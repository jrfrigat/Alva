# Copy to .env and choose a unique local password before starting.
POSTGRES_DB=alva
POSTGRES_USER=alva
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
ALVA_PORT=8080
ASPNETCORE_ENVIRONMENT=Production

# Image name built by compose and published by publish-docker.bat.
ALVA_IMAGE=alva:latest

# run-docker-compose.bat defaults to npm (no host ports); pass local for loopback access.
ALVA_RUN_MODE=npm
# NPM must already be connected to external Docker network proxy_network.
# Leave IP empty to detect this container's current address when the script starts.
NPM_PROXY_CONTAINER=nginx-proxy
NPM_PROXY_IP=

# Optional HTTPS profile. Point a public domain at this host for public certificates.
ALVA_DOMAIN=localhost
REVERSE_PROXY_ENABLED=false
CADDY_IP=172.30.10.10
PROXY_SUBNET=172.30.10.0/24
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
