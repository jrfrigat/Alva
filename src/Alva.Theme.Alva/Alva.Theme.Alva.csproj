<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The theme depends on the design language, not on the application: base values come from Material 3
      Expressive, and everything Alva actually overrides is stated in AlvaTheme. The theme package is needed
      only for the base tokens; the theme's own values are defined in AlvaTheme.cs.
    -->
    <PackageReference Include="Flare.Theme.MaterialDesign3Expressive" Version="0.53.0" />
  </ItemGroup>

</Project>
