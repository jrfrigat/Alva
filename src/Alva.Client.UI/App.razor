<FlareThemeProvider>
    <Router AppAssembly="typeof(App).Assembly">
        <Found Context="routeData">
            <RouteView RouteData="routeData" DefaultLayout="typeof(MainLayout)" />
            <FocusOnNavigate RouteData="routeData" Selector="h1" />
        </Found>
        <NotFound>
            <LayoutView Layout="typeof(MainLayout)">
                <FlareEmptyState Title="Страница не найдена" Description="Проверьте адрес или вернитесь к обзору.">
                    <ActionContent><FlareButton Href="/">Обзор команды</FlareButton></ActionContent>
                </FlareEmptyState>
            </LayoutView>
        </NotFound>
    </Router>
    <FlareDialogProvider />
    <FlareSnackbarProvider />
    <FlareMessageBoxProvider />
</FlareThemeProvider>
