<FlareThemeProvider>
    <Router AppAssembly="typeof(App).Assembly">
        <Found Context="routeData">
            <RouteView RouteData="routeData" DefaultLayout="typeof(MainLayout)" />
            <FocusOnNavigate RouteData="routeData" Selector="h1" />
        </Found>
        <NotFound>
            <LayoutView Layout="typeof(MainLayout)">
                <FlareEmptyState Title="@(Strings.T("Страница не найдена"))" Description="@(Strings.T("Проверьте адрес или вернитесь к обзору."))">
                    <ActionContent><FlareButton Href="/">@(Strings.T("Обзор команды"))</FlareButton></ActionContent>
                </FlareEmptyState>
            </LayoutView>
        </NotFound>
    </Router>
    <FlareDialogProvider />
    <FlareSnackbarProvider />
    <FlareMessageBoxProvider />
</FlareThemeProvider>
