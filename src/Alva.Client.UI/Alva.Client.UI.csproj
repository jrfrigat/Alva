<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- The namespaces stay Alva.Client.*, so the UI code does not need to be rewritten. -->
    <RootNamespace>Alva.Client</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Alva.Contracts\Alva.Contracts.csproj" />
    <ProjectReference Include="..\Alva.Theme.Alva\Alva.Theme.Alva.csproj" />
    <PackageReference Include="Flare.Components.Gantt" Version="0.55.0" />
    <PackageReference Include="Microsoft.Extensions.Localization" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.14" />
    <PackageReference Include="Flare.Blazor" Version="0.55.0" />
    <PackageReference Include="Flare.Theme.MaterialDesign3Expressive" Version="0.55.0" />
    <PackageReference Include="Flare.Icons.MaterialDesign3.Svg" Version="0.55.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Generated from Resources/AppStrings.resx by Resources/Generate-AlvaStrings.ps1. -->
    <Compile Update="Resources\AlvaStrings.Designer.cs">
      <DesignTime>true</DesignTime>
      <AutoGen>true</AutoGen>
    </Compile>
  </ItemGroup>

</Project>
