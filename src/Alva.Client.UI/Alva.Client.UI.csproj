<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Пространства имён остаются Alva.Client.*, поэтому код UI не переписывается. -->
    <RootNamespace>Alva.Client</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Alva.Contracts\Alva.Contracts.csproj" />
    <ProjectReference Include="..\Alva.Theme.Alva\Alva.Theme.Alva.csproj" />
    <PackageReference Include="Flare.Components.Gantt" Version="0.48.0" />
    <PackageReference Include="Microsoft.Extensions.Localization" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.12" />
    <PackageReference Include="Flare.Blazor" Version="0.48.0" />
    <PackageReference Include="Flare.Theme.MaterialDesign3Expressive" Version="0.48.0" />
    <PackageReference Include="Flare.Icons.MaterialDesign3.Svg" Version="0.48.0" />
  </ItemGroup>

</Project>
