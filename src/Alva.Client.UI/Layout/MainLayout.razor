@inherits LayoutComponentBase
@implements IAsyncDisposable
@inject AlvaSession Session
@inject NavigationManager Navigation
@inject IBrowserViewportService Viewport
@inject CultureService Cultures
@inject DraftGuard Drafts
<a class="skip-link" href="#main-content">@(AlvaStrings.Nav_SkipToContent)</a>
@* Confirmations (leaving with unsaved edits and the like) use the standard Flare dialog, one per application. *@
<FlareConfirmDialogProvider @ref="_confirm">
<FlareLayout>
    <FlareLayoutAppBar DrawerToggle="true">
        <div class="alva-appbar">
            <a href="@AppRoutes.Home" class="alva-brand" aria-label="@(AlvaStrings.Nav_AlvaHome)">
                <span class="alva-brand__mark" aria-hidden="true">A</span>
                <span class="alva-brand__text"><span class="alva-brand__name">ALVA</span><span class="alva-brand__caption">@(AlvaStrings.Nav_ResourcePlanning)</span></span>
            </a>
            <span class="alva-appbar__sep" aria-hidden="true"></span>
            <a href="workspaces" class="alva-team-chip" title="@(AlvaStrings.Nav_ChangeTeam)">
                <FlareIconView Value="@MaterialDesign3Icons.Regular.Groups" Size="18px" Class="alva-team-chip__icon" />
                <span class="alva-team-chip__name">@Session.TeamName</span>
                <FlareIconView Value="@MaterialDesign3Icons.Regular.KeyboardArrowDown" Size="16px" Class="alva-team-chip__chevron" />
            </a>
            <FlareSpacer />
            @if (_mobile && Session.User is not null)
            {
                @* On a phone the header keeps only the notification bell and the avatar; language, profile and sign-out
                   go into the menu behind the avatar, otherwise the sign-out label is truncated and the team name disappears. *@
                <RiskBell />
                <FlareMenu Anchor="MenuAnchor.BottomRight" AriaLabel="@(AlvaStrings.Nav_ProfileAndSettings)">
                    <Activator>
                        <button type="button" class="alva-user alva-user--menu" aria-label="@(AlvaStrings.Nav_ProfileAndSettings)">
                            <span class="alva-user__avatar" aria-hidden="true"><FlareIconView Value="@MaterialDesign3Icons.Regular.Person" Size="18px" /></span>
                        </button>
                    </Activator>
                    <ChildContent>
                        <FlareMenuItem Href="settings">@Session.User.DisplayName</FlareMenuItem>
                        <FlareMenuItem OnClick="ToggleCulture">@(Cultures.Current == "ru" ? "English" : "Русский")</FlareMenuItem>
                        <FlareMenuItem OnClick="Logout">@(AlvaStrings.Nav_SignOut)</FlareMenuItem>
                    </ChildContent>
                </FlareMenu>
            }
            else
            {
            <FlareButton OnClick="ToggleCulture" Variant="ButtonVariant.Text" Size="ButtonSize.Sm" aria-label="@(AlvaStrings.Nav_Language)" title="@(AlvaStrings.Nav_Language)">@(Cultures.Current == "ru" ? "EN" : "RU")</FlareButton>
            @if (Session.User is not null)
            {
                <RiskBell />
                <a href="settings" class="alva-user" title="@(AlvaStrings.Nav_ProfileAndSettings)">
                    <span class="alva-user__avatar" aria-hidden="true"><FlareIconView Value="@MaterialDesign3Icons.Regular.Person" Size="18px" /></span>
                    <span class="alva-user__name">@Session.User.DisplayName</span>
                </a>
                <FlareButton OnClick="Logout" Variant="ButtonVariant.Text" Size="ButtonSize.Sm">@(AlvaStrings.Nav_SignOut)</FlareButton>
            }
            else { <FlareButton Href="login" Size="ButtonSize.Sm">@(AlvaStrings.Common_SignIn)</FlareButton> }
            }
        </div>
    </FlareLayoutAppBar>
    <FlareLayoutDrawer @bind-Open="_open" Variant="DrawerVariant.Responsive" Width="18rem" AriaLabel="@(AlvaStrings.Nav_Navigation)">
        <FlareNavMenu AriaLabel="@(AlvaStrings.Nav_Navigation)">
            <FlareNavLink Href="@NavigationItems.Overview.Path" Match="NavMatchMode.Exact">
                <IconContent><FlareIconView Value="@NavigationItems.Overview.Icon" Size="1.25rem" /></IconContent>
                <ChildContent>@NavigationItems.Overview.Label</ChildContent>
            </FlareNavLink>
            @foreach (var group in NavigationItems.Groups)
            {
                <div class="alva-nav-group-label">@group.Title</div>
                @foreach (var item in group.Entries)
                {
                    <FlareNavLink Href="@item.Path" Match="NavMatchMode.Exact">
                        <IconContent><FlareIconView Value="@item.Icon" Size="1.25rem" /></IconContent>
                        <ChildContent>@item.Label</ChildContent>
                    </FlareNavLink>
                }
            }
            <div class="alva-nav-sep"></div>
            @foreach (var item in NavigationItems.Tail)
            {
                <FlareNavLink Href="@item.Path" Match="NavMatchMode.Exact">
                    <IconContent><FlareIconView Value="@item.Icon" Size="1.25rem" /></IconContent>
                    <ChildContent>@item.Label</ChildContent>
                </FlareNavLink>
            }
        </FlareNavMenu>
    </FlareLayoutDrawer>
    @* FlareLayoutContent already renders the single <main>; id and tabindex reach it through AdditionalAttributes,
       so no separate <main> wrapper is needed, and the skip-to-content link targets the main landmark directly. *@
    <FlareLayoutContent id="main-content" tabindex="-1"><FlareContainer MaxWidth="PageWidth"><SkillAssignmentNotice /><FlareStack @key="PagePath" Gap="FlareSpacing.XLarge">@Body</FlareStack></FlareContainer></FlareLayoutContent>
</FlareLayout>
</FlareConfirmDialogProvider>
@if (_mobile)
{
    <FlareBottomNav Position="BottomNavPosition.Fixed" LabelMode="BottomNavLabelMode.Wrap" AriaLabel="@(AlvaStrings.Nav_MainSections)">
        @foreach (var item in NavigationItems.Primary)
        {
            @* A short label fits on a phone; the full name stays as the tooltip and accessible name. *@
            <FlareBottomNavItem Href="@item.Path" Match="NavMatchMode.Exact" Tooltip="@item.Label" aria-label="@item.Label">
                <IconContent><FlareIconView Value="@item.Icon" Size="1.35rem" /></IconContent>
                <ChildContent>@(item.ShortLabel ?? item.Label)</ChildContent>
            </FlareBottomNavItem>
        }
    </FlareBottomNav>
}
@code {
    private bool _open;
    private bool _mobile;
    private IAsyncDisposable? _viewportSubscription;
    // Pages with several routes (/team and /team/roles, /capacity and /capacity/people) receive the same
    // parameters, and Blazor does not re-render them when navigating from the menu; a key by path recreates the page.
    private string PagePath => AppRoutes.Current(Navigation);

    // Boards on the time axis (Gantt charts and sprint planning) take the full width; other pages read better in a column.
    private ContainerMaxWidth PageWidth => PagePath.StartsWith("gantt", StringComparison.OrdinalIgnoreCase) || PagePath.EndsWith("/plan", StringComparison.OrdinalIgnoreCase) ? ContainerMaxWidth.Full : ContainerMaxWidth.Xl;
    protected override void OnInitialized() => Session.Changed += Refresh;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) _viewportSubscription = await Viewport.SubscribeBreakpointAsync((Breakpoint bp) => InvokeAsync(() => { _mobile = bp.IsAtMost(Breakpoint.Sm); _open = !_mobile; StateHasChanged(); }));
    }
    private void Refresh() => InvokeAsync(StateHasChanged);
    private FlareConfirmDialogProvider? _confirm;
    // Switching the language reloads the shell: the whole tree must render in the new language.
    // The same Flare dialog as when leaving a page with a draft, not the browser's system dialog.
    private async Task ToggleCulture()
    {
        if (Drafts.HasDirty && !await DestructivePrompt.ConfirmAsync(_confirm, AlvaStrings.Common_UnsavedChanges,
                AlvaStrings.Nav_UnsavedChangesWillBeLostWhenSwitchingTheLanguageContinue, AlvaStrings.Nav_SwitchLanguage))
            return;
        await Cultures.SetAsync(Cultures.Current == "ru" ? "en" : "ru");
        Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
    }
    private async Task Logout()
    {
        await Session.Logout();
        Navigation.NavigateTo("login");
    }
    public async ValueTask DisposeAsync() { Session.Changed -= Refresh; if (_viewportSubscription is not null) await _viewportSubscription.DisposeAsync(); }
}

