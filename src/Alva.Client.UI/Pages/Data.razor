@page "/data"
@inject AlvaSession Session
<PageTitle>@(Strings.T("Данные · Alva"))</PageTitle>
<FlareText Element="h1" Typo="TypographyScale.HeadlineLarge">@(Strings.T("Импорт и экспорт"))</FlareText>
<PageFeedback Loading="_busy" Error="@_error" />
@if (_formErrors.Count > 0) { <div class="alva-form-errors" role="alert" tabindex="-1" @ref="_errorSummary"><b>@(Strings.T("Проверьте выделенные поля."))</b>@foreach (var error in _formErrors) { <div>@error</div> }</div> }
@if(Session.TeamId is null){<TeamRequired />}
else
{
@* Демо без сервера не умеет ни разбирать файлы, ни выгружать их — говорим об этом до любых действий, а не после. *@
@if(!Session.SupportsDataTransfer){<FlareAlert Severity="AlertSeverity.Info" Title="@(Strings.T("Импорт и экспорт недоступны в демо"))">@(Strings.T("В демо данные хранятся только в этом браузере: импорт и экспорт файлов работают в версии Alva с сервером."))</FlareAlert>}
<FlareGrid MinColumnWidth="min(100%,24rem)">
<FlareCard Variant="CardVariant.Outlined"><FlareCardContent><FlareStack Gap="FlareSpacing.Large"><FlareText Element="h2" Typo="TypographyScale.TitleLarge">@(Strings.T("Экспорт данных команды"))</FlareText><FlareText>@(Strings.T("Скачайте данные для резервной копии или работы в таблицах."))</FlareText><FlareStack Row Wrap>@foreach(var format in Formats){<FlareButton Href="@(Session.SupportsDataTransfer ? Session.TeamPath("data/export?format="+format) : null)" Disabled="@(!Session.SupportsDataTransfer)" Variant="ButtonVariant.Tonal" Target="_blank">@format.ToUpperInvariant()</FlareButton>}</FlareStack></FlareStack></FlareCardContent></FlareCard>
<FlareCard Variant="CardVariant.Outlined"><FlareCardContent><FlareStack Gap="FlareSpacing.Large"><FlareText Element="h2" Typo="TypographyScale.TitleLarge">@(Strings.T("Импорт данных"))</FlareText><FlareText>@(Strings.T("Выберите файл JSON, CSV или XLSX. Используйте экспорт Alva как образец структуры."))</FlareText><FlareSelect TValue="string" Label="@(Strings.T("Формат"))" Items="Formats" @bind-Value="_format" Disabled="@(!Session.SupportsDataTransfer)" /><FlareFileUploadButton Text="@(Strings.T("Выбрать файл"))" Accept=".json,.csv,.xlsx" Multiple="false" OnFilesChanged="SelectFiles" ShowFileList MaxFileSize="10485760" Disabled="@(!Session.SupportsDataTransfer)" />@if(_fileError is not null){<FlareText Typo="TypographyScale.BodySmall" Class="alva-field-error">@_fileError</FlareText>}<FlareButton OnClick="Import" Loading="_busy" Disabled="@(_file is null || !Session.SupportsDataTransfer)">@(Strings.T("Импортировать"))</FlareButton>@if(_success){<FlareAlert Severity="AlertSeverity.Success">@(Strings.T("Данные импортированы. Откройте нужный раздел для проверки."))</FlareAlert>}</FlareStack></FlareCardContent></FlareCard>
</FlareGrid>
}
@code {
    private static readonly string[] Formats=["json","csv","xlsx"];private string _format="json";private IBrowserFile? _file;private bool _busy,_success;private string? _error;
    private string? _fileError; private readonly List<string> _formErrors=[]; private ElementReference _errorSummary;
    [CascadingParameter] public FlareConfirmDialogProvider? Confirm { get; set; }
    protected override async Task OnInitializedAsync(){try{await Session.Initialize();}catch(Exception e) when(e is HttpRequestException or InvalidOperationException){_error=e.Message;}}
    private void SelectFiles(IReadOnlyList<IBrowserFile> files){_file=files.FirstOrDefault();_success=false;}
    // Успех показывается только после того, как импорт действительно прошёл; любая ошибка — включая неподдерживаемую операцию — без «успеха».
    private async Task Import()
    {
        _fileError=null;_formErrors.Clear();
        if(!Session.SupportsDataTransfer)return;
        if(_file is null) { _fileError=Strings.T("Файл не выбран."); _formErrors.Add(_fileError); }
        else if(!string.Equals(Path.GetExtension(_file.Name).TrimStart('.'),_format,StringComparison.OrdinalIgnoreCase))
        { _fileError=Strings.T("Расширение файла не совпадает с форматом."); _formErrors.Add(_fileError); }
        if(_formErrors.Count > 0) { StateHasChanged(); await SafeFocus.Async(_errorSummary); return; }
        if(!await DestructivePrompt.ConfirmAsync(Confirm, Strings.T("Импортировать данные"),
            string.Format(Strings.T("Файл «{0}» будет импортирован в команду; существующие данные могут измениться."), _file.Name),
            Strings.T("Импортировать"))) return;
        _busy=true;_success=false;_error=null;
        try{await using var stream=_file.OpenReadStream(10*1024*1024);await Session.Import(_format,stream);_success=true;}
        catch(Exception e) when(e is HttpRequestException or InvalidOperationException or IOException or NotSupportedException){_error=e.Message;}
        finally{_busy=false;}
    }
}
