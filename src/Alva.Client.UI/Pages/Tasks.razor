@page "/tasks"
@page "/tasks/{TaskId:guid}"
@page "/unassigned"
@page "/my-work"
@inject AlvaSession Session
@inject NavigationManager Navigation
<PageTitle>@(Current is null ? "Задачи" : Current.Title) · Alva</PageTitle>
@if (Current is not null)
{
    <PageFeedback Error="@_error" Loading="_busy" />
    @* Esc закрывает карточку и возвращает к списку с прежними фильтрами; несохранённые правки не
       выбрасываются — их держит сама карточка, и тогда Esc не делает ничего. Обёртка принимает фокус при
       открытии задачи, в том числе по Enter из списка, чтобы фокус не падал на body. *@
    <div class="alva-task-card" @ref="_card" tabindex="-1" aria-label="@Current.Title" @onkeydown="OnCardKey">
        <TaskDetails @ref="_details" Item="Current" Tasks="_tasks" Projects="_projects" Sprints="_sprints" Actors="_actors" Changed="Load" />
    </div>
}
else if (TaskId.HasValue)
{
    @* Ссылка на конкретную задачу никогда не превращается в список: пока грузится — прогресс, ошибка — ошибка,
       а если задачи нет — так и сказано. *@
    <PageFeedback Error="@_error" Loading="_busy" />
    @if (_loaded) { <UnavailableState Title="@(Strings.T("Задача не найдена или недоступна"))" BackHref="tasks" BackLabel="@(Strings.T("К задачам"))" /> }
}
else
{
<AlvaPageHeader Category="@(Strings.T("Планирование · Задачи"))" Title="@PageHeading" Description="@(Strings.T("Пул задач команды: дерево, статусы и назначения."))">
    <Actions><FlareButton @ref="_newButton" OnClick="NewTask" Disabled="@(Session.TeamId is null)" Size="ButtonSize.Sm">@(Strings.T("Новая задача"))</FlareButton></Actions>
</AlvaPageHeader>
<PageFeedback Error="@_error" Loading="_busy" />
@if(Session.TeamId is null) { <TeamRequired /> }
else
{
<FlareStack Row Wrap Gap="FlareSpacing.Small">
    <FlareTextField Label="@(Strings.T("Поиск задач"))" @bind-Value="_search" @bind-Value:after="SaveListContext" Immediate Clearable Style="flex:2;min-width:min(100%,15rem)" />
    <FlareSelect TValue="Guid?" Label="@(Strings.T("Проект"))" Items="_projects.Select(x => (Guid?)x.Id)" ItemLabel="ProjectName" NullOption="@(Strings.T("Все проекты"))" @bind-Value="_projectFilter" @bind-Value:after="SaveListContext" Style="flex:1;min-width:12rem" />
    <FlareSelect TValue="string" Label="@(Strings.T("Статус"))" Items="_statuses" ItemLabel="Labels.Status" NullOption="@(Strings.T("Все статусы"))" @bind-Value="_statusFilter" @bind-Value:after="SaveListContext" Style="flex:1;min-width:12rem" />
</FlareStack>
<FlareStack Row Wrap Gap="FlareSpacing.Small"><FlareButton Href="tasks" Variant="ButtonVariant.Text" Size="ButtonSize.Sm">@(Strings.T("Все задачи"))</FlareButton><FlareButton Href="unassigned" Variant="ButtonVariant.Text" Size="ButtonSize.Sm">@(Strings.T("Без исполнителя"))</FlareButton><FlareButton Href="my-work" Variant="ButtonVariant.Text" Size="ButtonSize.Sm">@(Strings.T("Моя работа"))</FlareButton><FlareButton OnClick="Load" Variant="ButtonVariant.Text" Size="ButtonSize.Sm">@(Strings.T("Обновить"))</FlareButton></FlareStack>
<FlareGrid MinColumnWidth="min(100%, 26rem)" Gap="FlareSpacing.Large">
<FlareCard Variant="CardVariant.Outlined"><FlareCardContent>
    @if (!Filtered.Any()) { <FlareEmptyState Compact Title="@(Strings.T("Задач пока нет"))" Description="@(Strings.T("Добавьте первую задачу или измените фильтры."))" /> }
    else {
    <FlareDataTree TItem="TaskModel" Items="Roots" KeySelector="t => t!.Id" ChildrenProvider="Children" HasChildren="HasChildren" ItemClick="Open" Height="34rem" id="@TaskListState.TreeElementId">
        <ItemTemplate Context="task"><FlareStack Row Align="FlareAlignItems.Center" Gap="FlareSpacing.Small" Wrap>
            @* Ссылка делает задачу доступной с клавиатуры (Tab, Enter), а клик по ней идёт тем же путём Open,
               что и строка: так перед переходом запоминаются фильтры и позиция списка. Обёртка гасит всплытие
               и отменяет собственную навигацию ссылки, чтобы не было второй. *@
            <span @onclick:stopPropagation="true" @onclick="() => Open(task)" @onclick:preventDefault="true"><FlareLink Href="@($"tasks/{task!.Id}")">@task.Title</FlareLink></span><AlvaStatusChip Tone="AlvaTones.Status(task.Status)">@Labels.Status(task.Status)</AlvaStatusChip>
            @if(task.EstimateHours.HasValue) { <FlareText Typo="TypographyScale.LabelSmall">@task.EstimateHours ч</FlareText> }
        </FlareStack></ItemTemplate>
    </FlareDataTree>
    }
</FlareCardContent></FlareCard>
@if(_editing is not null)
{
<FlareCard Variant="CardVariant.Outlined"><FlareCardContent><FlareStack Gap="FlareSpacing.Medium">
    <FlareStack Row StretchFirst><FlareText Element="h2" Typo="TypographyScale.TitleLarge">@(_editing.Id == Guid.Empty ? Strings.T("Новая задача") : Strings.T("Карточка задачи"))</FlareText><FlareButton OnClick="Close" Variant="ButtonVariant.Text" Size="ButtonSize.Sm">@(Strings.T("Закрыть"))</FlareButton></FlareStack>
    <FlareTextField Label="@(Strings.T("Название"))" @bind-Value="_editing.Title" Required MaxLength="500" Autofocus />
    <FlareTextArea Label="@(Strings.T("Описание"))" @bind-Value="_editing.Description" AutoGrow />
    <SkillTagEditor Label="@(Strings.T("Необходимые навыки"))" @bind-Values="_editing.RequiredSkills"
                    Suggestions="_actors.SelectMany(a=>a.Skills).Concat(_tasks.SelectMany(t=>t.RequiredSkills)).Distinct(StringComparer.OrdinalIgnoreCase)" />
    <FlareGrid MinColumnWidth="min(100%,12rem)">
        <FlareSelect TValue="string" Label="@(Strings.T("Статус"))" Items="_statuses" ItemLabel="Labels.Status" @bind-Value="_editing.Status" />
        <FlareSelect TValue="Guid?" Label="@(Strings.T("Проект"))" Items="_projects.Select(x => (Guid?)x.Id)" ItemLabel="ProjectName" NullOption="@(Strings.T("Текучка"))" @bind-Value="_editing.ProjectId" />
        <FlareSelect TValue="Guid?" Label="@(Strings.T("Спринт (по датам)"))" Items="_sprints.OrderBy(x => x.StartDate).Select(x => (Guid?)x.Id)" ItemLabel="SprintName" NullOption="@(Strings.T("Бэклог — без дат"))" Value="SprintDates.First(_editing, _sprints)" ValueChanged="id => SprintDates.Place(_editing, _sprints.FirstOrDefault(s => s.Id == id))" HelperText="@SprintDates.Hint(_editing, _sprints)" />
        <FlareSelect TValue="Guid?" Label="@(Strings.T("Родительская задача"))" Items="_tasks.Where(x => x.Id != _editing.Id).Select(x => (Guid?)x.Id)" ItemLabel="TaskName" NullOption="@(Strings.T("Корневая задача"))" @bind-Value="_editing.ParentId" Searchable />
        <FlareNumericField TValue="decimal?" Label="@(Strings.T("Оценка, часы"))" @bind-Value="_editing.EstimateHours" Min="0" />
        <FlareDatePicker Label="@(Strings.T("Дедлайн"))" @bind-Value="_editing.Deadline" />
        <FlareDatePicker Label="@(Strings.T("Начало"))" @bind-Value="_editing.StartDate" />
        <FlareDatePicker Label="@(Strings.T("Окончание"))" @bind-Value="_editing.EndDate" />
    </FlareGrid>
    <FlareSelect TValue="Guid?" Label="@(Strings.T("Исполнитель, подкоманда или роль"))" Items="_actors.Select(x => (Guid?)x.Id)" ItemLabel="ActorName" NullOption="@(Strings.T("Не назначена"))" @bind-Value="_editing.AssignmentTargetId" Searchable />
    <SkillMatch Required="_editing.RequiredSkills" Person="@(_actors.FirstOrDefault(a=>a.Id==(_editing.ResolvedPersonId ?? _editing.AssignmentTargetId)))" />
    @if(_actors.FirstOrDefault(a=>a.Id==_editing.AssignmentTargetId)?.Kind is "Role" or "Department") { <FlareSelect TValue="Guid?" Label="@(Strings.T("Конкретный исполнитель"))" Items="@(_actors.Where(a=>a.Kind=="Person").Select(a=>(Guid?)a.Id))" ItemLabel="ActorName" NullOption="@(Strings.T("Пока не выбран"))" @bind-Value="_editing.ResolvedPersonId" Searchable /> }
    <FlareStack Row Wrap><FlareButton Loading="_busy" Disabled="@(string.IsNullOrWhiteSpace(_editing.Title))" OnClick="Save">@(Strings.T("Сохранить задачу"))</FlareButton>
        @if(_editing.Id != Guid.Empty) { <FlareButton Variant="ButtonVariant.Text" OnClick="() => NewChild(_editing.Id)">@(Strings.T("Подзадача"))</FlareButton><FlareButton Color="FlareColor.Error" Variant="ButtonVariant.Text" OnClick="Archive">@(Strings.T("Архивировать"))</FlareButton> }
    </FlareStack>
    @if(_history.Length>0) { <FlareText Element="h3" Typo="TypographyScale.TitleMedium">@(Strings.T("История"))</FlareText>@foreach(var entry in _history) { <FlareText Typo="TypographyScale.BodySmall">@entry.At.ToLocalTime().ToString("g") · @entry.Summary</FlareText> } }
</FlareStack></FlareCardContent></FlareCard>
}
</FlareGrid>
}
}
@code {
    [Parameter] public Guid? TaskId { get; set; }
    private TaskModel[] _tasks=[]; private ProjectModel[] _projects=[]; private SprintModel[] _sprints=[]; private ActorModel[] _actors=[]; private HistoryDto[] _history=[];
    private TaskModel? _editing; private string? _error,_search,_statusFilter; private Guid? _projectFilter; private bool _busy,_loaded;
    private double _pendingScroll;
    private readonly string[] _statuses=["Backlog","Planned","InProgress","Done","Cancelled"];
    private string Route => AppRoutes.Current(Navigation);
    private string PageHeading => Route == "my-work" ? Strings.T("Моя работа") : Route == "unassigned" ? Strings.T("Без исполнителя") : Strings.T("Задачи команды");
    private IEnumerable<TaskModel> Filtered => _tasks.Where(t => (string.IsNullOrWhiteSpace(_search) || t.Title.Contains(_search,StringComparison.OrdinalIgnoreCase)) && (!_projectFilter.HasValue || t.ProjectId==_projectFilter) && (_statusFilter is null || t.Status==_statusFilter) && (Route != "unassigned" || Assignees.Person(t,_actors) is null) && (Route != "my-work" || Assignees.Person(t,_actors) is { } person && Assignees.Me(_actors,Session.User).Contains(person)));
    private IEnumerable<TaskModel> Roots => Filtered.Where(t=>t.ParentId is null || !Filtered.Any(p=>p.Id==t.ParentId)).OrderBy(t=>t.Order);
    private Task<IEnumerable<TaskModel?>> Children(TaskModel? task) => Task.FromResult(Filtered.Where(t=>t.ParentId==task!.Id).OrderBy(t=>t.Order).Cast<TaskModel?>());
    private bool HasChildren(TaskModel? task) => Filtered.Any(t=>t.ParentId==task!.Id);
    private string ProjectName(Guid? id)=>_projects.FirstOrDefault(x=>x.Id==id)?.Name??Strings.T("Текучка");
    private string SprintName(Guid? id)=>_sprints.FirstOrDefault(x=>x.Id==id)?.Name??Strings.T("Без спринта");
    private string TaskName(Guid? id)=>_tasks.FirstOrDefault(x=>x.Id==id)?.Title??Strings.T("Корневая задача");
    private string ActorName(Guid? id) { var actor=_actors.FirstOrDefault(x=>x.Id==id);return actor is null?Strings.T("Не назначена"):$"{actor.Name} · {Labels.Kind(actor.Kind)}"; }
    private TaskModel? Current => TaskId.HasValue ? _tasks.FirstOrDefault(t=>t.Id==TaskId) : null;
    protected override async Task OnInitializedAsync()
    {
        // Список пересоздаётся по ключу маршрута (MainLayout), поэтому поиск, фильтры и позиция возвращаются
        // из TaskListState — после перехода в карточку и Back, а также после перезагрузки страницы.
        var context = await Session.TaskList.Load();
        _search = context.Search;
        _projectFilter = context.Project;
        _statusFilter = context.Status;
        _pendingScroll = context.Scroll;
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Открытая задача принимает фокус: Enter по ссылке в списке не оставляет человека без точки на
        // странице. Возврат из карточки, наоборот, возвращает фокус на страницу списка.
        if (_focusCard)
        {
            _focusCard = false;
            try { await _card.FocusAsync(); }
            catch (JSDisconnectedException) { }
        }
        if (_returnFocus)
        {
            _returnFocus = false;
            if (_newButton is not null) await _newButton.FocusAsync();
        }
        if (!firstRender || _pendingScroll <= 0) return;
        var scroll = _pendingScroll;
        _pendingScroll = 0;
        await Session.TaskList.RestoreScroll(scroll);
    }
    // Esc в открытой карточке возвращает к списку; несохранённый черновик держит карточка, поэтому Esc при
    // нём не срабатывает — правки уходят только после явного согласия.
    private void OnCardKey(KeyboardEventArgs e)
    {
        if (e.Key != "Escape" || _details?.Dirty == true) return;
        _returnFocus = true;
        Navigation.NavigateTo("tasks");
    }
    // Фильтры сохраняются при каждом изменении (@bind-Value:after), чтобы контекст был готов к переходу.
    private Task SaveListContext() => Session.TaskList.SaveFilters(_search, _projectFilter, _statusFilter);
    protected override async Task OnParametersSetAsync() { _editing=null; FocusOpened(); await Load(); }

    // Открытие задачи (клик по строке или Enter по ссылке) помечает карточку как цель фокуса.
    private void FocusOpened()
    {
        if (Current is null) { _opened = null; return; }
        if (_opened == Current.Id) return;
        _opened = Current.Id;
        _focusCard = true;
    }
    private async Task Open(TaskModel? task){ if(task is null) return; await Session.TaskList.SaveFilters(_search, _projectFilter, _statusFilter); await Session.TaskList.SaveScroll(await Session.TaskList.Scroll()); Navigation.NavigateTo($"tasks/{task.Id}"); }
    private async Task Run(Func<Task> action) { _busy=true; _error=null;try{await action();}catch(Exception e) when(e is HttpRequestException or InvalidOperationException){_error=PageFeedback.Describe(e);}finally{_busy=false;} }
    private Task Load()=>Run(async()=>{await Session.Initialize();if(Session.TeamId is null)return;_tasks=await Session.Get<TaskModel[]>(Session.TeamPath("tasks"));_projects=await Session.Get<ProjectModel[]>(Session.TeamPath("projects"));_actors=await Session.Get<ActorModel[]>(Session.TeamPath("actors"));_sprints=await Session.Get<SprintModel[]>(Session.TeamPath("sprints"));_loaded=true;});
    private void NewTask(){_editing=new TaskModel { TeamId=Session.TeamId!.Value };_history=[];}
    private void NewChild(Guid id){NewTask();_editing!.ParentId=id;}
    private FlareButton? _newButton;
    // Открытая карточка задачи: её обёртка (фокус при открытии), сама карточка (несохранённые правки) и
    // признаки, что после перерисовки нужно вернуть фокус.
    private ElementReference _card;
    private TaskDetails? _details;
    private Guid? _opened;
    private bool _focusCard;
    private bool _returnFocus;
    private void Hide(){_editing=null;_history=[];}
    // Закрытие редактора возвращает фокус на кнопку, которой его открыли, а не роняет его на body.
    private async Task Close(){Hide();StateHasChanged();if(_newButton is not null) await _newButton.FocusAsync();}
    private Task Save()=>Run(async()=>{
        var model=_editing!;var request=new TaskRequest(model.Title,model.Description,model.Status,model.ProjectId,model.ParentId,model.EstimateHours,model.Deadline,model.StartDate,model.EndDate,model.Order,model.Id==Guid.Empty?null:model.Version,model.RequiredSkills);
        var saved=await Session.Save<TaskModel>(model.Id==Guid.Empty?HttpMethod.Post:HttpMethod.Put,Session.TeamPath("tasks"+(model.Id==Guid.Empty?"":$"/{model.Id}")),request);
        if(model.AssignmentTargetId.HasValue)await Session.Send(HttpMethod.Put,Session.TeamPath($"tasks/{saved.Id}/assignment"),new AssignmentRequest(model.AssignmentTargetId.Value,model.ResolvedPersonId));
        else if(model.Id!=Guid.Empty && _tasks.Any(t=>t.Id==model.Id && t.AssignmentTargetId.HasValue))await Session.Send(HttpMethod.Delete,Session.TeamPath($"tasks/{saved.Id}/assignment"),new{});
        Hide();Navigation.NavigateTo($"tasks/{saved.Id}");
    });
    private Task Archive()=>Run(async()=>{await Session.Send(HttpMethod.Delete,Session.TeamPath($"tasks/{_editing!.Id}"),new{});Hide();_tasks=await Session.Get<TaskModel[]>(Session.TeamPath("tasks"));});
}
