    private IEnumerable<TaskModel> AllSiblings(TaskModel task) => _tasks.Where(t => t.ParentId == task.ParentId).OrderBy(t => t.Order).ThenBy(t => t.Title);
    private Task MoveUp(TaskModel task) => SwapWithNeighbor(task, -1);
    private Task MoveDown(TaskModel task) => SwapWithNeighbor(task, 1);
    private async Task SwapWithNeighbor(TaskModel task, int delta)
    {
        var siblings = AllSiblings(task).ToList();
        var index = siblings.FindIndex(t => t.Id == task.Id);
        var target = index + delta;
        if (index < 0 || target < 0 || target >= siblings.Count) return;
        (siblings[index], siblings[target]) = (siblings[target], siblings[index]);
        await ApplyOrder(task.ParentId, siblings);
    }
    private async Task ApplyOrder(Guid? parentId, IReadOnlyList<TaskModel> ordered, Guid? force = null)
    {
        try
        {
            for (var i = 0; i < ordered.Count; i++)
                if (ordered[i].Order != i || ordered[i].Id == force) await MoveTask(ordered[i], parentId, i);
            await Load();
            Snackbar.Show(AlvaStrings.Tasks_Moved, SnackbarSeverity.Success);
        }
        catch (Exception e) when (e is HttpRequestException or InvalidOperationException)
        {
            _error = PageFeedback.Describe(e);
        }
    }
    private async Task Outdent(TaskModel task)
    {
        if (task.ParentId is not { } parentId || _tasks.FirstOrDefault(t => t.Id == parentId) is not { } parent) return;
        var newParentId = parent.ParentId;
        var order = _tasks.Where(t => t.ParentId == newParentId).Select(t => t.Order).DefaultIfEmpty(-1).Max() + 1;
        await MoveOne(task, newParentId, order);
    }
    private async Task MakeSubtask(TaskModel task)
    {
        var siblings = AllSiblings(task).ToList();
        var index = siblings.FindIndex(t => t.Id == task.Id);
        if (index <= 0) return;
        var target = siblings[index - 1];
        var order = _tasks.Where(t => t.ParentId == target.Id).Select(t => t.Order).DefaultIfEmpty(-1).Max() + 1;
        await MoveOne(task, target.Id, order);
    }
    private async Task MoveOne(TaskModel task, Guid? parentId, int order)
    {
        try
        {
            await MoveTask(task, parentId, order);
            _highlightId = task.Id;
            await Load();
            Snackbar.Show(AlvaStrings.Tasks_Moved, SnackbarSeverity.Success);
        }
        catch (Exception e) when (e is HttpRequestException or InvalidOperationException)
        {
            _error = PageFeedback.Describe(e);
        }
    }
