    protected override async Task OnInitializedAsync()
    {
        _draft = Drafts.Track(() => IsDirty);
        _refresh = new RealtimeRefresh(() => !Drafts.HasDirty);
        Realtime.TaskChanged += OnRealtimeTaskChanged;
        Realtime.Resynced += OnRealtimeResynced;
        // The list is recreated by the route key (MainLayout), so search, filters, sort and expansion
        // are restored from TaskListState - after going to the card and Back, and after a page reload.
        var context = await Session.TaskList.Load();
        _search = context.Search;
        _projectFilter = context.Project;
        _statusFilter = context.Status;
        _sortKey = context.SortKey ?? "order";
        _sortDescending = context.SortDescending;
        _assigneeFilter = context.Assignee;
        _priorityFilter = context.Priority;
        _deadlineFilter = context.Deadline;
        _riskFilter = context.Risk;
        _expanded.UnionWith(context.Expanded);
        _selectedId = context.Selected;
        _tree = new DataGridTreeConfig<TaskModel>
        {
            ChildrenSelector = ChildrenOf,
            KeySelector = t => t.Id,
            IndentWidth = "24px",
            ToggleColumnTitle = AlvaStrings.Common_Task
        };
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // An open task takes focus: Enter on a link in the list does not leave the person without a point on
        // the page. Returning from the card, conversely, returns focus to the list page.
        if (_focusCard)
        {
            _focusCard = false;
            try { if (_card is not null) await _card.FocusAsync(); }
            catch (JSDisconnectedException) { }
        }
        if (_returnFocus)
        {
            _returnFocus = false;
            if (_newButton is not null) await _newButton.FocusAsync();
        }
        if (_focusQuick)
        {
            _focusQuick = false;
            if (_quickTitleField is not null)
            {
                try { await _quickTitleField.FocusAsync(); }
                catch (JSDisconnectedException) { }
            }
        }
        // The grid owns its sort stack; the saved key is applied once per grid instance, because a
        // filter that hides every row removes the grid and a new one starts with an empty stack.
        if (_dataGrid is null || ReferenceEquals(_sortedGrid, _dataGrid)) return;
        _sortedGrid = _dataGrid;
        await _grid.SetSortsAsync([new DataGridSort(_sortKey ?? "order", _sortDescending ? SortDirection.Descending : SortDirection.Ascending)]);
    }
