@page "/tasks"
@page "/tasks/{TaskId:guid}"
@page "/unassigned"
@page "/my-work"
@implements IDisposable
@inject AlvaSession Session
@inject NavigationManager Navigation
@inject DraftGuard Drafts
<PageTitle>@(Current is null ? AlvaStrings.Common_Tasks : Current.Title) · Alva</PageTitle>
<NavigationLock OnBeforeInternalNavigation="ConfirmLeave" ConfirmExternalNavigation="IsDirty" />
@if (Current is not null)
{
    <PageFeedback Error="@_error" Loading="_busy" OnRetry="Load" />
    @* Esc closes the card and returns to the list with the previous filters; unsaved edits are not
       discarded - the card itself holds them, and then Esc does nothing. The wrapper takes focus when
       the task opens, including via Enter from the list, so focus does not fall to body. *@
    <div class="alva-task-card" @ref="_card" tabindex="-1" aria-label="@Current.Title" @onkeydown="OnCardKey">
        <TaskDetails @ref="_details" Item="Current" Tasks="_tasks" Projects="_projects" Sprints="_sprints" Actors="_actors" Changed="Load" />
    </div>
}
else if (TaskId.HasValue)
{
    @* A link to a specific task never turns into a list: while loading - progress, on error - the error,
       and if the task does not exist - it says so. *@
    <PageFeedback Error="@_error" Loading="_busy" OnRetry="Load" />
    @if (_loaded && _error is null) { <UnavailableState Title="@(AlvaStrings.Tasks_TaskNotFoundOrUnavailable)" BackHref="tasks" BackLabel="@(AlvaStrings.Common_ToTasks)" /> }
}
else
{
<AlvaPageHeader Category="@(AlvaStrings.Tasks_PlanningTasks)" Title="@PageHeading" Description="@(AlvaStrings.Tasks_TheTeamSTaskPoolTreeStatusesAndAssignments)">
    <Actions><FlareButton @ref="_newButton" OnClick="NewTask" Disabled="@(Session.TeamId is null)" Size="ButtonSize.Sm">@(AlvaStrings.Tasks_NewTask)</FlareButton></Actions>
</AlvaPageHeader>
<PageFeedback Error="@_error" Loading="_busy" OnRetry="Load" />
@if(Session.TeamId is null) { <TeamRequired /> }
else
{
<FlareStack Row Wrap Gap="FlareSpacing.Small" Class="alva-task-filters">
    <FlareTextField Label="@(AlvaStrings.Tasks_SearchTasks)" @bind-Value="_search" @bind-Value:after="SaveListContext" Immediate Clearable Style="flex:2;min-width:min(100%,15rem)" />
    <FlareSelect TValue="Guid?" Label="@(AlvaStrings.Common_Project)" Items="_projects.Select(x => (Guid?)x.Id)" ItemLabel="ProjectName" NullOption="@(AlvaStrings.Projects_AllProjects)" @bind-Value="_projectFilter" @bind-Value:after="SaveListContext" Style="flex:1;min-width:12rem" />
    <FlareSelect TValue="string" Label="@(AlvaStrings.Common_Status)" Items="_statuses" ItemLabel="Labels.Status" NullOption="@(AlvaStrings.Tasks_AllStatuses)" @bind-Value="_statusFilter" @bind-Value:after="SaveListContext" Style="flex:1;min-width:12rem" />
</FlareStack>
<FlareStack Row Wrap Gap="FlareSpacing.Small" Class="alva-task-filters">
    <FlareSelect TValue="Guid?" Label="@(AlvaStrings.Tasks_FilterAssignee)" Items="FilterAssignees.Select(a => (Guid?)a.Id)" ItemLabel="ActorName" NullOption="@(AlvaStrings.Tasks_AnyAssignee)" @bind-Value="_assigneeFilter" @bind-Value:after="SaveExtraFilters" Searchable Style="flex:1;min-width:12rem" />
    <FlareSelect TValue="string" Label="@(AlvaStrings.Tasks_FilterPriority)" Items="Labels.Priorities" ItemLabel="Labels.Priority" NullOption="@(AlvaStrings.Tasks_AnyPriority)" @bind-Value="_priorityFilter" @bind-Value:after="SaveExtraFilters" Style="flex:1;min-width:10rem" />
    <FlareSelect TValue="string" Label="@(AlvaStrings.Tasks_FilterDeadline)" Items="DeadlineFilters" ItemLabel="DeadlineFilterLabel" NullOption="@(AlvaStrings.Tasks_AnyDeadline)" @bind-Value="_deadlineFilter" @bind-Value:after="SaveExtraFilters" Style="flex:1;min-width:10rem" />
    <FlareSelect TValue="string" Label="@(AlvaStrings.Tasks_FilterRisk)" Items="RiskFilters" ItemLabel="RiskFilterLabel" NullOption="@(AlvaStrings.Tasks_AnyRisk)" @bind-Value="_riskFilter" @bind-Value:after="SaveExtraFilters" Style="flex:1;min-width:10rem" />
    <FlareSelect TValue="string" Label="@(AlvaStrings.Tasks_SortBy)" Items="SortKeys" ItemLabel="SortLabel" @bind-Value="_sortKey" @bind-Value:after="SaveSort" Style="flex:1;min-width:12rem" />
    <FlareButton OnClick="ToggleSortDirection" Variant="ButtonVariant.Text" Size="ButtonSize.Sm" AriaLabel="@SortDirectionLabel">@SortDirectionLabel</FlareButton>
</FlareStack>
<FlareStack Row Wrap Gap="FlareSpacing.Small"><FlareButton Href="tasks" Variant="ButtonVariant.Text" Size="ButtonSize.Sm">@(AlvaStrings.Gantt_AllTasks)</FlareButton><FlareButton Href="unassigned" Variant="ButtonVariant.Text" Size="ButtonSize.Sm">@(AlvaStrings.Common_Unassigned)</FlareButton><FlareButton Href="my-work" Variant="ButtonVariant.Text" Size="ButtonSize.Sm">@(AlvaStrings.Tasks_MyWork)</FlareButton><FlareButton OnClick="Load" Variant="ButtonVariant.Text" Size="ButtonSize.Sm">@(AlvaStrings.Tasks_Refresh)</FlareButton></FlareStack>
<FlareGrid MinColumnWidth="min(100%, 26rem)" Gap="FlareSpacing.Large">
<FlareCard Variant="CardVariant.Outlined"><FlareCardContent>
    @if (!_loaded) { <LoadingSkeleton Height="24rem" /> }
    else if (_error is not null) { }
    else if (!Filtered.Any()) { <FlareEmptyState Compact Title="@(AlvaStrings.Common_NoTasksYet)" Description="@(AlvaStrings.Tasks_AddTheFirstTaskOrChangeTheFilters)" /> }
    else {
    <FlareDataTree TItem="TaskModel" Items="Roots" KeySelector="t => t!.Id" ChildrenProvider="Children" HasChildren="HasChildren" ItemClick="Open" Height="34rem" id="@TaskListState.TreeElementId">
        <ItemTemplate Context="task"><FlareStack Gap="FlareSpacing.XSmall" Class="alva-task-row">
            <FlareStack Row Align="FlareAlignItems.Center" Gap="FlareSpacing.Small" Wrap Class="alva-task-row__main">
            @* The link makes the task keyboard-accessible (Tab, Enter), and a click on it goes through the same Open
               path as the row: that way the filters and list position are saved before navigation. The wrapper stops
               propagation and cancels the link's own navigation so there is no second one. *@
            <span @onclick:stopPropagation="true" @onclick="() => Open(task)" @onclick:preventDefault="true"><FlareLink Href="@($"tasks/{task!.Id}")">@task.Title</FlareLink></span><AlvaStatusChip Tone="AlvaTones.Status(task.Status)">@Labels.Status(task.Status)</AlvaStatusChip>
            @if(task.Priority is not "Normal") { <AlvaStatusChip Tone="AlvaTones.Priority(task.Priority)">@Labels.Priority(task.Priority)</AlvaStatusChip> }
            </FlareStack>
            <FlareStack Row Align="FlareAlignItems.Center" Gap="FlareSpacing.Small" Wrap Class="alva-task-row__meta">
                @if(ProjectOf(task) is { } project) { <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant" title="@(AlvaStrings.Common_Project)">@project</FlareText> }
                <FlareText Typo="TypographyScale.BodySmall" Color="@(AssigneeActor(task) is null ? FlareColor.Warning : FlareColor.OnSurfaceVariant)" title="@(AlvaStrings.Tasks_FilterAssignee)">@AssigneeLabel(task)</FlareText>
                @if(DeadlineOf(task) is { } deadline) { <FlareText Typo="TypographyScale.BodySmall" Color="@DeadlineTone(task)" title="@DeadlineTitle(task)">@deadline.ToString("d MMM")</FlareText> }
                <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant" title="@(AlvaStrings.Tasks_RemainingShort)">@EffortLabel(task)</FlareText>
                @if(RiskOf(task) is { } risk) { <AlvaStatusChip Tone="AlvaTones.Severity(risk.Severity)" Title="@RiskReason(risk)">@(risk.Severity == "High" ? AlvaStrings.Common_High : AlvaStrings.Risks_Medium)</AlvaStatusChip> }
            </FlareStack>
        </FlareStack></ItemTemplate>
    </FlareDataTree>
    }
</FlareCardContent></FlareCard>
@if(_editing is not null)
{
<FlareCard Variant="CardVariant.Outlined"><FlareCardContent><FlareStack Gap="FlareSpacing.Medium">
    <FlareStack Row StretchFirst><FlareText Element="h2" Typo="TypographyScale.TitleLarge">@(_editing.Id == Guid.Empty ? AlvaStrings.Tasks_NewTask : AlvaStrings.Tasks_TaskCard)</FlareText><FlareButton OnClick="Close" Variant="ButtonVariant.Text" Size="ButtonSize.Sm">@(AlvaStrings.Common_Close)</FlareButton></FlareStack>
    @if (_formErrors.Count > 0) { <div tabindex="-1" @ref="_errorSummary"><AlvaValidationSummary Messages="_formErrors" /></div> }
    <FlareTextField Label="@(AlvaStrings.Common_Title)" @bind-Value="_editing.Title" ErrorText="@_titleError" Required MaxLength="500" Autofocus />
    <FlareTextArea Label="@(AlvaStrings.Common_Description)" @bind-Value="_editing.Description" AutoGrow />
    <FlareMultiSelect TValue="Guid" Label="@(AlvaStrings.Common_RequiredSkills)" Items="SkillActors.Select(a=>a.Id)"
                      ItemLabel="SkillName" Chips="true" Searchable="true"
                      Values="_editing.RequiredSkillIds" ValuesChanged="(IReadOnlyList<Guid> skills) => _editing.RequiredSkillIds = skills.ToArray()" />
    <FlareGrid MinColumnWidth="min(100%,12rem)">
        <FlareSelect TValue="string" Label="@(AlvaStrings.Common_Status)" Items="_statuses" ItemLabel="Labels.Status" @bind-Value="_editing.Status" />
        <FlareSelect TValue="string" Label="@(AlvaStrings.Common_Priority)" Items="Labels.Priorities" ItemLabel="Labels.Priority" @bind-Value="_editing.Priority" />
        <FlareSelect TValue="Guid?" Label="@(AlvaStrings.Common_Project)" Items="_projects.Select(x => (Guid?)x.Id)" ItemLabel="ProjectName" NullOption="@(AlvaStrings.Sprint_Ongoing)" @bind-Value="_editing.ProjectId" />
        <FlareSelect TValue="Guid?" Label="@(AlvaStrings.Common_SprintByDates)" Items="_sprints.OrderBy(x => x.StartDate).Select(x => (Guid?)x.Id)" ItemLabel="SprintName" NullOption="@(AlvaStrings.Common_BacklogUndated)" Value="SprintDates.First(_editing, _sprints)" ValueChanged="id => SprintDates.Place(_editing, _sprints.FirstOrDefault(s => s.Id == id))" HelperText="@SprintDates.Hint(_editing, _sprints)" Disabled="_editing.DatesFixed" />
        <FlareSelect TValue="Guid?" Label="@(AlvaStrings.Common_ParentTask)" ErrorText="@_parentError" Items="_tasks.Where(x => x.Id != _editing.Id).Select(x => (Guid?)x.Id)" ItemLabel="TaskName" NullOption="@(AlvaStrings.Common_RootTask)" @bind-Value="_editing.ParentId" Searchable />
        <FlareNumericField TValue="decimal?" Label="@(AlvaStrings.Common_EstimateHours)" ErrorText="@_estimateError" @bind-Value="_editing.EstimateHours" Min="0" />
        <FlareNumericField TValue="decimal?" Label="@(AlvaStrings.Common_RemainingWorkHours)" ErrorText="@_remainingError" @bind-Value="_editing.RemainingHours" Min="0" Max="100000" HelperText="@(AlvaStrings.Common_ForWorkInProgressLeaveBlankIfRemainingWorkIsUnknown0MeansNoWorkRemains)" />
        <FlareNumericField TValue="decimal?" Label="@(AlvaStrings.Common_NoMoreThanHPerDay)" ErrorText="@_limitError" @bind-Value="_editing.DailyHoursLimit" Min="0" Max="24" HelperText="@DailyLimit.Hint(_editing)" />
        <FlareDatePicker Label="@(AlvaStrings.Common_Deadline)" @bind-Value="_editing.Deadline" />
        <FlareDatePicker Label="@(AlvaStrings.Common_Start)" ErrorText="@_startError" @bind-Value="_editing.StartDate" Disabled="_editing.DatesFixed" />
        <FlareDatePicker Label="@(AlvaStrings.Common_End)" ErrorText="@_endError" @bind-Value="_editing.EndDate" Disabled="_editing.DatesFixed" />
    </FlareGrid>
    <FlareSwitch @bind-Value="_editing.DatesFixed" Label="@(AlvaStrings.Common_FixedDatesDoNotMove)"
                 Disabled="@(_editing.StartDate is null || _editing.EndDate is null)" />
    <FlareSelect TValue="Guid?" Label="@(AlvaStrings.Tasks_AssigneeSubTeamOrRole)" Items="AssignableActorIds" ItemLabel="id => ActorName(id)" NullOption="@(AlvaStrings.Common_UnassignedTask)" @bind-Value="_editing.AssignmentTargetId" Searchable />
    <SkillMatch Required="_editing.RequiredSkillIds" Person="@(_actors.FirstOrDefault(a=>a.Id==(_editing.ResolvedPersonId ?? _editing.AssignmentTargetId)))" Skills="SkillActors" />
    @if(_actors.FirstOrDefault(a=>a.Id==_editing.AssignmentTargetId)?.Kind is "Department") { <FlareSelect TValue="Guid?" Label="@(AlvaStrings.Common_SpecificAssignee)" Items="@(_actors.Where(a=>a.Kind=="Person").Select(a=>(Guid?)a.Id))" ItemLabel="ActorName" NullOption="@(AlvaStrings.Tasks_NotChosenYet)" @bind-Value="_editing.ResolvedPersonId" Searchable /> }
    <FlareStack Row Wrap><FlareButton Loading="_busy" Disabled="@(string.IsNullOrWhiteSpace(_editing.Title) || !IsDirty)" OnClick="Save">@(AlvaStrings.Tasks_SaveTheTask)</FlareButton><EditorStatus Dirty="IsDirty" Saving="_busy" />
        @if(_editing.Id != Guid.Empty) { <FlareButton Variant="ButtonVariant.Text" OnClick="() => NewChild(_editing.Id)">@(AlvaStrings.Common_Subtask)</FlareButton><FlareButton Color="FlareColor.Error" Variant="ButtonVariant.Text" OnClick="Archive">@(AlvaStrings.Common_Archive)</FlareButton> }
    </FlareStack>
    @if(_history.Length>0) { <FlareText Element="h3" Typo="TypographyScale.TitleMedium">@(AlvaStrings.Tasks_History)</FlareText>@foreach(var entry in _history) { <FlareText Typo="TypographyScale.BodySmall">@entry.At.ToLocalTime().ToString("g") · @entry.Summary</FlareText> } }
</FlareStack></FlareCardContent></FlareCard>
}
</FlareGrid>
}
}
@code {
    [Parameter] public Guid? TaskId { get; set; }
    private TaskModel[] _tasks=[]; private ProjectModel[] _projects=[]; private SprintModel[] _sprints=[]; private ActorModel[] _actors=[]; private HistoryDto[] _history=[]; private RiskDto[] _risks=[];
    private IEnumerable<ActorModel> SkillActors => _actors.Where(a => a.Kind == "Skill");
    private IEnumerable<Guid?> AssignableActorIds => _actors.Where(a => a.Kind is "Person" or "Department").Select(a => (Guid?)a.Id);
    private TaskModel? _editing; private string? _editingSnapshot; private IDisposable? _draft;
    private string? _error,_search,_statusFilter; private Guid? _projectFilter; private bool _busy,_loaded;
    private Guid? _assigneeFilter; private string? _priorityFilter,_deadlineFilter,_riskFilter;
    private string _sortKey="order"; private bool _sortDescending;
    private string? _titleError,_parentError,_startError,_endError,_estimateError,_remainingError,_limitError;
    private readonly List<string> _formErrors=[]; private ElementReference _errorSummary;
    [CascadingParameter] public FlareConfirmDialogProvider? Confirm { get; set; }
    internal bool IsDirty => _editing is not null && DraftSnapshot.Of(_editing) != _editingSnapshot;
    private double _pendingScroll;
    private readonly string[] _statuses=["Backlog","Planned","InProgress","Done","Cancelled"];
    private static readonly string[] SortKeys=["order","deadline","priority","project","assignee","status","estimate"];
    private static readonly string[] DeadlineFilters=["with","without"];
    private static readonly string[] RiskFilters=["with","without"];
    private IEnumerable<ActorModel> FilterAssignees => _actors.Where(a => a.Kind is "Person" or "Department");
    private string SortDirectionLabel => _sortDescending ? AlvaStrings.Tasks_SortDescending : AlvaStrings.Tasks_SortAscending;
    private static string SortLabel(string key) => key switch
    {
        "deadline" => AlvaStrings.Tasks_SortDeadline,
        "priority" => AlvaStrings.Tasks_SortPriority,
        "project" => AlvaStrings.Tasks_SortProject,
        "assignee" => AlvaStrings.Tasks_SortAssignee,
        "status" => AlvaStrings.Tasks_SortStatus,
        "estimate" => AlvaStrings.Tasks_SortEstimate,
        _ => AlvaStrings.Tasks_ListOrder
    };
    private static string DeadlineFilterLabel(string key) => key == "with" ? AlvaStrings.Tasks_WithDeadline : AlvaStrings.Tasks_WithoutDeadline;
    private static string RiskFilterLabel(string key) => key == "with" ? AlvaStrings.Tasks_WithRisk : AlvaStrings.Tasks_WithoutRisk;
    private string Route => AppRoutes.Current(Navigation);
    private string PageHeading => Route == "my-work" ? AlvaStrings.Tasks_MyWork : Route == "unassigned" ? AlvaStrings.Common_Unassigned : AlvaStrings.Tasks_TeamTasks;
    private IEnumerable<TaskModel> Filtered => _tasks.Where(t => (string.IsNullOrWhiteSpace(_search) || t.Title.Contains(_search,StringComparison.OrdinalIgnoreCase)) && (!_projectFilter.HasValue || t.ProjectId==_projectFilter) && (_statusFilter is null || t.Status==_statusFilter) && (Route != "unassigned" || Assignees.Person(t,_actors) is null) && (Route != "my-work" || Assignees.Person(t,_actors) is { } person && Assignees.Me(_actors,Session.User).Contains(person)) && (!_assigneeFilter.HasValue || AssigneeMatches(t,_assigneeFilter.Value)) && (_priorityFilter is null || t.Priority==_priorityFilter) && (_deadlineFilter is null || (_deadlineFilter=="with" ? DeadlineOf(t) is not null : DeadlineOf(t) is null)) && (_riskFilter is null || (_riskFilter=="with" ? RiskOf(t) is not null : RiskOf(t) is null)));
    private IEnumerable<TaskModel> Roots => Sorted(Filtered.Where(t=>t.ParentId is null || !Filtered.Any(p=>p.Id==t.ParentId)));
    private Task<IEnumerable<TaskModel?>> Children(TaskModel? task) => Task.FromResult(Sorted(Filtered.Where(t=>t.ParentId==task!.Id)).Cast<TaskModel?>());
    private bool HasChildren(TaskModel? task) => Filtered.Any(t=>t.ParentId==task!.Id);
    private IEnumerable<TaskModel> Sorted(IEnumerable<TaskModel> tasks)
    {
        var result = tasks.ToList();
        result.Sort(CompareTasks);
        return result;
    }
    private int CompareTasks(TaskModel a, TaskModel b)
    {
        var direction = _sortDescending ? -1 : 1;
        var compared = _sortKey switch
        {
            "deadline" => CompareNullableDate(DeadlineOf(a), DeadlineOf(b), direction),
            "priority" => direction * PriorityRank(a.Priority).CompareTo(PriorityRank(b.Priority)),
            "project" => CompareText(ProjectOf(a), ProjectOf(b), direction),
            "assignee" => CompareText(AssigneeSortName(a), AssigneeSortName(b), direction),
            "status" => direction * StatusRank(a.Status).CompareTo(StatusRank(b.Status)),
            "estimate" => CompareNullableDecimal(a.EstimateHours, b.EstimateHours, direction),
            _ => direction * a.Order.CompareTo(b.Order)
        };
        if (compared == 0) compared = a.Order.CompareTo(b.Order);
        if (compared == 0) compared = string.Compare(a.Title, b.Title, StringComparison.CurrentCultureIgnoreCase);
        return compared;
    }
    private static int CompareNullableDate(DateOnly? a, DateOnly? b, int direction)
    {
        if (a is null && b is null) return 0;
        if (a is null) return 1;
        if (b is null) return -1;
        return direction * a.Value.CompareTo(b.Value);
    }
    private static int CompareNullableDecimal(decimal? a, decimal? b, int direction)
    {
        if (a is null && b is null) return 0;
        if (a is null) return 1;
        if (b is null) return -1;
        return direction * a.Value.CompareTo(b.Value);
    }
    private static int CompareText(string? a, string? b, int direction)
    {
        var aEmpty = string.IsNullOrWhiteSpace(a);
        var bEmpty = string.IsNullOrWhiteSpace(b);
        if (aEmpty && bEmpty) return 0;
        if (aEmpty) return 1;
        if (bEmpty) return -1;
        return direction * string.Compare(a, b, StringComparison.CurrentCultureIgnoreCase);
    }
    private static int PriorityRank(string? priority) => priority switch { "Critical" => 3, "High" => 2, "Low" => 0, _ => 1 };
    private static int StatusRank(string? status) => status switch { "Planned" => 1, "InProgress" => 2, "Done" => 3, "Cancelled" => 4, "Backlog" => 0, _ => 5 };
    private static DateOnly? DeadlineOf(TaskModel task) => task.EffectiveDeadline ?? task.Deadline;
    private RiskDto? RiskOf(TaskModel task) => _risks.FirstOrDefault(r => r.TaskId == task.Id && r.HasRisk);
    private static string RiskReason(RiskDto risk) => ReasonText.Join(risk.Reasons);
    private string? ProjectOf(TaskModel task) => _projects.FirstOrDefault(p => p.Id == task.ProjectId)?.Name;
    private ActorModel? AssigneeActor(TaskModel task) => _actors.FirstOrDefault(a => a.Id == (task.ResolvedPersonId ?? task.AssignmentTargetId));
    private string? AssigneeSortName(TaskModel task) => AssigneeActor(task)?.Name;
    private string AssigneeLabel(TaskModel task) => AssigneeActor(task) is { } actor
        ? (actor.Kind == "Person" ? actor.Name : $"{actor.Name} - {Labels.Kind(actor.Kind)}")
        : AlvaStrings.Common_UnassignedTask;
    private bool AssigneeMatches(TaskModel task, Guid id) => task.AssignmentTargetId == id || Assignees.Person(task, _actors) == id;
    private static bool IsOverdue(TaskModel task) => task.Status is not ("Done" or "Cancelled") && DeadlineOf(task) is { } deadline && deadline < DateOnly.FromDateTime(DateTime.Today);
    private static FlareColor DeadlineTone(TaskModel task) => IsOverdue(task) ? FlareColor.Error : FlareColor.OnSurfaceVariant;
    private static string DeadlineTitle(TaskModel task)
    {
        var deadline = DeadlineOf(task);
        if (deadline is null) return "";
        var text = $"{AlvaStrings.Common_Deadline}: {deadline.Value:d MMM}";
        return IsOverdue(task) ? $"{text} ({AlvaStrings.Tasks_Overdue})" : text;
    }
    private static string EffortLabel(TaskModel task) => $"{Hours(task.EstimateHours)} / {Hours(task.RemainingHours)} {AlvaStrings.Sprint_HoursShort}";
    private static string Hours(decimal? value) => value is { } hours ? AlvaFormat.Hours(hours) : "-";
    private string ProjectName(Guid? id)=>_projects.FirstOrDefault(x=>x.Id==id)?.Name??AlvaStrings.Sprint_Ongoing;
    private string SprintName(Guid? id)=>_sprints.FirstOrDefault(x=>x.Id==id)?.Name??AlvaStrings.Common_NoSprint;
    private string TaskName(Guid? id)=>_tasks.FirstOrDefault(x=>x.Id==id)?.Title??AlvaStrings.Common_RootTask;
    private string ActorName(Guid? id) { var actor=_actors.FirstOrDefault(x=>x.Id==id);return actor is null?AlvaStrings.Common_UnassignedTask:$"{actor.Name} - {Labels.Kind(actor.Kind)}"; }
    private string SkillName(Guid id) => _actors.FirstOrDefault(x => x.Id == id)?.Name ?? "";
    private TaskModel? Current => TaskId.HasValue ? _tasks.FirstOrDefault(t=>t.Id==TaskId) : null;
    protected override async Task OnInitializedAsync()
    {
        _draft = Drafts.Track(() => IsDirty);
        // The list is recreated by the route key (MainLayout), so search, filters and position are restored
        // from TaskListState - after going to the card and Back, and after a page reload.
        var context = await Session.TaskList.Load();
        _search = context.Search;
        _projectFilter = context.Project;
        _statusFilter = context.Status;
        _sortKey = context.SortKey ?? "order";
        _sortDescending = context.SortDescending;
        _assigneeFilter = context.Assignee;
        _priorityFilter = context.Priority;
        _deadlineFilter = context.Deadline;
        _riskFilter = context.Risk;
        _pendingScroll = context.Scroll;
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // An open task takes focus: Enter on a link in the list does not leave the person without a point on
        // the page. Returning from the card, conversely, returns focus to the list page.
        if (_focusCard)
        {
            _focusCard = false;
            try { await _card.FocusAsync(); }
            catch (JSDisconnectedException) { }
        }
        if (_returnFocus)
        {
            _returnFocus = false;
            if (_newButton is not null) await _newButton.FocusAsync();
        }
        if (!firstRender || _pendingScroll <= 0) return;
        var scroll = _pendingScroll;
        _pendingScroll = 0;
        await Session.TaskList.RestoreScroll(scroll);
    }
    // Esc in an open card returns to the list; the card holds an unsaved draft, so Esc does not fire
    // with one - edits leave only after explicit consent.
    private void OnCardKey(KeyboardEventArgs e)
    {
        if (e.Key != "Escape" || _details?.Dirty == true || IsDirty) return;
        _returnFocus = true;
        Navigation.NavigateTo("tasks");
    }
    // Filters are saved on every change (@bind-Value:after), so the context is ready for navigation.
    private async Task SaveListContext()
    {
        await Session.TaskList.SaveFilters(_search, _projectFilter, _statusFilter);
        await Session.TaskList.SaveSort(_sortKey, _sortDescending);
        await Session.TaskList.SaveExtraFilters(_assigneeFilter, _priorityFilter, _deadlineFilter, _riskFilter);
    }
    private Task SaveExtraFilters() => Session.TaskList.SaveExtraFilters(_assigneeFilter, _priorityFilter, _deadlineFilter, _riskFilter);
    private Task SaveSort() => Session.TaskList.SaveSort(_sortKey, _sortDescending);
    private async Task ToggleSortDirection() { _sortDescending = !_sortDescending; await SaveSort(); }
    // Creation from another screen (project): the form opens immediately with that context, and saving returns there.
    [SupplyParameterFromQuery(Name = "new")] public int? NewFlag { get; set; }
    [SupplyParameterFromQuery(Name = "project")] public Guid? NewProject { get; set; }
    [SupplyParameterFromQuery(Name = "back")] public string? Back { get; set; }
    private bool BackToProject => Back == "project" && NewProject.HasValue;
    protected override async Task OnParametersSetAsync()
    {
        _editing=null; FocusOpened(); await Load();
        if (NewFlag == 1 && TaskId is null && Session.TeamId is not null) { NewTask(); _editing!.ProjectId = _projects.Any(p => p.Id == NewProject) ? NewProject : null; }
    }

    // Opening a task (clicking a row or pressing Enter on a link) marks the card as the focus target.
    private void FocusOpened()
    {
        if (Current is null) { _opened = null; return; }
        if (_opened == Current.Id) return;
        _opened = Current.Id;
        _focusCard = true;
    }
    private async Task Open(TaskModel? task){ if(task is null) return; await SaveListContext(); await Session.TaskList.SaveScroll(await Session.TaskList.Scroll()); Navigation.NavigateTo($"tasks/{task.Id}"); }
    private async Task Run(Func<Task> action) { _busy=true; _error=null;try{await action();}catch(Exception e) when(e is HttpRequestException or InvalidOperationException){_error=PageFeedback.Describe(e);}finally{_busy=false;_loaded=true;} }
    private Task Load()=>Run(async()=>{await Session.Initialize();if(Session.TeamId is null)return;_tasks=await Session.Get<TaskModel[]>(Session.TeamPath("tasks"));_projects=await Session.Get<ProjectModel[]>(Session.TeamPath("projects"));_actors=await Session.Get<ActorModel[]>(Session.TeamPath("actors"));_sprints=await Session.Get<SprintModel[]>(Session.TeamPath("sprints"));_risks=(await Session.Get<RiskDto[]>(Session.TeamPath("risks"))).Where(r=>r.HasRisk).ToArray();_loaded=true;});
    private void NewTask(){_editing=new TaskModel { TeamId=Session.TeamId!.Value };_history=[];_editingSnapshot=DraftSnapshot.Of(_editing);}
    private void NewChild(Guid id){NewTask();_editing!.ParentId=id;_editingSnapshot=DraftSnapshot.Of(_editing);}
