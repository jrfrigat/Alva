    private async Task CreateQuick(bool another)
    {
        if (string.IsNullOrWhiteSpace(_quickTitle) || _quickBusy) return;
        _quickBusy = true;
        _quickError = null;
        try
        {
            var request = new TaskRequest(_quickTitle.Trim(), Status: _quickStatus, ProjectId: _quickProjectId, ParentId: _quickParentId);
            var saved = await Session.Save<TaskModel>(HttpMethod.Post, Session.TeamPath("tasks"), request);
            if (saved is null) { _quickError = AlvaStrings.Tasks_CouldNotCreate; return; }
            _tasks = _tasks.Append(saved).ToArray();
            var parentId = saved.ParentId;
            while (parentId is { } id && _tasks.FirstOrDefault(t => t.Id == id) is { } parent)
            {
                _expanded.Add(id);
                parentId = parent.ParentId;
            }
            _highlightId = saved.Id;
            Snackbar.Show(AlvaStrings.Tasks_Created, SnackbarSeverity.Success);
            if (another) _quickTitle = "";
            else { _quickOpen = false; _returnFocus = true; }
            await SaveTreeState();
            StateHasChanged();
        }
        catch (Exception e) when (e is HttpRequestException or InvalidOperationException)
        {
            _quickError = PageFeedback.Describe(e);
        }
        finally { _quickBusy = false; }
    }
    private async Task Run(Func<Task> action) { _busy=true; _error=null;try{await action();}catch(Exception e) when(e is HttpRequestException or InvalidOperationException){_error=PageFeedback.Describe(e);}finally{_busy=false;_loaded=true;} }
