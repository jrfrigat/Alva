    public void Dispose() => _draft?.Dispose();
    private async Task Save()
    {
        if (!Validate())
        {
            StateHasChanged();
            await SafeFocus.Async(_errorSummary);
            return;
        }
        await Run(async()=>{
            var model=_editing!;var request=new TaskRequest(model.Title,model.Description,model.Status,model.ProjectId,model.ParentId,model.EstimateHours,model.Deadline,model.StartDate,model.EndDate,model.Order,model.Id==Guid.Empty?null:model.Version,RequiredSkillIds:model.RequiredSkillIds,Priority:model.Priority, RemainingHours:model.RemainingHours, SetRemainingHours:true, DatesFixed:model.DatesFixed, DailyHoursLimit:model.DailyHoursLimit, SetDailyHoursLimit:true);
            var saved=await Session.Save<TaskModel>(model.Id==Guid.Empty?HttpMethod.Post:HttpMethod.Put,Session.TeamPath("tasks"+(model.Id==Guid.Empty?"":$"/{model.Id}")),request);
            model.Id=saved.Id; model.Version=saved.Version;
            if(model.AssignmentTargetId.HasValue)await Session.Send(HttpMethod.Put,Session.TeamPath($"tasks/{saved.Id}/assignment"),new AssignmentRequest(model.AssignmentTargetId.Value,model.ResolvedPersonId));
            else if(model.Id!=Guid.Empty && _tasks.Any(t=>t.Id==model.Id && t.AssignmentTargetId.HasValue))await Session.Send(HttpMethod.Delete,Session.TeamPath($"tasks/{saved.Id}/assignment"),new{});
            Hide();Navigation.NavigateTo(BackToProject ? $"projects?project={NewProject}" : $"tasks/{saved.Id}");
        });
    }

    private bool Validate()
    {
        _titleError=_parentError=_startError=_endError=_estimateError=_remainingError=_limitError=null;
        _formErrors.Clear();
        var m=_editing!;
        if (string.IsNullOrWhiteSpace(m.Title)) Error(ref _titleError, AlvaStrings.Tasks_EnterAName);
        if (m.StartDate is { } start && m.EndDate is { } end && start > end) Error(ref _endError, AlvaStrings.Common_TheEndDateIsBeforeTheStartDate);
        if (m.EstimateHours is < 0) Error(ref _estimateError, AlvaStrings.Common_TheEstimateCannotBeNegative);
        if (m.RemainingHours is < 0) Error(ref _remainingError, AlvaStrings.Common_RemainingWorkCannotBeNegative);
        if (DailyLimit.Error(m.DailyHoursLimit) is { } limitError) Error(ref _limitError, limitError);
        if (m.ParentId is { } parent && (parent == m.Id || IsDescendant(parent, m.Id))) Error(ref _parentError, AlvaStrings.Common_AParentTaskCannotBeTheTaskItselfOrOneOfItsDescendants);
        return _formErrors.Count == 0;
    }

    // Walk up from the candidate: reaching the task itself would make it a descendant of its own descendant.
    private bool IsDescendant(Guid candidate, Guid taskId)
    {
        var byId=_tasks.ToDictionary(t=>t.Id); var seen=new HashSet<Guid>();
        for (Guid? id=candidate; id is { } current && seen.Add(current) && byId.TryGetValue(current, out var task); id=task.ParentId)
            if (current == taskId) return true;
        return false;
    }

    private void Error(ref string? field, string message) { field=message; _formErrors.Add(message); }
