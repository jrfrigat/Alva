@page "/tasks"
@page "/tasks/{TaskId:guid}"
@page "/unassigned"
@page "/my-work"
@implements IDisposable
@inject AlvaSession Session
@inject NavigationManager Navigation
@inject DraftGuard Drafts
@inject ISnackbarService Snackbar
@inject IRealtimeService Realtime
<PageTitle>@(Current is null ? AlvaStrings.Common_Tasks : Current.Title) - Alva</PageTitle>
<NavigationLock OnBeforeInternalNavigation="ConfirmLeave" ConfirmExternalNavigation="IsDirty" />
@if (Current is not null)
{
    <PageFeedback Error="@_error" Loading="_busy" OnRetry="Load" />
    <FlareButton Href="tasks" Variant="ButtonVariant.Text" Size="ButtonSize.Sm">@(AlvaStrings.Tasks_BackToTree)</FlareButton>
    @* Esc closes the card and returns to the list with the previous filters; unsaved edits are not
       discarded - the card itself holds them, and then Esc does nothing. The wrapper takes focus when
       the task opens, including via Enter from the list, so focus does not fall to body. *@
    <FlareStack Gap="FlareSpacing.None" @ref="_card" tabindex="-1" aria-label="@Current.Title" @onkeydown="OnCardKey">
        <TaskDetails @ref="_details" Item="Current" Tasks="_tasks" Projects="_projects" Sprints="_sprints" Actors="_actors" Changed="Load" InitialTab="@Tab" />
    </FlareStack>
}
else if (TaskId.HasValue)
{
    @* A link to a specific task never turns into a list: while loading - progress, on error - the error,
       and if the task does not exist - it says so. *@
    <PageFeedback Error="@_error" Loading="_busy" OnRetry="Load" />
    @if (_loaded && _error is null) { <UnavailableState Title="@(AlvaStrings.Tasks_TaskNotFoundOrUnavailable)" BackHref="tasks" BackLabel="@(AlvaStrings.Common_ToTasks)" /> }
}
else
{
<AlvaPageHeader Title="@PageHeading">
    <Actions><FlareButton @ref="_newButton" OnClick="() => OpenQuickCreate(null)" Disabled="@(Session.TeamId is null)" Size="ButtonSize.Sm">@(AlvaStrings.Tasks_NewTask)</FlareButton></Actions>
</AlvaPageHeader>
<PageFeedback Error="@_error" Loading="_busy" OnRetry="Load" />
@if(Session.TeamId is null) { <TeamRequired /> }
else
{
<FlareStack Row Wrap Gap="FlareSpacing.Small">
    <FlareTextField Label="@(AlvaStrings.Tasks_SearchTasks)" @bind-Value="_search" @bind-Value:after="SaveListContext" Immediate Clearable Style="flex:2;min-width:min(100%,15rem)" />
    <FlareSelect TValue="Guid?" Label="@(AlvaStrings.Common_Project)" Items="_projects.Select(x => (Guid?)x.Id)" ItemLabel="ProjectName" NullOption="@(AlvaStrings.Projects_AllProjects)" @bind-Value="_projectFilter" @bind-Value:after="SaveListContext" Style="flex:1;min-width:12rem" />
    <FlareSelect TValue="string" Label="@(AlvaStrings.Common_Status)" Items="_statuses" ItemLabel="Labels.Status" NullOption="@(AlvaStrings.Tasks_AllStatuses)" @bind-Value="_statusFilter" @bind-Value:after="SaveListContext" Style="flex:1;min-width:12rem" />
</FlareStack>
<FlareStack Row Wrap Gap="FlareSpacing.Small">
    <FlareSelect TValue="Guid?" Label="@(AlvaStrings.Tasks_FilterAssignee)" Items="FilterAssignees.Select(a => (Guid?)a.Id)" ItemLabel="ActorName" NullOption="@(AlvaStrings.Tasks_AnyAssignee)" @bind-Value="_assigneeFilter" @bind-Value:after="SaveExtraFilters" Searchable Style="flex:1;min-width:12rem" />
    <FlareSelect TValue="string" Label="@(AlvaStrings.Tasks_FilterPriority)" Items="Labels.Priorities" ItemLabel="Labels.Priority" NullOption="@(AlvaStrings.Tasks_AnyPriority)" @bind-Value="_priorityFilter" @bind-Value:after="SaveExtraFilters" Style="flex:1;min-width:10rem" />
    <FlareSelect TValue="string" Label="@(AlvaStrings.Tasks_FilterDeadline)" Items="DeadlineFilters" ItemLabel="DeadlineFilterLabel" NullOption="@(AlvaStrings.Tasks_AnyDeadline)" @bind-Value="_deadlineFilter" @bind-Value:after="SaveExtraFilters" Style="flex:1;min-width:10rem" />
    <FlareSelect TValue="string" Label="@(AlvaStrings.Tasks_FilterRisk)" Items="RiskFilters" ItemLabel="RiskFilterLabel" NullOption="@(AlvaStrings.Tasks_AnyRisk)" @bind-Value="_riskFilter" @bind-Value:after="SaveExtraFilters" Style="flex:1;min-width:10rem" />
</FlareStack>
@if (HasFilters)
{
<FlareStack Row Wrap Gap="FlareSpacing.Small">
    @if (!string.IsNullOrWhiteSpace(_search)) { <FlareChip Closable="true" OnClose="ClearSearch">@(AlvaStrings.Tasks_FilterSearch): @_search</FlareChip> }    @if (_projectFilter is { } projectId) { <FlareChip Closable="true" OnClose="ClearProject">@(AlvaStrings.Common_Project): @ProjectName(projectId)</FlareChip> }
    @if (_statusFilter is { } status) { <FlareChip Closable="true" OnClose="ClearStatus">@(AlvaStrings.Common_Status): @Labels.Status(status)</FlareChip> }
    @if (_assigneeFilter is { } assigneeId) { <FlareChip Closable="true" OnClose="ClearAssignee">@(AlvaStrings.Tasks_FilterAssignee): @ActorName(assigneeId)</FlareChip> }
    @if (_priorityFilter is { } priority) { <FlareChip Closable="true" OnClose="ClearPriority">@(AlvaStrings.Common_Priority): @Labels.Priority(priority)</FlareChip> }
    @if (_deadlineFilter is { } deadline) { <FlareChip Closable="true" OnClose="ClearDeadline">@(AlvaStrings.Tasks_FilterDeadline): @DeadlineFilterLabel(deadline)</FlareChip> }
    @if (_riskFilter is { } riskFilter) { <FlareChip Closable="true" OnClose="ClearRisk">@(AlvaStrings.Tasks_FilterRisk): @RiskFilterLabel(riskFilter)</FlareChip> }
    <FlareButton Variant="ButtonVariant.Text" Size="ButtonSize.Sm" OnClick="ClearFilters">@(AlvaStrings.Tasks_ClearFilters)</FlareButton>
</FlareStack>
<FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant"><span role="status" aria-live="polite">@string.Format(AlvaStrings.Tasks_FoundCount, Matched.Count())</span></FlareText>
}
<FlareStack Row Wrap Gap="FlareSpacing.Small"><FlareButton Href="tasks" aria-current="@(Route == "tasks" ? "page" : null)" Variant="@(Route == "tasks" ? ButtonVariant.Tonal : ButtonVariant.Text)" Size="ButtonSize.Sm">@(AlvaStrings.Gantt_AllTasks)</FlareButton><FlareButton Href="unassigned" aria-current="@(Route == "unassigned" ? "page" : null)" Variant="@(Route == "unassigned" ? ButtonVariant.Tonal : ButtonVariant.Text)" Size="ButtonSize.Sm">@(AlvaStrings.Common_Unassigned)</FlareButton><FlareButton Href="my-work" aria-current="@(Route == "my-work" ? "page" : null)" Variant="@(Route == "my-work" ? ButtonVariant.Tonal : ButtonVariant.Text)" Size="ButtonSize.Sm">@(AlvaStrings.Tasks_MyWork)</FlareButton><FlareButton OnClick="Load" Variant="ButtonVariant.Text" Size="ButtonSize.Sm">@(AlvaStrings.Tasks_Refresh)</FlareButton></FlareStack>
@if (HasRows)
{
<FlareStack Height="calc(100vh - 24rem)" MinHeight="22rem">
    <FlareDataGrid @ref="_dataGrid" TItem="TaskModel" Items="@Roots" RowKey="@(t => t.Id)" Context="@_grid"
                   Tree="@_tree" ExpandedItems="@ExpandedItems" OnExpandedChanged="@OnExpanded"
                   OnSortChanged="@OnSortChanged" RowReorderable="@ReorderEnabled" OnRowReordered="@Reordered"
                   SelectionMode="SelectionMode.Single" SelectedItems="@GridSelection" RowClick="@Open" RowClassFunc="@RowClass"
                   Presentation="DataGridPresentation.Auto" Virtual="true" FillHeight="true" Dense="true" Hoverable="true"
                   StickyHeader="true" ShowPager="false" role="group" aria-label="@(AlvaStrings.Tasks_TeamTasks)">
        <Columns>
            <FlareColumn TItem="TaskModel" Title="@(AlvaStrings.Common_Task)" Sortable="true" SortKey="order" SortComparison="@OrderComparison" Width="32%">
                <Template Context="task">
                    <FlareStack Row Gap="FlareSpacing.XXSmall" Align="FlareAlignItems.Center" Style="display:inline-flex;vertical-align:middle">
                        <span @onclick:stopPropagation="true" @onclick="() => Open(task)" @onclick:preventDefault="true"><FlareLink Href="@($"tasks/{task.Id}")">@task.Title</FlareLink></span>
                        <span @onclick:stopPropagation="true"><FlareIconButton Icon="@MaterialDesign3Icons.Regular.Add" Size="ButtonSize.Sm" Tooltip="@AlvaStrings.Tasks_AddSubtask" AriaLabel="@AlvaStrings.Tasks_AddSubtask" OnClick="() => OpenFullCreate(task.Id)" /></span>
                        <span @onclick:stopPropagation="true">
                            <FlareMenu Anchor="MenuAnchor.BottomEnd" AriaLabel="@(AlvaStrings.Tasks_RowActions)">
                                <Activator><FlareIconButton Icon="@MaterialDesign3Icons.Regular.MoreVert" Size="ButtonSize.Sm" Tooltip="@(AlvaStrings.Tasks_RowActions)" AriaLabel="@(AlvaStrings.Tasks_RowActions)" /></Activator>
                                <ChildContent>
                                    <FlareMenuItem Disabled="@(!ReorderEnabled)" OnClick="() => MoveUp(task)">@(AlvaStrings.Tasks_MoveUp)</FlareMenuItem>
                                    <FlareMenuItem Disabled="@(!ReorderEnabled)" OnClick="() => MoveDown(task)">@(AlvaStrings.Tasks_MoveDown)</FlareMenuItem>
                                    <FlareMenuItem OnClick="() => Outdent(task)">@(AlvaStrings.Tasks_Outdent)</FlareMenuItem>
                                    <FlareMenuItem OnClick="() => MakeSubtask(task)">@(AlvaStrings.Tasks_MakeSubtask)</FlareMenuItem>
                                </ChildContent>
                            </FlareMenu>
                        </span>
                    </FlareStack>
                </Template>
            </FlareColumn>
            <FlareColumn TItem="TaskModel" Title="@(AlvaStrings.Common_Status)" Sortable="true" SortKey="status" SortComparison="@StatusComparison" Width="6rem">
                <Template Context="task"><AlvaStatusChip Tone="TaskStatusTone(task.Status)">@Labels.Status(task.Status)</AlvaStatusChip></Template>
            </FlareColumn>
            <FlareColumn TItem="TaskModel" Title="@(AlvaStrings.Common_Priority)" Sortable="true" SortKey="priority" SortComparison="@PriorityComparison" Width="5.5rem">
                <Template Context="task">
                    @if (task.Priority is not "Normal") { <AlvaStatusChip Tone="AlvaTones.Priority(task.Priority)">@Labels.Priority(task.Priority)</AlvaStatusChip> }
                    else { <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@Labels.Priority(task.Priority)</FlareText> }
                </Template>
            </FlareColumn>
            <FlareColumn TItem="TaskModel" Title="@(AlvaStrings.Tasks_FilterAssignee)" Sortable="true" SortKey="assignee" SortComparison="@AssigneeComparison" Width="9rem">
                <Template Context="task"><FlareText Typo="TypographyScale.BodySmall" Color="@(AssigneeActor(task) is null ? FlareColor.Warning : FlareColor.OnSurfaceVariant)">@AssigneeLabel(task)</FlareText></Template>
            </FlareColumn>
            <FlareColumn TItem="TaskModel" Title="@(AlvaStrings.Common_Deadline)" Sortable="true" SortKey="deadline" SortComparison="@DeadlineComparison" Width="6.5rem">
                <Template Context="task">
                    @if (DeadlineOf(task) is { } deadline) { <FlareText Typo="TypographyScale.BodySmall" Color="@DeadlineTone(task)" title="@DeadlineTitle(task)">@deadline.ToString("d MMM")</FlareText> }
                    else { <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">-</FlareText> }
                </Template>
            </FlareColumn>
            <FlareColumn TItem="TaskModel" Title="@(AlvaStrings.Common_Estimate)" Sortable="true" SortKey="estimate" SortComparison="@EstimateComparison" Width="7rem">
                <Template Context="task"><FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@EffortLabel(task)</FlareText></Template>
            </FlareColumn>
            <FlareColumn TItem="TaskModel" Title="@(AlvaStrings.Tasks_FilterRisk)" Width="5.5rem">
                <Template Context="task">
                    @if (RiskOf(task) is { } risk) { <AlvaStatusChip Tone="AlvaTones.Severity(risk.Severity)" Title="@RiskReason(risk)">@(risk.Severity == "High" ? AlvaStrings.Common_High : AlvaStrings.Risks_Medium)</AlvaStatusChip> }
                    else { <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">-</FlareText> }
                </Template>
            </FlareColumn>
            <FlareColumn TItem="TaskModel" Title="@(AlvaStrings.Common_Project)" Sortable="true" SortKey="project" SortComparison="@ProjectComparison" Width="7rem">
                <Template Context="task"><FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@(ProjectOf(task) ?? "-")</FlareText></Template>
            </FlareColumn>
        </Columns>
    </FlareDataGrid>
</FlareStack>
}
else
{
<FlareCard Variant="CardVariant.Outlined"><FlareCardContent>
    @if (!_loaded) { <LoadingSkeleton Height="24rem" /> }
    else if (_error is not null) { <FlareAlert Severity="AlertSeverity.Error">@_error</FlareAlert><FlareButton Variant="ButtonVariant.Text" Size="ButtonSize.Sm" OnClick="Load">@(AlvaStrings.Common_TryAgain)</FlareButton> }
    else if (_tasks.Length == 0) { <FlareEmptyState Compact Title="@(AlvaStrings.Common_NoTasksYet)" Description="@(AlvaStrings.Tasks_AddTheFirstTaskOrChangeTheFilters)" /> }
    else { <FlareEmptyState Compact Title="@(AlvaStrings.Tasks_NoTasksByFilters)" Description="@(AlvaStrings.Tasks_ClearFilters)" /><FlareButton Variant="ButtonVariant.Text" Size="ButtonSize.Sm" OnClick="ClearFilters">@(AlvaStrings.Tasks_ClearFilters)</FlareButton> }
</FlareCardContent></FlareCard>
}
<FlareDrawer Anchor="DrawerAnchor.Right" Open="DrawerOpen" OpenChanged="OnDrawerOpen" Width="34rem" ContentPadding="FlareSpacing.Large" AriaLabel="@DrawerLabel">
    @if (_quickOpen)
    {
        <FlareStack Gap="FlareSpacing.Medium">
            <FlareStack Row StretchFirst><FlareText Element="h2" Typo="TypographyScale.TitleLarge">@(AlvaStrings.Tasks_NewTask)</FlareText><FlareButton OnClick="CloseQuick" Variant="ButtonVariant.Text" Size="ButtonSize.Sm">@(AlvaStrings.Common_Cancel)</FlareButton></FlareStack>
            <FlareTextField @ref="_quickTitleField" Label="@(AlvaStrings.Common_Title)" @bind-Value="_quickTitle" Required MaxLength="500" />
            @if (QuickContext is { Length: > 0 } quickContext) { <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@quickContext</FlareText> }
            @if (_quickError is not null) { <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.Error">@_quickError</FlareText> }
            <FlareStack Row Wrap Gap="FlareSpacing.Small">
                <FlareButton Loading="_quickBusy" Disabled="@(string.IsNullOrWhiteSpace(_quickTitle))" OnClick="() => CreateQuick(false)">@(AlvaStrings.Tasks_Create)</FlareButton>
                <FlareButton Variant="ButtonVariant.Text" Disabled="_quickBusy" OnClick="() => CreateQuick(true)">@(AlvaStrings.Tasks_CreateAnother)</FlareButton>
                <FlareButton Variant="ButtonVariant.Text" OnClick="OpenFullForm">@(AlvaStrings.Common_MoreFields)</FlareButton>
            </FlareStack>
        </FlareStack>
    }
    else if (_editing is not null)
    {
        <FlareStack Gap="FlareSpacing.Medium">
            <FlareStack Row StretchFirst><FlareText Element="h2" Typo="TypographyScale.TitleLarge">@(_editing.Id == Guid.Empty ? AlvaStrings.Tasks_NewTask : AlvaStrings.Tasks_TaskCard)</FlareText><FlareButton OnClick="Close" Variant="ButtonVariant.Text" Size="ButtonSize.Sm">@(AlvaStrings.Common_Close)</FlareButton></FlareStack>
            @if (_formErrors.Count > 0) { <div tabindex="-1" @ref="_errorSummary"><AlvaValidationSummary Messages="_formErrors" /></div> }
            <FlareTextField Label="@(AlvaStrings.Common_Title)" @bind-Value="_editing.Title" ErrorText="@_titleError" Required MaxLength="500" Autofocus />
            <FlareTextArea Label="@(AlvaStrings.Common_Description)" @bind-Value="_editing.Description" AutoGrow />
            <FlareMultiSelect TValue="Guid" Label="@(AlvaStrings.Common_RequiredSkills)" Items="SkillActors.Select(a=>a.Id)"
                              ItemLabel="SkillName" Chips="true" Searchable="true"
                              Values="_editing.RequiredSkillIds" ValuesChanged="(IReadOnlyList<Guid> skills) => _editing.RequiredSkillIds = skills.ToArray()" />
            <TaskFormPlan Task="_editing" Projects="_projects" Tasks="_tasks"
                          SelfId="@(_editing.Id == Guid.Empty ? (Guid?)null : _editing.Id)"
                          ParentError="@_parentError" EstimateError="@_estimateError" RemainingError="@_remainingError"
                          LimitError="@_limitError" StartError="@_startError" EndError="@_endError" Changed="StateHasChanged" />
            <FlareSelect TValue="Guid?" Label="@(AlvaStrings.Tasks_AssigneeSubTeamOrRole)" Items="AssignableActorIds" ItemLabel="id => ActorName(id)" NullOption="@(AlvaStrings.Common_UnassignedTask)" @bind-Value="_editing.AssignmentTargetId" Searchable />
            <SkillMatch Required="_editing.RequiredSkillIds" Person="@(_actors.FirstOrDefault(a=>a.Id==(_editing.ResolvedPersonId ?? _editing.AssignmentTargetId)))" Skills="SkillActors" />
            @if(_actors.FirstOrDefault(a=>a.Id==_editing.AssignmentTargetId)?.Kind is "Department") { <FlareSelect TValue="Guid?" Label="@(AlvaStrings.Common_SpecificAssignee)" Items="@(_actors.Where(a=>a.Kind=="Person").Select(a=>(Guid?)a.Id))" ItemLabel="ActorName" NullOption="@(AlvaStrings.Tasks_NotChosenYet)" @bind-Value="_editing.ResolvedPersonId" Searchable /> }
            <FlareStack Row Wrap><FlareButton Loading="_busy" Disabled="@(string.IsNullOrWhiteSpace(_editing.Title) || !IsDirty)" OnClick="Save">@(AlvaStrings.Tasks_SaveTheTask)</FlareButton><EditorStatus Dirty="IsDirty" Saving="_busy" /></FlareStack>
        </FlareStack>
    }
    else if (Selected is { } selected)
    {
        <TaskDetails Item="selected" Tasks="_tasks" Projects="_projects" Sprints="_sprints" Actors="_actors" Changed="Load" HeadingLevel="2" Compact="true" />
    }
</FlareDrawer>
}
}
@code {
    [Parameter] public Guid? TaskId { get; set; }
    private TaskModel[] _tasks=[]; private ProjectModel[] _projects=[]; private SprintModel[] _sprints=[]; private ActorModel[] _actors=[]; private RiskDto[] _risks=[];
    private IEnumerable<ActorModel> SkillActors => _actors.Where(a => a.Kind == "Skill");
    private IEnumerable<Guid?> AssignableActorIds => _actors.Where(a => a.Kind is "Person" or "Department").Select(a => (Guid?)a.Id);
    private TaskModel? _editing; private string? _editingSnapshot; private IDisposable? _draft;
    private string? _error,_search,_statusFilter; private Guid? _projectFilter; private bool _busy,_loaded;
    private Guid? _assigneeFilter; private string? _priorityFilter,_deadlineFilter,_riskFilter;
    private string? _sortKey="order"; private bool _sortDescending;
    private readonly HashSet<Guid> _expanded=[];
    private Guid? _selectedId;
    private readonly DataGridContext<TaskModel> _grid = new();
    private DataGridTreeConfig<TaskModel>? _tree;
    private FlareDataGrid<TaskModel>? _dataGrid;
    private FlareDataGrid<TaskModel>? _sortedGrid;
    private bool _quickOpen, _quickBusy;
    private string? _quickTitle, _quickError;
    private Guid? _quickParentId, _quickProjectId;
    private string _quickStatus = "Backlog";
    private Guid? _highlightId;
    private FlareTextField? _quickTitleField;
    private bool _focusQuick;
    private string? _titleError,_parentError,_startError,_endError,_estimateError,_remainingError,_limitError;
    private readonly List<string> _formErrors=[]; private ElementReference _errorSummary;
    [CascadingParameter] public FlareConfirmDialogProvider? Confirm { get; set; }
    internal bool IsDirty => _editing is not null && DraftSnapshot.Of(_editing) != _editingSnapshot;
    private readonly string[] _statuses=["Backlog","Planned","InProgress","Done","Cancelled"];
    private static readonly string[] DeadlineFilters=["with","without"];
    private static readonly string[] RiskFilters=["with","without"];
    private IEnumerable<ActorModel> FilterAssignees => _actors.Where(a => a.Kind is "Person" or "Department");
    private static AlvaTone TaskStatusTone(string? status) => status == "Planned" ? AlvaTone.Neutral : AlvaTones.Status(status);
    private static string DeadlineFilterLabel(string key) => key == "with" ? AlvaStrings.Tasks_WithDeadline : AlvaStrings.Tasks_WithoutDeadline;
    private static string RiskFilterLabel(string key) => key == "with" ? AlvaStrings.Tasks_WithRisk : AlvaStrings.Tasks_WithoutRisk;
    private string Route => AppRoutes.Current(Navigation);
    private string PageHeading => Route == "my-work" ? AlvaStrings.Tasks_MyWork : Route == "unassigned" ? AlvaStrings.Common_Unassigned : AlvaStrings.Tasks_TeamTasks;
    private bool Matches(TaskModel t) => (string.IsNullOrWhiteSpace(_search) || t.Title.Contains(_search,StringComparison.OrdinalIgnoreCase)) && (!_projectFilter.HasValue || t.ProjectId==_projectFilter) && (_statusFilter is null || t.Status==_statusFilter) && (Route != "unassigned" || Assignees.Person(t,_actors) is null) && (Route != "my-work" || Assignees.Person(t,_actors) is { } person && Assignees.Me(_actors,Session.User).Contains(person)) && (!_assigneeFilter.HasValue || AssigneeMatches(t,_assigneeFilter.Value)) && (_priorityFilter is null || t.Priority==_priorityFilter) && (_deadlineFilter is null || (_deadlineFilter=="with" ? DeadlineOf(t) is not null : DeadlineOf(t) is null)) && (_riskFilter is null || (_riskFilter=="with" ? RiskOf(t) is not null : RiskOf(t) is null));
    private bool HasFilters => !string.IsNullOrWhiteSpace(_search) || _projectFilter.HasValue || _statusFilter is not null || _assigneeFilter.HasValue || _priorityFilter is not null || _deadlineFilter is not null || _riskFilter is not null;
    private TaskModel[]? _indexedTasks;
    private Dictionary<Guid, TaskModel> _byId = [];
    private Dictionary<Guid, List<TaskModel>> _childrenById = [];
    private List<TaskModel>? _matchedCache;
    private string? _matchedKey;
    private HashSet<Guid>? _includedCache;
    private string? _includedKey;
    private string FilterKey => $"{_search}|{_projectFilter}|{_statusFilter}|{_assigneeFilter}|{_priorityFilter}|{_deadlineFilter}|{_riskFilter}|{Route}|{_tasks.GetHashCode()}";
    private void EnsureIndex()
    {
        if (ReferenceEquals(_indexedTasks, _tasks)) return;
        _indexedTasks = _tasks;
        _byId = _tasks.ToDictionary(t => t.Id);
        _childrenById = _tasks.Where(t => t.ParentId is not null).GroupBy(t => t.ParentId!.Value).ToDictionary(g => g.Key, g => g.ToList());
        _matchedCache = null;
        _includedCache = null;
    }
    private IEnumerable<TaskModel> Matched
    {
        get
        {
            EnsureIndex();
            var key = FilterKey;
            if (_matchedCache is null || key != _matchedKey)
            {
                _matchedCache = _tasks.Where(Matches).ToList();
                _matchedKey = key;
            }
            return _matchedCache;
        }
    }
    private HashSet<Guid> IncludedIds
    {
        get
        {
            EnsureIndex();
            var key = FilterKey;
            if (_includedCache is not null && key == _includedKey) return _includedCache;
            var included = new HashSet<Guid>();
            foreach (var match in Matched)
            {
                TaskModel? current = match;
                while (current is not null && included.Add(current.Id))
                    current = current.ParentId is { } parentId && _byId.TryGetValue(parentId, out var parent) ? parent : null;
            }
            _includedKey = key;
            _includedCache = included;
            return included;
        }
    }
    private IEnumerable<TaskModel> Filtered => _tasks.Where(t => IncludedIds.Contains(t.Id));
    private IEnumerable<TaskModel> Roots => Filtered.Where(t => t.ParentId is null || !IncludedIds.Contains(t.ParentId.Value))
                                                   .OrderBy(t => t.Order).ThenBy(t => t.Title);
    private IEnumerable<TaskModel> ChildrenOf(TaskModel task) => (_childrenById.TryGetValue(task.Id, out var children) ? children : [])
        .Where(t => IncludedIds.Contains(t.Id)).OrderBy(t => t.Order).ThenBy(t => t.Title);
    private HashSet<TaskModel> ExpandedItems => _tasks.Where(t => _expanded.Contains(t.Id) || (HasFilters && IncludedIds.Contains(t.Id))).ToHashSet();
    private HashSet<TaskModel> GridSelection => _tasks.Where(t => t.Id == _selectedId).ToHashSet();
    private bool HasRows => _loaded && _error is null && _tasks.Length > 0 && Matched.Any();
    // A sorted view has no manual neighbour to drop before or after, so dragging is offered only in manual order.
    private bool ReorderEnabled => (_sortKey is null or "order") && !_sortDescending;
    private string RowClass(TaskModel task) => string.Join(" ", new[]
    {
        HasFilters && !Matches(task) ? "alva-task-row--context" : null,
        task.Id == _highlightId ? "alva-task-row--new" : null
    }.Where(value => value is not null));
    private async Task OnExpanded(DataGridTreeExpandChanged<TaskModel> change)
    {
        if (change.Expanded) _expanded.Add(change.Item.Id); else _expanded.Remove(change.Item.Id);
        await SaveTreeState();
    }
    private async Task OnSortChanged(IReadOnlyList<DataGridSort> sorts)
    {
        var first = sorts.FirstOrDefault();
        _sortKey = first?.Key;
        _sortDescending = first?.Direction == SortDirection.Descending;
        await SaveSort();
    }
    private Task Reordered(DataGridRowReorder<TaskModel> move)
    {
        // Inside makes the target the parent; before/after place the row among the target's siblings.
        var parentId = move.Position == DataGridRowDropPosition.Inside ? move.Target.Id : move.Parent?.Id;
        var siblings = _tasks.Where(t => t.ParentId == parentId && t.Id != move.Item.Id)
                             .OrderBy(t => t.Order).ThenBy(t => t.Title).ToList();
        var index = siblings.FindIndex(t => t.Id == move.Target.Id);
        if (move.Position == DataGridRowDropPosition.Inside || index < 0) index = siblings.Count;
        else if (move.Position == DataGridRowDropPosition.After) index++;
        siblings.Insert(Math.Clamp(index, 0, siblings.Count), move.Item);
        // A reparented row may already carry the order number of its new place; the move is still required.
        return ApplyOrder(parentId, siblings, move.Item.Id);
    }
    private Comparison<TaskModel> OrderComparison => CompareByOrder;
    private Comparison<TaskModel> StatusComparison => CompareByStatus;
    private Comparison<TaskModel> PriorityComparison => CompareByPriority;
    private Comparison<TaskModel> AssigneeComparison => CompareByAssignee;
    private Comparison<TaskModel> DeadlineComparison => CompareByDeadline;
    private Comparison<TaskModel> EstimateComparison => CompareByEstimate;
    private Comparison<TaskModel> ProjectComparison => CompareByProject;
    // Flare negates a column comparison for the descending direction, so each one states ascending only.
    private static int CompareByOrder(TaskModel a, TaskModel b)
    {
        var compared = a.Order.CompareTo(b.Order);
        return compared != 0 ? compared : string.Compare(a.Title, b.Title, StringComparison.CurrentCultureIgnoreCase);
    }
    private static int CompareByStatus(TaskModel a, TaskModel b) => StatusRank(a.Status).CompareTo(StatusRank(b.Status));
    private static int CompareByPriority(TaskModel a, TaskModel b) => PriorityRank(a.Priority).CompareTo(PriorityRank(b.Priority));
    private int CompareByAssignee(TaskModel a, TaskModel b) => CompareText(AssigneeSortName(a), AssigneeSortName(b));
    private static int CompareByDeadline(TaskModel a, TaskModel b) => CompareNullableDate(DeadlineOf(a), DeadlineOf(b));
    private static int CompareByEstimate(TaskModel a, TaskModel b) => CompareNullableDecimal(a.EstimateHours, b.EstimateHours);
    private int CompareByProject(TaskModel a, TaskModel b) => CompareText(ProjectOf(a), ProjectOf(b));
    private static int CompareNullableDate(DateOnly? a, DateOnly? b)
    {
        if (a is null && b is null) return 0;
        if (a is null) return 1;
        if (b is null) return -1;
        return a.Value.CompareTo(b.Value);
    }
    private static int CompareNullableDecimal(decimal? a, decimal? b)
    {
        if (a is null && b is null) return 0;
        if (a is null) return 1;
        if (b is null) return -1;
        return a.Value.CompareTo(b.Value);
    }
    private static int CompareText(string? a, string? b)
    {
        var aEmpty = string.IsNullOrWhiteSpace(a);
        var bEmpty = string.IsNullOrWhiteSpace(b);
        if (aEmpty && bEmpty) return 0;
        if (aEmpty) return 1;
        if (bEmpty) return -1;
        return string.Compare(a, b, StringComparison.CurrentCultureIgnoreCase);
    }
    private static int PriorityRank(string? priority) => priority switch { "Critical" => 3, "High" => 2, "Low" => 0, _ => 1 };
    private static int StatusRank(string? status) => status switch { "Planned" => 1, "InProgress" => 2, "Done" => 3, "Cancelled" => 4, "Backlog" => 0, _ => 5 };
    private static DateOnly? DeadlineOf(TaskModel task) => task.EffectiveDeadline ?? task.Deadline;
    private RiskDto? RiskOf(TaskModel task) => _risks.FirstOrDefault(r => r.TaskId == task.Id && r.HasRisk);
    private static string RiskReason(RiskDto risk) => ReasonText.Join(risk.Reasons);
    private string? ProjectOf(TaskModel task) => _projects.FirstOrDefault(p => p.Id == task.ProjectId)?.Name;
    private ActorModel? AssigneeActor(TaskModel task) => _actors.FirstOrDefault(a => a.Id == (task.ResolvedPersonId ?? task.AssignmentTargetId));
    private string? AssigneeSortName(TaskModel task) => AssigneeActor(task)?.Name;
    private string AssigneeLabel(TaskModel task) => AssigneeActor(task) is { } actor
        ? (actor.Kind == "Person" ? actor.Name : $"{actor.Name} - {Labels.Kind(actor.Kind)}")
        : AlvaStrings.Common_UnassignedTask;
    private bool AssigneeMatches(TaskModel task, Guid id) => task.AssignmentTargetId == id || Assignees.Person(task, _actors) == id;
    private static bool IsOverdue(TaskModel task) => task.Status is not ("Done" or "Cancelled") && DeadlineOf(task) is { } deadline && deadline < DateOnly.FromDateTime(DateTime.Today);
    private static FlareColor DeadlineTone(TaskModel task) => IsOverdue(task) ? FlareColor.Error : FlareColor.OnSurfaceVariant;
    private static string DeadlineTitle(TaskModel task)
    {
        var deadline = DeadlineOf(task);
        if (deadline is null) return "";
