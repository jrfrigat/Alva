@page "/tasks"
@page "/tasks/{TaskId:guid}"
@page "/unassigned"
@page "/my-work"
@implements IDisposable
@inject AlvaSession Session
@inject NavigationManager Navigation
@inject DraftGuard Drafts
@inject ISnackbarService Snackbar
<PageTitle>@(Current is null ? AlvaStrings.Common_Tasks : Current.Title) · Alva</PageTitle>
<NavigationLock OnBeforeInternalNavigation="ConfirmLeave" ConfirmExternalNavigation="IsDirty" />
@if (Current is not null)
{
    <PageFeedback Error="@_error" Loading="_busy" OnRetry="Load" />
    <FlareButton Href="tasks" Variant="ButtonVariant.Text" Size="ButtonSize.Sm">@(AlvaStrings.Tasks_BackToTree)</FlareButton>
    @* Esc closes the card and returns to the list with the previous filters; unsaved edits are not
       discarded - the card itself holds them, and then Esc does nothing. The wrapper takes focus when
       the task opens, including via Enter from the list, so focus does not fall to body. *@
    <div class="alva-task-card" @ref="_card" tabindex="-1" aria-label="@Current.Title" @onkeydown="OnCardKey">
        <TaskDetails @ref="_details" Item="Current" Tasks="_tasks" Projects="_projects" Sprints="_sprints" Actors="_actors" Changed="Load" />
    </div>
}
else if (TaskId.HasValue)
{
    @* A link to a specific task never turns into a list: while loading - progress, on error - the error,
       and if the task does not exist - it says so. *@
    <PageFeedback Error="@_error" Loading="_busy" OnRetry="Load" />
    @if (_loaded && _error is null) { <UnavailableState Title="@(AlvaStrings.Tasks_TaskNotFoundOrUnavailable)" BackHref="tasks" BackLabel="@(AlvaStrings.Common_ToTasks)" /> }
}
else
{
<AlvaPageHeader Category="@(AlvaStrings.Tasks_PlanningTasks)" Title="@PageHeading" Description="@(AlvaStrings.Tasks_TheTeamSTaskPoolTreeStatusesAndAssignments)">
    <Actions><FlareButton @ref="_newButton" OnClick="() => OpenQuickCreate(null)" Disabled="@(Session.TeamId is null)" Size="ButtonSize.Sm">@(AlvaStrings.Tasks_NewTask)</FlareButton></Actions>
</AlvaPageHeader>
<PageFeedback Error="@_error" Loading="_busy" OnRetry="Load" />
@if(Session.TeamId is null) { <TeamRequired /> }
else
{
<FlareStack Row Wrap Gap="FlareSpacing.Small" Class="alva-task-filters">
    <FlareTextField Label="@(AlvaStrings.Tasks_SearchTasks)" @bind-Value="_search" @bind-Value:after="SaveListContext" Immediate Clearable Style="flex:2;min-width:min(100%,15rem)" />
    <FlareSelect TValue="Guid?" Label="@(AlvaStrings.Common_Project)" Items="_projects.Select(x => (Guid?)x.Id)" ItemLabel="ProjectName" NullOption="@(AlvaStrings.Projects_AllProjects)" @bind-Value="_projectFilter" @bind-Value:after="SaveListContext" Style="flex:1;min-width:12rem" />
    <FlareSelect TValue="string" Label="@(AlvaStrings.Common_Status)" Items="_statuses" ItemLabel="Labels.Status" NullOption="@(AlvaStrings.Tasks_AllStatuses)" @bind-Value="_statusFilter" @bind-Value:after="SaveListContext" Style="flex:1;min-width:12rem" />
</FlareStack>
<FlareStack Row Wrap Gap="FlareSpacing.Small" Class="alva-task-filters">
    <FlareSelect TValue="Guid?" Label="@(AlvaStrings.Tasks_FilterAssignee)" Items="FilterAssignees.Select(a => (Guid?)a.Id)" ItemLabel="ActorName" NullOption="@(AlvaStrings.Tasks_AnyAssignee)" @bind-Value="_assigneeFilter" @bind-Value:after="SaveExtraFilters" Searchable Style="flex:1;min-width:12rem" />
    <FlareSelect TValue="string" Label="@(AlvaStrings.Tasks_FilterPriority)" Items="Labels.Priorities" ItemLabel="Labels.Priority" NullOption="@(AlvaStrings.Tasks_AnyPriority)" @bind-Value="_priorityFilter" @bind-Value:after="SaveExtraFilters" Style="flex:1;min-width:10rem" />
    <FlareSelect TValue="string" Label="@(AlvaStrings.Tasks_FilterDeadline)" Items="DeadlineFilters" ItemLabel="DeadlineFilterLabel" NullOption="@(AlvaStrings.Tasks_AnyDeadline)" @bind-Value="_deadlineFilter" @bind-Value:after="SaveExtraFilters" Style="flex:1;min-width:10rem" />
    <FlareSelect TValue="string" Label="@(AlvaStrings.Tasks_FilterRisk)" Items="RiskFilters" ItemLabel="RiskFilterLabel" NullOption="@(AlvaStrings.Tasks_AnyRisk)" @bind-Value="_riskFilter" @bind-Value:after="SaveExtraFilters" Style="flex:1;min-width:10rem" />
</FlareStack>
@if (HasFilters)
{
<FlareStack Row Wrap Gap="FlareSpacing.Small" Class="alva-task-active-filters">
    @if (!string.IsNullOrWhiteSpace(_search)) { <FlareChip Closable="true" OnClose="ClearSearch">@(AlvaStrings.Tasks_FilterSearch): @_search</FlareChip> }
    @if (_projectFilter is { } projectId) { <FlareChip Closable="true" OnClose="ClearProject">@(AlvaStrings.Common_Project): @ProjectName(projectId)</FlareChip> }
    @if (_statusFilter is { } status) { <FlareChip Closable="true" OnClose="ClearStatus">@(AlvaStrings.Common_Status): @Labels.Status(status)</FlareChip> }
    @if (_assigneeFilter is { } assigneeId) { <FlareChip Closable="true" OnClose="ClearAssignee">@(AlvaStrings.Tasks_FilterAssignee): @ActorName(assigneeId)</FlareChip> }
    @if (_priorityFilter is { } priority) { <FlareChip Closable="true" OnClose="ClearPriority">@(AlvaStrings.Common_Priority): @Labels.Priority(priority)</FlareChip> }
    @if (_deadlineFilter is { } deadline) { <FlareChip Closable="true" OnClose="ClearDeadline">@(AlvaStrings.Tasks_FilterDeadline): @DeadlineFilterLabel(deadline)</FlareChip> }
    @if (_riskFilter is { } riskFilter) { <FlareChip Closable="true" OnClose="ClearRisk">@(AlvaStrings.Tasks_FilterRisk): @RiskFilterLabel(riskFilter)</FlareChip> }
    <FlareButton Variant="ButtonVariant.Text" Size="ButtonSize.Sm" OnClick="ClearFilters">@(AlvaStrings.Tasks_ClearFilters)</FlareButton>
</FlareStack>
<FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@string.Format(AlvaStrings.Tasks_FoundCount, Matched.Count())</FlareText>
}
<FlareStack Row Wrap Gap="FlareSpacing.Small"><FlareButton Href="tasks" Variant="ButtonVariant.Text" Size="ButtonSize.Sm">@(AlvaStrings.Gantt_AllTasks)</FlareButton><FlareButton Href="unassigned" Variant="ButtonVariant.Text" Size="ButtonSize.Sm">@(AlvaStrings.Common_Unassigned)</FlareButton><FlareButton Href="my-work" Variant="ButtonVariant.Text" Size="ButtonSize.Sm">@(AlvaStrings.Tasks_MyWork)</FlareButton><FlareButton OnClick="Load" Variant="ButtonVariant.Text" Size="ButtonSize.Sm">@(AlvaStrings.Tasks_Refresh)</FlareButton></FlareStack>
<FlareCard Variant="CardVariant.Outlined"><FlareCardContent>
    @if (!_loaded) { <LoadingSkeleton Height="24rem" /> }
    else if (_error is not null) { }
    else if (_tasks.Length == 0) { <FlareEmptyState Compact Title="@(AlvaStrings.Common_NoTasksYet)" Description="@(AlvaStrings.Tasks_AddTheFirstTaskOrChangeTheFilters)" /> }
    else if (!Matched.Any()) { <FlareEmptyState Compact Title="@(AlvaStrings.Tasks_NoTasksByFilters)" Description="@(AlvaStrings.Tasks_ClearFilters)" /><FlareButton Variant="ButtonVariant.Text" Size="ButtonSize.Sm" OnClick="ClearFilters">@(AlvaStrings.Tasks_ClearFilters)</FlareButton> }
    else {
    <div class="alva-tree" role="treegrid" aria-label="@(AlvaStrings.Tasks_TeamTasks)" id="@TaskListState.TreeElementId">
        <div class="alva-tree__head" role="row">
            <div class="alva-tree__cell alva-tree__cell--task" role="columnheader" aria-sort="@SortOrder"><button type="button" class="alva-tree__sort" @onclick="ByOrder">@(AlvaStrings.Common_Task)</button></div>
            <div class="alva-tree__cell" role="columnheader" aria-sort="@SortStatus"><button type="button" class="alva-tree__sort" @onclick="ByStatus">@(AlvaStrings.Common_Status)</button></div>
            <div class="alva-tree__cell" role="columnheader" aria-sort="@SortPriority"><button type="button" class="alva-tree__sort" @onclick="ByPriority">@(AlvaStrings.Common_Priority)</button></div>
            <div class="alva-tree__cell" role="columnheader" aria-sort="@SortAssignee"><button type="button" class="alva-tree__sort" @onclick="ByAssignee">@(AlvaStrings.Tasks_FilterAssignee)</button></div>
            <div class="alva-tree__cell" role="columnheader" aria-sort="@SortDeadline"><button type="button" class="alva-tree__sort" @onclick="ByDeadline">@(AlvaStrings.Common_Deadline)</button></div>
            <div class="alva-tree__cell" role="columnheader" aria-sort="@SortEstimate"><button type="button" class="alva-tree__sort" @onclick="ByEstimate">@(AlvaStrings.Common_Estimate)</button></div>
            <div class="alva-tree__cell" role="columnheader">@(AlvaStrings.Tasks_FilterRisk)</div>
            <div class="alva-tree__cell" role="columnheader" aria-sort="@SortProject"><button type="button" class="alva-tree__sort" @onclick="ByProject">@(AlvaStrings.Common_Project)</button></div>
        </div>
        @foreach (var row in Rows)
        {
            <div class="alva-tree__row @RowClass(row.Task)" role="row" aria-level="@(row.Depth + 1)" aria-expanded="@(row.HasChildren ? (row.Expanded ? "true" : "false") : null)" @key="row.Task.Id" @onclick="() => Open(row.Task)">
                <div class="alva-tree__cell alva-tree__cell--task" role="gridcell" style="--alva-depth:@row.Depth">
                    @if (row.HasChildren) { <button type="button" class="alva-tree__toggle" aria-label="@(row.Expanded ? AlvaStrings.Tasks_Collapse : AlvaStrings.Tasks_Expand)" @onclick:stopPropagation="true" @onclick="() => Toggle(row.Task)">@(row.Expanded ? "v" : ">")</button> }
                    else { <span class="alva-tree__toggle alva-tree__toggle--empty" aria-hidden="true"></span> }
                    <span @onclick:stopPropagation="true" @onclick="() => Open(row.Task)" @onclick:preventDefault="true"><FlareLink Href="@($"tasks/{row.Task.Id}")">@row.Task.Title</FlareLink></span>
                    <button type="button" class="alva-tree__add" aria-label="@AlvaStrings.Tasks_AddSubtask" title="@AlvaStrings.Tasks_AddSubtask" @onclick:stopPropagation="true" @onclick="() => OpenQuickCreate(row.Task.Id)">+</button>
                    <div class="alva-tree__meta">
                        <AlvaStatusChip Tone="AlvaTones.Status(row.Task.Status)">@Labels.Status(row.Task.Status)</AlvaStatusChip>
                        @if (row.Task.Priority is not "Normal") { <AlvaStatusChip Tone="AlvaTones.Priority(row.Task.Priority)">@Labels.Priority(row.Task.Priority)</AlvaStatusChip> }
                        @if (ProjectOf(row.Task) is { } mobileProject) { <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant" title="@(AlvaStrings.Common_Project)">@mobileProject</FlareText> }
                        <FlareText Typo="TypographyScale.BodySmall" Color="@(AssigneeActor(row.Task) is null ? FlareColor.Warning : FlareColor.OnSurfaceVariant)" title="@(AlvaStrings.Tasks_FilterAssignee)">@AssigneeLabel(row.Task)</FlareText>
                        @if (DeadlineOf(row.Task) is { } mobileDeadline) { <FlareText Typo="TypographyScale.BodySmall" Color="@DeadlineTone(row.Task)" title="@DeadlineTitle(row.Task)">@mobileDeadline.ToString("d MMM")</FlareText> }
                        <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant" title="@(AlvaStrings.Tasks_RemainingShort)">@EffortLabel(row.Task)</FlareText>
                        @if (RiskOf(row.Task) is { } mobileRisk) { <AlvaStatusChip Tone="AlvaTones.Severity(mobileRisk.Severity)" Title="@RiskReason(mobileRisk)">@(mobileRisk.Severity == "High" ? AlvaStrings.Common_High : AlvaStrings.Risks_Medium)</AlvaStatusChip> }
                    </div>
                </div>
                <div class="alva-tree__cell alva-tree__cell--optional" role="gridcell"><AlvaStatusChip Tone="AlvaTones.Status(row.Task.Status)">@Labels.Status(row.Task.Status)</AlvaStatusChip></div>
                <div class="alva-tree__cell alva-tree__cell--optional" role="gridcell">@if (row.Task.Priority is not "Normal") { <AlvaStatusChip Tone="AlvaTones.Priority(row.Task.Priority)">@Labels.Priority(row.Task.Priority)</AlvaStatusChip> } else { <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@Labels.Priority(row.Task.Priority)</FlareText> }</div>
                <div class="alva-tree__cell alva-tree__cell--optional" role="gridcell"><FlareText Typo="TypographyScale.BodySmall" Color="@(AssigneeActor(row.Task) is null ? FlareColor.Warning : FlareColor.OnSurfaceVariant)">@AssigneeLabel(row.Task)</FlareText></div>
                <div class="alva-tree__cell alva-tree__cell--optional" role="gridcell">@if (DeadlineOf(row.Task) is { } desktopDeadline) { <FlareText Typo="TypographyScale.BodySmall" Color="@DeadlineTone(row.Task)" title="@DeadlineTitle(row.Task)">@desktopDeadline.ToString("d MMM")</FlareText> } else { <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">-</FlareText> }</div>
                <div class="alva-tree__cell alva-tree__cell--optional" role="gridcell"><FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@EffortLabel(row.Task)</FlareText></div>
                <div class="alva-tree__cell alva-tree__cell--optional" role="gridcell">@if (RiskOf(row.Task) is { } desktopRisk) { <AlvaStatusChip Tone="AlvaTones.Severity(desktopRisk.Severity)" Title="@RiskReason(desktopRisk)">@(desktopRisk.Severity == "High" ? AlvaStrings.Common_High : AlvaStrings.Risks_Medium)</AlvaStatusChip> } else { <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">-</FlareText> }</div>
                <div class="alva-tree__cell alva-tree__cell--optional" role="gridcell"><FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@(ProjectOf(row.Task) ?? "-")</FlareText></div>
            </div>
        }
    </div>
    }
</FlareCardContent></FlareCard>
@if(_editing is not null)
{
<FlareCard Variant="CardVariant.Outlined"><FlareCardContent><FlareStack Gap="FlareSpacing.Medium">
    <FlareStack Row StretchFirst><FlareText Element="h2" Typo="TypographyScale.TitleLarge">@(_editing.Id == Guid.Empty ? AlvaStrings.Tasks_NewTask : AlvaStrings.Tasks_TaskCard)</FlareText><FlareButton OnClick="Close" Variant="ButtonVariant.Text" Size="ButtonSize.Sm">@(AlvaStrings.Common_Close)</FlareButton></FlareStack>
    @if (_formErrors.Count > 0) { <div tabindex="-1" @ref="_errorSummary"><AlvaValidationSummary Messages="_formErrors" /></div> }
    <FlareTextField Label="@(AlvaStrings.Common_Title)" @bind-Value="_editing.Title" ErrorText="@_titleError" Required MaxLength="500" Autofocus />
    <FlareTextArea Label="@(AlvaStrings.Common_Description)" @bind-Value="_editing.Description" AutoGrow />
    <FlareMultiSelect TValue="Guid" Label="@(AlvaStrings.Common_RequiredSkills)" Items="SkillActors.Select(a=>a.Id)"
                      ItemLabel="SkillName" Chips="true" Searchable="true"
                      Values="_editing.RequiredSkillIds" ValuesChanged="(IReadOnlyList<Guid> skills) => _editing.RequiredSkillIds = skills.ToArray()" />
    <TaskFormPlan Task="_editing" Projects="_projects" Sprints="_sprints" Tasks="_tasks"
                  SelfId="@(_editing.Id == Guid.Empty ? (Guid?)null : _editing.Id)"
                  ParentError="@_parentError" EstimateError="@_estimateError" RemainingError="@_remainingError"
                  LimitError="@_limitError" StartError="@_startError" EndError="@_endError" Changed="StateHasChanged" />
    <FlareSelect TValue="Guid?" Label="@(AlvaStrings.Tasks_AssigneeSubTeamOrRole)" Items="AssignableActorIds" ItemLabel="id => ActorName(id)" NullOption="@(AlvaStrings.Common_UnassignedTask)" @bind-Value="_editing.AssignmentTargetId" Searchable />
    <SkillMatch Required="_editing.RequiredSkillIds" Person="@(_actors.FirstOrDefault(a=>a.Id==(_editing.ResolvedPersonId ?? _editing.AssignmentTargetId)))" Skills="SkillActors" />
    @if(_actors.FirstOrDefault(a=>a.Id==_editing.AssignmentTargetId)?.Kind is "Department") { <FlareSelect TValue="Guid?" Label="@(AlvaStrings.Common_SpecificAssignee)" Items="@(_actors.Where(a=>a.Kind=="Person").Select(a=>(Guid?)a.Id))" ItemLabel="ActorName" NullOption="@(AlvaStrings.Tasks_NotChosenYet)" @bind-Value="_editing.ResolvedPersonId" Searchable /> }
    <FlareStack Row Wrap><FlareButton Loading="_busy" Disabled="@(string.IsNullOrWhiteSpace(_editing.Title) || !IsDirty)" OnClick="Save">@(AlvaStrings.Tasks_SaveTheTask)</FlareButton><EditorStatus Dirty="IsDirty" Saving="_busy" /></FlareStack>
</FlareStack></FlareCardContent></FlareCard>
}
@if (Selected is { } selected)
{
    <FlareDrawer Anchor="DrawerAnchor.Right" Open="_selectedId.HasValue" OpenChanged="OnDrawerOpen" Width="34rem" ContentPadding="FlareSpacing.Large" AriaLabel="@(AlvaStrings.Common_Task)">
        <TaskDetails Item="selected" Tasks="_tasks" Projects="_projects" Sprints="_sprints" Actors="_actors" Changed="Load" HeadingLevel="2" Compact="true" />
    </FlareDrawer>
}
<FlareDrawer Anchor="DrawerAnchor.Bottom" Open="_quickOpen" OpenChanged="OnQuickOpen" Height="auto" ContentPadding="FlareSpacing.Large" AriaLabel="@(AlvaStrings.Tasks_NewTask)">
    <FlareStack Gap="FlareSpacing.Medium">
        <FlareText Element="h2" Typo="TypographyScale.TitleLarge">@(AlvaStrings.Tasks_NewTask)</FlareText>
        <FlareTextField @ref="_quickTitleField" Label="@(AlvaStrings.Common_Title)" @bind-Value="_quickTitle" Required MaxLength="500" />
        @if (QuickContext is { Length: > 0 } quickContext) { <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@quickContext</FlareText> }
        @if (_quickError is not null) { <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.Error">@_quickError</FlareText> }
        <FlareStack Row Wrap Gap="FlareSpacing.Small">
            <FlareButton Loading="_quickBusy" Disabled="@(string.IsNullOrWhiteSpace(_quickTitle))" OnClick="() => CreateQuick(false)">@(AlvaStrings.Tasks_Create)</FlareButton>
            <FlareButton Variant="ButtonVariant.Text" Disabled="_quickBusy" OnClick="() => CreateQuick(true)">@(AlvaStrings.Tasks_CreateAnother)</FlareButton>
            <FlareButton Variant="ButtonVariant.Text" OnClick="OpenFullForm">@(AlvaStrings.Common_MoreFields)</FlareButton>
            <FlareButton Variant="ButtonVariant.Text" OnClick="CloseQuick">@(AlvaStrings.Common_Cancel)</FlareButton>
        </FlareStack>
    </FlareStack>
</FlareDrawer>
}
}
@code {
    [Parameter] public Guid? TaskId { get; set; }
    private TaskModel[] _tasks=[]; private ProjectModel[] _projects=[]; private SprintModel[] _sprints=[]; private ActorModel[] _actors=[]; private RiskDto[] _risks=[];
    private IEnumerable<ActorModel> SkillActors => _actors.Where(a => a.Kind == "Skill");
    private IEnumerable<Guid?> AssignableActorIds => _actors.Where(a => a.Kind is "Person" or "Department").Select(a => (Guid?)a.Id);
    private TaskModel? _editing; private string? _editingSnapshot; private IDisposable? _draft;
    private string? _error,_search,_statusFilter; private Guid? _projectFilter; private bool _busy,_loaded;
    private Guid? _assigneeFilter; private string? _priorityFilter,_deadlineFilter,_riskFilter;
    private string _sortKey="order"; private bool _sortDescending;
    private readonly HashSet<Guid> _expanded=[];
    private Guid? _selectedId;
    private bool _quickOpen, _quickBusy;
    private string? _quickTitle, _quickError;
    private Guid? _quickParentId, _quickProjectId, _quickSprintId;
    private string _quickStatus = "Backlog";
    private Guid? _highlightId;
    private FlareTextField? _quickTitleField;
    private bool _focusQuick;
    private string? _titleError,_parentError,_startError,_endError,_estimateError,_remainingError,_limitError;
    private readonly List<string> _formErrors=[]; private ElementReference _errorSummary;
    [CascadingParameter] public FlareConfirmDialogProvider? Confirm { get; set; }
    internal bool IsDirty => _editing is not null && DraftSnapshot.Of(_editing) != _editingSnapshot;
    private double _pendingScroll;
    private readonly string[] _statuses=["Backlog","Planned","InProgress","Done","Cancelled"];
    private static readonly string[] DeadlineFilters=["with","without"];
    private static readonly string[] RiskFilters=["with","without"];
    private IEnumerable<ActorModel> FilterAssignees => _actors.Where(a => a.Kind is "Person" or "Department");
    private string SortOrder => SortAria("order");
    private string SortStatus => SortAria("status");
    private string SortPriority => SortAria("priority");
    private string SortAssignee => SortAria("assignee");
    private string SortDeadline => SortAria("deadline");
    private string SortEstimate => SortAria("estimate");
    private string SortProject => SortAria("project");
    private string SortAria(string key) => _sortKey == key ? (_sortDescending ? "descending" : "ascending") : "none";
    private static string DeadlineFilterLabel(string key) => key == "with" ? AlvaStrings.Tasks_WithDeadline : AlvaStrings.Tasks_WithoutDeadline;
    private static string RiskFilterLabel(string key) => key == "with" ? AlvaStrings.Tasks_WithRisk : AlvaStrings.Tasks_WithoutRisk;
    private string Route => AppRoutes.Current(Navigation);
    private string PageHeading => Route == "my-work" ? AlvaStrings.Tasks_MyWork : Route == "unassigned" ? AlvaStrings.Common_Unassigned : AlvaStrings.Tasks_TeamTasks;
    private bool Matches(TaskModel t) => (string.IsNullOrWhiteSpace(_search) || t.Title.Contains(_search,StringComparison.OrdinalIgnoreCase)) && (!_projectFilter.HasValue || t.ProjectId==_projectFilter) && (_statusFilter is null || t.Status==_statusFilter) && (Route != "unassigned" || Assignees.Person(t,_actors) is null) && (Route != "my-work" || Assignees.Person(t,_actors) is { } person && Assignees.Me(_actors,Session.User).Contains(person)) && (!_assigneeFilter.HasValue || AssigneeMatches(t,_assigneeFilter.Value)) && (_priorityFilter is null || t.Priority==_priorityFilter) && (_deadlineFilter is null || (_deadlineFilter=="with" ? DeadlineOf(t) is not null : DeadlineOf(t) is null)) && (_riskFilter is null || (_riskFilter=="with" ? RiskOf(t) is not null : RiskOf(t) is null));
    private IEnumerable<TaskModel> Matched => _tasks.Where(Matches);
    private bool HasFilters => !string.IsNullOrWhiteSpace(_search) || _projectFilter.HasValue || _statusFilter is not null || _assigneeFilter.HasValue || _priorityFilter is not null || _deadlineFilter is not null || _riskFilter is not null;
    private HashSet<Guid> IncludedIds
    {
        get
        {
            var byId = _tasks.ToDictionary(t => t.Id);
            var included = new HashSet<Guid>();
            foreach (var match in Matched)
            {
                TaskModel? current = match;
                while (current is not null && included.Add(current.Id))
                    current = current.ParentId is { } parentId && byId.TryGetValue(parentId, out var parent) ? parent : null;
            }
            return included;
        }
    }
    private IEnumerable<TaskModel> Filtered => _tasks.Where(t => IncludedIds.Contains(t.Id));
    private IEnumerable<TaskModel> Roots => Sorted(Filtered.Where(t=>t.ParentId is null || !Filtered.Any(p=>p.Id==t.ParentId)));
    private IEnumerable<TaskRow> Rows => Flatten(Roots, 0, HasFilters ? IncludedIds : new HashSet<Guid>());
    private IEnumerable<TaskRow> Flatten(IEnumerable<TaskModel> tasks, int depth, HashSet<Guid> autoExpand)
    {
        foreach (var task in tasks)
        {
            var children = ChildrenOf(task).ToList();
            var expanded = _expanded.Contains(task.Id) || autoExpand.Contains(task.Id);
            yield return new TaskRow(task, depth, children.Count > 0, expanded);
            if (expanded)
                foreach (var child in Flatten(children, depth + 1, autoExpand))
                    yield return child;
        }
    }
    private IEnumerable<TaskModel> ChildrenOf(TaskModel task) => Sorted(Filtered.Where(t => t.ParentId == task.Id));
    private sealed record TaskRow(TaskModel Task, int Depth, bool HasChildren, bool Expanded);
    private string RowClass(TaskModel task) => string.Join(" ", new[]
    {
        HasFilters && !Matches(task) ? "alva-tree__row--context" : null,
        task.Id == _highlightId ? "alva-tree__row--new" : null
    }.Where(value => value is not null));
    private IEnumerable<TaskModel> Sorted(IEnumerable<TaskModel> tasks)
    {
        var result = tasks.ToList();
        result.Sort(CompareTasks);
        return result;
    }
    private int CompareTasks(TaskModel a, TaskModel b)
    {
        var direction = _sortDescending ? -1 : 1;
        var compared = _sortKey switch
        {
            "deadline" => CompareNullableDate(DeadlineOf(a), DeadlineOf(b), direction),
            "priority" => direction * PriorityRank(a.Priority).CompareTo(PriorityRank(b.Priority)),
            "project" => CompareText(ProjectOf(a), ProjectOf(b), direction),
            "assignee" => CompareText(AssigneeSortName(a), AssigneeSortName(b), direction),
            "status" => direction * StatusRank(a.Status).CompareTo(StatusRank(b.Status)),
            "estimate" => CompareNullableDecimal(a.EstimateHours, b.EstimateHours, direction),
            _ => direction * a.Order.CompareTo(b.Order)
        };
        if (compared == 0) compared = a.Order.CompareTo(b.Order);
        if (compared == 0) compared = string.Compare(a.Title, b.Title, StringComparison.CurrentCultureIgnoreCase);
        return compared;
    }
    private static int CompareNullableDate(DateOnly? a, DateOnly? b, int direction)
    {
        if (a is null && b is null) return 0;
        if (a is null) return 1;
        if (b is null) return -1;
        return direction * a.Value.CompareTo(b.Value);
    }
    private static int CompareNullableDecimal(decimal? a, decimal? b, int direction)
    {
        if (a is null && b is null) return 0;
        if (a is null) return 1;
        if (b is null) return -1;
        return direction * a.Value.CompareTo(b.Value);
    }
    private static int CompareText(string? a, string? b, int direction)
    {
        var aEmpty = string.IsNullOrWhiteSpace(a);
        var bEmpty = string.IsNullOrWhiteSpace(b);
        if (aEmpty && bEmpty) return 0;
        if (aEmpty) return 1;
        if (bEmpty) return -1;
        return direction * string.Compare(a, b, StringComparison.CurrentCultureIgnoreCase);
    }
