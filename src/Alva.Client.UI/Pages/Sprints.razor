@page "/sprints"
@page "/sprints/plan"
@page "/sprints/{SprintId:guid}"
@page "/sprints/{SprintId:guid}/plan"
@implements IDisposable
@inject AlvaSession Session
@inject NavigationManager Navigation
@inject DraftGuard Drafts
@inject IRealtimeService Realtime
<PageTitle>@(Planning ? AlvaStrings.Common_Planning : Current?.Name ?? AlvaStrings.Sprint_Sprints) · Alva</PageTitle>
<NavigationLock OnBeforeInternalNavigation="ConfirmLeave" ConfirmExternalNavigation="IsDirty" />
@if(SprintId is null && !Planning)
{
<AlvaPageHeader Title="@(AlvaStrings.Sprint_TeamSprints)">
    <Actions><FlareButton @ref="_newButton" Size="ButtonSize.Sm" OnClick="New" Disabled="@(Session.TeamId is null)">@(AlvaStrings.Sprint_NewSprint)</FlareButton></Actions>
</AlvaPageHeader>
}
<PageFeedback Loading="_busy" Error="@_error" OnRetry="Load" />
@if(Session.TeamId is null){<TeamRequired />}
else
{
@if(_editing is not null)
{
<FlareCard Variant="CardVariant.Outlined"><FlareCardContent><FlareStack Gap="FlareSpacing.Large">
    <FlareStack Row StretchFirst><FlareText Element="h2" Typo="TypographyScale.TitleLarge">@(_editing.Id==Guid.Empty?AlvaStrings.Sprint_NewSprint:AlvaStrings.Sprint_SprintSettings)</FlareText><FlareButton OnClick="Close" Variant="ButtonVariant.Text" Size="ButtonSize.Sm">@(AlvaStrings.Common_Close)</FlareButton></FlareStack>
    @if (_formErrors.Count > 0) { <div tabindex="-1" @ref="_errorSummary"><AlvaValidationSummary Messages="_formErrors" /></div> }
    <FlareGrid MinColumnWidth="min(100%,15rem)">
        <FlareTextField Label="@(AlvaStrings.Common_Title)" ErrorText="@_nameError" @bind-Value="_editing.Name" Required Autofocus /><FlareTextField Label="@(AlvaStrings.Sprint_Goal)" @bind-Value="_editing.Goal" />
        <FlareDatePicker Label="@(AlvaStrings.Common_Start)" @bind-Value="_start" /><FlareDatePicker Label="@(AlvaStrings.Common_End)" ErrorText="@_endError" @bind-Value="_end" Min="_start" />
        <FlareSelect TValue="string" Label="@(AlvaStrings.Common_Status)" Items="_statuses" ItemLabel="Labels.Status" @bind-Value="_editing.Status" />
    </FlareGrid>
    <FlareStack Row><FlareButton OnClick="Save" Loading="_busy" Disabled="@(string.IsNullOrWhiteSpace(_editing.Name) || !_start.HasValue || !_end.HasValue || !IsDirty)">@(AlvaStrings.Sprint_SaveTheSprint)</FlareButton><EditorStatus Dirty="IsDirty" Saving="_busy" /></FlareStack>
</FlareStack></FlareCardContent></FlareCard>
}
@if(Planning)
{
    <FlareStack Gap="FlareSpacing.Medium">
    <FlareText Element="h1" Typo="TypographyScale.HeadlineSmall">@PlanningTitle</FlareText>
    @if (SprintId.HasValue && Current is null)
    {
        if (_loaded) { <UnavailableState Title="@(AlvaStrings.Sprint_SprintNotFoundOrUnavailable)" BackHref="sprints" BackLabel="@(AlvaStrings.Sprint_ToSprints)" /> }
    }
    else if (PlanSprint is not null)
    {
        <SprintPlanning @ref="_planning" Sprint="PlanSprint" Sprints="_sprints" Tasks="_tasks" Changed="Reload" OnParams="() => Edit(PlanSprint!)" />
    }
    else if (_loaded)
    {
        <FlareEmptyState Title="@(AlvaStrings.Sprint_NothingToPlan)" Description="@(AlvaStrings.Sprint_CreateASprintToGatherTasksFromThePool)"><ActionContent><FlareButton @ref="_emptyNewButton" Size="ButtonSize.Sm" OnClick="New">@(AlvaStrings.Sprint_NewSprint)</FlareButton></ActionContent></FlareEmptyState>
    }
    </FlareStack>
}
else if(SprintId is null){<SprintRegistry Sprints="_sprints" Tasks="_tasks" />}
else if(Current is not null){<SprintDetails Sprint="Current" Tasks="_tasks" Sprints="_sprints" OnEdit="@(()=>Navigation.NavigateTo($"sprints/{Current.Id}/plan"))" Changed="Load" />}
else if(_loaded){<UnavailableState Title="@(AlvaStrings.Sprint_SprintNotFoundOrUnavailable)" BackHref="sprints" BackLabel="@(AlvaStrings.Sprint_ToSprints)" />}
}
@code {
    [Parameter]public Guid? SprintId{get;set;}
    private SprintModel[] _sprints=[];private TaskModel[] _tasks=[];private SprintModel? _editing;private DateOnly? _start,_end;private bool _busy,_loaded;private string? _error;private readonly string[] _statuses=["Planned","Active","Completed"];
    private string? _editingSnapshot; private IDisposable? _draft;
    private string? _nameError,_endError; private readonly List<string> _formErrors=[]; private ElementReference _errorSummary;
    [CascadingParameter] public FlareConfirmDialogProvider? Confirm { get; set; }
    internal bool IsDirty => _editing is not null && DraftSnapshot.Of(_editing, _start, _end) != _editingSnapshot;
    private RealtimeRefresh? _refresh;

    protected override void OnInitialized()
    {
        _draft = Drafts.Track(() => IsDirty);
        _refresh = new RealtimeRefresh(() => !Drafts.HasDirty);
        Realtime.TaskChanged += OnRealtimeTaskChanged;
        Realtime.Resynced += OnRealtimeResynced;
    }

    private void OnRealtimeTaskChanged(TaskChangedEvent change)
    {
        if (change.TeamId != Session.TeamId) return;
        _ = InvokeAsync(() => { _refresh?.Schedule(ReloadQuietly); return Task.CompletedTask; });
    }

    private void OnRealtimeResynced()
    {
        _ = InvokeAsync(() => { _refresh?.Schedule(ReloadQuietly); return Task.CompletedTask; });
    }

    // A task changed elsewhere: refresh sprints and tasks without the loading bar, then let the planning
    // board reload its Gantt and capacity. A draft holds the refresh back.
    private async Task ReloadQuietly()
    {
        if (Session.TeamId is null) return;
        _sprints = await Session.Get<SprintModel[]>(Session.TeamPath("sprints"));
        _tasks = await Session.Get<TaskModel[]>(Session.TeamPath("tasks"));
        if (_planning is not null) await _planning.RefreshRealtime();
        StateHasChanged();
    }
    private bool Planning => AppRoutes.Current(Navigation).EndsWith("/plan", StringComparison.Ordinal);
    private SprintModel? Current => SprintId.HasValue ? _sprints.FirstOrDefault(s=>s.Id==SprintId) : null;
    /// <summary>The board's sprint: the one named in the URL (not substituted if it is missing), otherwise the active one, otherwise the nearest planned one.</summary>
    private SprintModel? PlanSprint => SprintId.HasValue ? Current : _sprints.FirstOrDefault(s=>s.Status=="Active") ?? _sprints.Where(s=>s.Status=="Planned").OrderBy(s=>s.StartDate).FirstOrDefault();
    /// <summary>Planning page heading: the sprint name when a sprint is selected.</summary>
    private string PlanningTitle => PlanSprint is { } sprint ? $"{AlvaStrings.Sprint_PlanningASprint}: {sprint.Name}" : AlvaStrings.Sprint_PlanningASprint;
    protected override async Task OnParametersSetAsync(){_editing=null;await Load();await Realtime.EnsureStarted();}
    private async Task Run(Func<Task> action){_busy=true;_error=null;try{await action();}catch(Exception e) when(e is HttpRequestException or InvalidOperationException){_error=PageFeedback.Describe(e);}finally{_busy=false;}}
    private Task Load()=>Run(async()=>{await Session.Initialize();if(Session.TeamId is null)return;_sprints=await Session.Get<SprintModel[]>(Session.TeamPath("sprints"));_tasks=await Session.Get<TaskModel[]>(Session.TeamPath("tasks"));_loaded=true;});
    private void New(){_editing=new SprintModel();_start=_editing.StartDate;_end=_editing.EndDate;_editingSnapshot=DraftSnapshot.Of(_editing,_start,_end);}
    private void Edit(SprintModel sprint){_editing=new SprintModel{Id=sprint.Id,Name=sprint.Name,Goal=sprint.Goal,StartDate=sprint.StartDate,EndDate=sprint.EndDate,Status=sprint.Status};_start=sprint.StartDate;_end=sprint.EndDate;_editingSnapshot=DraftSnapshot.Of(_editing,_start,_end);}
    private FlareButton? _newButton,_emptyNewButton;private SprintPlanning? _planning;
    // Closing the editor returns focus to the button that opened it: sprint settings on the board or new sprint.
    private async Task Close()
    {
        if (!await DraftPrompt.CanDiscardAsync(Confirm, IsDirty)) return;
        var existing=_editing?.Id is { } id && id!=Guid.Empty;_editing=null;_editingSnapshot=null;StateHasChanged();
        if(existing && _planning is not null) await _planning.FocusParams();
        // @ref links are not reset on a route change, so the button is chosen by what is currently on screen.
        else if((Planning ? PlanSprint is null ? _emptyNewButton : null : SprintId is null ? _newButton : null) is { } button) await button.FocusAsync();
    }
    /// <summary>The board changed the sprint or the tasks: an open settings form is stale, but the draft is not lost.</summary>
    private Task Reload(){if(!IsDirty){_editing=null;_editingSnapshot=null;}return Load();}

    private async Task ConfirmLeave(LocationChangingContext context)
    {
        if (!IsDirty) return;
        if (!await DraftPrompt.CanDiscardAsync(Confirm, true)) { context.PreventNavigation(); return; }
        _editing=null; _editingSnapshot=null;
    }

    public void Dispose()
    {
        _draft?.Dispose();
        Realtime.TaskChanged -= OnRealtimeTaskChanged;
        Realtime.Resynced -= OnRealtimeResynced;
        _refresh?.Cancel();
    }
    private async Task Save()
    {
        _nameError=_endError=null;_formErrors.Clear();
        if (string.IsNullOrWhiteSpace(_editing!.Name)) { _nameError=AlvaStrings.Sprint_ASprintNameIsRequired; _formErrors.Add(_nameError); }
        if (_start is { } start && _end is { } end && start > end) { _endError=AlvaStrings.Common_TheEndDateIsBeforeTheStartDate; _formErrors.Add(_endError); }
        if (_formErrors.Count > 0) { StateHasChanged(); await SafeFocus.Async(_errorSummary); return; }
        await Run(async()=>{var s=_editing!;var saved=await Session.Save<SprintModel>(s.Id==Guid.Empty?HttpMethod.Post:HttpMethod.Put,Session.TeamPath("sprints"+(s.Id==Guid.Empty?"":$"/{s.Id}")),new SprintRequest(s.Name,s.Goal,_start!.Value,_end!.Value,s.Status));_sprints=await Session.Get<SprintModel[]>(Session.TeamPath("sprints"));_editing=null;Navigation.NavigateTo($"sprints/{saved.Id}/plan");});
    }
}
