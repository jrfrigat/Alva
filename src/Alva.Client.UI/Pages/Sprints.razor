@page "/sprints"
@page "/sprints/plan"
@page "/sprints/{SprintId:guid}"
@page "/sprints/{SprintId:guid}/plan"
@implements IDisposable
@inject AlvaSession Session
@inject NavigationManager Navigation
@inject DraftGuard Drafts
<PageTitle>@(Planning ? Strings.T("Планирование") : Current?.Name ?? Strings.T("Спринты")) · Alva</PageTitle>
<NavigationLock OnBeforeInternalNavigation="ConfirmLeave" ConfirmExternalNavigation="IsDirty" />
@if(SprintId is null && !Planning)
{
<AlvaPageHeader Category="@(Strings.T("Планирование · Спринты"))" Title="@(Strings.T("Спринты команды"))" Description="@(Strings.T("Цели, сроки и состав спринтов команды."))">
    <Actions><FlareButton @ref="_newButton" Size="ButtonSize.Sm" OnClick="New" Disabled="@(Session.TeamId is null)">@(Strings.T("Новый спринт"))</FlareButton></Actions>
</AlvaPageHeader>
}
<PageFeedback Loading="_busy" Error="@_error" OnRetry="Load" />
@if(Session.TeamId is null){<TeamRequired />}
else
{
@if(_editing is not null)
{
<FlareCard Variant="CardVariant.Outlined"><FlareCardContent><FlareStack Gap="FlareSpacing.Large">
    <FlareStack Row StretchFirst><FlareText Element="h2" Typo="TypographyScale.TitleLarge">@(_editing.Id==Guid.Empty?Strings.T("Новый спринт"):Strings.T("Параметры спринта"))</FlareText><FlareButton OnClick="Close" Variant="ButtonVariant.Text" Size="ButtonSize.Sm">@(Strings.T("Закрыть"))</FlareButton></FlareStack>
    @if (_formErrors.Count > 0) { <div class="alva-form-errors" role="alert" tabindex="-1" @ref="_errorSummary"><b>@(Strings.T("Проверьте выделенные поля."))</b>@foreach (var error in _formErrors) { <div>@error</div> }</div> }
    <FlareGrid MinColumnWidth="min(100%,15rem)">
        <FlareTextField Label="@(Strings.T("Название"))" ErrorText="@_nameError" @bind-Value="_editing.Name" Required Autofocus /><FlareTextField Label="@(Strings.T("Цель"))" @bind-Value="_editing.Goal" />
        <FlareDatePicker Label="@(Strings.T("Начало"))" @bind-Value="_start" /><FlareDatePicker Label="@(Strings.T("Окончание"))" ErrorText="@_endError" @bind-Value="_end" Min="_start" />
        <FlareSelect TValue="string" Label="@(Strings.T("Статус"))" Items="_statuses" ItemLabel="Labels.Status" @bind-Value="_editing.Status" />
    </FlareGrid>
    <FlareStack Row><FlareButton OnClick="Save" Loading="_busy" Disabled="@(string.IsNullOrWhiteSpace(_editing.Name) || !_start.HasValue || !_end.HasValue || !IsDirty)">@(Strings.T("Сохранить спринт"))</FlareButton><EditorStatus Dirty="IsDirty" Saving="_busy" /></FlareStack>
</FlareStack></FlareCardContent></FlareCard>
}
@if(Planning)
{
    if(SprintId.HasValue && Current is null){if(_loaded){<UnavailableState Title="@(Strings.T("Спринт не найден или недоступен"))" BackHref="sprints" BackLabel="@(Strings.T("К спринтам"))" />}}
    else if(PlanSprint is not null){<SprintPlanning @ref="_planning" Sprint="PlanSprint" Sprints="_sprints" Tasks="_tasks" Changed="Reload" OnParams="()=>Edit(PlanSprint)" />}
    else if(_loaded){<FlareEmptyState Title="@(Strings.T("Нечего планировать"))" Description="@(Strings.T("Создайте спринт, чтобы собрать в него задачи из пула."))"><ActionContent><FlareButton @ref="_emptyNewButton" Size="ButtonSize.Sm" OnClick="New">@(Strings.T("Новый спринт"))</FlareButton></ActionContent></FlareEmptyState>}
}
else if(SprintId is null){<SprintRegistry Sprints="_sprints" Tasks="_tasks" />}
else if(Current is not null){<SprintDetails Sprint="Current" Tasks="_tasks" Sprints="_sprints" OnEdit="@(()=>Navigation.NavigateTo($"sprints/{Current.Id}/plan"))" Changed="Load" />}
else if(_loaded){<UnavailableState Title="@(Strings.T("Спринт не найден или недоступен"))" BackHref="sprints" BackLabel="@(Strings.T("К спринтам"))" />}
}
@code {
    [Parameter]public Guid? SprintId{get;set;}
    private SprintModel[] _sprints=[];private TaskModel[] _tasks=[];private SprintModel? _editing;private DateOnly? _start,_end;private bool _busy,_loaded;private string? _error;private readonly string[] _statuses=["Planned","Active","Completed"];
    private string? _editingSnapshot; private IDisposable? _draft;
    private string? _nameError,_endError; private readonly List<string> _formErrors=[]; private ElementReference _errorSummary;
    [CascadingParameter] public FlareConfirmDialogProvider? Confirm { get; set; }
    internal bool IsDirty => _editing is not null && DraftSnapshot.Of(_editing, _start, _end) != _editingSnapshot;
    protected override void OnInitialized() => _draft = Drafts.Track(() => IsDirty);
    private bool Planning => AppRoutes.Current(Navigation).EndsWith("/plan", StringComparison.Ordinal);
    private SprintModel? Current => SprintId.HasValue ? _sprints.FirstOrDefault(s=>s.Id==SprintId) : null;
    /// <summary>Спринт доски: указанный в адресе (без подмены, если его нет), иначе активный, иначе ближайший запланированный.</summary>
    private SprintModel? PlanSprint => SprintId.HasValue ? Current : _sprints.FirstOrDefault(s=>s.Status=="Active") ?? _sprints.Where(s=>s.Status=="Planned").OrderBy(s=>s.StartDate).FirstOrDefault();
    protected override async Task OnParametersSetAsync(){_editing=null;await Load();}
    private async Task Run(Func<Task> action){_busy=true;_error=null;try{await action();}catch(Exception e) when(e is HttpRequestException or InvalidOperationException){_error=PageFeedback.Describe(e);}finally{_busy=false;}}
    private Task Load()=>Run(async()=>{await Session.Initialize();if(Session.TeamId is null)return;_sprints=await Session.Get<SprintModel[]>(Session.TeamPath("sprints"));_tasks=await Session.Get<TaskModel[]>(Session.TeamPath("tasks"));_loaded=true;});
    private void New(){_editing=new SprintModel();_start=_editing.StartDate;_end=_editing.EndDate;_editingSnapshot=DraftSnapshot.Of(_editing,_start,_end);}
    private void Edit(SprintModel sprint){_editing=new SprintModel{Id=sprint.Id,Name=sprint.Name,Goal=sprint.Goal,StartDate=sprint.StartDate,EndDate=sprint.EndDate,Status=sprint.Status};_start=sprint.StartDate;_end=sprint.EndDate;_editingSnapshot=DraftSnapshot.Of(_editing,_start,_end);}
    private FlareButton? _newButton,_emptyNewButton;private SprintPlanning? _planning;
    // Закрытие редактора возвращает фокус на кнопку, которой его открыли: «Параметры спринта» на доске или «Новый спринт».
    private async Task Close()
    {
        if (!await DraftPrompt.CanDiscardAsync(Confirm, IsDirty)) return;
        var existing=_editing?.Id is { } id && id!=Guid.Empty;_editing=null;_editingSnapshot=null;StateHasChanged();
        if(existing && _planning is not null) await _planning.FocusParams();
        // Ссылки @ref не обнуляются при смене маршрута, поэтому кнопку выбирает то, что сейчас на экране.
        else if((Planning ? PlanSprint is null ? _emptyNewButton : null : SprintId is null ? _newButton : null) is { } button) await button.FocusAsync();
    }
    /// <summary>Доска изменила спринт или задачи: открытая форма параметров устарела, но черновик не теряем.</summary>
    private Task Reload(){if(!IsDirty){_editing=null;_editingSnapshot=null;}return Load();}

    private async Task ConfirmLeave(LocationChangingContext context)
    {
        if (!IsDirty) return;
        if (!await DraftPrompt.CanDiscardAsync(Confirm, true)) { context.PreventNavigation(); return; }
        _editing=null; _editingSnapshot=null;
    }

    public void Dispose() => _draft?.Dispose();
    private async Task Save()
    {
        _nameError=_endError=null;_formErrors.Clear();
        if (string.IsNullOrWhiteSpace(_editing!.Name)) { _nameError=Strings.T("Название спринта обязательно."); _formErrors.Add(_nameError); }
        if (_start is { } start && _end is { } end && start > end) { _endError=Strings.T("Окончание раньше начала."); _formErrors.Add(_endError); }
        if (_formErrors.Count > 0) { StateHasChanged(); await SafeFocus.Async(_errorSummary); return; }
        await Run(async()=>{var s=_editing!;var saved=await Session.Save<SprintModel>(s.Id==Guid.Empty?HttpMethod.Post:HttpMethod.Put,Session.TeamPath("sprints"+(s.Id==Guid.Empty?"":$"/{s.Id}")),new SprintRequest(s.Name,s.Goal,_start!.Value,_end!.Value,s.Status));_sprints=await Session.Get<SprintModel[]>(Session.TeamPath("sprints"));_editing=null;Navigation.NavigateTo($"sprints/{saved.Id}/plan");});
    }
}
