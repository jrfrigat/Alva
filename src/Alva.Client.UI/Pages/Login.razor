@page "/login"
@page "/register"
@inject AlvaSession Session
@inject NavigationManager Navigation
<PageTitle>@(AlvaStrings.Auth_SignInAlva)</PageTitle>
<FlareContainer MaxWidth="ContainerMaxWidth.Sm">
<FlareCard Variant="CardVariant.Outlined"><FlareCardContent><FlareStack Gap="FlareSpacing.Large">
    <FlareText Element="h1" Typo="TypographyScale.HeadlineLarge">@(_register ? AlvaStrings.Auth_CreateAWorkspaceForTheTeam : AlvaStrings.Auth_WelcomeToAlva)</FlareText>
    <FlareText>@(AlvaStrings.Common_PlanSprintsDistributeTheWorkAndSpotOverloadsEarly)</FlareText>
    @* Общая сводка — для ответов сервера, которые не относятся к одному полю (неверный пароль, сбой). *@
    <PageFeedback Error="@_error" />
    @* novalidate: всплывающие подсказки браузера не связаны с полями и не читаются вместе с ними — проверяет сама форма. *@
    <EditForm EditContext="_editContext" OnSubmit="Submit" novalidate>
    @* Словарь «поле → id контрола» нужен FlareValidationSummary, чтобы связать пункт сводки с полем. *@
    <CascadingValue Value="_fieldRegistry" IsFixed="true">
    <FlareStack Gap="FlareSpacing.Medium">
        @* Сводка Flare сама получает фокус после неудачной отправки и ведёт к своим полям. *@
        <FlareValidationSummary />
        @if (_register)
        {
            <FlareTextField @ref="_nameField" Label="@(AlvaStrings.Common_YourName)" Value="@_displayName" ValueChanged="v => Edit(ref _displayName, v, Field.Name)" ErrorText="@ErrorOf(Field.Name)" For="() => _displayName" Required Autocomplete="name" />
            <FlareTextField @ref="_workspaceField" Label="@(AlvaStrings.Auth_WorkspaceName)" Value="@_workspaceName" ValueChanged="v => Edit(ref _workspaceName, v, Field.Workspace)" ErrorText="@ErrorOf(Field.Workspace)" For="() => _workspaceName" Required />
        }
        <FlareTextField @ref="_emailField" Label="@(AlvaStrings.Common_EmailField)" Value="@_email" ValueChanged="v => Edit(ref _email, v, Field.Email)" ErrorText="@ErrorOf(Field.Email)" For="() => _email" Type="email" Required Autocomplete="email" />
        <FlarePasswordField @ref="_passwordField" Label="@(AlvaStrings.Auth_Password)" Value="@_password" ValueChanged="v => Edit(ref _password, v, Field.Password)" ErrorText="@ErrorOf(Field.Password)" For="() => _password" Required Autocomplete="@(_register ? "new-password" : "current-password")" HelperText="@(_register ? $"{AlvaStrings.Auth_AtLeast} {MinPassword} {AlvaStrings.Auth_Characters}" : null)" ShowStrength="@_register" />
        @if (_register)
        {
            <FlarePasswordField @ref="_confirmField" Label="@(AlvaStrings.Auth_RepeatPassword)" Value="@_passwordConfirm" ValueChanged="v => Edit(ref _passwordConfirm, v, Field.PasswordConfirm)" ErrorText="@ErrorOf(Field.PasswordConfirm)" For="() => _passwordConfirm" Required Autocomplete="new-password" />
        }
        <FlareButton Type="ButtonType.Submit" Loading="_busy" FullWidth>@(_register ? AlvaStrings.Common_CreateAWorkspace : AlvaStrings.Common_SignIn)</FlareButton>
        <FlareButton Variant="ButtonVariant.Text" OnClick="Toggle">@(_register ? AlvaStrings.Auth_IAlreadyHaveAnAccount : AlvaStrings.Auth_CreateAnAccount)</FlareButton>
        @if (!_register) { <FlareText Typo="TypographyScale.BodySmall">@(AlvaStrings.Auth_ForgotYourPasswordContactTheWorkspaceAdministratorResetByLinkIsNotAvaila_1a773e)</FlareText> }
    </FlareStack>
    </CascadingValue>
    </EditForm>
</FlareStack></FlareCardContent></FlareCard>
</FlareContainer>
@code {
    // Пределы совпадают с проверками API регистрации (AuthEndpoints).
    private const int MinPassword = 12, MaxPassword = 128;

    private enum Field { Name, Workspace, Email, Password, PasswordConfirm }

    private string? _email, _password, _passwordConfirm, _displayName, _workspaceName, _error, _returnUrl;
    private bool _register, _busy;
    private readonly Dictionary<Field, string> _errors = [];
    private readonly Dictionary<FieldIdentifier, string> _fieldRegistry = [];
    private EditContext? _editContext;
    private ValidationMessageStore? _messages;
    private FlareTextField? _nameField, _workspaceField, _emailField;
    private FlarePasswordField? _passwordField, _confirmField;

    private string? ErrorOf(Field field) => _errors.GetValueOrDefault(field);

    // У входа и регистрации свои адреса: /register открывает форму регистрации.
    protected override void OnInitialized()
    {
        _editContext = new EditContext(this);
        _messages = new ValidationMessageStore(_editContext);
        _register = AppRoutes.Current(Navigation).Equals("register", StringComparison.OrdinalIgnoreCase);
        _returnUrl = RequestedReturnUrl();
    }

    // Правка поля снимает его ошибку: сообщение больше не описывает то, что введено.
    private void Edit(ref string? target, string? value, Field field)
    {
        target = value;
        if (_errors.Remove(field)) SyncMessages();
    }

    // Переключение меняет и адрес: у каждой формы свой URL, который можно сохранить в закладки.
    private void Toggle()
    {
        _register = !_register;
        _error = null;
        _errors.Clear();
        SyncMessages();
        Navigation.NavigateTo(WithReturn(_register ? "register" : "login"));
    }

    /// <summary>Проверки до запроса: неверная форма не уходит на сервер и не тратит лимит попыток входа.</summary>
    private void Validate()
    {
        _errors.Clear();
        if (_register && string.IsNullOrWhiteSpace(_displayName)) _errors[Field.Name] = AlvaStrings.Auth_EnterAName;
        if (_register && string.IsNullOrWhiteSpace(_workspaceName)) _errors[Field.Workspace] = AlvaStrings.Auth_EnterAWorkspaceName;
        var email = _email?.Trim();
        if (string.IsNullOrEmpty(email)) _errors[Field.Email] = AlvaStrings.Auth_EnterAnEmail;
        else if (!System.Net.Mail.MailAddress.TryCreate(email, out var parsed) || parsed.Address != email) _errors[Field.Email] = AlvaStrings.Auth_TheEmailIsInTheWrongFormatForExampleNameCompanyRu;
        if (string.IsNullOrEmpty(_password)) _errors[Field.Password] = AlvaStrings.Auth_EnterAPassword;
        else if (_register && _password.Length is < MinPassword or > MaxPassword) _errors[Field.Password] = string.Format(AlvaStrings.Auth_ThePasswordMustContainFromToCharacters, MinPassword, MaxPassword);
        if (_register && string.IsNullOrEmpty(_passwordConfirm)) _errors[Field.PasswordConfirm] = AlvaStrings.Auth_RepeatThePassword;
        else if (_register && _password != _passwordConfirm) _errors[Field.PasswordConfirm] = AlvaStrings.Auth_PasswordsDoNotMatch;
        SyncMessages();
    }

    // Ошибки полей живут в одном месте: их читают и ErrorText поля, и сводка Flare.
    private void SyncMessages()
    {
        if (_messages is null || _editContext is null) return;
        _messages.Clear();
        foreach (var (field, message) in _errors) _messages.Add(Identifier(field), message);
        _editContext.NotifyValidationStateChanged();
    }

    private FieldIdentifier Identifier(Field field) => field switch
    {
        Field.Name => FieldIdentifier.Create(() => _displayName),
        Field.Workspace => FieldIdentifier.Create(() => _workspaceName),
        Field.Email => FieldIdentifier.Create(() => _email),
        Field.Password => FieldIdentifier.Create(() => _password),
        _ => FieldIdentifier.Create(() => _passwordConfirm)
    };

    private async Task Submit()
    {
        _error = null;
        Validate();
        if (_errors.Count > 0)
        {
            // Запрос валидации поднимает у сводки Flare фокус на себя; поля уже показывают ErrorText.
            _editContext?.Validate();
            return;
        }
        _busy = true;
        try
        {
            await Session.Authenticate(_register ? "register" : "login", new { email = _email?.Trim(), password = _password, displayName = _displayName, workspaceName = _workspaceName });
            // Вернувшийся пользователь уже выбрал команду: обзор открывается сразу, без лишнего шага.
            Navigation.NavigateTo(_returnUrl ?? (Session.TeamId is not null ? "/" : "workspaces"));
        }
        // Занятая почта — ошибка конкретного поля; неверный вход — своя подсказка, а не «сессия истекла».
        catch (HttpRequestException error) when (_register && error.StatusCode == System.Net.HttpStatusCode.Conflict) { _errors[Field.Email] = AlvaStrings.Auth_AnAccountWithThisEmailAlreadyExists; SyncMessages(); _editContext?.Validate(); }
        catch (HttpRequestException error) when (!_register && error.StatusCode == System.Net.HttpStatusCode.Unauthorized) { _error = AlvaStrings.Auth_WrongEmailOrPasswordOrSignInIsTemporarilyBlocked; }
        catch (HttpRequestException error) when (error.StatusCode == System.Net.HttpStatusCode.Forbidden) { _error = AlvaStrings.Auth_TheServerRejectedTheSignInOrRegistrationRequestContactYourAlvaAdministra_4c9431; }
        catch (Exception error) when (error is HttpRequestException or InvalidOperationException) { _error = PageFeedback.Describe(error); }
        finally { _busy = false; }
    }

    // Возврат только на локальный относительный адрес: чужой URL не должен уводить после входа.
    private string? RequestedReturnUrl()
    {
        foreach (var part in Navigation.ToAbsoluteUri(Navigation.Uri).Query.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var pair = part.Split('=', 2);
            if (pair.Length != 2 || pair[0] != "returnUrl") continue;
            var value = Uri.UnescapeDataString(pair[1]);
            if (IsLocal(value)) return value;
        }
        return null;
    }

    // Только адрес того же origin: protocol-relative и внешние ссылки после входа не принимаются.
    private bool IsLocal(string value)
    {
        if (value.Contains('\\') || value.Contains('\r') || value.Contains('\n')) return false;
        if (!Uri.TryCreate(Navigation.BaseUri, UriKind.Absolute, out var root)) return false;
        if (!Uri.TryCreate(value, UriKind.RelativeOrAbsolute, out var parsed)) return false;
        var target = parsed.IsAbsoluteUri ? parsed : new Uri(root, parsed);
        return target.Scheme == root.Scheme && target.Authority == root.Authority;
    }

    private string WithReturn(string page) => _returnUrl is null ? page : $"{page}?returnUrl={Uri.EscapeDataString(_returnUrl)}";
}
