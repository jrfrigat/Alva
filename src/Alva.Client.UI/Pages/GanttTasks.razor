@page "/gantt/tasks"
@page "/diagrams"
@inject AlvaSession Session
@inject GanttPreferences Preferences
@using Flare.Components.Gantt
@* Task Gantt (projection 1): work tree, task windows, deadlines, sprint and links.
   Alva builds the projection from Flare.Components.Gantt primitives; the library itself knows nothing about tasks. *@
<PageTitle>@(AlvaStrings.Gantt_TaskGanttAlva)</PageTitle>
<AlvaPageHeader Category="@(AlvaStrings.Gantt_ChartsGantt)" Title="@(AlvaStrings.Gantt_TaskGantt)" Description="@(AlvaStrings.Gantt_WorkHierarchyOverTimeTaskAndSprintWindowsDeadlinesDependenciesAndRiskDra_692d07)" />
<PageFeedback Loading="_busy" Error="@_error" OnRetry="Reload" />
@if (Session.TeamId is null) { <TeamRequired /> }
else if (_data is not null)
{
    <div class="alva-filterbar alva-gantt-bar">
        <div class="alva-gantt-bar__fields">
            <FlareSelect TValue="Guid?" Items="@(_data.Sprints.OrderBy(s => s.StartDate).Select(s => (Guid?)s.Id))" ItemLabel="_data.SprintName" NullOption="@(AlvaStrings.Gantt_AllTasks)"
                         @bind-Value="_sprintId" Size="FieldSize.Sm" InputAttributes="@(Aria(AlvaStrings.Gantt_Sprint))" />
            <FlareSelect TValue="GanttScale" Items="GanttData.Scales" ItemLabel="GanttData.ScaleName" @bind-Value="_scale" Size="FieldSize.Sm" InputAttributes="@(Aria(AlvaStrings.Gantt_Scale))" />
            <GanttZoom View="tasks" Scale="_scale" @bind-Value="_unit" />
            <FlareButton Size="ButtonSize.Sm" Variant="ButtonVariant.Text" OnClick="ToToday" Tooltip="@(AlvaStrings.Gantt_ToTodayAltWheelScrollThroughTime)">@(AlvaStrings.Gantt_Today)</FlareButton>
        </div>
        <FlareChipGroup MultiSelect="true" SelectedValues="SelectedTypeCodes" SelectedValuesChanged="SetTypes" AriaLabel="@(AlvaStrings.Gantt_LinkTypes)">
            @foreach (var type in AllTypes)
            {
                <FlareChip Value="@GanttData.Code(type)" Label="@GanttData.Code(type)" />
            }
        </FlareChipGroup>
        <FlareSwitch @bind-Value="_critical" Label="@(AlvaStrings.Gantt_CriticalPath)" />
    </div>

    <GanttLegend Notice="@_notice" />

    @if (_data.Tasks.Length == 0)
    {
        <FlareEmptyState Title="@(AlvaStrings.Common_NoTasksYet)" Description="@(AlvaStrings.Gantt_CreateTasksInTheTaskTreeAndTheyAppearOnTheChart)"><ActionContent><FlareButton Href="tasks">@(AlvaStrings.Common_ToTasks)</FlareButton></ActionContent></FlareEmptyState>
    }
    else
    {
        @* The wrapper catches Enter from a bar (the bar is focusable and marked role="button") and holds focus
           after the panel closes: the bar's events bubble up here. *@
        <div class="alva-gantt__host" @ref="_host" tabindex="-1" @onkeydown="OnChartKey">
        <FlareGantt @ref="_chart" Range="@Axis()" RangeChanged="r => _range = r" Endless="true" Scale="_scale" UnitWidth="_unit" FillWidth="true" Virtualize="true" RowHeight="36" SideWidth="@_side" DefaultSideWidth="22rem" ResizableSide="true" SideWidthChanged="SaveSide"
                    NonWorking="GanttData.IsWeekend" Markers="@GanttData.TodayMarkers" Regions="@_data.SprintRegions(Sprint)" @bind-SelectedKey="_selected"
                    AriaLabel="@(AlvaStrings.Gantt_TaskGantt)" Class="alva-gantt">
            <Corner><span>@(AlvaStrings.Gantt_TaskAssigneeHours)</span></Corner>
            <ChildContent>
                <GanttTaskPanel Data="_data" SprintId="_sprintId" Types="_types" Critical="_critical" OnChange="Change" OnLinkCreate="Link" OnLinkRejected="Rejected" OnItemClick="OpenTask" />
            </ChildContent>
        </FlareGantt>
        </div>
        @* Task panel: a click on a bar or Enter opens it, Esc and a backdrop click close it (CloseOnEsc
           is enabled on FlareDrawer by default), and focus returns to the board after closing. Edits and
           saving are the same as on the task page: the card is reused as a whole. *@
        <FlareDrawer Anchor="DrawerAnchor.Right" Open="_panelOpen" OpenChanged="OnPanelOpen" Width="34rem" ContentPadding="FlareSpacing.Large" AriaLabel="@(AlvaStrings.Common_Task)">
            @if (_open is not null)
            {
                <TaskDetails @ref="_details" Item="_open" Tasks="_data.Tasks" Projects="_projects" Sprints="_data.Sprints" Actors="_data.Actors" Changed="Reload" HeadingLevel="2" Compact="true" />
            }
        </FlareDrawer>
    }
}

@code {
    private static readonly GanttLinkType[] AllTypes = [GanttLinkType.FinishToStart, GanttLinkType.StartToStart, GanttLinkType.FinishToFinish, GanttLinkType.StartToFinish];
    private GanttData? _data;
    private bool _busy = true;
    private string? _error;
    private string? _notice;
    private Guid? _sprintId;
    private GanttScale _scale = GanttScale.Day;
    private double _unit = GanttData.UnitWidth(GanttScale.Day);
    private string _side = "22rem";
    private bool _critical;
    private string? _selected;
    private HashSet<GanttLinkType> _types = [.. AllTypes];

    private TaskModel? _open;
    private TaskDetails? _details;
    [CascadingParameter] public FlareConfirmDialogProvider? Confirm { get; set; }
    private bool _panelOpen;
    private ElementReference _host;
    private ProjectModel[] _projects = [];

    private static DateOnly Today => DateOnly.FromDateTime(DateTime.Today);
    private SprintModel? Sprint => _data?.Sprint(_sprintId);
    private FlareGantt? _chart;
    private GanttSpan _range;
    private Guid? _rangeFor = Guid.Empty;

    // The axis is the sprint window (or all tasks) until the user scrolls further; changing the sprint starts it over.
    private GanttSpan Axis()
    {
        if (_rangeFor != _sprintId) (_range, _rangeFor) = (_data!.Range(Sprint, Today), _sprintId);
        return _range;
    }

    private Task ToToday() => _chart?.ScrollTo(DateTime.Today.AddDays(-1)) ?? Task.CompletedTask;

    private static Dictionary<string, object> Aria(string label) => new() { ["aria-label"] = label };

    private IReadOnlyCollection<string> SelectedTypeCodes => _types.Select(GanttData.Code).ToArray();

    private void SetTypes(IReadOnlyCollection<string> codes) =>
        _types = AllTypes.Where(type => codes.Contains(GanttData.Code(type))).ToHashSet();

    private async Task SaveSide(string width)
    {
        _side = width;
        await Preferences.SaveSide("tasks", width);
    }

    protected override async Task OnInitializedAsync()
    {
        await Session.Initialize();
        _side = (await Preferences.Get("tasks")).Side ?? _side;
        await Reload();
        _sprintId = _data?.Sprints.FirstOrDefault(s => s.Status == "Active")?.Id;
    }

    private async Task Reload()
    {
        _busy = true;
        try
        {
            if (Session.TeamId is not null)
            {
                _data = await GanttData.Load(Session);
                // The task card includes the project, so the panel also receives the project dictionary - as on the list page.
                _projects = await Session.Get<ProjectModel[]>(Session.TeamPath("projects"));
            }
        }
        catch (Exception e) when (e is HttpRequestException or InvalidOperationException) { _error = PageFeedback.Describe(e); }
        finally { _busy = false; }
    }

    /// <summary>A click on a bar opens the task panel without leaving the page.</summary>
    private void OpenTask(TaskModel task) { _open = task; _panelOpen = true; }

    /// <summary>Enter on the selected bar does the same as a click: the bar is focusable, but Enter does nothing
    /// on it, so the board wrapper catches it.</summary>
    private void OnChartKey(KeyboardEventArgs e)
    {
        if (e.Key != "Enter" || _selected is null || _panelOpen) return;
        if (_data?.Tasks.FirstOrDefault(t => GanttData.Key(t.Id) == _selected) is { } task) OpenTask(task);
    }

    /// <summary>The panel closed (Esc, backdrop or button): the task is released and focus returns to the board.</summary>
    private async Task OnPanelOpen(bool open)
    {
        if (!open && _details?.Dirty == true && !await DraftPrompt.CanDiscardAsync(Confirm, true))
        {
            _panelOpen = true;
            StateHasChanged();
            return;
        }
        _panelOpen = open;
        if (open) return;
        _open = null;
        try { await _host.FocusAsync(); }
        catch (JSDisconnectedException) { }
    }

    private async Task Change(GanttChangeEventArgs args)
    {
        _error = null;
        try
        {
            _notice = await _data!.Apply(Session, args);
        }
        catch (Exception e) when (e is HttpRequestException or InvalidOperationException) { args.Cancel = true; _error = PageFeedback.Describe(e); }
        await Reload();
    }

    private async Task Link(GanttLinkEventArgs args)
    {
        _error = null;
        try
        {
            await _data!.AddLink(Session, args.Link);
            _notice = AlvaStrings.Gantt_LinkAdded;
        }
        catch (Exception e) when (e is HttpRequestException or InvalidOperationException) { args.Cancel = true; _error = PageFeedback.Describe(e); }
        await Reload();
    }

    private void Rejected(GanttLinkRejectedEventArgs args) => _error = args.Message;
}
