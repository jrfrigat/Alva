@page "/gantt/tasks"
@page "/diagrams"
@inject AlvaSession Session
@inject GanttPreferences Preferences
@using Flare.Components.Gantt
@* Гантт по задачам (макет p6_2d, проекция 1): дерево работ, окна задач, сроки, спринт и связи.
   Проекцию собирает Alva из примитивов Flare.Components.Gantt; сама библиотека о задачах не знает. *@
<PageTitle>Гантт по задачам · Alva</PageTitle>
<section class="alva-page-header">
    <div class="alva-page-header__text">
        <div class="alva-micro-label"><span>Диаграммы · Гантт</span></div>
        <h1 class="alva-page-header__title">Гантт по задачам</h1>
        <p class="alva-page-header__desc">Иерархия работ во времени: окна задач и спринтов, сроки, зависимости и риск. Перетащите полосу или нажмите Ctrl+стрелку, чтобы перенести даты; L — связать с другой задачей.</p>
    </div>
</section>
<PageFeedback Loading="_busy" Error="@_error" />
@if (Session.TeamId is null) { <TeamRequired /> }
else if (_data is not null)
{
    <div class="alva-filterbar alva-gantt-bar">
        <div class="alva-gantt-bar__fields">
            <FlareSelect TValue="Guid?" Items="@(_data.Sprints.OrderBy(s => s.StartDate).Select(s => (Guid?)s.Id))" ItemLabel="_data.SprintName" NullOption="Все задачи"
                         @bind-Value="_sprintId" Size="FieldSize.Sm" InputAttributes="@(Aria("Спринт"))" />
            <FlareSelect TValue="GanttScale" Items="GanttData.Scales" ItemLabel="GanttData.ScaleName" @bind-Value="_scale" Size="FieldSize.Sm" InputAttributes="@(Aria("Масштаб"))" />
            <GanttZoom View="tasks" Scale="_scale" @bind-Value="_unit" />
        </div>
        <div class="alva-quickfilter" role="group" aria-label="Типы связей">
            @foreach (var type in AllTypes)
            {
                var t = type;
                <button type="button" class="alva-quickfilter__item @(_types.Contains(t) ? "alva-quickfilter__item--active" : "")" aria-pressed="@_types.Contains(t)" @onclick="() => ToggleType(t)">@GanttData.Code(t)</button>
            }
        </div>
        <FlareSwitch @bind-Value="_critical" Label="Критический путь" />
    </div>

    <div class="alva-gantt-legend" aria-label="Обозначения">
        <span class="alva-gantt-legend__item alva-gantt-legend__item--work">Работа</span>
        <span class="alva-gantt-legend__item alva-gantt-legend__item--risk-medium">Риск</span>
        <span class="alva-gantt-legend__item alva-gantt-legend__item--risk-high">Высокий риск</span>
        <span class="alva-gantt-legend__item alva-gantt-legend__item--overflow">Выход за спринт</span>
        <span class="alva-gantt-legend__item alva-gantt-legend__item--done">Готово</span>
        @if (_notice is not null) { <span class="alva-gantt-legend__notice" role="status">@_notice</span> }
    </div>

    @if (_data.Tasks.Length == 0)
    {
        <FlareEmptyState Title="Задач пока нет" Description="Создайте задачи в «Матрёшке», и они появятся на диаграмме."><ActionContent><FlareButton Href="/tasks">К задачам</FlareButton></ActionContent></FlareEmptyState>
    }
    else
    {
        <FlareGantt Range="@_data.Range(Sprint, Today)" Scale="_scale" UnitWidth="_unit" FillWidth="true" Virtualize="true" RowHeight="36" SideWidth="@_side" ResizableSide="true" SideWidthChanged="SaveSide"
                    NonWorking="GanttData.IsWeekend" Markers="@GanttData.TodayMarkers" Regions="@_data.SprintRegions(Sprint)" @bind-SelectedKey="_selected"
                    AriaLabel="Гантт по задачам" Class="alva-gantt">
            <Corner><span>Задача · исполнитель · часы</span></Corner>
            <ChildContent>
                <GanttTaskPanel Data="_data" SprintId="_sprintId" Types="_types" Critical="_critical" OnChange="Change" OnLinkCreate="Link" OnLinkRejected="Rejected" />
            </ChildContent>
        </FlareGantt>
    }
}

@code {
    private static readonly GanttLinkType[] AllTypes = [GanttLinkType.FinishToStart, GanttLinkType.StartToStart, GanttLinkType.FinishToFinish, GanttLinkType.StartToFinish];
    private GanttData? _data;
    private bool _busy = true;
    private string? _error;
    private string? _notice;
    private Guid? _sprintId;
    private GanttScale _scale = GanttScale.Day;
    private double _unit = GanttData.UnitWidth(GanttScale.Day);
    private string _side = "22rem";
    private bool _critical;
    private string? _selected;
    private HashSet<GanttLinkType> _types = [.. AllTypes];

    private static DateOnly Today => DateOnly.FromDateTime(DateTime.Today);
    private SprintModel? Sprint => _data?.Sprint(_sprintId);

    private static Dictionary<string, object> Aria(string label) => new() { ["aria-label"] = label };

    private void ToggleType(GanttLinkType type)
    {
        if (!_types.Remove(type)) _types.Add(type);
        _types = [.. _types];
    }

    private async Task SaveSide(string width)
    {
        _side = width;
        await Preferences.SaveSide("tasks", width);
    }

    protected override async Task OnInitializedAsync()
    {
        await Session.Initialize();
        _side = (await Preferences.Get("tasks")).Side ?? _side;
        await Reload();
        _sprintId = _data?.Sprints.FirstOrDefault(s => s.Status == "Active")?.Id;
    }

    private async Task Reload()
    {
        _busy = true;
        try
        {
            if (Session.TeamId is not null) _data = await GanttData.Load(Session);
        }
        catch (Exception e) when (e is HttpRequestException or InvalidOperationException) { _error = e.Message; }
        finally { _busy = false; }
    }

    private async Task Change(GanttChangeEventArgs args)
    {
        _error = null;
        try
        {
            _notice = await _data!.Apply(Session, args);
        }
        catch (Exception e) when (e is HttpRequestException or InvalidOperationException) { args.Cancel = true; _error = e.Message; }
        await Reload();
    }

    private async Task Link(GanttLinkEventArgs args)
    {
        _error = null;
        try
        {
            await _data!.AddLink(Session, args.Link);
            _notice = "Связь добавлена";
        }
        catch (Exception e) when (e is HttpRequestException or InvalidOperationException) { args.Cancel = true; _error = e.Message; }
        await Reload();
    }

    private void Rejected(GanttLinkRejectedEventArgs args) => _error = args.Message;
}
