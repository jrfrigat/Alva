@page "/gantt/tasks"
@page "/diagrams"
@inject AlvaSession Session
@using Flare.Components.Gantt
@* Гантт по задачам (макет p6_2d, проекция 1): дерево работ, окна задач, сроки, спринт и связи.
   Проекцию собирает Alva из примитивов Flare.Components.Gantt; сама библиотека о задачах не знает. *@
<PageTitle>Гантт по задачам · Alva</PageTitle>
<section class="alva-page-header">
    <div class="alva-page-header__text">
        <div class="alva-micro-label"><span>Диаграммы · Гантт</span></div>
        <h1 class="alva-page-header__title">Гантт по задачам</h1>
        <p class="alva-page-header__desc">Иерархия работ во времени: окна задач и спринтов, сроки, зависимости и риск. Перетащите полосу или нажмите Ctrl+стрелку, чтобы перенести даты; L — связать с другой задачей.</p>
    </div>
</section>
<PageFeedback Loading="_busy" Error="@_error" />
@if (Session.TeamId is null) { <TeamRequired /> }
else if (_data is not null)
{
    <div class="alva-filterbar alva-gantt-bar">
        <div class="alva-gantt-bar__fields">
            <FlareSelect TValue="Guid?" Items="@(_data.Sprints.OrderBy(s => s.StartDate).Select(s => (Guid?)s.Id))" ItemLabel="SprintName" NullOption="Все задачи"
                         @bind-Value="_sprintId" Size="FieldSize.Sm" InputAttributes="@(Aria("Спринт"))" />
            <FlareSelect TValue="GanttScale" Items="Scales" ItemLabel="ScaleName" @bind-Value="_scale" Size="FieldSize.Sm" InputAttributes="@(Aria("Масштаб"))" />
        </div>
        <div class="alva-quickfilter" role="group" aria-label="Типы связей">
            @foreach (var type in AllTypes)
            {
                var t = type;
                <button type="button" class="alva-quickfilter__item @(_types.Contains(t) ? "alva-quickfilter__item--active" : "")" aria-pressed="@_types.Contains(t)" @onclick="() => ToggleType(t)">@GanttData.Code(t)</button>
            }
        </div>
        <FlareSwitch @bind-Value="_critical" Label="Критический путь" />
    </div>

    <div class="alva-gantt-legend" aria-label="Обозначения">
        <span class="alva-gantt-legend__item alva-gantt-legend__item--work">Работа</span>
        <span class="alva-gantt-legend__item alva-gantt-legend__item--risk-medium">Риск</span>
        <span class="alva-gantt-legend__item alva-gantt-legend__item--risk-high">Высокий риск</span>
        <span class="alva-gantt-legend__item alva-gantt-legend__item--overflow">Выход за спринт</span>
        <span class="alva-gantt-legend__item alva-gantt-legend__item--done">Готово</span>
        @if (_notice is not null) { <span class="alva-gantt-legend__notice" role="status">@_notice</span> }
    </div>

    @if (_data.Tasks.Length == 0)
    {
        <FlareEmptyState Title="Задач пока нет" Description="Создайте задачи в «Матрёшке», и они появятся на диаграмме."><ActionContent><FlareButton Href="/tasks">К задачам</FlareButton></ActionContent></FlareEmptyState>
    }
    else
    {
        <FlareGantt Range="@_data.Range(Sprint, Today)" Scale="_scale" UnitWidth="@UnitWidth" RowHeight="36" SideWidth="22rem"
                    NonWorking="IsWeekend" Markers="@GlobalMarkers" Regions="@SprintRegions" @bind-SelectedKey="_selected"
                    AriaLabel="Гантт по задачам" Class="alva-gantt">
            <Corner><span>Задача · исполнитель · часы</span></Corner>
            <ChildContent>
                <FlareGanttPanel TRow="TaskModel" TItem="TaskModel" Rows="@Roots" RowKey="t => GanttData.Key(t.Id)" RowChildren="Children"
                                 RowClass="RowClass" Items="@_data.Tasks" ItemKey="t => GanttData.Key(t.Id)" ItemRow="t => GanttData.Key(t.Id)"
                                 ItemSpan="_data.Span" ItemKind="_data.Kind" ItemSegments="_data.Segments" ItemLabel="t => t.Title"
                                 Links="@_data.Links().ToArray()" LinkTypes="@_types" ShowCriticalPath="_critical" RollupParents="true"
                                 Markers="@DeadlineMarkers" Editable="true" AllowRowChange="false" OnChange="Change" OnLinkCreate="Link" OnLinkRejected="Rejected"
                                 AriaLabel="Задачи во времени">
                    <RowHeader Context="task">
                        <div class="alva-gantt-row">
                            <a class="alva-gantt-row__title" href="/tasks/@task.Id" title="@task.Title">@task.Title</a>
                            <span class="alva-gantt-row__meta">@_data.Assignee(task) · @AlvaFormat.Hours(task.EffectiveEstimateHours) ч</span>
                        </div>
                    </RowHeader>
                </FlareGanttPanel>
            </ChildContent>
        </FlareGantt>
    }
}

@code {
    private static readonly GanttScale[] Scales = [GanttScale.Day, GanttScale.Week, GanttScale.Month];
    private static readonly GanttLinkType[] AllTypes = [GanttLinkType.FinishToStart, GanttLinkType.StartToStart, GanttLinkType.FinishToFinish, GanttLinkType.StartToFinish];
    private GanttData? _data;
    private bool _busy = true;
    private string? _error;
    private string? _notice;
    private Guid? _sprintId;
    private GanttScale _scale = GanttScale.Day;
    private bool _critical;
    private string? _selected;
    private HashSet<GanttLinkType> _types = [.. AllTypes];

    private static DateOnly Today => DateOnly.FromDateTime(DateTime.Today);
    private SprintModel? Sprint => _data?.Sprints.FirstOrDefault(s => s.Id == _sprintId);
    private double UnitWidth => _scale switch { GanttScale.Week => 96, GanttScale.Month => 140, _ => 40 };

    private IEnumerable<TaskModel> Roots
    {
        get
        {
            var ids = _data!.Tasks.Select(t => t.Id).ToHashSet();
            return Visible(_data.Tasks.Where(t => t.ParentId is null || !ids.Contains(t.ParentId.Value)));
        }
    }

    private IEnumerable<TaskModel>? Children(TaskModel task) => Visible(_data!.Tasks.Where(t => t.ParentId == task.Id));

    // В режиме спринта показываются задачи спринта и их предки, чтобы дерево не рвалось.
    private IEnumerable<TaskModel> Visible(IEnumerable<TaskModel> tasks)
    {
        var ordered = tasks.OrderBy(t => t.Order).ThenBy(t => t.Title);
        if (_sprintId is not { } sprint) return ordered;
        return ordered.Where(t => InSprint(t, sprint));
    }

    private bool InSprint(TaskModel task, Guid sprint) =>
        task.SprintId == sprint || _data!.Tasks.Any(c => c.ParentId == task.Id && InSprint(c, sprint));

    private string? RowClass(TaskModel task) => GanttData.IsClosed(task) ? "alva-gantt-row--closed" : null;

    private IEnumerable<GanttMarker> GlobalMarkers => [new GanttMarker("today", DateTime.Today.AddHours(12), Label: "Сегодня")];

    private IEnumerable<GanttRegion> SprintRegions => Sprint is { } s
        ? [new GanttRegion("sprint", GanttSpan.FromDays(s.StartDate, s.EndDate), Label: $"{s.Name}: {s.StartDate:dd.MM}–{s.EndDate:dd.MM}")]
        : _data!.Sprints.Where(s => s.Status == "Active").Select(s => new GanttRegion("sprint", GanttSpan.FromDays(s.StartDate, s.EndDate), Label: s.Name));

    private IEnumerable<GanttMarker> DeadlineMarkers => _data!.Tasks
        .Where(t => !GanttData.IsClosed(t) && (t.EffectiveDeadline ?? t.Deadline) is not null)
        .Select(t => new GanttMarker("deadline", (t.EffectiveDeadline ?? t.Deadline)!.Value.AddDays(1).ToDateTime(TimeOnly.MinValue),
            GanttData.Key(t.Id), "Срок", GanttData.Key(t.Id)));

    private static bool IsWeekend(DateOnly day) => day.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday;

    private string SprintName(Guid? id) => _data?.Sprints.FirstOrDefault(s => s.Id == id) is { } s ? $"{s.Name} ({s.StartDate:dd.MM}–{s.EndDate:dd.MM})" : "Все задачи";

    private static string ScaleName(GanttScale scale) => scale switch { GanttScale.Week => "Недели", GanttScale.Month => "Месяцы", _ => "Дни" };

    private static Dictionary<string, object> Aria(string label) => new() { ["aria-label"] = label };

    private void ToggleType(GanttLinkType type)
    {
        if (!_types.Remove(type)) _types.Add(type);
        _types = [.. _types];
    }

    protected override async Task OnInitializedAsync()
    {
        await Session.Initialize();
        await Reload();
        _sprintId = _data?.Sprints.FirstOrDefault(s => s.Status == "Active")?.Id;
    }

    private async Task Reload()
    {
        _busy = true;
        try
        {
            if (Session.TeamId is not null) _data = await GanttData.Load(Session);
        }
        catch (Exception e) when (e is HttpRequestException or InvalidOperationException) { _error = e.Message; }
        finally { _busy = false; }
    }

    private async Task Change(GanttChangeEventArgs args)
    {
        _error = null;
        try
        {
            await _data!.Save(Session, args.Changes);
            _notice = args.Changes.Count > 1 ? $"Даты сохранены, сдвинуто последователей: {args.Changes.Count - 1}" : "Даты сохранены";
        }
        catch (Exception e) when (e is HttpRequestException or InvalidOperationException) { args.Cancel = true; _error = e.Message; }
        await Reload();
    }

    private async Task Link(GanttLinkEventArgs args)
    {
        _error = null;
        try
        {
            await _data!.AddLink(Session, args.Link);
            _notice = "Связь добавлена";
        }
        catch (Exception e) when (e is HttpRequestException or InvalidOperationException) { args.Cancel = true; _error = e.Message; }
        await Reload();
    }

    private void Rejected(GanttLinkRejectedEventArgs args) => _error = args.Message;
}
