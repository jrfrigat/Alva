@page "/gantt/tasks"
@page "/diagrams"
@inject AlvaSession Session
@inject GanttPreferences Preferences
@using Flare.Components.Gantt
@* Гантт по задачам (макет p6_2d, проекция 1): дерево работ, окна задач, сроки, спринт и связи.
   Проекцию собирает Alva из примитивов Flare.Components.Gantt; сама библиотека о задачах не знает. *@
<PageTitle>@(Strings.T("Гантт по задачам · Alva"))</PageTitle>
<section class="alva-page-header">
    <div class="alva-page-header__text">
        <div class="alva-micro-label"><span>@(Strings.T("Диаграммы · Гантт"))</span></div>
        <h1 class="alva-page-header__title">@(Strings.T("Гантт по задачам"))</h1>
        <p class="alva-page-header__desc">@(Strings.T("Иерархия работ во времени: окна задач и спринтов, сроки, зависимости и риск. Перетащите полосу или нажмите Ctrl+стрелку, чтобы перенести даты; L — связать с другой задачей."))</p>
    </div>
</section>
<PageFeedback Loading="_busy" Error="@_error" />
@if (Session.TeamId is null) { <TeamRequired /> }
else if (_data is not null)
{
    <div class="alva-filterbar alva-gantt-bar">
        <div class="alva-gantt-bar__fields">
            <FlareSelect TValue="Guid?" Items="@(_data.Sprints.OrderBy(s => s.StartDate).Select(s => (Guid?)s.Id))" ItemLabel="_data.SprintName" NullOption="@(Strings.T("Все задачи"))"
                         @bind-Value="_sprintId" Size="FieldSize.Sm" InputAttributes="@(Aria(Strings.T("Спринт")))" />
            <FlareSelect TValue="GanttScale" Items="GanttData.Scales" ItemLabel="GanttData.ScaleName" @bind-Value="_scale" Size="FieldSize.Sm" InputAttributes="@(Aria(Strings.T("Масштаб")))" />
            <GanttZoom View="tasks" Scale="_scale" @bind-Value="_unit" />
            <FlareButton Size="ButtonSize.Sm" Variant="ButtonVariant.Text" OnClick="ToToday" Tooltip="@(Strings.T("К сегодняшнему дню (Alt + колесо — прокрутка по времени)"))">@(Strings.T("Сегодня"))</FlareButton>
        </div>
        <div class="alva-quickfilter" role="group" aria-label="@(Strings.T("Типы связей"))">
            @foreach (var type in AllTypes)
            {
                var t = type;
                <button type="button" class="alva-quickfilter__item @(_types.Contains(t) ? "alva-quickfilter__item--active" : "")" aria-pressed="@_types.Contains(t)" @onclick="() => ToggleType(t)">@GanttData.Code(t)</button>
            }
        </div>
        <FlareSwitch @bind-Value="_critical" Label="@(Strings.T("Критический путь"))" />
    </div>

    <GanttLegend Notice="@_notice" />

    @if (_data.Tasks.Length == 0)
    {
        <FlareEmptyState Title="@(Strings.T("Задач пока нет"))" Description="@(Strings.T("Создайте задачи в разделе «Дерево задач», и они появятся на диаграмме."))"><ActionContent><FlareButton Href="tasks">@(Strings.T("К задачам"))</FlareButton></ActionContent></FlareEmptyState>
    }
    else
    {
        @* Обёртка ловит Enter с полосы (полоса фокусируема и сама помечена role="button") и держит фокус
           после закрытия панели: события полосы всплывают сюда. *@
        <div class="alva-gantt__host" @ref="_host" tabindex="-1" @onkeydown="OnChartKey">
        <FlareGantt @ref="_chart" Range="@Axis()" RangeChanged="r => _range = r" Endless="true" Scale="_scale" UnitWidth="_unit" FillWidth="true" Virtualize="true" RowHeight="36" SideWidth="@_side" DefaultSideWidth="22rem" ResizableSide="true" SideWidthChanged="SaveSide"
                    NonWorking="GanttData.IsWeekend" Markers="@GanttData.TodayMarkers" Regions="@_data.SprintRegions(Sprint)" @bind-SelectedKey="_selected"
                    AriaLabel="@(Strings.T("Гантт по задачам"))" Class="alva-gantt">
            <Corner><span>@(Strings.T("Задача · исполнитель · часы"))</span></Corner>
            <ChildContent>
                <GanttTaskPanel Data="_data" SprintId="_sprintId" Types="_types" Critical="_critical" OnChange="Change" OnLinkCreate="Link" OnLinkRejected="Rejected" OnItemClick="OpenTask" />
            </ChildContent>
        </FlareGantt>
        </div>
        @* Панель задачи: клик по полосе или Enter открывают, Esc и щелчок по фону закрывают (CloseOnEsc
           у FlareDrawer включён по умолчанию), после закрытия фокус возвращается к доске. Правки и
           сохранение — те же, что на странице задачи: карточка переиспользуется целиком. *@
        <FlareDrawer Anchor="DrawerAnchor.Right" Open="_panelOpen" OpenChanged="OnPanelOpen" Width="34rem" ContentPadding="FlareSpacing.Large" AriaLabel="@(Strings.T("Задача"))">
            @if (_open is not null)
            {
                <TaskDetails Item="_open" Tasks="_data.Tasks" Projects="_projects" Sprints="_data.Sprints" Actors="_data.Actors" Changed="Reload" />
            }
        </FlareDrawer>
    }
}

@code {
    private static readonly GanttLinkType[] AllTypes = [GanttLinkType.FinishToStart, GanttLinkType.StartToStart, GanttLinkType.FinishToFinish, GanttLinkType.StartToFinish];
    private GanttData? _data;
    private bool _busy = true;
    private string? _error;
    private string? _notice;
    private Guid? _sprintId;
    private GanttScale _scale = GanttScale.Day;
    private double _unit = GanttData.UnitWidth(GanttScale.Day);
    private string _side = "22rem";
    private bool _critical;
    private string? _selected;
    private HashSet<GanttLinkType> _types = [.. AllTypes];

    // Панель задачи: открытая задача, признак открытой панели, ссылка на доску (для возврата фокуса) и
    // справочник проектов для карточки задачи.
    private TaskModel? _open;
    private bool _panelOpen;
    private ElementReference _host;
    private ProjectModel[] _projects = [];

    private static DateOnly Today => DateOnly.FromDateTime(DateTime.Today);
    private SprintModel? Sprint => _data?.Sprint(_sprintId);
    private FlareGantt? _chart;
    private GanttSpan _range;
    private Guid? _rangeFor = Guid.Empty;

    // Ось — окно спринта (или всех задач), пока пользователь не докрутил дальше; смена спринта начинает её заново.
    private GanttSpan Axis()
    {
        if (_rangeFor != _sprintId) (_range, _rangeFor) = (_data!.Range(Sprint, Today), _sprintId);
        return _range;
    }

    private Task ToToday() => _chart?.ScrollTo(DateTime.Today.AddDays(-1)) ?? Task.CompletedTask;

    private static Dictionary<string, object> Aria(string label) => new() { ["aria-label"] = label };

    private void ToggleType(GanttLinkType type)
    {
        if (!_types.Remove(type)) _types.Add(type);
        _types = [.. _types];
    }

    private async Task SaveSide(string width)
    {
        _side = width;
        await Preferences.SaveSide("tasks", width);
    }

    protected override async Task OnInitializedAsync()
    {
        await Session.Initialize();
        _side = (await Preferences.Get("tasks")).Side ?? _side;
        await Reload();
        _sprintId = _data?.Sprints.FirstOrDefault(s => s.Status == "Active")?.Id;
    }

    private async Task Reload()
    {
        _busy = true;
        try
        {
            if (Session.TeamId is not null)
            {
                _data = await GanttData.Load(Session);
                // Проект есть в карточке задачи, поэтому панель получает и справочник проектов — как страница списка.
                _projects = await Session.Get<ProjectModel[]>(Session.TeamPath("projects"));
            }
        }
        catch (Exception e) when (e is HttpRequestException or InvalidOperationException) { _error = e.Message; }
        finally { _busy = false; }
    }

    /// <summary>Клик по полосе открывает панель задачи, не уводя со страницы.</summary>
    private void OpenTask(TaskModel task) { _open = task; _panelOpen = true; }

    /// <summary>Enter на выбранной полосе делает то же, что клик: полоса фокусируема, но Enter у неё ничего не
    /// делает, поэтому его ловит обёртка доски.</summary>
    private void OnChartKey(KeyboardEventArgs e)
    {
        if (e.Key != "Enter" || _selected is null || _panelOpen) return;
        if (_data?.Tasks.FirstOrDefault(t => GanttData.Key(t.Id) == _selected) is { } task) OpenTask(task);
    }

    /// <summary>Панель закрылась (Esc, фон или кнопка): задача отпускается, фокус возвращается к доске.</summary>
    private async Task OnPanelOpen(bool open)
    {
        _panelOpen = open;
        if (open) return;
        _open = null;
        try { await _host.FocusAsync(); }
        catch (JSDisconnectedException) { }
    }

    private async Task Change(GanttChangeEventArgs args)
    {
        _error = null;
        try
        {
            _notice = await _data!.Apply(Session, args);
        }
        catch (Exception e) when (e is HttpRequestException or InvalidOperationException) { args.Cancel = true; _error = e.Message; }
        await Reload();
    }

    private async Task Link(GanttLinkEventArgs args)
    {
        _error = null;
        try
        {
            await _data!.AddLink(Session, args.Link);
            _notice = Strings.T("Связь добавлена");
        }
        catch (Exception e) when (e is HttpRequestException or InvalidOperationException) { args.Cancel = true; _error = e.Message; }
        await Reload();
    }

    private void Rejected(GanttLinkRejectedEventArgs args) => _error = args.Message;
}
