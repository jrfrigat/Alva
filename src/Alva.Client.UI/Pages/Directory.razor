@page "/team"
@page "/team/departments"
@page "/team/skills"
@page "/team/roles"
@implements IDisposable
@inject AlvaSession Session
@inject NavigationManager Navigation
@inject DraftGuard Drafts
<PageTitle>@Title · Alva</PageTitle>
<NavigationLock OnBeforeInternalNavigation="ConfirmLeave" ConfirmExternalNavigation="IsDirty" />
<AlvaPageHeader Category="@Category" Title="@Title">
    <Actions><FlareButton Size="ButtonSize.Sm" OnClick="New" Disabled="@(Session.TeamId is null)">@(AlvaStrings.People_Add)</FlareButton></Actions>
</AlvaPageHeader>
<PageFeedback Loading="_busy" Error="@_error" OnRetry="Load" />
<EditorStatus Dirty="IsDirty" Saving="_busy" Saved="_saved" />
@if (Session.TeamId is null) { <TeamRequired /> }
else
{
<FlareTabs @bind-ActiveIndex="TabIndex">
    <FlareTab Label="@(AlvaStrings.Nav_People)" />
    <FlareTab Label="@(AlvaStrings.Common_SubTeams)" />
    <FlareTab Label="@(AlvaStrings.Common_Skills)" />
</FlareTabs>
<FlareGrid MinColumnWidth="min(100%,24rem)" Gap="FlareSpacing.Large" AlignItems="FlareAlignItems.Start">
<FlareCard Variant="CardVariant.Outlined">
    <FlareCardHeader Title="@Title" />
    <FlareCardContent>
        @if (!_actors.Any(a => a.Kind == Kind))
        {
            <FlareEmptyState Compact Title="@(AlvaStrings.People_TheListIsEmptyForNow)" Description="@(AlvaStrings.People_AddMembersSubTeamsAndRolesToAssignTasks)" />
        }
        else
        {
            <FlareList TItem="ActorModel" Dense="true">
                @foreach (var actor in _actors.Where(a => a.Kind == Kind))
                {
                    <FlareListItem @key="actor.Id" Selected="@(_actor?.Id == actor.Id)" OnClick="() => EditActor(actor)">
                        <Leading><FlareAvatar Text="@AlvaFormat.Initials(actor.Name)" Size="AvatarSize.Sm" Color="@(Kind == "Person" ? FlareColor.Primary : FlareColor.Tertiary)" /></Leading>
                        <ChildContent>
                            <FlareStack Gap="FlareSpacing.None">
                                <FlareText Typo="TypographyScale.LabelMedium">@actor.Name</FlareText>
                                @if (Kind == "Person" && !string.IsNullOrWhiteSpace(actor.Email)) { <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@actor.Email</FlareText> }
                                @if (Kind == "Person" && SkillNames(actor) is { Length: > 0 } skills)
                                {
                                    <FlareStack Row Wrap Gap="FlareSpacing.XSmall">
                                        @foreach (var skill in skills) { <FlareChip Variant="ChipVariant.Filled" Color="FlareColor.Secondary" Size="ChipSize.Xs">@skill</FlareChip> }
                                    </FlareStack>
                                }
                                @if (Kind != "Skill") { <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@ActorName(actor.ParentId)</FlareText> }
                            </FlareStack>
                        </ChildContent>
                    </FlareListItem>
                }
            </FlareList>
        }
    </FlareCardContent>
</FlareCard>
@if (_actor is not null)
{
<FlareCard Variant="CardVariant.Outlined">
    <FlareCardHeader Title="@Labels.Kind(_actor.Kind)" Subtitle="@(_actor.Id == Guid.Empty ? null : _actor.Name)" />
    <FlareCardContent>
        <FlareStack>
            @if (_formErrors.Count > 0) { <div tabindex="-1" @ref="_errorSummary"><AlvaValidationSummary Messages="_formErrors" /></div> }
            <FlareTextField Label="@(AlvaStrings.People_NameOrTitle)" ErrorText="@_nameError" @bind-Value="_actor.Name" Required />
            @if(_actor.Kind=="Person") { <FlareTextField Label="@(AlvaStrings.Common_EmailField)" ErrorText="@_emailError" @bind-Value="_actor.Email" Type="email" /> }
            @if(_actor.Kind=="Person") { <FlareMultiSelect TValue="Guid" Label="@(AlvaStrings.Common_Skills)" Items="@(_actors.Where(a=>a.Kind=="Skill").Select(a=>a.Id))" ItemLabel="id => ActorName(id)" Chips="true" Searchable="true" HelperText="@(AlvaStrings.People_SkillsHelper)" Values="@_actor.SkillIds" ValuesChanged="(IReadOnlyList<Guid> skills) => _actor.SkillIds = skills.ToArray()" /> }
            @if(_actor.Kind!="Skill") { <FlareSelect TValue="Guid?" Label="@(_actor.Kind=="Department" ? AlvaStrings.People_ParentSubTeam : AlvaStrings.Common_SubTeam)" Items="@(_actors.Where(a=>a.Kind=="Department" && a.Id!=_actor.Id).Select(a=>(Guid?)a.Id))" ItemLabel="ActorName" NullOption="@(AlvaStrings.People_NoSubTeam)" @bind-Value="_actor.ParentId" /> }
            @if(_actor.Kind=="Person") { @foreach(var department in _actors.Where(a=>a.Kind=="Department")){<FlareCheckbox Value="_actor.DepartmentIds.Contains(department.Id)" ValueChanged="(bool value)=>ToggleDepartment(department.Id,value)">@department.Name</FlareCheckbox>} }
        </FlareStack>
    </FlareCardContent>
    <FlareCardActions>
        <FlareButton Loading="_busy" OnClick="SaveActor" Disabled="@(string.IsNullOrWhiteSpace(_actor.Name) || !IsDirty)">@(AlvaStrings.Common_Save)</FlareButton>
        <FlareButton Variant="ButtonVariant.Text" OnClick="CloseActor">@(AlvaStrings.Common_Close)</FlareButton>
        @if(_actor.Id!=Guid.Empty)
        {
            @if(_actor.Kind!="Skill") { <FlareButton Href="@(_actor.Kind=="Department"?$"capacity/{_actor.Id}/schedule":$"capacity/{_actor.Id}")" Variant="ButtonVariant.Text">@(AlvaStrings.People_WorkSchedule)</FlareButton> }
            <FlareButton Variant="ButtonVariant.Text" Color="FlareColor.Error" OnClick="ArchiveActor">@(AlvaStrings.Common_Archive)</FlareButton>
        }
    </FlareCardActions>
</FlareCard>
}
</FlareGrid>
}
@code {
    private ActorModel[] _actors=[];private ActorModel? _actor;private bool _busy;private string? _error;
    private string? _actorSnapshot; private bool _saved; private IDisposable? _draft;
    private string? _nameError,_emailError; private readonly List<string> _formErrors=[]; private ElementReference _errorSummary;
    [CascadingParameter] public FlareConfirmDialogProvider? Confirm { get; set; }
    internal bool IsDirty => _actor is not null && DraftSnapshot.Of(_actor) != _actorSnapshot;
    protected override void OnInitialized() => _draft = Drafts.Track(() => IsDirty);
    private string Route=>AppRoutes.Current(Navigation);
    private string Kind=>Route.EndsWith("departments")?"Department":Route.EndsWith("skills")||Route.EndsWith("roles")?"Skill":"Person";
    private string Title=>Kind=="Skill"?AlvaStrings.People_TeamSkills:Kind=="Department"?AlvaStrings.Common_SubTeams:AlvaStrings.People_TeamPeople;
    private string Category=>Kind=="Skill"?AlvaStrings.People_RegistrySkills:Kind=="Department"?AlvaStrings.People_RegistrySubTeams:AlvaStrings.People_RegistryPeople;

    // Адрес — источник истины: вкладка только переводит индекс в маршрут.
    private int TabIndex
    {
        get => Kind == "Skill" ? 2 : Kind == "Department" ? 1 : 0;
        set
        {
            var path = value switch { 1 => "team/departments", 2 => "team/skills", _ => "team" };
            if (!Route.Equals(path, StringComparison.OrdinalIgnoreCase)) Navigation.NavigateTo(path);
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        // Old bookmarks keep working: roles became the team's skills.
        if (Route.EndsWith("roles", StringComparison.OrdinalIgnoreCase)) { Navigation.NavigateTo("team/skills"); return; }
        Close(); await Load();
    }
    private async Task Run(Func<Task> action){_busy=true;_error=null;try{await action();}catch(Exception e) when(e is HttpRequestException or InvalidOperationException){_error=PageFeedback.Describe(e);}finally{_busy=false;}}
    private Task Load()=>Run(async()=>{await Session.Initialize();if(Session.TeamId is null)return;_actors=await Session.Get<ActorModel[]>(Session.TeamPath("actors"));});
    private void New(){_saved=false;_actor=new ActorModel {Kind=Kind};_actorSnapshot=DraftSnapshot.Of(_actor);}
    private void Close(){_actor=null;_actorSnapshot=null;}
    private async Task CloseActor()
    {
        if (!await DraftPrompt.CanDiscardAsync(Confirm, IsDirty)) return;
        Close();
    }

    private async Task ConfirmLeave(LocationChangingContext context)
    {
        if (!IsDirty) return;
        if (!await DraftPrompt.CanDiscardAsync(Confirm, true)) { context.PreventNavigation(); return; }
        Close();
    }

    public void Dispose() => _draft?.Dispose();
    private void EditActor(ActorModel model){_saved=false;Close();_actor=new ActorModel{Id=model.Id,Name=model.Name,Kind=model.Kind,Email=model.Email,ParentId=model.ParentId,SkillIds=[..model.SkillIds],DepartmentIds=[..model.DepartmentIds],UserId=model.UserId};_actorSnapshot=DraftSnapshot.Of(_actor);}
    private string[] SkillNames(ActorModel actor) => actor.SkillIds.Select(id => _actors.FirstOrDefault(a => a.Id == id)?.Name).OfType<string>().ToArray();
    private void ToggleDepartment(Guid id,bool value)=>_actor!.DepartmentIds=value?_actor.DepartmentIds.Append(id).Distinct().ToArray():_actor.DepartmentIds.Where(x=>x!=id).ToArray();
    private string ActorName(Guid? id)=>_actors.FirstOrDefault(a=>a.Id==id)?.Name??AlvaStrings.People_NoSubTeam;
    private async Task SaveActor()
    {
        _nameError=_emailError=null;_formErrors.Clear();
        var a=_actor!;
        if (string.IsNullOrWhiteSpace(a.Name)) { _nameError=AlvaStrings.Common_ANameIsRequired; _formErrors.Add(_nameError); }
        if (a.Kind=="Person" && !string.IsNullOrWhiteSpace(a.Email) && !System.Net.Mail.MailAddress.TryCreate(a.Email, out _)) { _emailError=AlvaStrings.Common_EnterAValidEmailAddress; _formErrors.Add(_emailError); }
        if (_formErrors.Count > 0) { StateHasChanged(); await SafeFocus.Async(_errorSummary); return; }
        await Run(async()=>{await Session.Send(a.Id==Guid.Empty?HttpMethod.Post:HttpMethod.Put,Session.TeamPath("actors"+(a.Id==Guid.Empty?"":$"/{a.Id}")),new ActorRequest(a.Name,a.Kind,a.Email,a.ParentId,a.UserId,SkillIds:a.SkillIds,DepartmentIds:a.DepartmentIds));_saved=true;Close();_actors=await Session.Get<ActorModel[]>(Session.TeamPath("actors"));});
    }
    private async Task ArchiveActor()
    {
        if (!await DestructivePrompt.ConfirmAsync(Confirm, AlvaStrings.People_ArchiveMember,
            string.Format(AlvaStrings.People_WillLeaveTheRegistryItsAssignmentsStayInTheHistory, _actor!.Name),
            AlvaStrings.Common_Archive)) return;
        await Run(async()=>{await Session.Send(HttpMethod.Delete,Session.TeamPath($"actors/{_actor!.Id}"),new{});Close();_actors=await Session.Get<ActorModel[]>(Session.TeamPath("actors"));});
    }
}
