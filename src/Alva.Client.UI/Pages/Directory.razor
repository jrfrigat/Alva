@page "/team"
@page "/team/departments"
@page "/team/roles"
@implements IDisposable
@inject AlvaSession Session
@inject NavigationManager Navigation
@inject DraftGuard Drafts
<PageTitle>@Title · Alva</PageTitle>
<NavigationLock OnBeforeInternalNavigation="ConfirmLeave" ConfirmExternalNavigation="IsDirty" />
<AlvaPageHeader Category="@Category" Title="@Title">
    <Actions><FlareButton Size="ButtonSize.Sm" OnClick="New" Disabled="@(Session.TeamId is null)">@(Strings.T("Добавить"))</FlareButton></Actions>
</AlvaPageHeader>
<PageFeedback Loading="_busy" Error="@_error" OnRetry="Load" />
<EditorStatus Dirty="IsDirty" Saving="_busy" Saved="_saved" />
@if(Session.TeamId is null) { <TeamRequired /> }
else
{
<FlareStack Row Wrap>
    <FlareButton Href="team" Size="ButtonSize.Sm" Variant="@(Route == "team" ? ButtonVariant.Tonal : ButtonVariant.Text)" Selected="@(Route == "team")">@(Strings.T("Люди"))</FlareButton>
    <FlareButton Href="team/departments" Size="ButtonSize.Sm" Variant="@(Route == "team/departments" ? ButtonVariant.Tonal : ButtonVariant.Text)" Selected="@(Route == "team/departments")">@(Strings.T("Подкоманды"))</FlareButton>
    <FlareButton Href="team/roles" Size="ButtonSize.Sm" Variant="@(Route == "team/roles" ? ButtonVariant.Tonal : ButtonVariant.Text)" Selected="@(Route == "team/roles")">@(Strings.T("Роли"))</FlareButton>
</FlareStack>
<FlareGrid MinColumnWidth="min(100%,24rem)" Gap="FlareSpacing.Large">
<FlareCard Variant="CardVariant.Outlined"><FlareCardContent>
    <FlareDataGrid TItem="ActorModel" Items="_actors.Where(a=>a.Kind==Kind)" Height="auto" Hoverable Dense="true">
    <Columns>
        <FlareColumn TItem="ActorModel" Title="@(Strings.T("Имя"))" Field="a=>a!.Name" Sortable Filterable><Template Context="a"><FlareButton Variant="ButtonVariant.Text" Size="ButtonSize.Sm" OnClick="()=>EditActor(a!)">@a!.Name</FlareButton></Template></FlareColumn>
        <FlareColumn TItem="ActorModel" Title="@(Strings.T("Почта"))" Field="a=>a!.Email" />
        @if (Kind == "Person")
        {
            <FlareColumn TItem="ActorModel" Title="@(Strings.T("Навыки"))"><Template Context="a"><FlareStack Row Wrap>@foreach(var skill in a!.Skills){<FlareChip TValue="string" Value="skill">@skill</FlareChip>}</FlareStack></Template></FlareColumn>
        }
    </Columns><EmptyStateContent><FlareEmptyState Compact Title="@(Strings.T("Список пока пуст"))" Description="@(Strings.T("Добавьте участников, подкоманды и роли для назначения задач."))" /></EmptyStateContent>
    </FlareDataGrid>
</FlareCardContent></FlareCard>
@if(_actor is not null)
{
<FlareCard Variant="CardVariant.Outlined"><FlareCardContent><FlareStack>
    <FlareText Element="h2" Typo="TypographyScale.TitleLarge">@Labels.Kind(_actor.Kind)</FlareText>
    @if (_formErrors.Count > 0) { <div class="alva-form-errors" role="alert" tabindex="-1" @ref="_errorSummary"><b>@(Strings.T("Проверьте выделенные поля."))</b>@foreach (var error in _formErrors) { <div>@error</div> }</div> }
    <FlareTextField Label="@(Strings.T("Имя или название"))" ErrorText="@_nameError" @bind-Value="_actor.Name" Required />
    @if(_actor.Kind=="Person") { <FlareTextField Label="@(Strings.T("Электронная почта"))" ErrorText="@_emailError" @bind-Value="_actor.Email" Type="email" /> }
    @if(_actor.Kind=="Person") { <SkillTagEditor Label="@(Strings.T("Навыки"))" @bind-Values="_actor.Skills" Suggestions="_skillSuggestions" /> }
    @if(_actor.Kind!="Role") { <FlareSelect TValue="Guid?" Label="@(_actor.Kind=="Department" ? Strings.T("Родительская подкоманда") : Strings.T("Подкоманда"))" Items="@(_actors.Where(a=>a.Kind=="Department" && a.Id!=_actor.Id).Select(a=>(Guid?)a.Id))" ItemLabel="ActorName" NullOption="@(Strings.T("Без подкоманды"))" @bind-Value="_actor.ParentId" /> }
    @if(_actor.Kind=="Person") { @foreach(var department in _actors.Where(a=>a.Kind=="Department")){<FlareCheckbox Value="_actor.DepartmentIds.Contains(department.Id)" ValueChanged="(bool value)=>ToggleDepartment(department.Id,value)">@department.Name</FlareCheckbox>} }
    @if(_actor.Kind!="Role") {
    <FlareSelect TValue="Guid?" Label="@(Strings.T("Добавить роль"))" Items="@(_actors.Where(a=>a.Kind=="Role").Select(a=>(Guid?)a.Id))" ItemLabel="ActorName" NullOption="@(Strings.T("Выберите роль"))" @bind-Value="_role" />
    <FlareButton Variant="ButtonVariant.Text" Size="ButtonSize.Sm" OnClick="AddRole" Disabled="@(!_role.HasValue)">@(Strings.T("Добавить роль"))</FlareButton>
    <FlareStack Row Wrap>@foreach(var role in _actor.RoleIds) { <FlareButton Variant="ButtonVariant.Tonal" Size="ButtonSize.Sm" OnClick="()=>RemoveRole(role)">@ActorName(role) ×</FlareButton> }</FlareStack>
    }
    <FlareStack Row Wrap><FlareButton Loading="_busy" OnClick="SaveActor" Disabled="@(string.IsNullOrWhiteSpace(_actor.Name) || !IsDirty)">@(Strings.T("Сохранить"))</FlareButton><FlareButton Variant="ButtonVariant.Text" OnClick="CloseActor">@(Strings.T("Закрыть"))</FlareButton>
    @if(_actor.Id!=Guid.Empty) { @if(_actor.Kind!="Role") { <FlareButton Href="@(_actor.Kind=="Department"?$"capacity/{_actor.Id}/schedule":$"capacity/{_actor.Id}")" Variant="ButtonVariant.Text">@(Strings.T("Рабочий график"))</FlareButton> }<FlareButton Variant="ButtonVariant.Text" Color="FlareColor.Error" OnClick="ArchiveActor">@(Strings.T("Архивировать"))</FlareButton> }</FlareStack>
</FlareStack></FlareCardContent></FlareCard>
}
</FlareGrid>
}
@code {
    private ActorModel[] _actors=[];private ActorModel? _actor;private Guid? _role;private bool _busy;private string? _error;
    private string? _actorSnapshot; private bool _saved; private IDisposable? _draft;
    private string? _nameError,_emailError; private readonly List<string> _formErrors=[]; private ElementReference _errorSummary;
    [CascadingParameter] public FlareConfirmDialogProvider? Confirm { get; set; }
    internal bool IsDirty => _actor is not null && DraftSnapshot.Of(_actor) != _actorSnapshot;
    protected override void OnInitialized() => _draft = Drafts.Track(() => IsDirty);
    private string[] _skillSuggestions=[];
    private string Route=>AppRoutes.Current(Navigation);
    private string Kind=>Route.EndsWith("departments")?"Department":Route.EndsWith("roles")?"Role":"Person";
    private string Title=>Kind=="Role"?Strings.T("Роли команды"):Kind=="Department"?Strings.T("Подкоманды"):Strings.T("Люди команды");
    private string Category=>Kind=="Role"?Strings.T("Реестр · Роли"):Kind=="Department"?Strings.T("Реестр · Подкоманды"):Strings.T("Реестр · Люди");
    protected override async Task OnParametersSetAsync(){Close();await Load();}
    private async Task Run(Func<Task> action){_busy=true;_error=null;try{await action();}catch(Exception e) when(e is HttpRequestException or InvalidOperationException){_error=PageFeedback.Describe(e);}finally{_busy=false;}}
    private Task Load()=>Run(async()=>{await Session.Initialize();if(Session.TeamId is null)return;_actors=await Session.Get<ActorModel[]>(Session.TeamPath("actors"));await LoadSkillSuggestions();});
    private async Task LoadSkillSuggestions()
    {
        var tags = _actors.SelectMany(a=>a.Skills);
        try { tags = tags.Concat((await Session.Get<TaskModel[]>(Session.TeamPath("tasks"))).SelectMany(t=>t.RequiredSkills)); }
        catch (HttpRequestException e) when(e.StatusCode==System.Net.HttpStatusCode.Forbidden) { }
        _skillSuggestions=tags.Distinct(StringComparer.OrdinalIgnoreCase).Order(StringComparer.CurrentCultureIgnoreCase).ToArray();
    }
    private void New(){_saved=false;_actor=new ActorModel {Kind=Kind};_actorSnapshot=DraftSnapshot.Of(_actor);}
    private void Close(){_actor=null;_role=null;_actorSnapshot=null;}
    private async Task CloseActor()
    {
        if (!await DraftPrompt.CanDiscardAsync(Confirm, IsDirty)) return;
        Close();
    }

    private async Task ConfirmLeave(LocationChangingContext context)
    {
        if (!IsDirty) return;
        if (!await DraftPrompt.CanDiscardAsync(Confirm, true)) { context.PreventNavigation(); return; }
        Close();
    }

    public void Dispose() => _draft?.Dispose();
    private void EditActor(ActorModel model){_saved=false;Close();_actor=new ActorModel{Id=model.Id,Name=model.Name,Kind=model.Kind,Email=model.Email,ParentId=model.ParentId,RoleIds=[..model.RoleIds],DepartmentIds=[..model.DepartmentIds],UserId=model.UserId,Skills=[..model.Skills]};_actorSnapshot=DraftSnapshot.Of(_actor);}
    private void ToggleDepartment(Guid id,bool value)=>_actor!.DepartmentIds=value?_actor.DepartmentIds.Append(id).Distinct().ToArray():_actor.DepartmentIds.Where(x=>x!=id).ToArray();
    private string ActorName(Guid? id)=>_actors.FirstOrDefault(a=>a.Id==id)?.Name??Strings.T("Без подкоманды");
    private void AddRole(){if(_role.HasValue)_actor!.RoleIds=_actor.RoleIds.Append(_role.Value).Distinct().ToArray();_role=null;}
    private void RemoveRole(Guid id)=>_actor!.RoleIds=_actor.RoleIds.Where(x=>x!=id).ToArray();
    private async Task SaveActor()
    {
        _nameError=_emailError=null;_formErrors.Clear();
        var a=_actor!;
        if (string.IsNullOrWhiteSpace(a.Name)) { _nameError=Strings.T("Имя обязательно."); _formErrors.Add(_nameError); }
        if (a.Kind=="Person" && !string.IsNullOrWhiteSpace(a.Email) && !System.Net.Mail.MailAddress.TryCreate(a.Email, out _)) { _emailError=Strings.T("Некорректный адрес почты."); _formErrors.Add(_emailError); }
        if (_formErrors.Count > 0) { StateHasChanged(); await SafeFocus.Async(_errorSummary); return; }
        await Run(async()=>{await Session.Send(a.Id==Guid.Empty?HttpMethod.Post:HttpMethod.Put,Session.TeamPath("actors"+(a.Id==Guid.Empty?"":$"/{a.Id}")),new ActorRequest(a.Name,a.Kind,a.Email,a.ParentId,a.UserId,a.RoleIds,a.DepartmentIds,a.Skills));_saved=true;Close();_actors=await Session.Get<ActorModel[]>(Session.TeamPath("actors"));});
    }
    private async Task ArchiveActor()
    {
        if (!await DestructivePrompt.ConfirmAsync(Confirm, Strings.T("Архивировать участника"),
            string.Format(Strings.T("«{0}» уйдёт из реестра; назначения на него останутся в истории."), _actor!.Name),
            Strings.T("Архивировать"))) return;
        await Run(async()=>{await Session.Send(HttpMethod.Delete,Session.TeamPath($"actors/{_actor!.Id}"),new{});Close();_actors=await Session.Get<ActorModel[]>(Session.TeamPath("actors"));});
    }
}
