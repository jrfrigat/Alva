@page "/workspaces"
@inject AlvaSession Session
@inject NavigationManager Navigation
<PageTitle>@(AlvaStrings.Workspace_WorkspaceAlva)</PageTitle>
<AlvaPageHeader Title="@(AlvaStrings.Workspace_WorkspaceAndTeams)" />
<PageFeedback Loading="_busy" Error="@_error" OnRetry="Reload" />
<EditorStatus Saved="_saved" Saving="_busy" />
@if (Session.User is null) { <TeamRequired /> }
else
{
<FlareGrid MinColumnWidth="min(100%, 20rem)">
    <FlareCard Variant="CardVariant.Outlined"><FlareCardContent><FlareStack>
        <FlareText Element="h2" Typo="TypographyScale.TitleLarge">@(AlvaStrings.Workspace_Workspaces)</FlareText>
        @foreach(var item in Session.Workspaces) { <FlareStack Row Align="FlareAlignItems.Center" Gap="FlareSpacing.Small"><FlareButton Variant="@(Session.WorkspaceId == item.Id ? ButtonVariant.Tonal : ButtonVariant.Text)" OnClick="() => SelectWorkspace(item.Id)">@item.Name</FlareButton>@if (Session.WorkspaceId == item.Id) { <AlvaStatusChip Tone="AlvaTone.Ok">@(AlvaStrings.Workspace_Current)</AlvaStatusChip> }</FlareStack> }
        <FlareTextField Label="@(AlvaStrings.Workspace_NewWorkspace)" @bind-Value="_spaceName" @bind-Value:after="() => _saved = false" />
        <FlareButton Disabled="@(string.IsNullOrWhiteSpace(_spaceName) || _busy)" OnClick="CreateSpace">@(AlvaStrings.Common_CreateAWorkspace)</FlareButton>
    </FlareStack></FlareCardContent></FlareCard>
    <FlareCard Variant="CardVariant.Outlined"><FlareCardContent><FlareStack>
        <FlareText Element="h2" Typo="TypographyScale.TitleLarge">@(AlvaStrings.Workspace_Teams)</FlareText>
        @foreach(var item in Session.Teams) { <FlareStack Row Align="FlareAlignItems.Center" Gap="FlareSpacing.Small"><FlareButton Variant="@(Session.TeamId == item.Id ? ButtonVariant.Tonal : ButtonVariant.Text)" OnClick="() => SelectTeam(item.Id)">@item.Name</FlareButton>@if (Session.TeamId == item.Id) { <AlvaStatusChip Tone="AlvaTone.Ok">@(AlvaStrings.Workspace_Current)</AlvaStatusChip> }</FlareStack> }
        @if (Session.Teams.Length == 0) { <FlareText>@(AlvaStrings.Workspace_CreateTheFirstTeamInTheWorkspace)</FlareText> }
        <FlareTextField Label="@(AlvaStrings.Workspace_NewTeam)" @bind-Value="_teamName" @bind-Value:after="() => _saved = false" />
        <FlareButton Disabled="@(Session.WorkspaceId is null || string.IsNullOrWhiteSpace(_teamName) || _busy)" OnClick="CreateTeam">@(AlvaStrings.Workspace_CreateATeam)</FlareButton>
    </FlareStack></FlareCardContent></FlareCard>
</FlareGrid>
}
@code {
    private string? _spaceName, _teamName, _error; private bool _busy, _saved;
    protected override async Task OnInitializedAsync() => await Run(Session.Initialize);
    private Task Reload() => OnInitializedAsync();
    private async Task Run(Func<Task> action) { _busy=true; _error=null; try { await action(); } catch(Exception e) when(e is HttpRequestException or InvalidOperationException) { _error=PageFeedback.Describe(e); } finally { _busy=false; } }
    private Task SelectWorkspace(Guid id) => Run(() => Session.SelectWorkspace(id));
    private Task SelectTeam(Guid id) => Run(async () => { await Session.SelectTeam(id); Navigation.NavigateTo(AppRoutes.Home); });
    private Task CreateSpace() => Run(async () => { await Session.Send(HttpMethod.Post,"api/workspaces",new { name=_spaceName }); _spaceName=null; await Session.LoadWorkspaces(); _saved=true; });
    private Task CreateTeam() => Run(async () => { await Session.Send(HttpMethod.Post,$"api/workspaces/{Session.WorkspaceId}/teams",new { name=_teamName }); _teamName=null; await Session.SelectWorkspace(Session.WorkspaceId!.Value); _saved=true; });
}
