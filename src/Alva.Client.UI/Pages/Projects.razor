@page "/projects"
@implements IDisposable
@inject AlvaSession Session
@inject NavigationManager Navigation
@inject DraftGuard Drafts
@* Реестр проектов по макету p13: карточки проектов слева, выбранный проект справа — KPI,
   команды и их спринты, дерево задач (WBS). Статус проекта выводится из его задач. *@
<PageTitle>@(Strings.T("Проекты · Alva"))</PageTitle>
<NavigationLock OnBeforeInternalNavigation="ConfirmLeave" ConfirmExternalNavigation="IsDirty" />
<AlvaPageHeader Category="@(Strings.T("Проекты нескольких команд"))" Title="@(Strings.T("Проекты"))" Description="@(Strings.T("Реестр проектов и вовлечённость команд. Проекты объединяют задачи, исполняемые спринтами разных команд."))">
    <Actions><FlareButton Size="ButtonSize.Sm" OnClick="New" Disabled="@(Session.TeamId is null)"><LeadingIcon><FlareIconView Value="@MaterialDesign3Icons.Regular.AddCircle" Size="18px" /></LeadingIcon><ChildContent>@(Strings.T("Новый проект"))</ChildContent></FlareButton></Actions>
</AlvaPageHeader>
<PageFeedback Loading="_busy" Error="@_error" OnRetry="Load" />
<EditorStatus Dirty="IsDirty" Saving="_busy" Saved="_saved" />
@if (Session.TeamId is null) { <TeamRequired /> }
else
{
<FlareStack Gap="FlareSpacing.Small">
    <FlareTabs @bind-ActiveIndex="FilterIndex">
        <FlareTab Label="@($"{Strings.T("Все проекты")} ({_projects.Length})")" />
        <FlareTab Label="@($"{Strings.T("В работе")} ({_projects.Count(p => Status(p) == "active")})")" />
        <FlareTab Label="@($"{Strings.T("Не начаты")} ({_projects.Count(p => Status(p) == "new")})")" />
        <FlareTab Label="@($"{Strings.T("Завершены")} ({_projects.Count(p => Status(p) == "done")})")" />
    </FlareTabs>
    <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant"><FlareIconView Value="@MaterialDesign3Icons.Regular.Info" Size="16px" /> @(Strings.T("Проект не имеет собственных спринтов — исполнение через спринты команд"))</FlareText>
</FlareStack>

@if (_project is not null)
{
<FlareCard Variant="CardVariant.Outlined"><FlareCardContent><FlareStack>
    <FlareText Element="h2" Typo="TypographyScale.TitleLarge">@(_project.Id == Guid.Empty ? Strings.T("Новый проект") : Strings.T("Настройки проекта"))</FlareText>
    <FlareTextField Label="@(Strings.T("Название"))" @bind-Value="_project.Name" Required />
    <FlareTextArea Label="@(Strings.T("Описание"))" @bind-Value="_project.Description" AutoGrow />
    <FlareText Typo="TypographyScale.LabelLarge">@(Strings.T("Команды проекта"))</FlareText>
    @foreach (var team in Session.Teams) { <FlareCheckbox TValue="bool" Value="_project.TeamIds.Contains(team.Id)" ValueChanged="(bool value) => ToggleTeam(team.Id, value)">@team.Name</FlareCheckbox> }
    <FlareStack Row Wrap>
        <FlareButton Loading="_busy" OnClick="SaveProject" Disabled="@(string.IsNullOrWhiteSpace(_project.Name) || !IsDirty)">@(Strings.T("Сохранить"))</FlareButton>
        <FlareButton Variant="ButtonVariant.Text" OnClick="CloseProject">@(Strings.T("Закрыть"))</FlareButton>
        @if (_project.Id != Guid.Empty) { <FlareButton Variant="ButtonVariant.Text" Color="FlareColor.Error" OnClick="ArchiveProject">@(Strings.T("Архивировать"))</FlareButton> }
    </FlareStack>
</FlareStack></FlareCardContent></FlareCard>
}

@if (_projects.Length == 0 && !_busy)
{
    <FlareEmptyState Title="@(Strings.T("Добавьте первый проект"))" Description="@(Strings.T("Объедините связанные задачи общим результатом."))" />
}
else
{
<div class="alva-proj-layout">
    <FlareCard Variant="CardVariant.Outlined">
        <FlareCardHeader Title="@(Strings.T("Реестр проектов"))" Subtitle="@(Strings.T("Сортировка: нагрузка"))" />
        <FlareCardContent>
            @if (!Visible.Any())
            {
                <FlareEmptyState Compact Title="@(Strings.T("Проектов нет"))" Description="@(Strings.T("Смените фильтр статуса."))" />
            }
            else
            {
                <FlareList TItem="ProjectModel" Dense="true">
                    @foreach (var project in Visible)
                    {
                        var (done, total) = HoursOf(project);
                        var tasks = ProjectTasks(project);
                        <FlareListItem @key="project.Id" Selected="@(project.Id == Selected?.Id)" OnClick="() => Select(project.Id)">
                            <Leading><FlareAvatar Text="@AlvaFormat.Initials(project.Name)" Size="AvatarSize.Sm" Color="FlareColor.Primary" /></Leading>
                            <ChildContent>
                                <FlareStack Gap="FlareSpacing.XXSmall">
                                    <FlareStack Row Wrap Align="FlareAlignItems.Center" Gap="FlareSpacing.Small">
                                        <FlareText Typo="TypographyScale.LabelMedium">@project.Name</FlareText>
                                        <AlvaStatusChip Tone="StatusTone(Status(project))">@StatusLabel(Status(project))</AlvaStatusChip>
                                    </FlareStack>
                                    @if (!string.IsNullOrWhiteSpace(project.Description)) { <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@project.Description</FlareText> }
                                    <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@(Strings.T("Команды:")) @project.TeamIds.Length @AlvaFormat.Plural(project.TeamIds.Length, "team") · @string.Join(" · ", project.TeamIds.Select(TeamName))</FlareText>
                                    <FlareProgressLinear Value="@Pct(done, total)" Size="TrackSize.Xs" Color="FlareColor.Primary" aria-label="@(Strings.T("Прогресс проекта"))" />
                                    <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@Pct(done, total)% (@tasks.Count(t => t.Status == "Done") / @tasks.Length @AlvaFormat.Plural(tasks.Length, "task")) · @(Strings.T("Последний срок задач:")) @(LatestDeadline(project)?.ToString("d MMM yyyy") ?? "—")</FlareText>
                                </FlareStack>
                            </ChildContent>
                        </FlareListItem>
                    }
                </FlareList>
            }
            <FlareStack Row Align="FlareAlignItems.Center" Gap="FlareSpacing.Small">
                <FlareIconView Value="@MaterialDesign3Icons.Regular.Hub" Size="18px" />
                <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant"><b>@(Strings.T("Проект нескольких команд."))</b> @(Strings.T("Проект не привязан к одной команде: его задачи затягиваются разными командами в их спринты."))</FlareText>
            </FlareStack>
        </FlareCardContent>
    </FlareCard>

    @if (Selected is { } p)
    {
        var tasks = TasksOf(p);
        var all = ProjectTasks(p);
        var (done, total) = HoursOf(p);
        var (teamDone, teamTotal) = Hours(tasks);
        var closed = p.TeamIds.Count(_closedTeams.Contains);
        var sprints = SprintsOf(p);
        var latest = LatestDeadline(p);
        var risks = _risks.Count(r => tasks.Any(t => t.Id == r.TaskId));
        <section class="alva-proj-detail" aria-label="@p.Name">
            <FlareCard Variant="CardVariant.Outlined">
                <FlareCardHeader Class="alva-proj-detail__head" Title="@p.Name" Subtitle="@p.Description">
                    <AvatarContent><AlvaStatusChip Tone="StatusTone(Status(p))">@StatusLabel(Status(p))</AlvaStatusChip></AvatarContent>
                    <ActionContent>
                        <FlareButton Variant="ButtonVariant.Tonal" Size="ButtonSize.Sm" OnClick="() => Edit(p)"><LeadingIcon><FlareIconView Value="@MaterialDesign3Icons.Regular.Edit" Size="18px" /></LeadingIcon><ChildContent>@(Strings.T("Настройки проекта"))</ChildContent></FlareButton>
                        <FlareButton Href="@($"tasks?new=1&project={p.Id}&back=project")" Size="ButtonSize.Sm"><LeadingIcon><FlareIconView Value="@MaterialDesign3Icons.Regular.AddTask" Size="18px" /></LeadingIcon><ChildContent>@(Strings.T("Создать задачу"))</ChildContent></FlareButton>
                    </ActionContent>
                </FlareCardHeader>
                <FlareCardContent>
                <FlareGrid MinColumnWidth="min(100%,10rem)">
                    <FlareStat Label="@(Strings.T("Общий прогресс"))" Value="@($"{Pct(done, total)}%")">
                        <CaptionContent>
                            <FlareStack Gap="FlareSpacing.XSmall">
                                <FlareProgressLinear Value="@Pct(done, total)" Size="TrackSize.Xs" Color="FlareColor.Primary" aria-label="@(Strings.T("Общий прогресс"))" />
                                <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@all.Count(t => t.Status == "Done") @(Strings.T("из")) @all.Length @(Strings.T("задач закрыто"))</FlareText>
                                @if (p.TeamIds.Length > 1) { <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@(Strings.T("Вклад команды")) «@TeamName(Session.TeamId!.Value)»: @Pct(teamDone, teamTotal)% · @tasks.Length @AlvaFormat.Plural(tasks.Length, "task")</FlareText> }
                                @if (closed > 0) { <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@(Strings.T("Без команд, к которым нет доступа:")) @closed</FlareText> }
                            </FlareStack>
                        </CaptionContent>
                    </FlareStat>
                    <FlareStat Label="@(Strings.T("Трудозатраты"))" Value="@($"{AlvaFormat.Hours(total)} {Strings.T("ч")}")" Caption="@($"{Strings.T("Закрыто:")} {AlvaFormat.Hours(done)} {Strings.T("ч")} / {Strings.T("Остаток:")} {AlvaFormat.Hours(total - done)} {Strings.T("ч")}")" />
                    <FlareStat Label="@(Strings.T("Активные спринты"))" Value="@($"{sprints.Count(s => s.Status == "Active")} {AlvaFormat.Plural(sprints.Count(s => s.Status == "Active"), "sprint")}")" Caption="@($"{all.Count(t => t.Status == "InProgress")} {AlvaFormat.Plural(all.Count(t => t.Status == "InProgress"), "task")} {Strings.T("сейчас в работе")}")" />
                    <FlareStat Label="@(Strings.T("Последний срок задач"))" Value="@(latest?.ToString("d MMM") ?? "—")">
                        <CaptionContent>
                            <FlareStack Gap="FlareSpacing.XSmall">
                                <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@(latest is { } r ? string.Format(Strings.T("{0} (осталось {1} дн.)"), r.Year, Math.Max(0, r.DayNumber - DateOnly.FromDateTime(DateTime.Today).DayNumber)) : Strings.T("Дедлайны не заданы"))</FlareText>
                                @if (risks > 0) { <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.Error">@risks @AlvaFormat.Plural(risks, "risk") @(Strings.T("по задачам"))</FlareText> }
                            </FlareStack>
                        </CaptionContent>
                    </FlareStat>
                </FlareGrid>
                </FlareCardContent>
            </FlareCard>

            <h3 class="alva-section-title"><FlareIconView Value="@MaterialDesign3Icons.Regular.Hub" Size="18px" /> @(Strings.T("Команды и их спринты по проекту"))</h3>
            <div class="alva-proj-teams">
                @foreach (var teamId in p.TeamIds)
                {
                    <FlareCard Variant="CardVariant.Outlined" Class="alva-proj-team" @key="teamId">
                        <FlareCardHeader Title="@TeamName(teamId)">
                            <AvatarContent><FlareAvatar Text="@AlvaFormat.Initials(TeamName(teamId))" Size="AvatarSize.Sm" Color="FlareColor.Primary" /></AvatarContent>
                            <ActionContent>@if (teamId == Session.TeamId) { <AlvaStatusChip Tone="AlvaTone.Info">@(Strings.T("Текущая команда"))</AlvaStatusChip> }</ActionContent>
                        </FlareCardHeader>
                        <FlareCardContent>
                            @if (teamId == Session.TeamId)
                            {
                                @if (sprints.Length > 0)
                                {
                                    <FlareList TItem="SprintModel" Dense="true">
                                        @foreach (var sprint in sprints)
                                        {
                                            var inSprint = tasks.Where(t => t.SprintIds.Contains(sprint.Id)).ToArray();
                                            <FlareListItem @key="sprint.Id" OnClick="() => OpenSprint(sprint.Id)">
                                                <Leading><FlareIconView Value="@MaterialDesign3Icons.Regular.Flag" Size="18px" /></Leading>
                                                <ChildContent>
                                                    <FlareStack Gap="FlareSpacing.None">
                                                        <FlareText Typo="TypographyScale.LabelMedium">@sprint.Name</FlareText>
                                                        <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@(Strings.T("Взято задач проекта:")) @inSprint.Length (@AlvaFormat.Hours(SprintHours.Sum(inSprint, sprint)) @(Strings.T("ч")))</FlareText>
                                                    </FlareStack>
                                                </ChildContent>
                                                <Trailing><AlvaStatusChip Tone="AlvaTones.Status(sprint.Status)">@Labels.Status(sprint.Status)</AlvaStatusChip></Trailing>
                                            </FlareListItem>
                                        }
                                    </FlareList>
                                }
                                <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@(Strings.T("В бэклоге команды:")) @tasks.Count(t => !t.Planned && t.Status is not ("Done" or "Cancelled")) @AlvaFormat.Plural(tasks.Count(t => !t.Planned && t.Status is not ("Done" or "Cancelled")), "task") (@AlvaFormat.Hours(tasks.Where(t => !t.Planned && t.Status is not ("Done" or "Cancelled")).Sum(t => t.EstimateHours ?? 0)) @(Strings.T("ч")))</FlareText>
                            }
                            else
                            {
                                <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@(Strings.T("Задачи и спринты этой команды видны в её собственном пространстве."))</FlareText>
                            }
                        </FlareCardContent>
                    </FlareCard>
                }
            </div>

            <FlareCard Variant="CardVariant.Outlined" Class="alva-wbs">
                <FlareCardHeader Title="@(Strings.T("Дерево задач проекта"))" Subtitle="@(Strings.T("Иерархия задач с проекцией на спринты и исполнителей"))">
                    <AvatarContent><FlareIconView Value="@MaterialDesign3Icons.Regular.AccountTree" Size="20px" /></AvatarContent>
                    <ActionContent><FlareTextField @bind-Value="_wbsSearch" Immediate Clearable Placeholder="@(Strings.T("Поиск в дереве…"))" AriaLabel="@(Strings.T("Поиск в дереве задач"))"><AdornmentStart><FlareIconView Value="@MaterialDesign3Icons.Regular.Search" Size="18px" /></AdornmentStart></FlareTextField></ActionContent>
                </FlareCardHeader>
                <FlareCardContent>
                    @if (!Tree(tasks).Any())
                    {
                        <FlareEmptyState Compact Title="@(Strings.T("Задач в проекте пока нет."))" />
                    }
                    else
                    {
                        <FlareList TItem="TaskModel" Dense="true">
                            @foreach (var (task, depth) in Tree(tasks))
                            {
                                <FlareListItem @key="task.Id" OnClick="() => OpenTask(task.Id)" Style="@("padding-left: " + depth * 20 + "px")">
                                    <Leading><FlareIconView Value="@(tasks.Any(t => t.ParentId == task.Id) ? MaterialDesign3Icons.Regular.Folder : MaterialDesign3Icons.Regular.SubdirectoryArrowRight)" Size="16px" /></Leading>
                                    <ChildContent>
                                        <FlareStack Gap="FlareSpacing.None">
                                            <FlareText Typo="TypographyScale.LabelMedium">@task.Title</FlareText>
                                            <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@(task.SprintIds.Length == 0 ? Strings.T("Бэклог команды") : string.Join(", ", _sprints.Where(s => task.SprintIds.Contains(s.Id)).OrderBy(s => s.StartDate).Select(s => s.Name))) · @(task.Deadline?.ToString("d MMM") ?? "—")</FlareText>
                                            <AlvaAssignee Task="task" Actors="_actors" />
                                        </FlareStack>
                                    </ChildContent>
                                    <Trailing><AlvaStatusChip Tone="AlvaTones.Status(task.Status)">@Labels.Status(task.Status)</AlvaStatusChip></Trailing>
                                </FlareListItem>
                            }
                        </FlareList>
                    }
                    <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@(Strings.T("Связанные задачи распределяются по спринтам команд")) · @(Strings.T("Всего в проекте:")) @tasks.Length @AlvaFormat.Plural(tasks.Length, "task")</FlareText>
                </FlareCardContent>
            </FlareCard>
        </section>
    }
</div>
}
}
@code {
    private (string Key, string Label)[] Filters => [("all", Strings.T("Все проекты")), ("active", Strings.T("В работе")), ("new", Strings.T("Не начаты")), ("done", Strings.T("Завершены"))];
    private ProjectModel[] _projects = [];
    private TaskModel[] _tasks = [];
    private SprintModel[] _sprints = [];
    private ActorModel[] _actors = [];
    private RiskDto[] _risks = [];
    private readonly Dictionary<Guid, TaskModel[]> _teamTasks = [];
    private readonly HashSet<Guid> _closedTeams = [];
    private ProjectModel? _project;
    private string? _projectSnapshot; private IDisposable? _draft;
    [CascadingParameter] public FlareConfirmDialogProvider? Confirm { get; set; }
    internal bool IsDirty => _project is not null && DraftSnapshot.Of(_project) != _projectSnapshot;
    private Guid? _selected;
    private bool _saved;
    private string _filter = "all";

    private int FilterIndex
    {
        get => Array.FindIndex(Filters, f => f.Key == _filter);
        set
        {
            var filters = Filters;
            if (value >= 0 && value < filters.Length) _filter = filters[value].Key;
        }
    }
    private string? _error, _wbsSearch;
    private bool _busy;

    private IEnumerable<ProjectModel> Visible => _projects.Where(p => _filter == "all" || Status(p) == _filter)
        .OrderByDescending(p => ProjectTasks(p).Where(t => t.Status is not ("Done" or "Cancelled")).Sum(t => t.EstimateHours ?? 0));
    private ProjectModel? Selected => Visible.FirstOrDefault(p => p.Id == _selected) ?? Visible.FirstOrDefault();
    /// <summary>Задачи проекта в текущей команде: её спринты, бэклог и WBS.</summary>
    private TaskModel[] TasksOf(ProjectModel p) => _tasks.Where(t => t.ProjectId == p.Id && t.Status != "Cancelled").ToArray();
    /// <summary>Задачи проекта во всех его командах, доступных пользователю: из них считаются статус и общий прогресс,
    /// чтобы проект нескольких команд не выглядел по-разному из каждой.</summary>
    private TaskModel[] ProjectTasks(ProjectModel p) => p.TeamIds.Where(id => id != Session.TeamId)
        .SelectMany(id => _teamTasks.GetValueOrDefault(id) ?? []).Concat(_tasks)
        .Where(t => t.ProjectId == p.Id && t.Status != "Cancelled").ToArray();
    private (decimal Done, decimal Total) HoursOf(ProjectModel p) => Hours(ProjectTasks(p));
    private static (decimal Done, decimal Total) Hours(TaskModel[] tasks) =>
        (tasks.Where(t => t.Status == "Done").Sum(t => t.EstimateHours ?? 0), tasks.Sum(t => t.EstimateHours ?? 0));
    /// <summary>Самый поздний срок задач проекта. Это не релиз: отдельной сущности поставки в Alva пока нет.</summary>
    private DateOnly? LatestDeadline(ProjectModel p) => ProjectTasks(p).Where(t => t.Deadline.HasValue).Select(t => t.Deadline).Max();
    private SprintModel[] SprintsOf(ProjectModel p) => _sprints.Where(s => TasksOf(p).Any(t => t.SprintIds.Contains(s.Id))).OrderBy(s => s.StartDate).ToArray();
    private static int Pct(decimal part, decimal whole) => whole <= 0 ? 0 : (int)Math.Round(part / whole * 100);
    private string TeamName(Guid id) => Session.Teams.FirstOrDefault(t => t.Id == id)?.Name ?? (id == Session.TeamId ? Session.TeamName : Strings.T("Другая команда"));

    /// <summary>Статус проекта из задач: в работе / не начат / завершён.</summary>
    private string Status(ProjectModel p)
    {
        var tasks = ProjectTasks(p);
        if (tasks.Length > 0 && tasks.All(t => t.Status == "Done")) return "done";
        return tasks.Any(t => t.Status is "InProgress" or "Done" || t.SprintIds.Length > 0) ? "active" : "new";
    }
    private static string StatusLabel(string status) => status switch { "done" => Strings.T("Завершён"), "active" => Strings.T("В работе"), _ => Strings.T("Не начат") };
    private static AlvaTone StatusTone(string status) => status switch { "done" => AlvaTone.Ok, "active" => AlvaTone.Info, _ => AlvaTone.Neutral };

    /// <summary>Задачи проекта в порядке дерева: корень (родитель вне проекта) и его потомки с глубиной.</summary>
    private IEnumerable<(TaskModel Task, int Depth)> Tree(TaskModel[] tasks)
    {
        var ids = tasks.Select(t => t.Id).ToHashSet();
        IEnumerable<(TaskModel, int)> Walk(TaskModel node, int depth) =>
            new[] { (node, depth) }.Concat(tasks.Where(t => t.ParentId == node.Id).OrderBy(t => t.Order).SelectMany(c => Walk(c, depth + 1)));
        var all = tasks.Where(t => t.ParentId is null || !ids.Contains(t.ParentId.Value)).OrderBy(t => t.Order).SelectMany(r => Walk(r, 0));
        return string.IsNullOrWhiteSpace(_wbsSearch) ? all : all.Where(x => x.Item1.Title.Contains(_wbsSearch, StringComparison.OrdinalIgnoreCase));
    }

    /// <summary>Проект, выбранный по ссылке (например, после создания задачи из него).</summary>
    [SupplyParameterFromQuery(Name = "project")] public Guid? ProjectParam { get; set; }

    protected override async Task OnInitializedAsync() { _draft = Drafts.Track(() => IsDirty); _selected = ProjectParam; await Load(); }

    // Адрес — источник выбранного проекта: Back, Forward и обновление страницы возвращают тот же проект.
    protected override void OnParametersSet()
    {
        if (ProjectParam is { } id) _selected = id;
    }

    private void Select(Guid id)
    {
        if (_selected == id) return;
        Navigation.NavigateTo(Navigation.GetUriWithQueryParameter("project", id));
    }

    private void OpenSprint(Guid id) => Navigation.NavigateTo($"sprints/{id}");
    private void OpenTask(Guid id) => Navigation.NavigateTo($"tasks/{id}");

    private async Task Run(Func<Task> action)
    {
        _busy = true; _error = null;
        try { await action(); }
        catch (Exception e) when (e is HttpRequestException or InvalidOperationException or NotSupportedException) { _error = PageFeedback.Describe(e); }
        finally { _busy = false; }
    }

    private Task Load() => Run(async () =>
    {
        await Session.Initialize();
        if (Session.TeamId is null) return;
        _projects = await Session.Get<ProjectModel[]>(Session.TeamPath("projects"));
        _tasks = await Session.Get<TaskModel[]>(Session.TeamPath("tasks"));
        _sprints = await Session.Get<SprintModel[]>(Session.TeamPath("sprints"));
        _actors = await Session.Get<ActorModel[]>(Session.TeamPath("actors"));
        _risks = await Session.Get<RiskDto[]>(Session.TeamPath("risks"));
        _teamTasks.Clear();
        _closedTeams.Clear();
        foreach (var teamId in _projects.SelectMany(p => p.TeamIds).Distinct().Where(id => id != Session.TeamId))
        {
            if (Session.Teams.All(t => t.Id != teamId)) { _closedTeams.Add(teamId); continue; }
            // Команда без доступа или с ошибкой не роняет страницу: проект показывается без неё и с пометкой.
            try { _teamTasks[teamId] = await Session.Get<TaskModel[]>(Session.TeamPath(teamId, "tasks")); }
            catch (Exception e) when (e is HttpRequestException or InvalidOperationException) { _closedTeams.Add(teamId); }
        }
    });

    private void New() { _saved = false; _project = new ProjectModel { TeamIds = [Session.TeamId!.Value] }; _projectSnapshot = DraftSnapshot.Of(_project); }
    private void Edit(ProjectModel model) { _saved = false; _project = new ProjectModel { Id = model.Id, Name = model.Name, Description = model.Description, TeamIds = [.. model.TeamIds] }; _projectSnapshot = DraftSnapshot.Of(_project); }
    private async Task CloseProject()
    {
        if (!await DraftPrompt.CanDiscardAsync(Confirm, IsDirty)) return;
        _project = null; _projectSnapshot = null;
    }

    private async Task ConfirmLeave(LocationChangingContext context)
    {
        if (!IsDirty) return;
        if (!await DraftPrompt.CanDiscardAsync(Confirm, true)) { context.PreventNavigation(); return; }
        _project = null; _projectSnapshot = null;
    }

    public void Dispose() => _draft?.Dispose();
    private void ToggleTeam(Guid id, bool value) => _project!.TeamIds = value ? _project.TeamIds.Append(id).Distinct().ToArray() : _project.TeamIds.Where(x => x != id).ToArray();

    private Task SaveProject() => Run(async () =>
    {
        var p = _project!;
        await Session.Send(p.Id == Guid.Empty ? HttpMethod.Post : HttpMethod.Put, Session.TeamPath("projects" + (p.Id == Guid.Empty ? "" : $"/{p.Id}")), new ProjectRequest(p.Name, p.Description, p.TeamIds));
        _saved = true;
        _project = null; _projectSnapshot = null;
        _projects = await Session.Get<ProjectModel[]>(Session.TeamPath("projects"));
    });

    private async Task ArchiveProject()
    {
        if (!await DestructivePrompt.ConfirmAsync(Confirm, Strings.T("Архивировать проект"),
            string.Format(Strings.T("Проект «{0}» уйдёт из реестра. Вернуть его из приложения пока нельзя."), _project!.Name),
            Strings.T("Архивировать"))) return;
        await Run(async () =>
        {
            await Session.Send(HttpMethod.Delete, Session.TeamPath($"projects/{_project!.Id}"), new { });
            _project = null; _projectSnapshot = null;
            _projects = await Session.Get<ProjectModel[]>(Session.TeamPath("projects"));
        });
    }
}
