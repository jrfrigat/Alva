@page "/projects"
@inject AlvaSession Session
@* Реестр проектов по макету p13: карточки проектов слева, выбранный проект справа — KPI,
   команды и их спринты, дерево задач (WBS). Статус проекта выводится из его задач. *@
<PageTitle>Проекты · Alva</PageTitle>
<AlvaPageHeader Category="Корпоративный реестр · M:N архитектура" Title="Проекты" Description="Реестр проектов и вовлечённость команд. Проекты объединяют задачи, исполняемые спринтами разных команд.">
    <Actions><FlareButton Size="ButtonSize.Sm" OnClick="New" Disabled="@(Session.TeamId is null)"><LeadingIcon><FlareIconView Value="@MaterialDesign3Icons.Regular.AddCircle" Size="18px" /></LeadingIcon><ChildContent>Новый проект</ChildContent></FlareButton></Actions>
</AlvaPageHeader>
<PageFeedback Loading="_busy" Error="@_error" />
@if (Session.TeamId is null) { <TeamRequired /> }
else
{
<div class="alva-proj-filter">
    <div class="alva-quickfilter" role="group" aria-label="Статус проекта">
        @foreach (var (key, label) in Filters)
        {
            <button type="button" class="alva-quickfilter__item @(_filter == key ? "alva-quickfilter__item--active" : "")" aria-pressed="@(_filter == key)" @onclick="() => _filter = key">@label (@_projects.Count(p => key == "all" || Status(p) == key))</button>
        }
    </div>
    <span class="alva-proj-filter__hint"><FlareIconView Value="@MaterialDesign3Icons.Regular.Info" Size="16px" /> Проект не имеет собственных спринтов — исполнение через спринты команд</span>
</div>

@if (_project is not null)
{
<FlareCard Variant="CardVariant.Outlined"><FlareCardContent><FlareStack>
    <FlareText Element="h2" Typo="TypographyScale.TitleLarge">@(_project.Id == Guid.Empty ? "Новый проект" : "Рамка проекта")</FlareText>
    <FlareTextField Label="Название" @bind-Value="_project.Name" Required />
    <FlareTextArea Label="Описание" @bind-Value="_project.Description" AutoGrow />
    <FlareText Typo="TypographyScale.LabelLarge">Команды проекта</FlareText>
    @foreach (var team in Session.Teams) { <FlareCheckbox TValue="bool" Value="_project.TeamIds.Contains(team.Id)" ValueChanged="(bool value) => ToggleTeam(team.Id, value)">@team.Name</FlareCheckbox> }
    <FlareStack Row Wrap>
        <FlareButton Loading="_busy" OnClick="SaveProject" Disabled="@(string.IsNullOrWhiteSpace(_project.Name))">Сохранить</FlareButton>
        <FlareButton Variant="ButtonVariant.Text" OnClick="() => _project = null">Закрыть</FlareButton>
        @if (_project.Id != Guid.Empty) { <FlareButton Variant="ButtonVariant.Text" Color="FlareColor.Error" OnClick="ArchiveProject">Архивировать</FlareButton> }
    </FlareStack>
</FlareStack></FlareCardContent></FlareCard>
}

@if (_projects.Length == 0 && !_busy)
{
    <FlareEmptyState Title="Добавьте первый проект" Description="Объедините связанные задачи общим результатом." />
}
else
{
<div class="alva-proj-layout">
    <section class="alva-proj-registry" aria-label="Реестр проектов">
        <div class="alva-proj-registry__head"><span>Реестр проектов</span><span>Сортировка: нагрузка</span></div>
        @foreach (var project in Visible)
        {
            var (done, total) = HoursOf(project);
            var tasks = TasksOf(project);
            <button type="button" class="alva-proj-card @(project.Id == Selected?.Id ? "alva-proj-card--selected" : "")" aria-pressed="@(project.Id == Selected?.Id)" @onclick="() => _selected = project.Id" @key="project.Id">
                <span class="alva-proj-card__chips"><AlvaStatusChip Tone="StatusTone(Status(project))">@StatusLabel(Status(project))</AlvaStatusChip></span>
                <span class="alva-proj-card__name">@project.Name</span>
                @if (!string.IsNullOrWhiteSpace(project.Description)) { <span class="alva-proj-card__desc">@project.Description</span> }
                <span class="alva-proj-card__teams">
                    <span class="alva-proj-card__teams-head"><span>Команды (M:N):</span><b>@project.TeamIds.Length @AlvaFormat.Plural(project.TeamIds.Length, "команда", "команды", "команд")</b></span>
                    <span class="alva-proj-card__team-list">@string.Join(" · ", project.TeamIds.Select(TeamName))</span>
                </span>
                <span class="alva-loadbar__track"><span class="alva-loadbar__fill alva-loadbar__fill--info" style="width:@Pct(done, total)%"></span></span>
                <span class="alva-proj-card__foot alva-num"><span><b>@Pct(done, total)%</b> (@tasks.Count(t => t.Status == "Done") / @tasks.Length @AlvaFormat.Plural(tasks.Length, "задача", "задачи", "задач"))</span><span>Релиз: @(ReleaseOf(project)?.ToString("d MMM yyyy") ?? "—")</span></span>
            </button>
        }
        @if (!Visible.Any()) { <FlareEmptyState Compact Title="Проектов нет" Description="Смените фильтр статуса." /> }
        <div class="alva-proj-note"><FlareIconView Value="@MaterialDesign3Icons.Regular.Hub" Size="18px" /><span><b>M ↔ N модель данных.</b> Проект не привязан к одной команде: его задачи затягиваются разными командами в их спринты.</span></div>
    </section>

    @if (Selected is { } p)
    {
        var tasks = TasksOf(p);
        var (done, total) = HoursOf(p);
        var sprints = SprintsOf(p);
        var release = ReleaseOf(p);
        var risks = _risks.Count(r => tasks.Any(t => t.Id == r.TaskId));
        <section class="alva-proj-detail" aria-label="@p.Name">
            <div class="alva-panel">
                <div class="alva-proj-detail__head">
                    <div>
                        <AlvaStatusChip Tone="StatusTone(Status(p))">@StatusLabel(Status(p))</AlvaStatusChip>
                        <h2 class="alva-proj-detail__title">@p.Name</h2>
                        @if (!string.IsNullOrWhiteSpace(p.Description)) { <p class="alva-panel__subtitle">@p.Description</p> }
                    </div>
                    <div class="alva-proj-detail__actions">
                        <FlareButton Variant="ButtonVariant.Tonal" Size="ButtonSize.Sm" OnClick="() => Edit(p)"><LeadingIcon><FlareIconView Value="@MaterialDesign3Icons.Regular.Edit" Size="18px" /></LeadingIcon><ChildContent>Изменить рамку</ChildContent></FlareButton>
                        <FlareButton Href="/tasks" Size="ButtonSize.Sm"><LeadingIcon><FlareIconView Value="@MaterialDesign3Icons.Regular.AddTask" Size="18px" /></LeadingIcon><ChildContent>Создать задачу</ChildContent></FlareButton>
                    </div>
                </div>
                <div class="alva-proj-kpis">
                    <div class="alva-proj-kpi"><span class="alva-kpi__label">Общий прогресс</span><span class="alva-proj-kpi__value alva-num">@Pct(done, total)%</span><span class="alva-loadbar__track"><span class="alva-loadbar__fill alva-loadbar__fill--info" style="width:@Pct(done, total)%"></span></span><small class="alva-num">@tasks.Count(t => t.Status == "Done") из @tasks.Length задач закрыто</small></div>
                    <div class="alva-proj-kpi"><span class="alva-kpi__label">Трудозатраты</span><span class="alva-proj-kpi__value alva-num">@AlvaFormat.Hours(total) ч</span><small class="alva-num">Закрыто: @AlvaFormat.Hours(done) ч / Остаток: @AlvaFormat.Hours(total - done) ч</small></div>
                    <div class="alva-proj-kpi"><span class="alva-kpi__label">Активные спринты</span><span class="alva-proj-kpi__value alva-proj-kpi__value--primary alva-num">@sprints.Count(s => s.Status == "Active") @AlvaFormat.Plural(sprints.Count(s => s.Status == "Active"), "спринт", "спринта", "спринтов")</span><small class="alva-num">@tasks.Count(t => t.Status == "InProgress") @AlvaFormat.Plural(tasks.Count(t => t.Status == "InProgress"), "задача", "задачи", "задач") сейчас в работе</small></div>
                    <div class="alva-proj-kpi"><span class="alva-kpi__label">Дедлайн / релиз</span><span class="alva-proj-kpi__value alva-num">@(release?.ToString("d MMM") ?? "—")</span><small class="alva-num">@(release is { } r ? $"{r:yyyy} (осталось {Math.Max(0, r.DayNumber - DateOnly.FromDateTime(DateTime.Today).DayNumber)} дн.)" : "Дедлайны не заданы")</small>@if (risks > 0) { <small class="alva-kpi__alert">@risks @AlvaFormat.Plural(risks, "риск", "риска", "рисков") по задачам</small> }</div>
                </div>
            </div>

            <h3 class="alva-section-title"><FlareIconView Value="@MaterialDesign3Icons.Regular.Hub" Size="18px" /> Команды и их спринты по проекту</h3>
            <div class="alva-proj-teams">
                @foreach (var teamId in p.TeamIds)
                {
                    <div class="alva-panel alva-proj-team" @key="teamId">
                        <div class="alva-proj-team__head"><span class="alva-proj-team__dot" aria-hidden="true"></span><b>@TeamName(teamId)</b>@if (teamId == Session.TeamId) { <AlvaStatusChip Tone="AlvaTone.Info">Текущая команда</AlvaStatusChip> }</div>
                        @if (teamId == Session.TeamId)
                        {
                            @foreach (var sprint in sprints)
                            {
                                var inSprint = tasks.Where(t => t.SprintId == sprint.Id).ToArray();
                                <a class="alva-proj-sprint" href="@($"/sprints/{sprint.Id}")">
                                    <span class="alva-proj-sprint__head"><span><FlareIconView Value="@MaterialDesign3Icons.Regular.Flag" Size="15px" /> @sprint.Name</span><AlvaStatusChip Tone="AlvaTones.Status(sprint.Status)">@Labels.Status(sprint.Status)</AlvaStatusChip></span>
                                    <span class="alva-proj-sprint__row alva-num"><span>Взято задач проекта:</span><b>@inSprint.Length (@AlvaFormat.Hours(inSprint.Sum(t => t.EstimateHours ?? 0)) ч)</b></span>
                                </a>
                            }
                            <span class="alva-proj-sprint__row alva-num"><span>В бэклоге команды:</span><b>@tasks.Count(t => t.SprintId is null && t.Status is not ("Done" or "Cancelled")) задач (@AlvaFormat.Hours(tasks.Where(t => t.SprintId is null && t.Status is not ("Done" or "Cancelled")).Sum(t => t.EstimateHours ?? 0)) ч)</b></span>
                        }
                        else
                        {
                            <p class="alva-kpi__note">Задачи и спринты этой команды видны в её собственном пространстве.</p>
                        }
                    </div>
                }
            </div>

            <div class="alva-panel alva-wbs">
                <header class="alva-wbs__head">
                    <div><h3 class="alva-panel__title"><FlareIconView Value="@MaterialDesign3Icons.Regular.AccountTree" Size="20px" Class="alva-panel__icon" /> Дерево задач проекта (WBS)</h3><p class="alva-panel__subtitle">Иерархия задач с проекцией на спринты и исполнителей</p></div>
                    <FlareTextField @bind-Value="_wbsSearch" Immediate Clearable Placeholder="Поиск в дереве…" AriaLabel="Поиск в дереве задач"><AdornmentStart><FlareIconView Value="@MaterialDesign3Icons.Regular.Search" Size="18px" /></AdornmentStart></FlareTextField>
                </header>
                <div class="alva-wbs__table" role="table" aria-label="Задачи проекта">
                    <div class="alva-wbs__row alva-wbs__row--head" role="row"><span role="columnheader">Наименование / WBS</span><span role="columnheader">Текущий спринт</span><span role="columnheader">Исполнитель</span><span role="columnheader">Дедлайн</span><span role="columnheader">Статус</span></div>
                    @foreach (var (task, depth) in Tree(tasks))
                    {
                        <div class="alva-wbs__row @(depth == 0 ? "alva-wbs__row--root" : "")" role="row" @key="task.Id">
                            <span role="cell" class="alva-wbs__name" style="padding-left:@(depth * 20)px">
                                <FlareIconView Value="@(tasks.Any(t => t.ParentId == task.Id) ? MaterialDesign3Icons.Regular.Folder : MaterialDesign3Icons.Regular.SubdirectoryArrowRight)" Size="16px" />
                                <a href="@($"/tasks/{task.Id}")">@task.Title</a>
                            </span>
                            <span role="cell" class="alva-wbs__muted">@(_sprints.FirstOrDefault(s => s.Id == task.SprintId)?.Name ?? "Бэклог команды")</span>
                            <span role="cell"><AlvaAssignee Task="task" Actors="_actors" /></span>
                            <span role="cell" class="alva-num">@(task.Deadline?.ToString("d MMM") ?? "—")</span>
                            <span role="cell"><AlvaStatusChip Tone="AlvaTones.Status(task.Status)">@Labels.Status(task.Status)</AlvaStatusChip></span>
                        </div>
                    }
                    @if (!Tree(tasks).Any()) { <div class="alva-sprint-table__empty">Задач в проекте пока нет.</div> }
                </div>
                <footer class="alva-sprint-tasks__foot alva-num"><span>Связанные задачи распределяются по спринтам команд</span><span>Всего в проекте: <b>@tasks.Length</b> @AlvaFormat.Plural(tasks.Length, "задача", "задачи", "задач")</span></footer>
            </div>
        </section>
    }
</div>
}
}
@code {
    private static readonly (string Key, string Label)[] Filters = [("all", "Все проекты"), ("active", "В работе"), ("new", "Не начаты"), ("done", "Завершены")];
    private ProjectModel[] _projects = [];
    private TaskModel[] _tasks = [];
    private SprintModel[] _sprints = [];
    private ActorModel[] _actors = [];
    private RiskDto[] _risks = [];
    private ProjectModel? _project;
    private Guid? _selected;
    private string _filter = "all";
    private string? _error, _wbsSearch;
    private bool _busy;

    private IEnumerable<ProjectModel> Visible => _projects.Where(p => _filter == "all" || Status(p) == _filter)
        .OrderByDescending(p => TasksOf(p).Where(t => t.Status is not ("Done" or "Cancelled")).Sum(t => t.EstimateHours ?? 0));
    private ProjectModel? Selected => Visible.FirstOrDefault(p => p.Id == _selected) ?? Visible.FirstOrDefault();
    private TaskModel[] TasksOf(ProjectModel p) => _tasks.Where(t => t.ProjectId == p.Id && t.Status != "Cancelled").ToArray();
    private (decimal Done, decimal Total) HoursOf(ProjectModel p)
    {
        var tasks = TasksOf(p);
        return (tasks.Where(t => t.Status == "Done").Sum(t => t.EstimateHours ?? 0), tasks.Sum(t => t.EstimateHours ?? 0));
    }
    private DateOnly? ReleaseOf(ProjectModel p) => TasksOf(p).Where(t => t.Deadline.HasValue).Select(t => t.Deadline).Max();
    private SprintModel[] SprintsOf(ProjectModel p) => _sprints.Where(s => TasksOf(p).Any(t => t.SprintId == s.Id)).OrderBy(s => s.StartDate).ToArray();
    private static int Pct(decimal part, decimal whole) => whole <= 0 ? 0 : (int)Math.Round(part / whole * 100);
    private string TeamName(Guid id) => Session.Teams.FirstOrDefault(t => t.Id == id)?.Name ?? (id == Session.TeamId ? Session.TeamName : "Другая команда");

    /// <summary>Статус проекта из задач: в работе / не начат / завершён.</summary>
    private string Status(ProjectModel p)
    {
        var tasks = TasksOf(p);
        if (tasks.Length > 0 && tasks.All(t => t.Status == "Done")) return "done";
        return tasks.Any(t => t.Status is "InProgress" or "Done" || t.SprintId is not null) ? "active" : "new";
    }
    private static string StatusLabel(string status) => status switch { "done" => "Завершён", "active" => "В работе", _ => "Не начат" };
    private static AlvaTone StatusTone(string status) => status switch { "done" => AlvaTone.Ok, "active" => AlvaTone.Info, _ => AlvaTone.Neutral };

    /// <summary>Задачи проекта в порядке дерева: корень (родитель вне проекта) и его потомки с глубиной.</summary>
    private IEnumerable<(TaskModel Task, int Depth)> Tree(TaskModel[] tasks)
    {
        var ids = tasks.Select(t => t.Id).ToHashSet();
        IEnumerable<(TaskModel, int)> Walk(TaskModel node, int depth) =>
            new[] { (node, depth) }.Concat(tasks.Where(t => t.ParentId == node.Id).OrderBy(t => t.Order).SelectMany(c => Walk(c, depth + 1)));
        var all = tasks.Where(t => t.ParentId is null || !ids.Contains(t.ParentId.Value)).OrderBy(t => t.Order).SelectMany(r => Walk(r, 0));
        return string.IsNullOrWhiteSpace(_wbsSearch) ? all : all.Where(x => x.Item1.Title.Contains(_wbsSearch, StringComparison.OrdinalIgnoreCase));
    }

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Run(Func<Task> action)
    {
        _busy = true; _error = null;
        try { await action(); }
        catch (Exception e) when (e is HttpRequestException or InvalidOperationException or NotSupportedException) { _error = e.Message; }
        finally { _busy = false; }
    }

    private Task Load() => Run(async () =>
    {
        await Session.Initialize();
        if (Session.TeamId is null) return;
        _projects = await Session.Get<ProjectModel[]>(Session.TeamPath("projects"));
        _tasks = await Session.Get<TaskModel[]>(Session.TeamPath("tasks"));
        _sprints = await Session.Get<SprintModel[]>(Session.TeamPath("sprints"));
        _actors = await Session.Get<ActorModel[]>(Session.TeamPath("actors"));
        _risks = await Session.Get<RiskDto[]>(Session.TeamPath("risks"));
    });

    private void New() => _project = new ProjectModel { TeamIds = [Session.TeamId!.Value] };
    private void Edit(ProjectModel model) => _project = new ProjectModel { Id = model.Id, Name = model.Name, Description = model.Description, TeamIds = [.. model.TeamIds] };
    private void ToggleTeam(Guid id, bool value) => _project!.TeamIds = value ? _project.TeamIds.Append(id).Distinct().ToArray() : _project.TeamIds.Where(x => x != id).ToArray();

    private Task SaveProject() => Run(async () =>
    {
        var p = _project!;
        await Session.Send(p.Id == Guid.Empty ? HttpMethod.Post : HttpMethod.Put, Session.TeamPath("projects" + (p.Id == Guid.Empty ? "" : $"/{p.Id}")), new ProjectRequest(p.Name, p.Description, p.TeamIds));
        _project = null;
        _projects = await Session.Get<ProjectModel[]>(Session.TeamPath("projects"));
    });

    private Task ArchiveProject() => Run(async () =>
    {
        await Session.Send(HttpMethod.Delete, Session.TeamPath($"projects/{_project!.Id}"), new { });
        _project = null;
        _projects = await Session.Get<ProjectModel[]>(Session.TeamPath("projects"));
    });
}
