@page "/projects"
@implements IDisposable
@inject AlvaSession Session
@inject NavigationManager Navigation
@inject DraftGuard Drafts
@inject ISnackbarService Snackbar
@using Flare.Components.Gantt
<PageTitle>@(AlvaStrings.Projects_ProjectsAlva)</PageTitle>
<NavigationLock OnBeforeInternalNavigation="ConfirmLeave" ConfirmExternalNavigation="IsDirty" />
<AlvaPageHeader Category="@(AlvaStrings.Projects_ProjectsOfSeveralTeams)" Title="@(AlvaStrings.Common_Projects)" Description="@(AlvaStrings.Projects_ProjectRegistryAndTeamInvolvementProjectsUniteTasksDeliveredBySprintsOfD_6fd9fb)">
    <Actions><FlareButton Size="ButtonSize.Sm" OnClick="New" Disabled="@(Session.TeamId is null)"><LeadingIcon><FlareIconView Value="@MaterialDesign3Icons.Regular.AddCircle" Size="18px" /></LeadingIcon><ChildContent>@(AlvaStrings.Projects_NewProject)</ChildContent></FlareButton></Actions>
</AlvaPageHeader>
<PageFeedback Loading="_busy" Error="@_error" OnRetry="Load" />
<EditorStatus Dirty="IsDirty" Saving="_busy" Saved="_saved" />
@if (Session.TeamId is null) { <TeamRequired /> }
else
{
<FlareStack Gap="FlareSpacing.Small">
    <FlareTabs @bind-ActiveIndex="FilterIndex">
        <FlareTab Label="@($"{AlvaStrings.Projects_AllProjects} ({_projects.Length})")" />
        <FlareTab Label="@($"{AlvaStrings.Common_InProgress} ({_projects.Count(p => Status(p) == "active")})")" />
        <FlareTab Label="@($"{AlvaStrings.Projects_NotStartedTab} ({_projects.Count(p => Status(p) == "new")})")" />
        <FlareTab Label="@($"{AlvaStrings.Projects_Completed} ({_projects.Count(p => Status(p) == "done")})")" />
    </FlareTabs>
    <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant"><FlareIconView Value="@MaterialDesign3Icons.Regular.Info" Size="16px" /> @(AlvaStrings.Projects_AProjectHasNoSprintsOfItsOwnItIsDeliveredThroughTeamSprints)</FlareText>
</FlareStack>

@if (_project is not null)
{
<FlareCard Variant="CardVariant.Outlined"><FlareCardContent><FlareStack>
    <FlareText Element="h2" Typo="TypographyScale.TitleLarge">@(_project.Id == Guid.Empty ? AlvaStrings.Projects_NewProject : AlvaStrings.Projects_ProjectSettings)</FlareText>
    <FlareTextField Label="@(AlvaStrings.Common_Title)" @bind-Value="_project.Name" Required />
    <FlareTextArea Label="@(AlvaStrings.Common_Description)" @bind-Value="_project.Description" AutoGrow />
    <FlareText Typo="TypographyScale.LabelLarge">@(AlvaStrings.Projects_ProjectTeams)</FlareText>
    @foreach (var team in Session.Teams) { <FlareCheckbox TValue="bool" Value="_project.TeamIds.Contains(team.Id)" ValueChanged="(bool value) => ToggleTeam(team.Id, value)">@team.Name</FlareCheckbox> }
    <FlareStack Row Wrap>
        <FlareButton Loading="_busy" OnClick="SaveProject" Disabled="@(string.IsNullOrWhiteSpace(_project.Name) || !IsDirty)">@(AlvaStrings.Common_Save)</FlareButton>
        <FlareButton Variant="ButtonVariant.Text" OnClick="CloseProject">@(AlvaStrings.Common_Close)</FlareButton>
        @if (_project.Id != Guid.Empty) { <FlareButton Variant="ButtonVariant.Text" Color="FlareColor.Error" OnClick="ArchiveProject">@(AlvaStrings.Common_Archive)</FlareButton> }
    </FlareStack>
</FlareStack></FlareCardContent></FlareCard>
}

@if (_projects.Length == 0 && !_busy)
{
    <FlareEmptyState Title="@(AlvaStrings.Projects_AddTheFirstProject)" Description="@(AlvaStrings.Projects_TieRelatedTasksTogetherWithASharedOutcome)" />
}
else
{
<FlareGrid Columns="5" Gap="FlareSpacing.Medium" AlignItems="FlareAlignItems.Start">
    <FlareCol Xs="5" Sm="5" Md="2" Lg="2">
    <FlareCard Variant="CardVariant.Outlined">
        <FlareCardHeader Title="@(AlvaStrings.Projects_ProjectRegistry)" Subtitle="@(AlvaStrings.Projects_SortWorkload)" />
        <FlareCardContent>
            @if (!Visible.Any())
            {
                <FlareEmptyState Compact Title="@(AlvaStrings.Projects_NoProjects)" Description="@(AlvaStrings.Projects_ChangeTheStatusFilter)" />
            }
            else
            {
                <FlareList TItem="ProjectModel" Dense="true">
                    @foreach (var project in Visible)
                    {
                        var (done, total) = HoursOf(project);
                        var tasks = ProjectTasks(project);
                        <FlareListItem @key="project.Id" Selected="@(project.Id == Selected?.Id)" OnClick="() => Select(project.Id)">
                            <Leading><FlareAvatar Text="@AlvaFormat.Initials(project.Name)" Size="AvatarSize.Sm" Color="FlareColor.Primary" /></Leading>
                            <ChildContent>
                                <FlareStack Gap="FlareSpacing.XXSmall">
                                    <FlareStack Row Wrap Align="FlareAlignItems.Center" Gap="FlareSpacing.Small">
                                        <FlareText Typo="TypographyScale.LabelMedium">@project.Name</FlareText>
                                        <AlvaStatusChip Tone="StatusTone(Status(project))">@StatusLabel(Status(project))</AlvaStatusChip>
                                    </FlareStack>
                                    @if (!string.IsNullOrWhiteSpace(project.Description)) { <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@project.Description</FlareText> }
                                    <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@(AlvaStrings.Projects_Teams) @project.TeamIds.Length @AlvaFormat.Plural(project.TeamIds.Length, "team") · @string.Join(" · ", project.TeamIds.Select(TeamName))</FlareText>
                                    <FlareProgressLinear Value="@Pct(done, total)" Size="TrackSize.Xs" Color="FlareColor.Primary" aria-label="@(AlvaStrings.Projects_ProjectProgress)" />
                                    <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@Pct(done, total)% (@tasks.Count(t => t.Status == "Done") / @tasks.Length @AlvaFormat.Plural(tasks.Length, "task")) · @(AlvaStrings.Projects_LatestTaskDeadline) @(LatestDeadline(project)?.ToString("d MMM yyyy") ?? "—")</FlareText>
                                </FlareStack>
                            </ChildContent>
                            <Trailing>
                                <span @onclick:stopPropagation="true">
                                    <FlareLink Href="@($"projects?project={project.Id}")" target="_blank" rel="noopener noreferrer"
                                               title="@(AlvaStrings.Projects_OpenInANewTab)" aria-label="@(AlvaStrings.Projects_OpenInANewTab)">
                                        <FlareIconView Value="@MaterialDesign3Icons.Regular.ArrowForward" Size="18px" />
                                    </FlareLink>
                                </span>
                            </Trailing>
                        </FlareListItem>
                    }
                </FlareList>
            }
            <FlareStack Row Align="FlareAlignItems.Center" Gap="FlareSpacing.Small">
                <FlareIconView Value="@MaterialDesign3Icons.Regular.Hub" Size="18px" />
                <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant"><FlareText Element="strong" Typo="TypographyScale.LabelMedium">@(AlvaStrings.Projects_AProjectOfSeveralTeams)</FlareText> @(AlvaStrings.Projects_AProjectIsNotTiedToOneTeamDifferentTeamsPullItsTasksIntoTheirSprints)</FlareText>
            </FlareStack>
        </FlareCardContent>
    </FlareCard>
    </FlareCol>

    @if (Selected is { } p)
    {
        var tasks = TasksOf(p);
        var all = ProjectTasks(p);
        var (done, total) = HoursOf(p);
        var (teamDone, teamTotal) = Hours(tasks);
        var closed = p.TeamIds.Count(_closedTeams.Contains);
        var sprints = SprintsOf(p);
        var latest = LatestDeadline(p);
        var risks = _risks.Count(r => tasks.Any(t => t.Id == r.TaskId));
        <FlareCol Xs="5" Sm="5" Md="3" Lg="3">
            <FlareStack Gap="FlareSpacing.Large" aria-label="@p.Name">
            <FlareCard Variant="CardVariant.Outlined">
                <FlareCardHeader Title="@p.Name" Subtitle="@p.Description">
                    <AvatarContent><AlvaStatusChip Tone="StatusTone(Status(p))">@StatusLabel(Status(p))</AlvaStatusChip></AvatarContent>
                    <ActionContent>
                        <FlareButton Variant="ButtonVariant.Tonal" Size="ButtonSize.Sm" OnClick="() => Edit(p)"><LeadingIcon><FlareIconView Value="@MaterialDesign3Icons.Regular.Edit" Size="18px" /></LeadingIcon><ChildContent>@(AlvaStrings.Projects_ProjectSettings)</ChildContent></FlareButton>
                        <FlareButton OnClick="() => OpenCreate(null)" Size="ButtonSize.Sm"><LeadingIcon><FlareIconView Value="@MaterialDesign3Icons.Regular.AddTask" Size="18px" /></LeadingIcon><ChildContent>@(AlvaStrings.Projects_CreateATask)</ChildContent></FlareButton>
                    </ActionContent>
                </FlareCardHeader>
                <FlareCardContent>
                <FlareGrid MinColumnWidth="min(100%,10rem)">
                    <FlareStat Label="@(AlvaStrings.Projects_OverallProgress)" Value="@($"{Pct(done, total)}%")">
                        <CaptionContent>
                            <FlareStack Gap="FlareSpacing.XSmall">
                                <FlareProgressLinear Value="@Pct(done, total)" Size="TrackSize.Xs" Color="FlareColor.Primary" aria-label="@(AlvaStrings.Projects_OverallProgress)" />
                                <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@all.Count(t => t.Status == "Done") @(AlvaStrings.Sprint_OutOf) @all.Length @(AlvaStrings.Projects_TasksClosed)</FlareText>
                                @if (p.TeamIds.Length > 1) { <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@(AlvaStrings.Projects_TeamContribution) «@TeamName(Session.TeamId!.Value)»: @Pct(teamDone, teamTotal)% · @tasks.Length @AlvaFormat.Plural(tasks.Length, "task")</FlareText> }
                                @if (closed > 0) { <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@(AlvaStrings.Projects_ExcludingTeamsYouCannotAccess) @closed</FlareText> }
                            </FlareStack>
                        </CaptionContent>
                    </FlareStat>
                    <FlareStat Label="@(AlvaStrings.Projects_Effort)" Value="@($"{AlvaFormat.Hours(total)} {AlvaStrings.Sprint_HoursShort}")" Caption="@($"{AlvaStrings.Sprint_ClosedPrefix} {AlvaFormat.Hours(done)} {AlvaStrings.Sprint_HoursShort} / {AlvaStrings.Sprint_RemainingPrefix} {AlvaFormat.Hours(total - done)} {AlvaStrings.Sprint_HoursShort}")" />
                    <FlareStat Label="@(AlvaStrings.Projects_ActiveSprints)" Value="@($"{sprints.Count(s => s.Status == "Active")} {AlvaFormat.Plural(sprints.Count(s => s.Status == "Active"), "sprint")}")" Caption="@($"{all.Count(t => t.Status == "InProgress")} {AlvaFormat.Plural(all.Count(t => t.Status == "InProgress"), "task")} {AlvaStrings.Projects_InProgressNow}")" />
                    <FlareStat Label="@(AlvaStrings.Projects_LatestTaskDeadlineStat)" Value="@(latest?.ToString("d MMM") ?? "—")">
                        <CaptionContent>
                            <FlareStack Gap="FlareSpacing.XSmall">
                                <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@(latest is { } r ? string.Format(AlvaStrings.Projects_DLeft, r.Year, Math.Max(0, r.DayNumber - DateOnly.FromDateTime(DateTime.Today).DayNumber)) : AlvaStrings.Projects_NoDeadlinesSet)</FlareText>
                                @if (risks > 0) { <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.Error">@risks @AlvaFormat.Plural(risks, "risk") @(AlvaStrings.Projects_AcrossTasks)</FlareText> }
                            </FlareStack>
                        </CaptionContent>
                    </FlareStat>
                </FlareGrid>
                </FlareCardContent>
            </FlareCard>

            <FlareCard Variant="CardVariant.Outlined">
                <FlareCardHeader Title="@(AlvaStrings.Projects_ProjectGantt)" Subtitle="@(AlvaStrings.Projects_ProjectGanttDescription)">
                    <AvatarContent><FlareIconView Value="@MaterialDesign3Icons.Regular.ViewTimeline" Size="20px" /></AvatarContent>
                    <ActionContent>
                        <FlareStack Row Wrap Align="FlareAlignItems.Center" Gap="FlareSpacing.Small">
                            <FlareSelect TValue="GanttScale" Items="GanttData.Scales" ItemLabel="GanttData.ScaleName" @bind-Value="_ganttScale" @bind-Value:after="ResetGanttUnit" Size="FieldSize.Sm" InputAttributes="@(new Dictionary<string, object> { ["aria-label"] = AlvaStrings.Gantt_Scale })" />
                            <GanttZoom View="project" Scale="_ganttScale" @bind-Value="_ganttUnit" />
                            <FlareLink Href="gantt/tasks">@(AlvaStrings.Projects_OpenTheFullTaskGantt)</FlareLink>
                        </FlareStack>
                    </ActionContent>
                </FlareCardHeader>
                <FlareCardContent>
                    @{ var projectData = ProjectGantt(p); }
                    @if (tasks.Length == 0 || projectData is null)
                    {
                        <FlareEmptyState Compact Title="@(AlvaStrings.Projects_TheProjectHasNoTasksYet)" />
                    }
                    else
                    {
                        <FlareGantt Range="@Axis(p, projectData)" RangeChanged="r => _ganttRange = r" Endless="true" Scale="_ganttScale" UnitWidth="_ganttUnit"
                                    FillWidth="true" Virtualize="true" RowHeight="56" BarInset="10" SideWidth="22rem" DefaultSideWidth="22rem" ResizableSide="true"
                                    NonWorking="GanttData.IsWeekend" Markers="GanttData.TodayMarkers" AriaLabel="@(AlvaStrings.Projects_ProjectGantt)" Class="alva-gantt">
                            <Corner><FlareText Typo="TypographyScale.LabelSmall">@(AlvaStrings.Gantt_TaskAssigneeHours)</FlareText></Corner>
                            <ChildContent>
                                <GanttTaskPanel Data="projectData" Editable="false" OnItemClick="task => OpenTask(task.Id)">
                                    <RowActions Context="task">
                                        <FlareStack Row Gap="FlareSpacing.XXSmall">
                                            <FlareIconButton Icon="@MaterialDesign3Icons.Regular.Add" Size="ButtonSize.Sm" Tooltip="@AddSubtaskLabel(task)" AriaLabel="@AddSubtaskLabel(task)" OnClick="() => OpenCreate(task.Id)" />
                                            <FlareIconButton Icon="@MaterialDesign3Icons.Regular.Hub" Size="ButtonSize.Sm" Tooltip="@AddLinkLabel(task)" AriaLabel="@AddLinkLabel(task)" OnClick="() => OpenLink(task)" />
                                        </FlareStack>
                                    </RowActions>
                                </GanttTaskPanel>
                            </ChildContent>
                        </FlareGantt>
                    }
                </FlareCardContent>
            </FlareCard>

            <FlareStack Row Align="FlareAlignItems.Center" Gap="FlareSpacing.Small"><FlareIconView Value="@MaterialDesign3Icons.Regular.Hub" Size="18px" /><FlareText Element="h3" Typo="TypographyScale.LabelMedium">@(AlvaStrings.Projects_TeamsAndTheirSprintsPerProject)</FlareText></FlareStack>
            <FlareGrid MinColumnWidth="min(100%,16rem)" AutoFit="true" Gap="FlareSpacing.Small">
                @foreach (var teamId in p.TeamIds)
                {
                    <FlareCard Variant="CardVariant.Outlined" @key="teamId">
                        <FlareCardHeader Title="@TeamName(teamId)">
                            <AvatarContent><FlareAvatar Text="@AlvaFormat.Initials(TeamName(teamId))" Size="AvatarSize.Sm" Color="FlareColor.Primary" /></AvatarContent>
                            <ActionContent>@if (teamId == Session.TeamId) { <AlvaStatusChip Tone="AlvaTone.Info">@(AlvaStrings.Projects_CurrentTeam)</AlvaStatusChip> }</ActionContent>
                        </FlareCardHeader>
                        <FlareCardContent>
                            @if (teamId == Session.TeamId)
                            {
                                @if (sprints.Length > 0)
                                {
                                    <FlareList TItem="SprintModel" Dense="true">
                                        @foreach (var sprint in sprints)
                                        {
                                            var inSprint = tasks.Where(t => t.SprintIds.Contains(sprint.Id)).ToArray();
                                            <FlareListItem @key="sprint.Id" OnClick="() => OpenSprint(sprint.Id)">
                                                <Leading><FlareIconView Value="@MaterialDesign3Icons.Regular.Flag" Size="18px" /></Leading>
                                                <ChildContent>
                                                    <FlareStack Gap="FlareSpacing.None">
                                                        <FlareText Typo="TypographyScale.LabelMedium">@sprint.Name</FlareText>
                                                        <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@(AlvaStrings.Projects_ProjectTasksTaken) @inSprint.Length (@AlvaFormat.Hours(SprintHours.Sum(inSprint, sprint)) @(AlvaStrings.Sprint_HoursShort))</FlareText>
                                                    </FlareStack>
                                                </ChildContent>
                                                <Trailing><AlvaStatusChip Tone="AlvaTones.Status(sprint.Status)">@Labels.Status(sprint.Status)</AlvaStatusChip></Trailing>
                                            </FlareListItem>
                                        }
                                    </FlareList>
                                }
                                <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@(AlvaStrings.Projects_InTheTeamBacklog) @tasks.Count(t => !t.Planned && t.Status is not ("Done" or "Cancelled")) @AlvaFormat.Plural(tasks.Count(t => !t.Planned && t.Status is not ("Done" or "Cancelled")), "task") (@AlvaFormat.Hours(tasks.Where(t => !t.Planned && t.Status is not ("Done" or "Cancelled")).Sum(t => t.EstimateHours ?? 0)) @(AlvaStrings.Sprint_HoursShort))</FlareText>
                            }
                            else
                            {
                                <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@(AlvaStrings.Projects_ThisTeamSTasksAndSprintsAreVisibleInItsOwnWorkspace)</FlareText>
                            }
                        </FlareCardContent>
                    </FlareCard>
                }
            </FlareGrid>

            <FlareCard Variant="CardVariant.Outlined" aria-label="@(AlvaStrings.Projects_ProjectTaskTree)">
                <FlareCardHeader Title="@(AlvaStrings.Projects_ProjectTaskTree)" Subtitle="@(AlvaStrings.Projects_TaskHierarchyProjectedOntoSprintsAndAssignees)">
                    <AvatarContent><FlareIconView Value="@MaterialDesign3Icons.Regular.AccountTree" Size="20px" /></AvatarContent>
                    <ActionContent><FlareTextField @bind-Value="_wbsSearch" Immediate Clearable Placeholder="@(AlvaStrings.Projects_SearchTheTree)" AriaLabel="@(AlvaStrings.Projects_SearchTheTaskTree)"><AdornmentStart><FlareIconView Value="@MaterialDesign3Icons.Regular.Search" Size="18px" /></AdornmentStart></FlareTextField></ActionContent>
                </FlareCardHeader>
                <FlareCardContent>
                    @if (WbsRoots(tasks).Length == 0)
                    {
                        <FlareEmptyState Compact Title="@(AlvaStrings.Projects_TheProjectHasNoTasksYet)" />
                    }
                    else
                    {
                        <FlareDataGrid TItem="TaskModel" Items="WbsRoots(tasks)" RowKey="t => t.Id" Height="auto" Dense="true"
                                       Presentation="DataGridPresentation.Auto" Tree="WbsTree(tasks)">
                            <Columns>
                                <FlareColumn TItem="TaskModel" Title="@(AlvaStrings.Common_Task)">
                                    <Template Context="task">
                                        <FlareStack Gap="FlareSpacing.XXSmall">
                                            <FlareLink Href="@($"tasks/{task!.Id}")" title="@task.Title">@task.Title</FlareLink>
                                            <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@(task.SprintIds.Length == 0 ? AlvaStrings.Projects_TeamBacklog : string.Join(", ", _sprints.Where(s => task.SprintIds.Contains(s.Id)).OrderBy(s => s.StartDate).Select(s => s.Name))) · @(task.Deadline?.ToString("d MMM") ?? "—")</FlareText>
                                            <AlvaAssignee Task="task!" Actors="_actors" />
                                        </FlareStack>
                                    </Template>
                                </FlareColumn>
                                <FlareColumn TItem="TaskModel" Title="@(AlvaStrings.Common_Status)">
                                    <Template Context="task"><AlvaStatusChip Tone="AlvaTones.Status(task!.Status)">@Labels.Status(task.Status)</AlvaStatusChip></Template>
                                </FlareColumn>
                                <FlareColumn TItem="TaskModel" Title="@(AlvaStrings.Common_TaskActions)">
                                    <Template Context="task">
                                        <FlareStack Row Gap="FlareSpacing.XXSmall">
                                            <FlareIconButton Icon="@MaterialDesign3Icons.Regular.Add" Size="ButtonSize.Sm" Tooltip="@AddSubtaskLabel(task!)" AriaLabel="@AddSubtaskLabel(task!)" OnClick="() => OpenCreate(task!.Id)" />
                                            <FlareIconButton Icon="@MaterialDesign3Icons.Regular.Hub" Size="ButtonSize.Sm" Tooltip="@AddLinkLabel(task!)" AriaLabel="@AddLinkLabel(task!)" OnClick="() => OpenLink(task!)" />
                                        </FlareStack>
                                    </Template>
                                </FlareColumn>
                            </Columns>
                        </FlareDataGrid>
                    }
                    <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@(AlvaStrings.Projects_LinkedTasksAreDistributedAcrossTeamSprints) · @(AlvaStrings.Projects_TotalInTheProject) @tasks.Length @AlvaFormat.Plural(tasks.Length, "task")</FlareText>
                </FlareCardContent>
            </FlareCard>
            </FlareStack>
        </FlareCol>

        <FlareDrawer Anchor="DrawerAnchor.Right" Open="_createOpen" OpenChanged="OnCreateOpen" Width="34rem" ContentPadding="FlareSpacing.Large" AriaLabel="@CreateTitle">
            <FlareStack Gap="FlareSpacing.Medium">
                <FlareStack Row StretchFirst><FlareText Element="h2" Typo="TypographyScale.TitleLarge">@CreateTitle</FlareText><FlareButton Variant="ButtonVariant.Text" Size="ButtonSize.Sm" OnClick="CloseCreate">@(AlvaStrings.Common_Cancel)</FlareButton></FlareStack>
                <FlareTextField Label="@(AlvaStrings.Common_Title)" @bind-Value="_createTitle" Required MaxLength="500" Autofocus />
                @if (CreateContext is { Length: > 0 } context) { <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@context</FlareText> }
                @if (_createError is not null) { <FlareAlert Severity="AlertSeverity.Error">@_createError</FlareAlert> }
                <FlareStack Row Wrap Gap="FlareSpacing.Small">
                    <FlareButton Loading="_createBusy" Disabled="@(_createBusy || string.IsNullOrWhiteSpace(_createTitle))" OnClick="CreateTask">@(AlvaStrings.Tasks_Create)</FlareButton>
                    <FlareButton Variant="ButtonVariant.Text" OnClick="CloseCreate">@(AlvaStrings.Common_Cancel)</FlareButton>
                </FlareStack>
            </FlareStack>
        </FlareDrawer>

        <FlareDialog @bind-Visible="_linkOpen" Title="@(AlvaStrings.Task_AddLink)" Size="DialogSize.Sm">
            <ChildContent>
                <FlareStack Gap="FlareSpacing.Medium">
                    @if (_linkTask is { } first) { <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@TaskLabel(first.Id)</FlareText> }
                    @if (_linkError is not null) { <FlareAlert Severity="AlertSeverity.Error">@_linkError</FlareAlert> }
                    <FlareSelect TValue="Guid?" Label="@(AlvaStrings.Common_Task)" Items="LinkCandidates" ItemLabel="TaskLabel" NullOption="@(AlvaStrings.Common_ChooseATask)" @bind-Value="_linkOther" Searchable />
                    <FlareSelect TValue="bool" Label="@(AlvaStrings.Task_Link)" Items="Directions" ItemLabel="DirectionLabel" @bind-Value="_linkIncoming" />
                    <FlareSelect TValue="string" Label="@(AlvaStrings.Task_Type)" Items="DependencyKinds" ItemLabel="KindLabel" @bind-Value="_linkKind" />
                    <FlareNumericField TValue="int" Label="@(AlvaStrings.Task_LagDays)" @bind-Value="_linkLag" Min="-365" Max="365" />
                </FlareStack>
            </ChildContent>
            <ActionsContent>
                <FlareButton Variant="ButtonVariant.Text" OnClick="CloseLink">@(AlvaStrings.Common_Cancel)</FlareButton>
                <FlareButton Loading="_linkBusy" Disabled="@(_linkBusy || _linkOther is null)" OnClick="AddLink">@(AlvaStrings.Task_AddLink)</FlareButton>
            </ActionsContent>
        </FlareDialog>
    }
</FlareGrid>
}
}
@code {
    private (string Key, string Label)[] Filters => [("all", AlvaStrings.Projects_AllProjects), ("active", AlvaStrings.Common_InProgress), ("new", AlvaStrings.Projects_NotStartedTab), ("done", AlvaStrings.Projects_Completed)];
    private ProjectModel[] _projects = [];
    private TaskModel[] _tasks = [];
    private SprintModel[] _sprints = [];
    private ActorModel[] _actors = [];
    private RiskDto[] _risks = [];
    private DependencyDto[] _dependencies = [];
    private GanttData? _gantt;
    private Guid? _ganttFor;
    private GanttSpan _ganttRange;
    private Guid? _ganttRangeFor;
    private GanttScale _ganttScale = GanttScale.Day;
    private double _ganttUnit = GanttData.UnitWidth(GanttScale.Day);
    private readonly Dictionary<Guid, TaskModel[]> _teamTasks = [];
    private readonly HashSet<Guid> _closedTeams = [];
    private ProjectModel? _project;
    private string? _projectSnapshot; private IDisposable? _draft;
    [CascadingParameter] public FlareConfirmDialogProvider? Confirm { get; set; }
    internal bool IsDirty => _project is not null && DraftSnapshot.Of(_project) != _projectSnapshot;
    private Guid? _selected;
    private bool _saved;
    private string _filter = "all";

    private int FilterIndex
    {
        get => Array.FindIndex(Filters, f => f.Key == _filter);
        set
        {
            var filters = Filters;
            if (value >= 0 && value < filters.Length) _filter = filters[value].Key;
        }
    }
    private string? _error, _wbsSearch;
    private bool _busy;
    private bool _createOpen, _createBusy;
    private string? _createTitle, _createError;
    private Guid? _createParentId;
    private bool _linkOpen, _linkBusy;
    private TaskModel? _linkTask;
    private Guid? _linkOther;
    private bool _linkIncoming = true;
    private string _linkKind = "FS";
    private int _linkLag;
    private string? _linkError;
    private static readonly bool[] Directions = [true, false];
    private static readonly string[] DependencyKinds = ["FS", "SS", "FF", "SF"];

    private IEnumerable<ProjectModel> Visible => _projects.Where(p => _filter == "all" || Status(p) == _filter)
        .OrderByDescending(p => ProjectTasks(p).Where(t => t.Status is not ("Done" or "Cancelled")).Sum(t => t.EstimateHours ?? 0));
    private ProjectModel? Selected => Visible.FirstOrDefault(p => p.Id == _selected) ?? Visible.FirstOrDefault();
    /// <summary>Project tasks in the current team: its sprints, backlog and WBS.</summary>
    private TaskModel[] TasksOf(ProjectModel p) => _tasks.Where(t => t.ProjectId == p.Id && t.Status != "Cancelled").ToArray();
    /// <summary>Project tasks in all of its teams available to the user: status and overall progress are calculated
    /// from them, so a project spanning several teams does not look different from each team.</summary>
    private TaskModel[] ProjectTasks(ProjectModel p) => p.TeamIds.Where(id => id != Session.TeamId)
        .SelectMany(id => _teamTasks.GetValueOrDefault(id) ?? []).Concat(_tasks)
        .Where(t => t.ProjectId == p.Id && t.Status != "Cancelled").ToArray();
    private (decimal Done, decimal Total) HoursOf(ProjectModel p) => Hours(ProjectTasks(p));
    private static (decimal Done, decimal Total) Hours(TaskModel[] tasks) =>
        (tasks.Where(t => t.Status == "Done").Sum(t => t.EstimateHours ?? 0), tasks.Sum(t => t.EstimateHours ?? 0));
    /// <summary>The latest deadline of the project's tasks. This is not a release: Alva does not yet have a separate delivery entity.</summary>
    private DateOnly? LatestDeadline(ProjectModel p) => ProjectTasks(p).Where(t => t.Deadline.HasValue).Select(t => t.Deadline).Max();
    private SprintModel[] SprintsOf(ProjectModel p) => _sprints.Where(s => TasksOf(p).Any(t => t.SprintIds.Contains(s.Id))).OrderBy(s => s.StartDate).ToArray();
    private static DateOnly Today => DateOnly.FromDateTime(DateTime.Today);
    /// <summary>The project plan over the current team's data; rebuilt when the page reloads or another project is selected.</summary>
    private GanttData? ProjectGantt(ProjectModel p)
    {
        if (_ganttFor == p.Id && _gantt is not null) return _gantt;
        _gantt = GanttData.Create(_tasks, _sprints, _actors, _risks, _dependencies, p.Id);
        _ganttFor = p.Id;
        _ganttRangeFor = null;
        return _gantt;
    }
    private GanttSpan Axis(ProjectModel p, GanttData data)
    {
        if (_ganttRangeFor != p.Id) (_ganttRange, _ganttRangeFor) = (data.Range(null, Today), p.Id);
        return _ganttRange;
    }
    private void ResetGanttUnit() => _ganttUnit = GanttData.UnitWidth(_ganttScale);
    private static int Pct(decimal part, decimal whole) => whole <= 0 ? 0 : (int)Math.Round(part / whole * 100);
    private string TeamName(Guid id) => Session.Teams.FirstOrDefault(t => t.Id == id)?.Name ?? (id == Session.TeamId ? Session.TeamName : AlvaStrings.Projects_AnotherTeam);

    /// <summary>Project status derived from its tasks: in progress / not started / completed.</summary>
    private string Status(ProjectModel p)
    {
        var tasks = ProjectTasks(p);
        if (tasks.Length > 0 && tasks.All(t => t.Status == "Done")) return "done";
        return tasks.Any(t => t.Status is "InProgress" or "Done" || t.SprintIds.Length > 0) ? "active" : "new";
    }
    private static string StatusLabel(string status) => status switch { "done" => AlvaStrings.Common_Completed, "active" => AlvaStrings.Common_InProgress, _ => AlvaStrings.Projects_NotStarted };
    private static AlvaTone StatusTone(string status) => status switch { "done" => AlvaTone.Ok, "active" => AlvaTone.Info, _ => AlvaTone.Neutral };

    /// <summary>Project tasks in tree order: a root (whose parent is outside the project) and its descendants.</summary>
    private TaskModel[] WbsRoots(TaskModel[] tasks)
    {
        var ids = tasks.Select(t => t.Id).ToHashSet();
        return tasks.Where(t => t.ParentId is null || !ids.Contains(t.ParentId.Value))
            .Where(t => SubtreeMatches(tasks, t)).OrderBy(t => t.Order).ThenBy(t => t.Title).ToArray();
    }

    private IEnumerable<TaskModel>? WbsChildren(TaskModel[] tasks, TaskModel task) =>
        tasks.Where(t => t.ParentId == task.Id).OrderBy(t => t.Order).ThenBy(t => t.Title)
            .Where(t => SubtreeMatches(tasks, t)).ToArray();

    private bool SubtreeMatches(TaskModel[] tasks, TaskModel task) =>
        string.IsNullOrWhiteSpace(_wbsSearch) || task.Title.Contains(_wbsSearch, StringComparison.OrdinalIgnoreCase)
        || tasks.Any(t => t.ParentId == task.Id && SubtreeMatches(tasks, t));

    private DataGridTreeConfig<TaskModel> WbsTree(TaskModel[] tasks) => new()
    {
        ChildrenSelector = task => WbsChildren(tasks, task),
        InitiallyExpanded = _ => true,
        IndentWidth = "20px"
    };

    /// <summary>Project selected by link (for example, after creating a task from it).</summary>
    [SupplyParameterFromQuery(Name = "project")] public Guid? ProjectParam { get; set; }

    protected override async Task OnInitializedAsync() { _draft = Drafts.Track(() => IsDirty); _selected = ProjectParam; await Load(); }

    // The URL is the source of the selected project: Back, Forward and page refresh return the same project.
    protected override void OnParametersSet()
    {
        if (ProjectParam is { } id) _selected = id;
    }

    private void Select(Guid id)
    {
        if (_selected == id) return;
        Navigation.NavigateTo(Navigation.GetUriWithQueryParameter("project", id));
    }

    private void OpenSprint(Guid id) => Navigation.NavigateTo($"sprints/{id}");
    private void OpenTask(Guid id) => Navigation.NavigateTo($"tasks/{id}");

    private string CreateTitle => _createParentId is null ? AlvaStrings.Tasks_NewTask : AlvaStrings.Tasks_AddSubtask;
    private string? CreateContext => Selected is { } project
        ? _createParentId is { } parentId
            ? $"{AlvaStrings.Common_Project}: {project.Name} - {AlvaStrings.Common_ParentTask}: {TaskLabel(parentId)}"
            : $"{AlvaStrings.Common_Project}: {project.Name}"
        : null;
    private static string AddSubtaskLabel(TaskModel task) => $"{AlvaStrings.Tasks_AddSubtask}: {task.Title}";
    private static string AddLinkLabel(TaskModel task) => $"{AlvaStrings.Task_AddLink}: {task.Title}";
    private string TaskLabel(Guid? id) => _tasks.FirstOrDefault(t => t.Id == id) is { } task ? $"{AlvaFormat.Code(task.Id)} {task.Title}" : "";
    private static string DirectionLabel(bool incoming) => incoming ? AlvaStrings.Task_PredecessorThisTaskWaitsForIt : AlvaStrings.Task_SuccessorWaitsForThisTask;
    private static string KindLabel(string kind) => kind switch
    {
        "SS" => AlvaStrings.Task_StartStart,
        "FF" => AlvaStrings.Task_FinishFinish,
        "SF" => AlvaStrings.Task_StartFinish,
        _ => AlvaStrings.Task_FinishStart
    };
    private IEnumerable<Guid?> LinkCandidates => _linkTask is { } first && Selected is { } project
        ? TasksOf(project).Where(t => t.Id != first.Id).OrderBy(t => t.Order).ThenBy(t => t.Title).Select(t => (Guid?)t.Id)
        : [];

    private void OpenCreate(Guid? parentId)
    {
        if (Selected is null) return;
        _createParentId = parentId;
        _createTitle = "";
        _createError = null;
        _createOpen = true;
    }

    private void CloseCreate() { _createOpen = false; _createError = null; }
    private void OnCreateOpen(bool open) { if (!open) CloseCreate(); }

    private async Task CreateTask()
    {
        if (Selected is not { } project || string.IsNullOrWhiteSpace(_createTitle) || _createBusy) return;
        _createBusy = true;
        _createError = null;
        try
        {
            var order = _tasks.Where(t => t.ProjectId == project.Id && t.ParentId == _createParentId)
                .Select(t => t.Order).DefaultIfEmpty(-1).Max() + 1;
            await Session.Save<TaskModel>(HttpMethod.Post, Session.TeamPath("tasks"),
                new TaskRequest(_createTitle.Trim(), "", "Backlog", project.Id, _createParentId, Order: order));
            _createOpen = false;
            Snackbar.Show(AlvaStrings.Tasks_Created, SnackbarSeverity.Success);
            await Load();
        }
        catch (Exception e) when (e is HttpRequestException or InvalidOperationException)
        {
            _createError = PageFeedback.Describe(e);
        }
        finally { _createBusy = false; }
    }

    private void OpenLink(TaskModel task)
    {
        _linkTask = task;
        _linkOther = null;
        _linkIncoming = true;
        _linkKind = "FS";
        _linkLag = 0;
        _linkError = null;
        _linkOpen = true;
    }

    private void CloseLink() { _linkOpen = false; _linkError = null; }

    private async Task AddLink()
    {
        if (_linkTask is not { } first || _linkOther is not { } other || _linkBusy) return;
        var predecessor = _linkIncoming ? other : first.Id;
        var successor = _linkIncoming ? first.Id : other;
        if (predecessor == successor) { _linkError = AlvaStrings.Projects_ATaskCannotLinkToItself; return; }
        if (_dependencies.Any(d => d.PredecessorId == predecessor && d.SuccessorId == successor))
        {
            _linkError = AlvaStrings.Projects_LinkAlreadyExists;
            return;
        }
        if (WouldCycle(predecessor, successor))
        {
            _linkError = AlvaStrings.Projects_LinkWouldCreateACycle;
            return;
        }
        _linkBusy = true;
        _linkError = null;
        try
        {
            await Session.Save<DependencyDto>(HttpMethod.Post, Session.TeamPath($"tasks/{first.Id}/dependencies"),
                new DependencyRequest(predecessor, successor, _linkKind, _linkLag));
            _linkOpen = false;
            Snackbar.Show(AlvaStrings.Gantt_LinkAdded, SnackbarSeverity.Success);
            await Load();
        }
        catch (Exception e) when (e is HttpRequestException or InvalidOperationException)
        {
            _linkError = PageFeedback.Describe(e);
        }
        finally { _linkBusy = false; }
    }

    private bool WouldCycle(Guid predecessor, Guid successor)
    {
        var next = _dependencies.ToLookup(d => d.PredecessorId, d => d.SuccessorId);
        var seen = new HashSet<Guid>();
        var stack = new Stack<Guid>();
        stack.Push(successor);
        while (stack.Count > 0)
        {
            var current = stack.Pop();
            if (current == predecessor) return true;
            if (!seen.Add(current)) continue;
            foreach (var id in next[current]) stack.Push(id);
        }
        return false;
    }

    private async Task Run(Func<Task> action)
    {
        _busy = true; _error = null;
        try { await action(); }
        catch (Exception e) when (e is HttpRequestException or InvalidOperationException or NotSupportedException) { _error = PageFeedback.Describe(e); }
        finally { _busy = false; }
    }

    private Task Load() => Run(async () =>
    {
        await Session.Initialize();
        if (Session.TeamId is null) return;
        _projects = await Session.Get<ProjectModel[]>(Session.TeamPath("projects"));
        _tasks = await Session.Get<TaskModel[]>(Session.TeamPath("tasks"));
        _sprints = await Session.Get<SprintModel[]>(Session.TeamPath("sprints"));
        _actors = await Session.Get<ActorModel[]>(Session.TeamPath("actors"));
        _risks = (await Session.Get<RiskDto[]>(Session.TeamPath("risks"))).Where(r => r.HasRisk).ToArray();
        _dependencies = await Session.Get<DependencyDto[]>(Session.TeamPath("tasks/dependencies"));
        _gantt = null;
        _ganttFor = null;
        _teamTasks.Clear();
        _closedTeams.Clear();
        foreach (var teamId in _projects.SelectMany(p => p.TeamIds).Distinct().Where(id => id != Session.TeamId))
        {
            if (Session.Teams.All(t => t.Id != teamId)) { _closedTeams.Add(teamId); continue; }
            // A team without access or with an error does not break the page: the project is shown without it and with a marker.
            try { _teamTasks[teamId] = await Session.Get<TaskModel[]>(Session.TeamPath(teamId, "tasks")); }
            catch (Exception e) when (e is HttpRequestException or InvalidOperationException) { _closedTeams.Add(teamId); }
        }
    });

    private void New() { _saved = false; _project = new ProjectModel { TeamIds = [Session.TeamId!.Value] }; _projectSnapshot = DraftSnapshot.Of(_project); }
    private void Edit(ProjectModel model) { _saved = false; _project = new ProjectModel { Id = model.Id, Name = model.Name, Description = model.Description, TeamIds = [.. model.TeamIds] }; _projectSnapshot = DraftSnapshot.Of(_project); }
    private async Task CloseProject()
    {
        if (!await DraftPrompt.CanDiscardAsync(Confirm, IsDirty)) return;
        _project = null; _projectSnapshot = null;
    }

    private async Task ConfirmLeave(LocationChangingContext context)
    {
        if (!IsDirty) return;
        if (!await DraftPrompt.CanDiscardAsync(Confirm, true)) { context.PreventNavigation(); return; }
        _project = null; _projectSnapshot = null;
    }

    public void Dispose() => _draft?.Dispose();
    private void ToggleTeam(Guid id, bool value) => _project!.TeamIds = value ? _project.TeamIds.Append(id).Distinct().ToArray() : _project.TeamIds.Where(x => x != id).ToArray();

    private Task SaveProject() => Run(async () =>
    {
        var p = _project!;
        await Session.Send(p.Id == Guid.Empty ? HttpMethod.Post : HttpMethod.Put, Session.TeamPath("projects" + (p.Id == Guid.Empty ? "" : $"/{p.Id}")), new ProjectRequest(p.Name, p.Description, p.TeamIds));
        _saved = true;
        _project = null; _projectSnapshot = null;
        _projects = await Session.Get<ProjectModel[]>(Session.TeamPath("projects"));
    });

    private async Task ArchiveProject()
    {
        if (!await DestructivePrompt.ConfirmAsync(Confirm, AlvaStrings.Projects_ArchiveProject,
            string.Format(AlvaStrings.Projects_ProjectWillLeaveTheRegistryItCanTBeBroughtBackFromTheAppYet, _project!.Name),
            AlvaStrings.Common_Archive)) return;
        await Run(async () =>
        {
            await Session.Send(HttpMethod.Delete, Session.TeamPath($"projects/{_project!.Id}"), new { });
            _project = null; _projectSnapshot = null;
            _projects = await Session.Get<ProjectModel[]>(Session.TeamPath("projects"));
        });
    }
}
