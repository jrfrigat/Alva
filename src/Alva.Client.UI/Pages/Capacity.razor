@page "/capacity"
@page "/capacity/people"
@page "/capacity/{ActorId:guid}"
@page "/capacity/{ActorId:guid}/schedule"
@inject AlvaSession Session
@inject NavigationManager Navigation
@* Раздел «Ёмкость»: обзор (p14), командный календарь (p15), календарь сотрудника (p15.1) и
   редактор рабочего графика (p16). *@
<PageTitle>@Title · Alva</PageTitle>
@if (!_ready || _error is not null) { <PageFeedback Loading="!_ready" Error="@_error" /> }
else if (Session.TeamId is null) { <TeamRequired /> }
else if (ActorId is { } id && Schedule) { <ScheduleEditor ActorId="id" /> }
else if (ActorId is { } person) { <PersonCalendar ActorId="person" /> }
else if (People) { <TeamCalendar /> }
else { <CapacityOverview /> }
@code {
    [Parameter] public Guid? ActorId { get; set; }

    private string Path => AppRoutes.Current(Navigation);
    private bool Schedule => Path.EndsWith("/schedule", StringComparison.Ordinal);
    private bool People => Path.EndsWith("/people", StringComparison.Ordinal);
    private string Title => ActorId is null ? People ? Strings.T("Графики людей") : Strings.T("Ёмкость") : Schedule ? Strings.T("Редактор графика") : Strings.T("Календарь сотрудника");

    private bool _ready;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try { await Session.Initialize(); }
        catch (Exception e) when (e is HttpRequestException or InvalidOperationException) { _error = e.Message; }
        finally { _ready = true; }
    }
}
