@page "/"
@inject AlvaSession Session
<PageTitle>Обзор · Alva</PageTitle>
<AlvaPageHeader Category="Команда · Обзор" Title="@Session.TeamName" Description="Планы команды, ближайшие сроки и работа под риском.">
    <Actions><FlareButton Href="/tasks" Size="ButtonSize.Sm">К задачам</FlareButton></Actions>
</AlvaPageHeader>
<PageFeedback Error="@_error" Loading="_busy" />
@if(Session.TeamId is null){<TeamRequired />}
else
{
<FlareGrid MinColumnWidth="min(100%,14rem)">
    <div class="alva-metric"><span class="alva-metric__label">Задач в работе</span><span class="alva-metric__value">@_tasks.Count(t=>t.Status=="InProgress")</span></div>
    <div class="alva-metric"><span class="alva-metric__label">Активных спринтов</span><span class="alva-metric__value">@_sprints.Count(s=>s.Status=="Active")</span></div>
    <div class="alva-metric"><span class="alva-metric__label">Задач под риском</span><span class="alva-metric__value">@_risks.Length</span></div>
</FlareGrid>
<FlareGrid MinColumnWidth="min(100%,24rem)">
<FlareCard Variant="CardVariant.Outlined"><FlareCardContent><FlareStack Gap="FlareSpacing.Large">
    <FlareStack Row StretchFirst><FlareText Element="h2" Typo="TypographyScale.TitleLarge">Спринты</FlareText><FlareButton Href="/sprints" Variant="ButtonVariant.Text" Size="ButtonSize.Sm">Все спринты</FlareButton></FlareStack>
    @foreach(var sprint in _sprints.Where(s=>s.Status!="Completed").OrderBy(s=>s.StartDate).Take(5)) { var tasks=_tasks.Where(t=>t.SprintIds.Contains(sprint.Id)).ToArray(); <FlareStack Gap="FlareSpacing.Small"><FlareLink Href="@($"/sprints/{sprint.Id}")">@sprint.Name</FlareLink><FlareText Typo="TypographyScale.BodySmall">@sprint.StartDate.ToString("dd.MM") — @sprint.EndDate.ToString("dd.MM") · @tasks.Count(t=>t.Status=="Done") / @tasks.Length задач</FlareText><FlareProgressLinear Value="@(tasks.Length==0?0:100d*tasks.Count(t=>t.Status=="Done")/tasks.Length)" aria-label="Прогресс спринта" /></FlareStack> }
    @if(!_sprints.Any(s=>s.Status!="Completed")){<FlareEmptyState Compact Title="Спланируйте первый спринт" Description="Задайте цель и выберите задачи из пула." />}
</FlareStack></FlareCardContent></FlareCard>
<FlareCard Variant="CardVariant.Outlined"><FlareCardContent><FlareStack Gap="FlareSpacing.Large">
    <FlareText Element="h2" Typo="TypographyScale.TitleLarge">Ближайшие дедлайны</FlareText>
    @foreach(var task in _tasks.Where(t=>t.Deadline.HasValue && t.Status!="Done" && t.Status!="Cancelled").OrderBy(t=>t.Deadline).Take(6)){<FlareStack Row StretchFirst><FlareLink Href="@($"/tasks/{task.Id}")">@task.Title</FlareLink><FlareText Typo="TypographyScale.LabelMedium">@task.Deadline!.Value.ToString("dd.MM")</FlareText></FlareStack>}
    @if(!_tasks.Any(t=>t.Deadline.HasValue && t.Status!="Done" && t.Status!="Cancelled")){<FlareEmptyState Compact Title="Нет ближайших дедлайнов" Description="Сроки появятся после настройки задач." />}
</FlareStack></FlareCardContent></FlareCard>
</FlareGrid>
<FlareText Element="h2" Typo="TypographyScale.TitleLarge">На что обратить внимание</FlareText>
@foreach(var risk in _risks.Take(5)){<FlareAlert Severity="@(string.Equals(risk.Severity, "High", StringComparison.OrdinalIgnoreCase) ? AlertSeverity.Error : AlertSeverity.Warning)" Title="@risk.Title"><FlareStack Gap="FlareSpacing.Small"><FlareText>@string.Join(" · ",risk.Reasons)</FlareText><FlareLink Href="@($"/tasks/{risk.TaskId}")">Открыть задачу</FlareLink></FlareStack></FlareAlert>}
@if(_risks.Length==0){<FlareEmptyState Compact Title="Открытых рисков нет" Description="Alva проверяет загрузку, сроки и назначение задач." />}
}
@code {
    private TaskModel[] _tasks=[];private SprintModel[] _sprints=[];private RiskDto[] _risks=[];private bool _busy;private string? _error;
    protected override async Task OnInitializedAsync(){_busy=true;try{await Session.Initialize();if(Session.TeamId is null)return;_tasks=await Session.Get<TaskModel[]>(Session.TeamPath("tasks"));_sprints=await Session.Get<SprintModel[]>(Session.TeamPath("sprints"));_risks=await Session.Get<RiskDto[]>(Session.TeamPath("risks"));}catch(Exception e) when(e is HttpRequestException or InvalidOperationException){_error=e.Message;}finally{_busy=false;}}
}
