@page "/"
@inject AlvaSession Session
<PageTitle>@(AlvaStrings.Overview_OverviewAlva)</PageTitle>
<AlvaPageHeader Title="@Session.TeamName">
    <Actions><FlareButton Href="tasks" Size="ButtonSize.Sm">@(AlvaStrings.Common_ToTasks)</FlareButton></Actions>
</AlvaPageHeader>
<PageFeedback Error="@_error" Loading="_busy" OnRetry="Load" />
@if(Session.TeamId is null){<TeamRequired />}
else if(!_loaded)
{
    <LoadingSkeleton Height="20rem" />
}
else
{
    @if(FirstRun)
    {
        <FlareCard Variant="CardVariant.Outlined"><FlareCardContent><FlareStack Gap="FlareSpacing.Large">
            <FlareText Element="h2" Typo="TypographyScale.TitleLarge">@(AlvaStrings.Overview_FirstRun)</FlareText>
            <FlareText>@(AlvaStrings.Overview_SetUpTheTeamStepByStepHintsWillAppearHere)</FlareText>
            @foreach(var step in Steps)
            {
                <FlareStack Row StretchFirst Align="FlareAlignItems.Center" Gap="FlareSpacing.Small">
                    <FlareLink Href="@step.Href">@step.Label</FlareLink>
                    <AlvaStatusChip Tone="@(step.Done ? AlvaTone.Ok : AlvaTone.Warning)">@(step.Done ? AlvaStrings.Common_DoneStatus : AlvaStrings.Overview_NextStep)</AlvaStatusChip>
                </FlareStack>
            }
        </FlareStack></FlareCardContent></FlareCard>
    }
    else
    {
    <FlareGrid MinColumnWidth="min(100%,14rem)">
        <FlareStat Label="@(AlvaStrings.Overview_TasksInProgress)" Value="@_tasks.Count(t=>t.Status=="InProgress").ToString()" Icon="@MaterialDesign3Icons.Regular.Assignment" />
        <FlareStat Label="@(AlvaStrings.Overview_ActiveSprints)" Value="@_sprints.Count(s=>s.Status=="Active").ToString()" Icon="@MaterialDesign3Icons.Regular.Flag" />
        <FlareStat Label="@(AlvaStrings.Common_TasksAtRisk)" Value="@_risks.Length.ToString()" Icon="@MaterialDesign3Icons.Regular.Warning" />
    </FlareGrid>
    <FlareGrid MinColumnWidth="min(100%,24rem)">
    <FlareCard Variant="CardVariant.Outlined"><FlareCardContent><FlareStack Gap="FlareSpacing.Large">
        <FlareStack Row StretchFirst><FlareText Element="h2" Typo="TypographyScale.TitleLarge">@(AlvaStrings.Sprint_Sprints)</FlareText><FlareButton Href="sprints" Variant="ButtonVariant.Text" Size="ButtonSize.Sm">@(AlvaStrings.Common_AllSprints)</FlareButton></FlareStack>
        @foreach(var sprint in _sprints.Where(s=>s.Status!="Completed").OrderBy(s=>s.StartDate).Take(5)) { var tasks=_tasks.Where(t=>t.SprintIds.Contains(sprint.Id)).ToArray(); <FlareStack Gap="FlareSpacing.Small"><FlareLink Href="@($"sprints/{sprint.Id}")">@sprint.Name</FlareLink><FlareText Typo="TypographyScale.BodySmall">@sprint.StartDate.ToString("dd.MM") — @sprint.EndDate.ToString("dd.MM") · @tasks.Count(t=>t.Status=="Done") / @tasks.Length @AlvaFormat.Plural(tasks.Length, "task")</FlareText><FlareProgressLinear Value="@(tasks.Length==0?0:100d*tasks.Count(t=>t.Status=="Done")/tasks.Length)" aria-label="@(AlvaStrings.Overview_SprintProgress)" /></FlareStack> }
        @if(!_sprints.Any(s=>s.Status!="Completed")){<FlareEmptyState Compact Title="@(AlvaStrings.Overview_PlanTheFirstSprint)" Description="@(AlvaStrings.Overview_SetAGoalAndPickTasksFromThePool)" />}
    </FlareStack></FlareCardContent></FlareCard>
    <FlareCard Variant="CardVariant.Outlined"><FlareCardContent><FlareStack Gap="FlareSpacing.Large">
        <FlareText Element="h2" Typo="TypographyScale.TitleLarge">@(AlvaStrings.Overview_UpcomingDeadlines)</FlareText>
        @foreach(var task in _tasks.Where(t=>t.Deadline.HasValue && t.Status!="Done" && t.Status!="Cancelled").OrderBy(t=>t.Deadline).Take(6)){<FlareStack Row StretchFirst><FlareLink Href="@($"tasks/{task.Id}")">@task.Title</FlareLink><FlareText Typo="TypographyScale.LabelMedium">@task.Deadline!.Value.ToString("dd.MM")</FlareText></FlareStack>}
        @if(!_tasks.Any(t=>t.Deadline.HasValue && t.Status!="Done" && t.Status!="Cancelled")){<FlareEmptyState Compact Title="@(AlvaStrings.Overview_NoUpcomingDeadlines)" Description="@(AlvaStrings.Overview_DatesAppearOnceTheTasksAreSetUp)" />}
    </FlareStack></FlareCardContent></FlareCard>
    </FlareGrid>
    <FlareText Element="h2" Typo="TypographyScale.TitleLarge">@(AlvaStrings.Overview_WhatToWatch)</FlareText>
    @foreach(var risk in _risks.Take(5)){<FlareAlert Severity="@(string.Equals(risk.Severity, "High", StringComparison.OrdinalIgnoreCase) ? AlertSeverity.Error : AlertSeverity.Warning)" Title="@risk.Title"><FlareStack Gap="FlareSpacing.Small"><FlareText>@ReasonText.Join(risk.Reasons, " · ")</FlareText><FlareLink Href="@($"tasks/{risk.TaskId}")">@(AlvaStrings.Risks_OpenTask)</FlareLink></FlareStack></FlareAlert>}
    @if(_risks.Length==0){<FlareEmptyState Compact Title="@(AlvaStrings.Common_NoOpenRisks)" Description="@(AlvaStrings.Overview_AlvaChecksWorkloadDeadlinesAndTaskAssignment)" />}
    }
}
@code {
    private TaskModel[] _tasks=[];private SprintModel[] _sprints=[];private ProjectModel[] _projects=[];private ActorModel[] _actors=[];private RiskDto[] _risks=[];
    private bool _busy,_loaded;private string? _error;

    private bool FirstRun => _tasks.Length == 0 && _sprints.Length == 0 && _projects.Length == 0 && _actors.Length == 0;
    private (string Label, string Href, bool Done)[] Steps =>
    [
        (AlvaStrings.Overview_PeopleAndSchedules, "team", _actors.Length > 0),
        (AlvaStrings.Common_Project, "projects", _projects.Length > 0),
        (AlvaStrings.Common_Tasks, "tasks", _tasks.Length > 0),
        (AlvaStrings.Gantt_Sprint, "sprints", _sprints.Length > 0)
    ];

    protected override Task OnInitializedAsync() => Load();
    private async Task Load()
    {
        _busy = true; _error = null;
        try
        {
            await Session.Initialize();
            if (Session.TeamId is null) return;
            _tasks = await Session.Get<TaskModel[]>(Session.TeamPath("tasks"));
            _sprints = await Session.Get<SprintModel[]>(Session.TeamPath("sprints"));
            _projects = await Session.Get<ProjectModel[]>(Session.TeamPath("projects"));
            _actors = await Session.Get<ActorModel[]>(Session.TeamPath("actors"));
            _risks = (await Session.Get<RiskDto[]>(Session.TeamPath("risks"))).Where(r => r.HasRisk).ToArray();
        }
        catch (Exception e) when (e is HttpRequestException or InvalidOperationException) { _error = PageFeedback.Describe(e); }
        finally { _busy = false; _loaded = true; }
    }
}
