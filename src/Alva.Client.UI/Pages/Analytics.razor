@page "/analytics"
@inject AlvaSession Session
@inject NavigationManager Navigation
@* Риски и причины сдвига сроков: сводка, быстрые фильтры по видам причин и список задач под риском.
   Макета для страницы нет — разметка по DESIGN.md и образцам реестра спринтов и обзора ёмкости. *@
<PageTitle>@(Strings.T("Аналитика · Alva"))</PageTitle>
<AlvaPageHeader Category="@(Strings.T("Аналитика · Риски"))" Title="@(Strings.T("Риски и причины сдвига сроков"))" Description="@(Strings.T("Какие задачи могут не успеть и почему: перегрузка и отпуска исполнителей, работа без человека, просроченные сроки и незакрытые зависимости."))" />
<PageFeedback Loading="_busy" Error="@_error" OnRetry="Load" />
@if (Session.TeamId is null) { <TeamRequired /> }
else if (_busy)
{
    <LoadingSkeleton Height="18rem" />
}
else
{
<FlareGrid MinColumnWidth="min(100%,15rem)">
    <FlareStat Label="@(Strings.T("Задач под риском"))" Value="@_risks.Length.ToString()" Unit="@($"{Strings.T("из")} {OpenTasks} {Strings.T("открытых")}")" Icon="@MaterialDesign3Icons.Regular.Warning"
               Caption="@(_risks.Length == 0 ? (_tasks.Length == 0 ? Strings.T("Нет задач для оценки") : Strings.T("Все сроки держатся")) : string.Format(Strings.T("{0}% открытых задач"), Pct(_risks.Length, OpenTasks)))" />
    <FlareStat Label="@(Strings.T("Высокий уровень"))" Value="@High.ToString()" Unit="@AlvaFormat.Plural(High, "task")" Icon="@MaterialDesign3Icons.Regular.Error"
               Caption="@(Strings.T("Срок прошёл или прогноз позже срока больше чем на 3 дня"))" />
    <FlareStat Label="@(Strings.T("Ближайший срыв"))" Value="@(Nearest?.Risk.Title ?? Strings.T("Не ожидается"))" Icon="@MaterialDesign3Icons.Regular.EventBusy"
               Caption="@(Nearest is { } n ? string.Format(Strings.T("Срок {0:d MMM}, прогноз {1:d MMM} (+{2} дн.)"), n.Due, n.Risk.ForecastDate!.Value, Slip(n.Risk)) : _tasks.Length == 0 ? Strings.T("Нет задач для оценки") : Strings.T("Прогнозы укладываются в сроки"))" />
    <FlareStat Label="@(Strings.T("Без человека"))" Value="@Count(RiskKind.Unassigned).ToString()" Unit="@AlvaFormat.Plural(Count(RiskKind.Unassigned), "task")" Icon="@MaterialDesign3Icons.Regular.PersonSearch">
        <CaptionContent><FlareLink Href="unassigned">@(Strings.T("Без исполнителя"))</FlareLink></CaptionContent>
    </FlareStat>
</FlareGrid>

<FlareStack Row Wrap Align="FlareAlignItems.Center" Gap="FlareSpacing.Small">
    <FlareText Typo="TypographyScale.LabelMedium" Color="FlareColor.OnSurfaceVariant"><FlareIconView Value="@MaterialDesign3Icons.Regular.FilterList" Size="16px" /> @(Strings.T("Причины:"))</FlareText>
    <FlareChipGroup SelectedValues="SelectedKinds" SelectedValuesChanged="SetKind" AriaLabel="@(Strings.T("Причины"))">
        <FlareChip Variant="ChipVariant.Filled" Color="FlareColor.Primary" Value="" Label="@($"{Strings.T("Все")} ({_risks.Length})")" />
        @foreach (var kind in Kinds.Where(k => Count(k) > 0))
        {
            <FlareChip Variant="ChipVariant.Filled" Color="FlareColor.Primary" Value="@kind.ToString()" Label="@($"{Label(kind)} ({Count(kind)})")" />
        }
    </FlareChipGroup>
</FlareStack>

<div class="alva-filterbar">
    <FlareTabs @bind-ActiveIndex="_level" Class="alva-filterbar__tabs">
        <FlareTab Label="@(Strings.T("Все уровни"))" Badge="@_risks.Length.ToString()" BadgeColor="FlareColor.Secondary" />
        <FlareTab Label="@(Strings.T("Высокий"))" Badge="@High.ToString()" BadgeColor="FlareColor.Error" />
        <FlareTab Label="@(Strings.T("Средний"))" Badge="@((_risks.Length - High).ToString())" BadgeColor="FlareColor.Secondary" />
    </FlareTabs>
    <FlareSelect TValue="Guid?" Items="@(People.Select(p => (Guid?)p.Id))" ItemLabel="PersonName" NullOption="@(Strings.T("Все исполнители"))" @bind-Value="_person" Size="FieldSize.Sm" InputAttributes="@(new Dictionary<string, object> { ["aria-label"] = Strings.T("Исполнитель") })" Class="alva-filterbar__person" />
    <FlareTextField @bind-Value="_search" Immediate Clearable Placeholder="@(Strings.T("Поиск по задаче или причине"))" AriaLabel="@(Strings.T("Поиск риска"))" Class="alva-filterbar__search">
        <AdornmentStart><FlareIconView Value="@MaterialDesign3Icons.Regular.Search" Size="18px" /></AdornmentStart>
    </FlareTextField>
</div>

@if (_tasks.Length == 0)
{
    <FlareEmptyState Title="@(Strings.T("Нет задач для оценки"))" Description="@(Strings.T("Добавьте задачи — тогда появятся сроки, прогноз и риски."))"><ActionContent><FlareButton Href="tasks">@(Strings.T("К задачам"))</FlareButton></ActionContent></FlareEmptyState>
}
else if (_risks.Length == 0)
{
    <FlareEmptyState Title="@(Strings.T("Открытых рисков нет"))" Description="@(Strings.T("Проверены сроки, прогнозы по графикам исполнителей, отпуска, перегрузка, назначения и зависимости."))" />
}
else
{
<FlareCard Variant="CardVariant.Outlined" Class="alva-risk-panel">
    <FlareCardHeader Title="@(Strings.T("Задачи под риском"))" />
    <FlareCardContent>
        <FlareDataGrid TItem="RiskDto" Items="Visible" Height="auto" Dense="true" RowKey="r => r!.TaskId">
            <Columns>
                <FlareColumn TItem="RiskDto" Title="@(Strings.T("Задача"))">
                    <Template Context="risk">
                        <FlareStack Gap="FlareSpacing.None">
                            <FlareLink Href="@($"tasks/{risk!.TaskId}")">@risk.Title</FlareLink>
                            <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@AlvaFormat.Code(risk.TaskId)</FlareText>
                        </FlareStack>
                    </Template>
                </FlareColumn>
                <FlareColumn TItem="RiskDto" Title="@(Strings.T("Уровень"))">
                    <Template Context="risk"><AlvaStatusChip Tone="AlvaTones.Severity(risk!.Severity)">@(risk.Severity == "High" ? Strings.T("Высокий") : Strings.T("Средний"))</AlvaStatusChip></Template>
                </FlareColumn>
                <FlareColumn TItem="RiskDto" Title="@(Strings.T("Причины"))">
                    <Template Context="risk">
                        <FlareStack Row Wrap Gap="FlareSpacing.XSmall">
                            @foreach (var reason in risk!.Reasons)
                            {
                                var resolvedPersonId = TaskOf(risk.TaskId)?.ResolvedPersonId;
                                <FlareLink Href="@RiskActions.Href(reason, risk.TaskId, resolvedPersonId)" title="@RiskActions.Label(reason, resolvedPersonId)">@ReasonText.Describe(reason)</FlareLink>
                            }
                            @foreach (var note in (risk.ForecastNotes ?? []).Except(risk.Reasons))
                            {
                                <FlareLink Href="@($"tasks/{risk.TaskId}")" title="@(Strings.T("Открыть задачу"))">@ReasonText.Describe(note)</FlareLink>
                            }
                        </FlareStack>
                    </Template>
                </FlareColumn>
                <FlareColumn TItem="RiskDto" Title="@(Strings.T("Исполнитель"))">
                    <Template Context="risk">
                        @if (TaskOf(risk!.TaskId)?.ResolvedPersonId is { } personId && Actor(personId) is { } person)
                        {
                            <FlareStack Row Align="FlareAlignItems.Center" Gap="FlareSpacing.XSmall">
                                <FlareAvatar Text="@AlvaFormat.Initials(person.Name)" Size="AvatarSize.Xs" Color="FlareColor.Primary" />
                                <FlareLink Href="@($"capacity/{person.Id}")">@person.Name</FlareLink>
                            </FlareStack>
                        }
                        else
                        {
                            <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@(TaskOf(risk.TaskId)?.AssignmentTargetId is { } target ? Actor(target)?.Name ?? "—" : Strings.T("Не назначена"))</FlareText>
                        }
                    </Template>
                </FlareColumn>
                <FlareColumn TItem="RiskDto" Title="@(Strings.T("Срок / прогноз"))">
                    <Template Context="risk">
                        <FlareStack Gap="FlareSpacing.None">
                            <FlareText Typo="TypographyScale.BodySmall">@(DueOf(TaskOf(risk!.TaskId)) is { } due ? due.ToString("d MMM") : Strings.T("без срока"))</FlareText>
                            <FlareText Typo="TypographyScale.BodySmall" Color="@(Slip(risk) > 0 ? FlareColor.Error : FlareColor.OnSurfaceVariant)">@(risk.ForecastDate is { } forecast ? $"→ {forecast:d MMM}" : Strings.T("→ не рассчитан"))@(Slip(risk) > 0 ? string.Format(Strings.T(" (+{0} дн.)"), Slip(risk)) : "")</FlareText>
                        </FlareStack>
                    </Template>
                </FlareColumn>
            </Columns>
            <EmptyStateContent>
                <FlareStack Gap="FlareSpacing.Small">
                    <FlareText Typo="TypographyScale.BodyMedium">@(Strings.T("По этим условиям рисков нет. Смените фильтр или поиск."))</FlareText>
                    <FlareButton Variant="ButtonVariant.Text" Size="ButtonSize.Sm" OnClick="ResetFilters">@(Strings.T("Сбросить фильтр"))</FlareButton>
                </FlareStack>
            </EmptyStateContent>
        </FlareDataGrid>
        <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@(Strings.T("Прогноз учитывает очередь, календарь и зависимости; это не обещание."))</FlareText>
        <details class="alva-risk-panel__details">
            <summary>@(Strings.T("Подробнее о прогнозе"))</summary>
            <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@(Strings.T("Прогноз учитывает остаток работы, общую очередь исполнителя во всех проектах команды, календарь и зависимости. Порядок: приоритет, позиция в бэклоге, срок. Горизонт — 730 дней. Неизвестный остаток начатой задачи делает очередь неопределённой. Для остальных задач без остатка используется исходная оценка; для завершённых предшественников — плановые даты. Ограничения родителей наследуются всеми подзадачами, поэтому прогноз консервативный и не обещает оптимального расписания. Загрузка из других команд не учитывается. Плановые даты не меняются."))</FlareText>
        </details>
    </FlareCardContent>
</FlareCard>
}
}

@code {
    private enum RiskKind { Overdue, Forecast, Overload, Absence, Unassigned, Dependency, Other }
    private static readonly RiskKind[] Kinds = [RiskKind.Overdue, RiskKind.Forecast, RiskKind.Overload, RiskKind.Absence, RiskKind.Unassigned, RiskKind.Dependency, RiskKind.Other];

    private RiskDto[] _risks = [];
    private TaskModel[] _tasks = [];
    private ActorModel[] _actors = [];
    private bool _busy = true;
    private string? _error, _search;
    private int _level;
    private RiskKind? _kind;
    private Guid? _person;

    private int OpenTasks => _tasks.Count(t => t.Status is not ("Done" or "Cancelled"));
    private int High => _risks.Count(r => r.Severity == "High");
    private TaskModel? TaskOf(Guid id) => _tasks.FirstOrDefault(t => t.Id == id);
    private ActorModel? Actor(Guid id) => _actors.FirstOrDefault(a => a.Id == id);
    private string PersonName(Guid? id) => id is { } value ? Actor(value)?.Name ?? "—" : Strings.T("Все исполнители");
    private IEnumerable<ActorModel> People => _risks.Select(r => TaskOf(r.TaskId)?.ResolvedPersonId).OfType<Guid>().Distinct().Select(Actor).OfType<ActorModel>().OrderBy(a => a.Name);

    /// <summary>Вид причины по её коду: коды задаёт расчёт рисков (RiskMath).</summary>
    private static RiskKind KindOf(ReasonDto reason) => reason.Code switch
    {
        ReasonCodes.RiskOverdue => RiskKind.Overdue,
        ReasonCodes.RiskForecastLate => RiskKind.Forecast,
        ReasonCodes.RiskNoAssignee or ReasonCodes.RiskRequiredPerson => RiskKind.Unassigned,
        ReasonCodes.RiskDependencyOpen => RiskKind.Dependency,
        ReasonCodes.RiskOverload => RiskKind.Overload,
        ReasonCodes.RiskAbsence => RiskKind.Absence,
        _ => RiskKind.Other
    };

    private static string Label(RiskKind kind) => kind switch
    {
        RiskKind.Overdue => Strings.T("Срок прошёл"),
        RiskKind.Forecast => Strings.T("Не успевает к сроку"),
        RiskKind.Overload => Strings.T("Перегрузка"),
        RiskKind.Absence => Strings.T("Отпуск исполнителя"),
        RiskKind.Unassigned => Strings.T("Нет человека"),
        RiskKind.Dependency => Strings.T("Зависимости"),
        _ => Strings.T("Прочее")
    };

    private static string Tone(RiskKind kind) => kind switch
    {
        RiskKind.Overdue or RiskKind.Overload => "critical",
        RiskKind.Forecast or RiskKind.Dependency => "warning",
        RiskKind.Absence => "role",
        RiskKind.Unassigned => "info",
        _ => "neutral"
    };

    private int Count(RiskKind kind) => _risks.Count(r => r.Reasons.Any(x => KindOf(x) == kind));

    private IReadOnlyCollection<string> SelectedKinds => _kind is null ? [""] : [_kind.Value.ToString()];
    private void SetKind(IReadOnlyCollection<string> values) =>
        _kind = values.FirstOrDefault() is { } key && Enum.TryParse<RiskKind>(key, out var kind) ? kind : null;

    private IEnumerable<RiskDto> Visible => _risks
        .Where(r => _level == 0 || (_level == 1) == (r.Severity == "High"))
        .Where(r => _kind is null || r.Reasons.Any(x => KindOf(x) == _kind))
        .Where(r => _person is null || TaskOf(r.TaskId)?.ResolvedPersonId == _person)
        .Where(r => string.IsNullOrWhiteSpace(_search) || r.Title.Contains(_search, StringComparison.OrdinalIgnoreCase)
            || r.Reasons.Any(x => ReasonText.Describe(x).Contains(_search, StringComparison.OrdinalIgnoreCase)));

    /// <summary>На сколько дней прогноз позже срока задачи.</summary>
    private static DateOnly? DueOf(TaskModel? task) => task?.EffectiveDeadline ?? task?.Deadline;
    private int Slip(RiskDto risk) => DueOf(TaskOf(risk.TaskId)) is { } due && risk.ForecastDate is { } forecast ? Math.Max(0, forecast.DayNumber - due.DayNumber) : 0;

    private (RiskDto Risk, DateOnly Due)? Nearest => _risks
        .Where(r => Slip(r) > 0).Select(r => (Risk: r, Due: DueOf(TaskOf(r.TaskId))!.Value))
        .OrderBy(x => x.Due).Cast<(RiskDto, DateOnly)?>().FirstOrDefault();

    private static int Pct(int part, int whole) => whole <= 0 ? 0 : (int)Math.Round(part * 100.0 / whole);

    private void ResetFilters()
    {
        _kind = null;
        _level = 0;
        _person = null;
        _search = null;
    }

    protected override Task OnInitializedAsync() => Load();
    private async Task Load()
    {
        _busy = true; _error = null;
        try
        {
            await Session.Initialize();
            if (Session.TeamId is null) return;
            _risks = await Session.Get<RiskDto[]>(Session.TeamPath("risks"));
            _tasks = await Session.Get<TaskModel[]>(Session.TeamPath("tasks"));
            _actors = await Session.Get<ActorModel[]>(Session.TeamPath("actors"));
        }
        catch (Exception e) when (e is HttpRequestException or InvalidOperationException) { _error = PageFeedback.Describe(e); }
        finally { _busy = false; }
    }
}
