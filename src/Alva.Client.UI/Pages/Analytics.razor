@page "/analytics"
@inject AlvaSession Session
@* Риски и причины сдвига сроков: сводка, быстрые фильтры по видам причин и список задач под риском.
   Макета для страницы нет — разметка по DESIGN.md и образцам реестра спринтов и обзора ёмкости. *@
<PageTitle>@(Strings.T("Аналитика · Alva"))</PageTitle>
<section class="alva-page-header">
    <div class="alva-page-header__text">
        <div class="alva-micro-label"><span>@(Strings.T("Аналитика · Риски"))</span></div>
        <h1 class="alva-page-header__title">@(Strings.T("Риски и причины сдвига сроков"))</h1>
        <p class="alva-page-header__desc">@(Strings.T("Какие задачи могут не успеть и почему: перегрузка и отпуска исполнителей, работа без человека, просроченные сроки и незакрытые зависимости."))</p>
    </div>
</section>
<PageFeedback Loading="_busy" Error="@_error" />
@if (Session.TeamId is null) { <TeamRequired /> }
else if (!_busy)
{
<div class="alva-kpis">
    <section class="alva-kpi">
        <div class="alva-kpi__head"><div><span class="alva-kpi__label">@(Strings.T("Задач под риском"))</span><span class="alva-num"><span class="alva-kpi__value">@_risks.Length</span> <span class="alva-kpi__unit">@(Strings.T("из")) @OpenTasks @(Strings.T("открытых"))</span></span></div><span class="alva-kpi__icon"><FlareIconView Value="@MaterialDesign3Icons.Regular.Warning" Size="18px" /></span></div>
        <p class="alva-kpi__note">@(_risks.Length == 0 ? (_tasks.Length == 0 ? Strings.T("Нет задач для оценки") : Strings.T("Все сроки держатся")) : string.Format(Strings.T("{0}% открытых задач"), Pct(_risks.Length, OpenTasks)))</p>
    </section>
    <section class="alva-kpi @(High > 0 ? "alva-kpi--critical" : "")">
        <div class="alva-kpi__head"><div><span class="alva-kpi__label">@(Strings.T("Высокий уровень"))</span><span class="alva-num"><span class="alva-kpi__value">@High</span> <span class="alva-kpi__unit">@AlvaFormat.Plural(High, "task")</span></span></div><span class="alva-kpi__icon"><FlareIconView Value="@MaterialDesign3Icons.Regular.Error" Size="18px" /></span></div>
        <p class="alva-kpi__note">@(Strings.T("Срок прошёл или прогноз позже срока больше чем на 3 дня"))</p>
    </section>
    <section class="alva-kpi">
        <div class="alva-kpi__head"><div><span class="alva-kpi__label">@(Strings.T("Ближайший срыв"))</span><span class="alva-kpi__title">@(Nearest?.Risk.Title ?? Strings.T("Не ожидается"))</span></div><span class="alva-kpi__icon"><FlareIconView Value="@MaterialDesign3Icons.Regular.EventBusy" Size="18px" /></span></div>
        <p class="alva-kpi__note alva-num">@(Nearest is { } n ? string.Format(Strings.T("Срок {0:d MMM}, прогноз {1:d MMM} (+{2} дн.)"), n.Due, n.Risk.ForecastDate!.Value, Slip(n.Risk)) : _tasks.Length == 0 ? Strings.T("Нет задач для оценки") : Strings.T("Прогнозы укладываются в сроки"))</p>
    </section>
    <section class="alva-kpi">
        <div class="alva-kpi__head"><div><span class="alva-kpi__label">@(Strings.T("Без человека"))</span><span class="alva-num"><span class="alva-kpi__value">@Count(RiskKind.Unassigned)</span> <span class="alva-kpi__unit">@AlvaFormat.Plural(Count(RiskKind.Unassigned), "task")</span></span></div><span class="alva-kpi__icon"><FlareIconView Value="@MaterialDesign3Icons.Regular.PersonSearch" Size="18px" /></span></div>
        <p class="alva-kpi__note"><a href="unassigned">@(Strings.T("Пул неназначенных задач"))</a></p>
    </section>
</div>

<div class="alva-capacity-bar">
    <span class="alva-capacity-bar__label"><FlareIconView Value="@MaterialDesign3Icons.Regular.FilterList" Size="16px" /> @(Strings.T("Причины:"))</span>
    <div class="alva-quickfilter" role="group" aria-label="@(Strings.T("Фильтр по причине"))">
        <button type="button" class="alva-quickfilter__item @(_kind is null ? "alva-quickfilter__item--active" : "")" aria-pressed="@(_kind is null)" @onclick="() => _kind = null">@(Strings.T("Все")) (@_risks.Length)</button>
        @foreach (var kind in Kinds.Where(k => Count(k) > 0))
        {
            <button type="button" class="alva-quickfilter__item @(_kind == kind ? "alva-quickfilter__item--active" : "")" aria-pressed="@(_kind == kind)" @onclick="() => _kind = kind">@Label(kind) (@Count(kind))</button>
        }
    </div>
</div>

<div class="alva-filterbar">
    <FlareTabs @bind-ActiveIndex="_level" Class="alva-filterbar__tabs">
        <FlareTab Label="@(Strings.T("Все уровни"))" Badge="@_risks.Length.ToString()" BadgeColor="FlareColor.Secondary" />
        <FlareTab Label="@(Strings.T("Высокий"))" Badge="@High.ToString()" BadgeColor="FlareColor.Error" />
        <FlareTab Label="@(Strings.T("Средний"))" Badge="@((_risks.Length - High).ToString())" BadgeColor="FlareColor.Secondary" />
    </FlareTabs>
    <FlareSelect TValue="Guid?" Items="@(People.Select(p => (Guid?)p.Id))" ItemLabel="PersonName" NullOption="@(Strings.T("Все исполнители"))" @bind-Value="_person" Size="FieldSize.Sm" InputAttributes="@(new Dictionary<string, object> { ["aria-label"] = Strings.T("Исполнитель") })" Class="alva-filterbar__person" />
    <FlareTextField @bind-Value="_search" Immediate Clearable Placeholder="@(Strings.T("Поиск по задаче или причине"))" AriaLabel="@(Strings.T("Поиск риска"))" Class="alva-filterbar__search">
        <AdornmentStart><FlareIconView Value="@MaterialDesign3Icons.Regular.Search" Size="18px" /></AdornmentStart>
    </FlareTextField>
</div>

@if (_tasks.Length == 0)
{
    <FlareEmptyState Title="@(Strings.T("Нет задач для оценки"))" Description="@(Strings.T("Добавьте задачи — тогда появятся сроки, прогноз и риски."))" />
}
else if (_risks.Length == 0)
{
    <FlareEmptyState Title="@(Strings.T("Открытых рисков нет"))" Description="@(Strings.T("Проверены сроки, прогнозы по графикам исполнителей, отпуска, перегрузка, назначения и зависимости."))" />
}
else
{
<section class="alva-panel alva-risk-panel">
    <div class="alva-risk-table" role="table" aria-label="@(Strings.T("Задачи под риском"))">
        <div class="alva-risk-table__row alva-risk-table__row--head" role="row"><span role="columnheader">@(Strings.T("Задача"))</span><span role="columnheader">@(Strings.T("Уровень"))</span><span role="columnheader">@(Strings.T("Причины"))</span><span role="columnheader">@(Strings.T("Исполнитель"))</span><span role="columnheader">@(Strings.T("Срок / прогноз"))</span></div>
        @foreach (var risk in Visible)
        {
            var task = TaskOf(risk.TaskId);
            var slip = Slip(risk);
            <div class="alva-risk-table__row" role="row" @key="risk.TaskId">
                <span role="cell" class="alva-risk-table__task"><a href="@($"tasks/{risk.TaskId}")">@risk.Title</a><span class="alva-num">@AlvaFormat.Code(risk.TaskId)</span></span>
                <span role="cell"><AlvaStatusChip Tone="AlvaTones.Severity(risk.Severity)">@(risk.Severity == "High" ? Strings.T("Высокий") : Strings.T("Средний"))</AlvaStatusChip></span>
                <span role="cell" class="alva-risk-table__reasons">
                    @foreach (var reason in risk.Reasons)
                    {
                        var resolvedPersonId = task?.ResolvedPersonId;
                        <a class="alva-chip alva-chip--@Tone(KindOf(reason))" href="@RiskActions.Href(reason, risk.TaskId, resolvedPersonId)" title="@RiskActions.Label(reason, resolvedPersonId)">@ReasonText.Describe(reason)</a>
                    }
                    @foreach (var note in (risk.ForecastNotes ?? []).Except(risk.Reasons))
                    {
                        <a href="@($"tasks/{risk.TaskId}")" title="@(Strings.T("Открыть задачу"))">@ReasonText.Describe(note)</a>
                    }
                </span>
                <span role="cell" class="alva-risk-table__person">
                    @if (task?.ResolvedPersonId is { } personId && Actor(personId) is { } person)
                    {
                        <a href="@($"capacity/{person.Id}")" class="alva-person-link"><span class="alva-slot__mark" aria-hidden="true">@AlvaFormat.Initials(person.Name)</span><span>@person.Name</span></a>
                    }
                    else { <span class="alva-week__muted">@(task?.AssignmentTargetId is { } target ? Actor(target)?.Name ?? "—" : Strings.T("Не назначена"))</span> }
                </span>
                <span role="cell" class="alva-risk-table__dates alva-num">
                    <span>@(DueOf(task) is { } due ? due.ToString("d MMM") : Strings.T("без срока"))</span>
                    <span class="@(slip > 0 ? "alva-risk-table__slip" : "")">@(risk.ForecastDate is { } forecast ? $"→ {forecast:d MMM}" : Strings.T("→ не рассчитан"))@(slip > 0 ? string.Format(Strings.T(" (+{0} дн.)"), slip) : "")</span>
                </span>
            </div>
        }
        @if (!Visible.Any())
        {
            <div class="alva-sprint-table__empty">
                <span>@(Strings.T("По этим условиям рисков нет. Смените фильтр или поиск."))</span>
                <FlareButton Variant="ButtonVariant.Text" Size="ButtonSize.Sm" OnClick="ResetFilters">@(Strings.T("Сбросить фильтр"))</FlareButton>
            </div>
        }
    </div>
    <p class="alva-risk-panel__note alva-risk-panel__note--short">@(Strings.T("Прогноз учитывает очередь, календарь и зависимости; это не обещание."))</p>
    <details class="alva-risk-panel__details">
        <summary>@(Strings.T("Подробнее о прогнозе"))</summary>
        <p class="alva-risk-panel__note">@(Strings.T("Прогноз учитывает остаток работы, общую очередь исполнителя во всех проектах команды, календарь и зависимости. Порядок: приоритет, позиция в бэклоге, срок. Горизонт — 730 дней. Неизвестный остаток начатой задачи делает очередь неопределённой. Для остальных задач без остатка используется исходная оценка; для завершённых предшественников — плановые даты. Ограничения родителей наследуются всеми подзадачами, поэтому прогноз консервативный и не обещает оптимального расписания. Загрузка из других команд не учитывается. Плановые даты не меняются."))</p>
    </details>
</section>
}
}

@code {
    private enum RiskKind { Overdue, Forecast, Overload, Absence, Unassigned, Dependency, Other }
    private static readonly RiskKind[] Kinds = [RiskKind.Overdue, RiskKind.Forecast, RiskKind.Overload, RiskKind.Absence, RiskKind.Unassigned, RiskKind.Dependency, RiskKind.Other];

    private RiskDto[] _risks = [];
    private TaskModel[] _tasks = [];
    private ActorModel[] _actors = [];
    private bool _busy = true;
    private string? _error, _search;
    private int _level;
    private RiskKind? _kind;
    private Guid? _person;

    private int OpenTasks => _tasks.Count(t => t.Status is not ("Done" or "Cancelled"));
    private int High => _risks.Count(r => r.Severity == "High");
    private TaskModel? TaskOf(Guid id) => _tasks.FirstOrDefault(t => t.Id == id);
    private ActorModel? Actor(Guid id) => _actors.FirstOrDefault(a => a.Id == id);
    private string PersonName(Guid? id) => id is { } value ? Actor(value)?.Name ?? "—" : Strings.T("Все исполнители");
    private IEnumerable<ActorModel> People => _risks.Select(r => TaskOf(r.TaskId)?.ResolvedPersonId).OfType<Guid>().Distinct().Select(Actor).OfType<ActorModel>().OrderBy(a => a.Name);

    /// <summary>Вид причины по её коду: коды задаёт расчёт рисков (RiskMath).</summary>
    private static RiskKind KindOf(ReasonDto reason) => reason.Code switch
    {
        ReasonCodes.RiskOverdue => RiskKind.Overdue,
        ReasonCodes.RiskForecastLate => RiskKind.Forecast,
        ReasonCodes.RiskNoAssignee or ReasonCodes.RiskRequiredPerson => RiskKind.Unassigned,
        ReasonCodes.RiskDependencyOpen => RiskKind.Dependency,
        ReasonCodes.RiskOverload => RiskKind.Overload,
        ReasonCodes.RiskAbsence => RiskKind.Absence,
        _ => RiskKind.Other
    };

    private static string Label(RiskKind kind) => kind switch
    {
        RiskKind.Overdue => Strings.T("Срок прошёл"),
        RiskKind.Forecast => Strings.T("Не успевает к сроку"),
        RiskKind.Overload => Strings.T("Перегрузка"),
        RiskKind.Absence => Strings.T("Отпуск исполнителя"),
        RiskKind.Unassigned => Strings.T("Нет человека"),
        RiskKind.Dependency => Strings.T("Зависимости"),
        _ => Strings.T("Прочее")
    };

    private static string Tone(RiskKind kind) => kind switch
    {
        RiskKind.Overdue or RiskKind.Overload => "critical",
        RiskKind.Forecast or RiskKind.Dependency => "warning",
        RiskKind.Absence => "role",
        RiskKind.Unassigned => "info",
        _ => "neutral"
    };

    private int Count(RiskKind kind) => _risks.Count(r => r.Reasons.Any(x => KindOf(x) == kind));

    private IEnumerable<RiskDto> Visible => _risks
        .Where(r => _level == 0 || (_level == 1) == (r.Severity == "High"))
        .Where(r => _kind is null || r.Reasons.Any(x => KindOf(x) == _kind))
        .Where(r => _person is null || TaskOf(r.TaskId)?.ResolvedPersonId == _person)
        .Where(r => string.IsNullOrWhiteSpace(_search) || r.Title.Contains(_search, StringComparison.OrdinalIgnoreCase)
            || r.Reasons.Any(x => ReasonText.Describe(x).Contains(_search, StringComparison.OrdinalIgnoreCase)));

    /// <summary>На сколько дней прогноз позже срока задачи.</summary>
    private static DateOnly? DueOf(TaskModel? task) => task?.EffectiveDeadline ?? task?.Deadline;
    private int Slip(RiskDto risk) => DueOf(TaskOf(risk.TaskId)) is { } due && risk.ForecastDate is { } forecast ? Math.Max(0, forecast.DayNumber - due.DayNumber) : 0;

    private (RiskDto Risk, DateOnly Due)? Nearest => _risks
        .Where(r => Slip(r) > 0).Select(r => (Risk: r, Due: DueOf(TaskOf(r.TaskId))!.Value))
        .OrderBy(x => x.Due).Cast<(RiskDto, DateOnly)?>().FirstOrDefault();

    private static int Pct(int part, int whole) => whole <= 0 ? 0 : (int)Math.Round(part * 100.0 / whole);

    private void ResetFilters()
    {
        _kind = null;
        _level = 0;
        _person = null;
        _search = null;
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await Session.Initialize();
            if (Session.TeamId is null) return;
            _risks = await Session.Get<RiskDto[]>(Session.TeamPath("risks"));
            _tasks = await Session.Get<TaskModel[]>(Session.TeamPath("tasks"));
            _actors = await Session.Get<ActorModel[]>(Session.TeamPath("actors"));
        }
        catch (Exception e) when (e is HttpRequestException or InvalidOperationException) { _error = e.Message; }
        finally { _busy = false; }
    }
}
