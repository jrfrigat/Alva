@page "/analytics"
@inject AlvaSession Session
@inject NavigationManager Navigation
<PageTitle>@(AlvaStrings.Risks_AnalyticsAlva)</PageTitle>
<AlvaPageHeader Category="@(AlvaStrings.Risks_AnalyticsRisks)" Title="@(AlvaStrings.Risks_RisksAndReasonsForSlippingDeadlines)" />
<PageFeedback Loading="_busy" Error="@_error" OnRetry="Load" />
@if (Session.TeamId is null) { <TeamRequired /> }
else if (_busy)
{
    <LoadingSkeleton Height="18rem" />
}
else
{
<FlareGrid MinColumnWidth="min(100%,15rem)">
    <FlareStat Label="@(AlvaStrings.Common_TasksAtRisk)" Value="@_risks.Length.ToString()" Unit="@($"{AlvaStrings.Sprint_OutOf} {OpenTasks} {AlvaStrings.Risks_Open}")" Icon="@MaterialDesign3Icons.Regular.Warning"
               Caption="@(_risks.Length == 0 ? (_tasks.Length == 0 ? AlvaStrings.Risks_NoTasksToAssess : AlvaStrings.Risks_AllDeadlinesHold) : string.Format(AlvaStrings.Risks_OfOpenTasks, Pct(_risks.Length, OpenTasks)))" />
    <FlareStat Label="@(AlvaStrings.Risks_HighLevel)" Value="@High.ToString()" Unit="@AlvaFormat.Plural(High, "task")" Icon="@MaterialDesign3Icons.Regular.Error"
               Caption="@(AlvaStrings.Risks_PastDueOrTheForecastIsMoreThan3DaysLate)" />
    <FlareStat Label="@(AlvaStrings.Risks_NearestSlippage)" Value="@(Nearest?.Risk.Title ?? AlvaStrings.Risks_NotExpected)" Icon="@MaterialDesign3Icons.Regular.EventBusy"
               Caption="@(Nearest is { } n ? string.Format(AlvaStrings.Risks_DueForecastD, n.Due, n.Risk.ForecastDate!.Value, Slip(n.Risk)) : _tasks.Length == 0 ? AlvaStrings.Risks_NoTasksToAssess : AlvaStrings.Risks_ForecastsFitTheDeadlines)" />
    <FlareStat Label="@(AlvaStrings.Risks_NoAssignee)" Value="@Count(RiskKind.Unassigned).ToString()" Unit="@AlvaFormat.Plural(Count(RiskKind.Unassigned), "task")" Icon="@MaterialDesign3Icons.Regular.PersonSearch">
        <CaptionContent><FlareLink Href="unassigned">@(AlvaStrings.Common_Unassigned)</FlareLink></CaptionContent>
    </FlareStat>
</FlareGrid>

<FlareStack Row Wrap Align="FlareAlignItems.Center" Gap="FlareSpacing.Small">
    <FlareText Typo="TypographyScale.LabelMedium" Color="FlareColor.OnSurfaceVariant"><FlareIconView Value="@MaterialDesign3Icons.Regular.FilterList" Size="16px" /> @(AlvaStrings.Risks_ReasonsLabel)</FlareText>
    <FlareChipGroup SelectedValues="SelectedKinds" SelectedValuesChanged="SetKind" AriaLabel="@(AlvaStrings.Risks_Reasons)">
        <FlareChip Variant="ChipVariant.Filled" Color="FlareColor.Primary" Value="" Label="@($"{AlvaStrings.Sprint_All} ({_risks.Length})")" />
        @foreach (var kind in Kinds.Where(k => Count(k) > 0))
        {
            <FlareChip Variant="ChipVariant.Filled" Color="FlareColor.Primary" Value="@kind.ToString()" Label="@($"{Label(kind)} ({Count(kind)})")" />
        }
    </FlareChipGroup>
</FlareStack>

<FlareCard Variant="CardVariant.Outlined">
    <FlareCardContent>
    <FlareStack Row Wrap Align="FlareAlignItems.Center" Gap="FlareSpacing.Medium" StretchFirst="true">
    <FlareTabs @bind-ActiveIndex="_level">
        <FlareTab Label="@(AlvaStrings.Risks_AllLevels)" Badge="@_risks.Length.ToString()" BadgeColor="FlareColor.Secondary" />
        <FlareTab Label="@(AlvaStrings.Common_High)" Badge="@High.ToString()" BadgeColor="FlareColor.Error" />
        <FlareTab Label="@(AlvaStrings.Risks_Medium)" Badge="@((_risks.Length - High).ToString())" BadgeColor="FlareColor.Secondary" />
    </FlareTabs>
    <FlareSelect TValue="Guid?" Items="@(People.Select(p => (Guid?)p.Id))" ItemLabel="PersonName" NullOption="@(AlvaStrings.Risks_AllAssignees)" @bind-Value="_person" Size="FieldSize.Sm" InputAttributes="@(new Dictionary<string, object> { ["aria-label"] = AlvaStrings.Risks_Assignee })" />
    <FlareTextField @bind-Value="_search" Immediate Clearable Placeholder="@(AlvaStrings.Risks_SearchByTaskOrReason)" AriaLabel="@(AlvaStrings.Risks_SearchARisk)" Style="flex:0 1 20rem">
        <AdornmentStart><FlareIconView Value="@MaterialDesign3Icons.Regular.Search" Size="18px" /></AdornmentStart>
    </FlareTextField>
    </FlareStack>
    </FlareCardContent>
</FlareCard>

@if (_tasks.Length == 0)
{
    <FlareEmptyState Title="@(AlvaStrings.Risks_NoTasksToAssess)" Description="@(AlvaStrings.Risks_AddTasksToSeeDeadlinesTheForecastAndRisks)"><ActionContent><FlareButton Href="tasks">@(AlvaStrings.Common_ToTasks)</FlareButton></ActionContent></FlareEmptyState>
}
else if (_risks.Length == 0)
{
    <FlareEmptyState Title="@(AlvaStrings.Common_NoOpenRisks)" Description="@(AlvaStrings.Risks_DeadlinesForecastsFromAssigneeSchedulesVacationsOverloadAssignmentsAndDe_f1a29c)" />
}
else
{
<FlareCard Variant="CardVariant.Outlined">
    <FlareCardHeader Title="@(AlvaStrings.Risks_TasksAtRisk)" />
    <FlareCardContent>
        <FlareDataGrid TItem="RiskDto" Items="Visible" Height="auto" Dense="true" RowKey="r => r!.TaskId" Presentation="DataGridPresentation.Auto">
            <Columns>
                <FlareColumn TItem="RiskDto" Title="@(AlvaStrings.Common_Task)">
                    <Template Context="risk">
                        <FlareStack Gap="FlareSpacing.None">
                            <FlareLink Href="@($"tasks/{risk!.TaskId}")">@risk.Title</FlareLink>
                            <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@AlvaFormat.Code(risk.TaskId)</FlareText>
                        </FlareStack>
                    </Template>
                </FlareColumn>
                <FlareColumn TItem="RiskDto" Title="@(AlvaStrings.Risks_Level)">
                    <Template Context="risk"><AlvaStatusChip Tone="AlvaTones.Severity(risk!.Severity)">@(risk.Severity == "High" ? AlvaStrings.Common_High : AlvaStrings.Risks_Medium)</AlvaStatusChip></Template>
                </FlareColumn>
                <FlareColumn TItem="RiskDto" Title="@(AlvaStrings.Risks_Reasons)">
                    <Template Context="risk">
                        <FlareStack Row Wrap Gap="FlareSpacing.XSmall">
                            @foreach (var reason in risk!.Reasons)
                            {
                                var resolvedPersonId = TaskOf(risk.TaskId)?.ResolvedPersonId;
                                <FlareLink Href="@RiskActions.Href(reason, risk.TaskId, resolvedPersonId)" title="@RiskActions.Label(reason, resolvedPersonId)">@ReasonText.Describe(reason)</FlareLink>
                            }
                            @foreach (var note in (risk.ForecastNotes ?? []).Except(risk.Reasons))
                            {
                                <FlareLink Href="@($"tasks/{risk.TaskId}")" title="@(AlvaStrings.Risks_OpenTask)">@ReasonText.Describe(note)</FlareLink>
                            }
                        </FlareStack>
                    </Template>
                </FlareColumn>
                <FlareColumn TItem="RiskDto" Title="@(AlvaStrings.Risks_Assignee)">
                    <Template Context="risk">
                        @if (TaskOf(risk!.TaskId)?.ResolvedPersonId is { } personId && Actor(personId) is { } person)
                        {
                            <FlareStack Row Align="FlareAlignItems.Center" Gap="FlareSpacing.XSmall">
                                <FlareAvatar Text="@AlvaFormat.Initials(person.Name)" Size="AvatarSize.Xs" Color="FlareColor.Primary" />
                                <FlareLink Href="@($"capacity/{person.Id}")">@person.Name</FlareLink>
                            </FlareStack>
                        }
                        else
                        {
                            <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@(TaskOf(risk.TaskId)?.AssignmentTargetId is { } target ? Actor(target)?.Name ?? "—" : AlvaStrings.Common_UnassignedTask)</FlareText>
                        }
                    </Template>
                </FlareColumn>
                <FlareColumn TItem="RiskDto" Title="@(AlvaStrings.Risks_DueDateForecast)">
                    <Template Context="risk">
                        <FlareStack Gap="FlareSpacing.None">
                            <FlareText Typo="TypographyScale.BodySmall">@(DueOf(TaskOf(risk!.TaskId)) is { } due ? due.ToString("d MMM") : AlvaStrings.Risks_NoDueDate)</FlareText>
                            <FlareText Typo="TypographyScale.BodySmall" Color="@(Slip(risk) > 0 ? FlareColor.Error : FlareColor.OnSurfaceVariant)">@(risk.ForecastDate is { } forecast ? $"→ {forecast:d MMM}" : AlvaStrings.Risks_NotCalculated)@(Slip(risk) > 0 ? string.Format(AlvaStrings.Risks_SlipDaysSuffix, Slip(risk)) : "")</FlareText>
                        </FlareStack>
                    </Template>
                </FlareColumn>
            </Columns>
            <EmptyStateContent>
                <FlareStack Gap="FlareSpacing.Small">
                    <FlareText Typo="TypographyScale.BodyMedium">@(AlvaStrings.Risks_NoRisksMatchTheseConditionsChangeTheFilterOrSearch)</FlareText>
                    <FlareButton Variant="ButtonVariant.Text" Size="ButtonSize.Sm" OnClick="ResetFilters">@(AlvaStrings.Risks_ResetTheFilter)</FlareButton>
                </FlareStack>
            </EmptyStateContent>
        </FlareDataGrid>
        <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@(AlvaStrings.Risks_TheForecastUsesTheQueueCalendarsAndDependenciesItIsNotAPromise)</FlareText>
        <FlareAccordion>
            <FlareAccordionPanel Header="@(AlvaStrings.Risks_MoreAboutTheForecast)">
                <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@(AlvaStrings.Risks_TheForecastUsesRemainingWorkASharedQueueAcrossAllProjectsInThisTeamCalen_2be3c7)</FlareText>
            </FlareAccordionPanel>
        </FlareAccordion>
    </FlareCardContent>
</FlareCard>
}
}

@code {
    private enum RiskKind { Overdue, Forecast, Overload, Absence, Unassigned, Dependency, Other }
    private static readonly RiskKind[] Kinds = [RiskKind.Overdue, RiskKind.Forecast, RiskKind.Overload, RiskKind.Absence, RiskKind.Unassigned, RiskKind.Dependency, RiskKind.Other];

    private RiskDto[] _risks = [];
    private TaskModel[] _tasks = [];
    private ActorModel[] _actors = [];
    private bool _busy = true;
    private string? _error, _search;
    private int _level;
    private RiskKind? _kind;
    private Guid? _person;

    private int OpenTasks => _tasks.Count(t => t.Status is not ("Done" or "Cancelled"));
    private int High => _risks.Count(r => r.Severity == "High");
    private TaskModel? TaskOf(Guid id) => _tasks.FirstOrDefault(t => t.Id == id);
    private ActorModel? Actor(Guid id) => _actors.FirstOrDefault(a => a.Id == id);
    private string PersonName(Guid? id) => id is { } value ? Actor(value)?.Name ?? "—" : AlvaStrings.Risks_AllAssignees;
    private IEnumerable<ActorModel> People => _risks.Select(r => TaskOf(r.TaskId)?.ResolvedPersonId).OfType<Guid>().Distinct().Select(Actor).OfType<ActorModel>().OrderBy(a => a.Name);

    /// <summary>Reason kind by its code: the codes are defined by the risk calculation (RiskMath).</summary>
    private static RiskKind KindOf(ReasonDto reason) => reason.Code switch
    {
        ReasonCodes.RiskOverdue => RiskKind.Overdue,
        ReasonCodes.RiskForecastLate => RiskKind.Forecast,
        ReasonCodes.RiskNoAssignee or ReasonCodes.RiskRequiredPerson => RiskKind.Unassigned,
        ReasonCodes.RiskDependencyOpen => RiskKind.Dependency,
        ReasonCodes.RiskOverload => RiskKind.Overload,
        ReasonCodes.RiskAbsence => RiskKind.Absence,
        _ => RiskKind.Other
    };

    private static string Label(RiskKind kind) => kind switch
    {
        RiskKind.Overdue => AlvaStrings.Risks_PastDue,
        RiskKind.Forecast => AlvaStrings.Risks_WillMissTheDueDate,
        RiskKind.Overload => AlvaStrings.Common_OverloadLabel,
        RiskKind.Absence => AlvaStrings.Risks_AssigneeVacation,
        RiskKind.Unassigned => AlvaStrings.Risks_NoPerson,
        RiskKind.Dependency => AlvaStrings.Common_Dependencies,
        _ => AlvaStrings.Risks_Other
    };

    private static string Tone(RiskKind kind) => kind switch
    {
        RiskKind.Overdue or RiskKind.Overload => "critical",
        RiskKind.Forecast or RiskKind.Dependency => "warning",
        RiskKind.Absence => "role",
        RiskKind.Unassigned => "info",
        _ => "neutral"
    };

    private int Count(RiskKind kind) => _risks.Count(r => r.Reasons.Any(x => KindOf(x) == kind));

    private IReadOnlyCollection<string> SelectedKinds => _kind is null ? [""] : [_kind.Value.ToString()];
    private void SetKind(IReadOnlyCollection<string> values) =>
        _kind = values.FirstOrDefault() is { } key && Enum.TryParse<RiskKind>(key, out var kind) ? kind : null;

    private IEnumerable<RiskDto> Visible => _risks
        .Where(r => _level == 0 || (_level == 1) == (r.Severity == "High"))
        .Where(r => _kind is null || r.Reasons.Any(x => KindOf(x) == _kind))
        .Where(r => _person is null || TaskOf(r.TaskId)?.ResolvedPersonId == _person)
        .Where(r => string.IsNullOrWhiteSpace(_search) || r.Title.Contains(_search, StringComparison.OrdinalIgnoreCase)
            || r.Reasons.Any(x => ReasonText.Describe(x).Contains(_search, StringComparison.OrdinalIgnoreCase)));

    /// <summary>How many days the forecast is later than the task deadline.</summary>
    private static DateOnly? DueOf(TaskModel? task) => task?.EffectiveDeadline ?? task?.Deadline;
    private int Slip(RiskDto risk) => DueOf(TaskOf(risk.TaskId)) is { } due && risk.ForecastDate is { } forecast ? Math.Max(0, forecast.DayNumber - due.DayNumber) : 0;

    private (RiskDto Risk, DateOnly Due)? Nearest => _risks
        .Where(r => Slip(r) > 0).Select(r => (Risk: r, Due: DueOf(TaskOf(r.TaskId))!.Value))
        .OrderBy(x => x.Due).Cast<(RiskDto, DateOnly)?>().FirstOrDefault();

    private static int Pct(int part, int whole) => whole <= 0 ? 0 : (int)Math.Round(part * 100.0 / whole);

    private void ResetFilters()
    {
        _kind = null;
        _level = 0;
        _person = null;
        _search = null;
    }

    protected override Task OnInitializedAsync() => Load();
    private async Task Load()
    {
        _busy = true; _error = null;
        try
        {
            await Session.Initialize();
            if (Session.TeamId is null) return;
            _risks = (await Session.Get<RiskDto[]>(Session.TeamPath("risks"))).Where(r => r.HasRisk).ToArray();
            _tasks = await Session.Get<TaskModel[]>(Session.TeamPath("tasks"));
            _actors = await Session.Get<ActorModel[]>(Session.TeamPath("actors"));
        }
        catch (Exception e) when (e is HttpRequestException or InvalidOperationException) { _error = PageFeedback.Describe(e); }
        finally { _busy = false; }
    }
}
