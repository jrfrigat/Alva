@page "/gantt/people"
@page "/gantt/2d"
@inject AlvaSession Session
@inject GanttPreferences Preferences
@inject NavigationManager Navigation
@using Flare.Components.Gantt
@* Гантт по людям (макет p6_2d, проекция 2): дорожки людей и ролей с часами ёмкости и задачами исполнителя.
   В 2D-режиме над ними — проекция 1 на той же оси. Проекции собирает Alva из примитивов Flare.Components.Gantt. *@
<PageTitle>@(_twoD ? "Синхронный Гантт 2D" : "Гантт по людям") · Alva</PageTitle>
<section class="alva-page-header">
    <div class="alva-page-header__text">
        <div class="alva-micro-label"><span>Диаграммы · Гантт</span></div>
        <h1 class="alva-page-header__title">@(_twoD ? "Синхронный Гантт 2D" : "Гантт по людям")</h1>
        <p class="alva-page-header__desc">Кто чем занят во времени: часы назначенной работы против доступных, перегрузки и отсутствия. Перетащите задачу на другую строку или нажмите Ctrl+↑/↓, чтобы переназначить; Ctrl+стрелка влево/вправо переносит даты.</p>
    </div>
</section>
<PageFeedback Loading="_busy" Error="@_error" />
@if (Session.TeamId is null) { <TeamRequired /> }
else if (_data is not null && _people is not null)
{
    <div class="alva-filterbar alva-gantt-bar">
        <div class="alva-gantt-bar__fields">
            <FlareSelect TValue="Guid?" Items="@(_data.Sprints.OrderBy(s => s.StartDate).Select(s => (Guid?)s.Id))" ItemLabel="_data.SprintName" NullOption="Все задачи"
                         @bind-Value="_sprintId" @bind-Value:after="LoadCapacity" Size="FieldSize.Sm" InputAttributes="@(Aria("Спринт"))" />
            <FlareSelect TValue="GanttScale" Items="GanttData.Scales" ItemLabel="GanttData.ScaleName" @bind-Value="_scale" Size="FieldSize.Sm" InputAttributes="@(Aria("Масштаб"))" />
            <GanttZoom View="people" Scale="_scale" @bind-Value="_unit" />
        </div>
        <FlareSwitch Value="_twoD" ValueChanged="SetTwoD" Label="Синхронно с задачами (2D)" />
    </div>

    <GanttLegend Notice="@_notice">
        <span class="alva-gantt-legend__item alva-gantt-legend__item--load">Загрузка, ч</span>
        <span class="alva-gantt-legend__item alva-gantt-legend__item--overload">Перегрузка</span>
        <span class="alva-gantt-legend__item alva-gantt-legend__item--free">Свободно</span>
        <span class="alva-gantt-legend__item alva-gantt-legend__item--absence">Отсутствие</span>
        <span class="alva-gantt-legend__item alva-gantt-legend__item--demand">Нужен человек</span>
    </GanttLegend>

    <FlareGantt Range="@Range" Scale="_scale" UnitWidth="_unit" FillWidth="true" Virtualize="true" RowHeight="36" SideWidth="@_side" ResizableSide="true" SideWidthChanged="SaveSide"
                NonWorking="GanttData.IsWeekend" Markers="@GanttData.TodayMarkers" Regions="@_data.SprintRegions(Sprint)" @bind-SelectedKey="_selected"
                AriaLabel="@(_twoD ? "Синхронный Гантт 2D" : "Гантт по людям")" Class="alva-gantt">
        <Corner><span>Исполнитель · загрузка за период</span></Corner>
        <ChildContent>
            @if (_twoD)
            {
                <GanttTaskPanel Data="_data" SprintId="_sprintId" OnChange="Change" OnLinkCreate="Link" OnLinkRejected="Rejected">
                    <Header>Проекция 1: иерархия работ и фазы во времени</Header>
                </GanttTaskPanel>
            }
            <GanttPeoplePanel People="_people" Scale="_scale" Range="Range" Header="@(_twoD ? PeopleHeader : null)"
                              OnChange="Change" OnLinkCreate="Link" OnLinkRejected="Rejected" />
        </ChildContent>
    </FlareGantt>
}

@code {
    private GanttData? _data;
    private GanttPeopleData? _people;
    private bool _busy = true;
    private string? _error;
    private string? _notice;
    private Guid? _sprintId;
    private GanttScale _scale = GanttScale.Day;
    private double _unit = GanttData.UnitWidth(GanttScale.Day);
    private string _side = "22rem";
    private string? _selected;
    private bool _twoD;

    private static readonly RenderFragment PeopleHeader = @<span>Проекция 2: дорожки ресурсов и ёмкость (часы)</span>;

    private static DateOnly Today => DateOnly.FromDateTime(DateTime.Today);
    private SprintModel? Sprint => _data?.Sprint(_sprintId);
    private GanttSpan Range => _data!.Range(Sprint, Today);

    private static Dictionary<string, object> Aria(string label) => new() { ["aria-label"] = label };

    private async Task SaveSide(string width)
    {
        _side = width;
        await Preferences.SaveSide("people", width);
    }

    protected override async Task OnInitializedAsync()
    {
        _twoD = Navigation.Uri.Contains("/gantt/2d", StringComparison.OrdinalIgnoreCase);
        await Session.Initialize();
        _side = (await Preferences.Get("people")).Side ?? _side;
        await Reload(initial: true);
    }

    private void SetTwoD(bool value)
    {
        _twoD = value;
        Navigation.NavigateTo(value ? "/gantt/2d" : "/gantt/people", replace: true);
    }

    private async Task Reload(bool initial = false)
    {
        _busy = true;
        try
        {
            if (Session.TeamId is null) return;
            _data = await GanttData.Load(Session);
            if (initial) _sprintId = _data.Sprints.FirstOrDefault(s => s.Status == "Active")?.Id;
            _people = await GanttPeopleData.Load(Session, _data, Range);
        }
        catch (Exception e) when (e is HttpRequestException or InvalidOperationException) { _error = e.Message; }
        finally { _busy = false; }
    }

    // Ёмкость зависит от окна оси, поэтому новый спринт перечитывает её.
    private async Task LoadCapacity()
    {
        try { _people = await GanttPeopleData.Load(Session, _data!, Range); }
        catch (Exception e) when (e is HttpRequestException or InvalidOperationException) { _error = e.Message; }
    }

    private async Task Change(GanttChangeEventArgs args)
    {
        _error = null;
        try { _notice = await _people!.Apply(Session, args); }
        catch (Exception e) when (e is HttpRequestException or InvalidOperationException) { args.Cancel = true; _error = e.Message; }
        await Reload();
    }

    private async Task Link(GanttLinkEventArgs args)
    {
        _error = null;
        try
        {
            await _data!.AddLink(Session, args.Link);
            _notice = "Связь добавлена";
        }
        catch (Exception e) when (e is HttpRequestException or InvalidOperationException) { args.Cancel = true; _error = e.Message; }
        await Reload();
    }

    private void Rejected(GanttLinkRejectedEventArgs args) => _error = args.Message;
}
