@page "/gantt/people"
@page "/gantt/2d"
@inject AlvaSession Session
@inject GanttPreferences Preferences
@inject NavigationManager Navigation
@using Flare.Components.Gantt
@* Гантт по людям (макет p6_2d, проекция 2): дорожки людей и ролей с часами ёмкости и задачами исполнителя.
   В 2D-режиме над ними — проекция 1 на той же оси. Проекции собирает Alva из примитивов Flare.Components.Gantt. *@
<PageTitle>@(_twoD ? AlvaStrings.Gantt_SynchronisedGantt2d : AlvaStrings.Gantt_PeopleGantt) · Alva</PageTitle>
<AlvaPageHeader Category="@(AlvaStrings.Gantt_ChartsGantt)" Title="@(_twoD ? AlvaStrings.Gantt_SynchronisedGantt2d : AlvaStrings.Gantt_PeopleGantt)" Description="@(AlvaStrings.Gantt_WhoIsBusyAndWhenHoursOfAssignedWorkVersusAvailableOverloadsAndAbsencesDr_42e8e3)" />
<PageFeedback Loading="_busy" Error="@_error" OnRetry="() => Reload()" />
@if (Session.TeamId is null) { <TeamRequired /> }
else if (_data is not null && _people is not null)
{
    <div class="alva-filterbar alva-gantt-bar">
        <div class="alva-gantt-bar__fields">
            <FlareSelect TValue="Guid?" Items="@(_data.Sprints.OrderBy(s => s.StartDate).Select(s => (Guid?)s.Id))" ItemLabel="_data.SprintName" NullOption="@(AlvaStrings.Gantt_AllTasks)"
                         @bind-Value="_sprintId" @bind-Value:after="LoadCapacity" Size="FieldSize.Sm" InputAttributes="@(Aria(AlvaStrings.Gantt_Sprint))" />
            <FlareSelect TValue="GanttScale" Items="GanttData.Scales" ItemLabel="GanttData.ScaleName" @bind-Value="_scale" Size="FieldSize.Sm" InputAttributes="@(Aria(AlvaStrings.Gantt_Scale))" />
            <GanttZoom View="people" Scale="_scale" @bind-Value="_unit" />
            <FlareButton Size="ButtonSize.Sm" Variant="ButtonVariant.Text" OnClick="ToToday" Tooltip="@(AlvaStrings.Gantt_ToTodayAltWheelScrollThroughTime)">@(AlvaStrings.Gantt_Today)</FlareButton>
        </div>
        <FlareSwitch Value="_twoD" ValueChanged="SetTwoD" Label="@(AlvaStrings.Gantt_SynchronisedWithTasks2d)" />
    </div>

    <GanttLegend Notice="@_notice" Items="PeopleKey" />

    @* Обёртка ловит Enter с полосы и держит фокус после закрытия панели: события полосы всплывают сюда. *@
    <div class="alva-gantt__host" @ref="_host" tabindex="-1" @onkeydown="OnChartKey">
    <FlareGantt @ref="_chart" Range="@_range" RangeChanged="Grow" Endless="true" Scale="_scale" UnitWidth="_unit" FillWidth="true" Virtualize="true" RowHeight="36" SideWidth="@_side" DefaultSideWidth="22rem" ResizableSide="true" SideWidthChanged="SaveSide"
                NonWorking="GanttData.IsWeekend" Markers="@GanttData.TodayMarkers" Regions="@_data.SprintRegions(Sprint)" @bind-SelectedKey="_selected"
                AriaLabel="@(_twoD ? AlvaStrings.Gantt_SynchronisedGantt2d : AlvaStrings.Gantt_PeopleGantt)" Class="alva-gantt">
        <Corner><span>@(AlvaStrings.Gantt_AssigneeWorkloadOverThePeriod)</span></Corner>
        <ChildContent>
            @if (_twoD)
            {
                <GanttTaskPanel Data="_data" SprintId="_sprintId" OnChange="Change" OnLinkCreate="Link" OnLinkRejected="Rejected" OnItemClick="OpenTask">
                    <Header>@(AlvaStrings.Gantt_Projection1WorkHierarchyAndPhasesOverTime)</Header>
                </GanttTaskPanel>
            }
            <GanttPeoplePanel People="_people" Scale="_scale" Range="_range" Header="@(_twoD ? PeopleHeader : null)"
                              OnChange="Change" OnLinkCreate="Link" OnLinkRejected="Rejected" OnItemClick="OpenTask" />
        </ChildContent>
    </FlareGantt>
    </div>
    @* Панель задачи — та же, что на «Гантте по задачам»: карточка задачи целиком, без ухода со страницы. *@
    <FlareDrawer Anchor="DrawerAnchor.Right" Open="_panelOpen" OpenChanged="OnPanelOpen" Width="34rem" ContentPadding="FlareSpacing.Large" AriaLabel="@(AlvaStrings.Common_Task)">
        @if (_open is not null)
        {
            <TaskDetails @ref="_details" Item="_open" Tasks="_data!.Tasks" Projects="_projects" Sprints="_data.Sprints" Actors="_data.Actors" Changed="@(() => Reload())" HeadingLevel="2" />
        }
    </FlareDrawer>
}

@code {
    private GanttData? _data;
    private GanttPeopleData? _people;
    private bool _busy = true;
    private string? _error;
    private string? _notice;
    private Guid? _sprintId;
    private GanttScale _scale = GanttScale.Day;
    private double _unit = GanttData.UnitWidth(GanttScale.Day);
    private string _side = "22rem";
    private string? _selected;
    private bool _twoD;

    // Панель задачи: та же, что на «Гантте по задачам».
    private TaskModel? _open;
    private TaskDetails? _details;
    [CascadingParameter] public FlareConfirmDialogProvider? Confirm { get; set; }
    private bool _panelOpen;
    private ElementReference _host;
    private ProjectModel[] _projects = [];

    private GanttLegendItem[] PeopleKey =>
    [
        new("load", AlvaStrings.Gantt_LoadH, GanttLegendShape.Cell),
        new("overload", AlvaStrings.Common_OverloadLabel, GanttLegendShape.Cell),
        new("free", AlvaStrings.Gantt_Free, GanttLegendShape.Cell),
        new("absence", AlvaStrings.Gantt_Absence, GanttLegendShape.Cell),
        new("demand", AlvaStrings.Gantt_APersonIsRequired, GanttLegendShape.Cell)
    ];

    private static readonly RenderFragment PeopleHeader = @<span>@(AlvaStrings.Gantt_View2ResourceLanesAndCapacityHours)</span>;

    private static DateOnly Today => DateOnly.FromDateTime(DateTime.Today);
    private SprintModel? Sprint => _data?.Sprint(_sprintId);
    private FlareGantt? _chart;
    private GanttSpan _range;

    // Окно спринта (или всех задач) — начало оси; дальше она растёт прокруткой.
    private GanttSpan SprintRange => _data!.Range(Sprint, Today);

    // Ось просит больше времени: ёмкость догружается только для новых отрезков.
    private async Task Grow(GanttSpan range)
    {
        _range = range;
        if (_people is not null) _people = await _people.Extend(Session, range);
    }

    private Task ToToday() => _chart?.ScrollTo(DateTime.Today.AddDays(-1)) ?? Task.CompletedTask;

    private static Dictionary<string, object> Aria(string label) => new() { ["aria-label"] = label };

    private async Task SaveSide(string width)
    {
        _side = width;
        await Preferences.SaveSide("people", width);
    }

    protected override async Task OnInitializedAsync()
    {
        _twoD = Navigation.Uri.Contains("/gantt/2d", StringComparison.OrdinalIgnoreCase);
        await Session.Initialize();
        _side = (await Preferences.Get("people")).Side ?? _side;
        await Reload(initial: true);
    }

    private void SetTwoD(bool value)
    {
        _twoD = value;
        Navigation.NavigateTo(value ? "gantt/2d" : "gantt/people", replace: true);
    }

    /// <summary>Клик по полосе открывает панель задачи, не уводя со страницы.</summary>
    private void OpenTask(TaskModel task) { _open = task; _panelOpen = true; }

    /// <summary>Enter на выбранной полосе делает то же, что клик: полоса фокусируема, но Enter у неё ничего не
    /// делает, поэтому его ловит обёртка доски.</summary>
    private void OnChartKey(KeyboardEventArgs e)
    {
        if (e.Key != "Enter" || _selected is null || _panelOpen) return;
        if (_data?.Tasks.FirstOrDefault(t => GanttData.Key(t.Id) == _selected) is { } task) OpenTask(task);
    }

    /// <summary>Панель закрылась (Esc, фон или кнопка): задача отпускается, фокус возвращается к доске.</summary>
    private async Task OnPanelOpen(bool open)
    {
        if (!open && _details?.Dirty == true && !await DraftPrompt.CanDiscardAsync(Confirm, true))
        {
            _panelOpen = true;
            StateHasChanged();
            return;
        }
        _panelOpen = open;
        if (open) return;
        _open = null;
        try { await _host.FocusAsync(); }
        catch (JSDisconnectedException) { }
    }

    private async Task Reload(bool initial = false)
    {
        _busy = true;
        try
        {
            if (Session.TeamId is null) return;
            _data = await GanttData.Load(Session);
            // Проект есть в карточке задачи, поэтому панель получает и справочник проектов.
            _projects = await Session.Get<ProjectModel[]>(Session.TeamPath("projects"));
            if (initial)
            {
                _sprintId = _data.Sprints.FirstOrDefault(s => s.Status == "Active")?.Id;
                _range = SprintRange;
            }
            // После правки ось остаётся, где её докрутили, и включает окно спринта.
            else _range = new GanttSpan(_range.Start < SprintRange.Start ? _range.Start : SprintRange.Start, _range.End > SprintRange.End ? _range.End : SprintRange.End);
            _people = await GanttPeopleData.Load(Session, _data, _range);
        }
        catch (Exception e) when (e is HttpRequestException or InvalidOperationException) { _error = PageFeedback.Describe(e); }
        finally { _busy = false; }
    }

    // Новый спринт начинает ось заново с его окна и перечитывает ёмкость на неё.
    private async Task LoadCapacity()
    {
        _range = SprintRange;
        try { _people = await GanttPeopleData.Load(Session, _data!, _range); }
        catch (Exception e) when (e is HttpRequestException or InvalidOperationException) { _error = PageFeedback.Describe(e); }
    }

    private async Task Change(GanttChangeEventArgs args)
    {
        _error = null;
        try { _notice = await _people!.Apply(Session, args); }
        catch (Exception e) when (e is HttpRequestException or InvalidOperationException) { args.Cancel = true; _error = PageFeedback.Describe(e); }
        await Reload();
    }

    private async Task Link(GanttLinkEventArgs args)
    {
        _error = null;
        try
        {
            await _data!.AddLink(Session, args.Link);
            _notice = AlvaStrings.Gantt_LinkAdded;
        }
        catch (Exception e) when (e is HttpRequestException or InvalidOperationException) { args.Cancel = true; _error = PageFeedback.Describe(e); }
        await Reload();
    }

    private void Rejected(GanttLinkRejectedEventArgs args) => _error = args.Message;
}
