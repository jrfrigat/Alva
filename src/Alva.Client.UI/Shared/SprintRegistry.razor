@inject AlvaSession Session
@if (!_loaded) { <LoadingSkeleton Height="12rem" /> }
else
{
<FlareGrid MinColumnWidth="min(100%,15rem)">
    <FlareStat Label="@(AlvaStrings.Sprint_CurrentCycle)" Value="@(Active?.Name ?? AlvaStrings.Sprint_NoActive)">
        <CaptionContent>
            @if (Active is not null)
            {
                var (done, total) = Hours(Active);
                <FlareStack Gap="FlareSpacing.XSmall">
                    <FlareStack Row StretchFirst>
                        <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@AlvaFormat.Hours(done) @(AlvaStrings.Sprint_HoursShort) / @AlvaFormat.Hours(total) @(AlvaStrings.Sprint_HoursShort)</FlareText>
                        <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.Primary">@Percent(done, total)%</FlareText>
                    </FlareStack>
                    <FlareProgressLinear Value="@Percent(done, total)" Size="TrackSize.Xs" Color="FlareColor.Primary" aria-label="@(AlvaStrings.Sprint_SprintHoursClosed)" />
                    <FlareStack Row StretchFirst>
                        <FlareText Typo="TypographyScale.BodySmall" Color="@(RisksOf(Active).Length > 0 ? FlareColor.Error : FlareColor.OnSurfaceVariant)">@(RisksOf(Active).Length > 0 ? $"{RisksOf(Active).Length} {AlvaFormat.Plural(RisksOf(Active).Length, "task")} {AlvaStrings.Sprint_AtRiskSuffix}" : AlvaStrings.Sprint_NoRisks)</FlareText>
                        <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@(AlvaStrings.Sprint_Finish) @Active.EndDate.ToString("d MMM")</FlareText>
                    </FlareStack>
                    <AlvaStatusChip Tone="AlvaTone.Info">@(AlvaStrings.Sprint_Day) @DayOf(Active) @(AlvaStrings.Sprint_OutOf) @AlvaFormat.WorkDays(Active.StartDate, Active.EndDate)</AlvaStatusChip>
                </FlareStack>
            }
            else
            {
                <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@(AlvaStrings.Sprint_StartThePlannedSprintToFollowTheCycle)</FlareText>
            }
        </CaptionContent>
    </FlareStat>

    <FlareStat Label="@(AlvaStrings.Sprint_SpeedPace)" Value="@(Velocity is { } v ? $"{AlvaFormat.Hours(v.Current)} {AlvaStrings.Sprint_HoursPerWeek}" : "—")" Icon="@MaterialDesign3Icons.Regular.Speed"
               Delta="@(Velocity?.Trend is { } trend ? $"{(trend >= 0 ? "+" : "")}{trend}%" : null)" DeltaColor="@(Velocity?.Trend >= 0 ? FlareColor.Success : FlareColor.Error)"
               Caption="@(Velocity is { } velocity ? $"{AlvaStrings.Sprint_AverageClosedEstimateOver} {velocity.Count} {AlvaFormat.Plural(velocity.Count, "sprint")}" : AlvaStrings.Sprint_PaceAppearsAfterTheFirstCompletedSprint)" />

    <FlareStat Label="@(AlvaStrings.Sprint_CapacityBalance)" Value="@(Active is not null && _capacity.TryGetValue(Active.Id, out var cap) && cap.Available > 0 ? $"{Percent(cap.Allocated, cap.Available)}%" : "—")" Icon="@MaterialDesign3Icons.Regular.Balance">
        <CaptionContent>
            @if (Active is not null && _capacity.TryGetValue(Active.Id, out var cap) && cap.Available > 0)
            {
                <FlareStack Gap="FlareSpacing.XSmall">
                    <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@AlvaFormat.Hours(cap.Allocated) / @AlvaFormat.Hours(cap.Available) @(AlvaStrings.Sprint_HoursShort) · @(AlvaStrings.Sprint_Reserve) @AlvaFormat.Hours(Math.Max(0, cap.Available - cap.Allocated)) @(AlvaStrings.Sprint_HoursShort)</FlareText>
                    <FlareProgressLinear Value="@Math.Min(100, Percent(cap.Allocated, cap.Available))" Size="TrackSize.Xs" Color="FlareColor.Primary" aria-label="@(AlvaStrings.Sprint_TeamWorkload)" />
                    <FlareStack Row StretchFirst>
                        <FlareText Typo="TypographyScale.BodySmall" Color="@(cap.Overloaded > 0 ? FlareColor.Error : FlareColor.OnSurfaceVariant)">@(cap.Overloaded > 0 ? $"{cap.Overloaded} {AlvaFormat.Plural(cap.Overloaded, "person")} {AlvaStrings.Common_Overloaded}" : AlvaStrings.Sprint_NoOverloads)</FlareText>
                        <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@(AlvaStrings.Sprint_People) @cap.People</FlareText>
                    </FlareStack>
                </FlareStack>
            }
            else
            {
                <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@(AlvaStrings.Sprint_AnActiveSprintAndPeopleSSchedulesAreRequired)</FlareText>
            }
        </CaptionContent>
    </FlareStat>

    <FlareStat Label="@(AlvaStrings.Sprint_Progress)" Value="@Count("Active").ToString()" Unit="@(AlvaStrings.Sprint_Active)" Icon="@MaterialDesign3Icons.Regular.ViewTimeline">
        <CaptionContent>
            <FlareStack Gap="FlareSpacing.XSmall">
                <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@(AlvaStrings.Sprint_Planned): @Count("Planned") · @(AlvaStrings.Sprint_ClosedLabel): @Count("Completed")</FlareText>
                <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@(AlvaStrings.Sprint_NextStart) @(Planned.FirstOrDefault()?.StartDate.ToString("d MMM") ?? "—")</FlareText>
            </FlareStack>
        </CaptionContent>
    </FlareStat>
</FlareGrid>

<FlareCard Variant="CardVariant.Outlined">
    <FlareCardContent>
    <FlareStack Row Wrap Align="FlareAlignItems.Center" Gap="FlareSpacing.Medium" StretchFirst="true">
    <FlareTabs @bind-ActiveIndex="_filter">
        <FlareTab Label="@(AlvaStrings.Common_AllSprints)" Badge="@Sprints.Length.ToString()" BadgeColor="FlareColor.Secondary" />
        <FlareTab Label="@(AlvaStrings.Sprint_ActiveTab)" Badge="@Count("Active").ToString()" BadgeColor="FlareColor.Secondary" />
        <FlareTab Label="@(AlvaStrings.Sprint_PlannedTab)" Badge="@Count("Planned").ToString()" BadgeColor="FlareColor.Secondary" />
        <FlareTab Label="@(AlvaStrings.Sprint_Completed)" Badge="@Count("Completed").ToString()" BadgeColor="FlareColor.Secondary" />
    </FlareTabs>
    <FlareTextField @bind-Value="_search" Immediate Clearable Placeholder="@(AlvaStrings.Sprint_SearchBySprintName)" AriaLabel="@(AlvaStrings.Sprint_SearchASprint)" Style="flex:0 1 20rem">
        <AdornmentStart><FlareIconView Value="@MaterialDesign3Icons.Regular.Search" Size="18px" /></AdornmentStart>
    </FlareTextField>
    </FlareStack>
    </FlareCardContent>
</FlareCard>
<PageFeedback Error="@_error" />

@if (Sprints.Length == 0)
{
    <FlareEmptyState Title="@(AlvaStrings.Sprint_TheFirstSprintStartsWithAGoal)" Description="@(AlvaStrings.Sprint_SetTheDatesAndGatherTheTeamSTasks)" />
}

@if (Sprints.Length > 0 && _filter > 0 && !Visible(FilterStatus).Any())
{
    <FlareEmptyState Compact Title="@(AlvaStrings.Sprint_ThereAreNoSprintsInThisSection)" Description="@(AlvaStrings.Sprint_ChangeTheTabOrTheSearchCondition)" />
}

@if (Show("Active"))
{
<FlareSection Title="@(AlvaStrings.Sprint_CurrentIterationInProgress)">
    @foreach (var sprint in Visible("Active"))
    {
        var tasks = TasksOf(sprint);
        var (done, total) = Hours(sprint);
        var inWork = SprintHours.Sum(tasks.Where(t => t.Status == "InProgress"), sprint);
        var risks = RisksOf(sprint);
        <FlareCard Variant="CardVariant.Outlined" @key="sprint.Id">
            <FlareCardHeader Title="@sprint.Name" Subtitle="@(string.IsNullOrWhiteSpace(sprint.Goal) ? null : sprint.Goal)">
                <ActionContent>
                    <FlareStack Row Wrap Gap="FlareSpacing.XSmall">
                        <AlvaStatusChip Tone="AlvaTone.Ok">@(AlvaStrings.Common_InProgress)</AlvaStatusChip>
                        <AlvaStatusChip Tone="AlvaTone.Info">@(AlvaStrings.Sprint_Day) @DayOf(sprint) @(AlvaStrings.Sprint_OutOf) @AlvaFormat.WorkDays(sprint.StartDate, sprint.EndDate) · @(AlvaStrings.Sprint_RemainingDays) @DaysLeft(sprint) @(AlvaStrings.Sprint_Work) @AlvaFormat.Plural(DaysLeft(sprint), "day")</AlvaStatusChip>
                    </FlareStack>
                </ActionContent>
            </FlareCardHeader>
            <FlareCardContent>
                <FlareGrid MinColumnWidth="min(100%,20rem)">
                    <FlareStack Gap="FlareSpacing.Small">
                        <FlareStack Row Align="FlareAlignItems.Center" Gap="FlareSpacing.XSmall">
                            <FlareIconView Value="@MaterialDesign3Icons.Regular.Schedule" Size="16px" />
                            <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@AlvaFormat.Period(sprint.StartDate, sprint.EndDate) (@AlvaFormat.WorkDays(sprint.StartDate, sprint.EndDate) @(AlvaStrings.Sprint_WorkDays))</FlareText>
                        </FlareStack>
                        <FlareStack Row Wrap Align="FlareAlignItems.Center" Gap="FlareSpacing.XSmall">
                            <FlareText Typo="TypographyScale.LabelMedium" Color="FlareColor.OnSurfaceVariant">@(AlvaStrings.Sprint_Projects)</FlareText>
                            @foreach (var (name, share) in ProjectShares(tasks, sprint))
                            {
                                <FlareChip Size="ChipSize.Sm" Variant="ChipVariant.Filled" Label="@($"{name} ({share}%)")" />
                            }
                        </FlareStack>
                        <FlareStack Row Wrap Align="FlareAlignItems.Center" Gap="FlareSpacing.XSmall">
                            <FlareText Typo="TypographyScale.LabelMedium" Color="FlareColor.OnSurfaceVariant">@(AlvaStrings.Common_Team) (@PeopleOf(tasks).Length):</FlareText>
                            <FlareAvatarGroup Max="8" Size="AvatarSize.Xs">
                                @foreach (var person in PeopleOf(tasks))
                                {
                                    <FlareAvatar Text="@AlvaFormat.Initials(person.Name)" Alt="@person.Name" Size="AvatarSize.Xs" />
                                }
                            </FlareAvatarGroup>
                            @if (tasks.Count(t => Assignees.Person(t, _actors) is null) is > 0 and var unassigned)
                            {
                                <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.Warning">@(AlvaStrings.Sprint_UnassignedPrefix) @unassigned</FlareText>
                            }
                        </FlareStack>
                        @if (risks.Length > 0)
                        {
                            <FlareAlert Severity="AlertSeverity.Warning" Title="@($"{risks.Length} {AlvaFormat.Plural(risks.Length, "task")} {AlvaStrings.Sprint_AtRiskOfMissingTheDeadline}")">
                                <FlareStack Gap="FlareSpacing.XSmall">
                                    @foreach (var risk in risks.Take(3))
                                    {
                                        var task = TaskOf(risk.TaskId);
                                        <FlareStack Gap="FlareSpacing.None">
                                            <FlareLink Href="@($"tasks/{risk.TaskId}")">@risk.Title</FlareLink>
                                            <FlareStack Row Wrap Gap="FlareSpacing.XSmall">
                                                @foreach (var reason in risk.Reasons)
                                                {
                                                    <FlareLink Href="@RiskActions.Href(reason, risk.TaskId, task?.ResolvedPersonId)" title="@RiskActions.Label(reason, task?.ResolvedPersonId)">@ReasonText.Describe(reason)</FlareLink>
                                                }
                                            </FlareStack>
                                        </FlareStack>
                                    }
                                    @if (risks.Length > 3) { <FlareLink Href="analytics">@(AlvaStrings.Sprint_More) @(risks.Length - 3)</FlareLink> }
                                </FlareStack>
                            </FlareAlert>
                        }
                    </FlareStack>
                    <FlareCard Variant="CardVariant.Filled">
                        <FlareCardContent>
                            <FlareStack Gap="FlareSpacing.Small">
                                <FlareStack Row StretchFirst Align="FlareAlignItems.Baseline">
                                    <FlareText Typo="TypographyScale.LabelMedium" Color="FlareColor.OnSurfaceVariant">@(AlvaStrings.Sprint_SprintProgress)</FlareText>
                                    <FlareText Typo="TypographyScale.TitleMedium" Color="FlareColor.Primary">@Percent(done, total)%</FlareText>
                                </FlareStack>
                                <FlareMeter Size="TrackSize.Sm" aria-label="@string.Format(AlvaStrings.Sprint_ClosedHInProgressHOfH, AlvaFormat.Hours(done), AlvaFormat.Hours(inWork), AlvaFormat.Hours(total))">
                                    <FlareMeterSegment Value="@((double)Math.Max(0, done))" Color="FlareColor.Primary" />
                                    <FlareMeterSegment Value="@((double)Math.Max(0, inWork))" Color="FlareColor.Secondary" />
                                    <FlareMeterSegment Value="@((double)Math.Max(0, total - done - inWork))" Color="FlareColor.OnSurfaceVariant" />
                                </FlareMeter>
                                <FlareStack Row Wrap Gap="FlareSpacing.XSmall">
                                    <FlareChip Size="ChipSize.Sm" Variant="ChipVariant.Filled" Color="FlareColor.Primary" Label="@($"{AlvaStrings.Sprint_ClosedPrefix} {AlvaFormat.Hours(done)} {AlvaStrings.Sprint_HoursShort}")" />
                                    <FlareChip Size="ChipSize.Sm" Variant="ChipVariant.Filled" Color="FlareColor.Secondary" Label="@($"{AlvaStrings.Sprint_InProgress} {AlvaFormat.Hours(inWork)} {AlvaStrings.Sprint_HoursShort}")" />
                                    <FlareChip Size="ChipSize.Sm" Variant="ChipVariant.Filled" Label="@($"{AlvaStrings.Sprint_RemainingPrefix} {AlvaFormat.Hours(total - done)} {AlvaStrings.Sprint_HoursShort} / {AlvaFormat.Hours(total)} {AlvaStrings.Sprint_HoursShort}")" />
                                </FlareStack>
                                <FlareStack Row Wrap Gap="FlareSpacing.XSmall">
                                    <FlareChip Size="ChipSize.Sm" Variant="ChipVariant.Filled" Label="@($"{AlvaStrings.Sprint_Total} {tasks.Length}")" />
                                    <FlareChip Size="ChipSize.Sm" Variant="ChipVariant.Filled" Color="FlareColor.Info" Label="@($"{AlvaStrings.Common_InProgress} {tasks.Count(t => t.Status == "InProgress")}")" />
                                    <FlareChip Size="ChipSize.Sm" Variant="ChipVariant.Filled" Color="FlareColor.Success" Label="@($"{AlvaStrings.Common_DoneStatus} {tasks.Count(t => t.Status == "Done")}")" />
                                    <FlareChip Size="ChipSize.Sm" Variant="ChipVariant.Filled" Color="FlareColor.Error" Label="@($"{AlvaStrings.Common_Risk} {risks.Length}")" />
                                </FlareStack>
                            </FlareStack>
                        </FlareCardContent>
                    </FlareCard>
                </FlareGrid>
            </FlareCardContent>
            <FlareCardActions Align="CardActionsAlign.End">
                <FlareButton Href="@($"sprints/{sprint.Id}")" Size="ButtonSize.Sm">
                    <ChildContent>@(AlvaStrings.Sprint_GoToTheSprint)</ChildContent>
                    <TrailingIcon><FlareIconView Value="@MaterialDesign3Icons.Regular.ArrowForward" Size="16px" /></TrailingIcon>
                </FlareButton>
                <FlareButton Href="@($"sprints/{sprint.Id}/plan")" Variant="ButtonVariant.Outlined" Size="ButtonSize.Sm">
                    <LeadingIcon><FlareIconView Value="@MaterialDesign3Icons.Regular.Balance" Size="16px" /></LeadingIcon>
                    <ChildContent>@(AlvaStrings.Sprint_Balance)</ChildContent>
                </FlareButton>
            </FlareCardActions>
        </FlareCard>
    }
</FlareSection>
}

@if (Show("Planned") && Visible("Planned").Any())
{
<FlareSection Title="@($"{AlvaStrings.Sprint_PlannedSprints} ({Visible("Planned").Count()})")">
    <FlareGrid MinColumnWidth="min(100%,22rem)">
        @foreach (var sprint in Visible("Planned"))
        {
            var tasks = TasksOf(sprint);
            var (_, total) = Hours(sprint);
            var available = _capacity.TryGetValue(sprint.Id, out var plannedCap) ? plannedCap.Available : 0;
            <FlareCard Variant="CardVariant.Outlined" @key="sprint.Id">
                <FlareCardHeader Title="@sprint.Name" Subtitle="@(string.IsNullOrWhiteSpace(sprint.Goal) ? null : sprint.Goal)">
                    <ActionContent>
                        @if (available > 0) { <AlvaStatusChip Tone="@(total > available ? AlvaTone.Critical : AlvaTone.Ok)">@(AlvaStrings.Sprint_PlannedPercent) @Percent(total, available)%</AlvaStatusChip> }
                    </ActionContent>
                </FlareCardHeader>
                <FlareCardContent>
                    <FlareStack Gap="FlareSpacing.Small">
                        <FlareStack Row Align="FlareAlignItems.Center" Gap="FlareSpacing.XSmall">
                            <FlareIconView Value="@MaterialDesign3Icons.Regular.Event" Size="16px" />
                            <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@AlvaFormat.Period(sprint.StartDate, sprint.EndDate)</FlareText>
                        </FlareStack>
                        <FlareStack Row Wrap StretchFirst Align="FlareAlignItems.Baseline" Gap="FlareSpacing.XSmall">
                            <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@(AlvaStrings.Sprint_TeamCapacityBalance)</FlareText>
                            <FlareText Typo="TypographyScale.BodySmall">@AlvaFormat.Hours(total) @(AlvaStrings.Sprint_HoursShort) @(AlvaStrings.Sprint_PlannedCount) / @(available > 0 ? $"{AlvaFormat.Hours(available)} {AlvaStrings.Sprint_HoursShort} {AlvaStrings.Common_Available}" : AlvaStrings.Sprint_NoScheduleSet)</FlareText>
                        </FlareStack>
                        <FlareProgressLinear Value="@(available > 0 ? Math.Min(100, Percent(total, available)) : 0)" aria-label="@(AlvaStrings.Sprint_TakenOfAvailable)" />
                        <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@tasks.Length @AlvaFormat.Plural(tasks.Length, "taskIncluded")</FlareText>
                    </FlareStack>
                </FlareCardContent>
                <FlareCardActions Align="CardActionsAlign.Between">
                    <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@(AlvaStrings.Sprint_StartsIn) @Math.Max(0, sprint.StartDate.DayNumber - Today.DayNumber) @(AlvaStrings.Sprint_DaysShort)</FlareText>
                    <FlareButton Href="@($"sprints/{sprint.Id}/plan")" Size="ButtonSize.Sm">
                        <ChildContent>@(AlvaStrings.Sprint_OpenPlanning)</ChildContent>
                        <TrailingIcon><FlareIconView Value="@MaterialDesign3Icons.Regular.ArrowForward" Size="16px" /></TrailingIcon>
                    </FlareButton>
                </FlareCardActions>
            </FlareCard>
        }
    </FlareGrid>
</FlareSection>
}

@if (Show("Completed") && Visible("Completed").Any())
{
<FlareSection Title="@(AlvaStrings.Sprint_CompletedSprints)">
    <FlareCard Variant="CardVariant.Outlined">
        <FlareCardContent>
            <FlareDataGrid TItem="SprintModel" Items="VisibleCompleted" Height="auto" Dense="true" RowKey="s => s!.Id" Presentation="DataGridPresentation.Auto">
                <Columns>
                    <FlareColumn TItem="SprintModel" Title="@(AlvaStrings.Sprint_SprintPeriodGoal)" Sortable Field="s => s!.Name" SortKey="name">
                        <Template Context="sprint">
                            <FlareStack Gap="FlareSpacing.None">
                                <FlareLink Href="@($"sprints/{sprint!.Id}")">@sprint.Name</FlareLink>
                                <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@AlvaFormat.Period(sprint.StartDate, sprint.EndDate)</FlareText>
                                @if (!string.IsNullOrWhiteSpace(sprint.Goal))
                                {
                                    <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@sprint.Goal</FlareText>
                                }
                            </FlareStack>
                        </Template>
                    </FlareColumn>
                    <FlareColumn TItem="SprintModel" Title="@(AlvaStrings.Sprint_ClosingStatus)" Sortable Field="s => OpenHours(s!)" SortKey="open">
                        <Template Context="sprint">
                            <FlareStack Gap="FlareSpacing.XSmall">
                                @if (OpenHours(sprint!) <= 0) { <AlvaStatusChip Tone="AlvaTone.Ok">@(AlvaStrings.Common_Completed)</AlvaStatusChip> }
                                else { <AlvaStatusChip Tone="AlvaTone.Warning">@(AlvaStrings.Sprint_NotClosed) @AlvaFormat.Hours(OpenHours(sprint!)) @(AlvaStrings.Sprint_HoursShort)</AlvaStatusChip> }
                                @if (sprint.Commitment is { } committed && sprint.Result is { } closed)
                                {
                                    <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@(AlvaStrings.Sprint_Commitment) @AlvaFormat.Hours(committed.Hours) @(AlvaStrings.Sprint_HoursShort) → @(AlvaStrings.Sprint_Result) @AlvaFormat.Hours(closed.Hours) @(AlvaStrings.Sprint_HoursShort)</FlareText>
                                }
                            </FlareStack>
                        </Template>
                    </FlareColumn>
                    <FlareColumn TItem="SprintModel" Title="@(AlvaStrings.Sprint_Throughput)" Sortable Field="s => Hours(s!).Done" SortKey="done">
                        <Template Context="sprint">
                            <FlareStack Gap="FlareSpacing.XSmall">
                                <FlareText Typo="TypographyScale.BodySmall">@AlvaFormat.Hours(Hours(sprint!).Done) @(AlvaStrings.Sprint_HoursShort) / @AlvaFormat.Hours(Hours(sprint!).Total) @(AlvaStrings.Sprint_HoursShort)</FlareText>
                                <FlareProgressLinear Value="@Percent(Hours(sprint!).Done, Hours(sprint!).Total)" aria-label="@(AlvaStrings.Sprint_Throughput)" />
                            </FlareStack>
                        </Template>
                    </FlareColumn>
                    <FlareColumn TItem="SprintModel" Title="@(AlvaStrings.Sprint_Pace)" Sortable Field="s => WeeklyPace(s!)" SortKey="pace">
                        <Template Context="sprint">
                            <FlareText Typo="TypographyScale.BodySmall"><b>@AlvaFormat.Hours(WeeklyPace(sprint!))</b> @(AlvaStrings.Sprint_HoursPerWeek)</FlareText>
                        </Template>
                    </FlareColumn>
                </Columns>
            </FlareDataGrid>
        </FlareCardContent>
    </FlareCard>
</FlareSection>
}
}

@code {
    [Parameter] public SprintModel[] Sprints { get; set; } = [];
    [Parameter] public TaskModel[] Tasks { get; set; } = [];

    private RiskDto[] _risks = [];
    private ActorModel[] _actors = [];
    private Dictionary<Guid, (decimal Available, decimal Allocated, int Overloaded, int People)> _capacity = [];
    private int _filter;
    private string? _search, _error;
    private bool _loaded;
    private Guid[] _loadedFor = [];

    private static DateOnly Today => DateOnly.FromDateTime(DateTime.Today);
    private SprintModel? Active => Sprints.Where(s => s.Status == "Active").OrderBy(s => s.StartDate).FirstOrDefault();
    private IEnumerable<SprintModel> Planned => Sprints.Where(s => s.Status == "Planned").OrderBy(s => s.StartDate);
    private int Count(string status) => Sprints.Count(s => s.Status == status);
    private string FilterStatus => _filter switch { 1 => "Active", 2 => "Planned", _ => "Completed" };
    private bool Show(string status) => _filter == 0 || (_filter, status) is (1, "Active") or (2, "Planned") or (3, "Completed");
    private IEnumerable<SprintModel> Visible(string status) => Sprints
        .Where(s => s.Status == status && (string.IsNullOrWhiteSpace(_search) || s.Name.Contains(_search, StringComparison.OrdinalIgnoreCase)))
        .OrderBy(s => status == "Completed" ? -s.EndDate.DayNumber : s.StartDate.DayNumber);
    private IEnumerable<SprintModel> VisibleCompleted => Visible("Completed");
    private TaskModel[] TasksOf(SprintModel sprint) => Tasks.Where(t => t.SprintIds.Contains(sprint.Id) && t.Status != "Cancelled").ToArray();
    private TaskModel? TaskOf(Guid id) => Tasks.FirstOrDefault(t => t.Id == id);
    private RiskDto[] RisksOf(SprintModel sprint) => _risks.Where(r => TasksOf(sprint).Any(t => t.Id == r.TaskId)).ToArray();

    /// <summary>Closed and all estimated hours of the sprint - the share of tasks that falls on it.</summary>
    private (decimal Done, decimal Total) Hours(SprintModel sprint)
    {
        if (sprint.Status == "Completed" && sprint.Result is { } result) return (result.DoneHours, result.Hours);
        var tasks = TasksOf(sprint);
        return (SprintHours.Sum(tasks.Where(t => t.Status == "Done"), sprint), SprintHours.Sum(tasks, sprint));
    }

    private static int Percent(decimal part, decimal whole) => whole <= 0 ? 0 : (int)Math.Round(part / whole * 100);

    /// <summary>Remaining work at closing time: later task edits do not change a closed sprint's result.</summary>
    private decimal OpenHours(SprintModel sprint) => sprint.Result is { } result
        ? result.Hours - result.DoneHours
        : SprintHours.Sum(TasksOf(sprint).Where(t => t.Status is not ("Done" or "Cancelled")), sprint);
    private static int DayOf(SprintModel s) => AlvaFormat.SprintDay(s.StartDate, s.EndDate, Today);
    private static int DaysLeft(SprintModel s) => AlvaFormat.SprintDaysLeft(s.StartDate, s.EndDate, Today);
    private decimal WeeklyPace(SprintModel s) => Hours(s).Done / Math.Max(1m, (s.EndDate.DayNumber - s.StartDate.DayNumber + 1) / 7m);

    /// <summary>Average pace of the last three completed sprints and the change against the previous one, %.</summary>
    private (decimal Current, int? Trend, int Count)? Velocity
    {
        get
        {
            var closed = Sprints.Where(s => s.Status == "Completed").OrderByDescending(s => s.EndDate).Take(3).ToArray();
            if (closed.Length == 0) return null;
            var current = closed.Average(WeeklyPace);
            int? trend = closed.Length > 1 && WeeklyPace(closed[1]) > 0 ? (int)Math.Round((WeeklyPace(closed[0]) / WeeklyPace(closed[1]) - 1) * 100) : null;
            return (current, trend, closed.Length);
        }
    }

    private IEnumerable<(string Name, int Share)> ProjectShares(TaskModel[] tasks, SprintModel sprint)
    {
        var total = SprintHours.Sum(tasks, sprint);
        return tasks.GroupBy(t => t.ProjectId)
            .Select(g => (Name: g.Key is null ? AlvaStrings.Sprint_Ongoing : _projects.FirstOrDefault(p => p.Id == g.Key)?.Name ?? AlvaStrings.Common_Project, Share: Percent(SprintHours.Sum(g, sprint), total)))
            .OrderByDescending(x => x.Share);
    }

    private ProjectModel[] _projects = [];

    private ActorModel[] PeopleOf(TaskModel[] tasks) => _actors
        .Where(a => a.Kind == "Person" && tasks.Any(t => t.ResolvedPersonId == a.Id || t.AssignmentTargetId == a.Id)).ToArray();

    protected override async Task OnParametersSetAsync()
    {
        var open = Sprints.Where(s => s.Status != "Completed").Select(s => s.Id).OrderBy(x => x).ToArray();
        if (open.SequenceEqual(_loadedFor) && _actors.Length > 0) { _loaded = true; return; }
        try
        {
            _risks = (await Session.Get<RiskDto[]>(Session.TeamPath("risks"))).Where(r => r.HasRisk).ToArray();
            _actors = await Session.Get<ActorModel[]>(Session.TeamPath("actors"));
            _projects = await Session.Get<ProjectModel[]>(Session.TeamPath("projects"));
            foreach (var sprint in Sprints.Where(s => s.Status != "Completed"))
            {
                var rows = await Session.Get<CapacityDto[]>(Session.TeamPath($"capacity?from={sprint.StartDate:yyyy-MM-dd}&to={sprint.EndDate:yyyy-MM-dd}"));
                var people = rows.GroupBy(r => r.ActorId).Select(g => (Available: g.Sum(r => r.AvailableHours), Allocated: g.Sum(r => r.AllocatedHours))).ToArray();
                _capacity[sprint.Id] = (people.Sum(p => p.Available), people.Sum(p => p.Allocated), people.Count(p => p.Allocated > p.Available), people.Length);
            }
            _loadedFor = open;
        }
        catch (Exception e) when (e is HttpRequestException or InvalidOperationException or NotSupportedException) { _error = PageFeedback.Describe(e); }
        finally { _loaded = true; }
    }
}
