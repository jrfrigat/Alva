@* Реестр спринтов по макету p4: KPI, фильтр, текущая итерация, запланированные и архив. *@
@inject AlvaSession Session
@if (!_loaded) { <LoadingSkeleton Height="12rem" /> }
else
{
<FlareGrid MinColumnWidth="min(100%,15rem)">
    <FlareStat Label="@(Strings.T("Текущий цикл"))" Value="@(Active?.Name ?? Strings.T("Нет активного"))">
        <CaptionContent>
            @if (Active is not null)
            {
                var (done, total) = Hours(Active);
                <FlareStack Gap="FlareSpacing.XSmall">
                    <FlareStack Row StretchFirst>
                        <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@AlvaFormat.Hours(done) @(Strings.T("ч")) / @AlvaFormat.Hours(total) @(Strings.T("ч"))</FlareText>
                        <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.Primary">@Percent(done, total)%</FlareText>
                    </FlareStack>
                    <FlareProgressLinear Value="@Percent(done, total)" Size="TrackSize.Xs" Color="FlareColor.Primary" aria-label="@(Strings.T("Закрыто часов спринта"))" />
                    <FlareStack Row StretchFirst>
                        <FlareText Typo="TypographyScale.BodySmall" Color="@(RisksOf(Active).Length > 0 ? FlareColor.Error : FlareColor.OnSurfaceVariant)">@(RisksOf(Active).Length > 0 ? $"{RisksOf(Active).Length} {AlvaFormat.Plural(RisksOf(Active).Length, "task")} {Strings.T("под риском")}" : Strings.T("Рисков нет"))</FlareText>
                        <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@(Strings.T("Финиш:")) @Active.EndDate.ToString("d MMM")</FlareText>
                    </FlareStack>
                    <AlvaStatusChip Tone="AlvaTone.Info">@(Strings.T("День")) @DayOf(Active) @(Strings.T("из")) @AlvaFormat.WorkDays(Active.StartDate, Active.EndDate)</AlvaStatusChip>
                </FlareStack>
            }
            else
            {
                <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@(Strings.T("Запустите запланированный спринт, чтобы следить за ходом цикла."))</FlareText>
            }
        </CaptionContent>
    </FlareStat>

    <FlareStat Label="@(Strings.T("Скорость & темп"))" Value="@(Velocity is { } v ? $"{AlvaFormat.Hours(v.Current)} {Strings.T("ч / нед")}" : "—")" Icon="@MaterialDesign3Icons.Regular.Speed"
               Delta="@(Velocity?.Trend is { } trend ? $"{(trend >= 0 ? "+" : "")}{trend}%" : null)" DeltaColor="@(Velocity?.Trend >= 0 ? FlareColor.Success : FlareColor.Error)"
               Caption="@(Velocity is { } velocity ? $"{Strings.T("Средняя закрытая оценка за")} {velocity.Count} {AlvaFormat.Plural(velocity.Count, "sprint")}" : Strings.T("Темп появится после первого завершённого спринта."))" />

    <FlareStat Label="@(Strings.T("Баланс ёмкости"))" Value="@(Active is not null && _capacity.TryGetValue(Active.Id, out var cap) && cap.Available > 0 ? $"{Percent(cap.Allocated, cap.Available)}%" : "—")" Icon="@MaterialDesign3Icons.Regular.Balance">
        <CaptionContent>
            @if (Active is not null && _capacity.TryGetValue(Active.Id, out var cap) && cap.Available > 0)
            {
                <FlareStack Gap="FlareSpacing.XSmall">
                    <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@AlvaFormat.Hours(cap.Allocated) / @AlvaFormat.Hours(cap.Available) @(Strings.T("ч")) · @(Strings.T("Резерв")) @AlvaFormat.Hours(Math.Max(0, cap.Available - cap.Allocated)) @(Strings.T("ч"))</FlareText>
                    <FlareProgressLinear Value="@Math.Min(100, Percent(cap.Allocated, cap.Available))" Size="TrackSize.Xs" Color="FlareColor.Primary" aria-label="@(Strings.T("Загрузка команды"))" />
                    <FlareStack Row StretchFirst>
                        <FlareText Typo="TypographyScale.BodySmall" Color="@(cap.Overloaded > 0 ? FlareColor.Error : FlareColor.OnSurfaceVariant)">@(cap.Overloaded > 0 ? $"{cap.Overloaded} {AlvaFormat.Plural(cap.Overloaded, "person")} {Strings.T("в перегрузе")}" : Strings.T("Без перегрузок"))</FlareText>
                        <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@(Strings.T("Людей:")) @cap.People</FlareText>
                    </FlareStack>
                </FlareStack>
            }
            else
            {
                <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@(Strings.T("Нужен активный спринт и рабочие графики людей."))</FlareText>
            }
        </CaptionContent>
    </FlareStat>

    <FlareStat Label="@(Strings.T("Ход работы"))" Value="@Count("Active").ToString()" Unit="@(Strings.T("Активен"))" Icon="@MaterialDesign3Icons.Regular.ViewTimeline">
        <CaptionContent>
            <FlareStack Gap="FlareSpacing.XSmall">
                <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@(Strings.T("В плане")): @Count("Planned") · @(Strings.T("Закрыто")): @Count("Completed")</FlareText>
                <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@(Strings.T("Следующий старт:")) @(Planned.FirstOrDefault()?.StartDate.ToString("d MMM") ?? "—")</FlareText>
            </FlareStack>
        </CaptionContent>
    </FlareStat>
</FlareGrid>

<div class="alva-filterbar">
    <FlareTabs @bind-ActiveIndex="_filter" Class="alva-filterbar__tabs">
        <FlareTab Label="@(Strings.T("Все спринты"))" Badge="@Sprints.Length.ToString()" BadgeColor="FlareColor.Secondary" />
        <FlareTab Label="@(Strings.T("Активные"))" Badge="@Count("Active").ToString()" BadgeColor="FlareColor.Secondary" />
        <FlareTab Label="@(Strings.T("Запланированные"))" Badge="@Count("Planned").ToString()" BadgeColor="FlareColor.Secondary" />
        <FlareTab Label="@(Strings.T("Завершённые"))" Badge="@Count("Completed").ToString()" BadgeColor="FlareColor.Secondary" />
    </FlareTabs>
    <FlareTextField @bind-Value="_search" Immediate Clearable Placeholder="@(Strings.T("Поиск по названию спринта"))" AriaLabel="@(Strings.T("Поиск спринта"))" Class="alva-filterbar__search">
        <AdornmentStart><FlareIconView Value="@MaterialDesign3Icons.Regular.Search" Size="18px" /></AdornmentStart>
    </FlareTextField>
</div>
<PageFeedback Error="@_error" />

@if (Sprints.Length == 0)
{
    <FlareEmptyState Title="@(Strings.T("Первый спринт начинается с цели"))" Description="@(Strings.T("Задайте сроки и соберите задачи команды."))" />
}

@if (Sprints.Length > 0 && _filter > 0 && !Visible(FilterStatus).Any())
{
    <FlareEmptyState Compact Title="@(Strings.T("В этом разделе спринтов нет"))" Description="@(Strings.T("Смените вкладку или условие поиска."))" />
}

@if (Show("Active"))
{
<FlareSection Title="@(Strings.T("Текущая итерация в работе"))">
    @foreach (var sprint in Visible("Active"))
    {
        var tasks = TasksOf(sprint);
        var (done, total) = Hours(sprint);
        var inWork = SprintHours.Sum(tasks.Where(t => t.Status == "InProgress"), sprint);
        var risks = RisksOf(sprint);
        <FlareCard Variant="CardVariant.Outlined" @key="sprint.Id">
            <FlareCardHeader Title="@sprint.Name" Subtitle="@(string.IsNullOrWhiteSpace(sprint.Goal) ? null : sprint.Goal)">
                <ActionContent>
                    <FlareStack Row Wrap Gap="FlareSpacing.XSmall">
                        <AlvaStatusChip Tone="AlvaTone.Ok">@(Strings.T("В работе"))</AlvaStatusChip>
                        <AlvaStatusChip Tone="AlvaTone.Info">@(Strings.T("День")) @DayOf(sprint) @(Strings.T("из")) @AlvaFormat.WorkDays(sprint.StartDate, sprint.EndDate) · @(Strings.T("Осталось")) @DaysLeft(sprint) @(Strings.T("раб.")) @AlvaFormat.Plural(DaysLeft(sprint), "day")</AlvaStatusChip>
                    </FlareStack>
                </ActionContent>
            </FlareCardHeader>
            <FlareCardContent>
                <FlareGrid MinColumnWidth="min(100%,20rem)">
                    <FlareStack Gap="FlareSpacing.Small">
                        <FlareStack Row Align="FlareAlignItems.Center" Gap="FlareSpacing.XSmall">
                            <FlareIconView Value="@MaterialDesign3Icons.Regular.Schedule" Size="16px" />
                            <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@AlvaFormat.Period(sprint.StartDate, sprint.EndDate) (@AlvaFormat.WorkDays(sprint.StartDate, sprint.EndDate) @(Strings.T("раб. дней")))</FlareText>
                        </FlareStack>
                        <FlareStack Row Wrap Align="FlareAlignItems.Center" Gap="FlareSpacing.XSmall">
                            <FlareText Typo="TypographyScale.LabelMedium" Color="FlareColor.OnSurfaceVariant">@(Strings.T("Проекты:"))</FlareText>
                            @foreach (var (name, share) in ProjectShares(tasks, sprint))
                            {
                                <FlareChip Size="ChipSize.Sm" Variant="ChipVariant.Filled" Label="@($"{name} ({share}%)")" />
                            }
                        </FlareStack>
                        <FlareStack Row Wrap Align="FlareAlignItems.Center" Gap="FlareSpacing.XSmall">
                            <FlareText Typo="TypographyScale.LabelMedium" Color="FlareColor.OnSurfaceVariant">@(Strings.T("Команда")) (@PeopleOf(tasks).Length):</FlareText>
                            <FlareAvatarGroup Max="8" Size="AvatarSize.Xs">
                                @foreach (var person in PeopleOf(tasks))
                                {
                                    <FlareAvatar Text="@AlvaFormat.Initials(person.Name)" Alt="@person.Name" Size="AvatarSize.Xs" />
                                }
                            </FlareAvatarGroup>
                            @if (tasks.Count(t => Assignees.Person(t, _actors) is null) is > 0 and var unassigned)
                            {
                                <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.Warning">@(Strings.T("Без исполнителя:")) @unassigned</FlareText>
                            }
                        </FlareStack>
                        @if (risks.Length > 0)
                        {
                            <FlareAlert Severity="AlertSeverity.Warning" Title="@($"{risks.Length} {AlvaFormat.Plural(risks.Length, "task")} {Strings.T("под риском срыва срока:")}")">
                                <FlareStack Gap="FlareSpacing.XSmall">
                                    @foreach (var risk in risks.Take(3))
                                    {
                                        var task = TaskOf(risk.TaskId);
                                        <FlareStack Gap="FlareSpacing.None">
                                            <FlareLink Href="@($"tasks/{risk.TaskId}")">@risk.Title</FlareLink>
                                            <FlareStack Row Wrap Gap="FlareSpacing.XSmall">
                                                @foreach (var reason in risk.Reasons)
                                                {
                                                    <FlareLink Href="@RiskActions.Href(reason, risk.TaskId, task?.ResolvedPersonId)" title="@RiskActions.Label(reason, task?.ResolvedPersonId)">@ReasonText.Describe(reason)</FlareLink>
                                                }
                                            </FlareStack>
                                        </FlareStack>
                                    }
                                    @if (risks.Length > 3) { <FlareLink Href="analytics">@(Strings.T("Ещё")) @(risks.Length - 3)</FlareLink> }
                                </FlareStack>
                            </FlareAlert>
                        }
                    </FlareStack>
                    <FlareCard Variant="CardVariant.Filled">
                        <FlareCardContent>
                            <FlareStack Gap="FlareSpacing.Small">
                                <FlareStack Row StretchFirst Align="FlareAlignItems.Baseline">
                                    <FlareText Typo="TypographyScale.LabelMedium" Color="FlareColor.OnSurfaceVariant">@(Strings.T("Прогресс выполнения спринта"))</FlareText>
                                    <FlareText Typo="TypographyScale.TitleMedium" Color="FlareColor.Primary">@Percent(done, total)%</FlareText>
                                </FlareStack>
                                <FlareMeter Size="TrackSize.Sm" aria-label="@string.Format(Strings.T("Закрыто {0} ч, в работе {1} ч из {2} ч"), AlvaFormat.Hours(done), AlvaFormat.Hours(inWork), AlvaFormat.Hours(total))">
                                    <FlareMeterSegment Value="@((double)Math.Max(0, done))" Color="FlareColor.Primary" />
                                    <FlareMeterSegment Value="@((double)Math.Max(0, inWork))" Color="FlareColor.Secondary" />
                                    <FlareMeterSegment Value="@((double)Math.Max(0, total - done - inWork))" Color="FlareColor.OnSurfaceVariant" />
                                </FlareMeter>
                                <FlareStack Row Wrap Gap="FlareSpacing.XSmall">
                                    <FlareChip Size="ChipSize.Sm" Variant="ChipVariant.Filled" Color="FlareColor.Primary" Label="@($"{Strings.T("Закрыто:")} {AlvaFormat.Hours(done)} {Strings.T("ч")}")" />
                                    <FlareChip Size="ChipSize.Sm" Variant="ChipVariant.Filled" Color="FlareColor.Secondary" Label="@($"{Strings.T("В работе:")} {AlvaFormat.Hours(inWork)} {Strings.T("ч")}")" />
                                    <FlareChip Size="ChipSize.Sm" Variant="ChipVariant.Filled" Label="@($"{Strings.T("Остаток:")} {AlvaFormat.Hours(total - done)} {Strings.T("ч")} / {AlvaFormat.Hours(total)} {Strings.T("ч")}")" />
                                </FlareStack>
                                <FlareStack Row Wrap Gap="FlareSpacing.XSmall">
                                    <FlareChip Size="ChipSize.Sm" Variant="ChipVariant.Filled" Label="@($"{Strings.T("Всего")} {tasks.Length}")" />
                                    <FlareChip Size="ChipSize.Sm" Variant="ChipVariant.Filled" Color="FlareColor.Info" Label="@($"{Strings.T("В работе")} {tasks.Count(t => t.Status == "InProgress")}")" />
                                    <FlareChip Size="ChipSize.Sm" Variant="ChipVariant.Filled" Color="FlareColor.Success" Label="@($"{Strings.T("Готово")} {tasks.Count(t => t.Status == "Done")}")" />
                                    <FlareChip Size="ChipSize.Sm" Variant="ChipVariant.Filled" Color="FlareColor.Error" Label="@($"{Strings.T("Риск")} {risks.Length}")" />
                                </FlareStack>
                            </FlareStack>
                        </FlareCardContent>
                    </FlareCard>
                </FlareGrid>
            </FlareCardContent>
            <FlareCardActions Align="CardActionsAlign.End">
                <FlareButton Href="@($"sprints/{sprint.Id}")" Size="ButtonSize.Sm">
                    <ChildContent>@(Strings.T("Перейти в спринт"))</ChildContent>
                    <TrailingIcon><FlareIconView Value="@MaterialDesign3Icons.Regular.ArrowForward" Size="16px" /></TrailingIcon>
                </FlareButton>
                <FlareButton Href="@($"sprints/{sprint.Id}/plan")" Variant="ButtonVariant.Outlined" Size="ButtonSize.Sm">
                    <LeadingIcon><FlareIconView Value="@MaterialDesign3Icons.Regular.Balance" Size="16px" /></LeadingIcon>
                    <ChildContent>@(Strings.T("Сбалансировать"))</ChildContent>
                </FlareButton>
            </FlareCardActions>
        </FlareCard>
    }
</FlareSection>
}

@if (Show("Planned") && Visible("Planned").Any())
{
<FlareSection Title="@($"{Strings.T("Запланированные спринты")} ({Visible("Planned").Count()})")">
    <FlareGrid MinColumnWidth="min(100%,22rem)">
        @foreach (var sprint in Visible("Planned"))
        {
            var tasks = TasksOf(sprint);
            var (_, total) = Hours(sprint);
            var available = _capacity.TryGetValue(sprint.Id, out var plannedCap) ? plannedCap.Available : 0;
            <FlareCard Variant="CardVariant.Outlined" @key="sprint.Id">
                <FlareCardHeader Title="@sprint.Name" Subtitle="@(string.IsNullOrWhiteSpace(sprint.Goal) ? null : sprint.Goal)">
                    <ActionContent>
                        @if (available > 0) { <AlvaStatusChip Tone="@(total > available ? AlvaTone.Critical : AlvaTone.Ok)">@(Strings.T("Набрано")) @Percent(total, available)%</AlvaStatusChip> }
                    </ActionContent>
                </FlareCardHeader>
                <FlareCardContent>
                    <FlareStack Gap="FlareSpacing.Small">
                        <FlareStack Row Align="FlareAlignItems.Center" Gap="FlareSpacing.XSmall">
                            <FlareIconView Value="@MaterialDesign3Icons.Regular.Event" Size="16px" />
                            <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@AlvaFormat.Period(sprint.StartDate, sprint.EndDate)</FlareText>
                        </FlareStack>
                        <FlareStack Row Wrap StretchFirst Align="FlareAlignItems.Baseline" Gap="FlareSpacing.XSmall">
                            <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@(Strings.T("Баланс ёмкости команды:"))</FlareText>
                            <FlareText Typo="TypographyScale.BodySmall">@AlvaFormat.Hours(total) @(Strings.T("ч")) @(Strings.T("набрано")) / @(available > 0 ? $"{AlvaFormat.Hours(available)} {Strings.T("ч")} {Strings.T("доступно")}" : Strings.T("график не задан"))</FlareText>
                        </FlareStack>
                        <FlareProgressLinear Value="@(available > 0 ? Math.Min(100, Percent(total, available)) : 0)" aria-label="@(Strings.T("Набрано от доступного"))" />
                        <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@tasks.Length @AlvaFormat.Plural(tasks.Length, "taskIncluded")</FlareText>
                    </FlareStack>
                </FlareCardContent>
                <FlareCardActions Align="CardActionsAlign.Between">
                    <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@(Strings.T("Старт через")) @Math.Max(0, sprint.StartDate.DayNumber - Today.DayNumber) @(Strings.T("дн."))</FlareText>
                    <FlareButton Href="@($"sprints/{sprint.Id}/plan")" Size="ButtonSize.Sm">
                        <ChildContent>@(Strings.T("Открыть планирование"))</ChildContent>
                        <TrailingIcon><FlareIconView Value="@MaterialDesign3Icons.Regular.ArrowForward" Size="16px" /></TrailingIcon>
                    </FlareButton>
                </FlareCardActions>
            </FlareCard>
        }
    </FlareGrid>
</FlareSection>
}

@if (Show("Completed") && Visible("Completed").Any())
{
<FlareSection Title="@(Strings.T("Завершённые спринты"))">
    <FlareCard Variant="CardVariant.Outlined">
        <FlareCardContent>
            <FlareDataGrid TItem="SprintModel" Items="VisibleCompleted" Height="auto" Dense="true" RowKey="s => s!.Id">
                <Columns>
                    <FlareColumn TItem="SprintModel" Title="@(Strings.T("Спринт / период / цель"))" Sortable Field="s => s!.Name" SortKey="name">
                        <Template Context="sprint">
                            <FlareStack Gap="FlareSpacing.None">
                                <FlareLink Href="@($"sprints/{sprint!.Id}")">@sprint.Name</FlareLink>
                                <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@AlvaFormat.Period(sprint.StartDate, sprint.EndDate)</FlareText>
                                @if (!string.IsNullOrWhiteSpace(sprint.Goal))
                                {
                                    <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@sprint.Goal</FlareText>
                                }
                            </FlareStack>
                        </Template>
                    </FlareColumn>
                    <FlareColumn TItem="SprintModel" Title="@(Strings.T("Статус закрытия"))" Sortable Field="s => OpenHours(s!)" SortKey="open">
                        <Template Context="sprint">
                            <FlareStack Gap="FlareSpacing.XSmall">
                                @if (OpenHours(sprint!) <= 0) { <AlvaStatusChip Tone="AlvaTone.Ok">@(Strings.T("Завершён"))</AlvaStatusChip> }
                                else { <AlvaStatusChip Tone="AlvaTone.Warning">@(Strings.T("Не закрыто")) @AlvaFormat.Hours(OpenHours(sprint!)) @(Strings.T("ч"))</AlvaStatusChip> }
                                @if (sprint.Commitment is { } committed && sprint.Result is { } closed)
                                {
                                    <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@(Strings.T("Обязательство")) @AlvaFormat.Hours(committed.Hours) @(Strings.T("ч")) → @(Strings.T("итог")) @AlvaFormat.Hours(closed.Hours) @(Strings.T("ч"))</FlareText>
                                }
                            </FlareStack>
                        </Template>
                    </FlareColumn>
                    <FlareColumn TItem="SprintModel" Title="@(Strings.T("Выработка"))" Sortable Field="s => Hours(s!).Done" SortKey="done">
                        <Template Context="sprint">
                            <FlareStack Gap="FlareSpacing.XSmall">
                                <FlareText Typo="TypographyScale.BodySmall">@AlvaFormat.Hours(Hours(sprint!).Done) @(Strings.T("ч")) / @AlvaFormat.Hours(Hours(sprint!).Total) @(Strings.T("ч"))</FlareText>
                                <FlareProgressLinear Value="@Percent(Hours(sprint!).Done, Hours(sprint!).Total)" aria-label="@(Strings.T("Выработка"))" />
                            </FlareStack>
                        </Template>
                    </FlareColumn>
                    <FlareColumn TItem="SprintModel" Title="@(Strings.T("Темп"))" Sortable Field="s => WeeklyPace(s!)" SortKey="pace">
                        <Template Context="sprint">
                            <FlareText Typo="TypographyScale.BodySmall"><b>@AlvaFormat.Hours(WeeklyPace(sprint!))</b> @(Strings.T("ч / нед"))</FlareText>
                        </Template>
                    </FlareColumn>
                </Columns>
            </FlareDataGrid>
        </FlareCardContent>
    </FlareCard>
</FlareSection>
}
}

@code {
    [Parameter] public SprintModel[] Sprints { get; set; } = [];
    [Parameter] public TaskModel[] Tasks { get; set; } = [];

    private RiskDto[] _risks = [];
    private ActorModel[] _actors = [];
    private Dictionary<Guid, (decimal Available, decimal Allocated, int Overloaded, int People)> _capacity = [];
    private int _filter;
    private string? _search, _error;
    private bool _loaded;
    private Guid[] _loadedFor = [];

    private static DateOnly Today => DateOnly.FromDateTime(DateTime.Today);
    private SprintModel? Active => Sprints.Where(s => s.Status == "Active").OrderBy(s => s.StartDate).FirstOrDefault();
    private IEnumerable<SprintModel> Planned => Sprints.Where(s => s.Status == "Planned").OrderBy(s => s.StartDate);
    private int Count(string status) => Sprints.Count(s => s.Status == status);
    private string FilterStatus => _filter switch { 1 => "Active", 2 => "Planned", _ => "Completed" };
    private bool Show(string status) => _filter == 0 || (_filter, status) is (1, "Active") or (2, "Planned") or (3, "Completed");
    private IEnumerable<SprintModel> Visible(string status) => Sprints
        .Where(s => s.Status == status && (string.IsNullOrWhiteSpace(_search) || s.Name.Contains(_search, StringComparison.OrdinalIgnoreCase)))
        .OrderBy(s => status == "Completed" ? -s.EndDate.DayNumber : s.StartDate.DayNumber);
    private IEnumerable<SprintModel> VisibleCompleted => Visible("Completed");
    private TaskModel[] TasksOf(SprintModel sprint) => Tasks.Where(t => t.SprintIds.Contains(sprint.Id) && t.Status != "Cancelled").ToArray();
    private TaskModel? TaskOf(Guid id) => Tasks.FirstOrDefault(t => t.Id == id);
    private RiskDto[] RisksOf(SprintModel sprint) => _risks.Where(r => TasksOf(sprint).Any(t => t.Id == r.TaskId)).ToArray();

    /// <summary>Закрытые и все оценённые часы спринта — доли задач, которые приходятся на него.</summary>
    private (decimal Done, decimal Total) Hours(SprintModel sprint)
    {
        if (sprint.Status == "Completed" && sprint.Result is { } result) return (result.DoneHours, result.Hours);
        var tasks = TasksOf(sprint);
        return (SprintHours.Sum(tasks.Where(t => t.Status == "Done"), sprint), SprintHours.Sum(tasks, sprint));
    }

    private static int Percent(decimal part, decimal whole) => whole <= 0 ? 0 : (int)Math.Round(part / whole * 100);

    /// <summary>Остаток на момент закрытия: поздние правки задач итог закрытого спринта не меняют.</summary>
    private decimal OpenHours(SprintModel sprint) => sprint.Result is { } result
        ? result.Hours - result.DoneHours
        : SprintHours.Sum(TasksOf(sprint).Where(t => t.Status is not ("Done" or "Cancelled")), sprint);
    private static int DayOf(SprintModel s) => AlvaFormat.SprintDay(s.StartDate, s.EndDate, Today);
    private static int DaysLeft(SprintModel s) => AlvaFormat.SprintDaysLeft(s.StartDate, s.EndDate, Today);
    private decimal WeeklyPace(SprintModel s) => Hours(s).Done / Math.Max(1m, (s.EndDate.DayNumber - s.StartDate.DayNumber + 1) / 7m);

    /// <summary>Средний темп последних трёх завершённых спринтов и изменение к предыдущему, %.</summary>
    private (decimal Current, int? Trend, int Count)? Velocity
    {
        get
        {
            var closed = Sprints.Where(s => s.Status == "Completed").OrderByDescending(s => s.EndDate).Take(3).ToArray();
            if (closed.Length == 0) return null;
            var current = closed.Average(WeeklyPace);
            int? trend = closed.Length > 1 && WeeklyPace(closed[1]) > 0 ? (int)Math.Round((WeeklyPace(closed[0]) / WeeklyPace(closed[1]) - 1) * 100) : null;
            return (current, trend, closed.Length);
        }
    }

    private IEnumerable<(string Name, int Share)> ProjectShares(TaskModel[] tasks, SprintModel sprint)
    {
        var total = SprintHours.Sum(tasks, sprint);
        return tasks.GroupBy(t => t.ProjectId)
            .Select(g => (Name: g.Key is null ? Strings.T("Текучка") : _projects.FirstOrDefault(p => p.Id == g.Key)?.Name ?? Strings.T("Проект"), Share: Percent(SprintHours.Sum(g, sprint), total)))
            .OrderByDescending(x => x.Share);
    }

    private ProjectModel[] _projects = [];

    private ActorModel[] PeopleOf(TaskModel[] tasks) => _actors
        .Where(a => a.Kind == "Person" && tasks.Any(t => t.ResolvedPersonId == a.Id || t.AssignmentTargetId == a.Id)).ToArray();

    protected override async Task OnParametersSetAsync()
    {
        var open = Sprints.Where(s => s.Status != "Completed").Select(s => s.Id).OrderBy(x => x).ToArray();
        if (open.SequenceEqual(_loadedFor) && _actors.Length > 0) { _loaded = true; return; }
        try
        {
            _risks = await Session.Get<RiskDto[]>(Session.TeamPath("risks"));
            _actors = await Session.Get<ActorModel[]>(Session.TeamPath("actors"));
            _projects = await Session.Get<ProjectModel[]>(Session.TeamPath("projects"));
            foreach (var sprint in Sprints.Where(s => s.Status != "Completed"))
            {
                var rows = await Session.Get<CapacityDto[]>(Session.TeamPath($"capacity?from={sprint.StartDate:yyyy-MM-dd}&to={sprint.EndDate:yyyy-MM-dd}"));
                var people = rows.GroupBy(r => r.ActorId).Select(g => (Available: g.Sum(r => r.AvailableHours), Allocated: g.Sum(r => r.AllocatedHours))).ToArray();
                _capacity[sprint.Id] = (people.Sum(p => p.Available), people.Sum(p => p.Allocated), people.Count(p => p.Allocated > p.Available), people.Length);
            }
            _loadedFor = open;
        }
        catch (Exception e) when (e is HttpRequestException or InvalidOperationException or NotSupportedException) { _error = PageFeedback.Describe(e); }
        finally { _loaded = true; }
    }
}
