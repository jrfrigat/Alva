@using Flare.Components.Gantt
@* Проекция 1 (макет p6_2d): дерево работ с окнами задач, сроками и связями. Кладётся внутрь FlareGantt —
   отдельно на «Гантте по задачам» и над людьми в 2D-режиме. *@
<FlareGanttPanel TRow="TaskModel" TItem="TaskModel" Rows="@Roots" RowKey="t => GanttData.Key(t.Id)" RowChildren="Children"
                 RowClass="RowClass" Items="@Data.Tasks" ItemKey="t => GanttData.Key(t.Id)" ItemRow="t => GanttData.Key(t.Id)"
                 ItemSpan="Data.Span" ItemCover="Data.Cover" ItemKind="Data.Kind" ItemSegments="Data.Segments" ItemLabel="t => t.Title" ItemTitle="Data.Title"
                 Links="@Data.Links().ToArray()" LinkTypes="@Types" ShowCriticalPath="Critical" RollupParents="true"
                 Markers="@DeadlineMarkers" Editable="true" AllowRowChange="false" OnChange="OnChange" OnLinkCreate="OnLinkCreate"
                 OnLinkRejected="OnLinkRejected" OnItemClick="OnItemClick" Header="Header" DropGroup="@DropGroup" DropAccepts="DropAccepts"
                 ItemDropGroup="@ItemDropGroup" ItemDropAccepts="ItemDropAccepts" Suggested="Suggested" AriaLabel="@(Strings.T("Задачи во времени"))">
    <RowHeader Context="task">
        @if (DragRows)
        {
            <FlareDraggable Payload="@(new TaskDrag(task.Id))" Class="alva-gantt-row alva-gantt-row--draggable">@RowContent(task)</FlareDraggable>
        }
        else
        {
            <div class="alva-gantt-row">@RowContent(task)</div>
        }
    </RowHeader>
</FlareGanttPanel>

@code {
    [Parameter, EditorRequired] public GanttData Data { get; set; } = null!;

    /// <summary>Спринт, задачи которого (и их предки) показываются; null — все задачи.</summary>
    [Parameter] public Guid? SprintId { get; set; }

    /// <summary>Несколько спринтов вместо одного — доска планирования показывает все спринты своей оси.</summary>
    [Parameter] public IReadOnlyCollection<Guid>? SprintIds { get; set; }

    [Parameter] public IReadOnlyCollection<GanttLinkType>? Types { get; set; }
    [Parameter] public bool Critical { get; set; }
    [Parameter] public RenderFragment? Header { get; set; }
    [Parameter] public EventCallback<GanttChangeEventArgs> OnChange { get; set; }
    [Parameter] public EventCallback<GanttLinkEventArgs> OnLinkCreate { get; set; }
    [Parameter] public EventCallback<GanttLinkRejectedEventArgs> OnLinkRejected { get; set; }

    /// <summary>Клик по полосе задачи — страница открывает панель задачи. Клик после перетаскивания пакет
    /// не считает кликом, поэтому сюда он не попадает.</summary>
    [Parameter] public EventCallback<TaskModel> OnItemClick { get; set; }
    [Parameter] public string? DropGroup { get; set; }
    [Parameter] public Func<object?, bool>? DropAccepts { get; set; }
    [Parameter] public string? ItemDropGroup { get; set; }
    [Parameter] public Func<object?, bool>? ItemDropAccepts { get; set; }

    /// <summary>Предложенные даты задач — призрачные полосы поверх плана.</summary>
    [Parameter] public IEnumerable<GanttChange>? Suggested { get; set; }

    /// <summary>Шапки строк можно перетащить (TaskDrag) — нужен внешний FlareDragContext.</summary>
    [Parameter] public bool DragRows { get; set; }

    /// <summary>Действия в шапке строки задачи, например «вернуть в бэклог».</summary>
    [Parameter] public RenderFragment<TaskModel>? RowActions { get; set; }

    private RenderFragment RowContent(TaskModel task) => __builder =>
    {
        <span class="alva-gantt-row__body">
            <a class="alva-gantt-row__title" href="tasks/@task.Id" title="@task.Title">@task.Title</a>
            @if (task.DatesFixed)
            {
                <span class="alva-gantt-row__fixed" role="img" aria-label="@FixedLabel" title="@FixedLabel">
                    <FlareIconView Value="@MaterialDesign3Icons.Regular.Lock" Size="14px" />
                </span>
            }
            <span class="alva-gantt-row__meta">@Data.Assignee(task) · @AlvaFormat.Hours(task.EffectiveEstimateHours) ч</span>
            <SkillMatch Required="task.RequiredSkills" Person="@(Data.Actor(task.ResolvedPersonId ?? task.AssignmentTargetId))" />
        </span>
        @if (RowActions is not null) { @RowActions(task) }
    };

    private IEnumerable<TaskModel> Roots => Visible(Data.Roots);

    private IEnumerable<TaskModel>? Children(TaskModel task) => Visible(Data.ChildrenOf(task));

    // В режиме спринтов показываются задачи этих спринтов и их предки, чтобы дерево не рвалось.
    private IEnumerable<TaskModel> Visible(IEnumerable<TaskModel> tasks)
    {
        var ordered = tasks.OrderBy(t => t.Order).ThenBy(t => t.Title);
        IReadOnlyCollection<Guid>? sprints = SprintIds ?? (SprintId is { } one ? [one] : null);
        if (sprints is null) return ordered;
        var shown = Data.InSprintsWithAncestors(sprints);
        return ordered.Where(t => shown.Contains(t.Id));
    }

    private static string FixedLabel => Strings.T("Даты зафиксированы: задача не переносится");

    private static string? RowClass(TaskModel task)
    {
        var classes = new List<string>(2);
        if (GanttData.IsClosed(task)) classes.Add("alva-gantt-row--closed");
        if (task.DatesFixed) classes.Add("alva-gantt-row--fixed");
        return classes.Count == 0 ? null : string.Join(' ', classes);
    }

    private IEnumerable<GanttMarker> DeadlineMarkers => Data.Tasks
        .Where(t => !GanttData.IsClosed(t) && (t.EffectiveDeadline ?? t.Deadline) is not null)
        .Select(t => new GanttMarker("deadline", (t.EffectiveDeadline ?? t.Deadline)!.Value.AddDays(1).ToDateTime(TimeOnly.MinValue),
            GanttData.Key(t.Id), Strings.T("Срок"), GanttData.Key(t.Id)));
}
