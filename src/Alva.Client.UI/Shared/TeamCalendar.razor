@* Командный календарь по макету p15: месяц сеткой с доступными часами команды или выбранного
   сотрудника, отпусками, встречами и днями перегрузки. *@
@inject AlvaSession Session
@inject NavigationManager Navigation
<AlvaPageHeader Category="@(AlvaStrings.Capacity_CapacityPeopleSchedules)" Title="@(AlvaStrings.Capacity_PeopleSchedulesAndTeamAvailability)" Description="@(AlvaStrings.Capacity_EveryPersonSWorkingHoursVacationsAndRecurringMeetingsAndHowMuchCleanTime_c5193e)">
    <Actions>
        <FlareIconButton Icon="@MaterialDesign3Icons.Regular.ChevronLeft" Size="ButtonSize.Sm" AriaLabel="@(AlvaStrings.Capacity_PreviousMonth)" OnClick="() => Shift(-1)" />
        <FlareChip Variant="ChipVariant.Filled" Color="FlareColor.Primary" Size="ChipSize.Sm">@_month.ToString("MMMM yyyy")</FlareChip>
        <FlareIconButton Icon="@MaterialDesign3Icons.Regular.ChevronRight" Size="ButtonSize.Sm" AriaLabel="@(AlvaStrings.Capacity_NextMonth)" OnClick="() => Shift(1)" />
        <FlareButton Variant="ButtonVariant.Text" Size="ButtonSize.Sm" OnClick="ThisMonth">@(AlvaStrings.Gantt_Today)</FlareButton>
        @if (Focus is { } f) { <FlareButton Href="@($"capacity/{f.Id}/schedule")" Size="ButtonSize.Sm"><LeadingIcon><FlareIconView Value="@MaterialDesign3Icons.Regular.EventBusy" Size="18px" /></LeadingIcon><ChildContent>@(AlvaStrings.Capacity_AbsenceVacation)</ChildContent></FlareButton> }
    </Actions>
</AlvaPageHeader>
<PageFeedback Error="@_error" Loading="_busy" OnRetry="Load" />
@if (!_loaded) { <LoadingSkeleton Height="20rem" /> }
else
{
<FlareGrid MinColumnWidth="min(100%,15rem)">
    <FlareStat Label="@(AlvaStrings.Capacity_ActiveTeamMembers)" Value="@People.Length.ToString()" Unit="@AlvaFormat.Plural(People.Length, "person")" Icon="@MaterialDesign3Icons.Regular.Badge" Caption="@(AlvaStrings.Capacity_WithAScheduleThisMonth)" />
    <FlareStat Label="@(AlvaStrings.Capacity_PlannedAbsences)" Value="@MonthAbsences.Count().ToString()" Unit="@($"−{AlvaFormat.Hours(AbsenceHours)} {AlvaStrings.Sprint_HoursShort}")" Icon="@MaterialDesign3Icons.Regular.BeachAccess"
               Caption="@(MonthAbsences.Any() && MonthAbsences.First() is var a ? $"{a.Name}: {a.Ex.From:d}–{a.Ex.To:d MMM}" : AlvaStrings.Capacity_NoVacationsThisMonth)" />
    <FlareStat Label="@(AlvaStrings.Capacity_RecurringMeetings)" Value="@AlvaFormat.Hours(MeetingsPerPerson)" Unit="@(AlvaStrings.Capacity_HWeekPerson)" Icon="@MaterialDesign3Icons.Regular.Groups" Caption="@(AlvaStrings.Capacity_DeductionsFromFocusTime)" />
    <FlareStat Label="@(AlvaStrings.Capacity_EffectiveTeamFund)" Value="@AlvaFormat.Hours(Effective)" Unit="@(AlvaStrings.Capacity_CleanHoursLabel)" Icon="@MaterialDesign3Icons.Regular.Speed"
               Caption="@($"{AlvaStrings.Sprint_OutOf} {AlvaFormat.Hours(NominalMonth)} {AlvaStrings.Capacity_HNominal} ({Pct(Effective, NominalMonth)}%)")" />
</FlareGrid>

<div class="alva-capacity-bar">
    <FlareText Typo="TypographyScale.LabelMedium" Color="FlareColor.OnSurfaceVariant"><FlareIconView Value="@MaterialDesign3Icons.Regular.FilterList" Size="16px" /> @(AlvaStrings.Capacity_EngineerFilterLabel)</FlareText>
    <FlareChipGroup SelectedValues="SelectedPeople" SelectedValuesChanged="SetPersonFilter" AriaLabel="@(AlvaStrings.Capacity_EngineerFilter)">
        <FlareChip Value="" Label="@($"{AlvaStrings.Sprint_All} ({People.Length})")" />
        @foreach (var person in People)
        {
            <FlareChip Value="@person.Id.ToString()">
                <AvatarContent><FlareAvatar Text="@AlvaFormat.Initials(person.Name)" Alt="@person.Name" Size="AvatarSize.Xs" /></AvatarContent>
                <ChildContent>@person.Name</ChildContent>
            </FlareChip>
        }
    </FlareChipGroup>
    <div class="alva-heat-legend alva-heat-legend--inline">
        <span><i class="alva-heat--balance"></i>@(AlvaStrings.Capacity_WorkingDay)</span><span><i class="alva-heat--absence"></i>@(AlvaStrings.Capacity_VacationAbsence)</span><span><i class="alva-heat--critical"></i>@(AlvaStrings.Common_OverloadLabel)</span><span><i class="alva-heat--empty"></i>@(AlvaStrings.Capacity_DayOff)</span>
    </div>
</div>

<div class="alva-calendar-layout">
    <FlareCard Variant="CardVariant.Outlined" Class="alva-month-grid">
        <FlareCardHeader Title="@(AlvaStrings.Capacity_MonthCalendar)" />
        <FlareCardContent>
        <div class="alva-month-grid__head">@foreach (var d in WeekDays) { <span>@d</span> }</div>
        <div class="alva-month-grid__body">
            @foreach (var date in Cells)
            {
                var inMonth = date.Month == _month.Month;
                var rows = RowsOn(date);
                var avail = rows.Sum(r => r.AvailableHours);
                var alloc = rows.Sum(r => r.AllocatedHours);
                var overloaded = rows.Where(r => r.AllocatedHours > r.AvailableHours).ToArray();
                var absent = AbsentOn(date).ToArray();
                var weekend = !rows.Any(r => r.AvailableHours > 0) && !absent.Any();
                var sprintStart = _sprints.FirstOrDefault(s => s.StartDate == date);
                var sprintEnd = _sprints.FirstOrDefault(s => s.EndDate == date);
                var state = !inMonth ? "out" : weekend ? "off" : overloaded.Length > 0 ? "over" : absent.Length > 0 ? "absence" : "work";
                <div class="alva-day alva-day--@state @(date == Today ? "alva-day--today" : "")" @key="date">
                    <div class="alva-day__top"><b class="alva-num">@date.Day</b>@if (sprintStart is not null) { <span class="alva-day__flag"><FlareIconView Value="@MaterialDesign3Icons.Regular.Flag" Size="12px" /> @(AlvaStrings.Capacity_Start)</span> } else if (sprintEnd is not null) { <span class="alva-day__flag">@(AlvaStrings.Capacity_Finish)</span> }</div>
                    @if (state == "off") { <span class="alva-day__note">@(AlvaStrings.Capacity_DayOff)</span> }
                    else if (inMonth)
                    {
                        @if (sprintStart is not null) { <span class="alva-day__event">@sprintStart.Name</span> }
                        @foreach (var away in absent.Take(2)) { <span class="alva-day__event alva-day__event--absence"><FlareIconView Value="@MaterialDesign3Icons.Regular.BeachAccess" Size="12px" /> @Short(away.Name)</span> }
                        @foreach (var o in overloaded.Take(1)) { <span class="alva-day__event alva-day__event--over"><FlareIconView Value="@MaterialDesign3Icons.Regular.Warning" Size="12px" /> @Short(o.ActorName) @Pct(o.AllocatedHours, o.AvailableHours)%</span> }
                        <span class="alva-day__hours alva-num"><b>@AlvaFormat.Hours(avail) @(AlvaStrings.Sprint_HoursShort)</b> @(overloaded.Length > 0 ? string.Format(AlvaStrings.Common_DeficitH, AlvaFormat.Hours(overloaded.Sum(o => o.AllocatedHours - o.AvailableHours))) : alloc > 0 ? $"{AlvaStrings.Common_BusyLower} {AlvaFormat.Hours(alloc)}" : AlvaStrings.Common_Available)</span>
                    }
                </div>
            }
        </div>
        </FlareCardContent>
    </FlareCard>
    <aside class="alva-calendar-side">
        @if (Focus is { } focused)
        {
            var mine = _rows.Where(r => r.ActorId == focused.Id && r.Date.Month == _month.Month).ToArray();
            <FlareCard Variant="CardVariant.Outlined">
                <FlareCardHeader Title="@focused.Name" Subtitle="@string.Join(" / ", _actors.Where(a => focused.RoleIds.Contains(a.Id)).Select(a => a.Name).DefaultIfEmpty(AlvaStrings.Capacity_TeamMember))">
                    <AvatarContent><FlareAvatar Text="@AlvaFormat.Initials(focused.Name)" Alt="@focused.Name" Size="AvatarSize.Sm" /></AvatarContent>
                </FlareCardHeader>
                <FlareCardContent>
                    <FlareStack Gap="FlareSpacing.Medium">
                        <FlareList TItem="PersonStat" Dense>
                            @foreach (var stat in StatsOf(focused, mine))
                            {
                                <FlareListItem Primary="@stat.Label">
                                    <Trailing><FlareText Typo="TypographyScale.BodySmall" Color="@stat.Color"><b>@stat.Value</b></FlareText></Trailing>
                                </FlareListItem>
                            }
                        </FlareList>
                        <FlareStack Row Wrap>
                            <FlareButton Href="@($"capacity/{focused.Id}")" Size="ButtonSize.Sm">@(AlvaStrings.Capacity_PersonalCalendar)</FlareButton>
                            <FlareButton Href="@($"capacity/{focused.Id}/schedule")" Variant="ButtonVariant.Tonal" Size="ButtonSize.Sm">@(AlvaStrings.Common_ScheduleEditor)</FlareButton>
                        </FlareStack>
                    </FlareStack>
                </FlareCardContent>
            </FlareCard>
        }
        <FlareCard Variant="CardVariant.Outlined">
            <FlareCardHeader Title="@(AlvaStrings.Capacity_PeopleAndMonthWorkload)" />
            <FlareCardContent>
                <FlareList TItem="ActorModel" Dense>
                    @foreach (var p in People)
                    {
                        <FlareListItem @key="p.Id" OnClick="() => OpenPerson(p.Id)">
                            <Leading><FlareAvatar Text="@AlvaFormat.Initials(p.Name)" Alt="@p.Name" Size="AvatarSize.Xs" /></Leading>
                            <ChildContent>
                                <FlareStack Gap="FlareSpacing.XSmall">
                                    <FlareText Typo="TypographyScale.BodyMedium">@p.Name</FlareText>
                                    <FlareProgressLinear Value="@Math.Min(100, LoadPct(p))" Size="TrackSize.Xs" Color="@LoadColor(p)" aria-label="@string.Format(AlvaStrings.Common_Load, p.Name)" />
                                </FlareStack>
                            </ChildContent>
                            <Trailing><FlareText Typo="TypographyScale.BodySmall"><b>@LoadPct(p)%</b></FlareText></Trailing>
                        </FlareListItem>
                    }
                </FlareList>
            </FlareCardContent>
        </FlareCard>
    </aside>
</div>
}

@code {
    private static readonly string[] WeekDays = [AlvaStrings.Capacity_Monday, AlvaStrings.Capacity_Tuesday, AlvaStrings.Capacity_Wednesday, AlvaStrings.Capacity_Thursday, AlvaStrings.Capacity_Friday, AlvaStrings.Capacity_Saturday, AlvaStrings.Capacity_Sunday];
    private DateOnly _month = new(DateTime.Today.Year, DateTime.Today.Month, 1);
    private ActorModel[] _actors = [];
    private SprintModel[] _sprints = [];
    private CapacityDto[] _rows = [];
    private Dictionary<Guid, CalendarDto> _calendars = [];
    private Guid? _focus;
    private string? _error;
    private bool _busy, _loaded;

    private static DateOnly Today => DateOnly.FromDateTime(DateTime.Today);
    private DateOnly GridStart => _month.AddDays(-(((int)_month.DayOfWeek + 6) % 7));
    private IEnumerable<DateOnly> Cells => Enumerable.Range(0, (int)Math.Ceiling((_month.DayNumber - GridStart.DayNumber + DateTime.DaysInMonth(_month.Year, _month.Month)) / 7.0) * 7).Select(i => GridStart.AddDays(i));
    private ActorModel[] People => _actors.Where(a => a.Kind == "Person" && _calendars.ContainsKey(a.Id)).OrderBy(a => a.Name).ToArray();
    private ActorModel? Focus => People.FirstOrDefault(p => p.Id == _focus);
    private IEnumerable<CapacityDto> RowsOn(DateOnly d) => _rows.Where(r => r.Date == d && (_focus is null || r.ActorId == _focus));
    private IEnumerable<(string Name, CalendarExceptionDto Ex)> AbsentOn(DateOnly d) => People.Where(p => _focus is null || p.Id == _focus)
        .SelectMany(p => _calendars[p.Id].Exceptions.Where(e => d >= e.From && d <= e.To && e.AvailableHours < NominalOn(p.Id, d)).Select(e => (p.Name, e)));
    private IEnumerable<(string Name, CalendarExceptionDto Ex)> MonthAbsences => People.Where(p => _focus is null || p.Id == _focus)
        .SelectMany(p => _calendars[p.Id].Exceptions.Where(e => e.From <= _month.AddMonths(1).AddDays(-1) && e.To >= _month).Select(e => (p.Name, e)));

    private decimal NominalOn(Guid id, DateOnly d)
    {
        var c = _calendars[id];
        return d.DayOfWeek switch { DayOfWeek.Monday => c.Monday, DayOfWeek.Tuesday => c.Tuesday, DayOfWeek.Wednesday => c.Wednesday, DayOfWeek.Thursday => c.Thursday, DayOfWeek.Friday => c.Friday, DayOfWeek.Saturday => c.Saturday, _ => c.Sunday };
    }
    private IEnumerable<DateOnly> MonthDays => Enumerable.Range(0, DateTime.DaysInMonth(_month.Year, _month.Month)).Select(i => _month.AddDays(i));
    private decimal NominalOf(Guid id) => MonthDays.Sum(d => NominalOn(id, d));
    private decimal AbsenceOf(Guid id) => MonthDays.Sum(d => _calendars[id].Exceptions.Where(e => d >= e.From && d <= e.To).MinBy(e => e.AvailableHours) is { } e ? Math.Max(0, NominalOn(id, d) - e.AvailableHours) : 0);
    private decimal NominalMonth => People.Where(p => _focus is null || p.Id == _focus).Sum(p => NominalOf(p.Id));
    private decimal AbsenceHours => People.Where(p => _focus is null || p.Id == _focus).Sum(p => AbsenceOf(p.Id));
    private decimal Effective => _rows.Where(r => r.Date.Month == _month.Month && (_focus is null || r.ActorId == _focus)).Sum(r => r.AvailableHours);
    private decimal MeetingsPerPerson => People.Length == 0 ? 0 : People.Average(p => _calendars[p.Id].RecurringBlocks.Sum(b => b.Hours));
    private static int Pct(decimal part, decimal whole) => whole <= 0 ? 0 : (int)Math.Round(part / whole * 100);
    private static string Short(string name) => name.Split(' ') is [var first, var last, ..] ? $"{first[0]}. {last}" : name;

    private sealed record PersonStat(string Label, string Value, FlareColor Color);

    private IReadOnlyCollection<string> SelectedPeople => _focus is null ? [""] : [_focus.Value.ToString()];
    private void SetPersonFilter(IReadOnlyCollection<string> values) =>
        _focus = values.FirstOrDefault() is { Length: > 0 } key && Guid.TryParse(key, out var id) ? id : null;
    private void OpenPerson(Guid id) => Navigation.NavigateTo($"capacity/{id}");

    private int LoadPct(ActorModel person)
    {
        var rows = _rows.Where(r => r.ActorId == person.Id && r.Date.Month == _month.Month).ToArray();
        return Pct(rows.Sum(r => r.AllocatedHours), rows.Sum(r => r.AvailableHours));
    }

    private FlareColor LoadColor(ActorModel person) => LoadPct(person) switch
    {
        > 100 => FlareColor.Error,
        > 80 => FlareColor.Primary,
        _ => FlareColor.Success
    };

    private PersonStat[] StatsOf(ActorModel focused, CapacityDto[] mine) => [
        new(AlvaStrings.Capacity_MonthFundFromTheSchedule, $"{AlvaFormat.Hours(NominalOf(focused.Id))} {AlvaStrings.Sprint_HoursShort}", FlareColor.OnSurface),
        new(AlvaStrings.Capacity_MeetingsAndDeductions, $"−{AlvaFormat.Hours(Math.Max(0, NominalOf(focused.Id) - mine.Sum(r => r.AvailableHours) - AbsenceOf(focused.Id)))} {AlvaStrings.Sprint_HoursShort}", FlareColor.Primary),
        new(AlvaStrings.Capacity_Vacations, $"−{AlvaFormat.Hours(AbsenceOf(focused.Id))} {AlvaStrings.Sprint_HoursShort}", FlareColor.Error),
        new(AlvaStrings.Capacity_CleanCapacity, $"{AlvaFormat.Hours(mine.Sum(r => r.AvailableHours))} {AlvaStrings.Sprint_HoursShort}", FlareColor.Primary),
        new(AlvaStrings.Capacity_TasksPlanned, $"{AlvaFormat.Hours(mine.Sum(r => r.AllocatedHours))} {AlvaStrings.Sprint_HoursShort}", mine.Sum(r => r.AllocatedHours) > mine.Sum(r => r.AvailableHours) ? FlareColor.Error : FlareColor.OnSurface)
    ];

    protected override Task OnInitializedAsync() => Load();

    private Task Load() => Run(async () =>
    {
        _actors = await Session.Get<ActorModel[]>(Session.TeamPath("actors"));
        _sprints = await Session.Get<SprintModel[]>(Session.TeamPath("sprints"));
        // Праздники и встречи подкоманд действуют на их участников так же, как в расчёте ёмкости.
        var departments = _actors.Where(a => a.Kind == "Department").ToDictionary(a => a.Id, a => a.ParentId);
        var shared = new Dictionary<Guid, CalendarDto>();
        foreach (var id in departments.Keys) shared[id] = await Session.Get<CalendarDto>(Session.TeamPath($"actors/{id}/calendar"));
        foreach (var person in _actors.Where(a => a.Kind == "Person"))
        {
            var own = await Session.Get<CalendarDto>(Session.TeamPath($"actors/{person.Id}/calendar"));
            var memberOf = CapacityMath.DepartmentsWithParents(person.DepartmentIds.Append(person.ParentId ?? Guid.Empty).Where(departments.ContainsKey),
                id => departments.GetValueOrDefault(id) is { } parent && departments.ContainsKey(parent) ? parent : null);
            _calendars[person.Id] = CapacityMath.Combine(own, memberOf.Select(id => shared[id]));
        }
        await LoadMonth();
    });

    private async Task LoadMonth() =>
        _rows = await Session.Get<CapacityDto[]>(Session.TeamPath($"capacity?from={GridStart:yyyy-MM-dd}&to={GridStart.AddDays(41):yyyy-MM-dd}"));

    private Task Shift(int months) { _month = _month.AddMonths(months); return Run(LoadMonth); }
    private Task ThisMonth() { _month = new(DateTime.Today.Year, DateTime.Today.Month, 1); return Run(LoadMonth); }

    private async Task Run(Func<Task> action)
    {
        _busy = true; _error = null;
        try { await action(); }
        catch (Exception e) when (e is HttpRequestException or InvalidOperationException or NotSupportedException) { _error = PageFeedback.Describe(e); }
        finally { _busy = false; _loaded = true; }
    }
}
