@using Alva.Client.Models
@using Alva.Client.Shared

<FlareStack Gap="FlareSpacing.Medium">
    <FlareStack Gap="FlareSpacing.Small">
        <FlareText Typo="TypographyScale.LabelMedium" Color="FlareColor.OnSurfaceVariant">@(AlvaStrings.Task_PlanContext)</FlareText>
        <FlareGrid MinColumnWidth="min(100%,12rem)">
            <FlareSelect TValue="string" Label="@(AlvaStrings.Common_Status)" Items="Statuses" ItemLabel="Labels.Status" @bind-Value="Task.Status" @bind-Value:after="Notify" />
            <FlareSelect TValue="string" Label="@(AlvaStrings.Common_Priority)" Items="Labels.Priorities" ItemLabel="Labels.Priority" @bind-Value="Task.Priority" @bind-Value:after="Notify" />
            <FlareSelect TValue="Guid?" Label="@(AlvaStrings.Common_Project)" Items="Projects.Select(x => (Guid?)x.Id)" ItemLabel="ProjectName" NullOption="@(AlvaStrings.Sprint_Ongoing)" @bind-Value="Task.ProjectId" @bind-Value:after="Notify" />
            <FlareSelect TValue="Guid?" Label="@(AlvaStrings.Common_ParentTask)" ErrorText="@ParentError" Items="Tasks.Where(x => x.Id != SelfId).Select(x => (Guid?)x.Id)" ItemLabel="TaskLabel" NullOption="@(AlvaStrings.Common_RootTask)" @bind-Value="Task.ParentId" @bind-Value:after="Notify" Searchable />
        </FlareGrid>
    </FlareStack>
    <FlareStack Gap="FlareSpacing.Small">
        <FlareText Typo="TypographyScale.LabelMedium" Color="FlareColor.OnSurfaceVariant">@(AlvaStrings.Task_PlanEffort)</FlareText>
        <FlareGrid MinColumnWidth="min(100%,12rem)">
            <FlareNumericField TValue="decimal?" Label="@(AlvaStrings.Common_EstimateHours)" ErrorText="@EstimateError" @bind-Value="Task.EstimateHours" @bind-Value:after="Notify" Min="0" />
            <FlareNumericField TValue="decimal?" Label="@(AlvaStrings.Common_RemainingWorkHours)" ErrorText="@RemainingError" @bind-Value="Task.RemainingHours" @bind-Value:after="Notify" Min="0" Max="100000" HelperText="@(AlvaStrings.Common_ForWorkInProgressLeaveBlankIfRemainingWorkIsUnknown0MeansNoWorkRemains)" />
            <FlareNumericField TValue="decimal?" Label="@(AlvaStrings.Common_NoMoreThanHPerDay)" ErrorText="@LimitError" @bind-Value="Task.DailyHoursLimit" @bind-Value:after="Notify" Min="0" Max="24" HelperText="@DailyLimit.Hint(Task)" />
        </FlareGrid>
    </FlareStack>
    <FlareStack Gap="FlareSpacing.Small">
        <FlareText Typo="TypographyScale.LabelMedium" Color="FlareColor.OnSurfaceVariant">@(AlvaStrings.Task_PlanDates)</FlareText>
        <FlareGrid MinColumnWidth="min(100%,12rem)">
            <FlareDatePicker Label="@(AlvaStrings.Common_Start)" ErrorText="@StartError" @bind-Value="Task.StartDate" @bind-Value:after="Notify" Disabled="Task.DatesFixed" />
            <FlareDatePicker Label="@(AlvaStrings.Common_End)" ErrorText="@EndError" @bind-Value="Task.EndDate" @bind-Value:after="Notify" Disabled="Task.DatesFixed" />
            <FlareDatePicker Label="@(AlvaStrings.Common_Deadline)" @bind-Value="Task.Deadline" @bind-Value:after="Notify" />
        </FlareGrid>
        <FlareSwitch @bind-Value="Task.DatesFixed" @bind-Value:after="Notify" Label="@(AlvaStrings.Common_FixedDatesDoNotMove)"
                     Disabled="@(Task.StartDate is null || Task.EndDate is null)" />
        @if (!string.IsNullOrEmpty(FixedHint)) { <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@FixedHint</FlareText> }
    </FlareStack>
</FlareStack>

@code {
    private static readonly string[] Statuses = ["Backlog", "Planned", "InProgress", "Done", "Cancelled"];

    [Parameter, EditorRequired] public TaskModel Task { get; set; } = default!;
    [Parameter] public ProjectModel[] Projects { get; set; } = [];
    [Parameter] public TaskModel[] Tasks { get; set; } = [];
    [Parameter] public Guid? SelfId { get; set; }
    [Parameter] public string? ParentError { get; set; }
    [Parameter] public string? EstimateError { get; set; }
    [Parameter] public string? RemainingError { get; set; }
    [Parameter] public string? LimitError { get; set; }
    [Parameter] public string? StartError { get; set; }
    [Parameter] public string? EndError { get; set; }
    [Parameter] public string? FixedHint { get; set; }
    [Parameter] public EventCallback Changed { get; set; }

    private Task Notify() => Changed.InvokeAsync();
    private string ProjectName(Guid? id) => Projects.FirstOrDefault(x => x.Id == id)?.Name ?? AlvaStrings.Sprint_Ongoing;
    private string TaskLabel(Guid? id) => Tasks.FirstOrDefault(x => x.Id == id) is { } task ? $"{AlvaFormat.Code(task.Id)} {task.Title}" : AlvaStrings.Common_RootTask;
}
