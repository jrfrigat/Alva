@* Единый заголовок экрана Alva на FlarePageHeader: eyebrow или хлебные крошки, h1, описание, действия. *@
<FlarePageHeader Title="@Title" Description="@Description" Eyebrow="@Category" EyebrowContent="@EyebrowContent" ActionsContent="@Actions" />
@code {
    /// <summary>Основной заголовок экрана (h1).</summary>
    [Parameter, EditorRequired] public string Title { get; set; } = "";

    /// <summary>Категория над заголовком в стиле micro-label.</summary>
    [Parameter] public string? Category { get; set; }

    /// <summary>Содержимое над заголовком вместо категории — например, хлебные крошки.</summary>
    [Parameter] public RenderFragment? EyebrowContent { get; set; }

    /// <summary>Пояснение под заголовком.</summary>
    [Parameter] public string? Description { get; set; }

    /// <summary>Действия экрана (кнопки и т.п.).</summary>
    [Parameter] public RenderFragment? Actions { get; set; }
}
