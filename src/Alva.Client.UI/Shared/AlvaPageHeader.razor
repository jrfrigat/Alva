<FlarePageHeader Title="@Title" Description="@Description" Eyebrow="@Category" EyebrowContent="@EyebrowContent" ActionsContent="@Actions" />
@code {
    /// <summary>Main screen heading (h1).</summary>
    [Parameter, EditorRequired] public string Title { get; set; } = "";

    /// <summary>Category above the heading, styled as a micro-label.</summary>
    [Parameter] public string? Category { get; set; }

    /// <summary>Content above the heading instead of the category - for example, breadcrumbs.</summary>
    [Parameter] public RenderFragment? EyebrowContent { get; set; }

    /// <summary>Explanation below the heading.</summary>
    [Parameter] public string? Description { get; set; }

    /// <summary>Screen actions (buttons and the like).</summary>
    [Parameter] public RenderFragment? Actions { get; set; }
}
