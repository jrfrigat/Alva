@* Редактор рабочего графика по макету p16: часы по дням недели, повторяющиеся вычеты, отпуска и
   праздники, расчёт ёмкости и применение графика к другим сотрудникам. Для подкоманды — только общие
   вычеты и нерабочие периоды, которые действуют на всех её участников. *@
@implements IDisposable
@inject AlvaSession Session
@inject DraftGuard Drafts
<NavigationLock OnBeforeInternalNavigation="ConfirmLeave" ConfirmExternalNavigation="Dirty" />
<FlarePageHeader Title="@(IsDepartment ? string.Format(Strings.T("График подкоманды «{0}»"), Actor!.Name) : Strings.T("Редактор рабочего графика"))"
                Description="@(IsDepartment ? Strings.T("Общие нерабочие дни и повторяющиеся встречи подкоманды. Они вычитаются из ёмкости всех её участников и вложенных подкоманд поверх их личных графиков.") : $"{Strings.T("Рабочие часы, выходные, отпуска и повторяющиеся нерабочие интервалы")} {(Person is null ? "" : $"{Strings.T("для")} {Person.Name}")} {Strings.T("— с проекцией на ёмкость спринтов.")}")">
    <EyebrowContent>
        @if (IsDepartment)
        {
            <FlareBreadcrumb Items="@(new BreadcrumbItem[] { new(Strings.T("Команда"), "team"), new(Strings.T("Подкоманды"), "team/departments"), new(Actor!.Name), new(Strings.T("График подкоманды")) })" Separator="›" AriaLabel="@(Strings.T("Путь к редактору"))" />
        }
        else
        {
            <FlareBreadcrumb Items="@(new BreadcrumbItem[] { new(Strings.T("Ёмкость"), "capacity"), new(Strings.T("Графики людей"), "capacity/people"), new(Person?.Name ?? Strings.T("Сотрудник"), $"capacity/{ActorId}"), new(Strings.T("Редактор графика")) })" Separator="›" AriaLabel="@(Strings.T("Путь к редактору"))" />
        }
    </EyebrowContent>
    <ActionsContent>
        @if (!IsDepartment)
        {
            <FlareButton Variant="ButtonVariant.Tonal" Size="ButtonSize.Sm" OnClick="Reset" Disabled="@(!Dirty)"><LeadingIcon><FlareIconView Value="@MaterialDesign3Icons.Regular.Undo" Size="18px" /></LeadingIcon><ChildContent>@(Strings.T("Сбросить изменения"))</ChildContent></FlareButton>
            <FlareButton Variant="ButtonVariant.Tonal" Size="ButtonSize.Sm" OnClick="() => _applyOpen = !_applyOpen"><LeadingIcon><FlareIconView Value="@MaterialDesign3Icons.Regular.GroupAdd" Size="18px" /></LeadingIcon><ChildContent>@(Strings.T("Применить к выбранным сотрудникам"))</ChildContent></FlareButton>
            <FlareButton Size="ButtonSize.Sm" Loading="_busy" OnClick="Save" Disabled="@(!Dirty)"><LeadingIcon><FlareIconView Value="@MaterialDesign3Icons.Regular.Save" Size="18px" /></LeadingIcon><ChildContent>@(Strings.T("Сохранить график"))</ChildContent></FlareButton><EditorStatus Dirty="Dirty" Saving="_busy" />
        }
    </ActionsContent>
</FlarePageHeader>
<PageFeedback Error="@_error" OnRetry="() => LoadCalendar()" />
@if (_saved) { <FlareAlert Severity="AlertSeverity.Success" Title="@(Strings.T("График сохранён"))">@(Strings.T("Ёмкость пересчитана по новому графику."))</FlareAlert> }

@if (_applyOpen && !IsDepartment)
{
    <FlareCard Variant="CardVariant.Outlined">
        <FlareCardHeader Title="@(Strings.T("Применить недельные часы к сотрудникам"))" Subtitle="@(Strings.T("Часовой пояс и часы по дням копируются; отпуска и вычеты у каждого остаются свои."))" />
        <FlareCardContent>
            <FlareStack Gap="FlareSpacing.Medium">
                <FlareGrid MinColumnWidth="min(100%,12rem)">
                    @foreach (var person in _people.Where(p => p.Id != ActorId))
                    {
                        <FlareCheckbox TValue="bool" Value="_applyTo.Contains(person.Id)" ValueChanged="(bool on) => Toggle(person.Id, on)">@person.Name</FlareCheckbox>
                    }
                </FlareGrid>
                <FlareStack Row><FlareButton Size="ButtonSize.Sm" Loading="_busy" Disabled="@(_applyTo.Count == 0)" OnClick="Apply">@(Strings.T("Применить к")) @_applyTo.Count @AlvaFormat.Plural(_applyTo.Count, "employee")</FlareButton></FlareStack>
            </FlareStack>
        </FlareCardContent>
    </FlareCard>
}

@if (_calendar is not null)
{
<div class="alva-schedule">
    <div class="alva-schedule__main">
        @if (!IsDepartment)
        {
        <FlareCard Variant="CardVariant.Outlined">
            <FlareCardHeader Title="@($"{Strings.T("Рабочая неделя")} {Person?.Name}")" Subtitle="@(Strings.T("Базовый цикл рабочей недели и часовой пояс"))" />
            <FlareCardContent>
            <FlareStack Gap="FlareSpacing.Small">
                <FlareStack Row Wrap Align="FlareAlignItems.End" Gap="FlareSpacing.Small">
                    <FlareChip Size="ChipSize.Sm" Variant="ChipVariant.Filled" Color="FlareColor.Primary" Label="@($"{Strings.T("Недельный фонд:")} {AlvaFormat.Hours(_hours.Sum())} {Strings.T("ч")}")" />
                    <FlareTextField Label="@(Strings.T("Часовой пояс IANA"))" ErrorText="@_timeZoneError" @bind-Value="_timeZone" HelperText="@(Strings.T("Например, Europe/Moscow"))" />
                </FlareStack>
                <div class="alva-week" role="table" aria-label="@(Strings.T("Рабочие часы по дням недели"))">
                <div class="alva-week__row alva-week__row--head" role="row"><span role="columnheader">@(Strings.T("День недели"))</span><span role="columnheader">@(Strings.T("Рабочий"))</span><span role="columnheader">@(Strings.T("Часов в день"))</span><span role="columnheader">@(Strings.T("Вычеты"))</span><span role="columnheader">@(Strings.T("Чистые часы"))</span></div>
                @for (var i = 0; i < 7; i++)
                {
                    var day = i;
                    var blocks = BlocksOn(day);
                    <div class="alva-week__row @(_hours[day] == 0 ? "alva-week__row--off" : "")" role="row" @key="day">
                        <span role="cell" class="alva-week__day"><span class="alva-week__abbr">@Abbr[day]</span>@DayNames[day]</span>
                        <span role="cell" class="alva-week__cell"><span class="alva-week__label">@(Strings.T("Рабочий"))</span><FlareSwitch Value="@(_hours[day] > 0)" ValueChanged="(bool on) => _hours[day] = on ? (_lastHours[day] > 0 ? _lastHours[day] : 8) : Remember(day)" Label="@string.Format(Strings.T("{0}: рабочий день"), DayNames[day])" /></span>
                        <span role="cell" class="alva-week__cell"><span class="alva-week__label">@(Strings.T("Часов в день"))</span>@if (_hours[day] > 0) { <FlareNumericField TValue="decimal" Value="_hours[day]" ValueChanged="(decimal v) => _hours[day] = v" Min="0" Max="24" Step="0.5" Suffix="@(Strings.T("ч"))" InputAttributes="@(new Dictionary<string, object> { ["aria-label"] = string.Format(Strings.T("Часы: {0}"), DayNames[day]) })" Size="FieldSize.Sm" /> } else { <span class="alva-week__muted">@(Strings.T("Выходной день"))</span> }</span>
                        <span role="cell" class="alva-week__cell alva-num alva-week__muted"><span class="alva-week__label">@(Strings.T("Вычеты"))</span>@(blocks > 0 ? string.Format(Strings.T("−{0} ч"), AlvaFormat.Hours(blocks)) : "—")</span>
                        <span role="cell" class="alva-week__cell alva-num alva-week__net"><span class="alva-week__label">@(Strings.T("Чистые часы"))</span>@AlvaFormat.Hours(Math.Max(0, _hours[day] - blocks)) @(Strings.T("ч"))</span>
                    </div>
                }
                </div>
            </FlareStack>
            </FlareCardContent>
        </FlareCard>
        }

        <FlareCard Variant="CardVariant.Outlined">
            <FlareCardHeader Title="@(Strings.T("Повторяющиеся вычеты"))" Subtitle="@(Strings.T("Регулярные встречи и церемонии, которые исключаются из фокусного времени"))">
                <ActionContent><FlareChip Size="ChipSize.Sm" Variant="ChipVariant.Filled" Color="FlareColor.Primary" Label="@($"{Strings.T("Вычет:")} −{AlvaFormat.Hours(_calendar.RecurringBlocks.Sum(b => b.Hours))} {Strings.T("ч / нед")}")" /></ActionContent>
            </FlareCardHeader>
            <FlareCardContent>
            <FlareStack Gap="FlareSpacing.Medium">
                <FlareList TItem="RecurringBlockDto" Dense>
                    @foreach (var block in BlockList)
                    {
                        <FlareListItem @key="block.Id">
                            <Leading><FlareIconView Value="@MaterialDesign3Icons.Regular.Groups" Size="18px" /></Leading>
                            <ChildContent>
                                <FlareStack Gap="FlareSpacing.None">
                                    <FlareText Typo="TypographyScale.BodyMedium"><b>@block.Name</b></FlareText>
                                    <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@DayNames[(block.DayOfWeek + 6) % 7] · @(Strings.T("еженедельно"))</FlareText>
                                </FlareStack>
                            </ChildContent>
                            <Trailing>
                                <FlareStack Row Align="FlareAlignItems.Center" Gap="FlareSpacing.XSmall">
                                    <FlareChip Size="ChipSize.Sm" Variant="ChipVariant.Filled" Color="FlareColor.Primary" Label="@($"{AlvaFormat.Hours(block.Hours)} {Strings.T("ч/нед")}")" />
                                    <FlareIconButton Icon="@MaterialDesign3Icons.Regular.Delete" Size="ButtonSize.Sm" Tooltip="@(Strings.T("Удалить вычет"))" AriaLabel="@string.Format(Strings.T("Удалить вычет «{0}»"), block.Name)" OnClick="() => DeleteBlock(block.Id)" />
                                </FlareStack>
                            </Trailing>
                        </FlareListItem>
                    }
                </FlareList>
                <FlareStack Row Wrap Align="FlareAlignItems.End" Gap="FlareSpacing.Small">
                    <FlareTextField Label="@(Strings.T("Встреча или интервал"))" @bind-Value="_blockName" Immediate Size="FieldSize.Sm" />
                    <FlareSelect TValue="int" Label="@(Strings.T("День"))" Items="Enumerable.Range(0, 7)" ItemLabel="i => DayNames[i]" @bind-Value="_blockDay" Size="FieldSize.Sm" />
                    <FlareNumericField TValue="decimal" Label="@(Strings.T("Часы"))" @bind-Value="_blockHours" Min="0" Max="24" Step="0.5" Size="FieldSize.Sm" />
                    <FlareButton Variant="ButtonVariant.Text" Size="ButtonSize.Sm" OnClick="AddBlock" Disabled="@(string.IsNullOrWhiteSpace(_blockName) || _blockHours <= 0 || _busy)"><LeadingIcon><FlareIconView Value="@MaterialDesign3Icons.Regular.Add" Size="18px" /></LeadingIcon><ChildContent>@(Strings.T("Добавить нерабочий интервал"))</ChildContent></FlareButton>
                </FlareStack>
            </FlareStack>
            </FlareCardContent>
        </FlareCard>

        <FlareCard Variant="CardVariant.Outlined">
            <FlareCardHeader Title="@(Strings.T("Отпуска, отсутствия и праздники"))" Subtitle="@(Strings.T("Периоды со своей доступностью — заменяют обычные часы дня"))" />
            <FlareCardContent>
            <FlareStack Gap="FlareSpacing.Medium">
                <FlareList TItem="CalendarExceptionDto" Dense>
                    @foreach (var ex in ExceptionList)
                    {
                        <FlareListItem @key="ex.Id">
                            <Leading><FlareIconView Value="@MaterialDesign3Icons.Regular.BeachAccess" Size="18px" /></Leading>
                            <ChildContent>
                                <FlareStack Gap="FlareSpacing.None">
                                    <FlareText Typo="TypographyScale.BodyMedium">@(ex.AvailableHours == 0 ? Strings.T("Нерабочий период") : Strings.T("Сокращённый период")) · @(ex.From == ex.To ? ex.From.ToString("d MMMM") : $"{ex.From:d MMM} — {ex.To:d MMM}")</FlareText>
                                    <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@ex.Reason (@AlvaFormat.Hours(ex.AvailableHours) @(Strings.T("ч/день")))</FlareText>
                                </FlareStack>
                            </ChildContent>
                            <Trailing><FlareIconButton Icon="@MaterialDesign3Icons.Regular.Delete" Size="ButtonSize.Sm" Tooltip="@(Strings.T("Удалить период"))" AriaLabel="@string.Format(Strings.T("Удалить «{0}»"), ex.Reason)" OnClick="() => DeleteException(ex.Id)" /></Trailing>
                        </FlareListItem>
                    }
                </FlareList>
                @if (_calendar.Exceptions.Length == 0) { <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@(Strings.T("Отпусков и праздников не задано."))</FlareText> }
                <FlareStack Row Wrap Align="FlareAlignItems.End" Gap="FlareSpacing.Small">
                    <FlareDatePicker Label="@(Strings.T("С"))" @bind-Value="_exFrom" Size="FieldSize.Sm" />
                    <FlareDatePicker Label="@(Strings.T("По"))" @bind-Value="_exTo" Min="_exFrom" Size="FieldSize.Sm" />
                    <FlareNumericField TValue="decimal" Label="@(Strings.T("Часов в день"))" @bind-Value="_exHours" Min="0" Max="24" Step="0.5" Size="FieldSize.Sm" />
                    <FlareTextField Label="@(Strings.T("Причина"))" @bind-Value="_exReason" Immediate Size="FieldSize.Sm" />
                    <FlareButton Variant="ButtonVariant.Text" Size="ButtonSize.Sm" OnClick="AddException" Disabled="@(!_exFrom.HasValue || !_exTo.HasValue || string.IsNullOrWhiteSpace(_exReason) || _busy)"><LeadingIcon><FlareIconView Value="@MaterialDesign3Icons.Regular.Add" Size="18px" /></LeadingIcon><ChildContent>@(Strings.T("Добавить период"))</ChildContent></FlareButton>
                </FlareStack>
            </FlareStack>
            </FlareCardContent>
        </FlareCard>
    </div>

    <aside class="alva-schedule__side">
        @if (IsDepartment)
        {
        <FlareCard Variant="CardVariant.Outlined">
            <FlareCardHeader Title="@(Strings.T("Участники"))" Subtitle="@(Strings.T("На них действует этот график"))" />
            <FlareCardContent>
                <FlareList TItem="ActorModel" Dense>
                    @foreach (var person in MemberList)
                    {
                        <FlareListItem @key="person.Id">
                            <Leading><FlareAvatar Text="@AlvaFormat.Initials(person.Name)" Alt="@person.Name" Size="AvatarSize.Xs" /></Leading>
                            <ChildContent><FlareLink Href="@($"capacity/{person.Id}/schedule")">@person.Name</FlareLink></ChildContent>
                        </FlareListItem>
                    }
                </FlareList>
                @if (MemberList.Length == 0) { <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@(Strings.T("В подкоманде пока нет участников."))</FlareText> }
            </FlareCardContent>
        </FlareCard>
        }
        else
        {
        <FlareCard Variant="CardVariant.Outlined">
            <FlareCardHeader Title="@(Strings.T("Расчёт ёмкости на 2 недели"))" />
            <FlareCardContent>
                <FlareStack Gap="FlareSpacing.Medium">
                    <div class="alva-ring" style="--alva-ring:@Pct(Net, Nominal)">
                        <span class="alva-ring__value alva-num">@AlvaFormat.Hours(Net)</span><span class="alva-ring__label">@(Strings.T("чистых часов"))</span><span class="alva-ring__pct alva-num">@Pct(Net, Nominal)@(Strings.T("% от номинала"))</span>
                    </div>
                    <FlareList TItem="CalcStat" Dense>
                        @foreach (var stat in CalcStats)
                        {
                            <FlareListItem Primary="@stat.Label">
                                <Trailing><FlareText Typo="TypographyScale.BodySmall" Color="@stat.Color"><b>@stat.Value</b></FlareText></Trailing>
                            </FlareListItem>
                        }
                    </FlareList>
                    @if (Dirty) { <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@(Strings.T("Расчёт по сохранённому графику; новые часы учтутся после сохранения."))</FlareText> }
                </FlareStack>
            </FlareCardContent>
        </FlareCard>
        <FlareCard Variant="CardVariant.Outlined">
            <FlareCardHeader Title="@(Strings.T("Сотрудники команды"))" />
            <FlareCardContent>
                <FlareList TItem="ActorModel" Dense>
                    @foreach (var person in _people)
                    {
                        <FlareListItem @key="person.Id" Selected="@(person.Id == ActorId)">
                            <Leading><FlareAvatar Text="@AlvaFormat.Initials(person.Name)" Alt="@person.Name" Size="AvatarSize.Xs" /></Leading>
                            <ChildContent><FlareLink Href="@($"capacity/{person.Id}/schedule")">@person.Name</FlareLink></ChildContent>
                        </FlareListItem>
                    }
                </FlareList>
            </FlareCardContent>
        </FlareCard>
        }
    </aside>
</div>
}

@code {
    [Parameter, EditorRequired] public Guid ActorId { get; set; }

    private string[] DayNames => [Strings.T("Понедельник"), Strings.T("Вторник"), Strings.T("Среда"), Strings.T("Четверг"), Strings.T("Пятница"), Strings.T("Суббота"), Strings.T("Воскресенье")];
    private string[] Abbr => [Strings.T("ПН"), Strings.T("ВТ"), Strings.T("СР"), Strings.T("ЧТ"), Strings.T("ПТ"), Strings.T("СБ"), Strings.T("ВС")];
    private CalendarDto? _calendar;
    private ActorModel[] _actors = [], _people = [];
    private CapacityDto[] _window = [];
    private decimal[] _hours = new decimal[7], _lastHours = new decimal[7];
    private string _timeZone = "Europe/Moscow";
    private string? _timeZoneError;
    private readonly HashSet<Guid> _applyTo = [];
    private bool _busy, _applyOpen, _saved;
    private string? _error, _blockName, _exReason;
    private int _blockDay;
    private decimal _blockHours = 1, _exHours;
    private DateOnly? _exFrom, _exTo;
    private Guid _loadedFor;

    private static DateOnly Today => DateOnly.FromDateTime(DateTime.Today);
    private ActorModel? Actor => _actors.FirstOrDefault(a => a.Id == ActorId);
    private ActorModel? Person => _people.FirstOrDefault(p => p.Id == ActorId);
    private bool IsDepartment => Actor?.Kind == "Department";

    /// <summary>Люди подкоманды и всех вложенных в неё подкоманд.</summary>
    private IEnumerable<ActorModel> Members
    {
        get
        {
            var scope = new HashSet<Guid> { ActorId };
            for (var grown = true; grown;) grown = _actors.Where(a => a.Kind == "Department" && a.ParentId is { } p && scope.Contains(p)).Aggregate(false, (any, a) => scope.Add(a.Id) | any);
            return _people.Where(p => p.DepartmentIds.Any(scope.Contains) || p.ParentId is { } parent && scope.Contains(parent));
        }
    }
    // Сохранённые часы недели: снимаются при каждой загрузке календаря, а не собираются на каждом рендере.
    private decimal[] Saved { get; set; } = new decimal[7];
    private bool Dirty => _calendar is not null && (!_hours.SequenceEqual(Saved) || _timeZone != _calendar.TimeZone);
    private IDisposable? _draft;
    [CascadingParameter] public FlareConfirmDialogProvider? Confirm { get; set; }
    protected override void OnInitialized() => _draft = Drafts.Track(() => Dirty);
    public void Dispose() => _draft?.Dispose();

    private async Task ConfirmLeave(LocationChangingContext context)
    {
        if (!Dirty) return;
        if (!await DraftPrompt.CanDiscardAsync(Confirm, true)) context.PreventNavigation();
    }

    /// <summary>Вычеты блоков в день недели (0 — понедельник в порядке экрана).</summary>
    private decimal BlocksOn(int screenDay) => _calendar?.RecurringBlocks.Where(b => (b.DayOfWeek + 6) % 7 == screenDay).Sum(b => b.Hours) ?? 0;
    private decimal Remember(int day) { _lastHours[day] = _hours[day]; return 0; }

    private decimal Nominal => Enumerable.Range(0, 14).Select(i => Today.AddDays(i)).Sum(d => Saved[((int)d.DayOfWeek + 6) % 7]);
    private decimal Net => _window.Sum(r => r.AvailableHours);
    private decimal BlockLoss => Enumerable.Range(0, 14).Select(i => Today.AddDays(i))
        .Where(d => _calendar is not null && !_calendar.Exceptions.Any(e => d >= e.From && d <= e.To))
        .Sum(d => Math.Min(Saved[((int)d.DayOfWeek + 6) % 7], BlocksOn(((int)d.DayOfWeek + 6) % 7)));
    private decimal ExceptionLoss => Math.Max(0, Nominal - BlockLoss - Net);
    private static int Pct(decimal part, decimal whole) => whole <= 0 ? 0 : (int)Math.Round(part / whole * 100);
    private string CalendarPath => Session.TeamPath($"actors/{ActorId}/calendar");

    private sealed record CalcStat(string Label, string Value, FlareColor Color);

    private RecurringBlockDto[] BlockList => _calendar?.RecurringBlocks.OrderBy(b => (b.DayOfWeek + 6) % 7).ToArray() ?? [];
    private CalendarExceptionDto[] ExceptionList => _calendar?.Exceptions.OrderBy(e => e.From).ToArray() ?? [];
    private ActorModel[] MemberList => Members.ToArray();

    private CalcStat[] CalcStats => [
        new($"{Strings.T("Номинал по графику")} ({AlvaFormat.WorkDays(Today, Today.AddDays(13))} {Strings.T("раб. дн.")})", $"{AlvaFormat.Hours(Nominal)} {Strings.T("ч")}", FlareColor.OnSurface),
        new(Strings.T("Отпуска и праздники"), $"−{AlvaFormat.Hours(ExceptionLoss)} {Strings.T("ч")}", FlareColor.Error),
        new(Strings.T("Регулярные вычеты"), $"−{AlvaFormat.Hours(BlockLoss)} {Strings.T("ч")}", FlareColor.Primary),
        new(Strings.T("Фонд на 2 недели"), $"~{AlvaFormat.Hours(Net)} {Strings.T("ч")}", FlareColor.Primary)
    ];

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedFor == ActorId) return;
        _applyTo.Clear(); _saved = false;
        await Run(async () =>
        {
            _actors = await Session.Get<ActorModel[]>(Session.TeamPath("actors"));
            _people = _actors.Where(a => a.Kind == "Person").OrderBy(a => a.Name).ToArray();
            await LoadCalendar(keepDraft: false);
            _loadedFor = ActorId;
        });
    }

    // Вычеты и периоды — свои ресурсы: после операции с ними обновляются списки и сохранённые часы, а несохранённые
    // часы недели и часовой пояс остаются как их ввели (keepDraft). Черновик принимает сохранённое только при загрузке
    // и после «Сохранить график».
    private async Task LoadCalendar(bool keepDraft = true)
    {
        _calendar = await Session.Get<CalendarDto>(CalendarPath);
        Saved = [_calendar.Monday, _calendar.Tuesday, _calendar.Wednesday, _calendar.Thursday, _calendar.Friday, _calendar.Saturday, _calendar.Sunday];
        if (!keepDraft)
        {
            _timeZone = _calendar.TimeZone;
            _hours = Saved.ToArray();
            _lastHours = Saved.ToArray();
        }
        _window = (await Session.Get<CapacityDto[]>(Session.TeamPath($"capacity?from={Today:yyyy-MM-dd}&to={Today.AddDays(13):yyyy-MM-dd}"))).Where(r => r.ActorId == ActorId).ToArray();
    }

    private async Task Reset()
    {
        if (!await DraftPrompt.CanDiscardAsync(Confirm, Dirty)) return;
        _hours = Saved.ToArray(); _timeZone = _calendar!.TimeZone;
    }
    private void Toggle(Guid id, bool on) { if (on) _applyTo.Add(id); else _applyTo.Remove(id); }
    private CalendarRequest Request => new(_timeZone, _hours[0], _hours[1], _hours[2], _hours[3], _hours[4], _hours[5], _hours[6]);

    private async Task Save()
    {
        if (!await ValidateTimeZone()) return;
        await Run(async () => { await Session.Send(HttpMethod.Put, CalendarPath, Request); await LoadCalendar(keepDraft: false); _saved = true; });
    }

    private async Task<bool> ValidateTimeZone()
    {
        _timeZoneError = null;
        if (!string.IsNullOrWhiteSpace(_timeZone) && (TimeZoneInfo.TryFindSystemTimeZoneById(_timeZone, out _) || TimeZoneInfo.TryConvertIanaIdToWindowsId(_timeZone, out _)))
            return true;
        _timeZoneError = Strings.T("Неизвестный часовой пояс.");
        StateHasChanged();
        return false;
    }

    private async Task Apply()
    {
        if (!await ValidateTimeZone()) return;
        if (!await DestructivePrompt.ConfirmAsync(Confirm, Strings.T("Применить график"),
            string.Format(Strings.T("График будет применён к {0} сотрудникам."), _applyTo.Count), Strings.T("Применить"))) return;
        await Run(async () =>
        {
            foreach (var id in _applyTo) await Session.Send(HttpMethod.Put, Session.TeamPath($"actors/{id}/calendar"), Request);
            _applyTo.Clear(); _applyOpen = false; _saved = true;
        });
    }

    private Task AddBlock() => Run(async () =>
    {
        await Session.Send(HttpMethod.Post, CalendarPath + "/blocks", new RecurringBlockRequest((_blockDay + 1) % 7, _blockHours, _blockName!.Trim()));
        _blockName = null;
        await LoadCalendar();
    });

    private async Task DeleteBlock(Guid id)
    {
        var name = _calendar?.RecurringBlocks.FirstOrDefault(b => b.Id == id)?.Name ?? "";
        if (!await DestructivePrompt.ConfirmAsync(Confirm, Strings.T("Удалить вычет"),
            string.Format(Strings.T("Вычет «{0}» будет удалён из графика."), name), Strings.T("Удалить"))) return;
        await Run(async () => { await Session.Send(HttpMethod.Delete, CalendarPath + $"/blocks/{id}", new { }); await LoadCalendar(); });
    }

    private Task AddException() => Run(async () =>
    {
        await Session.Send(HttpMethod.Post, CalendarPath + "/exceptions", new CalendarExceptionRequest(_exFrom!.Value, _exTo!.Value, _exHours, _exReason!.Trim()));
        _exFrom = _exTo = null; _exReason = null;
        await LoadCalendar();
    });

    private async Task DeleteException(Guid id)
    {
        var reason = _calendar?.Exceptions.FirstOrDefault(e => e.Id == id)?.Reason ?? "";
        if (!await DestructivePrompt.ConfirmAsync(Confirm, Strings.T("Удалить период"),
            string.Format(Strings.T("Период «{0}» будет удалён из графика."), reason), Strings.T("Удалить"))) return;
        await Run(async () => { await Session.Send(HttpMethod.Delete, CalendarPath + $"/exceptions/{id}", new { }); await LoadCalendar(); });
    }

    private async Task Run(Func<Task> action)
    {
        _busy = true; _error = null;
        try { await action(); }
        catch (Exception e) when (e is HttpRequestException or InvalidOperationException or NotSupportedException) { _error = PageFeedback.Describe(e); }
        finally { _busy = false; }
    }
}
