@* Редактор рабочего графика по макету p16: часы по дням недели, повторяющиеся вычеты, отпуска и
   праздники, расчёт ёмкости и применение графика к другим сотрудникам. Для подкоманды — только общие
   вычеты и нерабочие периоды, которые действуют на всех её участников. *@
@implements IDisposable
@inject AlvaSession Session
@inject DraftGuard Drafts
<NavigationLock OnBeforeInternalNavigation="ConfirmLeave" ConfirmExternalNavigation="Dirty" />
<FlarePageHeader Title="@(IsDepartment ? string.Format(AlvaStrings.Capacity_SubTeamScheduleTitle, Actor!.Name) : AlvaStrings.Capacity_WorkScheduleEditor)"
                Description="@(IsDepartment ? AlvaStrings.Capacity_SharedNonWorkingDaysAndRecurringSubTeamMeetingsTheyAreDeductedFromTheCap_69ceb6 : $"{AlvaStrings.Capacity_WorkingHoursDaysOffVacationsAndRecurringNonWorkingPeriods} {(Person is null ? "" : $"{AlvaStrings.Capacity_For} {Person.Name}")} {AlvaStrings.Capacity_ProjectedOntoSprintCapacity}")">
    <EyebrowContent>
        @if (IsDepartment)
        {
            <FlareBreadcrumb Items="@(new BreadcrumbItem[] { new(AlvaStrings.Common_Team, "team"), new(AlvaStrings.Common_SubTeams, "team/departments"), new(Actor!.Name), new(AlvaStrings.Capacity_SubTeamSchedule) })" Separator="›" AriaLabel="@(AlvaStrings.Capacity_PathToTheEditor)" />
        }
        else
        {
            <FlareBreadcrumb Items="@(new BreadcrumbItem[] { new(AlvaStrings.Common_Capacity, "capacity"), new(AlvaStrings.Common_PeopleSchedules, "capacity/people"), new(Person?.Name ?? AlvaStrings.Capacity_Employee, $"capacity/{ActorId}"), new(AlvaStrings.Common_ScheduleEditor) })" Separator="›" AriaLabel="@(AlvaStrings.Capacity_PathToTheEditor)" />
        }
    </EyebrowContent>
    <ActionsContent>
        @if (!IsDepartment)
        {
            <FlareButton Variant="ButtonVariant.Tonal" Size="ButtonSize.Sm" OnClick="Reset" Disabled="@(!Dirty)"><LeadingIcon><FlareIconView Value="@MaterialDesign3Icons.Regular.Undo" Size="18px" /></LeadingIcon><ChildContent>@(AlvaStrings.Capacity_DiscardChanges)</ChildContent></FlareButton>
            <FlareButton Variant="ButtonVariant.Tonal" Size="ButtonSize.Sm" OnClick="() => _applyOpen = !_applyOpen"><LeadingIcon><FlareIconView Value="@MaterialDesign3Icons.Regular.GroupAdd" Size="18px" /></LeadingIcon><ChildContent>@(AlvaStrings.Capacity_ApplyToTheSelectedEmployees)</ChildContent></FlareButton>
            <FlareButton Size="ButtonSize.Sm" Loading="_busy" OnClick="Save" Disabled="@(!Dirty)"><LeadingIcon><FlareIconView Value="@MaterialDesign3Icons.Regular.Save" Size="18px" /></LeadingIcon><ChildContent>@(AlvaStrings.Capacity_SaveTheSchedule)</ChildContent></FlareButton><EditorStatus Dirty="Dirty" Saving="_busy" />
        }
    </ActionsContent>
</FlarePageHeader>
<PageFeedback Error="@_error" OnRetry="() => LoadCalendar()" />
@if (_saved) { <FlareAlert Severity="AlertSeverity.Success" Title="@(AlvaStrings.Capacity_ScheduleSaved)">@(AlvaStrings.Capacity_CapacityRecalculatedFromTheNewSchedule)</FlareAlert> }

@if (_applyOpen && !IsDepartment)
{
    <FlareCard Variant="CardVariant.Outlined">
        <FlareCardHeader Title="@(AlvaStrings.Capacity_ApplyTheWeeklyHoursToTheEmployees)" Subtitle="@(AlvaStrings.Capacity_TheTimeZoneAndDailyHoursAreCopiedVacationsAndDeductionsStayIndividual)" />
        <FlareCardContent>
            <FlareStack Gap="FlareSpacing.Medium">
                <FlareGrid MinColumnWidth="min(100%,12rem)">
                    @foreach (var person in _people.Where(p => p.Id != ActorId))
                    {
                        <FlareCheckbox TValue="bool" Value="_applyTo.Contains(person.Id)" ValueChanged="(bool on) => Toggle(person.Id, on)">@person.Name</FlareCheckbox>
                    }
                </FlareGrid>
                <FlareStack Row><FlareButton Size="ButtonSize.Sm" Loading="_busy" Disabled="@(_applyTo.Count == 0)" OnClick="Apply">@(AlvaStrings.Capacity_ApplyTo) @_applyTo.Count @AlvaFormat.Plural(_applyTo.Count, "employee")</FlareButton></FlareStack>
            </FlareStack>
        </FlareCardContent>
    </FlareCard>
}

@if (_calendar is not null)
{
<div class="alva-schedule">
    <div class="alva-schedule__main">
        @if (!IsDepartment)
        {
        <FlareCard Variant="CardVariant.Outlined">
            <FlareCardHeader Title="@($"{AlvaStrings.Capacity_WorkWeek} {Person?.Name}")" Subtitle="@(AlvaStrings.Capacity_BaseWorkingWeekAndTimeZone)" />
            <FlareCardContent>
            <FlareStack Gap="FlareSpacing.Small">
                <FlareStack Row Wrap Align="FlareAlignItems.End" Gap="FlareSpacing.Small">
                    <FlareChip Size="ChipSize.Sm" Variant="ChipVariant.Filled" Color="FlareColor.Primary" Label="@($"{AlvaStrings.Capacity_WeeklyFund} {AlvaFormat.Hours(_hours.Sum())} {AlvaStrings.Sprint_HoursShort}")" />
                    <FlareTextField Label="@(AlvaStrings.Capacity_IanaTimeZone)" ErrorText="@_timeZoneError" @bind-Value="_timeZone" HelperText="@(AlvaStrings.Capacity_ForExampleEuropeMoscow)" />
                </FlareStack>
                <div class="alva-week" role="table" aria-label="@(AlvaStrings.Capacity_WorkingHoursByWeekday)">
                <div class="alva-week__row alva-week__row--head" role="row"><span role="columnheader">@(AlvaStrings.Capacity_Weekday)</span><span role="columnheader">@(AlvaStrings.Capacity_Working)</span><span role="columnheader">@(AlvaStrings.Capacity_HoursPerDay)</span><span role="columnheader">@(AlvaStrings.Capacity_Deductions)</span><span role="columnheader">@(AlvaStrings.Capacity_CleanHours)</span></div>
                @for (var i = 0; i < 7; i++)
                {
                    var day = i;
                    var blocks = BlocksOn(day);
                    <div class="alva-week__row @(_hours[day] == 0 ? "alva-week__row--off" : "")" role="row" @key="day">
                        <span role="cell" class="alva-week__day"><span class="alva-week__abbr">@Abbr[day]</span>@DayNames[day]</span>
                        <span role="cell" class="alva-week__cell"><span class="alva-week__label">@(AlvaStrings.Capacity_Working)</span><FlareSwitch Value="@(_hours[day] > 0)" ValueChanged="(bool on) => _hours[day] = on ? (_lastHours[day] > 0 ? _lastHours[day] : 8) : Remember(day)" Label="@string.Format(AlvaStrings.Capacity_WorkingDayLabel, DayNames[day])" /></span>
                        <span role="cell" class="alva-week__cell"><span class="alva-week__label">@(AlvaStrings.Capacity_HoursPerDay)</span>@if (_hours[day] > 0) { <FlareNumericField TValue="decimal" Value="_hours[day]" ValueChanged="(decimal v) => _hours[day] = v" Min="0" Max="24" Step="0.5" Suffix="@(AlvaStrings.Sprint_HoursShort)" InputAttributes="@(new Dictionary<string, object> { ["aria-label"] = string.Format(AlvaStrings.Capacity_HoursAriaLabel, DayNames[day]) })" Size="FieldSize.Sm" /> } else { <span class="alva-week__muted">@(AlvaStrings.Capacity_DayOffLabel)</span> }</span>
                        <span role="cell" class="alva-week__cell alva-num alva-week__muted"><span class="alva-week__label">@(AlvaStrings.Capacity_Deductions)</span>@(blocks > 0 ? string.Format(AlvaStrings.Capacity_DeductionHours, AlvaFormat.Hours(blocks)) : "—")</span>
                        <span role="cell" class="alva-week__cell alva-num alva-week__net"><span class="alva-week__label">@(AlvaStrings.Capacity_CleanHours)</span>@AlvaFormat.Hours(Math.Max(0, _hours[day] - blocks)) @(AlvaStrings.Sprint_HoursShort)</span>
                    </div>
                }
                </div>
            </FlareStack>
            </FlareCardContent>
        </FlareCard>
        }

        <FlareCard Variant="CardVariant.Outlined">
            <FlareCardHeader Title="@(AlvaStrings.Capacity_RecurringDeductions)" Subtitle="@(AlvaStrings.Capacity_RecurringMeetingsAndCeremoniesExcludedFromFocusTime)">
                <ActionContent><FlareChip Size="ChipSize.Sm" Variant="ChipVariant.Filled" Color="FlareColor.Primary" Label="@($"{AlvaStrings.Capacity_Deduction} −{AlvaFormat.Hours(_calendar.RecurringBlocks.Sum(b => b.Hours))} {AlvaStrings.Sprint_HoursPerWeek}")" /></ActionContent>
            </FlareCardHeader>
            <FlareCardContent>
            <FlareStack Gap="FlareSpacing.Medium">
                <FlareList TItem="RecurringBlockDto" Dense>
                    @foreach (var block in BlockList)
                    {
                        <FlareListItem @key="block.Id">
                            <Leading><FlareIconView Value="@MaterialDesign3Icons.Regular.Groups" Size="18px" /></Leading>
                            <ChildContent>
                                <FlareStack Gap="FlareSpacing.None">
                                    <FlareText Typo="TypographyScale.BodyMedium"><b>@block.Name</b></FlareText>
                                    <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@DayNames[(block.DayOfWeek + 6) % 7] · @(AlvaStrings.Capacity_Weekly)</FlareText>
                                </FlareStack>
                            </ChildContent>
                            <Trailing>
                                <FlareStack Row Align="FlareAlignItems.Center" Gap="FlareSpacing.XSmall">
                                    <FlareChip Size="ChipSize.Sm" Variant="ChipVariant.Filled" Color="FlareColor.Primary" Label="@($"{AlvaFormat.Hours(block.Hours)} {AlvaStrings.Capacity_HWeek}")" />
                                    <FlareIconButton Icon="@MaterialDesign3Icons.Regular.Delete" Size="ButtonSize.Sm" Tooltip="@(AlvaStrings.Capacity_DeleteTheDeduction)" AriaLabel="@string.Format(AlvaStrings.Capacity_DeleteDeduction, block.Name)" OnClick="() => DeleteBlock(block.Id)" />
                                </FlareStack>
                            </Trailing>
                        </FlareListItem>
                    }
                </FlareList>
                <FlareStack Row Wrap Align="FlareAlignItems.End" Gap="FlareSpacing.Small">
                    <FlareTextField Label="@(AlvaStrings.Capacity_MeetingOrInterval)" @bind-Value="_blockName" Immediate Size="FieldSize.Sm" />
                    <FlareSelect TValue="int" Label="@(AlvaStrings.Sprint_Day)" Items="Enumerable.Range(0, 7)" ItemLabel="i => DayNames[i]" @bind-Value="_blockDay" Size="FieldSize.Sm" />
                    <FlareNumericField TValue="decimal" Label="@(AlvaStrings.Capacity_Hours)" @bind-Value="_blockHours" Min="0" Max="24" Step="0.5" Size="FieldSize.Sm" />
                    <FlareButton Variant="ButtonVariant.Text" Size="ButtonSize.Sm" OnClick="AddBlock" Disabled="@(string.IsNullOrWhiteSpace(_blockName) || _blockHours <= 0 || _busy)"><LeadingIcon><FlareIconView Value="@MaterialDesign3Icons.Regular.Add" Size="18px" /></LeadingIcon><ChildContent>@(AlvaStrings.Capacity_AddANonWorkingInterval)</ChildContent></FlareButton>
                </FlareStack>
            </FlareStack>
            </FlareCardContent>
        </FlareCard>

        <FlareCard Variant="CardVariant.Outlined">
            <FlareCardHeader Title="@(AlvaStrings.Capacity_VacationsAbsencesAndHolidays)" Subtitle="@(AlvaStrings.Capacity_PeriodsWithTheirOwnAvailabilityReplaceTheUsualHoursOfTheDay)" />
            <FlareCardContent>
            <FlareStack Gap="FlareSpacing.Medium">
                <FlareList TItem="CalendarExceptionDto" Dense>
                    @foreach (var ex in ExceptionList)
                    {
                        <FlareListItem @key="ex.Id">
                            <Leading><FlareIconView Value="@MaterialDesign3Icons.Regular.BeachAccess" Size="18px" /></Leading>
                            <ChildContent>
                                <FlareStack Gap="FlareSpacing.None">
                                    <FlareText Typo="TypographyScale.BodyMedium">@(ex.AvailableHours == 0 ? AlvaStrings.Capacity_NonWorkingPeriod : AlvaStrings.Capacity_ShortenedPeriod) · @(ex.From == ex.To ? ex.From.ToString("d MMMM") : $"{ex.From:d MMM} — {ex.To:d MMM}")</FlareText>
                                    <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@ex.Reason (@AlvaFormat.Hours(ex.AvailableHours) @(AlvaStrings.Capacity_HoursPerDayShort))</FlareText>
                                </FlareStack>
                            </ChildContent>
                            <Trailing><FlareIconButton Icon="@MaterialDesign3Icons.Regular.Delete" Size="ButtonSize.Sm" Tooltip="@(AlvaStrings.Capacity_DeleteThePeriod)" AriaLabel="@string.Format(AlvaStrings.Capacity_Delete, ex.Reason)" OnClick="() => DeleteException(ex.Id)" /></Trailing>
                        </FlareListItem>
                    }
                </FlareList>
                @if (_calendar.Exceptions.Length == 0) { <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@(AlvaStrings.Capacity_NoVacationsOrHolidaysSet)</FlareText> }
                <FlareStack Row Wrap Align="FlareAlignItems.End" Gap="FlareSpacing.Small">
                    <FlareDatePicker Label="@(AlvaStrings.Capacity_From)" @bind-Value="_exFrom" Size="FieldSize.Sm" />
                    <FlareDatePicker Label="@(AlvaStrings.Capacity_By)" @bind-Value="_exTo" Min="_exFrom" Size="FieldSize.Sm" />
                    <FlareNumericField TValue="decimal" Label="@(AlvaStrings.Capacity_HoursPerDay)" @bind-Value="_exHours" Min="0" Max="24" Step="0.5" Size="FieldSize.Sm" />
                    <FlareTextField Label="@(AlvaStrings.Capacity_Reason)" @bind-Value="_exReason" Immediate Size="FieldSize.Sm" />
                    <FlareButton Variant="ButtonVariant.Text" Size="ButtonSize.Sm" OnClick="AddException" Disabled="@(!_exFrom.HasValue || !_exTo.HasValue || string.IsNullOrWhiteSpace(_exReason) || _busy)"><LeadingIcon><FlareIconView Value="@MaterialDesign3Icons.Regular.Add" Size="18px" /></LeadingIcon><ChildContent>@(AlvaStrings.Capacity_AddAPeriod)</ChildContent></FlareButton>
                </FlareStack>
            </FlareStack>
            </FlareCardContent>
        </FlareCard>
    </div>

    <aside class="alva-schedule__side">
        @if (IsDepartment)
        {
        <FlareCard Variant="CardVariant.Outlined">
            <FlareCardHeader Title="@(AlvaStrings.Capacity_Members)" Subtitle="@(AlvaStrings.Capacity_TheseAreCoveredByThisSchedule)" />
            <FlareCardContent>
                <FlareList TItem="ActorModel" Dense>
                    @foreach (var person in MemberList)
                    {
                        <FlareListItem @key="person.Id">
                            <Leading><FlareAvatar Text="@AlvaFormat.Initials(person.Name)" Alt="@person.Name" Size="AvatarSize.Xs" /></Leading>
                            <ChildContent><FlareLink Href="@($"capacity/{person.Id}/schedule")">@person.Name</FlareLink></ChildContent>
                        </FlareListItem>
                    }
                </FlareList>
                @if (MemberList.Length == 0) { <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@(AlvaStrings.Capacity_TheSubTeamHasNoMembersYet)</FlareText> }
            </FlareCardContent>
        </FlareCard>
        }
        else
        {
        <FlareCard Variant="CardVariant.Outlined">
            <FlareCardHeader Title="@(AlvaStrings.Capacity_TwoWeekCapacityCalculation)" />
            <FlareCardContent>
                <FlareStack Gap="FlareSpacing.Medium">
                    <div class="alva-ring" style="--alva-ring:@Pct(Net, Nominal)">
                        <span class="alva-ring__value alva-num">@AlvaFormat.Hours(Net)</span><span class="alva-ring__label">@(AlvaStrings.Capacity_CleanHoursLabel)</span><span class="alva-ring__pct alva-num">@Pct(Net, Nominal)@(AlvaStrings.Capacity_OfNominal)</span>
                    </div>
                    <FlareList TItem="CalcStat" Dense>
                        @foreach (var stat in CalcStats)
                        {
                            <FlareListItem Primary="@stat.Label">
                                <Trailing><FlareText Typo="TypographyScale.BodySmall" Color="@stat.Color"><b>@stat.Value</b></FlareText></Trailing>
                            </FlareListItem>
                        }
                    </FlareList>
                    @if (Dirty) { <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@(AlvaStrings.Capacity_CalculatedFromTheSavedScheduleNewHoursCountAfterSaving)</FlareText> }
                </FlareStack>
            </FlareCardContent>
        </FlareCard>
        <FlareCard Variant="CardVariant.Outlined">
            <FlareCardHeader Title="@(AlvaStrings.Capacity_TeamEmployees)" />
            <FlareCardContent>
                <FlareList TItem="ActorModel" Dense>
                    @foreach (var person in _people)
                    {
                        <FlareListItem @key="person.Id" Selected="@(person.Id == ActorId)">
                            <Leading><FlareAvatar Text="@AlvaFormat.Initials(person.Name)" Alt="@person.Name" Size="AvatarSize.Xs" /></Leading>
                            <ChildContent><FlareLink Href="@($"capacity/{person.Id}/schedule")">@person.Name</FlareLink></ChildContent>
                        </FlareListItem>
                    }
                </FlareList>
            </FlareCardContent>
        </FlareCard>
        }
    </aside>
</div>
}

@code {
    [Parameter, EditorRequired] public Guid ActorId { get; set; }

    private string[] DayNames => [AlvaStrings.Capacity_Monday, AlvaStrings.Capacity_Tuesday, AlvaStrings.Capacity_Wednesday, AlvaStrings.Capacity_Thursday, AlvaStrings.Capacity_Friday, AlvaStrings.Capacity_Saturday, AlvaStrings.Capacity_Sunday];
    private string[] Abbr => [AlvaStrings.Capacity_Mon, AlvaStrings.Capacity_Tue, AlvaStrings.Capacity_Wed, AlvaStrings.Capacity_Thu, AlvaStrings.Capacity_Fri, AlvaStrings.Capacity_Sat, AlvaStrings.Capacity_Sun];
    private CalendarDto? _calendar;
    private ActorModel[] _actors = [], _people = [];
    private CapacityDto[] _window = [];
    private decimal[] _hours = new decimal[7], _lastHours = new decimal[7];
    private string _timeZone = "Europe/Moscow";
    private string? _timeZoneError;
    private readonly HashSet<Guid> _applyTo = [];
    private bool _busy, _applyOpen, _saved;
    private string? _error, _blockName, _exReason;
    private int _blockDay;
    private decimal _blockHours = 1, _exHours;
    private DateOnly? _exFrom, _exTo;
    private Guid _loadedFor;

    private static DateOnly Today => DateOnly.FromDateTime(DateTime.Today);
    private ActorModel? Actor => _actors.FirstOrDefault(a => a.Id == ActorId);
    private ActorModel? Person => _people.FirstOrDefault(p => p.Id == ActorId);
    private bool IsDepartment => Actor?.Kind == "Department";

    /// <summary>Люди подкоманды и всех вложенных в неё подкоманд.</summary>
    private IEnumerable<ActorModel> Members
    {
        get
        {
            var scope = new HashSet<Guid> { ActorId };
            for (var grown = true; grown;) grown = _actors.Where(a => a.Kind == "Department" && a.ParentId is { } p && scope.Contains(p)).Aggregate(false, (any, a) => scope.Add(a.Id) | any);
            return _people.Where(p => p.DepartmentIds.Any(scope.Contains) || p.ParentId is { } parent && scope.Contains(parent));
        }
    }
    // Сохранённые часы недели: снимаются при каждой загрузке календаря, а не собираются на каждом рендере.
    private decimal[] Saved { get; set; } = new decimal[7];
    private bool Dirty => _calendar is not null && (!_hours.SequenceEqual(Saved) || _timeZone != _calendar.TimeZone);
    private IDisposable? _draft;
    [CascadingParameter] public FlareConfirmDialogProvider? Confirm { get; set; }
    protected override void OnInitialized() => _draft = Drafts.Track(() => Dirty);
    public void Dispose() => _draft?.Dispose();

    private async Task ConfirmLeave(LocationChangingContext context)
    {
        if (!Dirty) return;
        if (!await DraftPrompt.CanDiscardAsync(Confirm, true)) context.PreventNavigation();
    }

    /// <summary>Вычеты блоков в день недели (0 — понедельник в порядке экрана).</summary>
    private decimal BlocksOn(int screenDay) => _calendar?.RecurringBlocks.Where(b => (b.DayOfWeek + 6) % 7 == screenDay).Sum(b => b.Hours) ?? 0;
    private decimal Remember(int day) { _lastHours[day] = _hours[day]; return 0; }

    private decimal Nominal => Enumerable.Range(0, 14).Select(i => Today.AddDays(i)).Sum(d => Saved[((int)d.DayOfWeek + 6) % 7]);
    private decimal Net => _window.Sum(r => r.AvailableHours);
    private decimal BlockLoss => Enumerable.Range(0, 14).Select(i => Today.AddDays(i))
        .Where(d => _calendar is not null && !_calendar.Exceptions.Any(e => d >= e.From && d <= e.To))
        .Sum(d => Math.Min(Saved[((int)d.DayOfWeek + 6) % 7], BlocksOn(((int)d.DayOfWeek + 6) % 7)));
    private decimal ExceptionLoss => Math.Max(0, Nominal - BlockLoss - Net);
    private static int Pct(decimal part, decimal whole) => whole <= 0 ? 0 : (int)Math.Round(part / whole * 100);
    private string CalendarPath => Session.TeamPath($"actors/{ActorId}/calendar");

    private sealed record CalcStat(string Label, string Value, FlareColor Color);

    private RecurringBlockDto[] BlockList => _calendar?.RecurringBlocks.OrderBy(b => (b.DayOfWeek + 6) % 7).ToArray() ?? [];
    private CalendarExceptionDto[] ExceptionList => _calendar?.Exceptions.OrderBy(e => e.From).ToArray() ?? [];
    private ActorModel[] MemberList => Members.ToArray();

    private CalcStat[] CalcStats => [
        new($"{AlvaStrings.Capacity_NominalSchedule} ({AlvaFormat.WorkDays(Today, Today.AddDays(13))} {AlvaStrings.Capacity_WorkDays})", $"{AlvaFormat.Hours(Nominal)} {AlvaStrings.Sprint_HoursShort}", FlareColor.OnSurface),
        new(AlvaStrings.Capacity_VacationsAndHolidays, $"−{AlvaFormat.Hours(ExceptionLoss)} {AlvaStrings.Sprint_HoursShort}", FlareColor.Error),
        new(AlvaStrings.Capacity_RecurringDeductionsSummary, $"−{AlvaFormat.Hours(BlockLoss)} {AlvaStrings.Sprint_HoursShort}", FlareColor.Primary),
        new(AlvaStrings.Capacity_TwoWeekFund, $"~{AlvaFormat.Hours(Net)} {AlvaStrings.Sprint_HoursShort}", FlareColor.Primary)
    ];

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedFor == ActorId) return;
        _applyTo.Clear(); _saved = false;
        await Run(async () =>
        {
            _actors = await Session.Get<ActorModel[]>(Session.TeamPath("actors"));
            _people = _actors.Where(a => a.Kind == "Person").OrderBy(a => a.Name).ToArray();
            await LoadCalendar(keepDraft: false);
            _loadedFor = ActorId;
        });
    }

    // Вычеты и периоды — свои ресурсы: после операции с ними обновляются списки и сохранённые часы, а несохранённые
    // часы недели и часовой пояс остаются как их ввели (keepDraft). Черновик принимает сохранённое только при загрузке
    // и после «Сохранить график».
    private async Task LoadCalendar(bool keepDraft = true)
    {
        _calendar = await Session.Get<CalendarDto>(CalendarPath);
        Saved = [_calendar.Monday, _calendar.Tuesday, _calendar.Wednesday, _calendar.Thursday, _calendar.Friday, _calendar.Saturday, _calendar.Sunday];
        if (!keepDraft)
        {
            _timeZone = _calendar.TimeZone;
            _hours = Saved.ToArray();
            _lastHours = Saved.ToArray();
        }
        _window = (await Session.Get<CapacityDto[]>(Session.TeamPath($"capacity?from={Today:yyyy-MM-dd}&to={Today.AddDays(13):yyyy-MM-dd}"))).Where(r => r.ActorId == ActorId).ToArray();
    }

    private async Task Reset()
    {
        if (!await DraftPrompt.CanDiscardAsync(Confirm, Dirty)) return;
        _hours = Saved.ToArray(); _timeZone = _calendar!.TimeZone;
    }
    private void Toggle(Guid id, bool on) { if (on) _applyTo.Add(id); else _applyTo.Remove(id); }
    private CalendarRequest Request => new(_timeZone, _hours[0], _hours[1], _hours[2], _hours[3], _hours[4], _hours[5], _hours[6]);

    private async Task Save()
    {
        if (!await ValidateTimeZone()) return;
        await Run(async () => { await Session.Send(HttpMethod.Put, CalendarPath, Request); await LoadCalendar(keepDraft: false); _saved = true; });
    }

    private async Task<bool> ValidateTimeZone()
    {
        _timeZoneError = null;
        if (!string.IsNullOrWhiteSpace(_timeZone) && (TimeZoneInfo.TryFindSystemTimeZoneById(_timeZone, out _) || TimeZoneInfo.TryConvertIanaIdToWindowsId(_timeZone, out _)))
            return true;
        _timeZoneError = AlvaStrings.Capacity_UnknownTimeZone;
        StateHasChanged();
        return false;
    }

    private async Task Apply()
    {
        if (!await ValidateTimeZone()) return;
        if (!await DestructivePrompt.ConfirmAsync(Confirm, AlvaStrings.Capacity_ApplyTheSchedule,
            string.Format(AlvaStrings.Capacity_TheScheduleWillBeAppliedToEmployees, _applyTo.Count), AlvaStrings.Common_Apply)) return;
        await Run(async () =>
        {
            foreach (var id in _applyTo) await Session.Send(HttpMethod.Put, Session.TeamPath($"actors/{id}/calendar"), Request);
            _applyTo.Clear(); _applyOpen = false; _saved = true;
        });
    }

    private Task AddBlock() => Run(async () =>
    {
        await Session.Send(HttpMethod.Post, CalendarPath + "/blocks", new RecurringBlockRequest((_blockDay + 1) % 7, _blockHours, _blockName!.Trim()));
        _blockName = null;
        await LoadCalendar();
    });

    private async Task DeleteBlock(Guid id)
    {
        var name = _calendar?.RecurringBlocks.FirstOrDefault(b => b.Id == id)?.Name ?? "";
        if (!await DestructivePrompt.ConfirmAsync(Confirm, AlvaStrings.Capacity_DeleteTheDeduction,
            string.Format(AlvaStrings.Capacity_DeductionWillBeDeletedFromTheSchedule, name), AlvaStrings.Common_Delete)) return;
        await Run(async () => { await Session.Send(HttpMethod.Delete, CalendarPath + $"/blocks/{id}", new { }); await LoadCalendar(); });
    }

    private Task AddException() => Run(async () =>
    {
        await Session.Send(HttpMethod.Post, CalendarPath + "/exceptions", new CalendarExceptionRequest(_exFrom!.Value, _exTo!.Value, _exHours, _exReason!.Trim()));
        _exFrom = _exTo = null; _exReason = null;
        await LoadCalendar();
    });

    private async Task DeleteException(Guid id)
    {
        var reason = _calendar?.Exceptions.FirstOrDefault(e => e.Id == id)?.Reason ?? "";
        if (!await DestructivePrompt.ConfirmAsync(Confirm, AlvaStrings.Capacity_DeleteThePeriod,
            string.Format(AlvaStrings.Capacity_PeriodWillBeDeletedFromTheSchedule, reason), AlvaStrings.Common_Delete)) return;
        await Run(async () => { await Session.Send(HttpMethod.Delete, CalendarPath + $"/exceptions/{id}", new { }); await LoadCalendar(); });
    }

    private async Task Run(Func<Task> action)
    {
        _busy = true; _error = null;
        try { await action(); }
        catch (Exception e) when (e is HttpRequestException or InvalidOperationException or NotSupportedException) { _error = PageFeedback.Describe(e); }
        finally { _busy = false; }
    }
}
