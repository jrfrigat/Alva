@implements IDisposable
@inject RiskNotifications Notifications
@inject NavigationManager Navigation
<FlarePopover @bind-Open="_open" Trigger="PopoverTrigger.Click" Placement="Placement.BottomEnd" MinWidth="min(22rem, 92vw)" MaxWidth="min(26rem, 92vw)" MaxHeight="70vh">
    <AnchorContent>
        <FlareBadge Count="Notifications.Unseen" Visible="@(Notifications.Unseen > 0)" Color="FlareColor.Error">
            <FlareIconButton Icon="@(Notifications.Unseen > 0 ? MaterialDesign3Icons.Regular.NotificationsActive : MaterialDesign3Icons.Regular.Notifications)" AriaLabel="@Label" Tooltip="@Label" />
        </FlareBadge>
    </AnchorContent>
    <ChildContent>
        <FlareStack role="region" aria-label="@(AlvaStrings.Common_RiskNotifications)" Gap="FlareSpacing.Small">
            <FlareStack Row Wrap Align="FlareAlignItems.Center" Justify="FlareJustifyContent.SpaceBetween" Gap="FlareSpacing.Small">
                <FlareText Element="h2" Typo="TypographyScale.TitleMedium">@(AlvaStrings.Risks_Risks)</FlareText>
                <FlareText Typo="TypographyScale.LabelMedium" Color="FlareColor.OnSurfaceVariant">@ScopeLabel(Notifications.Scope)</FlareText>
            </FlareStack>
            @if (Notifications.Items.Length == 0)
            {
                <FlareText Typo="TypographyScale.BodyMedium" Color="FlareColor.OnSurfaceVariant">@(AlvaStrings.Risks_NoRisksMatchYourSubscription)</FlareText>
            }
            else
            {
                <FlareList TItem="RiskNotice" Dense="true">
                    @foreach (var item in Notifications.Items)
                    {
                        <FlareListItem @key="item.Risk.TaskId" Selected="@item.New">
                            <ChildContent>
                                <FlareStack Gap="FlareSpacing.XXSmall">
                                    <FlareStack Row Wrap Align="FlareAlignItems.Center" Gap="FlareSpacing.Small">
                                        <AlvaStatusChip Tone="AlvaTones.Severity(item.Risk.Severity)">@(item.Risk.Severity == "High" ? AlvaStrings.Common_High : AlvaStrings.Risks_Medium)</AlvaStatusChip>
                                        <FlareLink Href="@($"tasks/{item.Risk.TaskId}")" @onclick="Close">@item.Risk.Title</FlareLink>
                                        @if (item.New) { <FlareChip Size="ChipSize.Xs" Color="FlareColor.Primary" Label="@(AlvaStrings.Risks_New)" /> }
                                    </FlareStack>
                                    <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">
                                        @for (var i = 0; i < item.Risk.Reasons.Length; i++)
                                        {
                                            if (i > 0) { <text>, </text> }
                                            var reason = item.Risk.Reasons[i];
                                            <FlareLink Href="@RiskActions.Href(reason, item.Risk.TaskId)" title="@RiskActions.Label(reason)">@ReasonText.Describe(reason)</FlareLink>
                                        }
                                    </FlareText>
                                </FlareStack>
                            </ChildContent>
                        </FlareListItem>
                    }
                </FlareList>
            }
            <FlareStack Row Wrap Justify="FlareJustifyContent.SpaceBetween" Gap="FlareSpacing.Small">
                <FlareButton Variant="ButtonVariant.Text" Size="ButtonSize.Sm" Disabled="@(Notifications.Unseen == 0)" OnClick="Notifications.MarkAllSeen">@(AlvaStrings.Risks_MarkAllAsRead)</FlareButton>
                <FlareButton Variant="ButtonVariant.Tonal" Size="ButtonSize.Sm" OnClick="OpenAll">@(AlvaStrings.Common_AllRisks)</FlareButton>
            </FlareStack>
        </FlareStack>
    </ChildContent>
</FlarePopover>
@code {
    private bool _open;
    private string Label => Notifications.Unseen > 0 ? $"{AlvaStrings.Risks_RisksNew} {Notifications.Unseen}" : AlvaStrings.Risks_Risks;

    public static string ScopeLabel(RiskScope scope) => scope switch
    {
        RiskScope.High => AlvaStrings.Risks_HighLevelOnly,
        RiskScope.Mine => AlvaStrings.Risks_OnlyMyTasks,
        _ => AlvaStrings.Risks_AllTeamRisks
    };

    protected override void OnInitialized() => Notifications.Changed += Refresh;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await Notifications.Start();
    }
    private void Refresh() => InvokeAsync(StateHasChanged);
    private void Close() => _open = false;
    private void OpenAll() { _open = false; Navigation.NavigateTo("analytics"); }
    public void Dispose() => Notifications.Changed -= Refresh;
}
