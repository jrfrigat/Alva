@* Validation summary outside EditForm: a FlareAlert with the messages. The calling page puts focus
   on the wrapper, so this component has no tabindex or focus handling of its own. *@
<FlareAlert Severity="AlertSeverity.Error" Title="@(AlvaStrings.Common_CheckTheHighlightedFields)">
    <FlareStack Gap="FlareSpacing.XSmall">
        @foreach (var message in Messages)
        {
            <FlareText Typo="TypographyScale.BodyMedium">@message</FlareText>
        }
    </FlareStack>
</FlareAlert>
@code {
    /// <summary>Messages collected by form validation before submission.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<string> Messages { get; set; } = [];
}
