@* Сводка ошибок вне EditForm: FlareAlert с сообщениями. Фокус на обёртку задаёт вызывающая
   страница, поэтому здесь нет собственного tabindex и перехвата фокуса. *@
<FlareAlert Severity="AlertSeverity.Error" Title="@(Strings.T("Проверьте выделенные поля."))">
    <FlareStack Gap="FlareSpacing.XSmall">
        @foreach (var message in Messages)
        {
            <FlareText Typo="TypographyScale.BodyMedium">@message</FlareText>
        }
    </FlareStack>
</FlareAlert>
@code {
    /// <summary>Сообщения, собранные проверкой формы до отправки.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<string> Messages { get; set; } = [];
}
