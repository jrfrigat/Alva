@* Employee calendar: a week with available and booked hours by day, the employee's tasks,
   deductions and upcoming absences. *@
@inject AlvaSession Session
<AlvaPageHeader Title="@(Person?.Name ?? AlvaStrings.Capacity_Employee)">
    <EyebrowContent>
        <FlareBreadcrumb Items="@(new BreadcrumbItem[] { new(AlvaStrings.Common_Capacity, "capacity"), new(AlvaStrings.Common_PeopleSchedules, "capacity/people"), new(Person?.Name ?? AlvaStrings.Capacity_Employee) })" Separator="›" AriaLabel="@(AlvaStrings.Capacity_PathToTheEmployeeCalendar)" />
    </EyebrowContent>
    <DescriptionContent>
        <FlareStack Row Wrap Align="FlareAlignItems.Center" Gap="FlareSpacing.Small">
            <FlareAvatar Text="@AlvaFormat.Initials(Person?.Name ?? "?")" Size="AvatarSize.Md" Color="FlareColor.Primary" />
            @foreach (var tag in Tags) { <AlvaStatusChip Tone="AlvaTone.Role">@tag</AlvaStatusChip> }
            @if (_calendar is not null) { <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant"><FlareIconView Value="@MaterialDesign3Icons.Regular.Schedule" Size="15px" /> @(AlvaStrings.Capacity_Schedule) @Pattern (@AlvaFormat.Hours(WeekNominal) @(AlvaStrings.Capacity_HWeek) · @_calendar.TimeZone)</FlareText> }
            @if (!string.IsNullOrWhiteSpace(Person?.Email)) { <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant"><FlareIconView Value="@MaterialDesign3Icons.Regular.Mail" Size="15px" /> @Person!.Email</FlareText> }
        </FlareStack>
    </DescriptionContent>
    <Actions>
        <FlareIconButton Icon="@MaterialDesign3Icons.Regular.ChevronLeft" Size="ButtonSize.Sm" AriaLabel="@(AlvaStrings.Capacity_PreviousWeek)" OnClick="() => Shift(-7)" />
        <FlareChip Variant="ChipVariant.Filled" Color="FlareColor.Primary" Size="ChipSize.Sm">@_monday.ToString("d") – @_monday.AddDays(6).ToString("d MMMM yyyy")@(SprintOfWeek is { } s ? $" · {s.Name}" : "")</FlareChip>
        <FlareIconButton Icon="@MaterialDesign3Icons.Regular.ChevronRight" Size="ButtonSize.Sm" AriaLabel="@(AlvaStrings.Capacity_NextWeek)" OnClick="() => Shift(7)" />
        <FlareButton Variant="ButtonVariant.Text" Size="ButtonSize.Sm" OnClick="ThisWeek">@(AlvaStrings.Gantt_Today)</FlareButton>
        <FlareButton Href="@($"capacity/{ActorId}/schedule")" Size="ButtonSize.Sm"><LeadingIcon><FlareIconView Value="@MaterialDesign3Icons.Regular.EditCalendar" Size="18px" /></LeadingIcon><ChildContent>@(AlvaStrings.Common_ScheduleEditor)</ChildContent></FlareButton>
    </Actions>
</AlvaPageHeader>
<PageFeedback Error="@_error" Loading="_busy" OnRetry="LoadWeek" />

<FlareGrid MinColumnWidth="min(100%,11rem)">
    <FlareStat Label="@(AlvaStrings.Capacity_WeekNominal)" Value="@AlvaFormat.Hours(WeekNominal)" Unit="@(AlvaStrings.Capacity_HoursUnit)" Caption="@($"{AlvaStrings.Capacity_BySchedule} {Pattern}")" />
    <FlareStat Label="@(AlvaStrings.Capacity_MeetingsAndDeductions)" Value="@($"−{AlvaFormat.Hours(WeekBlocks)}")" Unit="@(AlvaStrings.Capacity_HoursUnit)"
               Caption="@(_calendar?.RecurringBlocks.Length > 0 ? string.Join(" · ", _calendar.RecurringBlocks.Select(b => b.Name).Distinct()) : AlvaStrings.Capacity_NoRecurringDeductions)" />
    <FlareStat Label="@(AlvaStrings.Capacity_CleanCapacity)" Value="@AlvaFormat.Hours(WeekAvailable)" Unit="@(AlvaStrings.Capacity_FocusHours)" Caption="@(AlvaStrings.Capacity_AvailableForWorkVacationsIncluded)" />
    <FlareStat Label="@(AlvaStrings.Capacity_PlannedTasks)" Value="@AlvaFormat.Hours(WeekAllocated)" Unit="@($"{AlvaStrings.Sprint_HoursShort} {(WeekAllocated > WeekAvailable ? string.Format(AlvaStrings.Capacity_FreeWithHours, AlvaFormat.Hours(WeekAllocated - WeekAvailable)) : "")}")">
        <CaptionContent>
            <AlvaStatusChip Tone="@(WeekAllocated > WeekAvailable ? AlvaTone.Critical : AlvaTone.Ok)">@(WeekAvailable > 0 ? $"{Pct(WeekAllocated, WeekAvailable)}%" : "—") @(WeekAllocated > WeekAvailable ? AlvaStrings.Common_Overload : AlvaStrings.Capacity_Balanced)</AlvaStatusChip>
        </CaptionContent>
    </FlareStat>
    <FlareStat Label="@(AlvaStrings.Capacity_VacationInThePeriod)" Value="@AlvaFormat.Hours(WeekAbsence)" Unit="@(AlvaStrings.Capacity_HoursUnit)"
               Caption="@(NextAbsence is { } a ? $"{AlvaStrings.Capacity_Nearest} {a.From:d MMM}–{a.To:d MMM}, {a.Reason}" : AlvaStrings.Capacity_NoAbsencesPlanned)" />
</FlareGrid>

<FlareGrid Columns="5" Gap="FlareSpacing.Medium" AlignItems="FlareAlignItems.Start">
    <FlareCol Xs="5" Sm="5" Md="3" Lg="4">
    <section aria-label="@(AlvaStrings.Capacity_Weekdays)">
        <FlareGrid Columns="7" Gap="FlareSpacing.Small">
        @for (var i = 0; i < 7; i++)
        {
            var date = _monday.AddDays(i);
            var row = _rows.FirstOrDefault(r => r.Date == date);
            var avail = row?.AvailableHours ?? 0;
            var alloc = row?.AllocatedHours ?? 0;
            var absence = _calendar?.Exceptions.Where(e => date >= e.From && date <= e.To).MinBy(e => e.AvailableHours);
            var weekend = Nominal(date) == 0 && absence is null;
            var tasks = TasksOn(date);
            var state = weekend ? "off" : absence is not null ? "absence" : alloc > avail ? "over" : "ok";
            <FlareCol Xs="7" Sm="7" Md="1" Lg="1" @key="date">
                <FlareCard Variant="CardVariant.Outlined">
                    <FlareCardContent>
                    <FlareStack Gap="FlareSpacing.Small">
                        <FlareStack Gap="FlareSpacing.None">
                            <FlareText Typo="TypographyScale.LabelMedium">@date.ToString("ddd, d MMM")</FlareText>
                            <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@AlvaFormat.Hours(alloc) / @AlvaFormat.Hours(avail) @(AlvaStrings.Sprint_HoursShort)</FlareText>
                        </FlareStack>
                        <AlvaStatusChip Tone="@DayTone(state)">
                            @switch (state)
                            {
                                case "off": @AlvaStrings.Capacity_DayOff; break;
                                case "absence": @($"{absence!.Reason}"); break;
                                case "over": @($"+{AlvaFormat.Hours(alloc - avail)} {AlvaStrings.Sprint_HoursShort} {AlvaStrings.Capacity_Overtime}"); break;
                                default: @(alloc == 0 ? AlvaStrings.Capacity_FreePerson : alloc >= avail ? AlvaStrings.Capacity_FullDay : AlvaStrings.Capacity_NormBalance); break;
                            }
                        </AlvaStatusChip>
                        @if (avail > 0) { <FlareProgressLinear Value="@Math.Min(100, Pct(alloc, avail))" Size="TrackSize.Xs" Color="@(alloc > avail ? FlareColor.Error : FlareColor.Primary)" aria-label="@(AlvaStrings.Capacity_DayLoad)" /> }
                        @foreach (var block in Blocks(date)) { <FlareStack Row Align="FlareAlignItems.Center" Gap="FlareSpacing.XXSmall"><FlareIconView Value="@MaterialDesign3Icons.Regular.Groups" Size="14px" /><FlareText Typo="TypographyScale.BodySmall">@block.Name, @AlvaFormat.Hours(block.Hours) @(AlvaStrings.Sprint_HoursShort)</FlareText></FlareStack> }
                        @foreach (var task in tasks) { <FlareLink Href="@($"tasks/{task.Id}")">@AlvaFormat.Code(task.Id) @task.Title</FlareLink> }
                    </FlareStack>
                    </FlareCardContent>
                </FlareCard>
            </FlareCol>
        }
        </FlareGrid>
    </section>
    </FlareCol>
    <FlareCol Xs="5" Sm="5" Md="2" Lg="1">
    <FlareStack Gap="FlareSpacing.Medium">
        <FlareCard Variant="CardVariant.Outlined">
            <FlareCardHeader Title="@($"{AlvaStrings.Capacity_TasksThisWeek} ({WeekTasks.Length})")" />
            <FlareCardContent>
                <FlareList TItem="TaskModel" Dense>
                    @foreach (var task in WeekTasks)
                    {
                        <FlareListItem @key="task.Id">
                            <ChildContent>
                                <FlareStack Gap="FlareSpacing.XSmall">
                                    <FlareStack Row Align="FlareAlignItems.Center" Gap="FlareSpacing.XSmall">
                                        <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.Primary">@AlvaFormat.Code(task.Id)</FlareText>
                                        <AlvaStatusChip Tone="AlvaTones.Status(task.Status)">@Labels.Status(task.Status)</AlvaStatusChip>
                                    </FlareStack>
                                    <FlareLink Href="@($"tasks/{task.Id}")">@task.Title</FlareLink>
                                    <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@(AlvaStrings.Capacity_Estimate) @(task.EstimateHours.HasValue ? $"{AlvaFormat.Hours(task.EstimateHours.Value)} {AlvaStrings.Sprint_HoursShort}" : "—")@(task.Deadline.HasValue ? string.Format(AlvaStrings.Capacity_Due, task.Deadline) : "")</FlareText>
                                </FlareStack>
                            </ChildContent>
                        </FlareListItem>
                    }
                </FlareList>
                @if (WeekTasks.Length == 0) { <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@(AlvaStrings.Capacity_NoTasksThisWeek)</FlareText> }
            </FlareCardContent>
        </FlareCard>
        <FlareCard Variant="CardVariant.Outlined">
            <FlareCardHeader Title="@(AlvaStrings.Capacity_UpcomingAbsences)" />
            <FlareCardContent>
                <FlareList TItem="CalendarExceptionDto" Dense>
                    @foreach (var ex in Upcoming)
                    {
                        <FlareListItem @key="ex.Id" Primary="@ex.Reason" Secondary="@($"{ex.From:d MMM} — {ex.To:d MMM yyyy} · {AlvaFormat.Hours(ex.AvailableHours)} {AlvaStrings.Capacity_HoursPerDayShort}")" />
                    }
                </FlareList>
                @if (Upcoming.Length == 0) { <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@(AlvaStrings.Capacity_NoVacationsPlanned)</FlareText> }
                <FlareButton Href="@($"capacity/{ActorId}/schedule")" Variant="ButtonVariant.Tonal" Size="ButtonSize.Sm"><LeadingIcon><FlareIconView Value="@MaterialDesign3Icons.Regular.Add" Size="18px" /></LeadingIcon><ChildContent>@(AlvaStrings.Capacity_TimeOffVacation)</ChildContent></FlareButton>
            </FlareCardContent>
        </FlareCard>
    </FlareStack>
    </FlareCol>
</FlareGrid>

@code {
    [Parameter, EditorRequired] public Guid ActorId { get; set; }

    private CalendarDto? _calendar;
    private ActorModel[] _actors = [];
    private TaskModel[] _tasks = [];
    private SprintModel[] _sprints = [];
    private CapacityDto[] _rows = [];
    private DateOnly _monday = Monday(DateOnly.FromDateTime(DateTime.Today));
    private string? _error;
    private bool _busy;
    private Guid _loadedFor;

    private static DateOnly Today => DateOnly.FromDateTime(DateTime.Today);
    private static DateOnly Monday(DateOnly d) => d.AddDays(-(((int)d.DayOfWeek + 6) % 7));
    private ActorModel? Person => _actors.FirstOrDefault(a => a.Id == ActorId);
    private IEnumerable<string> Tags => Person is null ? [] : _actors.Where(a => Person.SkillIds.Contains(a.Id) || Person.DepartmentIds.Contains(a.Id)).Select(a => a.Name);
    private SprintModel? SprintOfWeek => _sprints.Where(s => s.StartDate <= _monday.AddDays(6) && s.EndDate >= _monday).OrderBy(s => s.StartDate).FirstOrDefault();
    private static int Pct(decimal part, decimal whole) => whole <= 0 ? 0 : (int)Math.Round(part / whole * 100);
    private static AlvaTone DayTone(string state) => state switch { "off" => AlvaTone.Neutral, "absence" => AlvaTone.Role, "over" => AlvaTone.Critical, _ => AlvaTone.Ok };

    private decimal Nominal(DateOnly d) => _calendar is null ? 0 : d.DayOfWeek switch
    {
        DayOfWeek.Monday => _calendar.Monday, DayOfWeek.Tuesday => _calendar.Tuesday, DayOfWeek.Wednesday => _calendar.Wednesday,
        DayOfWeek.Thursday => _calendar.Thursday, DayOfWeek.Friday => _calendar.Friday, DayOfWeek.Saturday => _calendar.Saturday, _ => _calendar.Sunday
    };
    private IEnumerable<RecurringBlockDto> Blocks(DateOnly d) => _calendar?.RecurringBlocks.Where(b => b.DayOfWeek == (int)d.DayOfWeek) ?? [];
    private IEnumerable<DateOnly> Week => Enumerable.Range(0, 7).Select(i => _monday.AddDays(i));
    private decimal WeekNominal => Week.Sum(Nominal);
    private decimal WeekBlocks => Week.Sum(d => Math.Min(Nominal(d), Blocks(d).Sum(b => b.Hours)));
    private decimal WeekAvailable => _rows.Sum(r => r.AvailableHours);
    private decimal WeekAllocated => _rows.Sum(r => r.AllocatedHours);
    private decimal WeekAbsence => Week.Where(d => _calendar?.Exceptions.Any(e => d >= e.From && d <= e.To) == true).Sum(d => Math.Max(0, Nominal(d) - _calendar!.Exceptions.Where(e => d >= e.From && d <= e.To).Min(e => e.AvailableHours)));
    private CalendarExceptionDto? NextAbsence => Upcoming.FirstOrDefault();
    private CalendarExceptionDto[] Upcoming => _calendar is null ? [] : _calendar.Exceptions.Where(e => e.To >= Today).OrderBy(e => e.From).ToArray();    private string Pattern
    {
        get
        {
            if (_calendar is null) return "—";
            var work = new[] { _calendar.Monday, _calendar.Tuesday, _calendar.Wednesday, _calendar.Thursday, _calendar.Friday, _calendar.Saturday, _calendar.Sunday }.Count(h => h > 0);
            return $"{work}/{7 - work}";
        }
    }

    private TaskModel[] Mine => _tasks.Where(t => (t.ResolvedPersonId ?? t.AssignmentTargetId) == ActorId && t.Status is not ("Cancelled")).ToArray();

    /// <summary>Task window: its planned dates, otherwise the deadline.</summary>
    private static (DateOnly From, DateOnly To)? Window(TaskModel t)
    {
        var from = t.StartDate ?? t.EndDate ?? t.Deadline;
        var to = t.EndDate ?? t.StartDate ?? t.Deadline ?? from;
        return from is null || to is null ? null : (from.Value, to.Value < from.Value ? from.Value : to.Value);
    }
    private TaskModel[] TasksOn(DateOnly d) => Nominal(d) == 0 ? [] : Mine.Where(t => t.Status != "Done" && Window(t) is { } w && d >= w.From && d <= w.To).ToArray();
    private TaskModel[] WeekTasks => Mine.Where(t => Window(t) is { } w && w.From <= _monday.AddDays(6) && w.To >= _monday).OrderBy(t => t.Status == "Done").ThenBy(t => t.Deadline ?? DateOnly.MaxValue).ToArray();

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedFor == ActorId) return;
        await Run(async () =>
        {
            _actors = await Session.Get<ActorModel[]>(Session.TeamPath("actors"));
            _tasks = await Session.Get<TaskModel[]>(Session.TeamPath("tasks"));
            _sprints = await Session.Get<SprintModel[]>(Session.TeamPath("sprints"));
            _calendar = await Session.Get<CalendarDto>(Session.TeamPath($"actors/{ActorId}/calendar"));
            // Holidays and sub-team meetings affect the employee just as in the capacity calculation.
            var departments = _actors.Where(a => a.Kind == "Department").ToDictionary(a => a.Id, a => a.ParentId);
            if (Person is { } person)
            {
                var memberOf = CapacityMath.DepartmentsWithParents(person.DepartmentIds.Append(person.ParentId ?? Guid.Empty).Where(departments.ContainsKey),
                    id => departments.GetValueOrDefault(id) is { } parent && departments.ContainsKey(parent) ? parent : null);
                var shared = new List<CalendarDto>();
                foreach (var id in memberOf) shared.Add(await Session.Get<CalendarDto>(Session.TeamPath($"actors/{id}/calendar")));
                _calendar = CapacityMath.Combine(_calendar, shared);
            }
            await LoadWeek();
            _loadedFor = ActorId;
        });
    }

    private async Task LoadWeek() =>
        _rows = (await Session.Get<CapacityDto[]>(Session.TeamPath($"capacity?from={_monday:yyyy-MM-dd}&to={_monday.AddDays(6):yyyy-MM-dd}"))).Where(r => r.ActorId == ActorId).ToArray();

    private Task Shift(int days) { _monday = _monday.AddDays(days); return Run(LoadWeek); }
    private Task ThisWeek() { _monday = Monday(Today); return Run(LoadWeek); }

    private async Task Run(Func<Task> action)
    {
        _busy = true; _error = null;
        try { await action(); }
        catch (Exception e) when (e is HttpRequestException or InvalidOperationException or NotSupportedException) { _error = PageFeedback.Describe(e); }
        finally { _busy = false; }
    }
}
