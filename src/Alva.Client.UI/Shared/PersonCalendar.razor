@* Календарь сотрудника по макету p15.1: неделя с доступными и занятыми часами по дням, задачи
   сотрудника, вычеты и предстоящие отсутствия. *@
@inject AlvaSession Session
<FlarePageHeader Title="@(Person?.Name ?? Strings.T("Сотрудник"))">
    <EyebrowContent>
        <FlareBreadcrumb Items="@(new BreadcrumbItem[] { new(Strings.T("Ёмкость"), "capacity"), new(Strings.T("Графики людей"), "capacity/people"), new(Person?.Name ?? Strings.T("Сотрудник")) })" Separator="›" AriaLabel="@(Strings.T("Путь к календарю сотрудника"))" />
    </EyebrowContent>
    <DescriptionContent>
        <FlareStack Row Wrap Align="FlareAlignItems.Center" Gap="FlareSpacing.Small">
            <FlareAvatar Text="@AlvaFormat.Initials(Person?.Name ?? "?")" Size="AvatarSize.Md" Color="FlareColor.Primary" />
            @foreach (var tag in Tags) { <AlvaStatusChip Tone="AlvaTone.Role">@tag</AlvaStatusChip> }
            @if (_calendar is not null) { <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant"><FlareIconView Value="@MaterialDesign3Icons.Regular.Schedule" Size="15px" /> @(Strings.T("График")) @Pattern (@AlvaFormat.Hours(WeekNominal) @(Strings.T("ч/нед")) · @_calendar.TimeZone)</FlareText> }
            @if (!string.IsNullOrWhiteSpace(Person?.Email)) { <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant"><FlareIconView Value="@MaterialDesign3Icons.Regular.Mail" Size="15px" /> @Person!.Email</FlareText> }
        </FlareStack>
    </DescriptionContent>
    <ActionsContent>
        <FlareIconButton Icon="@MaterialDesign3Icons.Regular.ChevronLeft" Size="ButtonSize.Sm" AriaLabel="@(Strings.T("Предыдущая неделя"))" OnClick="() => Shift(-7)" />
        <FlareChip Variant="ChipVariant.Filled" Color="FlareColor.Primary" Size="ChipSize.Sm">@_monday.ToString("d") – @_monday.AddDays(6).ToString("d MMMM yyyy")@(SprintOfWeek is { } s ? $" · {s.Name}" : "")</FlareChip>
        <FlareIconButton Icon="@MaterialDesign3Icons.Regular.ChevronRight" Size="ButtonSize.Sm" AriaLabel="@(Strings.T("Следующая неделя"))" OnClick="() => Shift(7)" />
        <FlareButton Variant="ButtonVariant.Text" Size="ButtonSize.Sm" OnClick="ThisWeek">@(Strings.T("Сегодня"))</FlareButton>
        <FlareButton Href="@($"capacity/{ActorId}/schedule")" Size="ButtonSize.Sm"><LeadingIcon><FlareIconView Value="@MaterialDesign3Icons.Regular.EditCalendar" Size="18px" /></LeadingIcon><ChildContent>@(Strings.T("Редактор графика"))</ChildContent></FlareButton>
    </ActionsContent>
</FlarePageHeader>
<PageFeedback Error="@_error" Loading="_busy" OnRetry="LoadWeek" />

<FlareGrid MinColumnWidth="min(100%,11rem)">
    <FlareStat Label="@(Strings.T("Номинал недели"))" Value="@AlvaFormat.Hours(WeekNominal)" Unit="@(Strings.T("часов"))" Caption="@($"{Strings.T("По графику:")} {Pattern}")" />
    <FlareStat Label="@(Strings.T("Встречи и вычеты"))" Value="@($"−{AlvaFormat.Hours(WeekBlocks)}")" Unit="@(Strings.T("часов"))"
               Caption="@(_calendar?.RecurringBlocks.Length > 0 ? string.Join(" · ", _calendar.RecurringBlocks.Select(b => b.Name).Distinct()) : Strings.T("Регулярных вычетов нет"))" />
    <FlareStat Label="@(Strings.T("Чистая ёмкость"))" Value="@AlvaFormat.Hours(WeekAvailable)" Unit="@(Strings.T("часов фокуса"))" Caption="@(Strings.T("Доступно для задач с учётом отпусков"))" />
    <FlareStat Label="@(Strings.T("Задачи в плане"))" Value="@AlvaFormat.Hours(WeekAllocated)" Unit="@($"{Strings.T("ч")} {(WeekAllocated > WeekAvailable ? string.Format(Strings.T("(+{0} ч)"), AlvaFormat.Hours(WeekAllocated - WeekAvailable)) : "")}")">
        <CaptionContent>
            <AlvaStatusChip Tone="@(WeekAllocated > WeekAvailable ? AlvaTone.Critical : AlvaTone.Ok)">@(WeekAvailable > 0 ? $"{Pct(WeekAllocated, WeekAvailable)}%" : "—") @(WeekAllocated > WeekAvailable ? Strings.T("перегруз") : Strings.T("в балансе"))</AlvaStatusChip>
        </CaptionContent>
    </FlareStat>
    <FlareStat Label="@(Strings.T("Отпуск в периоде"))" Value="@AlvaFormat.Hours(WeekAbsence)" Unit="@(Strings.T("часов"))"
               Caption="@(NextAbsence is { } a ? $"{Strings.T("Ближайшее:")} {a.From:d MMM}–{a.To:d MMM}, {a.Reason}" : Strings.T("Отсутствий не запланировано"))" />
</FlareGrid>

<div class="alva-person-layout">
    <section class="alva-panel alva-weekdays" aria-label="@(Strings.T("Дни недели"))">
        @for (var i = 0; i < 7; i++)
        {
            var date = _monday.AddDays(i);
            var row = _rows.FirstOrDefault(r => r.Date == date);
            var avail = row?.AvailableHours ?? 0;
            var alloc = row?.AllocatedHours ?? 0;
            var absence = _calendar?.Exceptions.Where(e => date >= e.From && date <= e.To).MinBy(e => e.AvailableHours);
            var weekend = Nominal(date) == 0 && absence is null;
            var tasks = TasksOn(date);
            var state = weekend ? "off" : absence is not null ? "absence" : alloc > avail ? "over" : "ok";
            <div class="alva-weekday alva-weekday--@state @(date == Today ? "alva-weekday--today" : "")" @key="date">
                <div class="alva-weekday__head"><b>@date.ToString("ddd, d MMM")</b><span class="alva-num">@AlvaFormat.Hours(alloc) / @AlvaFormat.Hours(avail) @(Strings.T("ч"))</span></div>
                <div class="alva-weekday__status">
                    @switch (state)
                    {
                        case "off": <span>@(Strings.T("Выходной"))</span>; break;
                        case "absence": <span><FlareIconView Value="@MaterialDesign3Icons.Regular.BeachAccess" Size="14px" /> @absence!.Reason</span>; break;
                        case "over": <span><FlareIconView Value="@MaterialDesign3Icons.Regular.Warning" Size="14px" /> +@AlvaFormat.Hours(alloc - avail) @(Strings.T("ч")) @(Strings.T("овертайм"))</span>; break;
                        default: <span>@(alloc == 0 ? Strings.T("Свободен") : alloc >= avail ? Strings.T("Полный день") : Strings.T("Баланс нормы"))</span>; break;
                    }
                </div>
                @if (avail > 0) { <FlareProgressLinear Value="@Math.Min(100, Pct(alloc, avail))" Size="TrackSize.Xs" Color="@(alloc > avail ? FlareColor.Error : FlareColor.Primary)" aria-label="@(Strings.T("Загрузка дня"))" /> }
                @foreach (var block in Blocks(date)) { <span class="alva-weekday__item alva-weekday__item--meeting"><FlareIconView Value="@MaterialDesign3Icons.Regular.Groups" Size="14px" /> @block.Name · @AlvaFormat.Hours(block.Hours) @(Strings.T("ч"))</span> }
                @foreach (var task in tasks) { <a class="alva-weekday__item" href="@($"tasks/{task.Id}")"><span class="alva-plan-card__code">@AlvaFormat.Code(task.Id)</span> @task.Title</a> }
            </div>
        }
    </section>
    <aside class="alva-person-side">
        <FlareCard Variant="CardVariant.Outlined">
            <FlareCardHeader Title="@($"{Strings.T("Задачи на неделе")} ({WeekTasks.Length})")" />
            <FlareCardContent>
                <FlareList TItem="TaskModel" Dense>
                    @foreach (var task in WeekTasks)
                    {
                        <FlareListItem @key="task.Id">
                            <ChildContent>
                                <FlareStack Gap="FlareSpacing.XSmall">
                                    <FlareStack Row Align="FlareAlignItems.Center" Gap="FlareSpacing.XSmall">
                                        <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.Primary">@AlvaFormat.Code(task.Id)</FlareText>
                                        <AlvaStatusChip Tone="AlvaTones.Status(task.Status)">@Labels.Status(task.Status)</AlvaStatusChip>
                                    </FlareStack>
                                    <FlareLink Href="@($"tasks/{task.Id}")">@task.Title</FlareLink>
                                    <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@(Strings.T("Оценка:")) @(task.EstimateHours.HasValue ? $"{AlvaFormat.Hours(task.EstimateHours.Value)} {Strings.T("ч")}" : "—")@(task.Deadline.HasValue ? string.Format(Strings.T(" · до {0:d MMM}"), task.Deadline) : "")</FlareText>
                                </FlareStack>
                            </ChildContent>
                        </FlareListItem>
                    }
                </FlareList>
                @if (WeekTasks.Length == 0) { <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@(Strings.T("На этой неделе задач нет."))</FlareText> }
            </FlareCardContent>
        </FlareCard>
        <FlareCard Variant="CardVariant.Outlined">
            <FlareCardHeader Title="@(Strings.T("Предстоящие отсутствия"))" />
            <FlareCardContent>
                <FlareList TItem="CalendarExceptionDto" Dense>
                    @foreach (var ex in Upcoming)
                    {
                        <FlareListItem @key="ex.Id" Primary="@ex.Reason" Secondary="@($"{ex.From:d MMM} — {ex.To:d MMM yyyy} · {AlvaFormat.Hours(ex.AvailableHours)} {Strings.T("ч/день")}")" />
                    }
                </FlareList>
                @if (Upcoming.Length == 0) { <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@(Strings.T("Отпусков не запланировано."))</FlareText> }
                <FlareButton Href="@($"capacity/{ActorId}/schedule")" Variant="ButtonVariant.Tonal" Size="ButtonSize.Sm"><LeadingIcon><FlareIconView Value="@MaterialDesign3Icons.Regular.Add" Size="18px" /></LeadingIcon><ChildContent>@(Strings.T("Отгул / отпуск"))</ChildContent></FlareButton>
            </FlareCardContent>
        </FlareCard>
    </aside>
</div>

@code {
    [Parameter, EditorRequired] public Guid ActorId { get; set; }

    private CalendarDto? _calendar;
    private ActorModel[] _actors = [];
    private TaskModel[] _tasks = [];
    private SprintModel[] _sprints = [];
    private CapacityDto[] _rows = [];
    private DateOnly _monday = Monday(DateOnly.FromDateTime(DateTime.Today));
    private string? _error;
    private bool _busy;
    private Guid _loadedFor;

    private static DateOnly Today => DateOnly.FromDateTime(DateTime.Today);
    private static DateOnly Monday(DateOnly d) => d.AddDays(-(((int)d.DayOfWeek + 6) % 7));
    private ActorModel? Person => _actors.FirstOrDefault(a => a.Id == ActorId);
    private IEnumerable<string> Tags => Person is null ? [] : _actors.Where(a => Person.RoleIds.Contains(a.Id) || Person.DepartmentIds.Contains(a.Id)).Select(a => a.Name);
    private SprintModel? SprintOfWeek => _sprints.Where(s => s.StartDate <= _monday.AddDays(6) && s.EndDate >= _monday).OrderBy(s => s.StartDate).FirstOrDefault();
    private static int Pct(decimal part, decimal whole) => whole <= 0 ? 0 : (int)Math.Round(part / whole * 100);

    private decimal Nominal(DateOnly d) => _calendar is null ? 0 : d.DayOfWeek switch
    {
        DayOfWeek.Monday => _calendar.Monday, DayOfWeek.Tuesday => _calendar.Tuesday, DayOfWeek.Wednesday => _calendar.Wednesday,
        DayOfWeek.Thursday => _calendar.Thursday, DayOfWeek.Friday => _calendar.Friday, DayOfWeek.Saturday => _calendar.Saturday, _ => _calendar.Sunday
    };
    private IEnumerable<RecurringBlockDto> Blocks(DateOnly d) => _calendar?.RecurringBlocks.Where(b => b.DayOfWeek == (int)d.DayOfWeek) ?? [];
    private IEnumerable<DateOnly> Week => Enumerable.Range(0, 7).Select(i => _monday.AddDays(i));
    private decimal WeekNominal => Week.Sum(Nominal);
    private decimal WeekBlocks => Week.Sum(d => Math.Min(Nominal(d), Blocks(d).Sum(b => b.Hours)));
    private decimal WeekAvailable => _rows.Sum(r => r.AvailableHours);
    private decimal WeekAllocated => _rows.Sum(r => r.AllocatedHours);
    private decimal WeekAbsence => Week.Where(d => _calendar?.Exceptions.Any(e => d >= e.From && d <= e.To) == true).Sum(d => Math.Max(0, Nominal(d) - _calendar!.Exceptions.Where(e => d >= e.From && d <= e.To).Min(e => e.AvailableHours)));
    private CalendarExceptionDto? NextAbsence => Upcoming.FirstOrDefault();
    private CalendarExceptionDto[] Upcoming => _calendar is null ? [] : _calendar.Exceptions.Where(e => e.To >= Today).OrderBy(e => e.From).ToArray();    private string Pattern
    {
        get
        {
            if (_calendar is null) return "—";
            var work = new[] { _calendar.Monday, _calendar.Tuesday, _calendar.Wednesday, _calendar.Thursday, _calendar.Friday, _calendar.Saturday, _calendar.Sunday }.Count(h => h > 0);
            return $"{work}/{7 - work}";
        }
    }

    private TaskModel[] Mine => _tasks.Where(t => (t.ResolvedPersonId ?? t.AssignmentTargetId) == ActorId && t.Status is not ("Cancelled")).ToArray();

    /// <summary>Окно задачи: её плановые даты, иначе дедлайн.</summary>
    private static (DateOnly From, DateOnly To)? Window(TaskModel t)
    {
        var from = t.StartDate ?? t.EndDate ?? t.Deadline;
        var to = t.EndDate ?? t.StartDate ?? t.Deadline ?? from;
        return from is null || to is null ? null : (from.Value, to.Value < from.Value ? from.Value : to.Value);
    }
    private TaskModel[] TasksOn(DateOnly d) => Nominal(d) == 0 ? [] : Mine.Where(t => t.Status != "Done" && Window(t) is { } w && d >= w.From && d <= w.To).ToArray();
    private TaskModel[] WeekTasks => Mine.Where(t => Window(t) is { } w && w.From <= _monday.AddDays(6) && w.To >= _monday).OrderBy(t => t.Status == "Done").ThenBy(t => t.Deadline ?? DateOnly.MaxValue).ToArray();

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedFor == ActorId) return;
        await Run(async () =>
        {
            _actors = await Session.Get<ActorModel[]>(Session.TeamPath("actors"));
            _tasks = await Session.Get<TaskModel[]>(Session.TeamPath("tasks"));
            _sprints = await Session.Get<SprintModel[]>(Session.TeamPath("sprints"));
            _calendar = await Session.Get<CalendarDto>(Session.TeamPath($"actors/{ActorId}/calendar"));
            // Праздники и встречи подкоманд действуют на сотрудника так же, как в расчёте ёмкости.
            var departments = _actors.Where(a => a.Kind == "Department").ToDictionary(a => a.Id, a => a.ParentId);
            if (Person is { } person)
            {
                var memberOf = CapacityMath.DepartmentsWithParents(person.DepartmentIds.Append(person.ParentId ?? Guid.Empty).Where(departments.ContainsKey),
                    id => departments.GetValueOrDefault(id) is { } parent && departments.ContainsKey(parent) ? parent : null);
                var shared = new List<CalendarDto>();
                foreach (var id in memberOf) shared.Add(await Session.Get<CalendarDto>(Session.TeamPath($"actors/{id}/calendar")));
                _calendar = CapacityMath.Combine(_calendar, shared);
            }
            await LoadWeek();
            _loadedFor = ActorId;
        });
    }

    private async Task LoadWeek() =>
        _rows = (await Session.Get<CapacityDto[]>(Session.TeamPath($"capacity?from={_monday:yyyy-MM-dd}&to={_monday.AddDays(6):yyyy-MM-dd}"))).Where(r => r.ActorId == ActorId).ToArray();

    private Task Shift(int days) { _monday = _monday.AddDays(days); return Run(LoadWeek); }
    private Task ThisWeek() { _monday = Monday(Today); return Run(LoadWeek); }

    private async Task Run(Func<Task> action)
    {
        _busy = true; _error = null;
        try { await action(); }
        catch (Exception e) when (e is HttpRequestException or InvalidOperationException or NotSupportedException) { _error = PageFeedback.Describe(e); }
        finally { _busy = false; }
    }
}
