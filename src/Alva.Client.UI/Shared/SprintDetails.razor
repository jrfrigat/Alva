@* Sprint page: header with cycle progress, risk and capacity KPIs, and the task table. *@
@inject AlvaSession Session
@if (!_loaded) { <LoadingSkeleton Height="18rem" /> }
else
{
<div @ref="_heading" tabindex="-1">
<AlvaPageHeader Title="@Sprint.Name">
    <EyebrowContent>
        <FlareStack Gap="FlareSpacing.Small">
            <FlareBreadcrumb Items="Crumbs" Separator="/" AriaLabel="@(AlvaStrings.Sprint_PathToTheSprint)" />
            <FlareStack Row Wrap Gap="FlareSpacing.XSmall">
                <AlvaStatusChip Tone="AlvaTones.Status(Sprint.Status)">@Labels.Status(Sprint.Status)@(Sprint.Status == "Active" ? string.Format(AlvaStrings.Sprint_DayOf, DayOf, AlvaFormat.WorkDays(Sprint.StartDate, Sprint.EndDate)) : "")</AlvaStatusChip>
                @if (Risks.Length > 0) { <AlvaStatusChip Tone="AlvaTone.Critical">@Risks.Length @AlvaFormat.Plural(Risks.Length, "task") @(AlvaStrings.Sprint_WithRisk)</AlvaStatusChip> }
            </FlareStack>
        </FlareStack>
    </EyebrowContent>
    <DescriptionContent>
        <FlareStack Gap="FlareSpacing.XSmall">
            @if (!string.IsNullOrWhiteSpace(Sprint.Goal))
            {
                <FlareText Element="p" Typo="TypographyScale.BodyLarge" Color="FlareColor.OnSurfaceVariant">@Sprint.Goal</FlareText>
            }
            <FlareStack Row Wrap Align="FlareAlignItems.Center" Gap="FlareSpacing.XSmall">
                <FlareIconView Value="@MaterialDesign3Icons.Regular.Timelapse" Size="16px" />
                <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">
                    @(AlvaStrings.Sprint_ClosedPrefix) <b>@AlvaFormat.Hours(HeadDone) @(AlvaStrings.Sprint_HoursShort)</b> @(AlvaStrings.Sprint_OutOf) @AlvaFormat.Hours(HeadTotal) @(AlvaStrings.Sprint_HoursShort) (@Percent(HeadDone, HeadTotal)%)
                </FlareText>
            </FlareStack>
            <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@AlvaFormat.Period(Sprint.StartDate, Sprint.EndDate)</FlareText>
            @if (Sprint.Commitment is { } committed) { <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@(AlvaStrings.Sprint_CommitmentAtStart) <b>@committed.Tasks @AlvaFormat.Plural(committed.Tasks, "task"), @AlvaFormat.Hours(committed.Hours) @(AlvaStrings.Sprint_HoursShort)</b> · @committed.At.ToLocalTime().ToString("d MMM")</FlareText> }
            @if (Sprint.Result is { } result)
            {
                <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@(AlvaStrings.Sprint_ResultAtClosing) <b>@AlvaFormat.Hours(result.DoneHours) @(AlvaStrings.Sprint_OutOf) @AlvaFormat.Hours(result.Hours) @(AlvaStrings.Sprint_HoursShort)</b> · @result.At.ToLocalTime().ToString("d MMM")</FlareText>
                @if (Done != result.DoneHours) { <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@(AlvaStrings.Sprint_TasksChangedAfterClosingNow) @AlvaFormat.Hours(Done) @(AlvaStrings.Sprint_OutOf) @AlvaFormat.Hours(Total) @(AlvaStrings.Sprint_HoursShort)</FlareText> }
            }
        </FlareStack>
    </DescriptionContent>
    <Actions>
        <FlareStack Row Wrap Gap="FlareSpacing.Small">
            <FlareButton Variant="ButtonVariant.Tonal" Size="ButtonSize.Sm" OnClick="Edit">
                <LeadingIcon><FlareIconView Value="@MaterialDesign3Icons.Regular.Tune" Size="18px" /></LeadingIcon>
                <ChildContent>@(AlvaStrings.Sprint_EditTheMembership)</ChildContent>
            </FlareButton>
            @if (Sprint.Status == "Active")
            {
                <FlareButton Size="ButtonSize.Sm" Variant="ButtonVariant.Outlined" Loading="_busy" OnClick="OpenClose">
                    <LeadingIcon><FlareIconView Value="@MaterialDesign3Icons.Regular.CheckCircle" Size="18px" /></LeadingIcon>
                    <ChildContent>@(AlvaStrings.Sprint_CompleteSprint)</ChildContent>
                </FlareButton>
            }
        </FlareStack>
    </Actions>
</AlvaPageHeader>
</div>

<FlareCard Variant="CardVariant.Filled">
    <FlareCardContent>
        <FlareStack Gap="FlareSpacing.Small">
            <FlareStack Row StretchFirst Align="FlareAlignItems.Baseline">
                <FlareText Typo="TypographyScale.LabelMedium" Color="FlareColor.OnSurfaceVariant">@(AlvaStrings.Sprint_OverallSprintPace)</FlareText>
                <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.Primary">@Percent(Done, Total)% (@AlvaFormat.Hours(Done)/@AlvaFormat.Hours(Total) @(AlvaStrings.Sprint_HoursShort))</FlareText>
            </FlareStack>
            <FlareMeter Size="TrackSize.Sm" aria-label="@string.Format(AlvaStrings.Sprint_ClosedHInProgressHRemainingH, AlvaFormat.Hours(Done), AlvaFormat.Hours(InWork), AlvaFormat.Hours(Total - Done))">
                <FlareMeterSegment Value="@((double)Math.Max(0, Done))" Color="FlareColor.Primary" />
                <FlareMeterSegment Value="@((double)Math.Max(0, InWork))" Color="FlareColor.Secondary" />
                <FlareMeterSegment Value="@((double)Math.Max(0, Total - Done - InWork))" Color="FlareColor.OnSurfaceVariant" />
            </FlareMeter>
            <FlareStack Row Wrap Gap="FlareSpacing.XSmall">
                <FlareChip Size="ChipSize.Sm" Variant="ChipVariant.Filled" Color="FlareColor.Primary" Label="@($"{AlvaStrings.Sprint_CompletedPrefix} {AlvaFormat.Hours(Done)} {AlvaStrings.Sprint_HoursShort}")" />
                <FlareChip Size="ChipSize.Sm" Variant="ChipVariant.Filled" Color="FlareColor.Secondary" Label="@($"{AlvaStrings.Sprint_InProgress} {AlvaFormat.Hours(InWork)} {AlvaStrings.Sprint_HoursShort}")" />
                <FlareChip Size="ChipSize.Sm" Variant="ChipVariant.Filled" Label="@($"{AlvaStrings.Sprint_RemainingPrefix} {AlvaFormat.Hours(Total - Done)} {AlvaStrings.Sprint_HoursShort}")" />
            </FlareStack>
        </FlareStack>
    </FlareCardContent>
</FlareCard>
<PageFeedback Error="@_error" />

<FlareGrid MinColumnWidth="min(100%,15rem)">
    <FlareStat Label="@(AlvaStrings.Sprint_Remaining)" Value="@($"{AlvaFormat.Hours(Total - Done)} {AlvaStrings.Sprint_HoursShort}")" Icon="@MaterialDesign3Icons.Regular.TrendingDown">
        <CaptionContent>
            <FlareStack Gap="FlareSpacing.XSmall">
                @if (Sprint.Status == "Completed")
                {
                    <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@(AlvaStrings.Sprint_SprintClosed) @(Sprint.Result is { } closed ? $"{AlvaStrings.Sprint_OpenAtClosing} {AlvaFormat.Hours(closed.Hours - closed.DoneHours)} {AlvaStrings.Sprint_HoursShort}." : "")</FlareText>
                }
                else
                {
                    <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@(AlvaStrings.Sprint_RemainingDays) @DaysLeft @(AlvaStrings.Sprint_Work) @AlvaFormat.Plural(DaysLeft, "day"); @(AlvaStrings.Sprint_RequiredPace) — @(DaysLeft > 0 ? AlvaFormat.Hours(Math.Round((Total - Done) / DaysLeft, 1)) : "—") @(AlvaStrings.Capacity_HoursPerDayShort).</FlareText>
                }
                <FlareStack Row StretchFirst>
                    <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@(AlvaStrings.Sprint_Plan) @AlvaFormat.Hours(Total) @(AlvaStrings.Sprint_HoursShort)</FlareText>
                    <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@(AlvaStrings.Sprint_Tasks) @SprintTasks.Length</FlareText>
                </FlareStack>
            </FlareStack>
        </CaptionContent>
    </FlareStat>

    <FlareStat Label="@(AlvaStrings.Sprint_RiskFactors)" Value="@Risks.Length.ToString()" Unit="@AlvaFormat.Plural(Risks.Length, "task")" Icon="@MaterialDesign3Icons.Regular.Warning">
        <CaptionContent>
            <FlareStack Gap="FlareSpacing.XSmall">
                @if (Risks.Length == 0) { <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@(AlvaStrings.Sprint_AlvaSeesNoDeadlineRisksInTheSprintSTasks)</FlareText> }
                @foreach (var reason in Risks.SelectMany(r => r.Reasons).GroupBy(r => r).OrderByDescending(g => g.Count()).Take(3))
                {
                    <FlareStack Row StretchFirst>
                        <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@ReasonText.Describe(reason.Key)</FlareText>
                        <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.Error">@reason.Count()</FlareText>
                    </FlareStack>
                }
                @if (Risks.Length > 0) { <FlareLink Href="analytics">@(AlvaStrings.Common_AllRisks) (@Risks.Length)</FlareLink> }
                @if (Risks.Length > 0)
                {
                    var high = Risks.Any(r => string.Equals(r.Severity, "High", StringComparison.OrdinalIgnoreCase));
                    <AlvaStatusChip Tone="@(high ? AlvaTone.Critical : AlvaTone.Warning)">@(high ? AlvaStrings.Sprint_High : AlvaStrings.Sprint_Medium)</AlvaStatusChip>
                }
            </FlareStack>
        </CaptionContent>
    </FlareStat>

    <FlareStat Label="@(AlvaStrings.Sprint_CapacityAndWorkload)" Value="@($"{Percent(_load.Values.Sum(l => l.Allocated), _load.Values.Sum(l => l.Available))}%")" Unit="@(AlvaStrings.Sprint_Overall)" Icon="@MaterialDesign3Icons.Regular.Groups">
        <CaptionContent>
            <FlareStack Gap="FlareSpacing.XSmall">
                @foreach (var (actor, pct) in People.Take(3))
                {
                    <FlareStack Gap="FlareSpacing.XXSmall">
                        <FlareStack Row StretchFirst>
                            <FlareLink Href="@($"capacity/{actor.Id}")">@actor.Name</FlareLink>
                            <FlareText Typo="TypographyScale.BodySmall" Color="@ToneColor(pct)">@LoadText(actor.Id, pct)</FlareText>
                        </FlareStack>
                        <FlareProgressLinear Value="@Math.Min(100, pct)" Size="TrackSize.Xs" Color="@ToneColor(pct)" aria-label="@string.Format(AlvaStrings.Common_Load, actor.Name)" />
                    </FlareStack>
                }
                @if (People.Length > 3) { <FlareLink Href="capacity">@(AlvaStrings.Sprint_AllPeople) (@People.Length)</FlareLink> }
                @if (People.Length == 0) { <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@(AlvaStrings.Sprint_NoPeopleSchedulesForTheSprintPeriod)</FlareText> }
                @if (People.LastOrDefault() is { Actor: { } free } && _load.TryGetValue(free.Id, out var freeLoad) && freeLoad.Available > freeLoad.Allocated)
                {
                    <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.Primary">@(AlvaStrings.Sprint_CapacityReserveCaption) @free.Name (+@AlvaFormat.Hours(freeLoad.Available - freeLoad.Allocated) @(AlvaStrings.Sprint_HoursShort))</FlareText>
                }
            </FlareStack>
        </CaptionContent>
    </FlareStat>

    <FlareStat Label="@(AlvaStrings.Sprint_ProjectsInTheSprint)" Value="@Shares.Length.ToString()" Unit="@AlvaFormat.Plural(Shares.Length, "project")" Icon="@MaterialDesign3Icons.Regular.FolderSpecial">
        <CaptionContent>
            <FlareStack Gap="FlareSpacing.XSmall">
                @foreach (var (name, share) in Shares)
                {
                    <FlareStack Row Align="FlareAlignItems.Center" Gap="FlareSpacing.Small">
                        <FlareText Typo="TypographyScale.BodySmall">@name</FlareText>
                        <FlareProgressLinear Value="@share" Size="TrackSize.Xs" Color="FlareColor.Primary" aria-label="@string.Format(AlvaStrings.Sprint_ProjectShare, name)" />
                        <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@share%</FlareText>
                    </FlareStack>
                }
            </FlareStack>
        </CaptionContent>
    </FlareStat>
</FlareGrid>

<FlareCard Variant="CardVariant.Outlined">
    <FlareCardHeader Title="@(AlvaStrings.Sprint_TasksInTheIteration)">
        <ActionContent>
            <FlareToggleGroup TValue="string" Value="@_filter" ValueChanged="SetFilter" Size="ButtonSize.Sm" Mandatory AriaLabel="@(AlvaStrings.Sprint_QuickFilter)">
                @foreach (var (key, label) in Filters)
                {
                    <FlareToggleButton Value="@key">@label (@Filtered(key).Count())</FlareToggleButton>
                }
            </FlareToggleGroup>
        </ActionContent>
    </FlareCardHeader>
    <FlareCardContent>
        <FlareDataGrid TItem="TaskModel" Items="Filtered(_filter)" Height="auto" Dense="true" RowKey="t => t!.Id" Presentation="DataGridPresentation.Auto">
            <Columns>
                <FlareColumn TItem="TaskModel" Title="@(AlvaStrings.Common_Task)" Sortable Field="t => t!.Title" SortKey="title">
                    <Template Context="task">
                        <FlareStack Gap="FlareSpacing.None">
                            <FlareLink Href="@($"tasks/{task!.Id}")">@task.Title</FlareLink>
                            <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@AlvaFormat.Code(task.Id)@(task.Deadline.HasValue ? string.Format(AlvaStrings.Sprint_Deadline, task.Deadline) : "")@(Risks.Any(r => r.TaskId == task.Id) ? AlvaStrings.Sprint_AtRisk : "")</FlareText>
                        </FlareStack>
                    </Template>
                </FlareColumn>
                <FlareColumn TItem="TaskModel" Title="@(AlvaStrings.Common_Project)" Sortable Field="t => ProjectName(t!.ProjectId)" SortKey="project">
                    <Template Context="task"><FlareChip Size="ChipSize.Sm" Label="@ProjectName(task!.ProjectId)" /></Template>
                </FlareColumn>
                <FlareColumn TItem="TaskModel" Title="@(AlvaStrings.Risks_Assignee)">
                    <Template Context="task">
                        <AlvaAssignee Task="task!" Actors="_actors" Load="@(Assignees.Person(task!, _actors) is { } p && _load.ContainsKey(p) ? LoadOf(p) : null)" />
                    </Template>
                </FlareColumn>
                <FlareColumn TItem="TaskModel" Title="@(AlvaStrings.Common_Estimate)" Sortable Field="t => Hours(t!)" SortKey="estimate">
                    <Template Context="task"><FlareText Typo="TypographyScale.BodySmall">@EstimateText(task!)</FlareText></Template>
                </FlareColumn>
                <FlareColumn TItem="TaskModel" Title="@(AlvaStrings.Common_Status)" Sortable Field="t => t!.Status" SortKey="status">
                    <Template Context="task"><AlvaStatusChip Tone="AlvaTones.Status(task!.Status)">@Labels.Status(task.Status)</AlvaStatusChip></Template>
                </FlareColumn>
            </Columns>
            <EmptyStateContent>
                <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@(AlvaStrings.Sprint_NoTasksMatchThisFilter)</FlareText>
            </EmptyStateContent>
        </FlareDataGrid>
        <FlareStack Row Wrap StretchFirst Align="FlareAlignItems.Center" Gap="FlareSpacing.Small">
            <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@(AlvaStrings.Sprint_SelectionTotalsPlan) <b>@AlvaFormat.Hours(Filtered(_filter).Sum(Hours)) @(AlvaStrings.Sprint_HoursShort)</b> @(AlvaStrings.Sprint_Closed) <b>@AlvaFormat.Hours(Filtered(_filter).Where(t => t.Status == "Done").Sum(Hours)) @(AlvaStrings.Sprint_HoursShort)</b> @(AlvaStrings.Sprint_TasksAtRisk) <b>@Filtered(_filter).Count(t => Risks.Any(r => r.TaskId == t.Id))</b></FlareText>
            <FlareButton Size="ButtonSize.Sm" OnClick="Edit">
                <LeadingIcon><FlareIconView Value="@MaterialDesign3Icons.Regular.Add" Size="18px" /></LeadingIcon>
                <ChildContent>@(AlvaStrings.Sprint_AddATaskToTheSprint)</ChildContent>
            </FlareButton>
        </FlareStack>
    </FlareCardContent>
</FlareCard>

<FlareDialog @bind-Visible="_closing" Title="@($"{AlvaStrings.Sprint_CompleteSprint} «{Sprint.Name}»")" Size="DialogSize.Lg" Divider>
    <ChildContent>
        @if (Open.Length == 0)
        {
            <FlareText Element="p" Typo="TypographyScale.BodyMedium">@(AlvaStrings.Sprint_AllSprintTasksAreFinishedTheResultIsSavedOnClosing)</FlareText>
        }
        else
        {
            <FlareText Element="p" Typo="TypographyScale.BodyMedium">@(AlvaStrings.Sprint_UnfinishedTasks) <b>@Open.Length (@AlvaFormat.Hours(Open.Sum(Hours)) @(AlvaStrings.Sprint_HoursShort))</b>. @(AlvaStrings.Sprint_DecideWhatToDoWithEachOneTheSprintResultIsSavedBeforeAnythingMoves)</FlareText>
            @if (NextChoices.Length > 0)
            {
                <FlareSelect TValue="Guid?" Label="@(AlvaStrings.Sprint_NextSprintToMoveWorkInto)" Items="NextChoices.Select(s => (Guid?)s.Id)" ItemLabel="NextLabel" @bind-Value="_next" />
            }
            <FlareList TItem="TaskModel" Dense>
                @foreach (var task in Open)
                {
                    <FlareListItem @key="task.Id">
                        <ChildContent>
                            <FlareStack Gap="FlareSpacing.None">
                                <FlareLink Href="@($"tasks/{task.Id}")">@task.Title</FlareLink>
                                <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@Labels.Status(task.Status) · @EstimateText(task)</FlareText>
                            </FlareStack>
                        </ChildContent>
                        <Trailing>
                            <FlareSelect TValue="string" Label="@(AlvaStrings.Sprint_Action)" Items="Actions" ItemLabel="ActionLabel" Value="@Decision(task)" ValueChanged="(string value) => _decisions[task.Id] = value" Size="FieldSize.Sm" />
                        </Trailing>
                    </FlareListItem>
                }
            </FlareList>
            <FlareText Element="p" Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@CloseSummary</FlareText>
        }
    </ChildContent>
    <ActionsContent>
        <FlareButton Variant="ButtonVariant.Text" OnClick="() => _closing = false">@(AlvaStrings.Common_Cancel)</FlareButton>
        <FlareButton Loading="_busy" Disabled="@(Open.Any(t => Decision(t) == SprintCarry.Next) && _next is null)" OnClick="Complete">@(AlvaStrings.Sprint_CompleteSprint)</FlareButton>
    </ActionsContent>
</FlareDialog>
}

@code {
    [Parameter, EditorRequired] public SprintModel Sprint { get; set; } = default!;
    [Parameter] public TaskModel[] Tasks { get; set; } = [];
    /// <summary>Team sprints: the remaining work is carried into one of the unfinished ones.</summary>
    [Parameter] public SprintModel[] Sprints { get; set; } = [];

    private bool _closing;
    private Guid? _next;
    private ElementReference _heading;
    private bool _focused;
    private readonly Dictionary<Guid, string> _decisions = [];
    /// <summary>Unfinished sprint tasks - each one needs a decision when the sprint is closed.</summary>
    private TaskModel[] Open => SprintTasks.Where(t => t.Status != "Done").ToArray();
    private SprintModel[] NextChoices => Sprints.Where(s => s.Id != Sprint.Id && s.Status != "Completed" && s.EndDate >= Sprint.StartDate).OrderBy(s => s.StartDate).ToArray();
    private string NextLabel(Guid? id) => Sprints.FirstOrDefault(s => s.Id == id) is { } s ? $"{s.Name} ({AlvaFormat.Period(s.StartDate, s.EndDate)})" : "";
    private string[] Actions => NextChoices.Length > 0 ? [SprintCarry.Next, SprintCarry.Backlog, SprintCarry.Done] : [SprintCarry.Backlog, SprintCarry.Done];
    private static string ActionLabel(string action) => action switch
    {
        SprintCarry.Next => AlvaStrings.Sprint_ToTheNextSprint,
        SprintCarry.Backlog => AlvaStrings.Sprint_BackToThePool,
        _ => AlvaStrings.Sprint_MarkAsDone
    };
    // By default - a safe return to the pool, not a carry-over to the next sprint: the decision must be explicit.
    private string Decision(TaskModel task) => _decisions.TryGetValue(task.Id, out var action) && Actions.Contains(action) ? action : SprintCarry.Backlog;
    private string CloseSummary => string.Join(" · ", Actions
        .Select(a => (Label: ActionLabel(a), Hours: Open.Where(t => Decision(t) == a).Sum(Hours)))
        .Where(x => x.Hours > 0).Select(x => string.Format(AlvaStrings.Sprint_LabelWithHours, x.Label, AlvaFormat.Hours(x.Hours))));

    private void OpenClose()
    {
        _decisions.Clear();
        _next = NextChoices.FirstOrDefault(s => s.StartDate > Sprint.EndDate)?.Id ?? NextChoices.FirstOrDefault()?.Id;
        _closing = true;
    }

    /// <summary>Open editing of the scope (sprint planning).</summary>
    [Parameter] public EventCallback OnEdit { get; set; }

    /// <summary>The sprint changed (for example, was completed) - the page reloads the data.</summary>
    [Parameter] public EventCallback Changed { get; set; }

    private static readonly (string Key, string Label)[] Filters = [("all", AlvaStrings.Sprint_All), ("risk", AlvaStrings.Sprint_WithRisks), ("unassigned", AlvaStrings.Sprint_Unassigned), ("work", AlvaStrings.Common_InProgress)];
    private RiskDto[] _risks = [];
    private ActorModel[] _actors = [];
    private ProjectModel[] _projects = [];
    private Dictionary<Guid, (decimal Available, decimal Allocated)> _load = [];
    private string _filter = "all";
    private string? _error;
    private bool _loaded;
    private bool _busy;
    private Guid _loadedFor;

    private static DateOnly Today => DateOnly.FromDateTime(DateTime.Today);
    private TaskModel[] SprintTasks => Tasks.Where(t => t.SprintIds.Contains(Sprint.Id) && t.Status != "Cancelled").OrderBy(t => t.Order).ToArray();
    private RiskDto[] Risks => _risks.Where(r => SprintTasks.Any(t => t.Id == r.TaskId)).ToArray();
    // Task hours in this sprint: a task spanning sprint boundaries splits its estimate between them (SprintWindows.Share).
    private decimal Hours(TaskModel t) => SprintHours.Of(t, Sprint);
    private decimal Total => SprintTasks.Sum(Hours);
    private decimal Done => SprintTasks.Where(t => t.Status == "Done").Sum(Hours);
    private decimal InWork => SprintTasks.Where(t => t.Status == "InProgress").Sum(Hours);
    // A closed sprint shows the result at closing: the carried-over remaining work has already left it, but it was part of its history.
    private decimal HeadDone => Sprint.Result?.DoneHours ?? Done;
    private decimal HeadTotal => Sprint.Result?.Hours ?? Total;
    private int DayOf => AlvaFormat.SprintDay(Sprint.StartDate, Sprint.EndDate, Today);
    private int DaysLeft => AlvaFormat.SprintDaysLeft(Sprint.StartDate, Sprint.EndDate, Today);
    private static int Percent(decimal part, decimal whole) => whole <= 0 ? 0 : (int)Math.Round(part / whole * 100);
    private static FlareColor ToneColor(int pct) => pct > 100 ? FlareColor.Error : pct > 80 ? FlareColor.Primary : FlareColor.Success;
    private int LoadOf(Guid id) => Percent(_load[id].Allocated, _load[id].Available);
    // The percentage is the share of booked time; free hours or overload are shown next to it so the number is not read as "N% free".
    private string LoadText(Guid id, int pct)
    {
        var (available, allocated) = _load[id];
        var rest = available - allocated;
        return $"{AlvaStrings.Sprint_Busy} {pct}% · {(rest >= 0 ? AlvaStrings.Common_FreeLower : AlvaStrings.Common_Overload)} {AlvaFormat.Hours(Math.Abs(rest))} {AlvaStrings.Sprint_HoursShort}";
    }
    /// <summary>Estimate in the table: the sprint share and, if the task continues beyond it, its full volume.</summary>
    private string EstimateText(TaskModel t) => t.EstimateHours is not { } all ? "—"
        : Hours(t) is var part && part < all ? $"{AlvaFormat.Hours(part)} {AlvaStrings.Sprint_OutOf} {AlvaFormat.Hours(all)} {AlvaStrings.Sprint_HoursShort}" : $"{AlvaFormat.Hours(all)} {AlvaStrings.Sprint_HoursShort}";
    private string ProjectName(Guid? id) => _projects.FirstOrDefault(p => p.Id == id)?.Name ?? AlvaStrings.Sprint_Ongoing;

    private IEnumerable<BreadcrumbItem> Crumbs => [new(AlvaStrings.Sprint_Sprints, "sprints"), new(Sprint.Name)];

    /// <summary>Sprint people (assignees of its tasks) by descending load over the sprint window.</summary>
    private (ActorModel Actor, int Pct)[] People => _actors
        .Where(a => a.Kind == "Person" && _load.ContainsKey(a.Id) && SprintTasks.Any(t => t.ResolvedPersonId == a.Id || t.AssignmentTargetId == a.Id))
        .Select(a => (a, LoadOf(a.Id))).OrderByDescending(x => x.Item2).ToArray();

    private (string Name, int Share)[] Shares => SprintTasks.GroupBy(t => t.ProjectId)
        .Select(g => (ProjectName(g.Key), Percent(g.Sum(Hours), Total)))
        .OrderByDescending(x => x.Item2).ToArray();

    private IEnumerable<TaskModel> Filtered(string key) => key switch
    {
        "risk" => SprintTasks.Where(t => _risks.Any(r => r.TaskId == t.Id)),
        "unassigned" => SprintTasks.Where(t => Assignees.Person(t, _actors) is null),
        "work" => SprintTasks.Where(t => t.Status == "InProgress"),
        _ => SprintTasks
    };

    private void SetFilter(string? value) => _filter = value ?? "all";

    // The page takes focus when the data has loaded: after navigation the person is not left on body.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focused || !_loaded) return;
        _focused = true;
        try { await _heading.FocusAsync(preventScroll: true); }
        catch (JSDisconnectedException) { }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedFor == Sprint.Id) { _loaded = true; return; }
        try
        {
            _risks = (await Session.Get<RiskDto[]>(Session.TeamPath("risks"))).Where(r => r.HasRisk).ToArray();
            _actors = await Session.Get<ActorModel[]>(Session.TeamPath("actors"));
            _projects = await Session.Get<ProjectModel[]>(Session.TeamPath("projects"));
            var rows = await Session.Get<CapacityDto[]>(Session.TeamPath($"capacity?from={Sprint.StartDate:yyyy-MM-dd}&to={Sprint.EndDate:yyyy-MM-dd}"));
            _load = rows.GroupBy(r => r.ActorId).ToDictionary(g => g.Key, g => (g.Sum(r => r.AvailableHours), g.Sum(r => r.AllocatedHours)));
            _loadedFor = Sprint.Id;
        }
        catch (Exception e) when (e is HttpRequestException or InvalidOperationException or NotSupportedException) { _error = PageFeedback.Describe(e); }
        finally { _loaded = true; }
    }

    private Task Edit() => OnEdit.InvokeAsync();

    private async Task Complete()
    {
        _busy = true; _error = null;
        try
        {
            // Closing and carrying over the remaining work are one server operation: the result is fixed before the tasks leave the sprint.
            var moves = Open.Select(t => new SprintCarryDto(t.Id, Decision(t))).ToArray();
            await Session.Save<SprintModel>(HttpMethod.Post, Session.TeamPath($"sprints/{Sprint.Id}/close"), new SprintCloseRequest(moves, moves.Any(m => m.Action == SprintCarry.Next) ? _next : null));
            _closing = false;
            await Changed.InvokeAsync();
        }
        catch (Exception e) when (e is HttpRequestException or InvalidOperationException) { _error = PageFeedback.Describe(e); }
        finally { _busy = false; }
    }
}
