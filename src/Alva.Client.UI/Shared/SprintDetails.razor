@* Страница спринта по макету p7: шапка с ходом цикла, KPI риска и ёмкости, таблица задач. *@
@inject AlvaSession Session
@if (!_loaded) { <LoadingSkeleton Height="18rem" /> }
else
{
<div @ref="_heading" tabindex="-1">
<FlarePageHeader Title="@Sprint.Name">
    <EyebrowContent>
        <FlareStack Gap="FlareSpacing.Small">
            <FlareBreadcrumb Items="Crumbs" Separator="/" AriaLabel="@(Strings.T("Путь к спринту"))" />
            <FlareStack Row Wrap Gap="FlareSpacing.XSmall">
                <AlvaStatusChip Tone="AlvaTones.Status(Sprint.Status)">@Labels.Status(Sprint.Status)@(Sprint.Status == "Active" ? string.Format(Strings.T(" (день {0} из {1})"), DayOf, AlvaFormat.WorkDays(Sprint.StartDate, Sprint.EndDate)) : "")</AlvaStatusChip>
                @if (Risks.Length > 0) { <AlvaStatusChip Tone="AlvaTone.Critical">@Risks.Length @AlvaFormat.Plural(Risks.Length, "task") @(Strings.T("с риском"))</AlvaStatusChip> }
            </FlareStack>
        </FlareStack>
    </EyebrowContent>
    <DescriptionContent>
        <FlareStack Gap="FlareSpacing.XSmall">
            @if (!string.IsNullOrWhiteSpace(Sprint.Goal))
            {
                <FlareText Element="p" Typo="TypographyScale.BodyLarge" Color="FlareColor.OnSurfaceVariant">@Sprint.Goal</FlareText>
            }
            <FlareStack Row Wrap Align="FlareAlignItems.Center" Gap="FlareSpacing.XSmall">
                <FlareIconView Value="@MaterialDesign3Icons.Regular.Timelapse" Size="16px" />
                <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">
                    @(Strings.T("Закрыто:")) <b>@AlvaFormat.Hours(HeadDone) @(Strings.T("ч"))</b> @(Strings.T("из")) @AlvaFormat.Hours(HeadTotal) @(Strings.T("ч")) (@Percent(HeadDone, HeadTotal)%)
                </FlareText>
            </FlareStack>
            <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@AlvaFormat.Period(Sprint.StartDate, Sprint.EndDate)</FlareText>
            @if (Sprint.Commitment is { } committed) { <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@(Strings.T("Обязательство при старте:")) <b>@committed.Tasks @AlvaFormat.Plural(committed.Tasks, "task"), @AlvaFormat.Hours(committed.Hours) @(Strings.T("ч"))</b> · @committed.At.ToLocalTime().ToString("d MMM")</FlareText> }
            @if (Sprint.Result is { } result)
            {
                <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@(Strings.T("Итог при закрытии:")) <b>@AlvaFormat.Hours(result.DoneHours) @(Strings.T("из")) @AlvaFormat.Hours(result.Hours) @(Strings.T("ч"))</b> · @result.At.ToLocalTime().ToString("d MMM")</FlareText>
                @if (Done != result.DoneHours) { <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@(Strings.T("После закрытия задачи изменились: сейчас")) @AlvaFormat.Hours(Done) @(Strings.T("из")) @AlvaFormat.Hours(Total) @(Strings.T("ч"))</FlareText> }
            }
        </FlareStack>
    </DescriptionContent>
    <ActionsContent>
        <FlareStack Row Wrap Gap="FlareSpacing.Small">
            <FlareButton Variant="ButtonVariant.Tonal" Size="ButtonSize.Sm" OnClick="Edit">
                <LeadingIcon><FlareIconView Value="@MaterialDesign3Icons.Regular.Tune" Size="18px" /></LeadingIcon>
                <ChildContent>@(Strings.T("Редактировать состав"))</ChildContent>
            </FlareButton>
            @if (Sprint.Status == "Active")
            {
                <FlareButton Size="ButtonSize.Sm" Variant="ButtonVariant.Outlined" Loading="_busy" OnClick="OpenClose">
                    <LeadingIcon><FlareIconView Value="@MaterialDesign3Icons.Regular.CheckCircle" Size="18px" /></LeadingIcon>
                    <ChildContent>@(Strings.T("Завершить спринт"))</ChildContent>
                </FlareButton>
            }
        </FlareStack>
    </ActionsContent>
</FlarePageHeader>
</div>

<FlareCard Variant="CardVariant.Filled">
    <FlareCardContent>
        <FlareStack Gap="FlareSpacing.Small">
            <FlareStack Row StretchFirst Align="FlareAlignItems.Baseline">
                <FlareText Typo="TypographyScale.LabelMedium" Color="FlareColor.OnSurfaceVariant">@(Strings.T("Общий темп выполнения спринта"))</FlareText>
                <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.Primary">@Percent(Done, Total)% (@AlvaFormat.Hours(Done)/@AlvaFormat.Hours(Total) @(Strings.T("ч")))</FlareText>
            </FlareStack>
            <FlareMeter Size="TrackSize.Sm" aria-label="@string.Format(Strings.T("Закрыто {0} ч, в работе {1} ч, остаток {2} ч"), AlvaFormat.Hours(Done), AlvaFormat.Hours(InWork), AlvaFormat.Hours(Total - Done))">
                <FlareMeterSegment Value="@((double)Math.Max(0, Done))" Color="FlareColor.Primary" />
                <FlareMeterSegment Value="@((double)Math.Max(0, InWork))" Color="FlareColor.Secondary" />
                <FlareMeterSegment Value="@((double)Math.Max(0, Total - Done - InWork))" Color="FlareColor.OnSurfaceVariant" />
            </FlareMeter>
            <FlareStack Row Wrap Gap="FlareSpacing.XSmall">
                <FlareChip Size="ChipSize.Sm" Variant="ChipVariant.Filled" Color="FlareColor.Primary" Label="@($"{Strings.T("Завершено:")} {AlvaFormat.Hours(Done)} {Strings.T("ч")}")" />
                <FlareChip Size="ChipSize.Sm" Variant="ChipVariant.Filled" Color="FlareColor.Secondary" Label="@($"{Strings.T("В работе:")} {AlvaFormat.Hours(InWork)} {Strings.T("ч")}")" />
                <FlareChip Size="ChipSize.Sm" Variant="ChipVariant.Filled" Label="@($"{Strings.T("Остаток:")} {AlvaFormat.Hours(Total - Done)} {Strings.T("ч")}")" />
            </FlareStack>
        </FlareStack>
    </FlareCardContent>
</FlareCard>
<PageFeedback Error="@_error" />

<FlareGrid MinColumnWidth="min(100%,15rem)">
    <FlareStat Label="@(Strings.T("Остаток"))" Value="@($"{AlvaFormat.Hours(Total - Done)} {Strings.T("ч")}")" Icon="@MaterialDesign3Icons.Regular.TrendingDown">
        <CaptionContent>
            <FlareStack Gap="FlareSpacing.XSmall">
                @if (Sprint.Status == "Completed")
                {
                    <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@(Strings.T("Спринт закрыт.")) @(Sprint.Result is { } closed ? $"{Strings.T("Не закрыто при закрытии:")} {AlvaFormat.Hours(closed.Hours - closed.DoneHours)} {Strings.T("ч")}." : "")</FlareText>
                }
                else
                {
                    <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@(Strings.T("Осталось")) @DaysLeft @(Strings.T("раб.")) @AlvaFormat.Plural(DaysLeft, "day"); @(Strings.T("нужный темп")) — @(DaysLeft > 0 ? AlvaFormat.Hours(Math.Round((Total - Done) / DaysLeft, 1)) : "—") @(Strings.T("ч/день")).</FlareText>
                }
                <FlareStack Row StretchFirst>
                    <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@(Strings.T("План:")) @AlvaFormat.Hours(Total) @(Strings.T("ч"))</FlareText>
                    <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@(Strings.T("Задач:")) @SprintTasks.Length</FlareText>
                </FlareStack>
            </FlareStack>
        </CaptionContent>
    </FlareStat>

    <FlareStat Label="@(Strings.T("Факторы риска"))" Value="@Risks.Length.ToString()" Unit="@AlvaFormat.Plural(Risks.Length, "task")" Icon="@MaterialDesign3Icons.Regular.Warning">
        <CaptionContent>
            <FlareStack Gap="FlareSpacing.XSmall">
                @if (Risks.Length == 0) { <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@(Strings.T("Alva не видит рисков срыва по задачам спринта."))</FlareText> }
                @foreach (var reason in Risks.SelectMany(r => r.Reasons).GroupBy(r => r).OrderByDescending(g => g.Count()).Take(3))
                {
                    <FlareStack Row StretchFirst>
                        <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@ReasonText.Describe(reason.Key)</FlareText>
                        <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.Error">@reason.Count()</FlareText>
                    </FlareStack>
                }
                @if (Risks.Length > 0) { <FlareLink Href="analytics">@(Strings.T("Все риски")) (@Risks.Length)</FlareLink> }
                @if (Risks.Length > 0)
                {
                    var high = Risks.Any(r => string.Equals(r.Severity, "High", StringComparison.OrdinalIgnoreCase));
                    <AlvaStatusChip Tone="@(high ? AlvaTone.Critical : AlvaTone.Warning)">@(high ? Strings.T("Высокая") : Strings.T("Средняя"))</AlvaStatusChip>
                }
            </FlareStack>
        </CaptionContent>
    </FlareStat>

    <FlareStat Label="@(Strings.T("Ёмкость и загрузка"))" Value="@($"{Percent(_load.Values.Sum(l => l.Allocated), _load.Values.Sum(l => l.Available))}%")" Unit="@(Strings.T("общая"))" Icon="@MaterialDesign3Icons.Regular.Groups">
        <CaptionContent>
            <FlareStack Gap="FlareSpacing.XSmall">
                @foreach (var (actor, pct) in People.Take(3))
                {
                    <FlareStack Gap="FlareSpacing.XXSmall">
                        <FlareStack Row StretchFirst>
                            <FlareLink Href="@($"capacity/{actor.Id}")">@actor.Name</FlareLink>
                            <FlareText Typo="TypographyScale.BodySmall" Color="@ToneColor(pct)">@LoadText(actor.Id, pct)</FlareText>
                        </FlareStack>
                        <FlareProgressLinear Value="@Math.Min(100, pct)" Size="TrackSize.Xs" Color="@ToneColor(pct)" aria-label="@string.Format(Strings.T("Загрузка: {0}"), actor.Name)" />
                    </FlareStack>
                }
                @if (People.Length > 3) { <FlareLink Href="capacity">@(Strings.T("Все люди")) (@People.Length)</FlareLink> }
                @if (People.Length == 0) { <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@(Strings.T("Нет рабочих графиков людей за период спринта."))</FlareText> }
                @if (People.LastOrDefault() is { Actor: { } free } && _load.TryGetValue(free.Id, out var freeLoad) && freeLoad.Available > freeLoad.Allocated)
                {
                    <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.Primary">@(Strings.T("Резерв ёмкости:")) @free.Name (+@AlvaFormat.Hours(freeLoad.Available - freeLoad.Allocated) @(Strings.T("ч")))</FlareText>
                }
            </FlareStack>
        </CaptionContent>
    </FlareStat>

    <FlareStat Label="@(Strings.T("Проекты в спринте"))" Value="@Shares.Length.ToString()" Unit="@AlvaFormat.Plural(Shares.Length, "project")" Icon="@MaterialDesign3Icons.Regular.FolderSpecial">
        <CaptionContent>
            <FlareStack Gap="FlareSpacing.XSmall">
                @foreach (var (name, share) in Shares)
                {
                    <FlareStack Row Align="FlareAlignItems.Center" Gap="FlareSpacing.Small">
                        <FlareText Typo="TypographyScale.BodySmall">@name</FlareText>
                        <FlareProgressLinear Value="@share" Size="TrackSize.Xs" Color="FlareColor.Primary" aria-label="@string.Format(Strings.T("Доля проекта: {0}"), name)" />
                        <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@share%</FlareText>
                    </FlareStack>
                }
            </FlareStack>
        </CaptionContent>
    </FlareStat>
</FlareGrid>

<FlareCard Variant="CardVariant.Outlined">
    <FlareCardHeader Title="@(Strings.T("Задачи в итерации"))">
        <ActionContent>
            <FlareToggleGroup TValue="string" Value="@_filter" ValueChanged="SetFilter" Size="ButtonSize.Sm" Mandatory AriaLabel="@(Strings.T("Быстрый фильтр"))">
                @foreach (var (key, label) in Filters)
                {
                    <FlareToggleButton Value="@key">@label (@Filtered(key).Count())</FlareToggleButton>
                }
            </FlareToggleGroup>
        </ActionContent>
    </FlareCardHeader>
    <FlareCardContent>
        <FlareDataGrid TItem="TaskModel" Items="Filtered(_filter)" Height="auto" Dense="true" RowKey="t => t!.Id">
            <Columns>
                <FlareColumn TItem="TaskModel" Title="@(Strings.T("Задача"))" Sortable Field="t => t!.Title" SortKey="title">
                    <Template Context="task">
                        <FlareStack Gap="FlareSpacing.None">
                            <FlareLink Href="@($"tasks/{task!.Id}")">@task.Title</FlareLink>
                            <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@AlvaFormat.Code(task.Id)@(task.Deadline.HasValue ? string.Format(Strings.T(" · Дедлайн: {0:d MMM}"), task.Deadline) : "")@(Risks.Any(r => r.TaskId == task.Id) ? Strings.T(" · под риском") : "")</FlareText>
                        </FlareStack>
                    </Template>
                </FlareColumn>
                <FlareColumn TItem="TaskModel" Title="@(Strings.T("Проект"))" Sortable Field="t => ProjectName(t!.ProjectId)" SortKey="project">
                    <Template Context="task"><FlareChip Size="ChipSize.Sm" Label="@ProjectName(task!.ProjectId)" /></Template>
                </FlareColumn>
                <FlareColumn TItem="TaskModel" Title="@(Strings.T("Исполнитель"))">
                    <Template Context="task">
                        <AlvaAssignee Task="task!" Actors="_actors" Load="@(Assignees.Person(task!, _actors) is { } p && _load.ContainsKey(p) ? LoadOf(p) : null)" />
                    </Template>
                </FlareColumn>
                <FlareColumn TItem="TaskModel" Title="@(Strings.T("Оценка"))" Sortable Field="t => Hours(t!)" SortKey="estimate">
                    <Template Context="task"><FlareText Typo="TypographyScale.BodySmall">@EstimateText(task!)</FlareText></Template>
                </FlareColumn>
                <FlareColumn TItem="TaskModel" Title="@(Strings.T("Статус"))" Sortable Field="t => t!.Status" SortKey="status">
                    <Template Context="task"><AlvaStatusChip Tone="AlvaTones.Status(task!.Status)">@Labels.Status(task.Status)</AlvaStatusChip></Template>
                </FlareColumn>
            </Columns>
            <EmptyStateContent>
                <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@(Strings.T("Задач по этому фильтру нет."))</FlareText>
            </EmptyStateContent>
        </FlareDataGrid>
        <FlareStack Row Wrap StretchFirst Align="FlareAlignItems.Center" Gap="FlareSpacing.Small">
            <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@(Strings.T("Итоги по выборке: План:")) <b>@AlvaFormat.Hours(Filtered(_filter).Sum(Hours)) @(Strings.T("ч"))</b> @(Strings.T("· Закрыто:")) <b>@AlvaFormat.Hours(Filtered(_filter).Where(t => t.Status == "Done").Sum(Hours)) @(Strings.T("ч"))</b> @(Strings.T("· Задач с рисками:")) <b>@Filtered(_filter).Count(t => Risks.Any(r => r.TaskId == t.Id))</b></FlareText>
            <FlareButton Size="ButtonSize.Sm" OnClick="Edit">
                <LeadingIcon><FlareIconView Value="@MaterialDesign3Icons.Regular.Add" Size="18px" /></LeadingIcon>
                <ChildContent>@(Strings.T("Добавить задачу в спринт"))</ChildContent>
            </FlareButton>
        </FlareStack>
    </FlareCardContent>
</FlareCard>

<FlareDialog @bind-Visible="_closing" Title="@($"{Strings.T("Завершить спринт")} «{Sprint.Name}»")" Size="DialogSize.Lg" Divider>
    <ChildContent>
        @if (Open.Length == 0)
        {
            <FlareText Element="p" Typo="TypographyScale.BodyMedium">@(Strings.T("Все задачи спринта завершены. Итог будет сохранён при закрытии."))</FlareText>
        }
        else
        {
            <FlareText Element="p" Typo="TypographyScale.BodyMedium">@(Strings.T("Незавершённых задач:")) <b>@Open.Length (@AlvaFormat.Hours(Open.Sum(Hours)) @(Strings.T("ч")))</b>. @(Strings.T("Решите, что сделать с каждой: итог спринта сохранится до переноса."))</FlareText>
            @if (NextChoices.Length > 0)
            {
                <FlareSelect TValue="Guid?" Label="@(Strings.T("Следующий спринт для переноса"))" Items="NextChoices.Select(s => (Guid?)s.Id)" ItemLabel="NextLabel" @bind-Value="_next" />
            }
            <FlareList TItem="TaskModel" Dense>
                @foreach (var task in Open)
                {
                    <FlareListItem @key="task.Id">
                        <ChildContent>
                            <FlareStack Gap="FlareSpacing.None">
                                <FlareLink Href="@($"tasks/{task.Id}")">@task.Title</FlareLink>
                                <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@Labels.Status(task.Status) · @EstimateText(task)</FlareText>
                            </FlareStack>
                        </ChildContent>
                        <Trailing>
                            <FlareSelect TValue="string" Label="@(Strings.T("Что сделать"))" Items="Actions" ItemLabel="ActionLabel" Value="@Decision(task)" ValueChanged="(string value) => _decisions[task.Id] = value" Size="FieldSize.Sm" />
                        </Trailing>
                    </FlareListItem>
                }
            </FlareList>
            <FlareText Element="p" Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@CloseSummary</FlareText>
        }
    </ChildContent>
    <ActionsContent>
        <FlareButton Variant="ButtonVariant.Text" OnClick="() => _closing = false">@(Strings.T("Отмена"))</FlareButton>
        <FlareButton Loading="_busy" Disabled="@(Open.Any(t => Decision(t) == SprintCarry.Next) && _next is null)" OnClick="Complete">@(Strings.T("Завершить спринт"))</FlareButton>
    </ActionsContent>
</FlareDialog>
}

@code {
    [Parameter, EditorRequired] public SprintModel Sprint { get; set; } = default!;
    [Parameter] public TaskModel[] Tasks { get; set; } = [];
    /// <summary>Спринты команды: из незакрытых выбирается тот, куда переносится остаток.</summary>
    [Parameter] public SprintModel[] Sprints { get; set; } = [];

    private bool _closing;
    private Guid? _next;
    private ElementReference _heading;
    private bool _focused;
    private readonly Dictionary<Guid, string> _decisions = [];
    /// <summary>Незавершённые задачи спринта — по каждой нужно решение при закрытии.</summary>
    private TaskModel[] Open => SprintTasks.Where(t => t.Status != "Done").ToArray();
    private SprintModel[] NextChoices => Sprints.Where(s => s.Id != Sprint.Id && s.Status != "Completed" && s.EndDate >= Sprint.StartDate).OrderBy(s => s.StartDate).ToArray();
    private string NextLabel(Guid? id) => Sprints.FirstOrDefault(s => s.Id == id) is { } s ? $"{s.Name} ({AlvaFormat.Period(s.StartDate, s.EndDate)})" : "";
    private string[] Actions => NextChoices.Length > 0 ? [SprintCarry.Next, SprintCarry.Backlog, SprintCarry.Done] : [SprintCarry.Backlog, SprintCarry.Done];
    private static string ActionLabel(string action) => action switch
    {
        SprintCarry.Next => Strings.T("В следующий спринт"),
        SprintCarry.Backlog => Strings.T("Вернуть в пул"),
        _ => Strings.T("Отметить готовой")
    };
    // По умолчанию — безопасный возврат в пул, а не перенос в следующий спринт: решение должно быть явным.
    private string Decision(TaskModel task) => _decisions.TryGetValue(task.Id, out var action) && Actions.Contains(action) ? action : SprintCarry.Backlog;
    private string CloseSummary => string.Join(" · ", Actions
        .Select(a => (Label: ActionLabel(a), Hours: Open.Where(t => Decision(t) == a).Sum(Hours)))
        .Where(x => x.Hours > 0).Select(x => string.Format(Strings.T("{0}: {1} ч"), x.Label, AlvaFormat.Hours(x.Hours))));

    private void OpenClose()
    {
        _decisions.Clear();
        _next = NextChoices.FirstOrDefault(s => s.StartDate > Sprint.EndDate)?.Id ?? NextChoices.FirstOrDefault()?.Id;
        _closing = true;
    }

    /// <summary>Открыть редактирование состава (планирование спринта).</summary>
    [Parameter] public EventCallback OnEdit { get; set; }

    /// <summary>Спринт изменён (например, завершён) — страница перечитывает данные.</summary>
    [Parameter] public EventCallback Changed { get; set; }

    private static readonly (string Key, string Label)[] Filters = [("all", Strings.T("Все")), ("risk", Strings.T("С рисками")), ("unassigned", Strings.T("Неназначенные")), ("work", Strings.T("В работе"))];
    private RiskDto[] _risks = [];
    private ActorModel[] _actors = [];
    private ProjectModel[] _projects = [];
    private Dictionary<Guid, (decimal Available, decimal Allocated)> _load = [];
    private string _filter = "all";
    private string? _error;
    private bool _loaded;
    private bool _busy;
    private Guid _loadedFor;

    private static DateOnly Today => DateOnly.FromDateTime(DateTime.Today);
    private TaskModel[] SprintTasks => Tasks.Where(t => t.SprintIds.Contains(Sprint.Id) && t.Status != "Cancelled").OrderBy(t => t.Order).ToArray();
    private RiskDto[] Risks => _risks.Where(r => SprintTasks.Any(t => t.Id == r.TaskId)).ToArray();
    // Часы задачи в этом спринте: задача на стыке спринтов делит оценку между ними (SprintWindows.Share).
    private decimal Hours(TaskModel t) => SprintHours.Of(t, Sprint);
    private decimal Total => SprintTasks.Sum(Hours);
    private decimal Done => SprintTasks.Where(t => t.Status == "Done").Sum(Hours);
    private decimal InWork => SprintTasks.Where(t => t.Status == "InProgress").Sum(Hours);
    // Закрытый спринт показывает итог при закрытии: перенесённый остаток уже ушёл из него, но в истории он был.
    private decimal HeadDone => Sprint.Result?.DoneHours ?? Done;
    private decimal HeadTotal => Sprint.Result?.Hours ?? Total;
    private int DayOf => AlvaFormat.SprintDay(Sprint.StartDate, Sprint.EndDate, Today);
    private int DaysLeft => AlvaFormat.SprintDaysLeft(Sprint.StartDate, Sprint.EndDate, Today);
    private static int Percent(decimal part, decimal whole) => whole <= 0 ? 0 : (int)Math.Round(part / whole * 100);
    private static FlareColor ToneColor(int pct) => pct > 100 ? FlareColor.Error : pct > 80 ? FlareColor.Primary : FlareColor.Success;
    private int LoadOf(Guid id) => Percent(_load[id].Allocated, _load[id].Available);
    // Процент — доля занятого времени; рядом свободные часы или перегруз, чтобы число не читалось как «свободно N%».
    private string LoadText(Guid id, int pct)
    {
        var (available, allocated) = _load[id];
        var rest = available - allocated;
        return $"{Strings.T("Занято")} {pct}% · {(rest >= 0 ? Strings.T("свободно") : Strings.T("перегруз"))} {AlvaFormat.Hours(Math.Abs(rest))} {Strings.T("ч")}";
    }
    /// <summary>Оценка в таблице: доля спринта и, если задача идёт дальше, её полный объём.</summary>
    private string EstimateText(TaskModel t) => t.EstimateHours is not { } all ? "—"
        : Hours(t) is var part && part < all ? $"{AlvaFormat.Hours(part)} {Strings.T("из")} {AlvaFormat.Hours(all)} {Strings.T("ч")}" : $"{AlvaFormat.Hours(all)} {Strings.T("ч")}";
    private string ProjectName(Guid? id) => _projects.FirstOrDefault(p => p.Id == id)?.Name ?? Strings.T("Текучка");

    private IEnumerable<BreadcrumbItem> Crumbs => [new(Strings.T("Спринты"), "sprints"), new(Sprint.Name)];

    /// <summary>Люди спринта (исполнители его задач) по убыванию загрузки за окно спринта.</summary>
    private (ActorModel Actor, int Pct)[] People => _actors
        .Where(a => a.Kind == "Person" && _load.ContainsKey(a.Id) && SprintTasks.Any(t => t.ResolvedPersonId == a.Id || t.AssignmentTargetId == a.Id))
        .Select(a => (a, LoadOf(a.Id))).OrderByDescending(x => x.Item2).ToArray();

    private (string Name, int Share)[] Shares => SprintTasks.GroupBy(t => t.ProjectId)
        .Select(g => (ProjectName(g.Key), Percent(g.Sum(Hours), Total)))
        .OrderByDescending(x => x.Item2).ToArray();

    private IEnumerable<TaskModel> Filtered(string key) => key switch
    {
        "risk" => SprintTasks.Where(t => _risks.Any(r => r.TaskId == t.Id)),
        "unassigned" => SprintTasks.Where(t => Assignees.Person(t, _actors) is null),
        "work" => SprintTasks.Where(t => t.Status == "InProgress"),
        _ => SprintTasks
    };

    private void SetFilter(string? value) => _filter = value ?? "all";

    // Страница принимает фокус, когда данные загрузились: после перехода человек не остаётся на body.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focused || !_loaded) return;
        _focused = true;
        try { await _heading.FocusAsync(preventScroll: true); }
        catch (JSDisconnectedException) { }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedFor == Sprint.Id) { _loaded = true; return; }
        try
        {
            _risks = await Session.Get<RiskDto[]>(Session.TeamPath("risks"));
            _actors = await Session.Get<ActorModel[]>(Session.TeamPath("actors"));
            _projects = await Session.Get<ProjectModel[]>(Session.TeamPath("projects"));
            var rows = await Session.Get<CapacityDto[]>(Session.TeamPath($"capacity?from={Sprint.StartDate:yyyy-MM-dd}&to={Sprint.EndDate:yyyy-MM-dd}"));
            _load = rows.GroupBy(r => r.ActorId).ToDictionary(g => g.Key, g => (g.Sum(r => r.AvailableHours), g.Sum(r => r.AllocatedHours)));
            _loadedFor = Sprint.Id;
        }
        catch (Exception e) when (e is HttpRequestException or InvalidOperationException or NotSupportedException) { _error = PageFeedback.Describe(e); }
        finally { _loaded = true; }
    }

    private Task Edit() => OnEdit.InvokeAsync();

    private async Task Complete()
    {
        _busy = true; _error = null;
        try
        {
            // Закрытие и перенос остатка — одна операция сервера: итог фиксируется до того, как задачи уйдут из спринта.
            var moves = Open.Select(t => new SprintCarryDto(t.Id, Decision(t))).ToArray();
            await Session.Save<SprintModel>(HttpMethod.Post, Session.TeamPath($"sprints/{Sprint.Id}/close"), new SprintCloseRequest(moves, moves.Any(m => m.Action == SprintCarry.Next) ? _next : null));
            _closing = false;
            await Changed.InvokeAsync();
        }
        catch (Exception e) when (e is HttpRequestException or InvalidOperationException) { _error = PageFeedback.Describe(e); }
        finally { _busy = false; }
    }
}
