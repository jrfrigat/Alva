@* Task page: breadcrumbs, pinned actions, risk with reasons, form sections,
   dependencies, subtasks, history and a side panel for assigning an assignee with candidate load. *@
@implements IDisposable
@inject AlvaSession Session
@inject NavigationManager Navigation
@inject DraftGuard Drafts
<NavigationLock OnBeforeInternalNavigation="ConfirmLeave" ConfirmExternalNavigation="Dirty" />
<FlareStack Gap="FlareSpacing.Large">
    <div @ref="_heading" tabindex="-1">
    <FlarePageHeader Title="@_model.Title" HeadingLevel="@HeadingLevel">
        <EyebrowContent><FlareBreadcrumb Items="Crumbs" Separator="›" AriaLabel="@(AlvaStrings.Task_PathToTheTask)" /></EyebrowContent>
        <DescriptionContent>
            <FlareStack Row Wrap Align="FlareAlignItems.Center" Gap="FlareSpacing.Small">
                <AlvaStatusChip Tone="AlvaTones.Status(Item.Status)">@Labels.Status(Item.Status)</AlvaStatusChip>
                @* The task came from an external tracker: the key leads to where it is managed, and synchronization updates it here. *@
                @if (Item.ExternalKey is { } externalKey)
                {
                    @if (Item.ExternalUrl is { Length: > 0 } externalUrl)
                    {
                        <FlareLink Class="alva-task__external" Href="@externalUrl" target="_blank" rel="noopener noreferrer" title="@(AlvaStrings.Task_OpenInTheExternalTracker)">@externalKey ↗</FlareLink>
                    }
                    else { <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@externalKey</FlareText> }
                }
                <FlareIconButton Icon="@MaterialDesign3Icons.Regular.Edit" Size="ButtonSize.Sm" Tooltip="@(AlvaStrings.Task_EditTitle)" AriaLabel="@(AlvaStrings.Task_EditTitle)" OnClick="OpenTitleEdit" />
            </FlareStack>
        </DescriptionContent>
    </FlarePageHeader>
    </div>
    <div class="alva-task__actions" role="toolbar" aria-label="@(AlvaStrings.Common_TaskActions)">
        <FlareButton Loading="_busy" Disabled="@(string.IsNullOrWhiteSpace(_model.Title) || !Dirty)" OnClick="Save" Size="ButtonSize.Sm">
            <LeadingIcon><FlareIconView Value="@MaterialDesign3Icons.Regular.Save" Size="18px" /></LeadingIcon>
            <ChildContent>@(AlvaStrings.Common_Save)</ChildContent>
        </FlareButton>
        <FlareButton @ref="_assignButton" Variant="ButtonVariant.Tonal" OnClick="OpenAssign" Size="ButtonSize.Sm">
            <LeadingIcon><FlareIconView Value="@MaterialDesign3Icons.Regular.PersonAdd" Size="18px" /></LeadingIcon>
            <ChildContent>@(AlvaStrings.Common_AssignAnAssignee)</ChildContent>
        </FlareButton>
        <FlareIconButton Icon="@MaterialDesign3Icons.Regular.Delete" Color="FlareColor.Error" Size="ButtonSize.Sm" Tooltip="@(AlvaStrings.Task_ArchiveTask)" AriaLabel="@(AlvaStrings.Task_ArchiveTask)" OnClick="Archive" />
        <FlareSpacer />
        <EditorStatus Dirty="Dirty" Saving="_busy" Saved="_saved" />
    </div>
    <PageFeedback Error="@_error" />

    <FlareSection Class="alva-task__risk">
        <HeadingContent>
            <FlareStack Row Align="FlareAlignItems.Center" Gap="FlareSpacing.Small">
                <FlareIconView Value="@MaterialDesign3Icons.Regular.Warning" Size="20px" />
                <FlareText Element="h2" Typo="TypographyScale.TitleLarge">@(AlvaStrings.Common_Risk)</FlareText>
                @if (_risk is not null) { <AlvaStatusChip Tone="AlvaTones.Severity(_risk.Severity)">@(_risk.Severity == "High" ? AlvaStrings.Common_High : AlvaStrings.Risks_Medium)</AlvaStatusChip> }
            </FlareStack>
        </HeadingContent>
        <ChildContent>
            @if (_linksError is not null) { <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.Error">@_linksError</FlareText> }
            else if (_risk is null) { <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@(AlvaStrings.Task_NoRisksTheDeadlineAssigneeAndDependenciesAreFine)</FlareText> }
            else
            {
                @if (_risk.ForecastDate is { } forecast) { <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@string.Format(AlvaStrings.Task_ForecastFinish, forecast.ToString("d MMM yyyy"))</FlareText> }
                <FlareStack Gap="FlareSpacing.XSmall">
                    @foreach (var reason in _risk.Reasons)
                    {
                        <FlareStack Row Wrap Align="FlareAlignItems.Center" Gap="FlareSpacing.Small">
                            @if (reason.Code is ReasonCodes.RiskNoAssignee or ReasonCodes.RiskRequiredPerson)
                            {
                                @* A link would lead to this same card: the action is to open the assignment right away. *@
                                <FlareText Typo="TypographyScale.BodySmall">@ReasonText.Describe(reason)</FlareText>
                                <FlareButton Variant="ButtonVariant.Text" Size="ButtonSize.Sm" OnClick="OpenAssign">@(AlvaStrings.Common_AssignAnAssignee)</FlareButton>
                            }
                            else
                            {
                                <FlareLink Href="@RiskActions.Href(reason, Item.Id, Item.ResolvedPersonId)" title="@RiskActions.Label(reason, Item.ResolvedPersonId)">@ReasonText.Describe(reason)</FlareLink>
                            }
                        </FlareStack>
                    }
                </FlareStack>
            }
        </ChildContent>
    </FlareSection>

    <FlareSection>
        <HeadingContent>
            <FlareStack Row Align="FlareAlignItems.Center" Gap="FlareSpacing.Small">
                <FlareIconView Value="@MaterialDesign3Icons.Regular.Description" Size="20px" />
                <FlareText Element="h2" Typo="TypographyScale.TitleLarge">@(AlvaStrings.Common_Description)</FlareText>
            </FlareStack>
        </HeadingContent>
        <ChildContent>
            <FlareTextArea Label="@(AlvaStrings.Task_DescriptionAndGoals)" @bind-Value="_model.Description" AutoGrow />
        </ChildContent>
    </FlareSection>

    <FlareSection>
        <HeadingContent>
            <FlareStack Row Align="FlareAlignItems.Center" Gap="FlareSpacing.Small">
                <FlareIconView Value="@MaterialDesign3Icons.Regular.Badge" Size="20px" />
                <FlareText Element="h2" Typo="TypographyScale.TitleLarge">@(AlvaStrings.Task_Skills)</FlareText>
            </FlareStack>
        </HeadingContent>
        <ChildContent>
            <FlareStack Gap="FlareSpacing.Medium">
                <FlareMultiSelect TValue="Guid" Label="@(AlvaStrings.Common_RequiredSkills)" Items="SkillActors.Select(a=>a.Id)"
                                  ItemLabel="SkillName" Chips="true" Searchable="true"
                                  Values="_model.RequiredSkillIds" ValuesChanged="(IReadOnlyList<Guid> skills) => _model.RequiredSkillIds = skills.ToArray()" />
                <SkillMatch Required="_model.RequiredSkillIds" Person="@(Actors.FirstOrDefault(a=>a.Id==(Item.ResolvedPersonId ?? Item.AssignmentTargetId)))" Skills="SkillActors" />
            </FlareStack>
        </ChildContent>
    </FlareSection>

    <FlareSection>
        <HeadingContent>
            <FlareStack Row Align="FlareAlignItems.Center" Gap="FlareSpacing.Small">
                <FlareIconView Value="@MaterialDesign3Icons.Regular.Tune" Size="20px" />
                <FlareText Element="h2" Typo="TypographyScale.TitleLarge">@(AlvaStrings.Task_Plan)</FlareText>
            </FlareStack>
        </HeadingContent>
        <ChildContent>
            <FlareStack Gap="FlareSpacing.Medium">
                @if (_formErrors.Count > 0) { <div tabindex="-1" @ref="_errorSummary"><AlvaValidationSummary Messages="_formErrors" /></div> }
                <FlareGrid MinColumnWidth="min(100%,12rem)">
                    <FlareSelect TValue="string" Label="@(AlvaStrings.Common_Status)" Items="Statuses" ItemLabel="Labels.Status" @bind-Value="_model.Status" />
                    <FlareSelect TValue="string" Label="@(AlvaStrings.Common_Priority)" Items="Labels.Priorities" ItemLabel="Labels.Priority" @bind-Value="_model.Priority" />
                    <FlareSelect TValue="Guid?" Label="@(AlvaStrings.Common_Project)" Items="Projects.Select(x => (Guid?)x.Id)" ItemLabel="ProjectName" NullOption="@(AlvaStrings.Sprint_Ongoing)" @bind-Value="_model.ProjectId" />
                    <FlareSelect TValue="Guid?" Label="@(AlvaStrings.Common_SprintByDates)" Items="Sprints.OrderBy(x => x.StartDate).Select(x => (Guid?)x.Id)" ItemLabel="SprintName" NullOption="@(AlvaStrings.Common_BacklogUndated)" Value="SprintDates.First(_model, Sprints)" ValueChanged="id => SprintDates.Place(_model, Sprints.FirstOrDefault(s => s.Id == id))" HelperText="@SprintDates.Hint(_model, Sprints)" Disabled="_model.DatesFixed" />
                    <FlareSelect TValue="Guid?" Label="@(AlvaStrings.Common_ParentTask)" ErrorText="@_parentError" Items="Tasks.Where(x => x.Id != Item.Id).Select(x => (Guid?)x.Id)" ItemLabel="TaskName" NullOption="@(AlvaStrings.Common_RootTask)" @bind-Value="_model.ParentId" Searchable />
                    <FlareNumericField TValue="decimal?" Label="@(AlvaStrings.Common_EstimateHours)" ErrorText="@_estimateError" @bind-Value="_model.EstimateHours" Min="0" />
                    <FlareNumericField TValue="decimal?" Label="@(AlvaStrings.Common_RemainingWorkHours)" ErrorText="@_remainingError" @bind-Value="_model.RemainingHours" Min="0" Max="100000" HelperText="@(AlvaStrings.Common_ForWorkInProgressLeaveBlankIfRemainingWorkIsUnknown0MeansNoWorkRemains)" />
                    <FlareNumericField TValue="decimal?" Label="@(AlvaStrings.Common_NoMoreThanHPerDay)" ErrorText="@_limitError" @bind-Value="_model.DailyHoursLimit" Min="0" Max="24" HelperText="@DailyLimit.Hint(_model)" />
                    <FlareDatePicker Label="@(AlvaStrings.Common_Deadline)" @bind-Value="_model.Deadline" />
                    <FlareDatePicker Label="@(AlvaStrings.Common_Start)" ErrorText="@_startError" @bind-Value="_model.StartDate" Disabled="_model.DatesFixed" />
                    <FlareDatePicker Label="@(AlvaStrings.Common_End)" ErrorText="@_endError" @bind-Value="_model.EndDate" Disabled="_model.DatesFixed" />
                </FlareGrid>
                <FlareStack Gap="FlareSpacing.Small">
                    <FlareSwitch @bind-Value="_model.DatesFixed" Label="@(AlvaStrings.Common_FixedDatesDoNotMove)"
                                 Disabled="@(_model.StartDate is null || _model.EndDate is null)" />
                    <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@FixedHint</FlareText>
                </FlareStack>
            </FlareStack>
        </ChildContent>
    </FlareSection>

    <FlareSection>
        <HeadingContent>
            <FlareStack Row Align="FlareAlignItems.Center" Gap="FlareSpacing.Small">
                <FlareIconView Value="@MaterialDesign3Icons.Regular.Assignment" Size="20px" />
                <FlareText Element="h2" Typo="TypographyScale.TitleLarge">@(AlvaStrings.Task_AssignmentTitle)</FlareText>
            </FlareStack>
        </HeadingContent>
        <ChildContent>
            <FlareStack Gap="FlareSpacing.XSmall">
                <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@(AlvaStrings.Risks_Assignee)</FlareText>
                <AlvaAssignee Task="Item" Actors="Actors" />
            </FlareStack>
        </ChildContent>
    </FlareSection>

    <FlareSection Class="alva-task__deps">
        <HeadingContent>
            <FlareStack Row Align="FlareAlignItems.Center" Gap="FlareSpacing.Small">
                <FlareIconView Value="@MaterialDesign3Icons.Regular.Hub" Size="20px" />
                <FlareStack Gap="FlareSpacing.None">
                    <FlareText Element="h2" Typo="TypographyScale.TitleLarge">@(AlvaStrings.Common_Dependencies)</FlareText>
                    <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@(AlvaStrings.Task_WhatTheTaskWaitsForAndWhatItHoldsUp)</FlareText>
                </FlareStack>
            </FlareStack>
        </HeadingContent>
        <ChildContent>
            <FlareStack Gap="FlareSpacing.Medium">
                @foreach (var (title, incoming) in new[] { (AlvaStrings.Task_Predecessors, true), (AlvaStrings.Task_Successors, false) })
                {
                    var links = _dependencies.Where(d => incoming ? d.SuccessorId == Item.Id : d.PredecessorId == Item.Id).ToArray();
                    <FlareText Typo="TypographyScale.LabelMedium" Color="FlareColor.OnSurfaceVariant">@title (@links.Length)</FlareText>
                    @if (links.Length == 0)
                    {
                        <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@(incoming ? AlvaStrings.Task_TheTaskWaitsForNothing : AlvaStrings.Task_NothingWaitsForThisTask)</FlareText>
                    }
                    else
                    {
                        <FlareList TItem="DependencyDto" Dense="true">
                            @foreach (var link in links)
                            {
                                var other = incoming ? link.PredecessorId : link.SuccessorId;
                                <FlareListItem @key="link.Id">
                                    <Leading><FlareLink Href="@($"tasks/{other}")">@AlvaFormat.Code(other)</FlareLink></Leading>
                                    <ChildContent>
                                        <FlareStack Gap="FlareSpacing.None">
                                            <FlareLink Href="@($"tasks/{other}")" title="@LinkTitle(other)">@LinkTitle(other)</FlareLink>
                                            <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@KindLabel(link.Kind)@(link.LagDays != 0 ? " · " + string.Format(AlvaStrings.Task_LagDaysShort, link.LagDays) : "")</FlareText>
                                        </FlareStack>
                                    </ChildContent>
                                    <Trailing>
                                        <FlareIconButton Icon="@MaterialDesign3Icons.Regular.Delete" Size="ButtonSize.Sm" Disabled="_busy"
                                                         AriaLabel="@string.Format(AlvaStrings.Task_RemoveTheLinkTo, LinkTitle(other))" Tooltip="@(AlvaStrings.Task_RemoveLink)" OnClick="() => RemoveDependency(link)" />
                                    </Trailing>
                                </FlareListItem>
                            }
                        </FlareList>
                    }
                }
                <FlareGrid MinColumnWidth="min(100%,11rem)">
                    <FlareSelect TValue="bool" Label="@(AlvaStrings.Task_Link)" Items="Directions" ItemLabel="DirectionLabel" @bind-Value="_linkIncoming" />
                    <FlareSelect TValue="Guid?" Label="@(AlvaStrings.Common_Task)" Items="LinkCandidates" ItemLabel="TaskName" NullOption="@(AlvaStrings.Common_ChooseATask)" @bind-Value="_linkTask" Searchable />
                    <FlareSelect TValue="string" Label="@(AlvaStrings.Task_Type)" Items="DependencyKinds" ItemLabel="KindLabel" @bind-Value="_linkKind" />
                    <FlareNumericField TValue="int" Label="@(AlvaStrings.Task_LagDays)" @bind-Value="_linkLag" Min="-365" Max="365" />
                </FlareGrid>
                <FlareButton Variant="ButtonVariant.Tonal" Size="ButtonSize.Sm" Loading="_busy" Disabled="@(_linkTask is null || _busy)" OnClick="AddDependency">@(AlvaStrings.Task_AddLink)</FlareButton>
            </FlareStack>
        </ChildContent>
    </FlareSection>

    <FlareSection>
        <HeadingContent>
            <FlareStack Row Align="FlareAlignItems.Center" Gap="FlareSpacing.Small">
                <FlareIconView Value="@MaterialDesign3Icons.Regular.Layers" Size="20px" />
                <FlareStack Gap="FlareSpacing.None">
                    <FlareText Element="h2" Typo="TypographyScale.TitleLarge">@(AlvaStrings.Task_Subtasks)</FlareText>
                    <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@(AlvaStrings.Task_TotalEstimateAndSubtaskAssignees)</FlareText>
                </FlareStack>
            </FlareStack>
        </HeadingContent>
        <ChildContent>
            <FlareStack Gap="FlareSpacing.Medium">
                <FlareStack Row Wrap Align="FlareAlignItems.Center" Gap="FlareSpacing.Medium">
                    <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant"><FlareIconView Value="@MaterialDesign3Icons.Regular.Schedule" Size="16px" /> @(AlvaStrings.Task_Total) @AlvaFormat.Hours(Children.Sum(c => c.EstimateHours ?? 0)) @(AlvaStrings.Sprint_HoursShort) (@Children.Length @AlvaFormat.Plural(Children.Length, "subtask"))</FlareText>
                    @if (Children.Where(c => c.Deadline.HasValue).Select(c => c.Deadline!.Value).DefaultIfEmpty().Max() is var last && last != default)
                    {
                        <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant"><FlareIconView Value="@MaterialDesign3Icons.Regular.Event" Size="16px" /> @(AlvaStrings.Task_Due) @last.ToString("d MMM yyyy")</FlareText>
                    }
                </FlareStack>
                <FlareDataGrid TItem="TaskModel" Items="Children" Height="auto" Dense="true" RowKey="c => c!.Id" Presentation="DataGridPresentation.Auto">
                    <Columns>
                        <FlareColumn TItem="TaskModel" Title="@(AlvaStrings.Common_Subtask)">
                            <Template Context="child">
                                <FlareStack Row Align="FlareAlignItems.Center" Gap="FlareSpacing.XSmall">
                                    <FlareIconView Value="@MaterialDesign3Icons.Regular.SubdirectoryArrowRight" Size="16px" />
                                    <FlareLink Href="@($"tasks/{child!.Id}")" title="@child.Title">@child.Title</FlareLink>
                                </FlareStack>
                            </Template>
                        </FlareColumn>
                        <FlareColumn TItem="TaskModel" Title="@(AlvaStrings.Task_AssigneeSlot)">
                            <Template Context="child"><AlvaAssignee Task="child!" Actors="Actors" /></Template>
                        </FlareColumn>
                        <FlareColumn TItem="TaskModel" Title="@(AlvaStrings.Common_Estimate)">
                            <Template Context="child">@(child!.EstimateHours.HasValue ? $"{AlvaFormat.Hours(child.EstimateHours.Value)} {AlvaStrings.Sprint_HoursShort}" : "—")</Template>
                        </FlareColumn>
                    </Columns>
                    <EmptyStateContent><FlareEmptyState Compact Title="@(AlvaStrings.Task_NoSubtasksYet)" Description="@(AlvaStrings.Task_AddTheFirstSubtaskBelow)" /></EmptyStateContent>
                </FlareDataGrid>
                <FlareStack Row Wrap Align="FlareAlignItems.End" Gap="FlareSpacing.Small">
                    <FlareTextField @bind-Value="_quickTitle" Immediate Placeholder="@(AlvaStrings.Task_QuickAddOfANestedTaskEnter)" AriaLabel="@(AlvaStrings.Task_NewSubtaskTitle)" OnKeyDown="QuickKey">
                        <AdornmentStart><FlareIconView Value="@MaterialDesign3Icons.Regular.AddCircle" Size="18px" /></AdornmentStart>
                    </FlareTextField>
                    <FlareButton Variant="ButtonVariant.Tonal" Size="ButtonSize.Sm" Loading="_adding" Disabled="@(_adding || string.IsNullOrWhiteSpace(_quickTitle))" OnClick="QuickAdd">@(AlvaStrings.Task_AddANestedTask)</FlareButton>
                </FlareStack>
            </FlareStack>
        </ChildContent>
    </FlareSection>

    <FlareSection>
        <HeadingContent>
            <FlareStack Row Align="FlareAlignItems.Center" Gap="FlareSpacing.Small">
                <FlareIconView Value="@MaterialDesign3Icons.Regular.History" Size="20px" />
                <FlareText Element="h2" Typo="TypographyScale.TitleLarge">@(AlvaStrings.Task_ChangeHistory) (@_history.Length)</FlareText>
            </FlareStack>
        </HeadingContent>
        <ChildContent>
            @if (_history.Length == 0)
            {
                <FlareEmptyState Compact Title="@(AlvaStrings.Task_NoChangesYet)" Description="@(AlvaStrings.Task_TaskEditsWillAppearHere)" />
            }
            else
            {
                <FlareTimeline>
                    @foreach (var entry in _history)
                    {
                        <FlareTimelineItem Time="@entry.At.ToLocalTime().ToString("g")" Title="@entry.Summary" Icon="@MaterialDesign3Icons.Regular.History" />
                    }
                </FlareTimeline>
            }
        </ChildContent>
    </FlareSection>
</FlareStack>

<FlareDrawer Anchor="DrawerAnchor.Right" @bind-Open="_assignOpen" @bind-Open:after="AssignToggled" Width="26rem" AriaLabel="@(AlvaStrings.Task_Assignment)">
    <HeaderContent>
        <div class="alva-assign__header">
            <FlareIconView Value="@MaterialDesign3Icons.Regular.PersonAdd" Size="22px" Class="alva-panel__icon" />
            <div>
                <div class="alva-assign__title">@(AlvaStrings.Task_Assignment)</div>
                <div class="alva-assign__task alva-num">@Code(Item)@(Item.EstimateHours.HasValue ? $" ({AlvaFormat.Hours(Item.EstimateHours.Value)}{AlvaStrings.Sprint_HoursShort})" : "")</div>
            </div>
        </div>
    </HeaderContent>
    <ChildContent>
        <div class="alva-assign">
            <span class="alva-micro-label">@(AlvaStrings.Task_BalancingType)</span>
            <FlareTabs @bind-ActiveIndex="_assignTab">
                @foreach (var kind in Kinds)
                {
                    <FlareTab Label="@Labels.Kind(kind)">@Candidates(kind)</FlareTab>
                }
            </FlareTabs>
            @if (Actors.FirstOrDefault(a => a.Id == _assignTarget)?.Kind is "Department")
            {
                <FlareSelect TValue="Guid?" Label="@(AlvaStrings.Common_SpecificAssignee)" Items="AssignablePeople.Select(a => (Guid?)a.Id)" ItemLabel="ActorName" NullOption="@(AlvaStrings.Task_NotChosenYetAPersonIsRequired)" @bind-Value="_assignPerson" Searchable />
            }
            <div class="alva-assign__footer">
                @if (Item.AssignmentTargetId is not null)
                {
                    <FlareButton Variant="ButtonVariant.Text" Size="ButtonSize.Sm" Color="FlareColor.Error" Disabled="_busy" OnClick="ClearAssign">@(AlvaStrings.Task_Unassign)</FlareButton>
                }
                <FlareButton Variant="ButtonVariant.Text" Size="ButtonSize.Sm" OnClick="CloseAssign">@(AlvaStrings.Common_Cancel)</FlareButton>
                <FlareButton Size="ButtonSize.Sm" Loading="_busy" Disabled="@(_assignTarget is null)" OnClick="ApplyAssign">
                    <LeadingIcon><FlareIconView Value="@MaterialDesign3Icons.Regular.Check" Size="18px" /></LeadingIcon>
                    <ChildContent>@(AlvaStrings.Common_ApplyTheAssignment)</ChildContent>
                </FlareButton>
            </div>
        </div>
    </ChildContent>
</FlareDrawer>

<FlareDialog @bind-Visible="_titleEditing" Title="@(AlvaStrings.Task_TaskTitle)" Size="DialogSize.Sm">
    <ChildContent>
        <FlareTextField Label="@(AlvaStrings.Common_Title)" @bind-Value="_titleDraft" Required MaxLength="500" Autofocus />
    </ChildContent>
    <ActionsContent>
        <FlareButton Variant="ButtonVariant.Text" OnClick="CancelTitle">@(AlvaStrings.Common_Cancel)</FlareButton>
        <FlareButton OnClick="ApplyTitle" Disabled="@(string.IsNullOrWhiteSpace(_titleDraft))">@(AlvaStrings.Common_Apply)</FlareButton>
    </ActionsContent>
</FlareDialog>

@code {
    /// <summary>Open task.</summary>
    [Parameter, EditorRequired] public TaskModel Item { get; set; } = default!;

    /// <summary>Card heading level: 1 on the page, 2 in a panel over the list.</summary>
    [Parameter] public int HeadingLevel { get; set; } = 1;

    /// <summary>All team tasks: subtasks and the parent are taken from them.</summary>
    [Parameter] public TaskModel[] Tasks { get; set; } = [];
    [Parameter] public ProjectModel[] Projects { get; set; } = [];
    [Parameter] public SprintModel[] Sprints { get; set; } = [];
    [Parameter] public ActorModel[] Actors { get; set; } = [];

    /// <summary>Called after tasks change: the page reloads them.</summary>
    [Parameter] public EventCallback Changed { get; set; }

    private static readonly string[] Statuses = ["Backlog", "Planned", "InProgress", "Done", "Cancelled"];
    private static readonly string[] Kinds = ["Person", "Department"];
    private TaskModel _model = new();
    private ElementReference _heading;
    private HistoryDto[] _history = [];
    private Dictionary<Guid, (decimal Available, decimal Allocated)> _load = [];
    private RiskDto? _risk;
    private DependencyDto[] _dependencies = [];
    private (Guid Id, long Version) _linksFor;
    private string? _linksError;
    private static readonly bool[] Directions = [true, false];
    private static readonly string[] DependencyKinds = ["FS", "SS", "FF", "SF"];
    private bool _linkIncoming = true;
    private Guid? _linkTask;
    private string _linkKind = "FS";
    private int _linkLag;
    private FlareButton? _assignButton;
    private string? _error, _quickTitle, _assignSearch;
    private string? _parentError,_startError,_endError,_estimateError,_remainingError,_limitError;
    private readonly List<string> _formErrors=[]; private ElementReference _errorSummary;
    private bool _busy, _saved, _assignOpen, _adding, _titleEditing;
    private string? _titleDraft;
    private int _assignTab;
    private Guid? _assignTarget, _assignPerson;

    private TaskModel[] Children => Tasks.Where(t => t.ParentId == Item.Id).OrderBy(t => t.Order).ToArray();

    private IEnumerable<BreadcrumbItem> Crumbs
    {
        get
        {
            yield return new(AlvaStrings.Common_Tasks, "tasks");
            if (Projects.FirstOrDefault(p => p.Id == Item.ProjectId) is { } project) yield return new(project.Name, $"projects?project={project.Id}");
            if (Sprints.FirstOrDefault(s => Item.SprintIds.Contains(s.Id)) is { } sprint) yield return new(sprint.Name, $"sprints/{sprint.Id}");
            yield return new(Code(Item));
        }
    }

    /// <summary>Bar next to the heading: risk level from the server, and without it - overdue crimson, no assignee amber,
    /// otherwise sapphire.</summary>
    private AlvaTone RiskTone =>
        Item.Status is "Done" or "Cancelled" ? AlvaTone.Ok
        : _risk is not null ? AlvaTones.Severity(_risk.Severity)
        : Item.Deadline < DateOnly.FromDateTime(DateTime.Today) ? AlvaTone.Critical
        : Item.AssignmentTargetId is null ? AlvaTone.Warning
        : AlvaTone.Info;

    /// <summary>Confirmation of losing edits; comes from FlareConfirmDialogProvider in MainLayout.</summary>
    [CascadingParameter] public FlareConfirmDialogProvider? Confirm { get; set; }

    private bool _leaving;
    private IDisposable? _draft;
    protected override void OnInitialized() => _draft = Drafts.Track(() => Dirty);
    public void Dispose() => _draft?.Dispose();

    // The card itself takes focus on its first appearance: after following a link the person is not left on body.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try { await _heading.FocusAsync(preventScroll: true); }
        catch (JSDisconnectedException) { }
    }

    // The draft yields to fresh data after a version conflict: otherwise saving would go out with the old version.
    private bool _adoptFresh;

    /// <summary>The draft diverges from the task: leaving the page or reloading it would lose the edits.</summary>
    /// <summary>Whether the draft has unsaved edits: by this flag the page decides whether it can leave via
    /// Esc without losing work.</summary>
    public bool Dirty => _model.Id == Item.Id && (_model.Title != Item.Title || _model.Description != Item.Description
        || _model.Status != Item.Status || _model.ProjectId != Item.ProjectId || _model.ParentId != Item.ParentId
        || _model.RemainingHours != Item.RemainingHours || _model.EstimateHours != Item.EstimateHours || _model.Deadline != Item.Deadline
        || _model.StartDate != Item.StartDate || _model.EndDate != Item.EndDate || _model.Priority != Item.Priority
        || _model.DatesFixed != Item.DatesFixed || _model.DailyHoursLimit != Item.DailyHoursLimit || !_model.RequiredSkillIds.SequenceEqual(Item.RequiredSkillIds));

    // Links, menu and Back/Forward: unsaved edits leave only after explicit consent.
    private async Task ConfirmLeave(LocationChangingContext context)
    {
        if (_leaving || !Dirty || Confirm is null) return;
        var leave = await Confirm.ConfirmAsync(AlvaStrings.Common_UnsavedChanges,
            AlvaStrings.Task_TheTaskCardHasUnsavedChangesLeaveAndLoseThem, AlvaStrings.Common_LeaveWithoutSaving, AlvaStrings.Common_Stay);
        if (leave != true) context.PreventNavigation();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_model.Id != Item.Id) _saved = false;
        if (_model.Id == Item.Id && _model.Version == Item.Version) return;
        // Risk and links are read for every new task version, even when the draft below remains untouched.
        if (_linksFor != (Item.Id, Item.Version)) await LoadLinks();
        // The task was reloaded (subtask, assignment, someone else's edit) while the draft is not saved yet - it stays;
        // saving will go out with the old version, and the server reports a conflict instead of silently losing edits.
        // After a conflict the draft, conversely, yields to fresh data (_adoptFresh): saving over a stale
        // version is pointless, and the person needs to see the current state.
        if (Dirty && !_adoptFresh) return;
        _adoptFresh = false;
        _model = Fresh();
        _quickTitle = null;
        try { _history = await Session.Get<HistoryDto[]>(Session.TeamPath($"tasks/{Item.Id}/history")); }
        catch (Exception e) when (e is HttpRequestException or InvalidOperationException) { _error = PageFeedback.Describe(e); }
    }

    private static string Code(TaskModel task) => AlvaFormat.Code(task.Id);

    /// <summary>Hint under the toggle: why it is unavailable or what it enables.</summary>
    private string FixedHint => _model.StartDate is null || _model.EndDate is null
        ? AlvaStrings.Task_SetBothStartAndFinishFirstThenTheDatesCanBeFixed
        : _model.DatesFixed
            ? AlvaStrings.Task_DatesAreFixedTheTaskCannotBeMovedManuallyOrByAutoBalance
            : AlvaStrings.Task_TurnOnToForbidMovingTheTaskOrChangingItsDates;

    /// <summary>Copy of the task from the parameter: the card draft is a separate object, so edits do not touch
    /// the page data until they are saved.</summary>
    private TaskModel Fresh() => System.Text.Json.JsonSerializer.Deserialize<TaskModel>(System.Text.Json.JsonSerializer.Serialize(Item))!;
    private string ProjectName(Guid? id) => Projects.FirstOrDefault(x => x.Id == id)?.Name ?? AlvaStrings.Sprint_Ongoing;
    private string SprintName(Guid? id) => Sprints.FirstOrDefault(x => x.Id == id)?.Name ?? AlvaStrings.Common_NoSprint;
    private string TaskName(Guid? id) => Tasks.FirstOrDefault(x => x.Id == id)?.Title ?? AlvaStrings.Common_RootTask;
    /// <summary>Title of the linked task; an archived or foreign task is not presented as the root task.</summary>
    private string LinkTitle(Guid id) => Tasks.FirstOrDefault(x => x.Id == id)?.Title ?? AlvaStrings.Task_TaskUnavailable;
    private string ActorName(Guid? id) => Actors.FirstOrDefault(x => x.Id == id)?.Name ?? AlvaStrings.Common_UnassignedTask;
    private string SkillName(Guid id) => Actors.FirstOrDefault(x => x.Id == id)?.Name ?? "";
    private IEnumerable<ActorModel> SkillActors => Actors.Where(a => a.Kind == "Skill");
    private string[] SkillNames(ActorModel actor) => actor.SkillIds.Select(id => Actors.FirstOrDefault(a => a.Id == id)?.Name).OfType<string>().ToArray();
    private IEnumerable<ActorModel> AssignablePeople => Actors.Where(a => a.Kind == "Person" && InTargetDepartment(a));
    private void SelectTarget(ActorModel actor) { _assignTarget = actor.Id; _assignPerson = null; }
    private bool InTargetDepartment(ActorModel person) =>
        Actors.FirstOrDefault(a => a.Id == _assignTarget) is not { Kind: "Department" } department || PersonInDepartment(person, department.Id);
    private bool PersonInDepartment(ActorModel person, Guid departmentId)
    {
        var departments = Actors.Where(a => a.Kind == "Department").ToDictionary(a => a.Id, a => a.ParentId);
        var periods = Actors.Where(a => a.Kind == "Department").ToDictionary(a => a.Id,
            a => a.DepartmentParentPeriods.Select(p => new DepartmentParentPeriodDto(p.Id, p.ParentId, p.From, p.To)).ToArray());
        var day = Item.StartDate ?? DateOnly.FromDateTime(DateTime.Today);
        Guid? ParentAt(Guid id) => DepartmentHierarchy.ParentOf(periods.GetValueOrDefault(id), id, day, departments.GetValueOrDefault(id));
        bool Walk(Guid start)
        {
            var seen = new HashSet<Guid>();
            for (Guid? current = start; current is { } id && seen.Add(id); current = ParentAt(id))
                if (id == departmentId) return true;
            return false;
        }
        var active = person.DepartmentMemberships.Where(m => m.From <= day && (m.To is null || day <= m.To)).Select(m => m.DepartmentId).ToArray();
        return (active.Length > 0 ? active : person.DepartmentIds).Any(Walk);
    }

    private static string KindLabel(string kind) => kind switch
    {
        "SS" => AlvaStrings.Task_StartStart,
        "FF" => AlvaStrings.Task_FinishFinish,
        "SF" => AlvaStrings.Task_StartFinish,
        _ => AlvaStrings.Task_FinishStart
    };
    private static string DirectionLabel(bool incoming) => incoming ? AlvaStrings.Task_PredecessorThisTaskWaitsForIt : AlvaStrings.Task_SuccessorWaitsForThisTask;

    /// <summary>Tasks this one can still be linked to: not itself and not already linked.</summary>
    private IEnumerable<Guid?> LinkCandidates => Tasks
        .Where(t => t.Id != Item.Id && !_dependencies.Any(d => d.PredecessorId == t.Id || d.SuccessorId == t.Id))
        .Select(t => (Guid?)t.Id);

    /// <summary>Task risk and its links. An error stays in the risk block and does not prevent editing the form.</summary>
    private async Task LoadLinks()
    {
        _linksFor = (Item.Id, Item.Version);
        _linksError = null;
        try
        {
            _dependencies = await Session.Get<DependencyDto[]>(Session.TeamPath($"tasks/{Item.Id}/dependencies"));
            _risk = (await Session.Get<RiskDto[]>(Session.TeamPath("risks"))).FirstOrDefault(r => r.TaskId == Item.Id);
        }
        catch (Exception e) when (e is HttpRequestException or InvalidOperationException)
        {
            _risk = null;
            _linksError = PageFeedback.Describe(e);
        }
    }

    private async Task AddDependency()
    {
        if (_linkTask is not { } other) return;
        var request = _linkIncoming
            ? new DependencyRequest(other, Item.Id, _linkKind, _linkLag)
            : new DependencyRequest(Item.Id, other, _linkKind, _linkLag);
        await Run(async () =>
        {
            await Session.Save<DependencyDto>(HttpMethod.Post, Session.TeamPath($"tasks/{Item.Id}/dependencies"), request);
            _linkTask = null; _linkLag = 0;
            await LoadLinks();
            await Changed.InvokeAsync();
        });
    }

    private async Task RemoveDependency(DependencyDto link)
    {
        var other = link.PredecessorId == Item.Id ? link.SuccessorId : link.PredecessorId;
        if (!await DestructivePrompt.ConfirmAsync(Confirm, AlvaStrings.Task_RemoveLink,
            string.Format(AlvaStrings.Task_TheLinkToWillBeRemovedTheForecastAndRiskWillBeRecalculated, LinkTitle(other)),
            AlvaStrings.Common_Delete)) return;
        await Run(async () =>
        {
            await Session.Send(HttpMethod.Delete, Session.TeamPath($"tasks/dependencies/{link.Id}"), new { });
            await LoadLinks();
            await Changed.InvokeAsync();
        });
    }

    /// <summary>Candidates of one kind. For people - load over the sprint window (or 14 days).</summary>
    private RenderFragment Candidates(string kind) => __builder =>
    {
        var list = Actors.Where(a => a.Kind == kind && (kind != "Person" || InTargetDepartment(a)) && (string.IsNullOrWhiteSpace(_assignSearch) || a.Name.Contains(_assignSearch, StringComparison.OrdinalIgnoreCase)))
            .OrderBy(a => kind == "Person" ? SkillMath.Missing(_model.RequiredSkillIds, a.SkillIds).Length : 0)
            .ThenBy(a => _load.ContainsKey(a.Id) ? Percent(a.Id) : int.MaxValue).ThenBy(a=>a.Name).ToArray();
        var recommended = kind == "Person" ? list.Where(a => SkillMath.Compatible(_model.RequiredSkillIds, a.SkillIds) && _load.ContainsKey(a.Id) && _load[a.Id].Available > 0).OrderBy(a => Percent(a.Id)).FirstOrDefault()?.Id : null;
        <FlareStack Gap="FlareSpacing.Small">
            <FlareTextField @bind-Value="_assignSearch" Immediate Clearable Placeholder="@string.Format(AlvaStrings.Task_SearchTheTeam, Session.TeamName)" AriaLabel="@(AlvaStrings.Task_SearchACandidate)">
                <AdornmentStart><FlareIconView Value="@MaterialDesign3Icons.Regular.Search" Size="18px" /></AdornmentStart>
            </FlareTextField>
            <FlareText Typo="TypographyScale.LabelMedium" Color="FlareColor.OnSurfaceVariant">@(AlvaStrings.Task_TeamCandidates) (@list.Length)@(kind == "Person" ? $" · {AlvaStrings.Task_PeriodCapacity}" : "")</FlareText>
            @if (list.Length == 0) { <FlareEmptyState Compact Title="@(AlvaStrings.Task_NobodyFound)" Description="@(AlvaStrings.Task_AddMembersInTheTeamSection)" /> }
            <FlareList TItem="ActorModel" Dense="true">
                @foreach (var actor in list)
                {
                    var percent = kind == "Person" && _load.ContainsKey(actor.Id) ? Percent(actor.Id) : (int?)null;
                    var reserve = _load.TryGetValue(actor.Id, out var l) ? l.Available - l.Allocated : 0;
                    var tone = percent is null ? AlvaTone.Role : percent > 100 ? AlvaTone.Critical : percent > 80 ? AlvaTone.Info : AlvaTone.Ok;
                    <FlareListItem @key="actor.Id" Selected="@(actor.Id == _assignTarget)" OnClick="() => SelectTarget(actor)">
                        <Leading><FlareAvatar Text="@AlvaFormat.Initials(actor.Name)" Size="AvatarSize.Sm" Color="@(kind == "Person" ? FlareColor.Primary : FlareColor.Tertiary)" /></Leading>
                        <ChildContent>
                            <FlareStack Gap="FlareSpacing.None">
                                <FlareStack Row Wrap Align="FlareAlignItems.Center" Gap="FlareSpacing.Small">
                                    <FlareText Typo="TypographyScale.LabelMedium">@actor.Name</FlareText>
                                    @if (actor.Id == recommended) { <AlvaStatusChip Tone="AlvaTone.Ok">@(AlvaStrings.Task_Recommended)</AlvaStatusChip> }
                                </FlareStack>
                                <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@CandidateMeta(actor)</FlareText>
                                @if (actor.Kind == "Person" && SkillNames(actor) is { Length: > 0 } actorSkills) { <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@(AlvaStrings.Task_Skills): @string.Join(", ", actorSkills)</FlareText> }
                                <SkillMatch Required="_model.RequiredSkillIds" Person="actor" Skills="SkillActors" />
                                @if (percent is not null)
                                {
                                    <AlvaStatusChip Tone="@tone">
                                        @(percent > 100 ? string.Format(AlvaStrings.Task_OverloadedDeficitH, AlvaFormat.Hours(-reserve)) : percent > 80 ? string.Format(AlvaStrings.Task_OptimalReserveH, AlvaFormat.Hours(reserve)) : string.Format(AlvaStrings.Task_FreeReserveH, AlvaFormat.Hours(reserve)))
                                    </AlvaStatusChip>
                                }
                                @if (actor.Id == Item.AssignmentTargetId || actor.Id == Item.ResolvedPersonId) { <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@(AlvaStrings.Task_CurrentAssignee)</FlareText> }
                            </FlareStack>
                        </ChildContent>
                        <Trailing>
                            @if (percent is not null) { <AlvaStatusChip Tone="@tone" Title="@(AlvaStrings.Common_WorkloadOverThePeriod)">@percent%</AlvaStatusChip> }
                        </Trailing>
                    </FlareListItem>
                }
            </FlareList>
        </FlareStack>
    };

    private string CandidateMeta(ActorModel actor)
    {
        if (actor.Kind != "Person") return $"{Labels.Kind(actor.Kind)} · {Actors.Count(a => a.Kind == "Person" && (a.SkillIds.Contains(actor.Id) || PersonInDepartment(a, actor.Id)))} {AlvaStrings.Common_People}";
        var tags = Actors.Where(a => actor.SkillIds.Contains(a.Id) || actor.DepartmentIds.Contains(a.Id)).Select(a => a.Name).ToArray();
        return tags.Length > 0 ? string.Join(" / ", tags) : AlvaStrings.Capacity_TeamMember;
    }

    private int Percent(Guid actorId)
    {
        var (available, allocated) = _load[actorId];
        return available > 0 ? (int)Math.Round(allocated / available * 100) : allocated > 0 ? 999 : 0;
    }

    private async Task OpenAssign()
    {
        _assignTarget = Item.AssignmentTargetId;
        _assignPerson = Item.ResolvedPersonId;
        _assignTab = Math.Max(0, Array.IndexOf(Kinds, Actors.FirstOrDefault(a => a.Id == Item.AssignmentTargetId)?.Kind ?? "Person"));
        _assignOpen = true;
        // Load is read on every open: while working with the card, team assignments change.
        var sprint = Sprints.FirstOrDefault(s => Item.SprintIds.Contains(s.Id));
        var from = sprint?.StartDate ?? DateOnly.FromDateTime(DateTime.Today);
        var to = sprint?.EndDate ?? from.AddDays(13);
        await Run(async () =>
        {
            var rows = await Session.Get<CapacityDto[]>(Session.TeamPath($"capacity?from={from:yyyy-MM-dd}&to={to:yyyy-MM-dd}"));
            _load = rows.GroupBy(r => r.ActorId).ToDictionary(g => g.Key, g => (g.Sum(r => r.AvailableHours), g.Sum(r => r.AllocatedHours)));
        });
    }

    /// <summary>After the panel closes, focus returns to Assign assignee in the actions panel:
    /// it is pinned and always on screen, even if the panel was opened from the risk block.</summary>
    private async Task AssignToggled()
    {
        if (!_assignOpen && _assignButton is not null) await _assignButton.FocusAsync();
    }

    private async Task CloseAssign()
    {
        _assignOpen = false;
        await AssignToggled();
    }

    private async Task ApplyAssign()
    {
        var person = Actors.FirstOrDefault(a => a.Id == _assignTarget)?.Kind == "Person" ? null : _assignPerson;
        await Run(async () =>
        {
            var updated = await Session.Assign(HttpMethod.Put, Session.TeamPath($"tasks/{Item.Id}/assignment"), new AssignmentRequest(_assignTarget!.Value, person));
            SyncAssignedVersion(updated);
            await CloseAssign();
            await Changed.InvokeAsync();
        });
    }

    private async Task ClearAssign()
    {
        await Run(async () =>
        {
            var updated = await Session.Assign(HttpMethod.Delete, Session.TeamPath($"tasks/{Item.Id}/assignment"), new { });
            _assignTarget = _assignPerson = null;
            SyncAssignedVersion(updated);
            await CloseAssign();
            await Changed.InvokeAsync();
        });
    }

    /// <summary>Assigning changes the task version on the server while the card keeps its draft: take the new
    /// version from the response so the next Save does not conflict and the draft is not lost.</summary>
    private void SyncAssignedVersion(TaskModel? updated)
    {
        if (updated is not null && updated.Id == _model.Id) _model.Version = updated.Version;
    }

    private void OpenTitleEdit()
    {
        _titleDraft = _model.Title;
        _titleEditing = true;
    }

    /// <summary>The dialog edits a draft copy: Cancel leaves the card unchanged and Apply only changes the card draft,
    /// which is saved later with the Save action.</summary>
    private void ApplyTitle()
    {
        if (string.IsNullOrWhiteSpace(_titleDraft)) return;
        _model.Title = _titleDraft;
        _titleEditing = false;
    }

    private void CancelTitle() => _titleEditing = false;

    private async Task Save()
    {
        if (!Validate())
        {
            StateHasChanged();
            await SafeFocus.Async(_errorSummary);
            return;
        }
        await Run(async () =>
        {
            var m = _model;
            await Session.Save<TaskModel>(HttpMethod.Put, Session.TeamPath($"tasks/{m.Id}"),
                new TaskRequest(m.Title, m.Description, m.Status, m.ProjectId, m.ParentId, m.EstimateHours, m.Deadline, m.StartDate, m.EndDate, m.Order, m.Version, RequiredSkillIds: m.RequiredSkillIds, Priority: m.Priority, RemainingHours: m.RemainingHours, SetRemainingHours: true, DatesFixed: m.DatesFixed, DailyHoursLimit: m.DailyHoursLimit, SetDailyHoursLimit: true));
            _saved = true;
            await Changed.InvokeAsync();
        });
    }

    private bool Validate()
    {
        _parentError=_startError=_endError=_estimateError=_remainingError=_limitError=null;
        _formErrors.Clear();
        var m=_model;
        if (m.StartDate is { } start && m.EndDate is { } end && start > end) Error(ref _endError, AlvaStrings.Common_TheEndDateIsBeforeTheStartDate);
        if (m.EstimateHours is < 0) Error(ref _estimateError, AlvaStrings.Common_TheEstimateCannotBeNegative);
        if (m.RemainingHours is < 0) Error(ref _remainingError, AlvaStrings.Common_RemainingWorkCannotBeNegative);
        if (DailyLimit.Error(m.DailyHoursLimit) is { } limitError) Error(ref _limitError, limitError);
        if (m.ParentId is { } parent && (parent == m.Id || IsDescendant(parent, m.Id))) Error(ref _parentError, AlvaStrings.Common_AParentTaskCannotBeTheTaskItselfOrOneOfItsDescendants);
        return _formErrors.Count == 0;
    }

    private bool IsDescendant(Guid candidate, Guid taskId)
    {
        var byId=Tasks.ToDictionary(t=>t.Id); var seen=new HashSet<Guid>();
        for (Guid? id=candidate; id is { } current && seen.Add(current) && byId.TryGetValue(current, out var task); id=task.ParentId)
            if (current == taskId) return true;
        return false;
    }

    private void Error(ref string? field, string message) { field=message; _formErrors.Add(message); }

    private async Task QuickKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await QuickAdd();
    }

    /// <summary>
    /// A subtask inherits the parent's project and lands in the backlog (without dates); its order is at the end of the list. While the request
    /// is running, a repeated Enter or click sends nothing; on error the entered title remains for retry.
    /// </summary>
    private async Task QuickAdd()
    {
        var title = _quickTitle?.Trim();
        if (_adding || string.IsNullOrEmpty(title)) return;
        _adding = true;
        try
        {
            await Run(async () =>
            {
                var order = Children.Select(c => c.Order).DefaultIfEmpty(-1).Max() + 1;
                await Session.Save<TaskModel>(HttpMethod.Post, Session.TeamPath("tasks"),
                    new TaskRequest(title, "", "Backlog", Item.ProjectId, Item.Id, null, null, null, null, order, null));
                _quickTitle = null;
                await Changed.InvokeAsync();
            });
        }
        finally { _adding = false; }
    }

    private async Task Archive()
    {
        if (!await DestructivePrompt.ConfirmAsync(Confirm, AlvaStrings.Task_ArchiveTask,
            string.Format(AlvaStrings.Common_TaskWillLeaveTheListsItCanTBeBroughtBackFromTheAppYet, Item.Title),
            AlvaStrings.Common_Archive)) return;
        await Run(async () =>
        {
            await Session.Send(HttpMethod.Delete, Session.TeamPath($"tasks/{Item.Id}"), new { });
            await Changed.InvokeAsync();
            _leaving = true;
            Navigation.NavigateTo("tasks");
        });
    }

    private async Task Run(Func<Task> action)
    {
        _busy = true; _error = null;
        try { await action(); }
        catch (HttpRequestException e) when (e.StatusCode == System.Net.HttpStatusCode.Conflict)
        {
            // The task was changed between reading and saving: the server rejected the stale version. Say in words
            // that the edits were not saved and show the current state: without this the person would save
            // over the stale version again and again, seeing only the response code.
            _error = AlvaStrings.Task_SomeoneElseChangedThisTaskSoYourEditsWereNotSavedTheLatestDataHasBeenRel_249809;
            _adoptFresh = true;
            if (Changed.HasDelegate) await Changed.InvokeAsync();
            else { _model = Fresh(); _adoptFresh = false; }
        }
        catch (Exception e) when (e is HttpRequestException or InvalidOperationException) { _error = PageFeedback.Describe(e); }
        finally { _busy = false; }
    }
}
