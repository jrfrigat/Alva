@* Страница задачи по макету p9: крошки, действия, описание и параметры, дерево задач подзадач,
   история и боковая панель назначения исполнителя с загрузкой кандидатов. *@
@implements IDisposable
@inject AlvaSession Session
@inject NavigationManager Navigation
@inject DraftGuard Drafts
<NavigationLock OnBeforeInternalNavigation="ConfirmLeave" ConfirmExternalNavigation="Dirty" />
<div class="alva-task">
    <FlareBreadcrumb Items="Crumbs" Separator="›" AriaLabel="@(Strings.T("Путь к задаче"))" />
    <div class="alva-task__actions">
        <FlareButton Loading="_busy" Disabled="@string.IsNullOrWhiteSpace(_model.Title)" OnClick="Save" Size="ButtonSize.Sm">
            <LeadingIcon><FlareIconView Value="@MaterialDesign3Icons.Regular.Save" Size="18px" /></LeadingIcon>
            <ChildContent>@(Strings.T("Сохранить"))</ChildContent>
        </FlareButton>
        <FlareButton Variant="ButtonVariant.Tonal" OnClick="OpenAssign" Size="ButtonSize.Sm">
            <LeadingIcon><FlareIconView Value="@MaterialDesign3Icons.Regular.PersonAdd" Size="18px" /></LeadingIcon>
            <ChildContent>@(Strings.T("Назначить исполнителя"))</ChildContent>
        </FlareButton>
        <FlareIconButton Icon="@MaterialDesign3Icons.Regular.Delete" Color="FlareColor.Error" Size="ButtonSize.Sm" Tooltip="@(Strings.T("Архивировать задачу"))" AriaLabel="@(Strings.T("Архивировать задачу"))" OnClick="Archive" />
    </div>
    <div class="alva-task__heading">
        <span class="alva-task__bar alva-task__bar--@RiskTone.ToString().ToLowerInvariant()" aria-hidden="true"></span>
        <ReadyHeading Class="alva-task__title"><span class="alva-task__code">@Code(Item)</span> @Item.Title</ReadyHeading>
        <AlvaStatusChip Tone="AlvaTones.Status(Item.Status)">@Labels.Status(Item.Status)</AlvaStatusChip>
    </div>
    <PageFeedback Error="@_error" />

    <section class="alva-panel">
        <header class="alva-panel__header">
            <FlareIconView Value="@MaterialDesign3Icons.Regular.Description" Size="20px" Class="alva-panel__icon" />
            <h2 class="alva-panel__title">@(Strings.T("Описание и параметры"))</h2>
        </header>
        <FlareStack Gap="FlareSpacing.Medium">
            <FlareTextField Label="@(Strings.T("Название"))" @bind-Value="_model.Title" Required MaxLength="500" />
            <FlareTextArea Label="@(Strings.T("Описание и цели"))" @bind-Value="_model.Description" AutoGrow />
            <SkillTagEditor Label="@(Strings.T("Необходимые навыки"))" @bind-Values="_model.RequiredSkills"
                            Suggestions="Actors.SelectMany(a=>a.Skills).Concat(Tasks.SelectMany(t=>t.RequiredSkills)).Distinct(StringComparer.OrdinalIgnoreCase)" />
            <SkillMatch Required="_model.RequiredSkills" Person="@(Actors.FirstOrDefault(a=>a.Id==(Item.ResolvedPersonId ?? Item.AssignmentTargetId)))" />
            <FlareGrid MinColumnWidth="min(100%,12rem)">
                <FlareSelect TValue="string" Label="@(Strings.T("Статус"))" Items="Statuses" ItemLabel="Labels.Status" @bind-Value="_model.Status" />
                <FlareSelect TValue="string" Label="@(Strings.T("Приоритет"))" Items="Labels.Priorities" ItemLabel="Labels.Priority" @bind-Value="_model.Priority" />
                <FlareSelect TValue="Guid?" Label="@(Strings.T("Проект"))" Items="Projects.Select(x => (Guid?)x.Id)" ItemLabel="ProjectName" NullOption="@(Strings.T("Текучка"))" @bind-Value="_model.ProjectId" />
                <FlareSelect TValue="Guid?" Label="@(Strings.T("Спринт (по датам)"))" Items="Sprints.OrderBy(x => x.StartDate).Select(x => (Guid?)x.Id)" ItemLabel="SprintName" NullOption="@(Strings.T("Бэклог — без дат"))" Value="SprintDates.First(_model, Sprints)" ValueChanged="id => SprintDates.Place(_model, Sprints.FirstOrDefault(s => s.Id == id))" HelperText="@SprintDates.Hint(_model, Sprints)" Disabled="_model.DatesFixed" />
                <FlareSelect TValue="Guid?" Label="@(Strings.T("Родительская задача"))" Items="Tasks.Where(x => x.Id != Item.Id).Select(x => (Guid?)x.Id)" ItemLabel="TaskName" NullOption="@(Strings.T("Корневая задача"))" @bind-Value="_model.ParentId" Searchable />
                <FlareNumericField TValue="decimal?" Label="@(Strings.T("Оценка, часы"))" @bind-Value="_model.EstimateHours" Min="0" />
                <FlareNumericField TValue="decimal?" Label="@(Strings.T("Остаток, часы"))" @bind-Value="_model.RemainingHours" Min="0" Max="100000" HelperText="@(Strings.T("Для начатой задачи пустое поле означает неизвестный остаток; 0 — работа закончена."))" />
                <FlareDatePicker Label="@(Strings.T("Дедлайн"))" @bind-Value="_model.Deadline" />
                <FlareDatePicker Label="@(Strings.T("Начало"))" @bind-Value="_model.StartDate" Disabled="_model.DatesFixed" />
                <FlareDatePicker Label="@(Strings.T("Окончание"))" @bind-Value="_model.EndDate" Disabled="_model.DatesFixed" />
            </FlareGrid>
            <FlareStack Gap="FlareSpacing.Small">
                <FlareSwitch @bind-Value="_model.DatesFixed" Label="@(Strings.T("Фиксированные даты — не переносить"))"
                             Disabled="@(_model.StartDate is null || _model.EndDate is null)" />
                <FlareText Typo="TypographyScale.BodySmall">@FixedHint</FlareText>
            </FlareStack>
            <div class="alva-task__assignee">
                <span class="alva-micro-label">@(Strings.T("Исполнитель"))</span>
                <AlvaAssignee Task="Item" Actors="Actors" />
            </div>
        </FlareStack>
    </section>

    <section class="alva-panel">
        <header class="alva-panel__header">
            <FlareIconView Value="@MaterialDesign3Icons.Regular.Layers" Size="20px" Class="alva-panel__icon" />
            <div>
                <h2 class="alva-panel__title">@(Strings.T("Подзадачи"))</h2>
                <p class="alva-panel__subtitle">@(Strings.T("Суммарная оценка и исполнители подзадач"))</p>
            </div>
        </header>
        <div class="alva-task__summary">
            <span class="alva-task__summary-label">@(Strings.T("Суммарно:"))</span>
            <span class="alva-task__summary-value alva-num">
                <FlareIconView Value="@MaterialDesign3Icons.Regular.Schedule" Size="16px" />
                @AlvaFormat.Hours(Children.Sum(c => c.EstimateHours ?? 0)) @(Strings.T("ч")) (@Children.Length @AlvaFormat.Plural(Children.Length, "subtask"))
            </span>
            @if (Children.Where(c => c.Deadline.HasValue).Select(c => c.Deadline!.Value).DefaultIfEmpty().Max() is var last && last != default)
            {
                <span class="alva-task__summary-sep" aria-hidden="true"></span>
                <span class="alva-task__summary-date alva-num"><FlareIconView Value="@MaterialDesign3Icons.Regular.Event" Size="16px" /> @(Strings.T("до")) @last.ToString("d MMM yyyy")</span>
            }
        </div>
        <div class="alva-subtasks" role="table" aria-label="@(Strings.T("Подзадачи"))">
            <div class="alva-subtasks__head" role="row">
                <span role="columnheader">@(Strings.T("Иерархия подзадач"))</span><span role="columnheader">@(Strings.T("Исполнитель / слот"))</span><span role="columnheader" class="alva-subtasks__est">@(Strings.T("Оценка"))</span>
            </div>
            @for (var i = 0; i < Children.Length; i++)
            {
                var child = Children[i];
                <div class="alva-subtasks__row" role="row" @key="child.Id">
                    <span class="alva-subtasks__name" role="cell">
                        <FlareIconView Value="@MaterialDesign3Icons.Regular.SubdirectoryArrowRight" Size="16px" Class="alva-subtasks__arrow" />
                        <a class="alva-subtasks__code" href="@($"tasks/{child.Id}")">@Code(Item).@(i + 1)</a>
                        <a class="alva-subtasks__title" href="@($"tasks/{child.Id}")" title="@child.Title">@child.Title</a>
                    </span>
                    <span role="cell"><AlvaAssignee Task="child" Actors="Actors" /></span>
                    <span class="alva-subtasks__est alva-num" role="cell">@(child.EstimateHours.HasValue ? $"{AlvaFormat.Hours(child.EstimateHours.Value)} {Strings.T("ч")}" : "—")</span>
                </div>
            }
            <div class="alva-subtasks__add">
                <FlareTextField @bind-Value="_quickTitle" Immediate Placeholder="@(Strings.T("Быстрое добавление вложенной задачи (Enter)…"))" AriaLabel="@(Strings.T("Название новой подзадачи"))" OnKeyDown="QuickKey" Variant="InputVariant.Bare">
                    <AdornmentStart><FlareIconView Value="@MaterialDesign3Icons.Regular.AddCircle" Size="18px" /></AdornmentStart>
                </FlareTextField>
                <FlareButton Variant="ButtonVariant.Tonal" Size="ButtonSize.Sm" Loading="_adding" Disabled="@(_adding || string.IsNullOrWhiteSpace(_quickTitle))" OnClick="QuickAdd">@(Strings.T("Добавить вложенную задачу"))</FlareButton>
            </div>
        </div>
    </section>

    <section class="alva-panel">
        <header class="alva-panel__header">
            <FlareIconView Value="@MaterialDesign3Icons.Regular.History" Size="20px" Class="alva-panel__icon" />
            <h2 class="alva-panel__title">@(Strings.T("История изменений")) (@_history.Length)</h2>
        </header>
        @if (_history.Length == 0) { <FlareEmptyState Compact Title="@(Strings.T("Изменений пока нет"))" Description="@(Strings.T("Правки задачи появятся здесь."))" /> }
        @foreach (var entry in _history)
        {
            <div class="alva-history">
                <FlareAvatar FallbackIcon="@MaterialDesign3Icons.Regular.History" Size="AvatarSize.Sm" />
                <div class="alva-history__body">
                    <span class="alva-history__summary">@entry.Summary</span>
                    <span class="alva-history__time alva-num">@entry.At.ToLocalTime().ToString("g")</span>
                </div>
            </div>
        }
    </section>
</div>

<FlareDrawer Anchor="DrawerAnchor.Right" @bind-Open="_assignOpen" Width="26rem" AriaLabel="@(Strings.T("Назначение исполнителя"))">
    <HeaderContent>
        <div class="alva-assign__header">
            <FlareIconView Value="@MaterialDesign3Icons.Regular.PersonAdd" Size="22px" Class="alva-panel__icon" />
            <div>
                <div class="alva-assign__title">@(Strings.T("Назначение исполнителя"))</div>
                <div class="alva-assign__task alva-num">@Code(Item)@(Item.EstimateHours.HasValue ? $" ({AlvaFormat.Hours(Item.EstimateHours.Value)}{Strings.T("ч")})" : "")</div>
            </div>
        </div>
    </HeaderContent>
    <ChildContent>
        <div class="alva-assign">
            <span class="alva-micro-label">@(Strings.T("Тип балансировки"))</span>
            <FlareTabs @bind-ActiveIndex="_assignTab">
                @foreach (var kind in Kinds)
                {
                    <FlareTab Label="@Labels.Kind(kind)">@Candidates(kind)</FlareTab>
                }
            </FlareTabs>
            @if (Actors.FirstOrDefault(a => a.Id == _assignTarget)?.Kind is "Role" or "Department")
            {
                <FlareSelect TValue="Guid?" Label="@(Strings.T("Конкретный исполнитель"))" Items="@(Actors.Where(a => a.Kind == "Person").Select(a => (Guid?)a.Id))" ItemLabel="ActorName" NullOption="@(Strings.T("Пока не выбран — требуется человек"))" @bind-Value="_assignPerson" Searchable />
            }
            <div class="alva-assign__footer">
                <FlareButton Variant="ButtonVariant.Text" Size="ButtonSize.Sm" OnClick="() => _assignOpen = false">@(Strings.T("Отмена"))</FlareButton>
                <FlareButton Size="ButtonSize.Sm" Loading="_busy" Disabled="@(_assignTarget is null)" OnClick="ApplyAssign">
                    <LeadingIcon><FlareIconView Value="@MaterialDesign3Icons.Regular.Check" Size="18px" /></LeadingIcon>
                    <ChildContent>@(Strings.T("Применить назначение"))</ChildContent>
                </FlareButton>
            </div>
        </div>
    </ChildContent>
</FlareDrawer>

@code {
    /// <summary>Открытая задача.</summary>
    [Parameter, EditorRequired] public TaskModel Item { get; set; } = default!;

    /// <summary>Все задачи команды: из них берутся подзадачи и родитель.</summary>
    [Parameter] public TaskModel[] Tasks { get; set; } = [];
    [Parameter] public ProjectModel[] Projects { get; set; } = [];
    [Parameter] public SprintModel[] Sprints { get; set; } = [];
    [Parameter] public ActorModel[] Actors { get; set; } = [];

    /// <summary>Вызывается после изменения задач: страница перечитывает их.</summary>
    [Parameter] public EventCallback Changed { get; set; }

    private static readonly string[] Statuses = ["Backlog", "Planned", "InProgress", "Done", "Cancelled"];
    private static readonly string[] Kinds = ["Person", "Department", "Role"];
    private TaskModel _model = new();
    private HistoryDto[] _history = [];
    private Dictionary<Guid, (decimal Available, decimal Allocated)> _load = [];
    private Guid _loadedFor;
    private string? _error, _quickTitle, _assignSearch;
    private bool _busy, _assignOpen, _adding;
    private int _assignTab;
    private Guid? _assignTarget, _assignPerson;

    private TaskModel[] Children => Tasks.Where(t => t.ParentId == Item.Id).OrderBy(t => t.Order).ToArray();

    private IEnumerable<BreadcrumbItem> Crumbs
    {
        get
        {
            yield return new(Strings.T("Задачи"), "tasks");
            if (Projects.FirstOrDefault(p => p.Id == Item.ProjectId) is { } project) yield return new(project.Name, "projects");
            if (Sprints.FirstOrDefault(s => Item.SprintIds.Contains(s.Id)) is { } sprint) yield return new(sprint.Name, $"sprints/{sprint.Id}");
            yield return new(Code(Item));
        }
    }

    /// <summary>Полоса у заголовка: просрочка — crimson, нет исполнителя — amber, иначе sapphire.</summary>
    private AlvaTone RiskTone =>
        Item.Status is "Done" or "Cancelled" ? AlvaTone.Ok
        : Item.Deadline < DateOnly.FromDateTime(DateTime.Today) ? AlvaTone.Critical
        : Item.AssignmentTargetId is null ? AlvaTone.Warning
        : AlvaTone.Info;

    /// <summary>Подтверждение потери правок; приходит от FlareConfirmDialogProvider в MainLayout.</summary>
    [CascadingParameter] public FlareConfirmDialogProvider? Confirm { get; set; }

    private bool _leaving;
    private IDisposable? _draft;
    protected override void OnInitialized() => _draft = Drafts.Track(() => Dirty);
    public void Dispose() => _draft?.Dispose();

    // Черновик уступает свежим данным после конфликта версий: иначе сохранение уходило бы со старой версией.
    private bool _adoptFresh;

    /// <summary>Черновик расходится с задачей: уход со страницы или перечитывание её потеряли бы правки.</summary>
    /// <summary>Есть ли в черновике несохранённые правки: страница по этому признаку решает, можно ли уйти по
    /// Esc, не теряя работу.</summary>
    public bool Dirty => _model.Id == Item.Id && (_model.Title != Item.Title || _model.Description != Item.Description
        || _model.Status != Item.Status || _model.ProjectId != Item.ProjectId || _model.ParentId != Item.ParentId
        || _model.RemainingHours != Item.RemainingHours || _model.EstimateHours != Item.EstimateHours || _model.Deadline != Item.Deadline
        || _model.StartDate != Item.StartDate || _model.EndDate != Item.EndDate || _model.Priority != Item.Priority
        || _model.DatesFixed != Item.DatesFixed || !_model.RequiredSkills.SequenceEqual(Item.RequiredSkills));

    // Ссылки, меню и Back/Forward: несохранённые правки уходят только после явного согласия.
    private async Task ConfirmLeave(LocationChangingContext context)
    {
        if (_leaving || !Dirty || Confirm is null) return;
        var leave = await Confirm.ConfirmAsync(Strings.T("Несохранённые изменения"),
            Strings.T("В карточке задачи есть несохранённые правки. Уйти и потерять их?"), Strings.T("Уйти без сохранения"), Strings.T("Остаться"));
        if (leave != true) context.PreventNavigation();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_model.Id == Item.Id && _model.Version == Item.Version) return;
        // Задачу перечитали (подзадача, назначение, чужая правка), а черновик ещё не сохранён — он остаётся;
        // сохранение уйдёт со старой версией, и сервер сообщит о конфликте вместо тихой потери правок.
        // После конфликта черновик, наоборот, уступает свежим данным (_adoptFresh): сохранять поверх
        // устаревшей версии бессмысленно, а человеку нужно видеть актуальное состояние.
        if (Dirty && !_adoptFresh) return;
        _adoptFresh = false;
        _model = Fresh();
        _quickTitle = null;
        try { _history = await Session.Get<HistoryDto[]>(Session.TeamPath($"tasks/{Item.Id}/history")); }
        catch (Exception e) when (e is HttpRequestException or InvalidOperationException) { _error = e.Message; }
    }

    private static string Code(TaskModel task) => AlvaFormat.Code(task.Id);

    /// <summary>Подсказка под переключателем: почему он недоступен или что включает.</summary>
    private string FixedHint => _model.StartDate is null || _model.EndDate is null
        ? Strings.T("Сначала задайте начало и окончание — тогда даты можно зафиксировать.")
        : _model.DatesFixed
            ? Strings.T("Даты зафиксированы: задача не переносится ни вручную, ни автобалансом.")
            : Strings.T("Включите, чтобы запретить перенос задачи и изменение её дат.");

    /// <summary>Копия задачи из параметра: черновик карточки — отдельный объект, поэтому правки не трогают
    /// данные страницы, пока их не сохранили.</summary>
    private TaskModel Fresh() => System.Text.Json.JsonSerializer.Deserialize<TaskModel>(System.Text.Json.JsonSerializer.Serialize(Item))!;
    private string ProjectName(Guid? id) => Projects.FirstOrDefault(x => x.Id == id)?.Name ?? Strings.T("Текучка");
    private string SprintName(Guid? id) => Sprints.FirstOrDefault(x => x.Id == id)?.Name ?? Strings.T("Без спринта");
    private string TaskName(Guid? id) => Tasks.FirstOrDefault(x => x.Id == id)?.Title ?? Strings.T("Корневая задача");
    private string ActorName(Guid? id) => Actors.FirstOrDefault(x => x.Id == id)?.Name ?? Strings.T("Не назначена");

    /// <summary>Кандидаты одного вида. У людей — загрузка за окно спринта (или 14 дней).</summary>
    private RenderFragment Candidates(string kind) => __builder =>
    {
        var list = Actors.Where(a => a.Kind == kind && (string.IsNullOrWhiteSpace(_assignSearch) || a.Name.Contains(_assignSearch, StringComparison.OrdinalIgnoreCase)))
            .OrderBy(a => kind == "Person" ? SkillMath.Missing(_model.RequiredSkills, a.Skills).Length : 0)
            .ThenBy(a => _load.ContainsKey(a.Id) ? Percent(a.Id) : int.MaxValue).ThenBy(a=>a.Name).ToArray();
        var recommended = kind == "Person" ? list.Where(a => SkillMath.Compatible(_model.RequiredSkills, a.Skills) && _load.ContainsKey(a.Id) && _load[a.Id].Available > 0).OrderBy(a => Percent(a.Id)).FirstOrDefault()?.Id : null;
        <div class="alva-assign__list">
            <FlareTextField @bind-Value="_assignSearch" Immediate Clearable Placeholder="@string.Format(Strings.T("Поиск по команде {0}…"), Session.TeamName)" AriaLabel="@(Strings.T("Поиск кандидата"))">
                <AdornmentStart><FlareIconView Value="@MaterialDesign3Icons.Regular.Search" Size="18px" /></AdornmentStart>
            </FlareTextField>
            <div class="alva-assign__caption"><span>@(Strings.T("Кандидаты команды")) (@list.Length)</span>@if (kind == "Person") { <span>@(Strings.T("Ёмкость периода"))</span> }</div>
            @if (list.Length == 0) { <FlareEmptyState Compact Title="@(Strings.T("Никого не найдено"))" Description="@(Strings.T("Добавьте участников в разделе «Команда»."))" /> }
            <FlareRadioGroup TValue="Guid?" @bind-Value="_assignTarget" Label="@string.Format(Strings.T("Кандидаты: {0}"), Labels.Kind(kind))" Class="alva-assign__group">
                @foreach (var actor in list)
                {
                    var percent = kind == "Person" && _load.ContainsKey(actor.Id) ? Percent(actor.Id) : (int?)null;
                    var reserve = _load.TryGetValue(actor.Id, out var l) ? l.Available - l.Allocated : 0;
                    var tone = percent is null ? AlvaTone.Role : percent > 100 ? AlvaTone.Critical : percent > 80 ? AlvaTone.Info : AlvaTone.Ok;
                    @* Вся карточка — подпись радиокнопки: клик по ней выбирает кандидата. *@
                    <div class="alva-candidate @(kind != "Person" ? "alva-candidate--group" : "") @(actor.Id == _assignTarget ? "alva-candidate--selected" : "") @(actor.Id == recommended ? "alva-candidate--recommended" : "")" @key="actor.Id">
                        <FlareRadio TValue="Guid?" Value="actor.Id">
                            <span class="alva-candidate__content">
                                <span class="alva-slot__mark alva-candidate__avatar" aria-hidden="true">@AlvaFormat.Initials(actor.Name)</span>
                                <span class="alva-candidate__body">
                                    <span class="alva-candidate__name">@actor.Name @if (actor.Id == recommended) { <AlvaStatusChip Tone="AlvaTone.Ok">@(Strings.T("Рекомендовано"))</AlvaStatusChip> }</span>
                                    <span class="alva-candidate__meta">@CandidateMeta(actor)</span>
                                    @if (actor.Kind == "Person" && actor.Skills.Length > 0) { <span class="alva-candidate__meta">@(Strings.T("Навыки")): @string.Join(", ", actor.Skills)</span> }
                                    <SkillMatch Required="_model.RequiredSkills" Person="actor" />
                                    @if (percent is not null)
                                    {
                                        <span class="alva-candidate__state alva-candidate__state--@tone.ToString().ToLowerInvariant()">
                                            @(percent > 100 ? string.Format(Strings.T("Перегружен (дефицит {0}ч)"), AlvaFormat.Hours(-reserve)) : percent > 80 ? string.Format(Strings.T("Оптимально (резерв +{0}ч)"), AlvaFormat.Hours(reserve)) : string.Format(Strings.T("Свободен (резерв +{0}ч)"), AlvaFormat.Hours(reserve)))
                                        </span>
                                    }
                                    @if (actor.Id == Item.AssignmentTargetId || actor.Id == Item.ResolvedPersonId) { <span class="alva-candidate__current">@(Strings.T("Текущий исполнитель"))</span> }
                                </span>
                                @if (percent is not null) { <span class="alva-candidate__side"><AlvaStatusChip Tone="tone" Title="@(Strings.T("Загрузка за период"))">@percent%</AlvaStatusChip></span> }
                            </span>
                        </FlareRadio>
                    </div>
                }
            </FlareRadioGroup>
        </div>
    };

    private string CandidateMeta(ActorModel actor)
    {
        if (actor.Kind != "Person") return $"{Labels.Kind(actor.Kind)} · {Actors.Count(a => a.Kind == "Person" && (a.RoleIds.Contains(actor.Id) || a.DepartmentIds.Contains(actor.Id)))} {Strings.T("чел.")}";
        var tags = Actors.Where(a => actor.RoleIds.Contains(a.Id) || actor.DepartmentIds.Contains(a.Id)).Select(a => a.Name).ToArray();
        return tags.Length > 0 ? string.Join(" / ", tags) : Strings.T("Участник команды");
    }

    private int Percent(Guid actorId)
    {
        var (available, allocated) = _load[actorId];
        return available > 0 ? (int)Math.Round(allocated / available * 100) : allocated > 0 ? 999 : 0;
    }

    private async Task OpenAssign()
    {
        _assignTarget = Item.AssignmentTargetId;
        _assignPerson = Item.ResolvedPersonId;
        _assignTab = Math.Max(0, Array.IndexOf(Kinds, Actors.FirstOrDefault(a => a.Id == Item.AssignmentTargetId)?.Kind ?? "Person"));
        _assignOpen = true;
        if (_loadedFor == Item.Id) return;
        var sprint = Sprints.FirstOrDefault(s => Item.SprintIds.Contains(s.Id));
        var from = sprint?.StartDate ?? DateOnly.FromDateTime(DateTime.Today);
        var to = sprint?.EndDate ?? from.AddDays(13);
        await Run(async () =>
        {
            var rows = await Session.Get<CapacityDto[]>(Session.TeamPath($"capacity?from={from:yyyy-MM-dd}&to={to:yyyy-MM-dd}"));
            _load = rows.GroupBy(r => r.ActorId).ToDictionary(g => g.Key, g => (g.Sum(r => r.AvailableHours), g.Sum(r => r.AllocatedHours)));
            _loadedFor = Item.Id;
        });
    }

    private async Task ApplyAssign()
    {
        var person = Actors.FirstOrDefault(a => a.Id == _assignTarget)?.Kind == "Person" ? null : _assignPerson;
        await Run(async () =>
        {
            await Session.Send(HttpMethod.Put, Session.TeamPath($"tasks/{Item.Id}/assignment"), new AssignmentRequest(_assignTarget!.Value, person));
            _assignOpen = false;
            _loadedFor = Guid.Empty;
            await Changed.InvokeAsync();
        });
    }

    private Task Save() => Run(async () =>
    {
        var m = _model;
        await Session.Save<TaskModel>(HttpMethod.Put, Session.TeamPath($"tasks/{m.Id}"),
            new TaskRequest(m.Title, m.Description, m.Status, m.ProjectId, m.ParentId, m.EstimateHours, m.Deadline, m.StartDate, m.EndDate, m.Order, m.Version, m.RequiredSkills, m.Priority, RemainingHours: m.RemainingHours, SetRemainingHours: true, DatesFixed: m.DatesFixed));
        await Changed.InvokeAsync();
    });

    private async Task QuickKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await QuickAdd();
    }

    /// <summary>
    /// Подзадача наследует проект родителя и попадает в бэклог (без дат); порядок — в конец списка. Пока запрос идёт,
    /// повторный Enter или клик ничего не отправляет; при ошибке введённое название остаётся для повтора.
    /// </summary>
    private async Task QuickAdd()
    {
        var title = _quickTitle?.Trim();
        if (_adding || string.IsNullOrEmpty(title)) return;
        _adding = true;
        try
        {
            await Run(async () =>
            {
                var order = Children.Select(c => c.Order).DefaultIfEmpty(-1).Max() + 1;
                await Session.Save<TaskModel>(HttpMethod.Post, Session.TeamPath("tasks"),
                    new TaskRequest(title, "", "Backlog", Item.ProjectId, Item.Id, null, null, null, null, order, null));
                _quickTitle = null;
                await Changed.InvokeAsync();
            });
        }
        finally { _adding = false; }
    }

    private Task Archive() => Run(async () =>
    {
        await Session.Send(HttpMethod.Delete, Session.TeamPath($"tasks/{Item.Id}"), new { });
        await Changed.InvokeAsync();
        _leaving = true;
        Navigation.NavigateTo("tasks");
    });

    private async Task Run(Func<Task> action)
    {
        _busy = true; _error = null;
        try { await action(); }
        catch (HttpRequestException e) when (e.StatusCode == System.Net.HttpStatusCode.Conflict)
        {
            // Задачу изменили между чтением и сохранением: сервер отверг устаревшую версию. Говорим словами,
            // что правки не сохранены, и показываем актуальное состояние: без этого человек сохранял бы
            // поверх устаревшей версии снова и снова, видя только код ответа.
            _error = Strings.T("Задачу изменил кто-то другой: ваши правки не сохранены. Данные перечитаны — перенесите нужное и сохраните снова.");
            _adoptFresh = true;
            if (Changed.HasDelegate) await Changed.InvokeAsync();
            else { _model = Fresh(); _adoptFresh = false; }
        }
        catch (Exception e) when (e is HttpRequestException or InvalidOperationException) { _error = e.Message; }
        finally { _busy = false; }
    }
}
