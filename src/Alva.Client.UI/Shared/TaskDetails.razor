@* Страница задачи по макету p9: крошки, закреплённые действия, риск с причинами, секции формы,
   зависимости, подзадачи, история и боковая панель назначения исполнителя с загрузкой кандидатов. *@
@implements IDisposable
@inject AlvaSession Session
@inject NavigationManager Navigation
@inject DraftGuard Drafts
<NavigationLock OnBeforeInternalNavigation="ConfirmLeave" ConfirmExternalNavigation="Dirty" />
<FlareStack Gap="FlareSpacing.Large">
    <div @ref="_heading" tabindex="-1">
    <FlarePageHeader Title="@_model.Title" HeadingLevel="@HeadingLevel">
        <EyebrowContent><FlareBreadcrumb Items="Crumbs" Separator="›" AriaLabel="@(Strings.T("Путь к задаче"))" /></EyebrowContent>
        <DescriptionContent>
            <FlareStack Row Wrap Align="FlareAlignItems.Center" Gap="FlareSpacing.Small">
                <AlvaStatusChip Tone="AlvaTones.Status(Item.Status)">@Labels.Status(Item.Status)</AlvaStatusChip>
                @* Задача пришла из внешнего трекера: ключ ведёт туда, где её ведут, а синхронизация обновит её здесь. *@
                @if (Item.ExternalKey is { } externalKey)
                {
                    @if (Item.ExternalUrl is { Length: > 0 } externalUrl)
                    {
                        <FlareLink Class="alva-task__external" Href="@externalUrl" target="_blank" rel="noopener noreferrer" title="@(Strings.T("Открыть во внешнем трекере"))">@externalKey ↗</FlareLink>
                    }
                    else { <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@externalKey</FlareText> }
                }
            </FlareStack>
        </DescriptionContent>
        <ActionsContent>
            <FlareButton Loading="_busy" Disabled="@(string.IsNullOrWhiteSpace(_model.Title) || !Dirty)" OnClick="Save" Size="ButtonSize.Sm">
                <LeadingIcon><FlareIconView Value="@MaterialDesign3Icons.Regular.Save" Size="18px" /></LeadingIcon>
                <ChildContent>@(Strings.T("Сохранить"))</ChildContent>
            </FlareButton>
            <FlareButton @ref="_assignButton" Variant="ButtonVariant.Tonal" OnClick="OpenAssign" Size="ButtonSize.Sm">
                <LeadingIcon><FlareIconView Value="@MaterialDesign3Icons.Regular.PersonAdd" Size="18px" /></LeadingIcon>
                <ChildContent>@(Strings.T("Назначить исполнителя"))</ChildContent>
            </FlareButton>
            <FlareIconButton Icon="@MaterialDesign3Icons.Regular.Delete" Color="FlareColor.Error" Size="ButtonSize.Sm" Tooltip="@(Strings.T("Архивировать задачу"))" AriaLabel="@(Strings.T("Архивировать задачу"))" OnClick="Archive" />
            <EditorStatus Dirty="Dirty" Saving="_busy" Saved="_saved" />
        </ActionsContent>
    </FlarePageHeader>
    </div>
    <PageFeedback Error="@_error" />

    <FlareSection Class="alva-task__risk">
        <HeadingContent>
            <FlareStack Row StretchFirst Align="FlareAlignItems.Center" Gap="FlareSpacing.Small">
                <FlareIconView Value="@MaterialDesign3Icons.Regular.Warning" Size="20px" />
                <FlareText Element="h2" Typo="TypographyScale.TitleLarge">@(Strings.T("Риск"))</FlareText>
                @if (_risk is not null) { <AlvaStatusChip Tone="AlvaTones.Severity(_risk.Severity)">@(_risk.Severity == "High" ? Strings.T("Высокий") : Strings.T("Средний"))</AlvaStatusChip> }
            </FlareStack>
        </HeadingContent>
        <ChildContent>
            @if (_linksError is not null) { <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.Error">@_linksError</FlareText> }
            else if (_risk is null) { <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@(Strings.T("Рисков нет: срок, исполнитель и зависимости в порядке."))</FlareText> }
            else
            {
                @if (_risk.ForecastDate is { } forecast) { <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@string.Format(Strings.T("Прогноз завершения: {0}"), forecast.ToString("d MMM yyyy"))</FlareText> }
                <FlareStack Gap="FlareSpacing.XSmall">
                    @foreach (var reason in _risk.Reasons)
                    {
                        <FlareStack Row Wrap Align="FlareAlignItems.Center" Gap="FlareSpacing.Small">
                            @if (reason.Code is ReasonCodes.RiskNoAssignee or ReasonCodes.RiskRequiredPerson)
                            {
                                @* Ссылка вела бы на эту же карточку: действие — сразу открыть назначение. *@
                                <FlareText Typo="TypographyScale.BodySmall">@ReasonText.Describe(reason)</FlareText>
                                <FlareButton Variant="ButtonVariant.Text" Size="ButtonSize.Sm" OnClick="OpenAssign">@(Strings.T("Назначить исполнителя"))</FlareButton>
                            }
                            else
                            {
                                <FlareLink Href="@RiskActions.Href(reason, Item.Id, Item.ResolvedPersonId)" title="@RiskActions.Label(reason, Item.ResolvedPersonId)">@ReasonText.Describe(reason)</FlareLink>
                            }
                        </FlareStack>
                    }
                </FlareStack>
            }
        </ChildContent>
    </FlareSection>

    <FlareSection>
        <HeadingContent>
            <FlareStack Row StretchFirst Align="FlareAlignItems.Center" Gap="FlareSpacing.Small">
                <FlareIconView Value="@MaterialDesign3Icons.Regular.Description" Size="20px" />
                <FlareText Element="h2" Typo="TypographyScale.TitleLarge">@(Strings.T("Описание"))</FlareText>
                <FlareIconButton Icon="@MaterialDesign3Icons.Regular.Edit" Size="ButtonSize.Sm" Tooltip="@(Strings.T("Изменить название"))" AriaLabel="@(Strings.T("Изменить название"))" OnClick="() => _titleEditing = true" />
            </FlareStack>
        </HeadingContent>
        <ChildContent>
            <FlareTextArea Label="@(Strings.T("Описание и цели"))" @bind-Value="_model.Description" AutoGrow />
        </ChildContent>
    </FlareSection>

    <FlareSection>
        <HeadingContent>
            <FlareStack Row Align="FlareAlignItems.Center" Gap="FlareSpacing.Small">
                <FlareIconView Value="@MaterialDesign3Icons.Regular.Badge" Size="20px" />
                <FlareText Element="h2" Typo="TypographyScale.TitleLarge">@(Strings.T("Навыки"))</FlareText>
            </FlareStack>
        </HeadingContent>
        <ChildContent>
            <FlareStack Gap="FlareSpacing.Medium">
                <SkillTagEditor Label="@(Strings.T("Необходимые навыки"))" @bind-Values="_model.RequiredSkills"
                                Suggestions="Actors.SelectMany(a=>a.Skills).Concat(Tasks.SelectMany(t=>t.RequiredSkills)).Distinct(StringComparer.OrdinalIgnoreCase)" />
                <SkillMatch Required="_model.RequiredSkills" Person="@(Actors.FirstOrDefault(a=>a.Id==(Item.ResolvedPersonId ?? Item.AssignmentTargetId)))" />
            </FlareStack>
        </ChildContent>
    </FlareSection>

    <FlareSection>
        <HeadingContent>
            <FlareStack Row Align="FlareAlignItems.Center" Gap="FlareSpacing.Small">
                <FlareIconView Value="@MaterialDesign3Icons.Regular.Tune" Size="20px" />
                <FlareText Element="h2" Typo="TypographyScale.TitleLarge">@(Strings.T("План"))</FlareText>
            </FlareStack>
        </HeadingContent>
        <ChildContent>
            <FlareStack Gap="FlareSpacing.Medium">
                @if (_formErrors.Count > 0) { <div tabindex="-1" @ref="_errorSummary"><AlvaValidationSummary Messages="_formErrors" /></div> }
                <FlareGrid MinColumnWidth="min(100%,12rem)">
                    <FlareSelect TValue="string" Label="@(Strings.T("Статус"))" Items="Statuses" ItemLabel="Labels.Status" @bind-Value="_model.Status" />
                    <FlareSelect TValue="string" Label="@(Strings.T("Приоритет"))" Items="Labels.Priorities" ItemLabel="Labels.Priority" @bind-Value="_model.Priority" />
                    <FlareSelect TValue="Guid?" Label="@(Strings.T("Проект"))" Items="Projects.Select(x => (Guid?)x.Id)" ItemLabel="ProjectName" NullOption="@(Strings.T("Текучка"))" @bind-Value="_model.ProjectId" />
                    <FlareSelect TValue="Guid?" Label="@(Strings.T("Спринт (по датам)"))" Items="Sprints.OrderBy(x => x.StartDate).Select(x => (Guid?)x.Id)" ItemLabel="SprintName" NullOption="@(Strings.T("Бэклог — без дат"))" Value="SprintDates.First(_model, Sprints)" ValueChanged="id => SprintDates.Place(_model, Sprints.FirstOrDefault(s => s.Id == id))" HelperText="@SprintDates.Hint(_model, Sprints)" Disabled="_model.DatesFixed" />
                    <FlareSelect TValue="Guid?" Label="@(Strings.T("Родительская задача"))" ErrorText="@_parentError" Items="Tasks.Where(x => x.Id != Item.Id).Select(x => (Guid?)x.Id)" ItemLabel="TaskName" NullOption="@(Strings.T("Корневая задача"))" @bind-Value="_model.ParentId" Searchable />
                    <FlareNumericField TValue="decimal?" Label="@(Strings.T("Оценка, часы"))" ErrorText="@_estimateError" @bind-Value="_model.EstimateHours" Min="0" />
                    <FlareNumericField TValue="decimal?" Label="@(Strings.T("Остаток, часы"))" ErrorText="@_remainingError" @bind-Value="_model.RemainingHours" Min="0" Max="100000" HelperText="@(Strings.T("Для начатой задачи пустое поле означает неизвестный остаток; 0 — работа закончена."))" />
                    <FlareNumericField TValue="decimal?" Label="@(Strings.T("Не больше, ч в день"))" ErrorText="@_limitError" @bind-Value="_model.DailyHoursLimit" Min="0" Max="24" HelperText="@DailyLimit.Hint(_model)" />
                    <FlareDatePicker Label="@(Strings.T("Дедлайн"))" @bind-Value="_model.Deadline" />
                    <FlareDatePicker Label="@(Strings.T("Начало"))" ErrorText="@_startError" @bind-Value="_model.StartDate" Disabled="_model.DatesFixed" />
                    <FlareDatePicker Label="@(Strings.T("Окончание"))" ErrorText="@_endError" @bind-Value="_model.EndDate" Disabled="_model.DatesFixed" />
                </FlareGrid>
                <FlareStack Gap="FlareSpacing.Small">
                    <FlareSwitch @bind-Value="_model.DatesFixed" Label="@(Strings.T("Фиксированные даты — не переносить"))"
                                 Disabled="@(_model.StartDate is null || _model.EndDate is null)" />
                    <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@FixedHint</FlareText>
                </FlareStack>
            </FlareStack>
        </ChildContent>
    </FlareSection>

    <FlareSection>
        <HeadingContent>
            <FlareStack Row Align="FlareAlignItems.Center" Gap="FlareSpacing.Small">
                <FlareIconView Value="@MaterialDesign3Icons.Regular.Assignment" Size="20px" />
                <FlareText Element="h2" Typo="TypographyScale.TitleLarge">@(Strings.T("Назначение"))</FlareText>
            </FlareStack>
        </HeadingContent>
        <ChildContent>
            <FlareStack Gap="FlareSpacing.XSmall">
                <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@(Strings.T("Исполнитель"))</FlareText>
                <AlvaAssignee Task="Item" Actors="Actors" />
            </FlareStack>
        </ChildContent>
    </FlareSection>

    <FlareSection Class="alva-task__deps">
        <HeadingContent>
            <FlareStack Row Align="FlareAlignItems.Center" Gap="FlareSpacing.Small">
                <FlareIconView Value="@MaterialDesign3Icons.Regular.Hub" Size="20px" />
                <FlareStack Gap="FlareSpacing.None">
                    <FlareText Element="h2" Typo="TypographyScale.TitleLarge">@(Strings.T("Зависимости"))</FlareText>
                    <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@(Strings.T("Что задача ждёт и кого задерживает"))</FlareText>
                </FlareStack>
            </FlareStack>
        </HeadingContent>
        <ChildContent>
            <FlareStack Gap="FlareSpacing.Medium">
                @foreach (var (title, incoming) in new[] { (Strings.T("Предшественники"), true), (Strings.T("Последователи"), false) })
                {
                    var links = _dependencies.Where(d => incoming ? d.SuccessorId == Item.Id : d.PredecessorId == Item.Id).ToArray();
                    <FlareText Typo="TypographyScale.LabelMedium" Color="FlareColor.OnSurfaceVariant">@title (@links.Length)</FlareText>
                    @if (links.Length == 0)
                    {
                        <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@(incoming ? Strings.T("Задача ничего не ждёт.") : Strings.T("Никто не ждёт эту задачу."))</FlareText>
                    }
                    else
                    {
                        <FlareList TItem="DependencyDto" Dense="true">
                            @foreach (var link in links)
                            {
                                var other = incoming ? link.PredecessorId : link.SuccessorId;
                                <FlareListItem @key="link.Id">
                                    <Leading><FlareLink Href="@($"tasks/{other}")">@AlvaFormat.Code(other)</FlareLink></Leading>
                                    <ChildContent>
                                        <FlareStack Gap="FlareSpacing.None">
                                            <FlareLink Href="@($"tasks/{other}")" title="@LinkTitle(other)">@LinkTitle(other)</FlareLink>
                                            <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@KindLabel(link.Kind)@(link.LagDays != 0 ? " · " + string.Format(Strings.T("лаг {0} дн."), link.LagDays) : "")</FlareText>
                                        </FlareStack>
                                    </ChildContent>
                                    <Trailing>
                                        <FlareIconButton Icon="@MaterialDesign3Icons.Regular.Delete" Size="ButtonSize.Sm" Disabled="_busy"
                                                         AriaLabel="@string.Format(Strings.T("Удалить связь с «{0}»"), LinkTitle(other))" Tooltip="@(Strings.T("Удалить связь"))" OnClick="() => RemoveDependency(link)" />
                                    </Trailing>
                                </FlareListItem>
                            }
                        </FlareList>
                    }
                }
                <FlareGrid MinColumnWidth="min(100%,11rem)">
                    <FlareSelect TValue="bool" Label="@(Strings.T("Связь"))" Items="Directions" ItemLabel="DirectionLabel" @bind-Value="_linkIncoming" />
                    <FlareSelect TValue="Guid?" Label="@(Strings.T("Задача"))" Items="LinkCandidates" ItemLabel="TaskName" NullOption="@(Strings.T("Выберите задачу"))" @bind-Value="_linkTask" Searchable />
                    <FlareSelect TValue="string" Label="@(Strings.T("Вид"))" Items="DependencyKinds" ItemLabel="KindLabel" @bind-Value="_linkKind" />
                    <FlareNumericField TValue="int" Label="@(Strings.T("Лаг, дни"))" @bind-Value="_linkLag" Min="-365" Max="365" />
                </FlareGrid>
                <FlareButton Variant="ButtonVariant.Tonal" Size="ButtonSize.Sm" Loading="_busy" Disabled="@(_linkTask is null || _busy)" OnClick="AddDependency">@(Strings.T("Добавить связь"))</FlareButton>
            </FlareStack>
        </ChildContent>
    </FlareSection>

    <FlareSection>
        <HeadingContent>
            <FlareStack Row Align="FlareAlignItems.Center" Gap="FlareSpacing.Small">
                <FlareIconView Value="@MaterialDesign3Icons.Regular.Layers" Size="20px" />
                <FlareStack Gap="FlareSpacing.None">
                    <FlareText Element="h2" Typo="TypographyScale.TitleLarge">@(Strings.T("Подзадачи"))</FlareText>
                    <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@(Strings.T("Суммарная оценка и исполнители подзадач"))</FlareText>
                </FlareStack>
            </FlareStack>
        </HeadingContent>
        <ChildContent>
            <FlareStack Gap="FlareSpacing.Medium">
                <FlareStack Row Wrap Align="FlareAlignItems.Center" Gap="FlareSpacing.Medium">
                    <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant"><FlareIconView Value="@MaterialDesign3Icons.Regular.Schedule" Size="16px" /> @(Strings.T("Суммарно:")) @AlvaFormat.Hours(Children.Sum(c => c.EstimateHours ?? 0)) @(Strings.T("ч")) (@Children.Length @AlvaFormat.Plural(Children.Length, "subtask"))</FlareText>
                    @if (Children.Where(c => c.Deadline.HasValue).Select(c => c.Deadline!.Value).DefaultIfEmpty().Max() is var last && last != default)
                    {
                        <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant"><FlareIconView Value="@MaterialDesign3Icons.Regular.Event" Size="16px" /> @(Strings.T("до")) @last.ToString("d MMM yyyy")</FlareText>
                    }
                </FlareStack>
                <FlareDataGrid TItem="TaskModel" Items="Children" Height="auto" Dense="true" RowKey="c => c!.Id">
                    <Columns>
                        <FlareColumn TItem="TaskModel" Title="@(Strings.T("Подзадача"))">
                            <Template Context="child">
                                <FlareStack Row Align="FlareAlignItems.Center" Gap="FlareSpacing.XSmall">
                                    <FlareIconView Value="@MaterialDesign3Icons.Regular.SubdirectoryArrowRight" Size="16px" />
                                    <FlareLink Href="@($"tasks/{child!.Id}")" title="@child.Title">@child.Title</FlareLink>
                                </FlareStack>
                            </Template>
                        </FlareColumn>
                        <FlareColumn TItem="TaskModel" Title="@(Strings.T("Исполнитель / слот"))">
                            <Template Context="child"><AlvaAssignee Task="child!" Actors="Actors" /></Template>
                        </FlareColumn>
                        <FlareColumn TItem="TaskModel" Title="@(Strings.T("Оценка"))">
                            <Template Context="child">@(child!.EstimateHours.HasValue ? $"{AlvaFormat.Hours(child.EstimateHours.Value)} {Strings.T("ч")}" : "—")</Template>
                        </FlareColumn>
                    </Columns>
                    <EmptyStateContent><FlareEmptyState Compact Title="@(Strings.T("Подзадач пока нет"))" Description="@(Strings.T("Добавьте первую подзадачу ниже."))" /></EmptyStateContent>
                </FlareDataGrid>
                <FlareStack Row Wrap Align="FlareAlignItems.End" Gap="FlareSpacing.Small">
                    <FlareTextField @bind-Value="_quickTitle" Immediate Placeholder="@(Strings.T("Быстрое добавление вложенной задачи (Enter)…"))" AriaLabel="@(Strings.T("Название новой подзадачи"))" OnKeyDown="QuickKey">
                        <AdornmentStart><FlareIconView Value="@MaterialDesign3Icons.Regular.AddCircle" Size="18px" /></AdornmentStart>
                    </FlareTextField>
                    <FlareButton Variant="ButtonVariant.Tonal" Size="ButtonSize.Sm" Loading="_adding" Disabled="@(_adding || string.IsNullOrWhiteSpace(_quickTitle))" OnClick="QuickAdd">@(Strings.T("Добавить вложенную задачу"))</FlareButton>
                </FlareStack>
            </FlareStack>
        </ChildContent>
    </FlareSection>

    <FlareSection>
        <HeadingContent>
            <FlareStack Row Align="FlareAlignItems.Center" Gap="FlareSpacing.Small">
                <FlareIconView Value="@MaterialDesign3Icons.Regular.History" Size="20px" />
                <FlareText Element="h2" Typo="TypographyScale.TitleLarge">@(Strings.T("История изменений")) (@_history.Length)</FlareText>
            </FlareStack>
        </HeadingContent>
        <ChildContent>
            @if (_history.Length == 0)
            {
                <FlareEmptyState Compact Title="@(Strings.T("Изменений пока нет"))" Description="@(Strings.T("Правки задачи появятся здесь."))" />
            }
            else
            {
                <FlareTimeline>
                    @foreach (var entry in _history)
                    {
                        <FlareTimelineItem Time="@entry.At.ToLocalTime().ToString("g")" Title="@entry.Summary" Icon="@MaterialDesign3Icons.Regular.History" />
                    }
                </FlareTimeline>
            }
        </ChildContent>
    </FlareSection>
</FlareStack>

<FlareDrawer Anchor="DrawerAnchor.Right" @bind-Open="_assignOpen" @bind-Open:after="AssignToggled" Width="26rem" AriaLabel="@(Strings.T("Назначение исполнителя"))">
    <HeaderContent>
        <div class="alva-assign__header">
            <FlareIconView Value="@MaterialDesign3Icons.Regular.PersonAdd" Size="22px" Class="alva-panel__icon" />
            <div>
                <div class="alva-assign__title">@(Strings.T("Назначение исполнителя"))</div>
                <div class="alva-assign__task alva-num">@Code(Item)@(Item.EstimateHours.HasValue ? $" ({AlvaFormat.Hours(Item.EstimateHours.Value)}{Strings.T("ч")})" : "")</div>
            </div>
        </div>
    </HeaderContent>
    <ChildContent>
        <div class="alva-assign">
            <span class="alva-micro-label">@(Strings.T("Тип балансировки"))</span>
            <FlareTabs @bind-ActiveIndex="_assignTab">
                @foreach (var kind in Kinds)
                {
                    <FlareTab Label="@Labels.Kind(kind)">@Candidates(kind)</FlareTab>
                }
            </FlareTabs>
            @if (Actors.FirstOrDefault(a => a.Id == _assignTarget)?.Kind is "Role" or "Department")
            {
                <FlareSelect TValue="Guid?" Label="@(Strings.T("Конкретный исполнитель"))" Items="@(Actors.Where(a => a.Kind == "Person").Select(a => (Guid?)a.Id))" ItemLabel="ActorName" NullOption="@(Strings.T("Пока не выбран — требуется человек"))" @bind-Value="_assignPerson" Searchable />
            }
            <div class="alva-assign__footer">
                @if (Item.AssignmentTargetId is not null)
                {
                    <FlareButton Variant="ButtonVariant.Text" Size="ButtonSize.Sm" Color="FlareColor.Error" Disabled="_busy" OnClick="ClearAssign">@(Strings.T("Снять назначение"))</FlareButton>
                }
                <FlareButton Variant="ButtonVariant.Text" Size="ButtonSize.Sm" OnClick="CloseAssign">@(Strings.T("Отмена"))</FlareButton>
                <FlareButton Size="ButtonSize.Sm" Loading="_busy" Disabled="@(_assignTarget is null)" OnClick="ApplyAssign">
                    <LeadingIcon><FlareIconView Value="@MaterialDesign3Icons.Regular.Check" Size="18px" /></LeadingIcon>
                    <ChildContent>@(Strings.T("Применить назначение"))</ChildContent>
                </FlareButton>
            </div>
        </div>
    </ChildContent>
</FlareDrawer>

<FlareDialog @bind-Visible="_titleEditing" Title="@(Strings.T("Название задачи"))" Size="DialogSize.Sm">
    <ChildContent>
        <FlareTextField Label="@(Strings.T("Название"))" @bind-Value="_model.Title" Required MaxLength="500" Autofocus />
    </ChildContent>
    <ActionsContent>
        <FlareButton OnClick="() => _titleEditing = false">@(Strings.T("Готово"))</FlareButton>
    </ActionsContent>
</FlareDialog>

@code {
    /// <summary>Открытая задача.</summary>
    [Parameter, EditorRequired] public TaskModel Item { get; set; } = default!;

    /// <summary>Уровень заголовка карточки: 1 на странице, 2 в панели поверх списка.</summary>
    [Parameter] public int HeadingLevel { get; set; } = 1;

    /// <summary>Все задачи команды: из них берутся подзадачи и родитель.</summary>
    [Parameter] public TaskModel[] Tasks { get; set; } = [];
    [Parameter] public ProjectModel[] Projects { get; set; } = [];
    [Parameter] public SprintModel[] Sprints { get; set; } = [];
    [Parameter] public ActorModel[] Actors { get; set; } = [];

    /// <summary>Вызывается после изменения задач: страница перечитывает их.</summary>
    [Parameter] public EventCallback Changed { get; set; }

    private static readonly string[] Statuses = ["Backlog", "Planned", "InProgress", "Done", "Cancelled"];
    private static readonly string[] Kinds = ["Person", "Department", "Role"];
    private TaskModel _model = new();
    private ElementReference _heading;
    private HistoryDto[] _history = [];
    private Dictionary<Guid, (decimal Available, decimal Allocated)> _load = [];
    private RiskDto? _risk;
    private DependencyDto[] _dependencies = [];
    private (Guid Id, long Version) _linksFor;
    private string? _linksError;
    private static readonly bool[] Directions = [true, false];
    private static readonly string[] DependencyKinds = ["FS", "SS", "FF", "SF"];
    private bool _linkIncoming = true;
    private Guid? _linkTask;
    private string _linkKind = "FS";
    private int _linkLag;
    private FlareButton? _assignButton;
    private string? _error, _quickTitle, _assignSearch;
    private string? _parentError,_startError,_endError,_estimateError,_remainingError,_limitError;
    private readonly List<string> _formErrors=[]; private ElementReference _errorSummary;
    private bool _busy, _saved, _assignOpen, _adding, _titleEditing;
    private int _assignTab;
    private Guid? _assignTarget, _assignPerson;

    private TaskModel[] Children => Tasks.Where(t => t.ParentId == Item.Id).OrderBy(t => t.Order).ToArray();

    private IEnumerable<BreadcrumbItem> Crumbs
    {
        get
        {
            yield return new(Strings.T("Задачи"), "tasks");
            if (Projects.FirstOrDefault(p => p.Id == Item.ProjectId) is { } project) yield return new(project.Name, $"projects?project={project.Id}");
            if (Sprints.FirstOrDefault(s => Item.SprintIds.Contains(s.Id)) is { } sprint) yield return new(sprint.Name, $"sprints/{sprint.Id}");
            yield return new(Code(Item));
        }
    }

    /// <summary>Полоса у заголовка: уровень риска с сервера, а без него — просрочка crimson, нет исполнителя amber,
    /// иначе sapphire.</summary>
    private AlvaTone RiskTone =>
        Item.Status is "Done" or "Cancelled" ? AlvaTone.Ok
        : _risk is not null ? AlvaTones.Severity(_risk.Severity)
        : Item.Deadline < DateOnly.FromDateTime(DateTime.Today) ? AlvaTone.Critical
        : Item.AssignmentTargetId is null ? AlvaTone.Warning
        : AlvaTone.Info;

    /// <summary>Подтверждение потери правок; приходит от FlareConfirmDialogProvider в MainLayout.</summary>
    [CascadingParameter] public FlareConfirmDialogProvider? Confirm { get; set; }

    private bool _leaving;
    private IDisposable? _draft;
    protected override void OnInitialized() => _draft = Drafts.Track(() => Dirty);
    public void Dispose() => _draft?.Dispose();

    // Карточка сама принимает фокус при первом появлении: после перехода по ссылке человек не остаётся на body.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try { await _heading.FocusAsync(preventScroll: true); }
        catch (JSDisconnectedException) { }
    }

    // Черновик уступает свежим данным после конфликта версий: иначе сохранение уходило бы со старой версией.
    private bool _adoptFresh;

    /// <summary>Черновик расходится с задачей: уход со страницы или перечитывание её потеряли бы правки.</summary>
    /// <summary>Есть ли в черновике несохранённые правки: страница по этому признаку решает, можно ли уйти по
    /// Esc, не теряя работу.</summary>
    public bool Dirty => _model.Id == Item.Id && (_model.Title != Item.Title || _model.Description != Item.Description
        || _model.Status != Item.Status || _model.ProjectId != Item.ProjectId || _model.ParentId != Item.ParentId
        || _model.RemainingHours != Item.RemainingHours || _model.EstimateHours != Item.EstimateHours || _model.Deadline != Item.Deadline
        || _model.StartDate != Item.StartDate || _model.EndDate != Item.EndDate || _model.Priority != Item.Priority
        || _model.DatesFixed != Item.DatesFixed || _model.DailyHoursLimit != Item.DailyHoursLimit || !_model.RequiredSkills.SequenceEqual(Item.RequiredSkills));

    // Ссылки, меню и Back/Forward: несохранённые правки уходят только после явного согласия.
    private async Task ConfirmLeave(LocationChangingContext context)
    {
        if (_leaving || !Dirty || Confirm is null) return;
        var leave = await Confirm.ConfirmAsync(Strings.T("Несохранённые изменения"),
            Strings.T("В карточке задачи есть несохранённые правки. Уйти и потерять их?"), Strings.T("Уйти без сохранения"), Strings.T("Остаться"));
        if (leave != true) context.PreventNavigation();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_model.Id != Item.Id) _saved = false;
        if (_model.Id == Item.Id && _model.Version == Item.Version) return;
        // Риск и связи читаются для каждой новой версии задачи, даже когда черновик ниже остаётся нетронутым.
        if (_linksFor != (Item.Id, Item.Version)) await LoadLinks();
        // Задачу перечитали (подзадача, назначение, чужая правка), а черновик ещё не сохранён — он остаётся;
        // сохранение уйдёт со старой версией, и сервер сообщит о конфликте вместо тихой потери правок.
        // После конфликта черновик, наоборот, уступает свежим данным (_adoptFresh): сохранять поверх
        // устаревшей версии бессмысленно, а человеку нужно видеть актуальное состояние.
        if (Dirty && !_adoptFresh) return;
        _adoptFresh = false;
        _model = Fresh();
        _quickTitle = null;
        try { _history = await Session.Get<HistoryDto[]>(Session.TeamPath($"tasks/{Item.Id}/history")); }
        catch (Exception e) when (e is HttpRequestException or InvalidOperationException) { _error = PageFeedback.Describe(e); }
    }

    private static string Code(TaskModel task) => AlvaFormat.Code(task.Id);

    /// <summary>Подсказка под переключателем: почему он недоступен или что включает.</summary>
    private string FixedHint => _model.StartDate is null || _model.EndDate is null
        ? Strings.T("Сначала задайте начало и окончание — тогда даты можно зафиксировать.")
        : _model.DatesFixed
            ? Strings.T("Даты зафиксированы: задача не переносится ни вручную, ни автобалансом.")
            : Strings.T("Включите, чтобы запретить перенос задачи и изменение её дат.");

    /// <summary>Копия задачи из параметра: черновик карточки — отдельный объект, поэтому правки не трогают
    /// данные страницы, пока их не сохранили.</summary>
    private TaskModel Fresh() => System.Text.Json.JsonSerializer.Deserialize<TaskModel>(System.Text.Json.JsonSerializer.Serialize(Item))!;
    private string ProjectName(Guid? id) => Projects.FirstOrDefault(x => x.Id == id)?.Name ?? Strings.T("Текучка");
    private string SprintName(Guid? id) => Sprints.FirstOrDefault(x => x.Id == id)?.Name ?? Strings.T("Без спринта");
    private string TaskName(Guid? id) => Tasks.FirstOrDefault(x => x.Id == id)?.Title ?? Strings.T("Корневая задача");
    /// <summary>Название связанной задачи; архивная или чужая задача не выдаётся за «корневую».</summary>
    private string LinkTitle(Guid id) => Tasks.FirstOrDefault(x => x.Id == id)?.Title ?? Strings.T("Задача недоступна");
    private string ActorName(Guid? id) => Actors.FirstOrDefault(x => x.Id == id)?.Name ?? Strings.T("Не назначена");

    private static string KindLabel(string kind) => kind switch
    {
        "SS" => Strings.T("Начало → начало"),
        "FF" => Strings.T("Окончание → окончание"),
        "SF" => Strings.T("Начало → окончание"),
        _ => Strings.T("Окончание → начало")
    };
    private static string DirectionLabel(bool incoming) => incoming ? Strings.T("Предшественник — задача ждёт его") : Strings.T("Последователь — ждёт эту задачу");

    /// <summary>Задачи, с которыми ещё можно связать эту: не она сама и не уже связанные.</summary>
    private IEnumerable<Guid?> LinkCandidates => Tasks
        .Where(t => t.Id != Item.Id && !_dependencies.Any(d => d.PredecessorId == t.Id || d.SuccessorId == t.Id))
        .Select(t => (Guid?)t.Id);

    /// <summary>Риск задачи и её связи. Ошибка остаётся в блоке риска и не мешает редактировать форму.</summary>
    private async Task LoadLinks()
    {
        _linksFor = (Item.Id, Item.Version);
        _linksError = null;
        try
        {
            _dependencies = await Session.Get<DependencyDto[]>(Session.TeamPath($"tasks/{Item.Id}/dependencies"));
            _risk = (await Session.Get<RiskDto[]>(Session.TeamPath("risks"))).FirstOrDefault(r => r.TaskId == Item.Id);
        }
        catch (Exception e) when (e is HttpRequestException or InvalidOperationException)
        {
            _risk = null;
            _linksError = PageFeedback.Describe(e);
        }
    }

    private async Task AddDependency()
    {
        if (_linkTask is not { } other) return;
        var request = _linkIncoming
            ? new DependencyRequest(other, Item.Id, _linkKind, _linkLag)
            : new DependencyRequest(Item.Id, other, _linkKind, _linkLag);
        await Run(async () =>
        {
            await Session.Save<DependencyDto>(HttpMethod.Post, Session.TeamPath($"tasks/{Item.Id}/dependencies"), request);
            _linkTask = null; _linkLag = 0;
            await LoadLinks();
            await Changed.InvokeAsync();
        });
    }

    private async Task RemoveDependency(DependencyDto link)
    {
        var other = link.PredecessorId == Item.Id ? link.SuccessorId : link.PredecessorId;
        if (!await DestructivePrompt.ConfirmAsync(Confirm, Strings.T("Удалить связь"),
            string.Format(Strings.T("Связь с задачей «{0}» будет удалена; прогноз и риск пересчитаются."), LinkTitle(other)),
            Strings.T("Удалить"))) return;
        await Run(async () =>
        {
            await Session.Send(HttpMethod.Delete, Session.TeamPath($"tasks/dependencies/{link.Id}"), new { });
            await LoadLinks();
            await Changed.InvokeAsync();
        });
    }

    /// <summary>Кандидаты одного вида. У людей — загрузка за окно спринта (или 14 дней).</summary>
    private RenderFragment Candidates(string kind) => __builder =>
    {
        var list = Actors.Where(a => a.Kind == kind && (string.IsNullOrWhiteSpace(_assignSearch) || a.Name.Contains(_assignSearch, StringComparison.OrdinalIgnoreCase)))
            .OrderBy(a => kind == "Person" ? SkillMath.Missing(_model.RequiredSkills, a.Skills).Length : 0)
            .ThenBy(a => _load.ContainsKey(a.Id) ? Percent(a.Id) : int.MaxValue).ThenBy(a=>a.Name).ToArray();
        var recommended = kind == "Person" ? list.Where(a => SkillMath.Compatible(_model.RequiredSkills, a.Skills) && _load.ContainsKey(a.Id) && _load[a.Id].Available > 0).OrderBy(a => Percent(a.Id)).FirstOrDefault()?.Id : null;
        <FlareStack Gap="FlareSpacing.Small">
            <FlareTextField @bind-Value="_assignSearch" Immediate Clearable Placeholder="@string.Format(Strings.T("Поиск по команде {0}…"), Session.TeamName)" AriaLabel="@(Strings.T("Поиск кандидата"))">
                <AdornmentStart><FlareIconView Value="@MaterialDesign3Icons.Regular.Search" Size="18px" /></AdornmentStart>
            </FlareTextField>
            <FlareText Typo="TypographyScale.LabelMedium" Color="FlareColor.OnSurfaceVariant">@(Strings.T("Кандидаты команды")) (@list.Length)@(kind == "Person" ? $" · {Strings.T("Ёмкость периода")}" : "")</FlareText>
            @if (list.Length == 0) { <FlareEmptyState Compact Title="@(Strings.T("Никого не найдено"))" Description="@(Strings.T("Добавьте участников в разделе «Команда»."))" /> }
            <FlareList TItem="ActorModel" Dense="true">
                @foreach (var actor in list)
                {
                    var percent = kind == "Person" && _load.ContainsKey(actor.Id) ? Percent(actor.Id) : (int?)null;
                    var reserve = _load.TryGetValue(actor.Id, out var l) ? l.Available - l.Allocated : 0;
                    var tone = percent is null ? AlvaTone.Role : percent > 100 ? AlvaTone.Critical : percent > 80 ? AlvaTone.Info : AlvaTone.Ok;
                    <FlareListItem @key="actor.Id" Selected="@(actor.Id == _assignTarget)" OnClick="() => _assignTarget = actor.Id">
                        <Leading><FlareAvatar Text="@AlvaFormat.Initials(actor.Name)" Size="AvatarSize.Sm" Color="@(kind == "Person" ? FlareColor.Primary : FlareColor.Tertiary)" /></Leading>
                        <ChildContent>
                            <FlareStack Gap="FlareSpacing.None">
                                <FlareStack Row Wrap Align="FlareAlignItems.Center" Gap="FlareSpacing.Small">
                                    <FlareText Typo="TypographyScale.LabelMedium">@actor.Name</FlareText>
                                    @if (actor.Id == recommended) { <AlvaStatusChip Tone="AlvaTone.Ok">@(Strings.T("Рекомендовано"))</AlvaStatusChip> }
                                </FlareStack>
                                <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@CandidateMeta(actor)</FlareText>
                                @if (actor.Kind == "Person" && actor.Skills.Length > 0) { <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@(Strings.T("Навыки")): @string.Join(", ", actor.Skills)</FlareText> }
                                <SkillMatch Required="_model.RequiredSkills" Person="actor" />
                                @if (percent is not null)
                                {
                                    <AlvaStatusChip Tone="@tone">
                                        @(percent > 100 ? string.Format(Strings.T("Перегружен (дефицит {0}ч)"), AlvaFormat.Hours(-reserve)) : percent > 80 ? string.Format(Strings.T("Оптимально (резерв +{0}ч)"), AlvaFormat.Hours(reserve)) : string.Format(Strings.T("Свободен (резерв +{0}ч)"), AlvaFormat.Hours(reserve)))
                                    </AlvaStatusChip>
                                }
                                @if (actor.Id == Item.AssignmentTargetId || actor.Id == Item.ResolvedPersonId) { <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@(Strings.T("Текущий исполнитель"))</FlareText> }
                            </FlareStack>
                        </ChildContent>
                        <Trailing>
                            @if (percent is not null) { <AlvaStatusChip Tone="@tone" Title="@(Strings.T("Загрузка за период"))">@percent%</AlvaStatusChip> }
                        </Trailing>
                    </FlareListItem>
                }
            </FlareList>
        </FlareStack>
    };

    private string CandidateMeta(ActorModel actor)
    {
        if (actor.Kind != "Person") return $"{Labels.Kind(actor.Kind)} · {Actors.Count(a => a.Kind == "Person" && (a.RoleIds.Contains(actor.Id) || a.DepartmentIds.Contains(actor.Id)))} {Strings.T("чел.")}";
        var tags = Actors.Where(a => actor.RoleIds.Contains(a.Id) || actor.DepartmentIds.Contains(a.Id)).Select(a => a.Name).ToArray();
        return tags.Length > 0 ? string.Join(" / ", tags) : Strings.T("Участник команды");
    }

    private int Percent(Guid actorId)
    {
        var (available, allocated) = _load[actorId];
        return available > 0 ? (int)Math.Round(allocated / available * 100) : allocated > 0 ? 999 : 0;
    }

    private async Task OpenAssign()
    {
        _assignTarget = Item.AssignmentTargetId;
        _assignPerson = Item.ResolvedPersonId;
        _assignTab = Math.Max(0, Array.IndexOf(Kinds, Actors.FirstOrDefault(a => a.Id == Item.AssignmentTargetId)?.Kind ?? "Person"));
        _assignOpen = true;
        // Загрузка читается при каждом открытии: за время работы с карточкой назначения команды меняются.
        var sprint = Sprints.FirstOrDefault(s => Item.SprintIds.Contains(s.Id));
        var from = sprint?.StartDate ?? DateOnly.FromDateTime(DateTime.Today);
        var to = sprint?.EndDate ?? from.AddDays(13);
        await Run(async () =>
        {
            var rows = await Session.Get<CapacityDto[]>(Session.TeamPath($"capacity?from={from:yyyy-MM-dd}&to={to:yyyy-MM-dd}"));
            _load = rows.GroupBy(r => r.ActorId).ToDictionary(g => g.Key, g => (g.Sum(r => r.AvailableHours), g.Sum(r => r.AllocatedHours)));
        });
    }

    /// <summary>Панель закрылась любым способом — фокус возвращается на «Назначить исполнителя» в панели действий:
    /// она закреплена и всегда на экране, даже если панель открыли из блока риска.</summary>
    private async Task AssignToggled()
    {
        if (!_assignOpen && _assignButton is not null) await _assignButton.FocusAsync();
    }

    private async Task CloseAssign()
    {
        _assignOpen = false;
        await AssignToggled();
    }

    private async Task ApplyAssign()
    {
        var person = Actors.FirstOrDefault(a => a.Id == _assignTarget)?.Kind == "Person" ? null : _assignPerson;
        await Run(async () =>
        {
            await Session.Send(HttpMethod.Put, Session.TeamPath($"tasks/{Item.Id}/assignment"), new AssignmentRequest(_assignTarget!.Value, person));
            await CloseAssign();
            await Changed.InvokeAsync();
        });
    }

    private async Task ClearAssign()
    {
        await Run(async () =>
        {
            await Session.Send(HttpMethod.Delete, Session.TeamPath($"tasks/{Item.Id}/assignment"), new { });
            _assignTarget = _assignPerson = null;
            await CloseAssign();
            await Changed.InvokeAsync();
        });
    }

    private async Task Save()
    {
        if (!Validate())
        {
            StateHasChanged();
            await SafeFocus.Async(_errorSummary);
            return;
        }
        await Run(async () =>
        {
            var m = _model;
            await Session.Save<TaskModel>(HttpMethod.Put, Session.TeamPath($"tasks/{m.Id}"),
                new TaskRequest(m.Title, m.Description, m.Status, m.ProjectId, m.ParentId, m.EstimateHours, m.Deadline, m.StartDate, m.EndDate, m.Order, m.Version, m.RequiredSkills, m.Priority, RemainingHours: m.RemainingHours, SetRemainingHours: true, DatesFixed: m.DatesFixed, DailyHoursLimit: m.DailyHoursLimit, SetDailyHoursLimit: true));
            _saved = true;
            await Changed.InvokeAsync();
        });
    }

    private bool Validate()
    {
        _parentError=_startError=_endError=_estimateError=_remainingError=_limitError=null;
        _formErrors.Clear();
        var m=_model;
        if (m.StartDate is { } start && m.EndDate is { } end && start > end) Error(ref _endError, Strings.T("Окончание раньше начала."));
        if (m.EstimateHours is < 0) Error(ref _estimateError, Strings.T("Оценка не может быть отрицательной."));
        if (m.RemainingHours is < 0) Error(ref _remainingError, Strings.T("Остаток не может быть отрицательным."));
        if (DailyLimit.Error(m.DailyHoursLimit) is { } limitError) Error(ref _limitError, limitError);
        if (m.ParentId is { } parent && (parent == m.Id || IsDescendant(parent, m.Id))) Error(ref _parentError, Strings.T("Родительская задача не может быть самой задачей или её потомком."));
        return _formErrors.Count == 0;
    }

    private bool IsDescendant(Guid candidate, Guid taskId)
    {
        var byId=Tasks.ToDictionary(t=>t.Id); var seen=new HashSet<Guid>();
        for (Guid? id=candidate; id is { } current && seen.Add(current) && byId.TryGetValue(current, out var task); id=task.ParentId)
            if (current == taskId) return true;
        return false;
    }

    private void Error(ref string? field, string message) { field=message; _formErrors.Add(message); }

    private async Task QuickKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await QuickAdd();
    }

    /// <summary>
    /// Подзадача наследует проект родителя и попадает в бэклог (без дат); порядок — в конец списка. Пока запрос идёт,
    /// повторный Enter или клик ничего не отправляет; при ошибке введённое название остаётся для повтора.
    /// </summary>
    private async Task QuickAdd()
    {
        var title = _quickTitle?.Trim();
        if (_adding || string.IsNullOrEmpty(title)) return;
        _adding = true;
        try
        {
            await Run(async () =>
            {
                var order = Children.Select(c => c.Order).DefaultIfEmpty(-1).Max() + 1;
                await Session.Save<TaskModel>(HttpMethod.Post, Session.TeamPath("tasks"),
                    new TaskRequest(title, "", "Backlog", Item.ProjectId, Item.Id, null, null, null, null, order, null));
                _quickTitle = null;
                await Changed.InvokeAsync();
            });
        }
        finally { _adding = false; }
    }

    private async Task Archive()
    {
        if (!await DestructivePrompt.ConfirmAsync(Confirm, Strings.T("Архивировать задачу"),
            string.Format(Strings.T("Задача «{0}» уйдёт из списков. Вернуть её из приложения пока нельзя."), Item.Title),
            Strings.T("Архивировать"))) return;
        await Run(async () =>
        {
            await Session.Send(HttpMethod.Delete, Session.TeamPath($"tasks/{Item.Id}"), new { });
            await Changed.InvokeAsync();
            _leaving = true;
            Navigation.NavigateTo("tasks");
        });
    }

    private async Task Run(Func<Task> action)
    {
        _busy = true; _error = null;
        try { await action(); }
        catch (HttpRequestException e) when (e.StatusCode == System.Net.HttpStatusCode.Conflict)
        {
            // Задачу изменили между чтением и сохранением: сервер отверг устаревшую версию. Говорим словами,
            // что правки не сохранены, и показываем актуальное состояние: без этого человек сохранял бы
            // поверх устаревшей версии снова и снова, видя только код ответа.
            _error = Strings.T("Задачу изменил кто-то другой: ваши правки не сохранены. Данные перечитаны — перенесите нужное и сохраните снова.");
            _adoptFresh = true;
            if (Changed.HasDelegate) await Changed.InvokeAsync();
            else { _model = Fresh(); _adoptFresh = false; }
        }
        catch (Exception e) when (e is HttpRequestException or InvalidOperationException) { _error = PageFeedback.Describe(e); }
        finally { _busy = false; }
    }
}
