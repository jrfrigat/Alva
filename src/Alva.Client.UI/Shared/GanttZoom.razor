@using Flare.Components.Gantt
@inject GanttPreferences Preferences
@* Gantt "Scale" slider: the width of one axis unit for the current scale. Stored on the device separately for
   each view and each scale; the minimum is half the normal width, the maximum is two and a half. *@
<FlareStack Row Align="FlareAlignItems.Center" Gap="FlareSpacing.None" Style="min-width:7rem;max-width:7rem;flex:0 0 7rem">
    <FlareSlider Value="Value" ValueChanged="Change" Min="Min" Max="Max" Step="Step" Label="@(AlvaStrings.Gantt_Scale)" AriaLabel="@(AlvaStrings.Gantt_AxisUnitWidth)" Style="width:100%" />
</FlareStack>

@code {
    /// <summary>View whose settings are stored: "plan", "tasks", "people".</summary>
    [Parameter, EditorRequired] public string View { get; set; } = "";
    [Parameter] public GanttScale Scale { get; set; } = GanttScale.Day;

    /// <summary>Default width; without it, the normal width of the scale.</summary>
    [Parameter] public double? Default { get; set; }

    [Parameter] public double Value { get; set; }
    [Parameter] public EventCallback<double> ValueChanged { get; set; }

    private GanttScale? _loaded;

    private double Base => Default ?? GanttData.UnitWidth(Scale);
    private double Min => Math.Round(Base * 0.5 / Step) * Step;
    private double Max => Math.Round(Base * 2.5 / Step) * Step;
    private double Step => Scale == GanttScale.Day ? 2 : 4;

    // Each scale keeps its own width: switching the scale restores the width stored for it.
    protected override async Task OnParametersSetAsync()
    {
        if (_loaded == Scale) return;
        _loaded = Scale;
        var width = Math.Clamp(await Preferences.Unit(View, Scale.ToString(), Base), Min, Max);
        if (width != Value) await ValueChanged.InvokeAsync(width);
    }

    private async Task Change(double width)
    {
        await ValueChanged.InvokeAsync(width);
        await Preferences.SaveUnit(View, Scale.ToString(), width);
    }
}
