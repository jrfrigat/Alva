@inject AlvaSession Session
@if (Session.User is null)
{
    <FlareEmptyState Title="@(Strings.T("Войдите в Alva"))" Description="@(Strings.T("Ваши команды и планы доступны после входа."))"><ActionContent><FlareButton Href="login">@(Strings.T("Войти"))</FlareButton></ActionContent></FlareEmptyState>
}
else
{
    <FlareEmptyState Title="@(Strings.T("Выберите команду"))" Description="@(Strings.T("Создайте или выберите команду в рабочем пространстве."))"><ActionContent><FlareButton Href="workspaces">@(Strings.T("Выбрать команду"))</FlareButton></ActionContent></FlareEmptyState>
}
