@inject AlvaSession Session
@if (Session.User is null)
{
    <FlareEmptyState Title="@(AlvaStrings.Common_SignInToAlva)" Description="@(AlvaStrings.Common_YourTeamsAndPlansAreAvailableAfterSigningIn)"><ActionContent><FlareButton Href="login">@(AlvaStrings.Common_SignIn)</FlareButton></ActionContent></FlareEmptyState>
}
else
{
    <FlareEmptyState Title="@(AlvaStrings.Common_ChooseATeam)" Description="@(AlvaStrings.Common_CreateOrChooseATeamInTheWorkspace)"><ActionContent><FlareButton Href="workspaces">@(AlvaStrings.Common_ChooseTeam)</FlareButton></ActionContent></FlareEmptyState>
}
