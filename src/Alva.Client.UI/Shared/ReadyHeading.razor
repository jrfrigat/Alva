@* Heading of a page that renders after data loads. FocusOnNavigate looks for an h1 right after navigation, when
   it does not exist yet, so the heading takes focus on its first appearance. Ordinary page updates leave it alone. *@
<h1 @ref="_heading" class="@Class" tabindex="-1">@ChildContent</h1>

@code {
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private ElementReference _heading;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await _heading.FocusAsync(preventScroll: true);
    }
}
