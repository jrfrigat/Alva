<FlareTagField TValue="string" Label="@Label" Values="Values" ValuesChanged="Changed"
               Suggestions="Suggestions" MaxTags="50" ErrorText="@_error"
               HelperText="@(AlvaStrings.Common_TypeASkillAndPressEnterTagsCanBeRemoved)" />

@code {
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public string[] Values { get; set; } = [];
    [Parameter] public EventCallback<string[]> ValuesChanged { get; set; }
    [Parameter] public IEnumerable<string> Suggestions { get; set; } = [];
    private string? _error;

    private async Task Changed(IReadOnlyList<string?> values)
    {
        try
        {
            var normalized = SkillMath.Normalize(values);
            _error = null;
            await ValuesChanged.InvokeAsync(normalized);
        }
        catch (ArgumentException) { _error = AlvaStrings.Common_UseUpTo50SkillsEachUpTo80Characters; }
    }
}
