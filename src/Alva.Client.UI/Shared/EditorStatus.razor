@* Одно состояние редактора на всех экранах: правки, сохранение и подтверждённый результат.
   Ошибку показывает PageFeedback, чтобы серверный текст не дублировался. *@
@if (Saving)
{
    <span role="status" aria-live="polite"><FlareChip Variant="ChipVariant.Filled" Color="FlareColor.Info" Size="ChipSize.Sm">@(Strings.T("Сохранение…"))</FlareChip></span>
}
else if (Saved && !Dirty)
{
    <span role="status" aria-live="polite"><FlareChip Variant="ChipVariant.Filled" Color="FlareColor.Success" Size="ChipSize.Sm">@(Strings.T("Сохранено"))</FlareChip></span>
}
else if (Dirty)
{
    <span role="status" aria-live="polite"><FlareChip Variant="ChipVariant.Filled" Color="FlareColor.Warning" Size="ChipSize.Sm">@(Strings.T("Есть несохранённые изменения"))</FlareChip></span>
}

@code {
    [Parameter] public bool Dirty { get; set; }
    [Parameter] public bool Saving { get; set; }
    [Parameter] public bool Saved { get; set; }
}
