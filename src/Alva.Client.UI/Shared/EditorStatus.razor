@* One editor state shared by all screens: edits, saving, and a confirmed result.
   Errors are shown by PageFeedback so the server text is not duplicated. *@
@if (Saving)
{
    <span role="status" aria-live="polite"><FlareChip Variant="ChipVariant.Filled" Color="FlareColor.Info" Size="ChipSize.Sm">@(AlvaStrings.Common_Saving)</FlareChip></span>
}
else if (Saved && !Dirty)
{
    <span role="status" aria-live="polite"><FlareChip Variant="ChipVariant.Filled" Color="FlareColor.Success" Size="ChipSize.Sm">@(AlvaStrings.Common_Saved)</FlareChip></span>
}
else if (Dirty)
{
    <span role="status" aria-live="polite"><FlareChip Variant="ChipVariant.Filled" Color="FlareColor.Warning" Size="ChipSize.Sm">@(AlvaStrings.Common_ThereAreUnsavedChanges)</FlareChip></span>
}

@code {
    [Parameter] public bool Dirty { get; set; }
    [Parameter] public bool Saving { get; set; }
    [Parameter] public bool Saved { get; set; }
}
