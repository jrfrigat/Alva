@* Capacity overview: fund KPIs, a "person x period" matrix with a heat scale,
   vacant roles with a deficit and a balance forecast by period. *@
@inject AlvaSession Session
<AlvaPageHeader Category="@(AlvaStrings.Capacity_ResourcesCapacity)" Title="@(AlvaStrings.Capacity_TeamCapacityOverview)">
    <Actions>
        <FlareButton Href="capacity/people" Variant="ButtonVariant.Tonal" Size="ButtonSize.Sm">
            <LeadingIcon><FlareIconView Value="@MaterialDesign3Icons.Regular.EditCalendar" Size="18px" /></LeadingIcon>
            <ChildContent>@(AlvaStrings.Capacity_ScheduleEditor)</ChildContent>
        </FlareButton>
        @if (_sprints.FirstOrDefault(s => s.Status == "Active") is { } active)
        {
            <FlareButton Href="@($"sprints/{active.Id}/plan")" Size="ButtonSize.Sm">
                <LeadingIcon><FlareIconView Value="@MaterialDesign3Icons.Regular.Balance" Size="18px" /></LeadingIcon>
                <ChildContent>@(AlvaStrings.Capacity_BalanceSprint)</ChildContent>
            </FlareButton>
        }
    </Actions>
</AlvaPageHeader>

<FlareCard Variant="CardVariant.Outlined">
    <FlareCardContent>
    <FlareStack Row Wrap Align="FlareAlignItems.Center" Gap="FlareSpacing.Medium">
        <FlareToggleGroup TValue="string" Value="@_mode" ValueChanged="SetMode" Size="ButtonSize.Sm" Mandatory AriaLabel="@(AlvaStrings.Capacity_PeriodBreakdown)">
            @foreach (var (mode, label) in Modes)
            {
                <FlareToggleButton Value="@mode">@label</FlareToggleButton>
            }
        </FlareToggleGroup>
        <FlareDivider Vertical="true" />
        <FlareText Typo="TypographyScale.LabelMedium" Color="FlareColor.OnSurfaceVariant">@(AlvaStrings.Capacity_Departments)</FlareText>
        <FlareChipGroup SelectedValues="SelectedDepartments" SelectedValuesChanged="SetDepartment" AriaLabel="@(AlvaStrings.Common_SubTeams)">
            <FlareChip Value="" Label="@($"{AlvaStrings.Capacity_AllSubTeams} ({_departments.Length})")" />
            @foreach (var dept in _departments)
            {
                <FlareChip Value="@dept.Id.ToString()" Label="@($"{dept.Name}: {People.Count(p => GroupOf(p) == dept.Id)}")" />
            }
        </FlareChipGroup>
        <FlareSpacer />
        <FlareCheckbox TValue="bool" @bind-Value="_highlight" Label="@(AlvaStrings.Capacity_ShowOverloads100)" />
    </FlareStack>
    </FlareCardContent>
</FlareCard>
<PageFeedback Error="@_error" Loading="_busy" OnRetry="Load" />
@if (!_loaded) { <LoadingSkeleton Height="20rem" /> }
else
{
<FlareGrid MinColumnWidth="min(100%,15rem)">
    <FlareStat Label="@(AlvaStrings.Capacity_AvailableFundNominal)" Value="@AlvaFormat.Hours(Fund)" Unit="@(AlvaStrings.Capacity_PersonHour)" Icon="@MaterialDesign3Icons.Regular.CalendarMonth"
               Caption="@($"{_periods.Length} {PeriodWord(_periods.Length)} · {VisiblePeople.Length} {AlvaFormat.Plural(VisiblePeople.Length, "person")}")" />
    <FlareStat Label="@(AlvaStrings.Capacity_PlannedWorkload)" Value="@AlvaFormat.Hours(Planned)" Unit="@($"{AlvaStrings.Sprint_HoursShort} ({Pct(Planned, Fund)}%)")" Icon="@MaterialDesign3Icons.Regular.FactCheck">
        <CaptionContent>
            <FlareStack Gap="FlareSpacing.XSmall">
                <AlvaStatusChip Tone="LoadTone">@LoadLabel</AlvaStatusChip>
                <FlareProgressLinear Value="@Math.Min(100, Pct(Planned, Fund))" Size="TrackSize.Xs" Color="FlareColor.Primary" aria-label="@(AlvaStrings.Capacity_PlannedOfTheFund)" />
                <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@(AlvaStrings.Capacity_TargetCorridor8595) · @Horizon</FlareText>
            </FlareStack>
        </CaptionContent>
    </FlareStat>
    <FlareStat Label="@(AlvaStrings.Capacity_DeficitSlots)" Value="@($"{(Deficit > 0 ? "−" : "")}{AlvaFormat.Hours(Deficit)}")" Unit="@(AlvaStrings.Capacity_HDeficit)" Icon="@MaterialDesign3Icons.Regular.Warning"
               Caption="@($"{WorstName ?? AlvaStrings.Capacity_NoDeficit} · {OverloadedCount} {AlvaStrings.Common_Overloaded}")" />
    <FlareStat Label="@(AlvaStrings.Capacity_FreeReserve)" Value="@($"+{AlvaFormat.Hours(Reserve)}")" Unit="@(AlvaStrings.Capacity_HAvailable)" Icon="@MaterialDesign3Icons.Regular.Inventory2"
               Caption="@($"{FreestName ?? AlvaStrings.Capacity_NoReserve} · {AlvaStrings.Capacity_EndOfHorizon}")" />
</FlareGrid>

<FlareCard Variant="CardVariant.Outlined">
    <FlareCardHeader Title="@(AlvaStrings.Capacity_CapacityDistributionMatrix)" Subtitle="@($"{AlvaStrings.Capacity_Spread} {string.Join(", ", _periods.Select(p => p.Title))}")" />
    <FlareCardContent>
    <FlareStack Row Wrap Align="FlareAlignItems.Center" Gap="FlareSpacing.Medium">
        <FlareText Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant">@(AlvaStrings.Capacity_HeatScale)</FlareText>
        <FlareStack Row Align="FlareAlignItems.Center" Gap="FlareSpacing.XXSmall"><FlareBadge Standalone="true" Dot="true" Color="FlareColor.Info" /><FlareText Typo="TypographyScale.BodySmall">@(AlvaStrings.Capacity_Text70Underload)</FlareText></FlareStack>
        <FlareStack Row Align="FlareAlignItems.Center" Gap="FlareSpacing.XXSmall"><FlareBadge Standalone="true" Dot="true" Color="FlareColor.Success" /><FlareText Typo="TypographyScale.BodySmall">@(AlvaStrings.Capacity_Text70100Balanced)</FlareText></FlareStack>
        <FlareStack Row Align="FlareAlignItems.Center" Gap="FlareSpacing.XXSmall"><FlareBadge Standalone="true" Dot="true" Color="FlareColor.Warning" /><FlareText Typo="TypographyScale.BodySmall">@(AlvaStrings.Capacity_Text101115Strained)</FlareText></FlareStack>
        <FlareStack Row Align="FlareAlignItems.Center" Gap="FlareSpacing.XXSmall"><FlareBadge Standalone="true" Dot="true" Color="FlareColor.Error" /><FlareText Typo="TypographyScale.BodySmall">@(AlvaStrings.Capacity_Text115CriticalOverload)</FlareText></FlareStack>
    </FlareStack>
    <FlareDataGrid TItem="MatrixRow" Items="MatrixRows" RowKey="row => row.Key" Height="auto" Dense="true"
                   Presentation="DataGridPresentation.Auto" aria-label="@(AlvaStrings.Capacity_CapacityDistribution)">
        <Grouping>
            <DataGridGroup Key="@(AlvaStrings.Capacity_ResourceSubTeam)" Selector="row => row.Group" />
        </Grouping>
        <Columns>
            <FlareColumn TItem="MatrixRow" Title="@(AlvaStrings.Capacity_ResourceSubTeam)">
                <Template Context="row">
                    <FlareStack Row Align="FlareAlignItems.Center" Gap="FlareSpacing.Small">
                        @if (row.Role is null)
                        {
                            <FlareAvatar Text="@AlvaFormat.Initials(row.Name)" Alt="@row.Name" Size="AvatarSize.Xs" />
                        }
                        else
                        {
                            <FlareIconView Value="@MaterialDesign3Icons.Regular.PersonAdd" Size="18px" />
                        }
                        <FlareStack Gap="FlareSpacing.None">
                            @if (row.PersonId is { } personId)
                            {
                                <FlareLink Href="@($"capacity/{personId}")">@row.Name</FlareLink>
                            }
                            else
                            {
                                <FlareText Typo="TypographyScale.LabelMedium" Color="FlareColor.Error">@row.Name</FlareText>
                            }
                            <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@row.Meta</FlareText>
                        </FlareStack>
                    </FlareStack>
                </Template>
            </FlareColumn>
            <FlareColumn TItem="MatrixRow" Title="@(AlvaStrings.Capacity_RoleStatus)">
                <Template Context="row">
                    @if (row.Role is null)
                    {
                        <AlvaStatusChip Tone="AlvaTone.Info">@(AlvaStrings.Capacity_Staff)</AlvaStatusChip>
                    }
                    else
                    {
                        <AlvaStatusChip Tone="AlvaTone.Critical">@(AlvaStrings.Capacity_Vacancy)</AlvaStatusChip>
                    }
                </Template>
            </FlareColumn>
            <FlareColumn TItem="MatrixRow" Title="@(AlvaStrings.Capacity_AvailableFund)">
                <Template Context="row">
                    @if (row.PersonId is { } personId)
                    {
                        <FlareText Typo="TypographyScale.BodySmall">@AlvaFormat.Hours(Available(personId)) @(AlvaStrings.Sprint_HoursShort)</FlareText>
                    }
                    else
                    {
                        <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.Error">0 @(AlvaStrings.Sprint_HoursShort)</FlareText>
                    }
                </Template>
            </FlareColumn>
            @foreach (var period in _periods)
            {
                var current = period;
                <FlareColumn TItem="MatrixRow" Id="@($"period-{current.From:yyyyMMdd}")" Title="@($"{current.Title} · {current.Subtitle}")">
                    <Template Context="row">
                        @if (row.PersonId is { } personId)
                        {
                            var (avail, alloc) = Cell(personId, current);
                            var pct = Pct(alloc, avail);
                            var over = Overload(personId, current);
                            <HeatCell Tone="@Heat(pct, avail, alloc)" Flag="@(_highlight && over > 0)"
                                      Top="@($"{AlvaFormat.Hours(alloc)} / {AlvaFormat.Hours(avail)} {AlvaStrings.Sprint_HoursShort}")"
                                      Percent="@(avail > 0 ? $"{pct}%" : "—")" Progress="@pct"
                                      Note="@CellNote(avail, alloc, over)" />
                        }
                        else if (row.Role is { } role)
                        {
                            var demand = Demand(role, current);
                            <HeatCell Tone="@(demand > 0 ? "critical" : "empty")"
                                      Top="@($"{AlvaFormat.Hours(demand)} / 0 {AlvaStrings.Sprint_HoursShort}")"
                                      Percent="@(demand > 0 ? AlvaStrings.Capacity_NoSlot : "")"
                                      Note="@(demand > 0 ? string.Format(AlvaStrings.Capacity_DeficitH, AlvaFormat.Hours(demand)) : AlvaStrings.Capacity_NoAssignments)" />
                        }
                    </Template>
                </FlareColumn>
            }
            <FlareColumn TItem="MatrixRow" Title="@(AlvaStrings.Capacity_FundTotal)">
                <Template Context="row">
                    @if (row.PersonId is { } personId)
                    {
                        <FlareText Typo="TypographyScale.BodySmall" Color="@(Allocated(personId) > Available(personId) ? FlareColor.Error : FlareColor.OnSurface)">@AlvaFormat.Hours(Allocated(personId)) / @AlvaFormat.Hours(Available(personId)) @(AlvaStrings.Sprint_HoursShort)</FlareText>
                    }
                    else if (row.Role is { } role)
                    {
                        <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.Error">−@AlvaFormat.Hours(Demand(role)) @(AlvaStrings.Sprint_HoursShort) · @(AlvaStrings.Capacity_Deficit)</FlareText>
                    }
                </Template>
            </FlareColumn>
        </Columns>
        <EmptyStateContent><FlareEmptyState Compact Title="@(AlvaStrings.Capacity_NoPeopleHaveSchedulesOverTheHorizon)" /></EmptyStateContent>
    </FlareDataGrid>
    </FlareCardContent>
    <FlareCardActions Align="CardActionsAlign.Between">
        <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@(AlvaStrings.Capacity_Shown) @VisiblePeople.Length @AlvaFormat.Plural(VisiblePeople.Length, "person") @(AlvaStrings.Capacity_In) @Groups.Count(g => VisiblePeople.Any(p => GroupOf(p) == g.Id)) @AlvaFormat.Plural(Groups.Count(g => VisiblePeople.Any(p => GroupOf(p) == g.Id)), "subteam")</FlareText>
        <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@(AlvaStrings.Capacity_FundFromPeopleSWorkSchedulesVacationsAndBlocksIncluded)</FlareText>
    </FlareCardActions>
</FlareCard>

@if (_periods.Length > 0)
{
    <FlareCard Variant="CardVariant.Outlined">
        <FlareCardHeader Title="@(AlvaStrings.Capacity_CapacityBalanceForecastByPeriod)" />
        <FlareCardContent>
            <FlareChart Type="ChartType.Bar" Data="Forecast" Height="260"
                        Description="@ForecastSummary" DataTable="true" aria-label="@(AlvaStrings.Capacity_FundPlanAndDeficitByPeriod)" />
            <FlareText Element="p" Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant"><FlareText Element="strong" Typo="TypographyScale.LabelMedium">@(AlvaStrings.Capacity_KeyTakeaway)</FlareText> @ForecastSummary</FlareText>
        </FlareCardContent>
    </FlareCard>
}
}

@code {
    private sealed record Period(string Title, string Subtitle, DateOnly From, DateOnly To);
    private sealed record MatrixRow(string Key, string Group, string Name, string Meta, Guid? PersonId, ActorModel? Role);
    private (string Mode, string Label)[] Modes => [("sprints", AlvaStrings.Capacity_BySprint), ("weeks", AlvaStrings.Capacity_ByWeek), ("days", AlvaStrings.Capacity_ByDay)];

    private CapacityDto[] _rows = [];
    private CapacityDemandDto[] _demand = [];
    private ActorModel[] _actors = [];
    private ActorModel[] _departments = [];
    private SprintModel[] _sprints = [];
    private Period[] _periods = [];
    private string _mode = "sprints";
    private Guid? _department;
    private bool _highlight = true, _busy, _loaded;
    private string? _error;

    private static DateOnly Today => DateOnly.FromDateTime(DateTime.Today);
    private string Horizon => _periods.Length == 0 ? "—" : $"{_periods[0].From:d MMM} — {_periods[^1].To:d MMM yyyy}";
    private ActorModel[] People => _actors.Where(a => a.Kind == "Person" && _rows.Any(r => r.ActorId == a.Id)).ToArray();
    private ActorModel[] VisiblePeople => People.Where(p => _department is null || GroupOf(p) == _department).ToArray();

    /// <summary>Roles and sub-teams that have work assigned without a specific person.</summary>
    private ActorModel[] Vacancies => _actors
        .Where(a => a.Kind != "Person" && (_department is null || GroupOfRole(a) == _department) && Demand(a) > 0).ToArray();

    private IEnumerable<(Guid? Id, string Name)> Groups =>
        _departments.Select(d => ((Guid?)d.Id, d.Name)).Append((null, AlvaStrings.People_NoSubTeam));

    /// <summary>The matrix rows: people and vacant roles, grouped by sub-team. The group key carries the
    /// group totals, because the Flare grid renders its own group headers.</summary>
    private MatrixRow[] MatrixRows
    {
        get
        {
            var rows = new List<MatrixRow>();
            foreach (var group in Groups)
            {
                var people = VisiblePeople.Where(p => GroupOf(p) == group.Id).ToArray();
                var roles = Vacancies.Where(v => GroupOfRole(v) == group.Id).ToArray();
                if (people.Length == 0 && roles.Length == 0) continue;
                var fund = people.Sum(p => Available(p.Id));
                var balance = fund - people.Sum(p => Allocated(p.Id)) - roles.Sum(r => Demand(r));
                var total = balance < 0
                    ? string.Format(AlvaStrings.Capacity_PeriodDeficitH, AlvaFormat.Hours(-balance))
                    : string.Format(AlvaStrings.Capacity_PeriodReserveH, AlvaFormat.Hours(balance));
                var label = $"{group.Name} ({people.Length} {AlvaFormat.Plural(people.Length, "person")}{(roles.Length > 0 ? string.Format(AlvaStrings.Capacity_Vacancies, roles.Length) : "")}) · {total} · {AlvaStrings.Capacity_Fund} {AlvaFormat.Hours(fund)} {AlvaStrings.Sprint_HoursShort}";
                foreach (var person in people)
                    rows.Add(new MatrixRow($"person-{person.Id}", label, person.Name, SkillsOf(person), person.Id, null));
                foreach (var role in roles)
                    rows.Add(new MatrixRow($"role-{role.Id}", label, $"{Labels.Kind(role.Kind)}: {role.Name}", AlvaStrings.Capacity_APersonRequiredVacantSlot, null, role));
            }
            return [.. rows];
        }
    }

    private Guid? GroupOf(ActorModel person) => person.DepartmentIds.FirstOrDefault(id => _departments.Any(d => d.Id == id)) is var id && id != Guid.Empty ? id : (Guid?)null;
    private Guid? GroupOfRole(ActorModel actor) => actor.Kind == "Department" ? actor.Id : actor.ParentId is { } parent && _departments.Any(d => d.Id == parent) ? parent : null;
    private string SkillsOf(ActorModel person) => string.Join(" / ", _actors.Where(a => person.SkillIds.Contains(a.Id)).Select(a => a.Name).DefaultIfEmpty(AlvaStrings.Capacity_TeamMember));

    private (decimal Available, decimal Allocated) Cell(Guid actorId, Period period)
    {
        var rows = _rows.Where(r => r.ActorId == actorId && r.Date >= period.From && r.Date <= period.To);
        return (rows.Sum(r => r.AvailableHours), rows.Sum(r => r.AllocatedHours));
    }

    private decimal Available(Guid id) => _periods.Sum(p => Cell(id, p).Available);
    private decimal Allocated(Guid id) => _periods.Sum(p => Cell(id, p).Allocated);

    /// <summary>Task hours for a skill or sub-team without a person in the period - from capacity/demand.</summary>
    private decimal Demand(ActorModel role, Period period) => _demand.Where(d => d.TargetId == role.Id && d.Date >= period.From && d.Date <= period.To).Sum(d => d.Hours);

    private decimal Demand(ActorModel role) => _periods.Sum(p => Demand(role, p));

    private decimal Fund => VisiblePeople.Sum(p => Available(p.Id));
    private decimal Planned => VisiblePeople.Sum(p => Allocated(p.Id));
    // People deficit - per-day excesses: a reserve on one day does not cover an overload on another.
    private decimal Overload(Guid id, Period period) => CapacityMath.Overload(_rows.Where(r => r.ActorId == id && r.Date >= period.From && r.Date <= period.To));
    private decimal Overload(Guid id) => _periods.Sum(p => Overload(id, p));
    private decimal Deficit => VisiblePeople.Sum(p => Overload(p.Id)) + Vacancies.Sum(Demand);
    private decimal Reserve => VisiblePeople.Sum(p => Math.Max(0, Available(p.Id) - Allocated(p.Id)));
    private int OverloadedCount => VisiblePeople.Count(p => Overload(p.Id) > 0);
    private string? WorstName => VisiblePeople.Select(p => (p.Name, Gap: Overload(p.Id))).Concat(Vacancies.Select(v => (v.Name, Gap: Demand(v)))).Where(x => x.Gap > 0).OrderByDescending(x => x.Gap).Select(x => x.Name).FirstOrDefault();
    private string? FreestName => VisiblePeople.Select(p => (p.Name, Free: Available(p.Id) - Allocated(p.Id))).Where(x => x.Free > 0).OrderByDescending(x => x.Free).Select(x => string.Format(AlvaStrings.Capacity_PersonWithReserve, x.Name, AlvaFormat.Hours(x.Free))).FirstOrDefault();
    private AlvaTone LoadTone => Pct(Planned, Fund) switch { > 100 => AlvaTone.Critical, >= 85 and <= 95 => AlvaTone.Ok, > 95 => AlvaTone.Warning, _ => AlvaTone.Info };
    private string LoadLabel => Pct(Planned, Fund) switch { > 100 => AlvaStrings.Common_OverloadShort, >= 85 and <= 95 => AlvaStrings.Common_Optimal, > 95 => AlvaStrings.Capacity_AtTheLimit, _ => AlvaStrings.Capacity_Underload };

    private static int Pct(decimal part, decimal whole) => whole <= 0 ? (part > 0 ? 999 : 0) : (int)Math.Round(part / whole * 100);
    private IReadOnlyCollection<string> SelectedDepartments => _department is null ? [""] : [_department.Value.ToString()];
    private void SetDepartment(IReadOnlyCollection<string> values) =>
        _department = values.FirstOrDefault() is { Length: > 0 } key && Guid.TryParse(key, out var id) ? id : null;
    private static string Heat(int pct, decimal avail, decimal alloc) => avail <= 0 && alloc <= 0 ? "empty" : pct > 115 ? "critical" : pct > 100 ? "tension" : pct >= 70 ? "balance" : "under";
    private static string CellNote(decimal avail, decimal alloc, decimal over) =>
        over > 0 && alloc <= avail ? $"{AlvaStrings.Capacity_DailyOverload} {AlvaFormat.Hours(over)} {AlvaStrings.Sprint_HoursShort}" :
        avail <= 0 && alloc <= 0 ? AlvaStrings.Capacity_NoSchedule : alloc > avail ? string.Format(AlvaStrings.Capacity_OverloadH, AlvaFormat.Hours(alloc - avail)) : alloc == avail ? AlvaStrings.Capacity_FullBalance : string.Format(AlvaStrings.Capacity_ReserveH, AlvaFormat.Hours(avail - alloc));
    private string PeriodWord(int n) => _mode switch
    {
        "sprints" => AlvaFormat.Plural(n, "sprint"),
        "weeks" => AlvaFormat.Plural(n, "week"),
        _ => AlvaFormat.Plural(n, "day")
    };

    private decimal PeriodDeficit(Period period) => VisiblePeople.Sum(x => Overload(x.Id, period)) + Vacancies.Sum(v => Demand(v, period));

    private ChartData Forecast => new(
    [
        new ChartSeries(AlvaStrings.Capacity_FundNominal, _periods.Select(p => (double)VisiblePeople.Sum(x => Cell(x.Id, p).Available)).ToArray(), "var(--alva-chart-fund)"),
        new ChartSeries(AlvaStrings.Capacity_Planned, _periods.Select(p => (double)VisiblePeople.Sum(x => Cell(x.Id, p).Allocated)).ToArray(), "var(--alva-chart-planned)"),
        new ChartSeries(AlvaStrings.Capacity_Deficit, _periods.Select(p => (double)PeriodDeficit(p)).ToArray(), "var(--alva-chart-deficit)"),
    ], _periods.Select(p => p.Title).ToArray());

    /// <summary>Visible text output: the same values as in the chart, without relying on color and shape alone.</summary>
    private string ForecastSummary
    {
        get
        {
            if (VisiblePeople.Length == 0 && Vacancies.Length == 0) return AlvaStrings.Capacity_NoDataForTheForecast;
            var fund = _periods.Sum(p => VisiblePeople.Sum(x => Cell(x.Id, p).Available));
            var planned = _periods.Sum(p => VisiblePeople.Sum(x => Cell(x.Id, p).Allocated));
            var pct = Pct(planned, fund);
            var worst = _periods.Select(p => (p.Title, Hours: PeriodDeficit(p))).OrderByDescending(x => x.Hours).First();
            return worst.Hours > 0
                ? string.Format(AlvaStrings.Capacity_PlannedHOfHFundLargestDeficitHIn, AlvaFormat.Hours(planned), AlvaFormat.Hours(fund), pct, AlvaFormat.Hours(worst.Hours), worst.Title)
                : string.Format(AlvaStrings.Capacity_PlannedHOfHFundNoDeficitByPeriod, AlvaFormat.Hours(planned), AlvaFormat.Hours(fund), pct);
        }
    }

    protected override Task OnInitializedAsync() => Load();

    private async Task Load()
    {
        _busy = true; _error = null;
        try
        {
            _actors = await Session.Get<ActorModel[]>(Session.TeamPath("actors"));
            _departments = _actors.Where(a => a.Kind == "Department").OrderBy(a => a.Name).ToArray();
            _sprints = await Session.Get<SprintModel[]>(Session.TeamPath("sprints"));
            await LoadPeriods();
        }
        catch (Exception e) when (e is HttpRequestException or InvalidOperationException or NotSupportedException) { _error = PageFeedback.Describe(e); }
        finally { _busy = false; _loaded = true; }
    }

    private async Task SetMode(string? mode)
    {
        if (mode is null) return;
        _mode = mode;
        _busy = true;
        try { await LoadPeriods(); }
        catch (Exception e) when (e is HttpRequestException or InvalidOperationException or NotSupportedException) { _error = PageFeedback.Describe(e); }
        finally { _busy = false; }
    }

    private async Task LoadPeriods()
    {
        var sprints = _sprints.Where(s => s.Status != "Completed").OrderBy(s => s.StartDate).Take(3).ToArray();
        if (_mode == "sprints" && sprints.Length > 0)
            _periods = sprints.Select(s => new Period(s.Name, $"{s.StartDate:d MMM} — {s.EndDate:d MMM}", s.StartDate, s.EndDate)).ToArray();
        else if (_mode == "days")
        {
            var days = new List<DateOnly>();
            for (var d = Today; days.Count < 10; d = d.AddDays(1)) if (d.DayOfWeek is not (DayOfWeek.Saturday or DayOfWeek.Sunday)) days.Add(d);
            _periods = days.Select(d => new Period(d.ToString("ddd d"), d.ToString("MMM"), d, d)).ToArray();
        }
        else
        {
            if (_mode == "sprints") _mode = "weeks";
            var monday = Today.AddDays(-(((int)Today.DayOfWeek + 6) % 7));
            _periods = Enumerable.Range(0, 4).Select(i => monday.AddDays(7 * i))
                .Select(w => new Period(string.Format(AlvaStrings.Capacity_Week, System.Globalization.ISOWeek.GetWeekOfYear(w.ToDateTime(TimeOnly.MinValue))), $"{w:d MMM} — {w.AddDays(6):d MMM}", w, w.AddDays(6))).ToArray();
        }
        _rows = await Session.Get<CapacityDto[]>(Session.TeamPath($"capacity?from={_periods[0].From:yyyy-MM-dd}&to={_periods[^1].To:yyyy-MM-dd}"));
        _demand = await Session.Get<CapacityDemandDto[]>(Session.TeamPath($"capacity/demand?from={_periods[0].From:yyyy-MM-dd}&to={_periods[^1].To:yyyy-MM-dd}"));
    }
}
