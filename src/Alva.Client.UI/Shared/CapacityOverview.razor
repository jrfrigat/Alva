@* Обзор ёмкости по макету p14: KPI фонда, матрица «человек × период» с тепловой шкалой,
   вакантные роли с дефицитом и прогноз баланса по периодам. *@
@inject AlvaSession Session
<AlvaPageHeader Category="@(Strings.T("Ресурсы · Ёмкость"))" Title="@(Strings.T("Обзор ёмкости команды"))" Description="@($"{Strings.T("Сводный баланс рабочего фонда, утилизация по подкомандам и ресурсные дефициты на горизонте")} {Horizon}.")">
    <Actions>
        <FlareButton Href="capacity/people" Variant="ButtonVariant.Tonal" Size="ButtonSize.Sm">
            <LeadingIcon><FlareIconView Value="@MaterialDesign3Icons.Regular.EditCalendar" Size="18px" /></LeadingIcon>
            <ChildContent>@(Strings.T("Редактор графиков"))</ChildContent>
        </FlareButton>
        @if (_sprints.FirstOrDefault(s => s.Status == "Active") is { } active)
        {
            <FlareButton Href="@($"sprints/{active.Id}/plan")" Size="ButtonSize.Sm">
                <LeadingIcon><FlareIconView Value="@MaterialDesign3Icons.Regular.Balance" Size="18px" /></LeadingIcon>
                <ChildContent>@(Strings.T("Балансировать спринт"))</ChildContent>
            </FlareButton>
        }
    </Actions>
</AlvaPageHeader>

<div class="alva-capacity-bar">
    <FlareToggleGroup TValue="string" Value="@_mode" ValueChanged="SetMode" Size="ButtonSize.Sm" Mandatory AriaLabel="@(Strings.T("Разбивка периода"))">
        @foreach (var (mode, label) in Modes)
        {
            <FlareToggleButton Value="@mode">@label</FlareToggleButton>
        }
    </FlareToggleGroup>
    <span class="alva-capacity-bar__sep" aria-hidden="true"></span>
    <FlareText Typo="TypographyScale.LabelMedium" Color="FlareColor.OnSurfaceVariant">@(Strings.T("Подразделения:"))</FlareText>
    <FlareChipGroup SelectedValues="SelectedDepartments" SelectedValuesChanged="SetDepartment" AriaLabel="@(Strings.T("Подкоманды"))">
        <FlareChip Value="" Label="@($"{Strings.T("Все подкоманды")} ({_departments.Length})")" />
        @foreach (var dept in _departments)
        {
            <FlareChip Value="@dept.Id.ToString()" Label="@($"{dept.Name}: {People.Count(p => GroupOf(p) == dept.Id)}")" />
        }
    </FlareChipGroup>
    <FlareCheckbox TValue="bool" @bind-Value="_highlight" Label="@(Strings.T("Показывать перегрузы (>100%)"))" Class="alva-capacity-bar__check" />
</div>
<PageFeedback Error="@_error" Loading="_busy" OnRetry="Load" />
@if (!_loaded) { <LoadingSkeleton Height="20rem" /> }
else
{
<FlareGrid MinColumnWidth="min(100%,15rem)">
    <FlareStat Label="@(Strings.T("Доступный фонд (номинал)"))" Value="@AlvaFormat.Hours(Fund)" Unit="@(Strings.T("чел/час"))" Icon="@MaterialDesign3Icons.Regular.CalendarMonth"
               Caption="@($"{_periods.Length} {PeriodWord(_periods.Length)} · {VisiblePeople.Length} {AlvaFormat.Plural(VisiblePeople.Length, "person")}")" />
    <FlareStat Label="@(Strings.T("Запланированная нагрузка"))" Value="@AlvaFormat.Hours(Planned)" Unit="@($"{Strings.T("ч")} ({Pct(Planned, Fund)}%)")" Icon="@MaterialDesign3Icons.Regular.FactCheck">
        <CaptionContent>
            <FlareStack Gap="FlareSpacing.XSmall">
                <AlvaStatusChip Tone="LoadTone">@LoadLabel</AlvaStatusChip>
                <FlareProgressLinear Value="@Math.Min(100, Pct(Planned, Fund))" Size="TrackSize.Xs" Color="FlareColor.Primary" aria-label="@(Strings.T("Запланировано от фонда"))" />
                <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@(Strings.T("Целевой коридор: 85–95%")) · @Horizon</FlareText>
            </FlareStack>
        </CaptionContent>
    </FlareStat>
    <FlareStat Label="@(Strings.T("Дефицитные слоты"))" Value="@($"{(Deficit > 0 ? "−" : "")}{AlvaFormat.Hours(Deficit)}")" Unit="@(Strings.T("ч дефицита"))" Icon="@MaterialDesign3Icons.Regular.Warning"
               Caption="@($"{WorstName ?? Strings.T("Дефицита нет")} · {OverloadedCount} {Strings.T("в перегрузе")}")" />
    <FlareStat Label="@(Strings.T("Свободный резерв"))" Value="@($"+{AlvaFormat.Hours(Reserve)}")" Unit="@(Strings.T("ч доступно"))" Icon="@MaterialDesign3Icons.Regular.Inventory2"
               Caption="@($"{FreestName ?? Strings.T("Резерва нет")} · {Strings.T("Конец горизонта")}")" />
</FlareGrid>

<FlareCard Variant="CardVariant.Outlined">
    <FlareCardHeader Title="@(Strings.T("Матрица распределения ёмкости"))" Subtitle="@($"{Strings.T("Развёртка:")} {string.Join(", ", _periods.Select(p => p.Title))}")" />
    <FlareCardContent>
    <div class="alva-heat-legend">
        <span class="alva-heat-legend__title">@(Strings.T("Тепловая шкала:"))</span>
        <span><i class="alva-heat--under"></i>@(Strings.T("<70% Недогруз"))</span>
        <span><i class="alva-heat--balance"></i>@(Strings.T("70–100% Баланс"))</span>
        <span><i class="alva-heat--tension"></i>@(Strings.T("101–115% Напряжение"))</span>
        <span><i class="alva-heat--critical"></i>@(Strings.T(">115% Критичный перегруз"))</span>
    </div>
    <div class="alva-matrix" role="table" aria-label="@(Strings.T("Распределение ёмкости"))" style="--alva-matrix-periods:@Math.Max(1, _periods.Length)">
        <div class="alva-matrix__head" role="row">
            <span role="columnheader">@(Strings.T("Ресурс / подкоманда"))</span><span role="columnheader">@(Strings.T("Роль / статус"))</span><span role="columnheader">@(Strings.T("Доступно (фонд)"))</span>
            @foreach (var period in _periods) { <span role="columnheader" class="alva-matrix__period"><b>@period.Title</b><small class="alva-num">@period.Subtitle</small></span> }
            <span role="columnheader">@(Strings.T("Итог фонда"))</span>
        </div>
        @foreach (var group in Groups)
        {
            var people = VisiblePeople.Where(p => GroupOf(p) == group.Id).ToArray();
            var roles = Vacancies.Where(v => GroupOfRole(v) == group.Id).ToArray();
            if (people.Length == 0 && roles.Length == 0) { continue; }
            var groupFund = people.Sum(p => Available(p.Id));
            var groupBalance = groupFund - people.Sum(p => Allocated(p.Id)) - roles.Sum(r => Demand(r));
            <div class="alva-matrix__group" role="row">
                <span role="cell" class="alva-matrix__group-name">@group.Name <small>(@people.Length @AlvaFormat.Plural(people.Length, "person")@(roles.Length > 0 ? string.Format(Strings.T(", вакансий: {0}"), roles.Length) : ""))</small></span>
                <span role="cell" class="alva-matrix__group-total @(groupBalance < 0 ? "alva-matrix__group-total--critical" : "")">@(groupBalance < 0 ? string.Format(Strings.T("Дефицит периода: −{0} ч"), AlvaFormat.Hours(-groupBalance)) : string.Format(Strings.T("Резерв периода: +{0} ч"), AlvaFormat.Hours(groupBalance))) · @(Strings.T("Фонд:")) @AlvaFormat.Hours(groupFund) @(Strings.T("ч"))</span>
            </div>
            @foreach (var person in people)
            {
                <div class="alva-matrix__row" role="row" @key="person.Id">
                    <span role="cell" class="alva-matrix__who"><span class="alva-slot__mark" aria-hidden="true">@AlvaFormat.Initials(person.Name)</span><span><a href="@($"capacity/{person.Id}")" class="alva-matrix__name">@person.Name</a><small>@RolesOf(person)</small></span></span>
                    <span role="cell"><AlvaStatusChip Tone="AlvaTone.Info">@(Strings.T("Штат"))</AlvaStatusChip></span>
                    <span role="cell" class="alva-num alva-matrix__fund">@AlvaFormat.Hours(Available(person.Id)) @(Strings.T("ч"))</span>
                    @foreach (var period in _periods)
                    {
                        var (avail, alloc) = Cell(person.Id, period);
                        var pct = Pct(alloc, avail);
                        var over = Overload(person.Id, period);
                        <span role="cell" class="alva-heat alva-heat--@Heat(pct, avail, alloc) @(_highlight && over > 0 ? "alva-heat--flag" : "")">
                            <span class="alva-heat__top alva-num"><span>@AlvaFormat.Hours(alloc) @(Strings.T("ч")) / @AlvaFormat.Hours(avail) @(Strings.T("ч"))</span><b>@(avail > 0 ? $"{pct}%" : "—")</b></span>
                            <span class="alva-heat__bar"><span style="width:@Math.Min(100, pct)%"></span></span>
                            <span class="alva-heat__note">@CellNote(avail, alloc, over)</span>
                        </span>
                    }
                    <span role="cell" class="alva-num alva-matrix__total @(Allocated(person.Id) > Available(person.Id) ? "alva-matrix__total--critical" : "")">@AlvaFormat.Hours(Allocated(person.Id)) @(Strings.T("ч")) / @AlvaFormat.Hours(Available(person.Id)) @(Strings.T("ч"))</span>
                </div>
            }
            @foreach (var role in roles)
            {
                <div class="alva-matrix__row alva-matrix__row--vacancy" role="row" @key="role.Id">
                    <span role="cell" class="alva-matrix__who"><span class="alva-slot__mark alva-slot__mark--vacancy" aria-hidden="true"><FlareIconView Value="@MaterialDesign3Icons.Regular.PersonAdd" Size="14px" /></span><span><span class="alva-matrix__name alva-matrix__name--critical">@Labels.Kind(role.Kind): @role.Name</span><small>@(Strings.T("Требуется человек / вакантный слот"))</small></span></span>
                    <span role="cell"><AlvaStatusChip Tone="AlvaTone.Critical">@(Strings.T("Вакансия"))</AlvaStatusChip></span>
                    <span role="cell" class="alva-num alva-matrix__fund alva-matrix__total--critical">0 @(Strings.T("ч"))</span>
                    @foreach (var period in _periods)
                    {
                        var demand = Demand(role, period);
                        <span role="cell" class="alva-heat @(demand > 0 ? "alva-heat--critical" : "alva-heat--empty")">
                            <span class="alva-heat__top alva-num"><span>@AlvaFormat.Hours(demand) @(Strings.T("ч")) / 0 @(Strings.T("ч"))</span>@if (demand > 0) { <b>@(Strings.T("НЕТ СЛОТА"))</b> }</span>
                            <span class="alva-heat__note">@(demand > 0 ? string.Format(Strings.T("Дефицит: −{0} ч"), AlvaFormat.Hours(demand)) : Strings.T("Нет назначений"))</span>
                        </span>
                    }
                    <span role="cell" class="alva-num alva-matrix__total alva-matrix__total--critical">−@AlvaFormat.Hours(Demand(role)) @(Strings.T("ч"))<br /><small>@(Strings.T("Дефицит"))</small></span>
                </div>
            }
        }
        @if (!VisiblePeople.Any() && !Vacancies.Any()) { <FlareEmptyState Compact Title="@(Strings.T("Нет людей с рабочими графиками за горизонт."))" /> }
    </div>
    </FlareCardContent>
    <FlareCardActions Align="CardActionsAlign.Between">
        <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@(Strings.T("Показано:")) @VisiblePeople.Length @AlvaFormat.Plural(VisiblePeople.Length, "person") @(Strings.T("в")) @Groups.Count(g => VisiblePeople.Any(p => GroupOf(p) == g.Id)) @AlvaFormat.Plural(Groups.Count(g => VisiblePeople.Any(p => GroupOf(p) == g.Id)), "subteam")</FlareText>
        <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@(Strings.T("Фонд — по рабочим графикам людей с учётом отпусков и блоков"))</FlareText>
    </FlareCardActions>
</FlareCard>

@if (_periods.Length > 0)
{
    <FlareCard Variant="CardVariant.Outlined">
        <FlareCardHeader Title="@(Strings.T("Прогноз баланса ёмкости по периодам"))" Subtitle="@(Strings.T("Сравнение номинала фонда, запланированной работы и ресурсного дефицита"))" />
        <FlareCardContent>
            <FlareChart Type="ChartType.Bar" Data="Forecast" Height="260" ComponentCssClass="alva-forecast-chart"
                        Description="@ForecastSummary" DataTable="true" aria-label="@(Strings.T("Фонд, план и дефицит по периодам"))" />
            <FlareText Element="p" Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant"><b>@(Strings.T("Ключевой вывод:"))</b> @ForecastSummary</FlareText>
        </FlareCardContent>
    </FlareCard>
}
}

@code {
    private sealed record Period(string Title, string Subtitle, DateOnly From, DateOnly To);
    private (string Mode, string Label)[] Modes => [("sprints", Strings.T("По спринтам")), ("weeks", Strings.T("По неделям")), ("days", Strings.T("По дням"))];

    private CapacityDto[] _rows = [];
    private CapacityDemandDto[] _demand = [];
    private ActorModel[] _actors = [];
    private ActorModel[] _departments = [];
    private SprintModel[] _sprints = [];
    private Period[] _periods = [];
    private string _mode = "sprints";
    private Guid? _department;
    private bool _highlight = true, _busy, _loaded;
    private string? _error;

    private static DateOnly Today => DateOnly.FromDateTime(DateTime.Today);
    private string Horizon => _periods.Length == 0 ? "—" : $"{_periods[0].From:d MMM} — {_periods[^1].To:d MMM yyyy}";
    private ActorModel[] People => _actors.Where(a => a.Kind == "Person" && _rows.Any(r => r.ActorId == a.Id)).ToArray();
    private ActorModel[] VisiblePeople => People.Where(p => _department is null || GroupOf(p) == _department).ToArray();

    /// <summary>Роли и подкоманды, на которые назначена работа без конкретного человека.</summary>
    private ActorModel[] Vacancies => _actors
        .Where(a => a.Kind != "Person" && (_department is null || GroupOfRole(a) == _department) && Demand(a) > 0).ToArray();

    private IEnumerable<(Guid? Id, string Name)> Groups =>
        _departments.Select(d => ((Guid?)d.Id, d.Name)).Append((null, Strings.T("Без подкоманды")));

    private Guid? GroupOf(ActorModel person) => person.DepartmentIds.FirstOrDefault(id => _departments.Any(d => d.Id == id)) is var id && id != Guid.Empty ? id : (Guid?)null;
    private Guid? GroupOfRole(ActorModel actor) => actor.Kind == "Department" ? actor.Id : actor.ParentId is { } parent && _departments.Any(d => d.Id == parent) ? parent : null;
    private string RolesOf(ActorModel person) => string.Join(" / ", _actors.Where(a => person.RoleIds.Contains(a.Id)).Select(a => a.Name).DefaultIfEmpty(Strings.T("Участник команды")));

    private (decimal Available, decimal Allocated) Cell(Guid actorId, Period period)
    {
        var rows = _rows.Where(r => r.ActorId == actorId && r.Date >= period.From && r.Date <= period.To);
        return (rows.Sum(r => r.AvailableHours), rows.Sum(r => r.AllocatedHours));
    }

    private decimal Available(Guid id) => _periods.Sum(p => Cell(id, p).Available);
    private decimal Allocated(Guid id) => _periods.Sum(p => Cell(id, p).Allocated);

    /// <summary>Часы задач на роль или подкоманду без человека в периоде — из capacity/demand.</summary>
    private decimal Demand(ActorModel role, Period period) => _demand.Where(d => d.TargetId == role.Id && d.Date >= period.From && d.Date <= period.To).Sum(d => d.Hours);

    private decimal Demand(ActorModel role) => _periods.Sum(p => Demand(role, p));

    private decimal Fund => VisiblePeople.Sum(p => Available(p.Id));
    private decimal Planned => VisiblePeople.Sum(p => Allocated(p.Id));
    // Дефицит людей — превышения по дням: резерв одного дня не покрывает перегруз другого.
    private decimal Overload(Guid id, Period period) => CapacityMath.Overload(_rows.Where(r => r.ActorId == id && r.Date >= period.From && r.Date <= period.To));
    private decimal Overload(Guid id) => _periods.Sum(p => Overload(id, p));
    private decimal Deficit => VisiblePeople.Sum(p => Overload(p.Id)) + Vacancies.Sum(Demand);
    private decimal Reserve => VisiblePeople.Sum(p => Math.Max(0, Available(p.Id) - Allocated(p.Id)));
    private int OverloadedCount => VisiblePeople.Count(p => Overload(p.Id) > 0);
    private string? WorstName => VisiblePeople.Select(p => (p.Name, Gap: Overload(p.Id))).Concat(Vacancies.Select(v => (v.Name, Gap: Demand(v)))).Where(x => x.Gap > 0).OrderByDescending(x => x.Gap).Select(x => x.Name).FirstOrDefault();
    private string? FreestName => VisiblePeople.Select(p => (p.Name, Free: Available(p.Id) - Allocated(p.Id))).Where(x => x.Free > 0).OrderByDescending(x => x.Free).Select(x => string.Format(Strings.T("{0} (+{1} ч)"), x.Name, AlvaFormat.Hours(x.Free))).FirstOrDefault();
    private AlvaTone LoadTone => Pct(Planned, Fund) switch { > 100 => AlvaTone.Critical, >= 85 and <= 95 => AlvaTone.Ok, > 95 => AlvaTone.Warning, _ => AlvaTone.Info };
    private string LoadLabel => Pct(Planned, Fund) switch { > 100 => Strings.T("Перегруз"), >= 85 and <= 95 => Strings.T("Оптимально"), > 95 => Strings.T("На пределе"), _ => Strings.T("Недогруз") };

    private static int Pct(decimal part, decimal whole) => whole <= 0 ? (part > 0 ? 999 : 0) : (int)Math.Round(part / whole * 100);
    private IReadOnlyCollection<string> SelectedDepartments => _department is null ? [""] : [_department.Value.ToString()];
    private void SetDepartment(IReadOnlyCollection<string> values) =>
        _department = values.FirstOrDefault() is { Length: > 0 } key && Guid.TryParse(key, out var id) ? id : null;
    private static string Heat(int pct, decimal avail, decimal alloc) => avail <= 0 && alloc <= 0 ? "empty" : pct > 115 ? "critical" : pct > 100 ? "tension" : pct >= 70 ? "balance" : "under";
    private static string CellNote(decimal avail, decimal alloc, decimal over) =>
        over > 0 && alloc <= avail ? $"{Strings.T("Перегруз по дням:")} {AlvaFormat.Hours(over)} {Strings.T("ч")}" :
        avail <= 0 && alloc <= 0 ? Strings.T("Нет графика") : alloc > avail ? string.Format(Strings.T("Перегрузка: −{0} ч"), AlvaFormat.Hours(alloc - avail)) : alloc == avail ? Strings.T("Полный баланс") : string.Format(Strings.T("Резерв: +{0} ч"), AlvaFormat.Hours(avail - alloc));
    private string PeriodWord(int n) => _mode switch
    {
        "sprints" => AlvaFormat.Plural(n, "sprint"),
        "weeks" => AlvaFormat.Plural(n, "week"),
        _ => AlvaFormat.Plural(n, "day")
    };

    private decimal PeriodDeficit(Period period) => VisiblePeople.Sum(x => Overload(x.Id, period)) + Vacancies.Sum(v => Demand(v, period));

    private ChartData Forecast => new(
    [
        new ChartSeries(Strings.T("Номинал фонда"), _periods.Select(p => (double)VisiblePeople.Sum(x => Cell(x.Id, p).Available)).ToArray(), "var(--alva-chart-fund)"),
        new ChartSeries(Strings.T("Запланировано"), _periods.Select(p => (double)VisiblePeople.Sum(x => Cell(x.Id, p).Allocated)).ToArray(), "var(--alva-chart-planned)"),
        new ChartSeries(Strings.T("Дефицит"), _periods.Select(p => (double)PeriodDeficit(p)).ToArray(), "var(--alva-chart-deficit)"),
    ], _periods.Select(p => p.Title).ToArray());

    /// <summary>Видимый текстовый вывод: те же значения, что в графике, без опоры только на цвет и форму.</summary>
    private string ForecastSummary
    {
        get
        {
            if (VisiblePeople.Length == 0 && Vacancies.Length == 0) return Strings.T("Нет данных для прогноза.");
            var fund = _periods.Sum(p => VisiblePeople.Sum(x => Cell(x.Id, p).Available));
            var planned = _periods.Sum(p => VisiblePeople.Sum(x => Cell(x.Id, p).Allocated));
            var pct = Pct(planned, fund);
            var worst = _periods.Select(p => (p.Title, Hours: PeriodDeficit(p))).OrderByDescending(x => x.Hours).First();
            return worst.Hours > 0
                ? string.Format(Strings.T("Запланировано {0} ч из {1} ч фонда ({2}%). Наибольший дефицит — {3} ч в период «{4}»."), AlvaFormat.Hours(planned), AlvaFormat.Hours(fund), pct, AlvaFormat.Hours(worst.Hours), worst.Title)
                : string.Format(Strings.T("Запланировано {0} ч из {1} ч фонда ({2}%). Дефицита по периодам нет."), AlvaFormat.Hours(planned), AlvaFormat.Hours(fund), pct);
        }
    }

    protected override Task OnInitializedAsync() => Load();

    private async Task Load()
    {
        _busy = true; _error = null;
        try
        {
            _actors = await Session.Get<ActorModel[]>(Session.TeamPath("actors"));
            _departments = _actors.Where(a => a.Kind == "Department").OrderBy(a => a.Name).ToArray();
            _sprints = await Session.Get<SprintModel[]>(Session.TeamPath("sprints"));
            await LoadPeriods();
        }
        catch (Exception e) when (e is HttpRequestException or InvalidOperationException or NotSupportedException) { _error = PageFeedback.Describe(e); }
        finally { _busy = false; _loaded = true; }
    }

    private async Task SetMode(string? mode)
    {
        if (mode is null) return;
        _mode = mode;
        _busy = true;
        try { await LoadPeriods(); }
        catch (Exception e) when (e is HttpRequestException or InvalidOperationException or NotSupportedException) { _error = PageFeedback.Describe(e); }
        finally { _busy = false; }
    }

    private async Task LoadPeriods()
    {
        var sprints = _sprints.Where(s => s.Status != "Completed").OrderBy(s => s.StartDate).Take(3).ToArray();
        if (_mode == "sprints" && sprints.Length > 0)
            _periods = sprints.Select(s => new Period(s.Name, $"{s.StartDate:d MMM} — {s.EndDate:d MMM}", s.StartDate, s.EndDate)).ToArray();
        else if (_mode == "days")
        {
            var days = new List<DateOnly>();
            for (var d = Today; days.Count < 10; d = d.AddDays(1)) if (d.DayOfWeek is not (DayOfWeek.Saturday or DayOfWeek.Sunday)) days.Add(d);
            _periods = days.Select(d => new Period(d.ToString("ddd d"), d.ToString("MMM"), d, d)).ToArray();
        }
        else
        {
            if (_mode == "sprints") _mode = "weeks";
            var monday = Today.AddDays(-(((int)Today.DayOfWeek + 6) % 7));
            _periods = Enumerable.Range(0, 4).Select(i => monday.AddDays(7 * i))
                .Select(w => new Period(string.Format(Strings.T("Неделя {0}"), System.Globalization.ISOWeek.GetWeekOfYear(w.ToDateTime(TimeOnly.MinValue))), $"{w:d MMM} — {w.AddDays(6):d MMM}", w, w.AddDays(6))).ToArray();
        }
        _rows = await Session.Get<CapacityDto[]>(Session.TeamPath($"capacity?from={_periods[0].From:yyyy-MM-dd}&to={_periods[^1].To:yyyy-MM-dd}"));
        _demand = await Session.Get<CapacityDemandDto[]>(Session.TeamPath($"capacity/demand?from={_periods[0].From:yyyy-MM-dd}&to={_periods[^1].To:yyyy-MM-dd}"));
    }
}
