@* Tasks whose assignee lacks a required skill: one warning under the board instead of a line in every Gantt row. *@
@if (Issues.Length > 0)
{
    <FlareAlert Severity="AlertSeverity.Warning" Title="@(AlvaStrings.Sprint_MissingSkills)">
        <FlareStack Gap="FlareSpacing.XSmall">
            @foreach (var issue in Issues)
            {
                <FlareStack Row Wrap Align="FlareAlignItems.Center" Gap="FlareSpacing.Small" @key="issue.Task.Id">
                    <FlareLink Href="@($"tasks/{issue.Task.Id}")">@issue.Task.Title</FlareLink>
                    <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@issue.Person.Name: @string.Join(", ", issue.Missing)</FlareText>
                </FlareStack>
            }
        </FlareStack>
    </FlareAlert>
}

@code {
    private sealed record Issue(TaskModel Task, ActorModel Person, string[] Missing);

    [Parameter] public IEnumerable<TaskModel> Tasks { get; set; } = [];
    [Parameter] public IEnumerable<ActorModel> Actors { get; set; } = [];

    private Issue[] Issues
    {
        get
        {
            var actors = Actors.ToArray();
            var skills = actors.Where(x => x.Kind == "Skill").ToDictionary(x => x.Id, x => x.Name);
            return [.. Tasks
                .Where(t => t.Status is not ("Done" or "Cancelled") && t.RequiredSkillIds.Length > 0)
                .Select(t => (Task: t, Person: actors.FirstOrDefault(a => a.Kind == "Person" && a.Id == (t.ResolvedPersonId ?? t.AssignmentTargetId))))
                .Where(x => x.Person is not null)
                .Select(x => new Issue(x.Task, x.Person!,
                    [.. SkillMath.Missing(x.Task.RequiredSkillIds, x.Person!.SkillIds).Select(id => skills.GetValueOrDefault(id)).OfType<string>()]))
                .Where(x => x.Missing.Length > 0)];
        }
    }
}
