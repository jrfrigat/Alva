@using Flare.Components.Gantt
@* Projection 2: lanes of people and skills with capacity hours and the assignee's tasks. Placed inside
   FlareGantt - on the Gantt by people page and on the sprint planning board. *@
<FlareGanttPanel TRow="PeopleRow" TItem="TaskModel" Rows="@People.Rows" RowKey="r => r.Key" RowChildren="r => r.Children.Count > 0 ? r.Children : null"
                 RowClass="RowClass" Items="@People.Items" ItemKey="t => GanttData.Key(t.Id)" ItemRow="People.RowOf"
                 ItemSpan="People.Data.Span" ItemCover="People.Data.Cover" ItemKind="People.Data.Kind" ItemSegments="People.Data.Segments" ItemLabel="t => t.Title" ItemTitle="People.Data.Title"
                 Links="@People.Data.Links().ToArray()" Cells="@People.Cells(Scale, Range)" Editable="true"
                 OnChange="OnChange" OnLinkCreate="OnLinkCreate" OnLinkRejected="OnLinkRejected" OnItemClick="OnItemClick" Header="Header"
                 DropGroup="@DropGroup" DropAccepts="DropAccepts" ItemDropGroup="@ItemDropGroup" ItemDropAccepts="ItemDropAccepts" Suggested="Suggested"
                 AriaLabel="@(AlvaStrings.Gantt_PeopleAndRolesOverTime)">
    <RowHeader Context="row">
        <FlareStack Gap="FlareSpacing.XXSmall" Class="alva-gantt-row">
            @if (row.Kind == "person")
            {
                <FlareLink Class="alva-gantt-row__title" Href="@($"capacity/{row.Actor!.Id}")" title="@row.Name">@row.Name</FlareLink>
            }
            else
            {
                <FlareText Typo="TypographyScale.LabelMedium" Class="alva-gantt-row__title" title="@row.Name">@row.Name</FlareText>
            }
            <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant" Class="alva-gantt-row__meta">@row.Meta</FlareText>
        </FlareStack>
    </RowHeader>
</FlareGanttPanel>

@code {
    [Parameter, EditorRequired] public GanttPeopleData People { get; set; } = null!;
    [Parameter] public GanttScale Scale { get; set; } = GanttScale.Day;
    [Parameter, EditorRequired] public GanttSpan Range { get; set; }
    [Parameter] public RenderFragment? Header { get; set; }

    /// <summary>Person whose row is highlighted.</summary>
    [Parameter] public Guid? Focus { get; set; }

    [Parameter] public EventCallback<GanttChangeEventArgs> OnChange { get; set; }
    [Parameter] public EventCallback<GanttLinkEventArgs> OnLinkCreate { get; set; }
    [Parameter] public EventCallback<GanttLinkRejectedEventArgs> OnLinkRejected { get; set; }

    /// <summary>Click on a task bar - the page opens the task panel.</summary>
    [Parameter] public EventCallback<TaskModel> OnItemClick { get; set; }
    [Parameter] public string? DropGroup { get; set; }
    [Parameter] public Func<object?, bool>? DropAccepts { get; set; }
    [Parameter] public string? ItemDropGroup { get; set; }
    [Parameter] public Func<object?, bool>? ItemDropAccepts { get; set; }

    /// <summary>Suggested task dates and rows - ghost bars over the plan.</summary>
    [Parameter] public IEnumerable<GanttChange>? Suggested { get; set; }

    private string RowClass(PeopleRow row) =>
        $"alva-gantt-row--{row.Kind}" + (Focus is { } id && row.Actor?.Id == id ? " alva-gantt-row--focus" : "");
}
