@* Доска планирования спринта по макетам p6 и p6_2d: KPI ёмкости, бэклог, Гантт спринта 2D, баланс специальностей
   и люди спринта. Всё связано перетаскиванием: задача на день Гантта получает срок, на строку человека — ещё и
   исполнителя; человек на задачу становится исполнителем; задача в бэклог выходит из спринта. *@
@using Flare.Components.Gantt
@inject AlvaSession Session
@inject NavigationManager Navigation
<section class="alva-plan-head">
    <div class="alva-plan-head__row">
        <div class="alva-plan-head__picker">
            <FlareIconView Value="@MaterialDesign3Icons.Regular.CalendarMonth" Size="22px" Class="alva-panel__icon" />
            <FlareSelect TValue="Guid" Label="@(AlvaStrings.Gantt_Sprint)" Items="Choices.Select(s => s.Id)" ItemLabel="SprintLabel" Value="Sprint.Id" ValueChanged="Pick" />
            <span class="alva-plan-head__horizon alva-num">@(AlvaStrings.Sprint_PlanningHorizon) @AlvaFormat.WorkDays(Sprint.StartDate, Sprint.EndDate) @(AlvaStrings.Sprint_WorkShifts) · @AlvaFormat.Period(Sprint.StartDate, Sprint.EndDate)</span>
        </div>
        <AlvaStatusChip Tone="@(Sprint.Status == "Planned" ? AlvaTone.Info : AlvaTones.Status(Sprint.Status))">@(Sprint.Status == "Planned" ? AlvaStrings.Sprint_PlanningDraft : Labels.Status(Sprint.Status))</AlvaStatusChip>
    </div>
    <div class="alva-plan-head__actions">
        <FlareMenu Anchor="MenuAnchor.BottomLeft" AriaLabel="@(AlvaStrings.Sprint_AutoBalanceMode)">
            <Activator>
                <FlareButton Variant="ButtonVariant.Tonal" Size="ButtonSize.Sm" Loading="_balancing" Disabled="_busy">
                    <LeadingIcon><FlareIconView Value="@MaterialDesign3Icons.Regular.Balance" Size="18px" /></LeadingIcon>
                    <ChildContent>@(AlvaStrings.Sprint_AutoBalance)</ChildContent>
                </FlareButton>
            </Activator>
            <ChildContent>
                @foreach (var (mode, label, hint) in BalanceModesMenu)
                {
                    <FlareMenuItem OnClick="() => Balance(mode)">
                        <span class="alva-plan-mode"><b>@label</b><small>@hint</small></span>
                    </FlareMenuItem>
                }
            </ChildContent>
        </FlareMenu>
        <FlareButton @ref="_paramsButton" Variant="ButtonVariant.Tonal" Size="ButtonSize.Sm" OnClick="() => OnParams.InvokeAsync()">
            <LeadingIcon><FlareIconView Value="@MaterialDesign3Icons.Regular.Tune" Size="18px" /></LeadingIcon>
            <ChildContent>@(AlvaStrings.Sprint_SprintSettings)</ChildContent>
        </FlareButton>
        <FlareButton Href="@($"sprints/{Sprint.Id}")" Variant="ButtonVariant.Outlined" Size="ButtonSize.Sm">@(AlvaStrings.Sprint_SprintPage)</FlareButton>
        @if (Sprint.Status == "Planned")
        {
            <FlareButton Size="ButtonSize.Sm" Variant="ButtonVariant.Outlined" Loading="_busy" OnClick="Commit">
                <LeadingIcon><FlareIconView Value="@MaterialDesign3Icons.Regular.Lock" Size="18px" /></LeadingIcon>
                <ChildContent>@(AlvaStrings.Sprint_CommitTheSprint)</ChildContent>
            </FlareButton>
        }
    </div>
    <FlareGrid MinColumnWidth="min(100%,12rem)">
        <FlareStat Label="@(AlvaStrings.Sprint_TeamCapacity)" Value="@($"{AlvaFormat.Hours(Capacity)} {AlvaStrings.Sprint_HoursShort}")" Icon="@MaterialDesign3Icons.Regular.Groups" />
        <FlareStat Label="@(AlvaStrings.Sprint_PlannedIntoTheSprint)" Value="@($"{AlvaFormat.Hours(Planned)} {AlvaStrings.Sprint_HoursShort}")" Icon="@MaterialDesign3Icons.Regular.FactCheck">
            <CaptionContent><AlvaStatusChip Tone="@(Planned > Capacity ? AlvaTone.Critical : AlvaTone.Info)">@Pct(Planned, Capacity)%</AlvaStatusChip></CaptionContent>
        </FlareStat>
        <FlareStat Label="@(Capacity >= Planned ? AlvaStrings.Sprint_CapacityReserve : AlvaStrings.Sprint_CapacityShortage)" Value="@($"{AlvaFormat.Hours(Math.Abs(Capacity - Planned))} {AlvaStrings.Sprint_HoursShort}")" Caption="@(Capacity >= Planned ? AlvaStrings.Sprint_Reserve : AlvaStrings.Sprint_OverCapacity)" Icon="@MaterialDesign3Icons.Regular.HourglassEmpty" />
        <FlareStat Label="@(AlvaStrings.Sprint_Overtime)" Value="@($"{AlvaFormat.Hours(Overtime)} {AlvaStrings.Sprint_HoursShort}")" Icon="@MaterialDesign3Icons.Regular.Warning">
            <CaptionContent>@if (OvertimePeople > 0) { <AlvaStatusChip Tone="AlvaTone.Critical">@OvertimePeople @(AlvaStrings.Common_People)</AlvaStatusChip> }</CaptionContent>
        </FlareStat>
    </FlareGrid>
</section>
<PageFeedback Error="@_error" />

@if (_proposal is { } proposal)
{
    <section class="alva-panel alva-plan-proposal" aria-live="polite">
        <header class="alva-panel__header">
            <FlareIconView Value="@MaterialDesign3Icons.Regular.Balance" Size="20px" Class="alva-panel__icon" />
            <div>
                <h2 class="alva-panel__title">@(AlvaStrings.Sprint_AutoBalanceRecommendation) @ModeName(proposal.Mode)</h2>
                <p class="alva-panel__subtitle">@StatusText(proposal.Status)@(proposal.Note is { } note ? $" · {note}" : "") · @(AlvaStrings.Sprint_TheDashedLineOnTheGanttShowsWhereTasksWillMoveNothingIsSavedUntilYouAppl_0664fc)</p>
            </div>
            <div class="alva-plan-proposal__actions">
                @if (proposal.Changes.Length > 0)
                {
                    <FlareButton Size="ButtonSize.Sm" Loading="_busy" Disabled="Chosen.Count == 0" OnClick="ApplyProposal">@(AlvaStrings.Sprint_ApplySelected) (@Chosen.Count)</FlareButton>
                }
                <FlareButton Size="ButtonSize.Sm" Variant="ButtonVariant.Outlined" Disabled="_busy" OnClick="RejectProposal">@(proposal.Changes.Length > 0 ? AlvaStrings.Sprint_Reject : AlvaStrings.Common_Close)</FlareButton>
            </div>
        </header>
        <div class="alva-plan-proposal__metrics">
            @foreach (var (label, before, after, unit) in Metrics(proposal))
            {
                <div class="alva-plan-metric alva-plan-metric--@(after < before ? "better" : after > before ? "worse" : "same")">
                    <span class="alva-kpi__label">@label</span>
                    <span class="alva-num"><s>@AlvaFormat.Hours(before)</s> → <b>@AlvaFormat.Hours(after)</b> @unit</span>
                </div>
            }
        </div>
        @* Расчёт двигает не всё: задачи в работе, родительские, без оценки или назначения остаются как есть. *@
        <p class="alva-plan-proposal__scope alva-num">@(AlvaStrings.Sprint_TasksConsidered) @proposal.Considered@(proposal.Excluded is { Length: > 0 } skipped ? $" · {AlvaStrings.Sprint_LeftOut} {skipped.Length}" : "")</p>
        @if (proposal.Excluded is { Length: > 0 } excluded)
        {
            <details class="alva-plan-proposal__excluded">
                <summary>@(AlvaStrings.Sprint_WhyTasksWereLeftOut)</summary>
                <ul>
                    @foreach (var item in excluded)
                    {
                        <li @key="item.TaskId"><a href="tasks/@item.TaskId">@item.Title</a> — @ReasonText.Describe(item.Reason)</li>
                    }
                </ul>
            </details>
        }
        @if (proposal.Changes.Length == 0)
        {
            <p class="alva-panel__subtitle">@(proposal.Status == BalanceMath.Infeasible
                ? AlvaStrings.Sprint_NoFeasiblePlanFixedDatesAndLinksContradictEachOther
                : proposal.Excluded is { Length: > 0 } ? AlvaStrings.Sprint_NoImprovementAmongTheTasksConsideredTheTasksTheCalculationDidNotTouchAre_277646 : AlvaStrings.Sprint_ThePlanIsAlreadyBalancedInThisModeNothingToChange)</p>
        }
        else
        {
            <ul class="alva-plan-proposal__list">
                @foreach (var change in proposal.Changes)
                {
                    <li class="alva-plan-change" @key="change.TaskId">
                        <FlareCheckbox TValue="bool" Value="_chosen.Contains(change.TaskId)" ValueChanged="(bool on) => Choose(change.TaskId, on)"
                                       AriaLabel="@string.Format(AlvaStrings.Sprint_ApplyTheChange, change.Title)" />
                        <div class="alva-plan-change__body">
                            <a class="alva-plan-change__title" href="tasks/@change.TaskId">@change.Title</a>
                            <span class="alva-plan-change__what alva-num">
                                @if (change.FromPersonId != change.ToPersonId)
                                {
                                    <span>@(change.FromPersonName ?? AlvaStrings.Sprint_Nobody) → <b>@change.ToPersonName</b></span>
                                }
                                @if (change.FromStart != change.ToStart || change.FromEnd != change.ToEnd)
                                {
                                    <span>@AlvaFormat.Period(change.FromStart, change.FromEnd) → <b>@AlvaFormat.Period(change.ToStart, change.ToEnd)</b></span>
                                }
                            </span>
                            <small class="alva-plan-change__why">@ReasonText.Join(change.Reasons)</small>
                        </div>
                    </li>
                }
            </ul>
        }
    </section>
}

<FlareDragContext TPayload="PlanDrag" Group="plan" OnDrop="Drop" Class="alva-plan-board">
    <section class="alva-panel alva-plan-pool">
        <header class="alva-panel__header">
            <FlareIconView Value="@MaterialDesign3Icons.Regular.Inventory2" Size="20px" Class="alva-panel__icon" />
            <h2 class="alva-panel__title">@(AlvaStrings.Sprint_TaskPoolBacklog)</h2>
            <span class="alva-plan-count alva-num">@Pool.Count()</span>
        </header>
        <div class="alva-quickfilter" role="group" aria-label="@(AlvaStrings.Sprint_PoolFilter)">
            @foreach (var (key, label) in PoolFilters)
            {
                <button type="button" class="alva-quickfilter__item @(_poolFilter == key ? "alva-quickfilter__item--active" : "")" aria-pressed="@(_poolFilter == key)" @onclick="() => _poolFilter = key">@label (@Pool.Count(t => Matches(t, key)))</button>
            }
        </div>
        <FlareTextField @bind-Value="_search" Immediate Clearable Placeholder="@(AlvaStrings.Sprint_SearchByCodeOrTitle)" AriaLabel="@(AlvaStrings.Sprint_SearchThePool)">
            <AdornmentStart><FlareIconView Value="@MaterialDesign3Icons.Regular.Search" Size="18px" /></AdornmentStart>
        </FlareTextField>
        <FlareDropZone Target="pool" Accepts="FromSprint" Class="alva-plan-cards">
            @foreach (var task in Pool.Where(t => Matches(t, _poolFilter) && Found(t)))
            {
                <FlareDropZone Target="@($"task:{task.Id}")" Accepts="IsPerson" Class="alva-plan-card-zone" @key="task.Id">
                    <FlareDraggable Payload="@(new TaskDrag(task.Id))" Class="alva-plan-card">
                        <div class="alva-plan-card__top">
                            <a class="alva-plan-card__code" href="@($"tasks/{task.Id}")">@AlvaFormat.Code(task.Id)</a>
                            <span class="alva-project-chip">@ProjectName(task.ProjectId)</span>
                            @if (task.Priority != "Normal") { <AlvaStatusChip Tone="AlvaTones.Priority(task.Priority)">@Labels.Priority(task.Priority)</AlvaStatusChip> }
                            <span class="alva-plan-card__est alva-num"><FlareIconView Value="@MaterialDesign3Icons.Regular.Schedule" Size="15px" /> @(task.EstimateHours.HasValue ? $"{AlvaFormat.Hours(task.EstimateHours.Value)} {AlvaStrings.Sprint_HoursShort}" : "—")</span>
                        </div>
                        <div class="alva-plan-card__title">@task.Title</div>
                        <div class="alva-plan-card__bottom">
                            <AlvaAssignee Task="task" Actors="_actors" />
                            <span class="alva-plan-card__deadline alva-num">@(task.Deadline.HasValue ? task.Deadline.Value.ToString("d MMM") : AlvaStrings.Sprint_NoDeadline)</span>
                            @if (!Ready(task)) { <span class="alva-plan-card__unready" title="@(AlvaStrings.Sprint_NeedsAnEstimateAndAnAssigneeOrRole)">@(AlvaStrings.Sprint_NotReady)</span> }
                            <span class="alva-plan-card__rank">
                                <FlareIconButton Icon="@MaterialDesign3Icons.Regular.ArrowUpward" Size="ButtonSize.Sm" AriaLabel="@($"{AlvaStrings.Sprint_MoveUpInThePool}: {task.Title}")" Disabled="@(_busy || task == Pool.First())" OnClick="() => Rerank(task, -1)" />
                                <FlareIconButton Icon="@MaterialDesign3Icons.Regular.ArrowDownward" Size="ButtonSize.Sm" AriaLabel="@($"{AlvaStrings.Sprint_MoveDownInThePool}: {task.Title}")" Disabled="@(_busy || task == Pool.Last())" OnClick="() => Rerank(task, 1)" />
                            </span>
                            <FlareButton Size="ButtonSize.Sm" Variant="ButtonVariant.Tonal" Disabled="_busy" OnClick="() => Move(task, true)">@(AlvaStrings.Sprint_IntoSprint)</FlareButton>
                        </div>
                    </FlareDraggable>
                </FlareDropZone>
            }
            @if (!Pool.Any(t => Matches(t, _poolFilter) && Found(t))) { <FlareEmptyState Compact Title="@(AlvaStrings.Sprint_ThePoolIsEmpty)" Description="@(AlvaStrings.Sprint_NoTaskMatchesThisFilter)" /> }
        </FlareDropZone>
        <div class="alva-plan-hint"><FlareIconView Value="@MaterialDesign3Icons.Regular.DragIndicator" Size="16px" /> @(AlvaStrings.Sprint_DragATaskOntoTheGanttOntoADayOrOntoAPersonSRowHereToReturnItToTheBacklog)</div>
    </section>

    <GanttSprintBoard @ref="_board" Sprint="Sprint" Data="_gantt" People="_people" Range="_axis" RangeChanged="Grow" Focus="_focus" OnTaskChange="TaskChange" OnPeopleChange="PeopleChange"
                      OnLinkCreate="Link" OnLinkRejected="Rejected" OnUnplan="t => Move(t, false)" Suggested="Chosen" />

    <div class="alva-plan-side">
        <section class="alva-panel">
            <header class="alva-panel__header">
                <FlareIconView Value="@MaterialDesign3Icons.Regular.Balance" Size="20px" Class="alva-panel__icon" />
                <div><h2 class="alva-panel__title">@(AlvaStrings.Sprint_SubTeamBalance)</h2><p class="alva-panel__subtitle">@(AlvaStrings.Sprint_SubTeamBalanceSubtitle)</p></div>
            </header>
            <div class="alva-skills">
                @foreach (var (team, plan, avail) in SubTeams)
                {
                    var pct = Pct(plan, avail);
                    var tone = avail <= 0 && plan > 0 ? AlvaTone.Critical : pct > 100 ? AlvaTone.Critical : pct > 85 ? AlvaTone.Info : AlvaTone.Ok;
                    <div class="alva-skill alva-skill--@tone.ToString().ToLowerInvariant()">
                        <div class="alva-skill__head"><b>@team.Name</b><AlvaStatusChip Tone="tone">@(avail > 0 ? $"{pct}%" : AlvaStrings.Sprint_NoPeople) @(tone == AlvaTone.Critical ? AlvaStrings.Common_OverloadShort : tone == AlvaTone.Info ? AlvaStrings.Common_Optimal : AlvaStrings.Sprint_Buffer)</AlvaStatusChip></div>
                        <FlareProgressLinear Value="@Math.Min(100, pct)" Size="TrackSize.Xs" Color="@ToneColor(tone)" aria-label="@string.Format(AlvaStrings.Sprint_SubTeamBalanceAria, team.Name)" />
                        <div class="alva-skill__foot alva-num"><span>@(AlvaStrings.Sprint_Plan) @AlvaFormat.Hours(plan) @(AlvaStrings.Sprint_HoursShort)</span><span class="@(plan > avail ? "alva-kpi__alert" : "alva-kpi__aside--primary")">@(plan > avail ? string.Format(AlvaStrings.Common_DeficitH, AlvaFormat.Hours(plan - avail)) : string.Format(AlvaStrings.Sprint_ReserveH, AlvaFormat.Hours(avail - plan))) (@(AlvaStrings.Sprint_Avail) @AlvaFormat.Hours(avail) @(AlvaStrings.Sprint_HoursShort))</span></div>
                    </div>
                }
                @if (!SubTeams.Any()) { <p class="alva-kpi__note">@(AlvaStrings.Sprint_GivePeopleSubTeamsToSeeTheBalance)</p> }
            </div>
        </section>

        <SprintPeople Sprint="Sprint" Actors="_actors" Capacity="_capacity" Tasks="Tasks" Shift="Shift" @bind-Focus="_focus" OnAssign="AssignPerson" />
    </div>
</FlareDragContext>

@code {
    [Parameter, EditorRequired] public SprintModel Sprint { get; set; } = default!;
    [Parameter] public SprintModel[] Sprints { get; set; } = [];
    [Parameter] public TaskModel[] Tasks { get; set; } = [];
    [Parameter] public EventCallback Changed { get; set; }
    [Parameter] public EventCallback OnParams { get; set; }
    [CascadingParameter] public FlareConfirmDialogProvider? Confirm { get; set; }

    private FlareButton? _paramsButton;
    /// <summary>Возвращает фокус на «Параметры спринта», когда закрыт открытый ею редактор.</summary>
    public ValueTask FocusParams() => _paramsButton?.FocusAsync() ?? ValueTask.CompletedTask;

    private ActorModel[] _actors = [];
    private ProjectModel[] _projects = [];
    private Dictionary<Guid, (decimal Available, decimal Allocated)> _load = [];
    private CapacityDto[] _capacity = [];
    private GanttData? _gantt;
    private GanttSprintBoard? _board;
    private GanttPeopleData? _people;
    private Guid _loadedFor;
    private Guid? _focus;
    private string _poolFilter = "all";
    private string? _search, _error;
    private bool _busy, _balancing;
    private BalanceProposalDto? _proposal;
    private HashSet<Guid> _chosen = [];

    private static readonly (string Mode, string Label, string Hint)[] BalanceModesMenu =
    [
        (BalanceModes.Gentle, AlvaStrings.Sprint_Gentle, AlvaStrings.Sprint_AssigneesOnlyKeepTheDates),
        (BalanceModes.Deadlines, AlvaStrings.Sprint_DatesAndDependencies, AlvaStrings.Sprint_ShiftDatesToMeetTheDeadlineAndRespectTheDependencies),
        (BalanceModes.Maximum, AlvaStrings.Sprint_Maximum, AlvaStrings.Sprint_EverythingAtOncePeopleWithASharedRoleDatesEvenWorkload)
    ];

    private static string ModeName(string mode) => BalanceModesMenu.FirstOrDefault(m => m.Mode == mode).Label ?? mode;

    private static string StatusText(string status) => status switch
    {
        BalanceMath.Optimal => AlvaStrings.Sprint_OrToolsSolverTheBestPlanFoundAndProven,
        BalanceMath.Feasible => AlvaStrings.Sprint_OrToolsSolverTheBestPlanWithinTheTimeGiven,
        BalanceMath.Infeasible => AlvaStrings.Sprint_ConstraintsAreIncompatibleNoFeasiblePlan,
        _ => AlvaStrings.Sprint_SimpleSearch
    };

    /// <summary>Метрики, которые есть до или после; дни и часы рядом, чтобы было видно, что улучшилось.</summary>
    private static IEnumerable<(string Label, decimal Before, decimal After, string Unit)> Metrics(BalanceProposalDto p) => new (string, decimal, decimal, string)[]
    {
        (AlvaStrings.Common_OverloadShort, p.Before.OverloadHours, p.After.OverloadHours, AlvaStrings.Sprint_HoursShort),
        (AlvaStrings.Sprint_MostLoaded, p.Before.PeakOverloadHours, p.After.PeakOverloadHours, AlvaStrings.Sprint_HoursShort),
        (AlvaStrings.Sprint_Overdue, p.Before.LateDays, p.After.LateDays, AlvaStrings.Sprint_DaysShort),
        (AlvaStrings.Sprint_BrokenDependencies, p.Before.LinkViolationDays, p.After.LinkViolationDays, AlvaStrings.Sprint_DaysShort),
        (AlvaStrings.Sprint_AfterTheSprintEnds, p.Before.OverflowHours, p.After.OverflowHours, AlvaStrings.Sprint_HoursShort),
        (AlvaStrings.Sprint_SpreadOfFreeTime, p.Before.SpreadHours, p.After.SpreadHours, AlvaStrings.Sprint_HoursShort),
        (AlvaStrings.Common_Unassigned, p.Before.UnassignedHours, p.After.UnassignedHours, AlvaStrings.Sprint_HoursShort)
    }.Where(m => m.Item2 != 0 || m.Item3 != 0);

    /// <summary>Отмеченные изменения предложения — их показывают призраки и применяет кнопка.</summary>
    private IReadOnlyList<BalanceChangeDto> Chosen => _proposal?.Changes.Where(c => _chosen.Contains(c.TaskId)).ToArray() ?? [];

    /// <summary>Часы спринта, которые отмеченные изменения переносят между людьми.</summary>
    private IReadOnlyDictionary<Guid, decimal> Shift
    {
        get
        {
            var shift = new Dictionary<Guid, decimal>();
            foreach (var change in Chosen.Where(c => c.FromPersonId != c.ToPersonId))
            {
                var hours = Tasks.FirstOrDefault(t => t.Id == change.TaskId)?.EstimateHours ?? 0;
                if (change.FromPersonId is { } from) shift[from] = shift.GetValueOrDefault(from) - hours;
                shift[change.ToPersonId] = shift.GetValueOrDefault(change.ToPersonId) + hours;
            }
            return shift;
        }
    }

    private IEnumerable<SprintModel> Choices => Sprints.Where(s => s.Status != "Completed" || s.Id == Sprint.Id).OrderBy(s => s.StartDate);
    private string SprintLabel(Guid id) => Sprints.FirstOrDefault(s => s.Id == id) is { } s ? $"{s.Name} ({s.StartDate:d MMM}–{s.EndDate:d MMM})" : "";
    // Пул — задачи без плановых дат: в спринт задачу ставят её даты. Порядок — ручной ранг команды, затем приоритет и срок.
    private IEnumerable<TaskModel> Pool => Tasks.Where(t => !t.Planned && t.Status is not ("Done" or "Cancelled"))
        .OrderBy(t => t.BacklogRank ?? int.MaxValue).ThenByDescending(t => Array.IndexOf(Labels.Priorities, t.Priority)).ThenBy(t => t.Deadline ?? DateOnly.MaxValue);
    /// <summary>Готова к плану: оценена и назначена на человека, роль или подкоманду — её можно ставить в спринт без уточнений.</summary>
    private static bool Ready(TaskModel t) => t.EstimateHours > 0 && t.AssignmentTargetId is not null;
    // Задачи спринта считаются один раз на набор задач и спринт: доска спрашивает о них в каждой строке баланса.
    private TaskModel[] InSprint => _inSprint.Tasks == Tasks && _inSprint.Sprint == Sprint.Id ? _inSprint.Value
        : (_inSprint = (Tasks, Sprint.Id, Tasks.Where(t => t.SprintIds.Contains(Sprint.Id) && t.Status != "Cancelled").OrderBy(t => t.Order).ToArray())).Value;
    private (TaskModel[]? Tasks, Guid Sprint, TaskModel[] Value) _inSprint = (null, Guid.Empty, []);
    private decimal Planned => SprintHours.Sum(InSprint, Sprint);
    private decimal Capacity => _load.Values.Sum(l => l.Available);
    // Перегруз по дням: свободные дни спринта не гасят перегруженные (так же считает автобаланс).
    private decimal Overtime => CapacityMath.Overload(_capacity);
    private int OvertimePeople => _capacity.Where(r => r.AllocatedHours > r.AvailableHours).Select(r => r.ActorId).Distinct().Count();
    private static int Pct(decimal part, decimal whole) => whole <= 0 ? 0 : (int)Math.Round(part / whole * 100);
    private static FlareColor ToneColor(AlvaTone tone) => tone switch
    {
        AlvaTone.Critical => FlareColor.Error,
        AlvaTone.Warning => FlareColor.Warning,
        AlvaTone.Info => FlareColor.Primary,
        AlvaTone.Ok => FlareColor.Success,
        _ => FlareColor.OnSurfaceVariant
    };
    private string ProjectName(Guid? id) => _projects.FirstOrDefault(p => p.Id == id)?.Name ?? AlvaStrings.Sprint_Ongoing;

    private IEnumerable<(string Key, string Label)> PoolFilters =>
        new[] { ("all", AlvaStrings.Sprint_All) }
        .Concat(_projects.Where(p => Pool.Any(t => t.ProjectId == p.Id)).Select(p => (p.Id.ToString(), p.Name)))
        .Concat(new[] { ("ready", AlvaStrings.Sprint_ReadyToPlan), ("routine", AlvaStrings.Sprint_Ongoing), ("unassigned", AlvaStrings.Common_Unassigned), ("group", AlvaStrings.Sprint_WithASubTeam) });

    private bool Matches(TaskModel t, string key) => key switch
    {
        "all" => true,
        "ready" => Ready(t),
        "routine" => t.ProjectId is null,
        "unassigned" => Assignees.Person(t, _actors) is null,
        "group" => t.ResolvedPersonId is null && _actors.FirstOrDefault(a => a.Id == t.AssignmentTargetId)?.Kind is "Department",
        _ => t.ProjectId?.ToString() == key
    };

    private bool Found(TaskModel t) => string.IsNullOrWhiteSpace(_search)
        || t.Title.Contains(_search, StringComparison.OrdinalIgnoreCase)
        || AlvaFormat.Code(t.Id).Contains(_search.Trim().TrimStart('#'), StringComparison.OrdinalIgnoreCase);

    private bool DepartmentInTree(Guid departmentId, Guid rootId)
    {
        var departments = _actors.Where(a => a.Kind == "Department").ToDictionary(a => a.Id, a => a.ParentId);
        var seen = new HashSet<Guid>();
        for (Guid? current = departmentId; current is { } id && seen.Add(id); current = departments.GetValueOrDefault(id))
            if (id == rootId) return true;
        return false;
    }

    private bool PersonInDepartmentTree(ActorModel person, Guid rootId) => person.DepartmentIds.Any(id => DepartmentInTree(id, rootId));

    /// <summary>Подкоманды: план — задачи спринта на подкоманду или на её людей; доступно — ёмкость этих людей.</summary>
    private IEnumerable<(ActorModel Team, decimal Plan, decimal Available)> SubTeams => _actors.Where(a => a.Kind == "Department")
        .Select(team =>
        {
            var people = _actors.Where(a => a.Kind == "Person" && PersonInDepartmentTree(a, team.Id)).Select(a => a.Id).ToHashSet();
            var plan = InSprint.Where(t => t.AssignmentTargetId is { } target && DepartmentInTree(target, team.Id)
                || (t.ResolvedPersonId ?? t.AssignmentTargetId) is { } p && people.Contains(p)).Sum(t => SprintHours.Of(t, Sprint));
            var avail = people.Sum(p => _load.TryGetValue(p, out var l) ? l.Available : 0);
            return (team, plan, avail);
        })
        .Where(x => x.plan > 0 || x.avail > 0);

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedFor == Sprint.Id) return;
        try
        {
            _actors = await Session.Get<ActorModel[]>(Session.TeamPath("actors"));
            _projects = await Session.Get<ProjectModel[]>(Session.TeamPath("projects"));
            _loadedFor = Sprint.Id;
            await Refresh(tasks: false);
        }
        catch (Exception e) when (e is HttpRequestException or InvalidOperationException or NotSupportedException) { _error = PageFeedback.Describe(e); }
    }

    /// <summary>После правки: задачи страницы, ёмкость спринта и данные Гантта — всё, что показывает доска. Предложение автобаланса устаревает.</summary>
    private async Task Refresh(bool tasks = true)
    {
        _proposal = null;
        if (tasks) await Changed.InvokeAsync();
        _capacity = await Session.Get<CapacityDto[]>(Session.TeamPath($"capacity?from={Sprint.StartDate:yyyy-MM-dd}&to={Sprint.EndDate:yyyy-MM-dd}"));
        _load = _capacity.GroupBy(r => r.ActorId).ToDictionary(g => g.Key, g => (g.Sum(r => r.AvailableHours), g.Sum(r => r.AllocatedHours)));
        _gantt = await GanttData.Load(Session);
        // Ось доски: спринты плана и всё, до чего уже докрутили; ёмкость — на всё это окно.
        var plan = _gantt.PlanRange(Sprint);
        _axis = _axisFor == Sprint.Id ? new GanttSpan(Min(_axis.Start, plan.Start), Max(_axis.End, plan.End)) : plan;
        _axisFor = Sprint.Id;
        _people = await GanttPeopleData.Load(Session, _gantt, _axis);
    }

    private GanttSpan _axis;
    private Guid? _axisFor;

    /// <summary>Бесконечная ось просит больше времени: ёмкость людей догружается только для добавленных отрезков.</summary>
    private async Task Grow(GanttSpan range)
    {
        _axis = range;
        if (_people is not null) _people = await _people.Extend(Session, range);
    }

    private static DateTime Min(DateTime a, DateTime b) => a < b ? a : b;

    private static DateTime Max(DateTime a, DateTime b) => a > b ? a : b;

    private void Pick(Guid id) => Navigation.NavigateTo($"sprints/{id}/plan");

    private bool FromSprint(object? payload) => payload is TaskDrag t && _gantt?.Tasks.FirstOrDefault(x => x.Id == t.TaskId)?.Planned == true;
    private static bool IsPerson(object? payload) => payload is PersonDrag;

    /// <summary>
    /// Сброс на доске. Задача: в бэклог — выходит из спринта; на день Гантта — входит в спринт этого дня с этим днём начала,
    /// а на строке человека или роли проекции 2 ещё и назначается. Человек: на полосу или карточку — исполнитель задачи.
    /// </summary>
    private Task Drop(FlareDropEventArgs<PlanDrag?> e) => Run(async () =>
    {
        if (_gantt is null || _people is null) return;
        switch (e.Payload)
        {
            case TaskDrag { TaskId: var id } when _gantt.Tasks.FirstOrDefault(t => t.Id == id) is { } task:
                if (e.TargetId == "pool")
                {
                    await _gantt.Unplan(Session, task);
                }
                else if (_board is not null && await _board.ResolveDrop(e.TargetId) is { } cell)
                {
                    var row = cell.RowKey;
                    if (GanttPeopleData.IsGroup(row)) throw new InvalidOperationException(GanttPeopleData.GroupRefusal);
                    var day = DateOnly.FromDateTime(cell.Span.Start);
                    if (GanttData.SprintAt(day, _gantt.PlanSprints(Sprint)) is null)
                        throw new InvalidOperationException(string.Format(AlvaStrings.Sprint_IsNotInAnySprintDropTheTaskOnADayInsideASprint, day.ToString("d MMMM")));
                    await _gantt.Place(Session, task, day);
                    if (GanttPeopleData.IsRowKey(row)) await _people.Reassign(Session, task, row);
                }
                else return;
                break;
            case PersonDrag { PersonId: var person } when TaskOf(e.TargetId) is { } task:
                await _people.Reassign(Session, task, GanttPeopleData.PersonKey(person));
                break;
            default:
                return;
        }
        await Refresh();
    });

    // Задача под человеком: полоса Гантта или карточка бэклога.
    private TaskModel? TaskOf(string targetId) =>
        GanttItemDropTarget.TryParse(targetId, out var item) ? _gantt!.Task(item!.ItemKey)
        : targetId.StartsWith("task:", StringComparison.Ordinal) && Guid.TryParse(targetId[5..], out var id) ? _gantt!.Tasks.FirstOrDefault(t => t.Id == id)
        : null;

    private Task TaskChange(GanttChangeEventArgs args) => Edit(args, () => _gantt!.Apply(Session, args));

    private Task PeopleChange(GanttChangeEventArgs args) => Edit(args, () => _people!.Apply(Session, args));

    private async Task Edit(GanttChangeEventArgs args, Func<Task<string>> save)
    {
        _error = null;
        try { await save(); }
        catch (Exception e) when (e is HttpRequestException or InvalidOperationException or NotSupportedException) { args.Cancel = true; _error = PageFeedback.Describe(e); }
        try { await Refresh(); }
        catch (Exception e) when (e is HttpRequestException or InvalidOperationException or NotSupportedException) { _error ??= e.Message; }
    }

    private Task Link(GanttLinkEventArgs args) => Run(async () =>
    {
        await _gantt!.AddLink(Session, args.Link);
        await Refresh();
    });

    private void Rejected(GanttLinkRejectedEventArgs args) => _error = args.Message;

    /// <summary>
    /// В спринт — задача получает даты с начала спринта (или с сегодняшнего дня, если спринт уже идёт); в пул — теряет
    /// плановые даты. Спринт задачи следует из дат.
    /// </summary>
    /// <summary>Назначение из блока «Люди спринта» без перетаскивания: человек и задача выбраны в диалоге.</summary>
    private Task AssignPerson((Guid PersonId, Guid TaskId) assignment) => Run(async () =>
    {
        if (_people is null) return;
        if (Tasks.FirstOrDefault(t => t.Id == assignment.TaskId) is not { } task) return;
        await _people.Reassign(Session, task, GanttPeopleData.PersonKey(assignment.PersonId));
        await Refresh();
    });

    private Task Move(TaskModel t, bool plan) => Run(async () =>
    {
        if (_gantt is null) return;
        var today = DateOnly.FromDateTime(DateTime.Today);
        if (plan) await _gantt.Place(Session, t, Sprint.StartDate < today && today <= Sprint.EndDate ? today : Sprint.StartDate);
        else await _gantt.Unplan(Session, t);
        await Refresh();
    });

    /// <summary>Просит предложение автобаланса; сервер только считает, план не меняется.</summary>
    private async Task Balance(string mode)
    {
        _balancing = true;
        await Run(async () =>
        {
            var proposal = await Session.Save<BalanceProposalDto>(HttpMethod.Post, Session.TeamPath($"sprints/{Sprint.Id}/balance"), new BalanceRequest(mode));
            _proposal = proposal;
            _chosen = proposal.Changes.Select(c => c.TaskId).ToHashSet();
        });
        _balancing = false;
    }

    /// <summary>Сдвигает задачу в ручном порядке пула и сохраняет весь порядок одной записью.</summary>
    private Task Rerank(TaskModel task, int by) => Run(async () =>
    {
        var order = Pool.ToList();
        var at = order.IndexOf(task);
        if (at < 0 || at + by < 0 || at + by >= order.Count) return;
        order.RemoveAt(at);
        order.Insert(at + by, task);
        await Session.Send(HttpMethod.Put, Session.TeamPath("tasks/backlog-order"), new BacklogOrderRequest([.. order.Select(t => t.Id)]));
        await Refresh();
    });

    private void Choose(Guid taskId, bool on)
    {
        if (on) _chosen.Add(taskId);
        else _chosen.Remove(taskId);
    }

    private void RejectProposal() => _proposal = null;

    /// <summary>Применяет отмеченные изменения одной операцией сервера: все или ни одного, с проверкой версий задач.</summary>
    private async Task ApplyProposal()
    {
        if (!await DestructivePrompt.ConfirmAsync(Confirm, AlvaStrings.Sprint_ApplyChanges,
            string.Format(AlvaStrings.Sprint_ChangesWillBeAppliedTaskDatesAndAssigneesWillChange, Chosen.Count),
            AlvaStrings.Common_Apply)) return;
        await Run(async () =>
        {
            var items = Chosen.Select(c => Tasks.FirstOrDefault(t => t.Id == c.TaskId) is { } task
                    ? new BalanceApplyItem(c.TaskId, task.Version, c.ToStart, c.ToEnd, c.ToTargetId, c.ToPersonId) : null)
                .OfType<BalanceApplyItem>().ToArray();
            await Session.Send(HttpMethod.Post, Session.TeamPath($"sprints/{Sprint.Id}/balance/apply"), new BalanceApplyRequest(items));
            await Refresh();
        });
    }

    private async Task Commit()
    {
        if (!await DestructivePrompt.ConfirmAsync(Confirm, AlvaStrings.Sprint_CommitTheSprint,
            string.Format(AlvaStrings.Sprint_SprintWillStartNowItsScopeAndDatesAreFixedAndItCannotReturnToADraft, Sprint.Name),
            AlvaStrings.Sprint_CommitTheSprint)) return;
        await Run(async () =>
        {
            await Session.Save<SprintModel>(HttpMethod.Put, Session.TeamPath($"sprints/{Sprint.Id}"), new SprintRequest(Sprint.Name, Sprint.Goal, Sprint.StartDate, Sprint.EndDate, "Active"));
            await Changed.InvokeAsync();
        });
    }

    private async Task Run(Func<Task> action)
    {
        _busy = true; _error = null;
        try { await action(); }
        catch (Exception e) when (e is HttpRequestException or InvalidOperationException or NotSupportedException) { _error = PageFeedback.Describe(e); }
        finally { _busy = false; }
    }
}
