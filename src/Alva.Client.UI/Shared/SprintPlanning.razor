@* Sprint planning board: capacity KPIs, backlog, sprint 2D Gantt, skill balance
   and sprint people. Everything is connected by dragging: a task dropped on a Gantt day gets a deadline, on a person's row it also
   gets an assignee; a person dropped on a task becomes its assignee; a task dropped into the backlog leaves the sprint. *@
@using Flare.Components.Gantt
@inject AlvaSession Session
@inject GanttEditGate Edits
@inject NavigationManager Navigation
<FlareGrid Columns="12" AlignItems="FlareAlignItems.Stretch" Gap="FlareSpacing.Large">
    <FlareCol Span="12" Md="8" Lg="8">
<FlareCard Variant="CardVariant.Outlined" Height="100%">
    <FlareCardContent>
    <FlareStack Gap="FlareSpacing.Medium">
    <FlareStack Row Wrap Align="FlareAlignItems.Center" Gap="FlareSpacing.Small">
        <FlareSelect TValue="Guid" Items="Choices.Select(s => s.Id)" ItemLabel="SprintLabel" Value="Sprint.Id" ValueChanged="Pick"
                     InputAttributes="@(new Dictionary<string, object> { ["aria-label"] = AlvaStrings.Gantt_Sprint })" />
        <AlvaStatusChip Tone="@(Sprint.Status == "Planned" ? AlvaTone.Info : AlvaTones.Status(Sprint.Status))">@(Sprint.Status == "Planned" ? AlvaStrings.Sprint_PlanningDraft : Labels.Status(Sprint.Status))</AlvaStatusChip>
        <FlareButton @ref="_paramsButton" Variant="ButtonVariant.Tonal" Size="ButtonSize.Sm" OnClick="() => OnParams.InvokeAsync()">
            <LeadingIcon><FlareIconView Value="@MaterialDesign3Icons.Regular.Tune" Size="18px" /></LeadingIcon>
            <ChildContent>@(AlvaStrings.Sprint_SprintSettings)</ChildContent>
        </FlareButton>
        <FlareButton Href="@($"sprints/{Sprint.Id}")" Variant="ButtonVariant.Outlined" Size="ButtonSize.Sm">@(AlvaStrings.Sprint_SprintPage)</FlareButton>
        @if (Sprint.Status == "Planned")
        {
            <FlareButton Size="ButtonSize.Sm" Variant="ButtonVariant.Outlined" Loading="_busy" OnClick="Commit">
                <LeadingIcon><FlareIconView Value="@MaterialDesign3Icons.Regular.Lock" Size="18px" /></LeadingIcon>
                <ChildContent>@(AlvaStrings.Sprint_CommitTheSprint)</ChildContent>
            </FlareButton>
        }
    </FlareStack>
    <FlareGrid MinColumnWidth="min(100%,12rem)">
        <FlareStat Label="@(AlvaStrings.Sprint_TeamCapacity)" Value="@($"{AlvaFormat.Hours(Capacity)} {AlvaStrings.Sprint_HoursShort}")" Icon="@MaterialDesign3Icons.Regular.Groups" />
        <FlareStat Label="@(AlvaStrings.Sprint_PlannedIntoTheSprint)" Value="@($"{AlvaFormat.Hours(Planned)} {AlvaStrings.Sprint_HoursShort} / {Pct(Planned, Capacity)}%")" Icon="@MaterialDesign3Icons.Regular.FactCheck" />
        <FlareStat Label="@(Capacity >= Planned ? AlvaStrings.Sprint_CapacityReserve : AlvaStrings.Sprint_CapacityShortage)" Value="@($"{AlvaFormat.Hours(Math.Abs(Capacity - Planned))} {AlvaStrings.Sprint_HoursShort}")" Icon="@MaterialDesign3Icons.Regular.HourglassEmpty" />
        <FlareStat Label="@(AlvaStrings.Sprint_Overtime)" Value="@($"{AlvaFormat.Hours(Overtime)} {AlvaStrings.Sprint_HoursShort}")" Caption="@(OvertimePeople > 0 ? $"{OvertimePeople} {AlvaStrings.Common_People}" : null)" Icon="@MaterialDesign3Icons.Regular.Warning" />
    </FlareGrid>
    </FlareStack>
    </FlareCardContent>
</FlareCard>
    </FlareCol>

    <FlareCol Span="12" Md="4" Lg="4">
<FlareCard Variant="CardVariant.Outlined" Height="100%">
    <FlareCardHeader Title="@(AlvaStrings.Sprint_SubTeamBalance)">
        <AvatarContent><FlareIconView Value="@MaterialDesign3Icons.Regular.Balance" Size="20px" /></AvatarContent>
        <ActionContent>
            <FlareMenu Anchor="MenuAnchor.BottomRight" AriaLabel="@(AlvaStrings.Sprint_AutoBalanceMode)">
                <Activator>
                    <FlareButton Variant="ButtonVariant.Tonal" Size="ButtonSize.Sm" Loading="_balancing" Disabled="_busy">
                        <LeadingIcon><FlareIconView Value="@MaterialDesign3Icons.Regular.Balance" Size="18px" /></LeadingIcon>
                        <ChildContent>@(AlvaStrings.Sprint_AutoBalance)</ChildContent>
                    </FlareButton>
                </Activator>
                <ChildContent>
                    @foreach (var (mode, label, hint) in BalanceModesMenu)
                    {
                        <FlareMenuItem OnClick="() => Balance(mode)">
                            <FlareStack Gap="FlareSpacing.None">
                                <FlareText Typo="TypographyScale.LabelMedium">@label</FlareText>
                                <FlareText Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant">@hint</FlareText>
                            </FlareStack>
                        </FlareMenuItem>
                    }
                </ChildContent>
            </FlareMenu>
        </ActionContent>
    </FlareCardHeader>
    <FlareCardContent>
        <FlareStack Gap="FlareSpacing.Small">
        <FlareGrid MinColumnWidth="min(100%,12rem)" Gap="FlareSpacing.Small">
            @foreach (var (team, plan, avail) in SubTeams)
            {
                var pct = Pct(plan, avail);
                var tone = avail <= 0 && plan > 0 ? AlvaTone.Critical : pct > 100 ? AlvaTone.Critical : pct > 85 ? AlvaTone.Info : AlvaTone.Ok;
                <FlarePaper Outlined="true" Padding="FlareSpacing.Small">
                    <FlareStack Gap="FlareSpacing.XSmall">
                        <FlareStack Row Wrap Align="FlareAlignItems.Start" Justify="FlareJustifyContent.SpaceBetween" Gap="FlareSpacing.XSmall">
                            <FlareText Typo="TypographyScale.LabelMedium">@team.Name</FlareText>
                            <AlvaStatusChip Tone="tone">@(avail > 0 ? $"{pct}%" : AlvaStrings.Sprint_NoPeople) @(tone == AlvaTone.Critical ? AlvaStrings.Common_OverloadShort : tone == AlvaTone.Info ? AlvaStrings.Common_Optimal : AlvaStrings.Sprint_Buffer)</AlvaStatusChip>
                        </FlareStack>
                        <FlareProgressLinear Value="@Math.Min(100, pct)" Size="TrackSize.Xs" Color="@ToneColor(tone)" aria-label="@string.Format(AlvaStrings.Sprint_SubTeamBalanceAria, team.Name)" />
                        <FlareStack Row Wrap Justify="FlareJustifyContent.SpaceBetween" Gap="FlareSpacing.XSmall">
                            <FlareText Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant">@(AlvaStrings.Sprint_Plan) @AlvaFormat.Hours(plan) @(AlvaStrings.Sprint_HoursShort)</FlareText>
                            <FlareText Typo="TypographyScale.LabelSmall" Color="@(plan > avail ? FlareColor.Error : FlareColor.Primary)">@(plan > avail ? string.Format(AlvaStrings.Common_DeficitH, AlvaFormat.Hours(plan - avail)) : string.Format(AlvaStrings.Sprint_ReserveH, AlvaFormat.Hours(avail - plan))) (@(AlvaStrings.Sprint_Avail) @AlvaFormat.Hours(avail) @(AlvaStrings.Sprint_HoursShort))</FlareText>
                        </FlareStack>
                    </FlareStack>
                </FlarePaper>
            }
        </FlareGrid>
        </FlareStack>
    </FlareCardContent>
</FlareCard>
    </FlareCol>
</FlareGrid>
<PageFeedback Error="@_error" />

@if (_proposal is { } proposal)
{
    <FlareCard Variant="CardVariant.Outlined" aria-live="polite">
        <FlareCardHeader Title="@($"{AlvaStrings.Sprint_AutoBalanceRecommendation} {ModeName(proposal.Mode)}")"
                         Subtitle="@($"{StatusText(proposal.Status)}{(proposal.Note is { } note ? $" - {note}" : "")}")">
            <AvatarContent><FlareIconView Value="@MaterialDesign3Icons.Regular.Balance" Size="20px" /></AvatarContent>
            <ActionContent>
                <FlareStack Row Wrap Gap="FlareSpacing.Small">
                    @if (proposal.Changes.Length > 0)
                    {
                        <FlareButton Size="ButtonSize.Sm" Loading="_busy" Disabled="Chosen.Count == 0" OnClick="ApplyProposal">@(AlvaStrings.Sprint_ApplySelected) (@Chosen.Count)</FlareButton>
                    }
                    <FlareButton Size="ButtonSize.Sm" Variant="ButtonVariant.Outlined" Disabled="_busy" OnClick="RejectProposal">@(proposal.Changes.Length > 0 ? AlvaStrings.Sprint_Reject : AlvaStrings.Common_Close)</FlareButton>
                </FlareStack>
            </ActionContent>
        </FlareCardHeader>
        <FlareCardContent>
        <FlareStack Gap="FlareSpacing.Medium">
        <FlareGrid MinColumnWidth="min(100%,11rem)">
            @foreach (var (label, before, after, unit) in Metrics(proposal))
            {
                <FlarePaper Outlined="true" Padding="FlareSpacing.Small">
                    <FlareStack Gap="FlareSpacing.XXSmall">
                        <FlareText Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant">@label</FlareText>
                        <FlareText Typo="TypographyScale.BodySmall"><s>@AlvaFormat.Hours(before)</s> -> @AlvaFormat.Hours(after) @unit</FlareText>
                    </FlareStack>
                </FlarePaper>
            }
        </FlareGrid>
        @* The calculation does not move everything: in-progress, parent, unestimated or unassigned tasks stay as they are. *@
        <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@(AlvaStrings.Sprint_TasksConsidered) @proposal.Considered@(proposal.Excluded is { Length: > 0 } skipped ? $", {AlvaStrings.Sprint_LeftOut} {skipped.Length}" : "")</FlareText>
        @if (proposal.Excluded is { Length: > 0 } excluded)
        {
            <FlareAccordion>
                <FlareAccordionPanel Header="@(AlvaStrings.Sprint_WhyTasksWereLeftOut)">
                    <FlareStack Gap="FlareSpacing.XSmall">
                        @foreach (var item in excluded)
                        {
                            <FlareStack Row Wrap Align="FlareAlignItems.Center" Gap="FlareSpacing.Small" @key="item.TaskId">
                                <FlareLink Href="@($"tasks/{item.TaskId}")">@item.Title</FlareLink>
                                <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@ReasonText.Describe(item.Reason)</FlareText>
                            </FlareStack>
                        }
                    </FlareStack>
                </FlareAccordionPanel>
            </FlareAccordion>
        }
        @if (proposal.Changes.Length == 0)
        {
            <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@(proposal.Status == BalanceMath.Infeasible
                ? AlvaStrings.Sprint_NoFeasiblePlanFixedDatesAndLinksContradictEachOther
                : proposal.Excluded is { Length: > 0 } ? AlvaStrings.Sprint_NoImprovementAmongTheTasksConsideredTheTasksTheCalculationDidNotTouchAre_277646 : AlvaStrings.Sprint_ThePlanIsAlreadyBalancedInThisModeNothingToChange)</FlareText>
        }
        else
        {
            <FlareGrid MinColumnWidth="min(100%,22rem)">
                @foreach (var change in proposal.Changes)
                {
                    <FlarePaper Outlined="true" Padding="FlareSpacing.Small" @key="change.TaskId">
                        <FlareStack Row Align="FlareAlignItems.Start" Gap="FlareSpacing.Small">
                            <FlareCheckbox TValue="bool" Value="_chosen.Contains(change.TaskId)" ValueChanged="(bool on) => Choose(change.TaskId, on)"
                                           AriaLabel="@string.Format(AlvaStrings.Sprint_ApplyTheChange, change.Title)" />
                            <FlareStack Gap="FlareSpacing.XXSmall">
                                <FlareLink Href="@($"tasks/{change.TaskId}")">@change.Title</FlareLink>
                                @if (change.FromPersonId != change.ToPersonId)
                                {
                                    <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@(change.FromPersonName ?? AlvaStrings.Sprint_Nobody) -> @change.ToPersonName</FlareText>
                                }
                                @if (change.FromStart != change.ToStart || change.FromEnd != change.ToEnd)
                                {
                                    <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@AlvaFormat.Period(change.FromStart, change.FromEnd) -> @AlvaFormat.Period(change.ToStart, change.ToEnd)</FlareText>
                                }
                                <FlareText Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant">@ReasonText.Join(change.Reasons)</FlareText>
                            </FlareStack>
                        </FlareStack>
                    </FlarePaper>
                }
            </FlareGrid>
        }
        </FlareStack>
        </FlareCardContent>
    </FlareCard>
}

<FlareDragContext TPayload="PlanDrag" Group="plan" OnDrop="Drop" OnDragStart="SuppressTaskOpen" OnDragEnd="EndDrag">
    <FlareGrid Columns="12" AlignItems="FlareAlignItems.Start" Gap="FlareSpacing.Large">
        @* The chart is the working surface: it takes the width, while the pool and the people
           blocks share one narrow rail. *@
        <FlareCol Span="12" Md="8" Lg="9" Xl="10">
            <GanttSprintBoard @ref="_board" Sprint="Sprint" Data="_gantt" People="_people" Range="_axis" RangeChanged="Grow" Focus="_focus" OnTaskChange="TaskChange" OnPeopleChange="PeopleChange"
                              OnLinkCreate="Link" OnLinkRejected="Rejected" OnItemClick="OpenTask" OnUnplan="t => Move(t, false)" Suggested="Chosen" />
        </FlareCol>

        <FlareCol Span="12" Md="4" Lg="3" Xl="2">
            <FlareStack Gap="FlareSpacing.Large">
            <FlareCard Variant="CardVariant.Outlined">
                <FlareCardHeader Title="@(AlvaStrings.Sprint_TaskPoolBacklog)">
                    <AvatarContent><FlareIconView Value="@MaterialDesign3Icons.Regular.Inventory2" Size="20px" /></AvatarContent>
                    <ActionContent><FlareChip Variant="ChipVariant.Filled" Color="FlareColor.Primary" Size="ChipSize.Sm">@Pool.Count()</FlareChip></ActionContent>
                </FlareCardHeader>
                <FlareCardContent>
                    <FlareStack Gap="FlareSpacing.Small">
                        <FlareChipGroup SelectedValues="PoolFilterValues" SelectedValuesChanged="SetPoolFilter" AriaLabel="@(AlvaStrings.Sprint_PoolFilter)">
                            @foreach (var (key, label) in PoolFilters)
                            {
                                <FlareChip Value="@key" Label="@($"{label} ({Pool.Count(t => Matches(t, key))})")" />
                            }
                        </FlareChipGroup>
                        <FlareTextField @bind-Value="_search" Immediate Clearable Placeholder="@(AlvaStrings.Sprint_SearchByCodeOrTitle)" AriaLabel="@(AlvaStrings.Sprint_SearchThePool)">
                            <AdornmentStart><FlareIconView Value="@MaterialDesign3Icons.Regular.Search" Size="18px" /></AdornmentStart>
                        </FlareTextField>
                        <FlareDropZone Target="pool" Accepts="FromSprint">
                            <FlareStack Gap="FlareSpacing.Small" MaxHeight="26rem" Overflow="auto">
                                @foreach (var task in Pool.Where(t => Matches(t, _poolFilter) && Found(t)))
                                {
                                    <FlareDropZone Target="@($"task:{task.Id}")" Accepts="AcceptsOnCard" @key="task.Id">
                                        <FlareDraggable Payload="@(new TaskDrag(task.Id))">
                                            <FlareCard Variant="CardVariant.Outlined" OnClick="() => OpenTask(task)">
                                            <FlareCardContent>
                                                <FlareStack Gap="FlareSpacing.XSmall">
                                                    <FlareStack Row Wrap Align="FlareAlignItems.Center" Gap="FlareSpacing.Small">
                                                        <FlareText Typo="TypographyScale.LabelMedium" Color="FlareColor.Primary">@AlvaFormat.Code(task.Id)</FlareText>
                                                        <FlareChip Size="ChipSize.Xs">@ProjectName(task.ProjectId)</FlareChip>
                                                        @if (task.Priority != "Normal") { <AlvaStatusChip Tone="AlvaTones.Priority(task.Priority)">@Labels.Priority(task.Priority)</AlvaStatusChip> }
                                                        <FlareSpacer />
                                                        <FlareText Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant"><FlareIconView Value="@MaterialDesign3Icons.Regular.Schedule" Size="15px" /> @(task.EstimateHours.HasValue ? $"{AlvaFormat.Hours(task.EstimateHours.Value)} {AlvaStrings.Sprint_HoursShort}" : "-")</FlareText>
                                                    </FlareStack>
                                                    <FlareText Typo="TypographyScale.BodyMedium">@task.Title</FlareText>
                                                    <FlareStack Row Wrap Align="FlareAlignItems.Center" Gap="FlareSpacing.Small">
                                                        <AlvaAssignee Task="task" Actors="_actors" />
                                                        <FlareSpacer />
                                                        <FlareText Typo="TypographyScale.LabelSmall" Color="FlareColor.OnSurfaceVariant">@(task.Deadline.HasValue ? task.Deadline.Value.ToString("d MMM") : AlvaStrings.Sprint_NoDeadline)</FlareText>
                                                        @if (!Ready(task)) { <FlareText Typo="TypographyScale.LabelSmall" Color="FlareColor.Error" title="@(AlvaStrings.Sprint_NeedsAnEstimateAndAnAssigneeOrRole)">@(AlvaStrings.Sprint_NotReady)</FlareText> }
                                                        <FlareStack Row Gap="FlareSpacing.None">
                                                            <FlareIconButton Icon="@MaterialDesign3Icons.Regular.ArrowUpward" Size="ButtonSize.Sm" AriaLabel="@($"{AlvaStrings.Sprint_MoveUpInThePool}: {task.Title}")" Disabled="@(_busy || task == Pool.First())" OnClick="() => Rerank(task, -1)" />
                                                            <FlareIconButton Icon="@MaterialDesign3Icons.Regular.ArrowDownward" Size="ButtonSize.Sm" AriaLabel="@($"{AlvaStrings.Sprint_MoveDownInThePool}: {task.Title}")" Disabled="@(_busy || task == Pool.Last())" OnClick="() => Rerank(task, 1)" />
                                                        </FlareStack>
                                                        <FlareButton Size="ButtonSize.Sm" Variant="ButtonVariant.Tonal" Disabled="_busy" OnClick="() => Move(task, true)">@(AlvaStrings.Sprint_IntoSprint)</FlareButton>
                                                    </FlareStack>
                                                </FlareStack>
                                            </FlareCardContent>
                                            </FlareCard>
                                        </FlareDraggable>
                                    </FlareDropZone>
                                }
                                @if (!Pool.Any(t => Matches(t, _poolFilter) && Found(t))) { <FlareEmptyState Compact Title="@(AlvaStrings.Sprint_ThePoolIsEmpty)" Description="@(AlvaStrings.Sprint_NoTaskMatchesThisFilter)" /> }
                            </FlareStack>
                        </FlareDropZone>
                    </FlareStack>
                </FlareCardContent>
            </FlareCard>

            <SprintPeople Sprint="Sprint" Actors="_actors" Capacity="_capacity" Tasks="Tasks" Shift="Shift" @bind-Focus="_focus" OnAssign="AssignPerson" />
            </FlareStack>
        </FlareCol>
    </FlareGrid>
</FlareDragContext>
<SkillIssues Tasks="InSprint" Actors="_actors" />

<FlareDrawer Anchor="DrawerAnchor.Right" Open="_taskPanelOpen" OpenChanged="OnTaskPanelOpen" Width="34rem" ContentPadding="FlareSpacing.Large" AriaLabel="@(AlvaStrings.Common_Task)">
    @if (_openTask is not null)
    {
        <TaskDetails @ref="_taskDetails" Item="_openTask" Tasks="Tasks" Projects="_projects" Sprints="Sprints" Actors="_actors" Changed="OnTaskChanged" HeadingLevel="2" Compact="true" />
    }
</FlareDrawer>

@code {
    [Parameter, EditorRequired] public SprintModel Sprint { get; set; } = default!;
    [Parameter] public SprintModel[] Sprints { get; set; } = [];
    [Parameter] public TaskModel[] Tasks { get; set; } = [];
    [Parameter] public EventCallback Changed { get; set; }
    [Parameter] public EventCallback OnParams { get; set; }
    [CascadingParameter] public FlareConfirmDialogProvider? Confirm { get; set; }

    private FlareButton? _paramsButton;
    /// <summary>Returns focus to the sprint settings button when the editor it opened is closed.</summary>
    public ValueTask FocusParams() => _paramsButton?.FocusAsync() ?? ValueTask.CompletedTask;

    private ActorModel[] _actors = [];
    private ProjectModel[] _projects = [];
    private Dictionary<Guid, (decimal Available, decimal Allocated)> _load = [];
    private CapacityDto[] _capacity = [];
    private GanttData? _gantt;
    private GanttSprintBoard? _board;
    private GanttPeopleData? _people;
    private Guid _loadedFor;
    private Guid? _focus;
    private string _poolFilter = "all";
    private IReadOnlyCollection<string> PoolFilterValues => [_poolFilter];
    private void SetPoolFilter(IReadOnlyCollection<string> values) => _poolFilter = values.FirstOrDefault() ?? "all";
    private string? _search, _error;
    private bool _busy, _balancing;
    private BalanceProposalDto? _proposal;
    private HashSet<Guid> _chosen = [];
    private TaskModel? _openTask;
    private TaskDetails? _taskDetails;
    private bool _taskPanelOpen;
    private DateTime _suppressTaskOpenUntil;

    private static readonly (string Mode, string Label, string Hint)[] BalanceModesMenu =
    [
        (BalanceModes.Gentle, AlvaStrings.Sprint_Gentle, AlvaStrings.Sprint_AssigneesOnlyKeepTheDates),
        (BalanceModes.Deadlines, AlvaStrings.Sprint_DatesAndDependencies, AlvaStrings.Sprint_ShiftDatesToMeetTheDeadlineAndRespectTheDependencies),
        (BalanceModes.Maximum, AlvaStrings.Sprint_Maximum, AlvaStrings.Sprint_EverythingAtOncePeopleWithASharedRoleDatesEvenWorkload)
    ];

    private static string ModeName(string mode) => BalanceModesMenu.FirstOrDefault(m => m.Mode == mode).Label ?? mode;

    private static string StatusText(string status) => status switch
    {
        BalanceMath.Optimal => AlvaStrings.Sprint_OrToolsSolverTheBestPlanFoundAndProven,
        BalanceMath.Feasible => AlvaStrings.Sprint_OrToolsSolverTheBestPlanWithinTheTimeGiven,
        BalanceMath.Infeasible => AlvaStrings.Sprint_ConstraintsAreIncompatibleNoFeasiblePlan,
        _ => AlvaStrings.Sprint_SimpleSearch
    };

    /// <summary>Metrics present before or after; days and hours are shown next to them so it is visible what improved.</summary>
    private static IEnumerable<(string Label, decimal Before, decimal After, string Unit)> Metrics(BalanceProposalDto p) => new (string, decimal, decimal, string)[]
    {
        (AlvaStrings.Common_OverloadShort, p.Before.OverloadHours, p.After.OverloadHours, AlvaStrings.Sprint_HoursShort),
        (AlvaStrings.Sprint_MostLoaded, p.Before.PeakOverloadHours, p.After.PeakOverloadHours, AlvaStrings.Sprint_HoursShort),
        (AlvaStrings.Sprint_Overdue, p.Before.LateDays, p.After.LateDays, AlvaStrings.Sprint_DaysShort),
        (AlvaStrings.Sprint_BrokenDependencies, p.Before.LinkViolationDays, p.After.LinkViolationDays, AlvaStrings.Sprint_DaysShort),
        (AlvaStrings.Sprint_AfterTheSprintEnds, p.Before.OverflowHours, p.After.OverflowHours, AlvaStrings.Sprint_HoursShort),
        (AlvaStrings.Sprint_SpreadOfFreeTime, p.Before.SpreadHours, p.After.SpreadHours, AlvaStrings.Sprint_HoursShort),
        (AlvaStrings.Common_Unassigned, p.Before.UnassignedHours, p.After.UnassignedHours, AlvaStrings.Sprint_HoursShort)
    }.Where(m => m.Item2 != 0 || m.Item3 != 0);

    /// <summary>Selected changes of the proposal - they are shown as ghosts and applied by the button.</summary>
    private IReadOnlyList<BalanceChangeDto> Chosen => _proposal?.Changes.Where(c => _chosen.Contains(c.TaskId)).ToArray() ?? [];

    /// <summary>Sprint hours that the selected changes move between people.</summary>
    private IReadOnlyDictionary<Guid, decimal> Shift
    {
        get
        {
            var shift = new Dictionary<Guid, decimal>();
            foreach (var change in Chosen.Where(c => c.FromPersonId != c.ToPersonId))
            {
                var hours = Tasks.FirstOrDefault(t => t.Id == change.TaskId)?.EstimateHours ?? 0;
                if (change.FromPersonId is { } from) shift[from] = shift.GetValueOrDefault(from) - hours;
                shift[change.ToPersonId] = shift.GetValueOrDefault(change.ToPersonId) + hours;
            }
            return shift;
        }
    }

    private IEnumerable<SprintModel> Choices => Sprints.Where(s => s.Status != "Completed" || s.Id == Sprint.Id).OrderBy(s => s.StartDate);
    private string SprintLabel(Guid id) => Sprints.FirstOrDefault(s => s.Id == id) is { } s ? $"{s.Name} ({s.StartDate:d MMM}–{s.EndDate:d MMM})" : "";
    // The pool is tasks without planned dates: a task enters the sprint through its dates. Order is the team's manual rank, then priority and deadline.
    private IEnumerable<TaskModel> Pool => Tasks.Where(t => !t.Planned && t.Status is not ("Done" or "Cancelled"))
        .OrderBy(t => t.BacklogRank ?? int.MaxValue).ThenByDescending(t => Array.IndexOf(Labels.Priorities, t.Priority)).ThenBy(t => t.Deadline ?? DateOnly.MaxValue);
    /// <summary>Ready for planning: estimated and assigned to a person, skill or sub-team - it can be put into the sprint without clarification.</summary>
    private static bool Ready(TaskModel t) => t.EstimateHours > 0 && t.AssignmentTargetId is not null;
    // Sprint tasks are computed once per task set and sprint: the board asks about them in every balance row.
    private TaskModel[] InSprint => _inSprint.Tasks == Tasks && _inSprint.Sprint == Sprint.Id ? _inSprint.Value
        : (_inSprint = (Tasks, Sprint.Id, Tasks.Where(t => t.SprintIds.Contains(Sprint.Id) && t.Status != "Cancelled").OrderBy(t => t.Order).ToArray())).Value;
    private (TaskModel[]? Tasks, Guid Sprint, TaskModel[] Value) _inSprint = (null, Guid.Empty, []);
    private decimal Planned => SprintHours.Sum(InSprint, Sprint);
    private decimal Capacity => _load.Values.Sum(l => l.Available);
    // Overload by day: free days of the sprint do not offset overloaded ones (auto-balance counts the same way).
    private decimal Overtime => CapacityMath.Overload(_capacity);
    private int OvertimePeople => _capacity.Where(r => r.AllocatedHours > r.AvailableHours).Select(r => r.ActorId).Distinct().Count();
    private static int Pct(decimal part, decimal whole) => whole <= 0 ? 0 : (int)Math.Round(part / whole * 100);
    private static FlareColor ToneColor(AlvaTone tone) => tone switch
    {
        AlvaTone.Critical => FlareColor.Error,
        AlvaTone.Warning => FlareColor.Warning,
        AlvaTone.Info => FlareColor.Primary,
        AlvaTone.Ok => FlareColor.Success,
        _ => FlareColor.OnSurfaceVariant
    };
    private string ProjectName(Guid? id) => _projects.FirstOrDefault(p => p.Id == id)?.Name ?? AlvaStrings.Sprint_Ongoing;

    private IEnumerable<(string Key, string Label)> PoolFilters =>
        [("all", AlvaStrings.Sprint_All), ("ready", AlvaStrings.Sprint_ReadyToPlan)];

    private static bool Matches(TaskModel t, string key) => key switch
    {
        "ready" => Ready(t),
        _ => true
    };

    private bool Found(TaskModel t) => string.IsNullOrWhiteSpace(_search)
        || t.Title.Contains(_search, StringComparison.OrdinalIgnoreCase)
        || AlvaFormat.Code(t.Id).Contains(_search.Trim().TrimStart('#'), StringComparison.OrdinalIgnoreCase);

    private bool DepartmentInTree(Guid departmentId, Guid rootId)
    {
        var departments = _actors.Where(a => a.Kind == "Department").ToDictionary(a => a.Id, a => a.ParentId);
        var periods = _actors.Where(a => a.Kind == "Department").ToDictionary(a => a.Id,
            a => a.DepartmentParentPeriods.Select(p => new DepartmentParentPeriodDto(p.Id, p.ParentId, p.From, p.To)).ToArray());
        var seen = new HashSet<Guid>();
        for (Guid? current = departmentId; current is { } id && seen.Add(id);
             current = DepartmentHierarchy.ParentOf(periods.GetValueOrDefault(id), id, Sprint.StartDate, departments.GetValueOrDefault(id)))
            if (id == rootId) return true;
        return false;
    }

    private bool PersonInDepartmentTree(ActorModel person, Guid rootId)
    {
        var day = Sprint.StartDate;
        var active = person.DepartmentMemberships.Where(m => m.From <= day && (m.To is null || day <= m.To)).Select(m => m.DepartmentId).ToArray();
        return (active.Length > 0 ? active : person.DepartmentIds).Any(id => DepartmentInTree(id, rootId));
    }

    /// <summary>Sub-teams: plan - sprint tasks for the sub-team or its people; available - capacity of those people.</summary>
    private IEnumerable<(ActorModel Team, decimal Plan, decimal Available)> SubTeams => _actors.Where(a => a.Kind == "Department")
        .Select(team =>
        {
            var people = _actors.Where(a => a.Kind == "Person" && PersonInDepartmentTree(a, team.Id)).Select(a => a.Id).ToHashSet();
            var plan = InSprint.Where(t => t.AssignmentTargetId is { } target && DepartmentInTree(target, team.Id)
                || (t.ResolvedPersonId ?? t.AssignmentTargetId) is { } p && people.Contains(p)).Sum(t => SprintHours.Of(t, Sprint));
            var avail = people.Sum(p => _load.TryGetValue(p, out var l) ? l.Available : 0);
            return (team, plan, avail);
        })
        .Where(x => x.plan > 0 || x.avail > 0);

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedFor == Sprint.Id) return;
        try
        {
            _actors = await Session.Get<ActorModel[]>(Session.TeamPath("actors"));
            _projects = await Session.Get<ProjectModel[]>(Session.TeamPath("projects"));
            _loadedFor = Sprint.Id;
            await Refresh(tasks: false);
        }
        catch (Exception e) when (e is HttpRequestException or InvalidOperationException or NotSupportedException) { _error = PageFeedback.Describe(e); }
    }

    /// <summary>After an edit: page tasks, sprint capacity and Gantt data - everything the board shows. The auto-balance proposal becomes stale.</summary>
    private async Task Refresh(bool tasks = true)
    {
        _proposal = null;
        if (tasks) await Changed.InvokeAsync();
        _capacity = await Session.Get<CapacityDto[]>(Session.TeamPath($"capacity?from={Sprint.StartDate:yyyy-MM-dd}&to={Sprint.EndDate:yyyy-MM-dd}"));
        _load = _capacity.GroupBy(r => r.ActorId).ToDictionary(g => g.Key, g => (g.Sum(r => r.AvailableHours), g.Sum(r => r.AllocatedHours)));
        _gantt = await GanttData.Load(Session);
        // Board axis: the plan's sprints and everything already scrolled to; capacity covers this whole window.
        var plan = _gantt.PlanRange(Sprint);
        _axis = _axisFor == Sprint.Id ? new GanttSpan(Min(_axis.Start, plan.Start), Max(_axis.End, plan.End)) : plan;
        _axisFor = Sprint.Id;
        _people = await GanttPeopleData.Load(Session, _gantt, _axis);
    }

    private GanttSpan _axis;
    private Guid? _axisFor;

    /// <summary>The endless axis asks for more time: people's capacity is loaded only for the added segments.</summary>
    private async Task Grow(GanttSpan range)
    {
        _axis = range;
        if (_people is not null) _people = await _people.Extend(Session, range);
    }

    private static DateTime Min(DateTime a, DateTime b) => a < b ? a : b;

    private static DateTime Max(DateTime a, DateTime b) => a > b ? a : b;

    private void Pick(Guid id) => Navigation.NavigateTo($"sprints/{id}/plan");

    private bool FromSprint(object? payload) => payload is TaskDrag t && _gantt?.Tasks.FirstOrDefault(x => x.Id == t.TaskId)?.Planned == true;
    // A pool card takes a person (assign) and a task (return to the pool), so every card is a drop target during both drags.
    private static bool AcceptsOnCard(object? payload) => payload is PersonDrag or TaskDrag;

    /// <summary>
    /// Drop on the board. Task: into the backlog - leaves the sprint; onto a Gantt day - joins the sprint of that day with that start
    /// date, and on a person or skill row of projection 2 it is also assigned. Person: onto a bar or card - the task's assignee.
    /// </summary>
    private Task Drop(FlareDropEventArgs<PlanDrag?> e) => Run(async () =>
    {
        if (_gantt is null || _people is null) return;
        switch (e.Payload)
        {
            case TaskDrag { TaskId: var id } when _gantt.Tasks.FirstOrDefault(t => t.Id == id) is { } task:
                if (e.TargetId == "pool" || e.TargetId.StartsWith("task:", StringComparison.Ordinal))
                {
                    await _gantt.Unplan(Session, task);
                }
                else if (_board is not null && await _board.ResolveDrop(e.TargetId) is { } cell)
                {
                    var row = cell.RowKey;
                    if (GanttPeopleData.IsGroup(row)) throw new InvalidOperationException(GanttPeopleData.GroupRefusal);
                    var day = DateOnly.FromDateTime(cell.Span.Start);
                    if (GanttData.SprintAt(day, _gantt.PlanSprints(Sprint)) is null)
                        throw new InvalidOperationException(string.Format(AlvaStrings.Sprint_IsNotInAnySprintDropTheTaskOnADayInsideASprint, day.ToString("d MMMM")));
                    await _gantt.Place(Session, task, day);
                    if (GanttPeopleData.IsRowKey(row)) await _people.Reassign(Session, task, row);
                }
                else return;
                break;
            case PersonDrag { PersonId: var person } when TaskOf(e.TargetId) is { } task:
                await _people.Reassign(Session, task, GanttPeopleData.PersonKey(person));
                break;
            default:
                return;
        }
        await Refresh();
    });

    // A task under a person: a Gantt bar or a backlog card.
    private TaskModel? TaskOf(string targetId) =>
        GanttItemDropTarget.TryParse(targetId, out var item) ? _gantt!.Task(item!.ItemKey)
        : targetId.StartsWith("task:", StringComparison.Ordinal) && Guid.TryParse(targetId[5..], out var id) ? _gantt!.Tasks.FirstOrDefault(t => t.Id == id)
        : null;

    private Task TaskChange(GanttChangeEventArgs args) => Edit(args, () => _gantt!.Apply(Session, args));

    private Task PeopleChange(GanttChangeEventArgs args) => Edit(args, () => _people!.Apply(Session, args));

    private async Task Edit(GanttChangeEventArgs args, Func<Task<string>> save)
    {
        // Flare can report the same pointer gesture twice while its script is attached twice (FLARE TASK-808).
        if (!Edits.TryTake(args.ItemKey)) { args.Cancel = true; return; }
        _error = null;
        try
        {
            // The saved task carries its new dates, version and assignee: update locally instead of reloading the
            // page, so a successful drag has no loading bar and no flicker.
            await save();
            _proposal = null;
            SyncTasks();
            await RefreshCapacityOnly();
        }
        catch (Exception e) when (e is HttpRequestException or InvalidOperationException or NotSupportedException)
        {
            args.Cancel = true;
            _error = PageFeedback.Describe(e);
            try { await Refresh(); }
            catch (Exception reload) when (reload is HttpRequestException or InvalidOperationException or NotSupportedException) { _error ??= reload.Message; }
        }
    }

    /// <summary>Copies the fields a Gantt write changed back to the page's task array, so no reload is needed.</summary>
    private void SyncTasks()
    {
        if (_gantt is null) return;
        foreach (var source in _gantt.Tasks)
            if (Tasks.FirstOrDefault(t => t.Id == source.Id) is { } target)
            {
                target.StartDate = source.StartDate;
                target.EndDate = source.EndDate;
                target.Version = source.Version;
                target.SprintIds = source.SprintIds;
                target.AssignmentTargetId = source.AssignmentTargetId;
                target.ResolvedPersonId = source.ResolvedPersonId;
            }
    }

    /// <summary>Capacity and the people projection in the background: no skeleton and no page-wide reload.</summary>
    private async Task RefreshCapacityOnly()
    {
        try
        {
            _capacity = await Session.Get<CapacityDto[]>(Session.TeamPath($"capacity?from={Sprint.StartDate:yyyy-MM-dd}&to={Sprint.EndDate:yyyy-MM-dd}"));
            _load = _capacity.GroupBy(r => r.ActorId).ToDictionary(g => g.Key, g => (g.Sum(r => r.AvailableHours), g.Sum(r => r.AllocatedHours)));
            if (_gantt is not null) _people = await GanttPeopleData.Load(Session, _gantt, _axis);
            StateHasChanged();
        }
        catch (Exception e) when (e is HttpRequestException or InvalidOperationException)
        {
            _error ??= PageFeedback.Describe(e);
        }
    }

    private Task Link(GanttLinkEventArgs args) => Run(async () =>
    {
        await _gantt!.AddLink(Session, args.Link);
        await Refresh();
    });

    private void Rejected(GanttLinkRejectedEventArgs args) => _error = args.Message;

    /// <summary>
    /// Into the sprint - the task gets dates from the sprint start (or from today if the sprint is already running); into the pool - loses
    /// its planned dates. The task's sprint follows from the dates.
    /// </summary>
    /// <summary>Assignment from the Sprint people block without dragging: the person and task are chosen in a dialog.</summary>
    private Task AssignPerson((Guid PersonId, Guid TaskId) assignment) => Run(async () =>
    {
        if (_people is null) return;
        if (Tasks.FirstOrDefault(t => t.Id == assignment.TaskId) is not { } task) return;
        await _people.Reassign(Session, task, GanttPeopleData.PersonKey(assignment.PersonId));
        await Refresh();
    });

    /// <summary>A click on a pool card opens the task without leaving the board; a drag that just ended does not.</summary>
    private void OpenTask(TaskModel task)
    {
        if (DateTime.UtcNow < _suppressTaskOpenUntil) return;
        _openTask = task;
        _taskPanelOpen = true;
    }

    private void SuppressTaskOpen(PlanDrag _) => _suppressTaskOpenUntil = DateTime.MaxValue;

    private void EndDrag() => _suppressTaskOpenUntil = DateTime.UtcNow.AddMilliseconds(300);

    private async Task OnTaskPanelOpen(bool open)
    {
        if (!open && _taskDetails?.Dirty == true && !await DraftPrompt.CanDiscardAsync(Confirm, true))
        {
            _taskPanelOpen = true;
            StateHasChanged();
            return;
        }
        _taskPanelOpen = open;
        if (open) return;
        _openTask = null;
        _taskDetails = null;
    }

    private Task OnTaskChanged() => Run(() => Refresh());

    private Task Move(TaskModel t, bool plan) => Run(async () =>
    {
        if (_gantt is null) return;
        var today = DateOnly.FromDateTime(DateTime.Today);
        if (plan) await _gantt.Place(Session, t, Sprint.StartDate < today && today <= Sprint.EndDate ? today : Sprint.StartDate);
        else await _gantt.Unplan(Session, t);
        await Refresh();
    });

    /// <summary>Requests an auto-balance proposal; the server only calculates, the plan does not change.</summary>
    private async Task Balance(string mode)
    {
        _balancing = true;
        await Run(async () =>
        {
            var proposal = await Session.Save<BalanceProposalDto>(HttpMethod.Post, Session.TeamPath($"sprints/{Sprint.Id}/balance"), new BalanceRequest(mode));
            _proposal = proposal;
            _chosen = proposal.Changes.Select(c => c.TaskId).ToHashSet();
        });
        _balancing = false;
    }

    /// <summary>Moves a task in the pool's manual order and saves the whole order in one record.</summary>
    private Task Rerank(TaskModel task, int by) => Run(async () =>
    {
        var order = Pool.ToList();
        var at = order.IndexOf(task);
        if (at < 0 || at + by < 0 || at + by >= order.Count) return;
        order.RemoveAt(at);
        order.Insert(at + by, task);
        await Session.Send(HttpMethod.Put, Session.TeamPath("tasks/backlog-order"), new BacklogOrderRequest([.. order.Select(t => t.Id)]));
        await Refresh();
    });

    private void Choose(Guid taskId, bool on)
    {
        if (on) _chosen.Add(taskId);
        else _chosen.Remove(taskId);
    }

    private void RejectProposal() => _proposal = null;

    /// <summary>Applies the selected changes in one server operation: all or none, with task version checks.</summary>
    private async Task ApplyProposal()
    {
        if (!await DestructivePrompt.ConfirmAsync(Confirm, AlvaStrings.Sprint_ApplyChanges,
            string.Format(AlvaStrings.Sprint_ChangesWillBeAppliedTaskDatesAndAssigneesWillChange, Chosen.Count),
            AlvaStrings.Common_Apply)) return;
        await Run(async () =>
        {
            var items = Chosen.Select(c => Tasks.FirstOrDefault(t => t.Id == c.TaskId) is { } task
                    ? new BalanceApplyItem(c.TaskId, task.Version, c.ToStart, c.ToEnd, c.ToTargetId, c.ToPersonId) : null)
                .OfType<BalanceApplyItem>().ToArray();
            await Session.Send(HttpMethod.Post, Session.TeamPath($"sprints/{Sprint.Id}/balance/apply"), new BalanceApplyRequest(items));
            await Refresh();
        });
    }

    private async Task Commit()
    {
        if (!await DestructivePrompt.ConfirmAsync(Confirm, AlvaStrings.Sprint_CommitTheSprint,
            string.Format(AlvaStrings.Sprint_SprintWillStartNowItsScopeAndDatesAreFixedAndItCannotReturnToADraft, Sprint.Name),
            AlvaStrings.Sprint_CommitTheSprint)) return;
        await Run(async () =>
        {
            await Session.Save<SprintModel>(HttpMethod.Put, Session.TeamPath($"sprints/{Sprint.Id}"), new SprintRequest(Sprint.Name, Sprint.Goal, Sprint.StartDate, Sprint.EndDate, "Active"));
            await Changed.InvokeAsync();
        });
    }

    private async Task Run(Func<Task> action)
    {
        _busy = true; _error = null;
        try { await action(); }
        catch (Exception e) when (e is HttpRequestException or InvalidOperationException or NotSupportedException) { _error = PageFeedback.Describe(e); }
        finally { _busy = false; }
    }
}
