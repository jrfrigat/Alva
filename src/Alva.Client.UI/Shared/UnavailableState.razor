@* The link points to a record that does not exist (deleted, in another team, or a typo): the page says so
   explicitly and leads to the list instead of rendering an empty page or substituting another record. *@
<FlareEmptyState Title="@Title" Description="@(Description ?? AlvaStrings.Common_TheRecordMayHaveBeenDeletedMayBelongToAnotherTeamOrTheAddressHasATypo)">
    <ActionContent><FlareButton Href="@BackHref" Size="ButtonSize.Sm" Variant="ButtonVariant.Tonal">@BackLabel</FlareButton></ActionContent>
</FlareEmptyState>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public string? Description { get; set; }
    [Parameter, EditorRequired] public string BackHref { get; set; } = AppRoutes.Home;
    [Parameter, EditorRequired] public string BackLabel { get; set; } = "";
}
