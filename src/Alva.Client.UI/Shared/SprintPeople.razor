@* Sprint people: who else can be given work. Free hours in the sprint window, load, skills and
   absences; a person is dragged onto a task or assigned with a button. Daily load is shown in the Gantt cells. *@
<FlareCard Variant="CardVariant.Outlined">
    <FlareCardHeader Title="@(AlvaStrings.Sprint_SprintPeople)" Subtitle="@(AlvaStrings.Sprint_DragAPersonOntoATaskOrAssignWithTheButtonClickToShowOnTheGantt)">
        <AvatarContent><FlareIconView Value="@MaterialDesign3Icons.Regular.Groups" Size="20px" /></AvatarContent>
        <ActionContent><FlareChip Variant="ChipVariant.Filled" Color="FlareColor.Primary" Size="ChipSize.Sm">@Rows.Count</FlareChip></ActionContent>
    </FlareCardHeader>
    <FlareCardContent>
        @if (Rows.Count == 0)
        {
            <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@(AlvaStrings.Sprint_NoTeamMemberHasAScheduleForThisSprint)</FlareText>
        }
        else
        {
            <FlareList TItem="PersonLoad" Dense="true">
                @foreach (var row in Rows)
                {
                    var person = row.Person;
                    var focused = Focus == person.Id;
                    <FlareListItem @key="person.Id" Selected="@focused" OnClick="() => Toggle(person.Id)">
                        <Leading><FlareAvatar Text="@AlvaFormat.Initials(person.Name)" Size="AvatarSize.Sm" Color="FlareColor.Primary" /></Leading>
                        <ChildContent>
                            <FlareDraggable Payload="@(new PersonDrag(person.Id))">
                                <FlareStack Gap="FlareSpacing.XXSmall">
                                    <FlareStack Row Wrap Align="FlareAlignItems.Center" Justify="FlareJustifyContent.SpaceBetween" Gap="FlareSpacing.Small">
                                        <FlareText Typo="TypographyScale.LabelMedium">@person.Name</FlareText>
                                        <FlareStack Row Align="FlareAlignItems.Center" Gap="FlareSpacing.XSmall">
                                            <AlvaStatusChip Tone="@(row.Tone == "critical" ? AlvaTone.Critical : row.Tone == "info" ? AlvaTone.Info : AlvaTone.Ok)" Title="@(AlvaStrings.Common_WorkloadOverThePeriod)">@row.Percent%</AlvaStatusChip>
                                            <FlareIconButton Icon="@MaterialDesign3Icons.Regular.PersonAdd" Size="ButtonSize.Sm" Tooltip="@(AlvaStrings.Common_AssignAnAssignee)" AriaLabel="@($"{AlvaStrings.Common_AssignAnAssignee}: {person.Name}")" OnClick="() => OpenAssign(person.Id)" />
                                        </FlareStack>
                                    </FlareStack>
                                    <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@row.Roles</FlareText>
                                    <FlareProgressLinear Value="@Math.Min(100, row.Percent)" Size="TrackSize.Xs" Color="@ToneColor(row.Tone)" aria-label="@string.Format(AlvaStrings.Common_HAssignedOutOfH, person.Name, AlvaFormat.Hours(row.Allocated), AlvaFormat.Hours(row.Available))" />
                                    <FlareStack Row Wrap Align="FlareAlignItems.Center" Gap="FlareSpacing.Small">
                                        <FlareText Typo="TypographyScale.BodySmall" Color="@ToneColor(row.Tone)">@(row.Free >= 0 ? $"{AlvaFormat.Hours(row.Free)} {AlvaStrings.Sprint_HoursShort} {AlvaStrings.Common_FreeLower}" : $"−{AlvaFormat.Hours(-row.Free)} {AlvaStrings.Sprint_HoursShort} {AlvaStrings.Common_Overload}")</FlareText>
                                        @if (Shift.GetValueOrDefault(person.Id) is var shift && shift != 0)
                                        {
                                            var after = row.Free - shift;
                                            <FlareText Typo="TypographyScale.BodySmall" Color="@(shift > 0 ? FlareColor.Error : FlareColor.Success)">→ @(after >= 0 ? $"{AlvaFormat.Hours(after)} {AlvaStrings.Sprint_HoursShort}" : $"−{AlvaFormat.Hours(-after)} {AlvaStrings.Sprint_HoursShort}")</FlareText>
                                        }
                                        @foreach (var absence in row.Absences)
                                        {
                                            <FlareChip Variant="ChipVariant.Filled" Color="FlareColor.Warning" Size="ChipSize.Xs">@absence</FlareChip>
                                        }
                                    </FlareStack>
                                </FlareStack>
                            </FlareDraggable>
                        </ChildContent>
                    </FlareListItem>
                }
            </FlareList>
        }
    </FlareCardContent>
</FlareCard>

<FlareDialog @bind-Visible="_assignOpen" Title="@(AlvaStrings.Task_Assignment)" Size="DialogSize.Sm">
    <ChildContent>
        <FlareStack Gap="FlareSpacing.Medium">
            <FlareText Typo="TypographyScale.BodyMedium">@(_assignPerson is { } id ? PeopleName(id) : "")</FlareText>
            <FlareSelect TValue="Guid?" Label="@(AlvaStrings.Common_Task)" Items="AssignableTasks" ItemLabel="TaskName" NullOption="@(AlvaStrings.Common_ChooseATask)" @bind-Value="_assignTask" Searchable />
        </FlareStack>
    </ChildContent>
    <ActionsContent>
        <FlareButton Variant="ButtonVariant.Text" OnClick="() => _assignOpen = false">@(AlvaStrings.Common_Cancel)</FlareButton>
        <FlareButton Disabled="@(_assignPerson is null || _assignTask is null)" OnClick="ApplyAssign">@(AlvaStrings.Common_ApplyTheAssignment)</FlareButton>
    </ActionsContent>
</FlareDialog>

@code {
    private sealed record PersonLoad(ActorModel Person, string Roles, decimal Available, decimal Allocated, string[] Absences)
    {
        public decimal Free => Available - Allocated;
        public int Percent => Available <= 0 ? (Allocated > 0 ? 999 : 0) : (int)Math.Round(Allocated / Available * 100);
        public string Tone => Allocated > Available ? "critical" : Percent >= 85 ? "info" : "ok";
    }

    [Parameter, EditorRequired] public SprintModel Sprint { get; set; } = default!;
    [Parameter] public ActorModel[] Actors { get; set; } = [];

    /// <summary>Capacity by day over the sprint window.</summary>
    [Parameter] public CapacityDto[] Capacity { get; set; } = [];

    /// <summary>Tasks that can be assigned to a person from the dialog.</summary>
    [Parameter] public TaskModel[] Tasks { get; set; } = [];

    /// <summary>The person in focus - their row is highlighted on the Gantt.</summary>
    [Parameter] public Guid? Focus { get; set; }
    [Parameter] public EventCallback<Guid?> FocusChanged { get; set; }

    /// <summary>How many hours the auto-balance suggestion adds to the person in the sprint (negative - removes).</summary>
    [Parameter] public IReadOnlyDictionary<Guid, decimal> Shift { get; set; } = new Dictionary<Guid, decimal>();

    /// <summary>The person and task selected in the assignment dialog.</summary>
    [Parameter] public EventCallback<(Guid PersonId, Guid TaskId)> OnAssign { get; set; }

    private bool _assignOpen;
    private Guid? _assignPerson, _assignTask;

    // People with free time come first: they should get the work.
    private IReadOnlyList<PersonLoad> Rows => Actors.Where(a => a.Kind == "Person")
        .Select(person =>
        {
            var days = Capacity.Where(c => c.ActorId == person.Id && c.Date >= Sprint.StartDate && c.Date <= Sprint.EndDate).ToArray();
            var roles = string.Join(" / ", Actors.Where(a => person.SkillIds.Contains(a.Id)).Select(a => a.Name).DefaultIfEmpty(AlvaStrings.Capacity_TeamMember));
            return new PersonLoad(person, roles, days.Sum(d => d.AvailableHours), days.Sum(d => d.AllocatedHours), Absences(days));
        })
        .Where(p => p.Available > 0 || p.Allocated > 0)
        .OrderByDescending(p => p.Free).ThenBy(p => p.Person.Name).ToArray();

    private IEnumerable<Guid?> AssignableTasks => Tasks
        .Where(t => t.Status is not ("Done" or "Cancelled"))
        .OrderBy(t => t.Title)
        .Select(t => (Guid?)t.Id);

    private string TaskName(Guid? id) => Tasks.FirstOrDefault(t => t.Id == id)?.Title ?? "";
    private string PeopleName(Guid id) => Actors.FirstOrDefault(a => a.Id == id)?.Name ?? "";

    private static FlareColor ToneColor(string tone) => tone switch
    {
        "critical" => FlareColor.Error,
        "info" => FlareColor.Primary,
        _ => FlareColor.Success
    };

    /// <summary>Working days without available hours for a person who has a schedule, collapsed into ranges such as "20-23 Oct: not in the schedule".</summary>
    private static string[] Absences(CapacityDto[] days)
    {
        if (!days.Any(d => d.AvailableHours > 0)) return [];
        var off = days.Where(d => d.AvailableHours == 0 && !GanttData.IsWeekend(d.Date)).Select(d => d.Date).Order().ToArray();
        var ranges = new List<string>();
        for (var i = 0; i < off.Length;)
        {
            var j = i;
            // Adjacent working days (across weekends too) form one range.
            while (j + 1 < off.Length && Enumerable.Range(1, off[j + 1].DayNumber - off[j].DayNumber - 1).All(k => GanttData.IsWeekend(off[j].AddDays(k)))) j++;
            ranges.Add(i == j ? string.Format(AlvaStrings.Sprint_NotScheduled, off[i]) : string.Format(AlvaStrings.Sprint_NotScheduledRange, off[i], off[j]));
            i = j + 1;
        }
        return [.. ranges];
    }

    private Task Toggle(Guid id) => FocusChanged.InvokeAsync(Focus == id ? null : id);

    private void OpenAssign(Guid personId)
    {
        _assignPerson = personId;
        _assignTask = null;
        _assignOpen = true;
    }

    private async Task ApplyAssign()
    {
        if (_assignPerson is not { } person || _assignTask is not { } task) return;
        _assignOpen = false;
        await OnAssign.InvokeAsync((person, task));
    }
}
