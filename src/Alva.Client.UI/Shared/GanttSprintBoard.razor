@using Flare.Components.Gantt
@inject GanttPreferences Preferences
@* Sprint Gantt on the planning board: tasks of all unfinished sprints and people lanes on one axis,
   each sprint is labelled and the selected one is highlighted. Bars are edited as on the Gantt pages; the day a task
   is dropped on or a bar is moved to decides which sprint it lands in. *@
<FlareCard Variant="CardVariant.Outlined">
    <FlareCardHeader Title="@(AlvaStrings.Gantt_SynchronisedGantt2d)">
        <AvatarContent><FlareIconView Value="@MaterialDesign3Icons.Regular.AlignHorizontalLeft" Size="20px" /></AvatarContent>
        <ActionContent>
            <FlareStack Row Align="FlareAlignItems.Center" Gap="FlareSpacing.XSmall">
                <FlareButton Href="gantt/2d" Variant="ButtonVariant.Text" Size="ButtonSize.Sm">@(AlvaStrings.Gantt_Open)</FlareButton>
                <FlareButton Size="ButtonSize.Sm" Variant="ButtonVariant.Text" OnClick="ToToday" Tooltip="@(AlvaStrings.Gantt_ToTodayAltWheelScrollThroughTime)">@(AlvaStrings.Gantt_Today)</FlareButton>
            </FlareStack>
        </ActionContent>
    </FlareCardHeader>
    <FlareCardContent>
        <FlareStack Gap="FlareSpacing.Medium">
            <FlareStack Row Wrap Align="FlareAlignItems.Center" Gap="FlareSpacing.Small">
                <GanttLegend Items="BoardKey" />
                <FlareSpacer />
                <GanttZoom View="@View" Default="DefaultUnit" @bind-Value="_unit" />
            </FlareStack>
            @if (Data is null || People is null)
            {
                <FlareSkeleton Height="240px" Announce />
            }
            else
            {
                <FlareGantt @ref="_chart" Range="Range" RangeChanged="RangeChanged" Endless="true" Scale="GanttScale.Day" UnitWidth="_unit" FillWidth="true" Virtualize="true" RowHeight="56"
                            SideWidth="@_side" DefaultSideWidth="14rem" ResizableSide="true" SideWidthChanged="SaveSide" NonWorking="GanttData.IsWeekend"
                            Markers="@GanttData.TodayMarkers" Regions="@Data.PlanRegions(Sprint)" @bind-SelectedKey="_selected"
                            AriaLabel="@(AlvaStrings.Gantt_SprintGantt)" Class="alva-gantt" Style="--flare-gantt-max-height:38rem">
                    <Corner><FlareText Typo="TypographyScale.LabelSmall">@(AlvaStrings.Gantt_TaskAssignee)</FlareText></Corner>
                    <ChildContent>
                        <GanttTaskPanel Data="Data" SprintIds="SprintIds" DragRows="true" OnChange="OnTaskChange" OnLinkCreate="OnLinkCreate" OnLinkRejected="OnLinkRejected"
                                        DropGroup="plan" DropAccepts="IsTask" ItemDropGroup="plan" ItemDropAccepts="IsPerson" Suggested="TaskGhosts">
                            <Header>@(AlvaStrings.Gantt_Projection1SprintTasks)</Header>
                            <RowActions Context="task">
                                <FlareIconButton Icon="@MaterialDesign3Icons.Regular.Close" Size="ButtonSize.Sm" Tooltip="@UnplanHint(task)"
                                                 AriaLabel="@string.Format(AlvaStrings.Gantt_ReturnToTheBacklog, task.Title)" OnClick="() => OnUnplan.InvokeAsync(task)" />
                            </RowActions>
                        </GanttTaskPanel>
                        <GanttPeoplePanel People="People" Range="Range" Focus="Focus" OnChange="OnPeopleChange" OnLinkCreate="OnLinkCreate" OnLinkRejected="OnLinkRejected"
                                          DropGroup="plan" DropAccepts="IsTask" ItemDropGroup="plan" ItemDropAccepts="IsPerson" Suggested="PeopleGhosts">
                            <Header>@(AlvaStrings.Gantt_Projection2PeopleLanesAndCapacityHoursPerDay)</Header>
                        </GanttPeoplePanel>
                    </ChildContent>
                </FlareGantt>
            }
        </FlareStack>
    </FlareCardContent>
</FlareCard>

@code {
    private const string View = "plan";
    private const double DefaultUnit = 30;

    [Parameter, EditorRequired] public SprintModel Sprint { get; set; } = default!;
    [Parameter] public GanttData? Data { get; set; }
    [Parameter] public GanttPeopleData? People { get; set; }

    /// <summary>Axis window: the board's sprints and everything the user has scrolled to; the axis is endless and asks for more through <see cref="RangeChanged"/>.</summary>
    [Parameter, EditorRequired] public GanttSpan Range { get; set; }

    [Parameter] public EventCallback<GanttSpan> RangeChanged { get; set; }
    [Parameter] public Guid? Focus { get; set; }
    [Parameter] public EventCallback<GanttChangeEventArgs> OnTaskChange { get; set; }
    [Parameter] public EventCallback<GanttChangeEventArgs> OnPeopleChange { get; set; }
    [Parameter] public EventCallback<GanttLinkEventArgs> OnLinkCreate { get; set; }
    [Parameter] public EventCallback<GanttLinkRejectedEventArgs> OnLinkRejected { get; set; }
    [Parameter] public EventCallback<TaskModel> OnUnplan { get; set; }

    /// <summary>Selected auto-balance changes: shown as ghosts until they are applied or rejected.</summary>
    [Parameter] public IReadOnlyList<BalanceChangeDto> Suggested { get; set; } = [];

    // On tasks - only the new dates; on people - the new dates in the new person's row.
    private IEnumerable<GanttChange> TaskGhosts => Suggested.Where(c => c.ToStart != c.FromStart || c.ToEnd != c.FromEnd)
        .Select(c => new GanttChange(GanttData.Key(c.TaskId), GanttSpan.FromDays(c.ToStart, c.ToEnd)));

    private IEnumerable<GanttChange> PeopleGhosts => Suggested
        .Select(c => new GanttChange(GanttData.Key(c.TaskId), GanttSpan.FromDays(c.ToStart, c.ToEnd), GanttPeopleData.PersonKey(c.ToPersonId)));

    private FlareGantt? _chart;
    private string? _selected;
    private double _unit = DefaultUnit;
    private string _side = "14rem";
    private Guid? _scrolledTo;

    private IReadOnlyCollection<Guid> SprintIds => [.. Data!.PlanSprints(Sprint).Select(s => s.Id)];

    protected override async Task OnInitializedAsync() => _side = (await Preferences.Get(View)).Side ?? _side;

    // The axis is longer than the screen: after loading and after a sprint change it scrolls to the start of the selected one.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_chart is null || Data is null || _scrolledTo == Sprint.Id) return;
        _scrolledTo = Sprint.Id;
        await _chart.ScrollTo(Sprint.StartDate.AddDays(-1).ToDateTime(TimeOnly.MinValue));
    }

    private Task ToToday() => _chart?.ScrollTo(DateTime.Today.AddDays(-1)) ?? Task.CompletedTask;

    private async Task SaveSide(string width)
    {
        _side = width;
        await Preferences.SaveSide(View, width);
    }

    /// <summary>Row and day of a drop on the board Gantt: the zone gives the row, the day is where the pointer was released.</summary>
    public Task<GanttDropTarget?> ResolveDrop(string? targetId) =>
        _chart?.ResolveDrop(targetId) ?? Task.FromResult<GanttDropTarget?>(null);

    // A task with subtasks goes to the backlog together with them - the hint says so.
    private string UnplanHint(TaskModel task) => Data!.ChildrenOf(task).Any() ? AlvaStrings.Gantt_ReturnToBacklogWithSubtasksClearDates : AlvaStrings.Gantt_ReturnToBacklogClearDates;

    // Board-specific items: sprint windows, people overload and auto-balance ghosts if it suggests something.
    private IEnumerable<GanttLegendItem> BoardKey => new GanttLegendItem[]
    {
        new("sprint", AlvaStrings.Gantt_SelectedSprint, GanttLegendShape.Region),
        new("sprint-other", AlvaStrings.Gantt_OtherSprints, GanttLegendShape.Region),
        new("overload", AlvaStrings.Common_OverloadShort, GanttLegendShape.Cell)
    }.Concat(Suggested.Count > 0 ? [new GanttLegendItem("suggested", AlvaStrings.Gantt_Proposal, GanttLegendShape.Suggested)] : []);

    private static bool IsTask(object? payload) => payload is TaskDrag;
    private static bool IsPerson(object? payload) => payload is PersonDrag;
}
