@using Flare.Components.Gantt
@inject GanttPreferences Preferences
@* Гантт спринтов на доске планирования (макет p6_2d): задачи всех незавершённых спринтов и дорожки людей на одной оси,
   каждый спринт подписан, выбранный выделен. Полосы правятся как на страницах Гантта; день, на который бросили задачу или
   передвинули полосу, решает, в какой спринт она попадёт. *@
<section class="alva-panel alva-plan-gantt">
    <header class="alva-panel__header">
        <FlareIconView Value="@MaterialDesign3Icons.Regular.WaterfallChart" Size="20px" Class="alva-panel__icon" />
        <div>
            <h2 class="alva-panel__title">Синхронный Гантт 2D: @SprintCount @AlvaFormat.Plural(SprintCount, "спринт", "спринта", "спринтов") на оси</h2>
            <p class="alva-panel__subtitle">Бросьте задачу на день — она попадёт в спринт этого дня и получит срок; на строку человека — ещё и исполнителя. Человека — на полосу.</p>
        </div>
        <GanttLegend Class="alva-plan-gantt__legend" Items="BoardKey">
            <Trailing><a class="alva-plan-gantt__link" href="/gantt/2d">Открыть Гантт</a></Trailing>
        </GanttLegend>
        <GanttZoom View="@View" Default="DefaultUnit" @bind-Value="_unit" />
        <FlareButton Size="ButtonSize.Sm" Variant="ButtonVariant.Text" OnClick="ToToday" Tooltip="К сегодняшнему дню (Alt + колесо — прокрутка по времени)">Сегодня</FlareButton>
    </header>
    @if (Data is null || People is null)
    {
        <FlareSkeleton Height="240px" />
    }
    else
    {
        <FlareGantt @ref="_chart" Range="Range" RangeChanged="RangeChanged" Endless="true" Scale="GanttScale.Day" UnitWidth="_unit" FillWidth="true" Virtualize="true" RowHeight="34"
                    SideWidth="@_side" ResizableSide="true" SideWidthChanged="SaveSide" NonWorking="GanttData.IsWeekend"
                    Markers="@GanttData.TodayMarkers" Regions="@Data.PlanRegions(Sprint)" @bind-SelectedKey="_selected"
                    AriaLabel="Гантт спринтов" Class="alva-gantt alva-plan-gantt__chart">
            <Corner><span>Задача · исполнитель</span></Corner>
            <ChildContent>
                <GanttTaskPanel Data="Data" SprintIds="SprintIds" DragRows="true" OnChange="OnTaskChange" OnLinkCreate="OnLinkCreate" OnLinkRejected="OnLinkRejected"
                                DropGroup="plan" DropAccepts="IsTask" ItemDropGroup="plan" ItemDropAccepts="IsPerson" Suggested="TaskGhosts">
                    <Header>Проекция 1: задачи спринтов</Header>
                    <RowActions Context="task">
                        <FlareIconButton Icon="@MaterialDesign3Icons.Regular.Close" Size="ButtonSize.Sm" Tooltip="@UnplanHint(task)"
                                         AriaLabel="@($"Вернуть «{task.Title}» в бэклог")" OnClick="() => OnUnplan.InvokeAsync(task)" />
                    </RowActions>
                </GanttTaskPanel>
                <GanttPeoplePanel People="People" Range="Range" Focus="Focus" OnChange="OnPeopleChange" OnLinkCreate="OnLinkCreate" OnLinkRejected="OnLinkRejected"
                                  DropGroup="plan" DropAccepts="IsTask" ItemDropGroup="plan" ItemDropAccepts="IsPerson" Suggested="PeopleGhosts">
                    <Header>Проекция 2: дорожки людей и ёмкость (часы в день)</Header>
                </GanttPeoplePanel>
            </ChildContent>
        </FlareGantt>
    }
</section>

@code {
    private const string View = "plan";
    private const double DefaultUnit = 30;

    [Parameter, EditorRequired] public SprintModel Sprint { get; set; } = default!;
    [Parameter] public GanttData? Data { get; set; }
    [Parameter] public GanttPeopleData? People { get; set; }

    /// <summary>Окно оси: спринты доски и всё, до чего пользователь докрутил; ось бесконечная и просит больше через <see cref="RangeChanged"/>.</summary>
    [Parameter, EditorRequired] public GanttSpan Range { get; set; }

    [Parameter] public EventCallback<GanttSpan> RangeChanged { get; set; }
    [Parameter] public Guid? Focus { get; set; }
    [Parameter] public EventCallback<GanttChangeEventArgs> OnTaskChange { get; set; }
    [Parameter] public EventCallback<GanttChangeEventArgs> OnPeopleChange { get; set; }
    [Parameter] public EventCallback<GanttLinkEventArgs> OnLinkCreate { get; set; }
    [Parameter] public EventCallback<GanttLinkRejectedEventArgs> OnLinkRejected { get; set; }
    [Parameter] public EventCallback<TaskModel> OnUnplan { get; set; }

    /// <summary>Выбранные изменения автобаланса: показываются призраками, пока их не применят или не отклонят.</summary>
    [Parameter] public IReadOnlyList<BalanceChangeDto> Suggested { get; set; } = [];

    // На задачах — только новые даты; на людях — новые даты в строке нового человека.
    private IEnumerable<GanttChange> TaskGhosts => Suggested.Where(c => c.ToStart != c.FromStart || c.ToEnd != c.FromEnd)
        .Select(c => new GanttChange(GanttData.Key(c.TaskId), GanttSpan.FromDays(c.ToStart, c.ToEnd)));

    private IEnumerable<GanttChange> PeopleGhosts => Suggested
        .Select(c => new GanttChange(GanttData.Key(c.TaskId), GanttSpan.FromDays(c.ToStart, c.ToEnd), GanttPeopleData.PersonKey(c.ToPersonId)));

    private FlareGantt? _chart;
    private string? _selected;
    private double _unit = DefaultUnit;
    private string _side = "14rem";
    private Guid? _scrolledTo;

    private int SprintCount => Data?.PlanSprints(Sprint).Count ?? 1;
    private IReadOnlyCollection<Guid> SprintIds => [.. Data!.PlanSprints(Sprint).Select(s => s.Id)];

    protected override async Task OnInitializedAsync() => _side = (await Preferences.Get(View)).Side ?? _side;

    // Ось длиннее экрана: после загрузки и смены спринта она встаёт на начало выбранного.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_chart is null || Data is null || _scrolledTo == Sprint.Id) return;
        _scrolledTo = Sprint.Id;
        await _chart.ScrollTo(Sprint.StartDate.AddDays(-1).ToDateTime(TimeOnly.MinValue));
    }

    private Task ToToday() => _chart?.ScrollTo(DateTime.Today.AddDays(-1)) ?? Task.CompletedTask;

    private async Task SaveSide(string width)
    {
        _side = width;
        await Preferences.SaveSide(View, width);
    }

    /// <summary>Строка и день сброса на Гантт доски: строку даёт зона, день — место, где отпустили указатель.</summary>
    public Task<GanttDropTarget?> ResolveDrop(string? targetId) =>
        _chart?.ResolveDrop(targetId) ?? Task.FromResult<GanttDropTarget?>(null);

    // Задача с подзадачами уходит в бэклог вместе с ними — подсказка говорит об этом.
    private string UnplanHint(TaskModel task) => Data!.ChildrenOf(task).Any() ? "Вернуть в бэклог вместе с подзадачами (снять даты)" : "Вернуть в бэклог (снять даты)";

    // Свои пункты доски: окна спринтов, перегруз людей и призраки автобаланса, если он что-то предлагает.
    private IEnumerable<GanttLegendItem> BoardKey => new GanttLegendItem[]
    {
        new("sprint", "Выбранный спринт", GanttLegendShape.Region),
        new("sprint-other", "Другие спринты", GanttLegendShape.Region),
        new("overload", "Перегруз", GanttLegendShape.Cell)
    }.Concat(Suggested.Count > 0 ? [new GanttLegendItem("suggested", "Предложение", GanttLegendShape.Suggested)] : []);

    private static bool IsTask(object? payload) => payload is TaskDrag;
    private static bool IsPerson(object? payload) => payload is PersonDrag;
}
