@if (!string.IsNullOrEmpty(Error)) { <FlareAlert Severity="AlertSeverity.Error" Title="@(Strings.T("Не удалось выполнить действие"))">@Error</FlareAlert> }
@if (Loading) { <FlareProgressLinear Value="null" aria-label="@(Strings.T("Загрузка данных"))" /> }
@code {
    [Parameter] public string? Error { get; set; }
    [Parameter] public bool Loading { get; set; }

    /// <summary>
    /// Текст ошибки для страницы: отказ в доступе называется прямо, а не сырым ответом сервера — так он не путается
    /// ни с «не найдено», ни с поломкой.
    /// </summary>
    public static string Describe(Exception error) => error is HttpRequestException { StatusCode: System.Net.HttpStatusCode.Forbidden }
        ? Strings.T("Нет доступа: у вашей роли нет прав на эти данные. Попросите владельца пространства выдать доступ.")
        : error.Message;
}
