@if (!string.IsNullOrEmpty(Error))
{
    <FlareAlert Severity="AlertSeverity.Error" Title="@(AlvaStrings.Common_TheActionFailed)">
        <FlareStack Gap="FlareSpacing.Small">
            <span>@Error</span>
            @if (OnRetry.HasDelegate) { <FlareButton Size="ButtonSize.Sm" Variant="ButtonVariant.Tonal" OnClick="Retry">@(AlvaStrings.Common_TryAgain)</FlareButton> }
        </FlareStack>
    </FlareAlert>
}
@if (Loading) { <div class="alva-page-loading" role="status" aria-busy="true"><FlareProgressLinear Value="null" aria-label="@(AlvaStrings.Common_LoadingData)" /></div> }
@code {
    [Parameter] public string? Error { get; set; }
    [Parameter] public bool Loading { get; set; }
    [Parameter] public EventCallback OnRetry { get; set; }

    private Task Retry() => OnRetry.HasDelegate ? OnRetry.InvokeAsync() : Task.CompletedTask;

    /// <summary>
    /// Текст ошибки для страницы. Отказ, который сервер объяснил (400/404/409/422), и правило демо-API
    /// показываются их же словами: «сначала переместите подзадачи» полезнее, чем «проверьте данные».
    /// Остальное — понятная фраза по классу ошибки: 403 объясняет, что делать; 404 — что запись исчезла;
    /// 409 — что данные уже изменились; 5xx и сеть — что повторить.
    /// </summary>
    public static string Describe(Exception error) => error switch
    {
        ServerRefusalException { StatusCode: System.Net.HttpStatusCode.BadRequest or System.Net.HttpStatusCode.NotFound or System.Net.HttpStatusCode.Conflict or System.Net.HttpStatusCode.UnprocessableEntity } refusal => refusal.Message,
        HttpRequestException { StatusCode: System.Net.HttpStatusCode.Unauthorized } => AlvaStrings.Common_YourSessionHasExpiredSignInAgain,
        HttpRequestException { StatusCode: System.Net.HttpStatusCode.Forbidden } => AlvaStrings.Common_NoAccessYourRoleHasNoRightsToThisDataAskTheWorkspaceOwnerForAccess,
        HttpRequestException { StatusCode: System.Net.HttpStatusCode.NotFound } => AlvaStrings.Common_TheRecordWasNotFoundItMayHaveBeenDeleted,
        HttpRequestException { StatusCode: System.Net.HttpStatusCode.Conflict } => AlvaStrings.Common_TheDataHasAlreadyChangedRefreshThePageAndTryAgain,
        HttpRequestException { StatusCode: System.Net.HttpStatusCode.TooManyRequests } => AlvaStrings.Common_TooManyRequestsWaitAndTryAgain,
        HttpRequestException { StatusCode: System.Net.HttpStatusCode.BadRequest } => AlvaStrings.Common_CheckTheEnteredData,
        HttpRequestException { StatusCode: { } status } when (int)status >= 500 => AlvaStrings.Common_TheServerCouldNotCompleteTheActionTryAgainLater,
        HttpRequestException => AlvaStrings.Common_CouldNotReachTheServerCheckTheConnectionAndTryAgain,
        TimeoutException or TaskCanceledException => AlvaStrings.Common_TheServerDidNotRespondInTimeTryAgain,
        InvalidOperationException or NotSupportedException when !string.IsNullOrWhiteSpace(error.Message) => error.Message,
        _ => AlvaStrings.Common_TheActionCouldNotBeCompletedTryAgain
    };
}
