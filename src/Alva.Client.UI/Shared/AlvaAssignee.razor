@* Исполнитель или слот задачи: человек — аватар с инициалами; роль/подкоманда — аватар с иконкой
   и «Требуется человек», пока конкретный исполнитель не выбран. Загрузка, если передана, заменяет
   подпись под именем: >100% — перегрузка. *@
@if (Target is null)
{
    <FlareStack Row Align="FlareAlignItems.Center" Gap="FlareSpacing.XSmall">
        <FlareAvatar Text="?" Size="AvatarSize.Sm" Color="FlareColor.OnSurfaceVariant" />
        <FlareStack Gap="FlareSpacing.None">
            <FlareText Typo="TypographyScale.LabelMedium">@(Strings.T("Не назначена"))</FlareText>
            <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.Warning">@(Strings.T("Нет исполнителя"))</FlareText>
        </FlareStack>
    </FlareStack>
}
else if (Person is not null)
{
    <FlareStack Row Align="FlareAlignItems.Center" Gap="FlareSpacing.XSmall">
        <FlareAvatar Text="@AlvaFormat.Initials(Person.Name)" Size="AvatarSize.Sm" Color="FlareColor.Primary" />
        <FlareStack Gap="FlareSpacing.None">
            <FlareText Typo="TypographyScale.LabelMedium">@Person.Name</FlareText>
            @if (Load is { } load)
            {
                <FlareText Typo="TypographyScale.BodySmall" Color="@(load > 100 ? FlareColor.Error : FlareColor.OnSurfaceVariant)">@load% @(Strings.T("ёмкости"))@(load > 100 ? $" ({Strings.T("перегруз")})" : "")</FlareText>
            }
            else
            {
                <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@(Target.Kind == "Person" ? Strings.T("Человек") : $"{Labels.Kind(Target.Kind)}: {Target.Name}")</FlareText>
            }
            <SkillMatch Required="Task.RequiredSkills" Person="Person" />
        </FlareStack>
    </FlareStack>
}
else
{
    <FlareStack Row Align="FlareAlignItems.Center" Gap="FlareSpacing.XSmall">
        <FlareAvatar Size="AvatarSize.Sm" Color="FlareColor.Tertiary">
            <FallbackContent><FlareIconView Value="@MaterialDesign3Icons.Regular.Groups" Size="14px" /></FallbackContent>
        </FlareAvatar>
        <FlareStack Gap="FlareSpacing.None">
            <FlareText Typo="TypographyScale.LabelMedium">@Labels.Kind(Target.Kind): @Target.Name</FlareText>
            <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.Error">@(Strings.T("Требуется человек"))</FlareText>
        </FlareStack>
    </FlareStack>
}
@code {
    [Parameter, EditorRequired] public TaskModel Task { get; set; } = default!;
    [Parameter] public ActorModel[] Actors { get; set; } = [];

    /// <summary>Загрузка исполнителя в процентах за период, если она известна.</summary>
    [Parameter] public int? Load { get; set; }

    private ActorModel? Target => Actors.FirstOrDefault(a => a.Id == Task.AssignmentTargetId);
    private ActorModel? Person => Actors.FirstOrDefault(a => a.Id == Task.ResolvedPersonId) ?? (Target?.Kind == "Person" ? Target : null);
}
