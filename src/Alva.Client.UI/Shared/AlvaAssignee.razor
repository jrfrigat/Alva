@* Task assignee or slot: a person is an avatar with initials; a sub-team is an avatar with an icon
   and the "a person is required" label until a specific assignee is chosen. Load, when passed, replaces
   the caption under the name: >100% means overload. *@
@if (Target is null)
{
    <FlareStack Row Align="FlareAlignItems.Center" Gap="FlareSpacing.XSmall">
        <FlareAvatar Text="?" Size="AvatarSize.Sm" Color="FlareColor.OnSurfaceVariant" />
        <FlareStack Gap="FlareSpacing.None">
            <FlareText Typo="TypographyScale.LabelMedium">@(AlvaStrings.Common_UnassignedTask)</FlareText>
            <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.Warning">@(AlvaStrings.Common_NoAssignee)</FlareText>
        </FlareStack>
    </FlareStack>
}
else if (Person is not null)
{
    <FlareStack Row Align="FlareAlignItems.Center" Gap="FlareSpacing.XSmall">
        <FlareAvatar Text="@AlvaFormat.Initials(Person.Name)" Size="AvatarSize.Sm" Color="FlareColor.Primary" />
        <FlareStack Gap="FlareSpacing.None">
            <FlareText Typo="TypographyScale.LabelMedium">@Person.Name</FlareText>
            @if (Load is { } load)
            {
                <FlareText Typo="TypographyScale.BodySmall" Color="@(load > 100 ? FlareColor.Error : FlareColor.OnSurfaceVariant)">@load% @(AlvaStrings.Common_CapacitySuffix)@(load > 100 ? $" ({AlvaStrings.Common_Overload})" : "")</FlareText>
            }
            else
            {
                <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.OnSurfaceVariant">@(Target.Kind == "Person" ? AlvaStrings.Common_Person : $"{Labels.Kind(Target.Kind)}: {Target.Name}")</FlareText>
            }
            @if (ShowSkillMatch) { <SkillMatch Required="Task.RequiredSkillIds" Person="Person" Skills="SkillDictionary" /> }
        </FlareStack>
    </FlareStack>
}
else
{
    <FlareStack Row Align="FlareAlignItems.Center" Gap="FlareSpacing.XSmall">
        <FlareAvatar Size="AvatarSize.Sm" Color="FlareColor.Tertiary">
            <FallbackContent><FlareIconView Value="@MaterialDesign3Icons.Regular.Groups" Size="14px" /></FallbackContent>
        </FlareAvatar>
        <FlareStack Gap="FlareSpacing.None">
            <FlareText Typo="TypographyScale.LabelMedium">@Labels.Kind(Target.Kind): @Target.Name</FlareText>
            <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.Error">@(AlvaStrings.Common_APersonIsRequired)</FlareText>
        </FlareStack>
    </FlareStack>
}
@code {
    [Parameter, EditorRequired] public TaskModel Task { get; set; } = default!;
    [Parameter] public ActorModel[] Actors { get; set; } = [];

    /// <summary>Assignee load as a percentage for the period, when known.</summary>
    [Parameter] public int? Load { get; set; }

    /// <summary>Shows the skill match under the name. The subtask table hides it because it repeats for every row;
    /// the assignment section keeps it.</summary>
    [Parameter] public bool ShowSkillMatch { get; set; } = true;

    private ActorModel? Target => Actors.FirstOrDefault(a => a.Id == Task.AssignmentTargetId);
    private ActorModel? Person => Actors.FirstOrDefault(a => a.Id == Task.ResolvedPersonId) ?? (Target?.Kind == "Person" ? Target : null);
    private IEnumerable<ActorModel> SkillDictionary => Actors.Where(a => a.Kind == "Skill");
}
