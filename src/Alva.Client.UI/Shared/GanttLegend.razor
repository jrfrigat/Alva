@using Flare.Components.Gantt
@* Одна легенда для всех диаграмм Ганта: образцы рисует библиотека теми же элементами, что и график, поэтому цвета
   берутся из тех же правил .alva-gantt. Свои пункты страницы (спринты, ячейки ёмкости, предложение) идут перед видами
   полос, ссылка и уведомление страницы — после. *@
<FlareGanttLegend Items="@AllItems" AriaLabel="@(AlvaStrings.Gantt_Legend)" Class="@($"alva-gantt alva-gantt-legend {Class}".Trim())">
    @Trailing
    @if (Notice is not null)
    {
        <span class="alva-gantt-legend__notice" role="status">@Notice</span>
    }
</FlareGanttLegend>

@code {
    private GanttLegendItem[] Bars =>
    [
        new("work", AlvaStrings.Gantt_Work, Title: AlvaStrings.Gantt_TaskNotAtRiskOfMissingItsDueDate),
        new("risk-medium", AlvaStrings.Gantt_MediumRisk, Title: AlvaStrings.Gantt_DueDateAtRiskTheReasonsAreInTheBarTooltip),
        new("risk-high", AlvaStrings.Gantt_HighRisk, Title: AlvaStrings.Gantt_TheDueDateWillMostLikelyBeMissedTheReasonsAreInTheBarTooltip),
        new("waiting", AlvaStrings.Gantt_WaitingForSubtasks, GanttLegendShape.Segment, AlvaStrings.Gantt_AParentTaskWaitsForItsSubtasksTheSolidPartIsItsOwnWork, BarKind: "work"),
        new("done", AlvaStrings.Common_DoneStatus)
    ];

    /// <summary>Пункты страницы перед видами полос.</summary>
    [Parameter] public IEnumerable<GanttLegendItem> Items { get; set; } = [];

    /// <summary>Пункты после видов полос, например ссылка.</summary>
    [Parameter] public RenderFragment? Trailing { get; set; }

    [Parameter] public string? Notice { get; set; }
    [Parameter] public string? Class { get; set; }

    private IEnumerable<GanttLegendItem> AllItems => Items.Concat(Bars);
}
