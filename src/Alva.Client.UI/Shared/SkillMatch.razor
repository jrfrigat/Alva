@* A real skill gap only: a full match stays silent, so the line does not take space when all is well. *@
@{
    Guid[] missing = Required.Length > 0 && Person is { Kind: "Person" }
        ? SkillMath.Missing(Required, Person.SkillIds).ToArray()
        : [];
    var names = Skills.ToDictionary(skill => skill.Id, skill => skill.Name);
    var missingNames = missing.Select(id => names.GetValueOrDefault(id)).OfType<string>().ToArray();
}
@if (missingNames.Length > 0)
{
    <FlareText Typo="TypographyScale.BodySmall" Color="FlareColor.Warning" role="status">
        @(AlvaStrings.Common_MissingSkills + " " + string.Join(", ", missingNames))
    </FlareText>
}
@code {
    [Parameter] public Guid[] Required { get; set; } = [];
    [Parameter] public ActorModel? Person { get; set; }
    /// <summary>The team's skill dictionary, used to show the missing skills by name.</summary>
    [Parameter] public IEnumerable<ActorModel> Skills { get; set; } = [];
}
