@if (Required.Length > 0 && Person is { Kind: "Person" })
{
    var missing = SkillMath.Missing(Required, Person.Skills);
    <FlareText Typo="TypographyScale.BodySmall" Color="@(missing.Length > 0 ? FlareColor.Warning : FlareColor.OnSurfaceVariant)" role="status">
        @(missing.Length > 0 ? Strings.T("Не хватает навыков:") + " " + string.Join(", ", missing) : Strings.T("Все необходимые навыки есть"))
    </FlareText>
}
@code {
    [Parameter] public string[] Required { get; set; } = [];
    [Parameter] public ActorModel? Person { get; set; }
}
