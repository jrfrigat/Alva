<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <BlazorFingerprintBlazorJs>false</BlazorFingerprintBlazorJs>
    <WasmFingerprintDotnetJs>false</WasmFingerprintDotnetJs>
    <WasmFingerprintAssets>false</WasmFingerprintAssets>
    <BlazorWebAssemblyLoadAllGlobalizationData>true</BlazorWebAssemblyLoadAllGlobalizationData>
  </PropertyGroup>
  <PropertyGroup Condition="'$(AlvaDemo)' == 'true'">
    <DefineConstants>$(DefineConstants);ALVA_DEMO</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Alva.Contracts\Alva.Contracts.csproj" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.12" PrivateAssets="all" />
    <PackageReference Include="Flare.Blazor" Version="0.43.0" />
    <PackageReference Include="Flare.Theme.MaterialDesign3Expressive" Version="0.43.0" />
    <PackageReference Include="Flare.Icons.MaterialDesign3.Svg" Version="0.43.0" />
    <ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" />
  </ItemGroup>
</Project>
