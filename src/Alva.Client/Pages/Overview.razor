@page "/"
<PageTitle>Обзор · Alva</PageTitle>
<FlareStack Gap="FlareSpacing.Small"><FlareText Element="h1" Typo="TypographyScale.HeadlineLarge">Обзор команды</FlareText><FlareText Typo="TypographyScale.BodyLarge">Планируйте работу с учётом возможностей команды.</FlareText></FlareStack>
<FlareEmptyState Title="Начните с команды" Description="Войдите в Alva, выберите рабочее пространство и соберите команду.">
    <IconContent><FlareIconView Value="@MaterialDesign3Icons.Regular.Group" Size="3rem" /></IconContent>
    <ActionContent><FlareButton Href="/workspaces">Выбрать команду</FlareButton></ActionContent>
</FlareEmptyState>
