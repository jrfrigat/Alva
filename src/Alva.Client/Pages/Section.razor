@page "/sprints"
@page "/tasks"
@page "/diagrams"
@page "/projects"
@page "/capacity"
@page "/team"
@page "/analytics"
@page "/my-work"
@page "/data"
@page "/settings"
@page "/login"
@page "/workspaces"
@inject NavigationManager Navigation
<PageTitle>@Title · Alva</PageTitle>
<FlareText Element="h1" Typo="TypographyScale.HeadlineLarge">@Title</FlareText>
<FlareEmptyState Title="Выберите команду" Description="Данные и действия этого раздела относятся к выбранной команде.">
    <ActionContent><FlareButton Href="/">К обзору</FlareButton></ActionContent>
</FlareEmptyState>
@code {
    private string Title => NavigationItems.All.FirstOrDefault(x => x.Path == new Uri(Navigation.Uri).AbsolutePath).Label ?? "Рабочее пространство";
}
